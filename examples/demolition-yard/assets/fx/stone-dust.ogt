type particles
version 1
---
# breakFx for concrete: a low grey puff where a piece breaks loose, lit by
# the sun, that sinks and settles quickly so the break shows through it
# (a pillar breaks loose many islands at once, and their puffs add up).
maxParticles 256
shape sphere 0.2
spread 180
rate 0
burst 0 14
duration 0.25
looping false
lifetime 0.8 1.5
speed 0.2 0.6
size 0.2 0.4
sizeOverLife 0 0.6 1 1.6
colorOverLife {
  key 0 0.36 0.35 0.33 0
  key 0.1 0.36 0.35 0.33 0.4
  key 1 0.4 0.39 0.37 0
}
rotation 0 360
angularVelocity -40 40
gravity 0 -0.8 0
drag 2.5
blend alpha
lit true
softDistance 0.3
