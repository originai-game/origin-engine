  material "wood"
  position 0 0 0
  boxGeometry {
    width 0.8
    height 0.8
    depth 0.8
  }
}
fracture {
  chunks 10
  seed 2
  children 0
  anchor none
  interior {
    color 0.78 0.62 0.4
    roughness 0.9
  }
}
