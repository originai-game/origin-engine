type model
version 1
---
# A wooden crate, 0.8 m, of boards: a dynamic body that splinters along its
# grain where it lands hard.
material "wood" {
  color 1 1 1
  roughness 0.75
  map "../textures/planks.png"
  normalMap "../textures/planks_n.png"
}
part "box" {
  material "wood"
  position 0 0 0
  boxGeometry {
    width 0.8
    height 0.8
    depth 0.8
  }
}
fracture {
  style wood
  grain x
  chunks 16
  seed 2
  children 0
  anchor none
  interiorScale 1.5
  interior {
    color 1 1 1
    roughness 0.9
    map "../textures/wood_cut.png"
    normalMap "../textures/wood_cut_n.png"
  }
}
