type model
version 1
---
# A brick wall, 4 × 2.4 × 0.3 m, standing on its foot and tied in at both
# ends: a running bond of 0.25 × 0.1 m bricks, broken along its mortar into
# blocks of brickwork, each falling apart into its bricks.
material "brick" {
  color 1 1 1
  roughness 0.9
  map "../textures/brick.png"
  normalMap "../textures/brick_n.png"
}
part "wall" {
  material "brick"
  position 0 1.2 0
  boxGeometry {
    width 4
    height 2.4
    depth 0.3
    uvRepeat 4 2.4
  }
}
fracture {
  style brick
  brick 0.25 0.1
  chunks 80
  seed 11
  children 32          # a block's bricks (brick style: up to 32)
  anchor bottom ends
  interiorScale 2
  interior {
    color 1 1 1
    roughness 1
    map "../textures/brick_cut.png"
    normalMap "../textures/brick_cut_n.png"
  }
}
