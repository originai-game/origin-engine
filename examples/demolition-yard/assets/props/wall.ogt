type model
version 1
---
# A brick wall, 5 × 2.4 × 0.3 m, standing on its foot and tied in at both
# ends: a running bond of 0.25 × 0.1 m bricks, broken along its mortar into
# runs of one to three bricks along a course, each falling apart into its
# bricks.
material "brick" {
  color 1 1 1
  roughness 0.9
  map "../textures/brick.png"
  normalMap "../textures/brick_n.png"
}
part "wall" {
  material "brick"
  position 0 1.2 0
  boxGeometry {
    width 5
    height 2.4
    depth 0.3
    uvRepeat 5 2.4
  }
}
fracture {
  style brick
  brick 0.25 0.1
  chunks 250
  seed 11
  children 32          # a block's bricks (brick style: up to 32)
  anchor bottom ends
  interiorScale 2
  interior {
    color 1 1 1
    roughness 1
    map "../textures/brick_cut.png"
    normalMap "../textures/brick_cut_n.png"
  }
  mortar {             # the grit a broken joint sheds beside the clay
    color 0.66 0.63 0.57
    roughness 1
  }
}
