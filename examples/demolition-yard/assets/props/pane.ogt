type model
version 1
---
# A glass pane, 1.6 × 1.2 m and 1 cm thick: clear float glass with its faint
# green, it refracts what lies behind it and reflects the sky; struck, it
# cracks radially and in rings from the blow, its shards' edges catching
# the light. It stands in a metal frame (src/main.ts), not part of it.
material "glass" {
  color 0.84 0.95 0.9
  metalness 0
  roughness 0.02
  transmission 1
  ior 1.5
  thickness 0.01
  doubleSided true
}
part "pane" {
  material "glass"
  position 0 0.6 0
  boxGeometry {
    width 1.6
    height 1.2
    depth 0.01
  }
}
fracture {
  style glass
  chunks 25
  rings 3
  seed 9
  children 0
  impact 0 0.8 0 0.25
  interior {
    color 0.55 0.85 0.8
    roughness 0.05
    emissive 0.5 0.75 0.72
    emissiveIntensity 0.35
  }
}
