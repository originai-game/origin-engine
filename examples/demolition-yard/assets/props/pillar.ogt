type model
version 1
---
# A concrete pillar, 0.5 m across and 3 m tall: a blow at its middle takes
# it away in chunky lumps that show their gravel, and what stood on it
# comes down.
material "concrete" {
  color 1 1 1
  roughness 0.85
  map "../textures/concrete.png"
  normalMap "../textures/concrete_n.png"
}
part "shaft" {
  material "concrete"
  position 0 1.5 0
  cylinderGeometry {
    radiusTop 0.25
    radiusBottom 0.25
    height 3
    radialSegments 20
    uvRepeat 1.6 3
  }
}
fracture {
  style concrete
  chunks 44
  seed 5
  children 5
  interiorScale 2.5
  interior {
    color 1 1 1
    roughness 0.95
    map "../textures/concrete_cut.png"
    normalMap "../textures/concrete_cut_n.png"
  }
}
