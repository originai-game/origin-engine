type model
version 1
---
# The yard: worn concrete slabs, 24 × 14 m, their top at y = 0.
material "slab" {
  color 1 1 1
  roughness 0.95
  map "../textures/ground.png"
  normalMap "../textures/ground_n.png"
}
part "ground" {
  material "slab"
  position 0 -0.25 0
  boxGeometry {
    width 24
    height 0.5
    depth 14
    uvRepeat 12 7
  }
}
