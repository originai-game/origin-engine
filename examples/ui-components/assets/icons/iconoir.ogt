type icons
version 1
---
# 72 game-UI glyphs of iconoir 7.12.1 (MIT, iconoir/LICENSE), cooked into
# a distance-field atlas like a font (og-cook cook::icons) for UiDesc.icons.font,
# and the kit's own icon names after them (the 32 of the old PNG grid).
source "iconoir"
size 48
range 8
# iconoir draws round joins; floppy-disk and pause name none (SVG's miter).
join round
# Navigation and controls
icon "home"
icon "settings"
icon "play"
icon "pause"
icon "refresh"
icon "undo"
icon "menu"
icon "search"
icon "xmark"
icon "check"
icon "plus"
icon "minus"
icon "nav-arrow-left"
icon "nav-arrow-right"
icon "nav-arrow-up"
icon "nav-arrow-down"
# Sound
icon "sound-high"
icon "sound-off"
icon "music-double-note"
# Status
icon "info-circle"
icon "warning-triangle"
icon "help-circle"
icon "bell"
icon "lock"
icon "key"
icon "eye"
icon "eye-closed"
# Game items
icon "heart"
icon "star"
icon "coins"
icon "trophy"
icon "medal"
icon "crown"
icon "gift"
icon "shield"
icon "flash"
icon "fire-flame"
icon "potion"
icon "magic-wand"
icon "sparks"
icon "flask"
icon "cube"
icon "puzzle"
# Shop and people
icon "cart"
icon "shopping-bag"
icon "user"
icon "group"
icon "chat-bubble"
icon "share-android"
icon "leaderboard-star"
# World and time
icon "map"
icon "map-pin"
icon "compass"
icon "globe"
icon "clock"
icon "hourglass"
icon "timer"
# Other
icon "gamepad"
icon "dice-five"
icon "rocket"
icon "floppy-disk"
icon "trash"
icon "edit-pencil"
icon "language"
# The kit's names (its screens, the shop, the idle game, the dialogue's
# portraits), each an iconoir glyph: those the set has under another name,
# and eight more icons.
icon "coin" "coins"
icon "gear" "settings"
icon "sword" "hammer"
icon "gem" "hexagon"
icon "bolt" "flash"
icon "close" "xmark"
icon "back" "nav-arrow-left"
icon "bag" "shopping-bag"
icon "bomb" "bowling-ball"
icon "flag" "triangle-flag"
icon "apple"
icon "leaf"
icon "fire" "fire-flame"
icon "drop" "droplet"
icon "skull" "emoji-talking-angry"
icon "music" "music-double-note"
icon "person" "user"
