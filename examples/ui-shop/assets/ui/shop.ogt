type screen
version 1
---
# The shop: a menu layer over the HUD (it dims and pauses what is under
# it, takes Back and the focus, and gives both back when it pops). Every
# value below is a prop the probe can set live (ui:set) and ui:save writes
# back into this file, line by line.
name "shop"
layer menu
pause true
under dim
focus "Footer/Buy"
props {
  gold number "The gold the player can spend."
  items list "What the shop sells: name, price, owned, tint."
  selected number "The index of the selected item."
  price number "The selected item's price."
  restock number "Seconds until the stock changes."
  volume number "The shop's music volume, 0 to 1."
}
actions {
  confirm "Buy"
  back "Leave"
}
timeline bought {
  track "" scale {
    key 0 1
    key 110 1.06 out
    key 280 1 out
  }
}
fixture default "{\"gold\": 1250, \"items\": [{\"name\": \"Ember blade\", \"price\": 1200, \"owned\": false, \"tint\": \"#e0573d\"}, {\"name\": \"Tide shield\", \"price\": 800, \"owned\": true, \"tint\": \"#3d86e0\"}, {\"name\": \"Grove charm\", \"price\": 450, \"owned\": false, \"tint\": \"#45a861\"}], \"selected\": 0, \"price\": 1200, \"restock\": 5400, \"volume\": 0.6}"
panel Shop {
  width 560
  padding 24
  gap 14
  radius 18
  background "#1b2030"
  centerX true
  centerY true
  position absolute
  enter slideUp 24 spring 320 0.1
  row Header {
    width grow
    cross center
    gap 8
    label Title {
      text "Shop"
      step xl2
      heading true
    }
    spacer
    label Gold {
      text bind gold compact
      step lg
      color "#ffd166"
    }
  }
  label Restock {
    text "Restocks in {restock, duration}"
    color "#8a93a6"
  }
  column Items {
    width grow
    gap 6
    for item in items {
      row Item {
        width grow
        padding 10
        gap 12
        cross center
        radius 10
        interactive true
        on click set selected "$index"
        panel Swatch {
          width 28
          height 28
          radius 6
          background bind item.tint
        }
        label Name {
          text bind item.name
          step lg
        }
        spacer
        label Price {
          text "{item.price, grouped} gold"
          color "#ffd166"
        }
        toggle Owned {
          text "Owned"
          checked bind item.owned
        }
        state selection bind "$index == selected" {
          off {
            background "#232a3b"
            opacity 0.8
          }
          on {
            background "#2f3a55"
            opacity 1
          }
          transition any any spring 220 0.1
        }
      }
    }
  }
  slot Preview {
    width grow
    height 56
  }
  row Music {
    width grow
    gap 12
    cross center
    label Label {
      text "Music"
    }
    slider Volume {
      width grow
      value bind volume
    }
  }
  row Footer {
    width grow
    gap 10
    align end
    button Leave {
      text "Leave"
      on click pop
    }
    button Buy {
      text "Buy"
      variant primary
      disabled bind "gold < price"
      on click emit buy
      on click play bought
    }
  }
}
