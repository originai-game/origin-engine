type screen
version 1
---
# The HUD: the Wallet resource's gold and essence, read as of the last
# tick (a Capitalised root), and a Shop button that tells code to open it.
name "hud"
layer hud
actions {
  details "Shop"
}
row Bar {
  width grow
  padding 16
  gap 12
  cross center
  panel Purse {
    padding 10
    gap 16
    radius 12
    background "#151a24e6"
    label Gold {
      text "{Wallet.gold, grouped} gold"
      step lg
      color "#ffd166"
    }
    label Essence {
      text "{Wallet.essence, letters} essence"
      color "#9ad1ff"
    }
  }
  spacer
  button Open {
    text "Shop"
    on click emit shop
    on action details emit shop
  }
}
