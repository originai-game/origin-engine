type style
version 2
---
# Brasswick's style: the engine's fantasy style pack (templates/ui-kit, CC0 art, OFL fonts:
# LICENSES.md), copied by tools/make-assets.ts, its ground soot and its accent brass; the CJK
# fallback line dropped, the game shows Latin-1 only.
name "brasswick"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#14110d"
  well "#1d1812"
  panel "#efdfb8"
  panelHover "#f4e8c8"
  panelRaised "#efdfb8"
  line "#9b7a4a"
  lineStrong "#5c4127"
  ink "#2a1a0c"
  inkMuted "#3d2a18"
  inkFaint "#654b31"
  inkInverse "#f4e8c8"
  control "#e2cc98"
  controlStrong "#d6bc82"
  primary "#7a4f12"
  primaryHover "#6e470f"
  primaryActive "#5f3d0c"
  onPrimary "#fff4dc"
  primarySoft "#7a520f40"
  highlight "#6a440e"
  focus "#1f6a5c"
  knob "#f4e8c8"
  hud "#efdfb8"
  scrim "#0d0805cc"
  shadow "#000000aa"
  sheen "#ffffff52"
  success "#2d5a1e"
  warn "#704713"
  danger "#6e1b10"
  info "#22517f"
  health "#2d5a1e"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#7a520f"
}
colors {
  success icon "check"
  warn icon "flag"
  danger icon "skull"
  info icon "map"
  common "#877e6e" pips 1
  uncommon "#3f8a2f" pips 2
  rare "#2a5fa8" pips 3
  epic "#7d3aa0" pips 4
  legendary "#af7219" icon "crown"
  mythic "#a8182c" icon "gem"
  team1 "#2a5fa8"
  team2 "#a8182c"
  team3 "#3f8a2f"
  team4 "#af7219"
  team5 "#7d3aa0"
  team6 "#c0561a"
  team7 "#1f7f7a"
  team8 "#a83a7a"
  physical "#7a6a55" icon "sword"
  fire "#c0461a" icon "fire"
  ice "#2f7fb0" icon "drop"
  lightning "#9b7b18" icon "bolt"
  poison "#4f7a1f" icon "potion"
  holy "#9b7c16" icon "star"
  shadow "#4a2a6a" icon "skull"
  arcane "#8a2a9a" pattern stars
  series1 "#2a5fa8"
  series2 "#af7219"
  series3 "#a8182c"
  series4 "#3f8a2f"
  series5 "#7d3aa0"
  series6 "#1f7f7a"
  series7 "#c0561a"
  series8 "#6a5a48"
}
typography {
  display 42 48 0.06 700 display {
    phonePortrait 34 38
    phoneLandscape 38 43
  }
  title 28 34 0.05 700 display {
    phonePortrait 24 30
    phoneLandscape 26 32
  }
  heading 22 28 0.03 700 display
  body 15 22 0 500 body
  label 13 18 0 500 body
  caption 13 18 0 500 body
  numeric 19 26 0.02 700 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 2
  sm 4
  md 6
  lg 8
  xl 12
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 4 8 0 "#00000066"
  }
  floating {
    shadow 0 3 6 0 "#00000080"
  }
  overlay {
    shadow 0 10 18 2 "#000000b3"
  }
  top {
    shadow 0 14 28 2 "#000000c0"
  }
}
shape {
  panel round 4
  dialog round 6
  card round 4
  tooltip notch 4
  button round 4
  field round 4
  chip bevel 4
  badge notch 6
  tab round 4
  slot bevel 4
  bar round 4
  hud round 8
  avatar round pill
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 24
  lg 19 26
  xl 22 28
  xl2 24 30
  xl3 28 32
  displaySm 28 34
  displayMd 34 40
  displayLg 42 48
}
fonts {
  body "Newsreader-Medium.ttf"
  display "Cinzel-Bold.ttf"
  numeric "Cinzel-Bold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
corner 320 104 32 32 28 28 authored 6
divider 4 172 128 24 112 20 authored
flourish 136 172 64 24 48 18 authored 0
tile 204 172 64 64 64 64 0.5 6
motion {
  enter scale
  toast slideDown
  progress 420
  shake 5
  pop 0.1
  spring ui 220 0
  spring panel 360 0.05
  spring emphasis 520 0.15
  spring playful 600 0.2
  ease standard 0.25 0.1 0.25 1
  ease enter 0.16 1 0.3 1
  ease exit 0.7 0 0.84 0
  ease emphasis 0.22 1.2 0.36 1
  duration instant 120
  duration fast 200
  duration base 300
  duration slow 480
  duration spring 520
  duration bounce 640
  stagger 35
  staggerCap 420
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none volume 0.85 1 pitch 0.97 1.03 haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic tap
  close none haptic tick
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none pitch 1 1.3 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic thud
}
dress "Panel.frame" {
  slice 4 4 96 96 16 authored
  tone 0.861 0.736 0.478 1.00
  shadow 0 10 18 2 "#000000b3"
  corners
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 10 authored
  tone 0.860 0.735 0.478 1.00
  shadow 0 4 8 0 "#00000066"
  tile
}
dress "Button.base" {
  slice 172 4 48 48 10 tint
  tone 0.789 0.789 0.789 1.00
  shadow 0 3 4 0 "#00000073"
  press 0.98 0.96 1
  hover 0 1.0
}
dress "Button.base[hover]" {
  slice 224 4 48 48 10 tint
  tone 0.890 0.890 0.890 1.00
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 10 tint
  tone 0.693 0.693 0.693 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 10 tint
  tone 0.630 0.630 0.630 1.00
}
dress "Field.frame" {
  slice 4 104 48 48 8 tint
  tone 0.912 0.912 0.912 1.00
}
dress "Slot.frame" {
  slice 56 104 48 48 10 tint
  tone 0.808 0.808 0.808 1.00
}
dress "Tooltip.frame" {
  slice 108 104 32 32 8 tint
  tone 0.934 0.934 0.934 1.00
}
dress "Hud.frame" {
  slice 144 104 32 32 12 tint
  tone 0.848 0.848 0.848 1.00
  shadow 0 3 6 0 "#00000080"
}
dress "Meter.track" {
  slice 180 104 32 16 6 tint
  tone 0.692 0.692 0.692 1.00
}
dress "Meter.fill" {
  slice 216 104 32 16 6 tint
  tone 0.788 0.788 0.788 1.00
}
