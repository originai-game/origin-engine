type screen
version 1
---
# Brasswick's title, ejected from the library's main-menu (og ui eject
# main-menu) and made the game's own: the game's name and its line in a
# card in the middle of the frame, Continue (disabled with no save), New
# game, Levels and Settings, and the keys in the bottom-right corner. Every word is a key of
# assets/strings/<locale>.ogt.
#
# Viewmodel: canContinue, continueLine (Continue's words, with the saved
# level). Events to code: continue, new, levels, settings. src/ui.ts
# `title` mounts it while the title is the screen.
name "main-menu"
layer menu
under none
back none
focus "Card/Items/new"
props {
  canContinue bool "The vault slot answered with a save: Continue is live."
  continueLine string "Continue's words (Continue · level 2)."
}
actions {
  confirm "Select"
}
fixture default "{\"canContinue\": true, \"continueLine\": \"Continue · level 2\"}"
column Title {
  width grow
  height grow
  align center
  cross center
  at phone {
    align end
  }
  column Card {
    width 380
    padding 24
    gap 24
    cross center
    background token hud
    radius 10
    at phone {
      width grow
      padding 16
    }
    column Heading {
      width grow
      gap 4
      cross center
      label Title {
        text "Brasswick"
        step displayLg
        font display
        textAlign center
        width grow
        heading true
        at phone {
          step displayMd
        }
      }
      label Subtitle {
        key "title.subtitle"
        text "A small brass automaton climbs out of the vault"
        color token inkMuted
        textAlign center
        width grow
      }
    }
    column Items {
      width grow
      gap 8
      cross stretch
      button continue {
        text bind continueLine
        size large
        width grow
        disabled bind "!canContinue"
        on click emit continue
      }
      button new {
        key "title.new"
        text "New game"
        variant primary
        size large
        width grow
        autofocus true
        on click emit new
      }
      button levels {
        key "title.levels"
        text "Levels"
        size large
        width grow
        on click emit levels
      }
      button settings {
        key "title.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
    }
  }
  label Footer {
    key "title.footer"
    text "Arrows or WASD to move · Space to jump · R back to the lamp"
    step meta
    color token inkFaint
    nowrap true
    position absolute
    end 16
    bottom 16
  }
}
