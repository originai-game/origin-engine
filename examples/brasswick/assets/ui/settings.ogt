type screen
version 1
---
# Brasswick's settings, ejected from the library's settings (og ui eject
# settings) and made the game's own, laid out as they shipped: a panel over
# the dimmed screen with the title, the page and Done in its footer.
#
# Slot Page takes the sections and their rows (src/ui.ts `settings`): Sound,
# Display, Controls and Language as tabs (a select on a phone) over a body
# of fixed height, each change applied at once (src/prefs.ts); every word
# is the game's string key. Viewmodel: none. Events to code: done (Done and
# Back: the settings close and are saved).
name "settings"
layer menu
under dim
back emit done
remember true
actions {
  confirm "Select"
  back "Done"
  tabNext "Next page"
  tabPrev "Previous page"
}
fixture default "{}"
column Settings {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 600
    padding 24
    gap 12
    background token panelRaised
    radius 4
    frame panel
    enter scale
    label Title {
      key "settings.title"
      text "Settings"
      step xl
      heading true
    }
    slot Page {
      width grow
      gap 12
    }
    row Footer {
      width grow
      align end
      button Done {
        key "settings.done"
        text "Done"
        variant primary
        on click emit done
      }
    }
  }
}
