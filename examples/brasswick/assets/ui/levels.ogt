type screen
version 1
---
# Brasswick's level select, ejected from the library's saga-map (og ui
# eject saga-map, renamed levels) and made the game's own, laid out as it
# shipped: three levels are cards, not a map. A panel with the title, the
# stars earned of all, a card per level in a grid (its number and name and
# its stars; a locked one a lock, refused) and Back. Every word is a key of
# assets/strings/<locale>.ogt or a line the game says from them.
#
# Viewmodel: earned (the stars line), earnedLabel (the stars to a screen
# reader). Events to code: back (Back, a tap on the scrim, Escape, the
# pad's B). Slot Levels takes the cards' og.ui.grid (src/ui.ts `levels`:
# a press on an open card starts it).
name "levels"
layer menu
under dim
back emit back
focus "Panel/Levels"
props {
  earned string "The stars earned of all, as a line."
  earnedLabel string "The stars earned of all, as a screen reader says them."
}
actions {
  confirm "Play"
  back "Back"
}
fixture default "{\"earned\": \"3 / 9\", \"earnedLabel\": \"3 of 9 stars\"}"
column Screen {
  width grow
  height grow
  padding 16
  align center
  cross center
  interactive true
  on click emit back
  column Panel {
    width grow 0 720
    padding 24
    gap 12
    background token panelRaised
    radius 4
    frame panel
    interactive true
    enter scale
    label Title {
      key "levels.title"
      text "Levels"
      step xl
      heading true
    }
    row Total {
      gap 4
      cross center
      icon Star {
        icon star
        name bind earnedLabel
        iconSize 18
        color token gold
      }
      label Count {
        text bind earned
        font mono
        color token inkMuted
        nowrap true
      }
    }
    slot Levels {
      width grow
    }
    row Footer {
      width grow
      align end
      button Back {
        key "levels.back"
        text "Back"
        on click emit back
      }
    }
  }
}
