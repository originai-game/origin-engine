type flipbook
version 1
---
# Wick (tools/make-assets.ts): 24 x 32 frames facing right (flipX faces left),
# the feet on the bottom row (the pivot). The run's feet touch on frames 0 and 3.
texture "wick.png"
pivot 0.5 0
grid 24 32 6 3
clip idle {
  frames 0 1
  fps 3
  mode pingPong
}
clip run {
  frames 2 3 4 5 6 7
  fps 12
  event 0 "step"
  event 3 "step"
}
clip jump {
  frames 8
  fps 1
}
clip fall {
  frames 9
  fps 1
}
clip wall {
  frames 10
  fps 1
}
clip push {
  frames 11 12 13 14
  fps 6
  event 1 "shove"
  event 3 "shove"
}
clip hurt {
  frames 15
  fps 1
}
clip cheer {
  frames 16 17
  fps 4
  mode pingPong
}
