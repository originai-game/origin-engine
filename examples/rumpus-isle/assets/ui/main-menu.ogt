type screen
version 1
---
# Rumpus Isle's title, ejected from the library's main-menu (og ui eject
# main-menu) and made the game's own: the isle's name and its line in a
# card in the middle of the frame, Play and Settings, and under them, in
# the card, the records (or the hint about pads). Every word is a key of
# assets/strings/<locale>.ogt.
#
# Viewmodel: footer (the records, or the hint). Events to code: play,
# settings. src/ui.ts `title` mounts it while the title is the screen.
name "main-menu"
layer menu
under none
back none
focus "Card/Items/play"
props {
  footer string "The card's last line: the isle's records, or how to play."
}
actions {
  confirm "Select"
}
fixture default "{\"footer\": \"Pads, or two players on one keyboard\"}"
column Title {
  width grow
  height grow
  align center
  cross center
  at phone {
    align end
  }
  column Card {
    width 380
    padding 24
    gap 24
    cross center
    background token hud
    radius 10
    frame panel
    at phone {
      width grow
      padding 16
    }
    column Heading {
      width grow
      gap 4
      cross center
      label Title {
        text "Rumpus Isle"
        step displayLg
        font display
        textAlign center
        width grow
        heading true
        at phone {
          step displayMd
        }
      }
      label Subtitle {
        key "title.subtitle"
        text "A party of bumps for two to four on one screen"
        color token inkMuted
        textAlign center
        width grow
      }
    }
    column Items {
      width grow
      gap 8
      cross stretch
      button play {
        key "title.play"
        text "Play"
        variant primary
        size large
        width grow
        autofocus true
        on click emit play
      }
      button settings {
        key "title.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
    }
    label Footer {
      text bind footer
      step meta
      color token inkFaint
      textAlign center
      width grow
    }
  }
}
