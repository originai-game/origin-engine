type screen
version 1
---
# Rumpus Isle's settings, ejected from the library's settings (og ui eject
# settings) and made the game's own, laid out as the game shipped them: a
# 600 px panel over the dimmed screen with its title, the page (the tabs
# and the rows under them) and Done at its foot.
#
# Slot Page takes the game's own tabs and rows (src/ui.ts `settings`):
# Sound (General, Music and Effects sliders, Mute everything), Graphics,
# Controls and Language, each change applied at once (src/prefs.ts); its
# words are the game's string keys. Viewmodel: none. Events to code: done
# (Done and Back: the settings close and are saved).
name "settings"
layer menu
under dim
back emit done
focus "Panel/Page/Section"
remember true
actions {
  confirm "Select"
  back "Done"
  tabNext "Next page"
  tabPrev "Previous page"
}
fixture default "{}"
column Settings {
  width grow
  height grow
  padding 24
  align center
  cross center
  at phone {
    padding 8
  }
  column Panel {
    width grow 0 600
    padding 24
    gap 12
    background token panelRaised
    radius 10
    frame panel
    interactive true
    label Title {
      key "settings.title"
      text "Settings"
      step xl
      heading true
    }
    slot Page {
      width grow
      gap 12
    }
    row Footer {
      width grow
      align end
      button Done {
        key "settings.done"
        text "Done"
        variant primary
        on click emit done
      }
    }
  }
}
