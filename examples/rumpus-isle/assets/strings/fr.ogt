# Les mots de Rumpus Isle en français (og-i18n §1) : les mêmes clés que en.ogt.
locale "fr"
string "lang.en" "English"
string "lang.fr" "Français"
string "title.subtitle" "Une fête de bousculades à deux, trois ou quatre sur un écran"
string "title.play" "Jouer"
string "title.settings" "Réglages"
string "title.footer" "Des manettes, ou deux joueurs sur un clavier"
string "title.recordBerries" "Record : {n, plural, one {# baie} other {# baies}} en Ruée aux baies"
string "title.recordTiles" "{s} s sur les Dalles friables"
string "lobby.title" "Qui joue ?"
string "lobby.hint" "Appuyez sur [b]A[/b] sur une manette, [b]Espace[/b] (ZQSD) ou [b]Entrée[/b] (flèches) pour vous asseoir. Une manette choisit sa couleur avec son propre anneau ; le clavier avec gauche et droite. Tout le monde est prêt ? C'est parti !"
string "lobby.join" "Appuyez pour jouer"
string "lobby.ready" "Prêt !"
string "lobby.choosing" "Choisit"
string "lobby.colour" "Couleur"
