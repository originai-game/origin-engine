type strings
version 1
---
# Rumpus Isle's words in English, the base table (og-i18n §1): every word a
# screen shows is a key here. fr.ogt has the same keys. The critters' names
# (Pip, Juno, Moss, Bix, Plum, Tofu) are names, the same in every language.
locale "en"
base true
string "lang.en" "English"
string "lang.fr" "Français"
string "title.subtitle" "A party of bumps for two to four on one screen"
string "title.play" "Play"
string "title.settings" "Settings"
string "title.footer" "Pads, or two players on one keyboard"
string "title.recordBerries" "Record: {n, plural, one {# berry} other {# berries}} in a Berry Rush"
string "title.recordTiles" "{s} s on the Crumble Tiles"
string "lobby.title" "Who's playing?"
string "lobby.hint" "Press [b]A[/b] on a pad, [b]Space[/b] (WASD) or [b]Enter[/b] (arrows) to sit down. A pad picks its colour with its own ring; the keys pick with left and right. Everyone ready, and off we go!"
string "lobby.join" "Press to join"
string "lobby.ready" "Ready!"
string "lobby.choosing" "Choosing"
string "lobby.colour" "Colour"
string "lobby.readyButton" "Ready"
string "lobby.back" "Back"
string "lobby.start" "Start"
string "lobby.starting" "Starting in {n}…"
string "source.pad" "Pad {n}"
string "source.keysLeft" "WASD + Space"
string "source.keysRight" "Arrows + Enter"
string "colour.coral" "Coral"
string "colour.sun" "Sun"
string "colour.mint" "Mint"
string "colour.sky" "Sky"
string "colour.grape" "Grape"
string "colour.cream" "Cream"
string "round.bump" "Bump Ring"
string "round.berry" "Berry Rush"
string "round.crumble" "Crumble Tiles"
string "round.bump.how" "Shove the others into the sea. Dash with A, Space or Enter. Last one on the island wins!"
string "round.berry.how" "Grab the most berries before the whistle. Gold ones count three; a dip in the sea costs one."
string "round.crumble.how" "Every tile you stand on cracks and drops. Keep moving; the last one standing wins!"
string "intro.round" "Round {n} of {of}"
string "hud.round" "{n}/{of} · {name}"
string "hud.pause" "Pause"
string "place.short" "{n, select, 1 {1st} 2 {2nd} 3 {3rd} other {{n}th}}"
string "over.one" "{name} takes the round!"
string "over.tie" "{names} share the round!"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
string "pause.lobby" "Back to the lobby"
string "pause.quit" "Quit to title"
string "scores.title" "Round {n}: {name}"
string "scores.berries" "{n, plural, one {# berry} other {# berries}}"
string "scores.lasted" "{s} s"
string "scores.pts" "pts"
string "scores.recordBerries" "New record: {n, plural, one {# berry} other {# berries}}!"
string "scores.recordTiles" "New record: {s} s on the tiles!"
string "scores.dropIn" "New players can sit down now and join from the next round."
string "scores.next" "Next round"
string "scores.podium" "To the podium"
string "podium.one" "{name} rules Rumpus Isle!"
string "podium.tie" "{names} share the isle!"
string "podium.again" "Play again"
string "podium.lobby" "New players"
string "podium.title" "Title"
string "settings.title" "Settings"
string "settings.audio" "Audio"
string "settings.graphics" "Graphics"
string "settings.controls" "Controls"
string "settings.language" "Language"
string "settings.master" "Master"
string "settings.music" "Music"
string "settings.effects" "Effects"
string "settings.mute" "Mute everything"
string "settings.quality" "Quality"
string "settings.low" "Low"
string "settings.medium" "Medium"
string "settings.high" "High"
string "settings.fps" "Show frame rate"
string "settings.motion" "Reduced motion"
string "settings.contrast" "High contrast"
string "settings.sensitivity" "Stick sensitivity"
string "settings.invert" "Invert Y"
string "settings.vibration" "Vibration"
string "settings.done" "Done"
