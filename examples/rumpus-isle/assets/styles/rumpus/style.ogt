type style
version 2
---
# Rumpus Isle's style: the engine's cartoon style pack (templates/ui-kit, CC0 art, OFL fonts:
# LICENSES.md), copied by tools/make-assets.ts, its ground a deep sea blue and its accent coral;
# the CJK fallback line dropped, the game shows Latin-1 only.
name "rumpus"
scheme light
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#123a5c"
  well "#174870"
  panel "#fff4dc"
  panelHover "#ffe9bd"
  panelRaised "#fff4dc"
  line "#2b1a4a"
  lineStrong "#2b1a4a"
  ink "#2b1a4a"
  inkMuted "#5a4880"
  inkFaint "#61527c"
  inkInverse "#fff4dc"
  control "#fff3cc"
  controlStrong "#ffecb5"
  primary "#b23a1e"
  primaryHover "#b9401f"
  primaryActive "#962f17"
  onPrimary "#fff4dc"
  primarySoft "#b23a1e40"
  highlight "#a3341a"
  focus "#3fa7ff"
  knob "#ffffff"
  hud "#fff4dcf5"
  scrim "#0b2238cc"
  shadow "#2b1a4a99"
  sheen "#ffffff52"
  success "#06681b"
  warn "#7b5102"
  danger "#6a0a16"
  info "#2256af"
  health "#06681b"
  mana "#007aff"
  xp "#af52de"
  gold "#b23a1e"
}
colors {
  success icon "check"
  warn icon "flag"
  danger icon "close"
  info pattern dots
  common "#8c8c99" pips 1
  uncommon "#28a23f" pips 2
  rare "#2e8bff" pips 3
  epic "#b44cff" pips 4
  legendary "#c97a18" pips 5
  mythic "#ff3d7f" pips 6
  team1 "#2e8bff"
  team2 "#fc4c4c"
  team3 "#28a23f"
  team4 "#b08612"
  team5 "#b44cff"
  team6 "#d6741a"
  team7 "#189d9d"
  team8 "#eb55a2"
  physical "#a08a70" icon "sword"
  fire "#eb6228" icon "fire"
  ice "#3496bf" icon "drop"
  lightning "#a88b14" icon "bolt"
  poison "#5b9c3f" pattern dots
  holy "#9c8c54" icon "star"
  shadow "#7a5cf6" pattern waves
  arcane "#ed49c9" pattern stars
  series1 "#2e8bff"
  series2 "#d6741a"
  series3 "#fc4c69"
  series4 "#28a23f"
  series5 "#b44cff"
  series6 "#b08612"
  series7 "#189d9d"
  series8 "#eb55a2"
}
typography {
  display 52 56 0.01 400 display {
    phonePortrait 42 45
    phoneLandscape 47 50
  }
  title 32 36 0.01 400 display {
    phonePortrait 28 32
    phoneLandscape 30 34
  }
  heading 22 28 0 600 display
  body 15 20 0 600 body
  label 13 18 0 600 body
  caption 13 18 0 600 body
  numeric 19 26 0 400 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 36
  lg 52
  xl 72
  xxl 104
  touch 48
}
radius {
  xs 4
  sm 6
  md 10
  lg 14
  xl 20
  pill 9999
}
stroke {
  hairline 2
  thin 3
  regular 4
  thick 5
  focus 3
}
elevation {
  raised {
    shadow 0 5 0 0 "#2b1a4a99"
  }
  floating {
    shadow 0 4 0 0 "#2b1a4a99"
  }
  overlay {
    shadow 0 8 0 0 "#2b1a4acc"
    shadow 0 18 24 0 "#1a0f3c40"
  }
  top {
    shadow 0 10 0 0 "#2b1a4acc"
    shadow 0 24 32 0 "#1a0f3c4d"
  }
}
shape {
  panel round 10
  dialog round 14
  card round 12
  tooltip round 8
  button squircle 6
  field squircle 6
  chip round pill
  badge round pill
  tab squircle 6
  slot round 6
  bar round 6
  hud round 8
  avatar round pill
}
ramp {
  body 15 20
  meta 13 18
  caption 13 18
  lg 19 26
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 52 56
}
fonts {
  body "Fredoka-SemiBold.ttf"
  display "LilitaOne-Regular.ttf"
  numeric "LilitaOne-Regular.ttf"
  cjk "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 48 16 primary
flourish 136 172 64 24 22 10 primary 2
textShadow display 0 4 0 "#2b1a4a"
motion {
  enter pop
  toast pop
  progress 360
  shake 8
  pop 0.22
  spring ui 160 0.15
  spring panel 320 0.25
  spring emphasis 480 0.4
  spring playful 560 0.5
  ease standard 0.2 0 0 1
  ease enter 0.34 1.56 0.64 1
  ease exit 0.36 0 0.66 -0.56
  ease emphasis 0.34 1.8 0.64 1
  duration instant 110
  duration fast 160
  duration base 280
  duration slow 420
  duration spring 520
  duration bounce 640
  stagger 50
  staggerCap 400
  overshoot 0.2
}
sounds {
  hover none haptic none
  press none volume 0.8 1 pitch 0.95 1.08 haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none pitch 1 1.6 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none pitch 1 1.25 haptic 0 20 0.2 0.6 80 20 0.2 0.7 160 40 0.4 0.9
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic thud
}
dress "Panel.frame" {
  slice 4 4 96 96 16 tint
  tone 0.933 0.933 0.933 1.00
  shadow 0 8 0 0 "#2b1a4acc"
}
dress "Card.frame" {
  slice 104 4 64 64 14 tint
  tone 0.922 0.922 0.922 1.00
  shadow 0 5 0 0 "#2b1a4a99"
}
dress "Button.base" {
  slice 172 4 48 48 12 tint
  tone 0.830 0.830 0.830 1.00
  shadow 0 5 0 0 "#2b1a4acc"
  press 1.08 0.88 3
  hover -3 1.04
}
dress "Button.base[hover]" {
  slice 224 4 48 48 12 tint
  tone 0.913 0.913 0.913 1.00
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 12 tint
  tone 0.711 0.711 0.711 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 12 tint
  tone 0.711 0.711 0.711 1.00
}
dress "Field.frame" {
  slice 4 104 48 48 10 tint
  tone 0.890 0.890 0.890 1.00
}
dress "Slot.frame" {
  slice 56 104 48 48 10 tint
  tone 0.828 0.828 0.828 1.00
  shadow 0 3 0 0 "#2b1a4a66"
}
dress "Tooltip.frame" {
  slice 108 104 32 32 10 tint
  tone 0.944 0.944 0.944 1.00
}
dress "Hud.frame" {
  slice 144 104 32 32 10 tint
  tone 0.890 0.890 0.890 1.00
  shadow 0 4 0 0 "#2b1a4a99"
}
dress "Meter.track" {
  slice 180 104 32 16 7 tint
  tone 0.738 0.738 0.738 1.00
}
dress "Meter.fill" {
  slice 216 104 32 16 7 tint
  tone 0.839 0.839 0.839 1.00
}
