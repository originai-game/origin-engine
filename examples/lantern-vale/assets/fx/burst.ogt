type particles
version 1
---
# A lantern catching: one burst of warm sparks thrown up from the glass,
# falling back and fading (src/lanterns.ts restarts it with startTick).
maxParticles 128
shape sphere 0.2
spread 70
rate 0
burst 0 60
duration 1.4
looping false
lifetime 0.7 1.4
speed 2.5 5
size 0.05 0.1
colorOverLife {
  key 0 6 3.2 1 1
  key 1 1.6 0.4 0.1 0
}
gravity 0 -5 0
drag 0.5
texture "textures/spark.png"
blend additive
align velocity 0.05
