type screen
version 1
---
# Lantern Vale's results, ejected from the library's results (og ui eject
# results) and made the game's own, under the dawn look, laid out as the
# game shipped them: a dialog panel 420 px wide, how the run ended,
# the stars (none when night or the slimes won), the score counting up,
# the best and the New best badge when it lands, the lamplighter, the
# lanterns, the time and the hurts as rows, and Again and Title. Every
# word is a key of assets/strings/<locale>.ogt or a line the game says
# from them.
#
# Viewmodel: title. Events to code: none. Slots: Body takes the stars
# landing one by one, the score counting up, the best and the New best
# badge, the rows and Again and Title (src/ui.ts `results`).
name "results"
layer menu
under dim
back none
props {
  title string "How the run ended."
}
actions {
  confirm "Select"
}
fixture default "{\"title\": \"The vale is lit\"}"
column Results {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width 420
    padding 24
    gap 12
    background token panelRaised
    radius 4
    frame panel
    enter slideUp 24 token enter
    at phone {
      width 360
    }
    label Title {
      text bind title
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
  }
}
