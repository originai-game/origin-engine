type screen
version 1
---
# Lantern Vale's results, ejected from the library's results (og ui eject
# results) and made the game's own, under the dawn look: how the run ended,
# the stars (none when night or the slimes won), the score counting up,
# the best and the New best badge when it lands, the lamplighter, the
# lanterns, the time and the hurts as rows, and Again and Title. Every
# word is a key of assets/strings/<locale>.ogt or a line the game says
# from them.
#
# Viewmodel: title, score (counted up this tick), best (the best line;
# empty: none), newBest, landed (the count-up ended: the badge pops),
# stats ({ label, value }). Events to code: again, menu. Slots: Stars
# takes og.ui.starRating.
name "results"
layer menu
under dim
back none
focus "Panel/Actions/again"
props {
  title string "How the run ended."
  score number "The score, as shown this tick (it counts up)."
  best string "The best score, as a line; empty: none."
  newBest bool "This run set the best."
  landed bool "The count-up has landed: the badge shows."
  stats list "The rows: { label, value }."
}
actions {
  confirm "Select"
}
fixture default "{\"title\": \"The vale is lit\", \"score\": 1092, \"best\": \"Best 1,092\", \"newBest\": true, \"landed\": true, \"stats\": [{\"label\": \"Lanterns\", \"value\": \"4/4\"}, {\"label\": \"Time\", \"value\": \"1:48\"}]}"
column Results {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 420
    padding 24
    gap 16
    frame panel
    enter slideUp 24 token enter
    label Title {
      text bind title
      step xl2
      font display
      heading true
    }
    row StarRow {
      width grow
      align center
      slot Stars {
      }
    }
    column ScoreBlock {
      width grow
      gap 2
      cross center
      label Score {
        text bind score grouped
        step displayLg
        font display
        textAlign center
        nowrap true
      }
      row BestRow {
        gap 8
        cross center
        label Best {
          text bind best
          step meta
          color token inkMuted
          nowrap true
          visible bind "best != \"\""
        }
        badge NewBest {
          key "results.newBest"
          text "New best"
          tone accent
          visible bind "newBest && landed"
        }
      }
    }
    column Stats {
      width grow
      for s in stats {
        row Stat {
          width grow
          padding 4
          gap 12
          label Key {
            text bind s.label
            color token inkMuted
            nowrap true
          }
          spacer
          label Value {
            text bind s.value
            font mono
            nowrap true
          }
        }
      }
    }
    row Actions {
      width grow
      gap 8
      button again {
        key "results.again"
        text "Again"
        variant primary
        width grow
        on click emit again
      }
      button menu {
        key "results.menu"
        text "Title"
        width grow
        on click emit menu
      }
    }
  }
}
