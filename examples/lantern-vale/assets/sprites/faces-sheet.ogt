type flipbook
version 1
---
# The slimes' expression bubbles as one sheet cooked into a texture array
# (`array true`: frame n is layer n): 0 calm, 1 alert, 2 lost, 3 sleepy
# (Face in src/components.ts). tools/make-assets.ts draws faces-sheet.png.
texture "faces-sheet.png"
array true
pivot 0.5 0
grid 32 32 4 1
clip faces {
  frames 0 1 2 3
  fps 1
  mode loop
}
