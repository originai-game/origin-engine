type strings
version 1
---
# Lantern Vale's English strings (og.i18n); every key is in zh-CN.ogt too.
locale "en"
base true
string "title.name" "Lantern Vale"
string "title.tagline" "Light the four lanterns before night falls"
string "title.play" "Set out"
string "title.settings" "Settings"
string "title.footer" "WASD move · Shift run · hold E by a lantern to light it · Esc pause"
string "hud.lanterns" "{n}/{total}"
string "hud.pause" "Pause"
string "hud.hint" "Hold E to light the lantern"
string "hud.lit" "Lantern {n} of {total} glows"
string "hud.far" "The far side of the vale stirs"
string "hud.ouch" "-1"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
string "pause.quit" "Quit to title"
string "settings.title" "Settings"
string "settings.about" "Lantern Vale · 灯笼谷 · a lamplighter's dusk"
string "settings.music" "Music"
string "settings.effects" "Effects"
string "settings.name" "Lamplighter"
string "settings.namePlaceholder" "Your name"
string "settings.language" "Language"
string "settings.motion" "Reduced motion"
string "settings.done" "Done"
string "lang.en" "English"
string "lang.zh" "简体中文"
string "results.won" "The vale is lit"
string "results.night" "Night fell first"
string "results.caught" "The slimes won"
string "results.lanterns" "Lanterns"
