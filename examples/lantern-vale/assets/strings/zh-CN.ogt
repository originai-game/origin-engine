type strings
version 1
---
# 灯笼谷的简体中文字符串（og.i18n）；每个键都与 en.ogt 一一对应。
locale "zh-CN"
fonts "fonts/NotoSansSC-subset.ttf"
string "title.name" "灯笼谷"
string "title.tagline" "在夜幕降临前点亮四盏灯笼"
string "title.play" "出发"
string "title.settings" "设置"
string "title.footer" "WASD 移动 · Shift 奔跑 · 在灯笼旁按住 E 点灯 · Esc 暂停"
string "hud.lanterns" "{n}/{total}"
string "hud.pause" "暂停"
string "hud.hint" "按住 E 点亮灯笼"
string "hud.lit" "第 {n}/{total} 盏灯笼已点亮"
string "hud.far" "山谷的彼岸苏醒了"
string "hud.ouch" "-1"
string "pause.title" "已暂停"
string "pause.resume" "继续"
string "pause.settings" "设置"
string "pause.quit" "返回标题"
string "settings.title" "设置"
string "settings.about" "灯笼谷 · Lantern Vale · 点灯人的黄昏"
string "settings.music" "音乐"
string "settings.effects" "音效"
string "settings.name" "点灯人"
string "settings.namePlaceholder" "你的名字"
string "settings.language" "语言"
string "settings.motion" "减少动态效果"
string "settings.done" "完成"
string "lang.en" "English"
string "lang.zh" "简体中文"
string "results.won" "山谷灯火通明"
string "results.night" "夜幕先降临了"
string "results.caught" "史莱姆赢了"
string "results.lanterns" "灯笼"
string "results.time" "用时"
string "results.hurts" "受伤"
string "results.player" "点灯人"
string "results.again" "再来一次"
string "results.menu" "标题"
string "results.nobody" "无名氏"
