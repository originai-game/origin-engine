type screen
version 1
---
# Meridian Loop's results, ejected from the library's results (og ui eject
# results) and made the game's own, laid out as the game shipped them: a
# time trial's result is a time. A 420 px panel over the dimmed race with
# the race's title (Finished, New lap record, the replay's verdict), the
# result (slot Body: the stars the best lap earned, the total time
# counting up as m:ss.mmm under its caption, the session's best race
# before it and the Best race badge, the laps and the record as rows), and
# Again, Watch replay, Leaderboard and Title. Every word is a key of
# assets/strings/<locale>.ogt or a line the game says from them.
#
# Viewmodel: title, replay (a replay is ready). Events to code: again,
# replay, board, title. Slot Body takes the game's own rows (src/ui.ts
# `results`).
name "results"
layer menu
under dim
back none
focus "Panel/Actions/again"
props {
  title string "The result's line."
  replay bool "A replay of this race is ready."
}
actions {
  confirm "Select"
}
fixture default "{\"title\": \"Finished\", \"replay\": true}"
column Results {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 420
    padding 24
    gap 12
    background token panelRaised
    radius 10
    frame panel
    interactive true
    at phone {
      width grow 0 360
    }
    label Title {
      text bind title
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
    row Actions {
      width grow
      gap 8
      at phone {
        wrap true
      }
      button again {
        key "results.again"
        text "Again"
        variant primary
        width grow
        on click emit again
      }
      button replay {
        key "results.replay"
        text "Watch replay"
        width grow
        visible bind replay
        on click emit replay
      }
      button board {
        key "results.board"
        text "Leaderboard"
        width grow
        on click emit board
      }
      button title {
        key "results.title"
        text "Title"
        width grow
        on click emit title
      }
    }
  }
}
