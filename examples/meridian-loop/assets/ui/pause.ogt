type screen
version 1
---
# Meridian Loop's pause, ejected from the library's pause (og ui eject
# pause) and made the game's own: a panel over the dimmed race with its
# title, Resume, Restart, the ghost on or off, Settings and Quit to title.
# The race's clock is the game's to hold (src/ui.ts sets the time scale
# while it is up). Every word is a key of assets/strings/<locale>.ogt.
#
# Viewmodel: ghost (the ghost button's words, as the game says them).
# Events to code: resume (also Back), restart, ghost, settings, quit.
name "pause"
layer menu
under dim
back emit resume
focus "Panel/Items/resume"
props {
  ghost string "The ghost button's words: Ghost: on or Ghost: off."
}
actions {
  confirm "Select"
  back "Resume"
}
fixture default "{\"ghost\": \"Ghost: on\"}"
column Pause {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 340
    padding 24
    gap 12
    background token panelRaised
    radius 10
    frame panel
    interactive true
    enter slideUp 24 token enter
    label Title {
      key "pause.title"
      text "Paused"
      step xl
      heading true
    }
    column Items {
      width grow
      gap 8
      cross stretch
      focusGroup wrap
      button resume {
        key "pause.resume"
        text "Resume"
        variant primary
        size large
        width grow
        on click emit resume
      }
      button restart {
        key "pause.restart"
        text "Restart"
        size large
        width grow
        on click emit restart
      }
      button ghost {
        text bind ghost
        size large
        width grow
        on click emit ghost
      }
      button settings {
        key "pause.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
      button quit {
        key "pause.quit"
        text "Quit to title"
        size large
        width grow
        on click emit quit
      }
    }
  }
}
