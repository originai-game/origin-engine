type screen
version 1
---
# Meridian Loop's title, ejected from the library's main-menu (og ui eject
# main-menu) and made the game's own: the name and the record (or the
# tagline) in a card in the middle, Time trial, Leaderboard and Settings,
# and the keys in the bottom-right corner. Every word is a key of
# assets/strings/<locale>.ogt.
#
# Viewmodel: sub (the record, or the tagline). Events to code: start,
# board, settings. src/ui.ts mounts it while the title is the screen.
name "main-menu"
layer menu
under none
back none
focus "Card/Items/start"
props {
  sub string "Under the name: the lap record, or the tagline."
}
actions {
  confirm "Select"
}
fixture default "{\"sub\": \"Three laps after midnight. Beat your ghost.\"}"
column Title {
  width grow
  height grow
  align center
  cross center
  at phone {
    align end
  }
  column Card {
    width 380
    padding 24
    gap 24
    cross center
    background token hud
    radius 10
    at phone {
      width grow
      padding 16
    }
    column Heading {
      width grow
      gap 4
      cross center
      label Title {
        key "title.name"
        text "Meridian Loop"
        step displayLg
        font display
        textAlign center
        width grow
        heading true
        at phone {
          step displayMd
        }
      }
      label Subtitle {
        text bind sub
        color token inkMuted
        textAlign center
        width grow
      }
    }
    column Items {
      width grow
      gap 8
      cross stretch
      button start {
        key "title.start"
        text "Time trial"
        variant primary
        size large
        width grow
        autofocus true
        on click emit start
      }
      button board {
        key "title.board"
        text "Leaderboard"
        size large
        width grow
        on click emit board
      }
      button settings {
        key "title.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
    }
  }
  label Footer {
    key "title.footer"
    text "W throttle · S brake · A D steer (or the arrows) · R reset · Esc pause · pad: RT LT, left stick"
    step meta
    color token inkFaint
    nowrap true
    position absolute
    end 16
    bottom 16
  }
}
