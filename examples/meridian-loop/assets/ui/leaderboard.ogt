type screen
version 1
---
# Meridian Loop's leaderboard, ejected from the library's leaderboard (og
# ui eject leaderboard) and made the game's own, laid out as the game
# shipped it: a 520 px panel with the title, the two scopes (the fastest
# laps, the ones round the player) and the laps as rows (rank, driver,
# time; the player's row lit), its loading, error and empty states honest.
# Every word is a key of assets/strings/<locale>.ogt.
#
# Viewmodel: none. Events to code: back (Back closes it). Slot Body takes
# the game's own tabs and rows (src/ui.ts `board`).
name "leaderboard"
layer menu
under dim
back emit back
focus "Panel/Body/Scopes"
actions {
  confirm "Select"
  back "Back"
}
fixture default "{}"
column Board {
  width grow
  height grow
  padding 24
  align center
  cross center
  column Panel {
    width grow 0 520
    padding 24
    gap 12
    background token panelRaised
    radius 10
    frame panel
    interactive true
    at phone {
      width grow
    }
    label Title {
      key "board.title"
      text "Fastest laps"
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
  }
}
