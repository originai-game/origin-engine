type style
version 2
---
# Meridian Loop's style: the engine's neon pack (templates/ui-kit), copied and retinted by tools/make-assets.ts.
name "meridian"
scheme dark
screens 1
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#07020f"
  well "#0e0520"
  panel "#1b0f36"
  panelHover "#26164a"
  panelRaised "#1b0f36"
  line "#4a2f86"
  lineStrong "#b18cff"
  ink "#fbefff"
  inkMuted "#cdb6ea"
  inkFaint "#8d76ad"
  inkInverse "#07020f"
  control "#7a4fe6"
  controlStrong "#7650d8"
  primary "#d4127f"
  primaryHover "#e0258f"
  primaryActive "#b80e6d"
  onPrimary "#fbefff"
  primarySoft "#c81ebc40"
  highlight "#ff8ac8"
  focus "#36e8ff"
  knob "#5a3aa6"
  hud "#1b0f36"
  scrim "#030008cc"
  shadow "#000000aa"
  sheen "#ffffff52"
  success "#3dffb0"
  warn "#ffd23d"
  danger "#ff3d6e"
  info "#36e8ff"
  health "#3dffb0"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#c81ebc"
}
colors {
  success icon "check"
  warn pattern stripes
  danger pattern chevrons
  info pattern waves
  common "#9a8ab8" pips 1
  uncommon "#3dffb0" pips 2
  rare "#36e8ff" pips 3
  epic "#c86bff" pips 4
  legendary "#ffd23d" pips 5
  mythic "#ff3d6e" pips 6
  team1 "#36e8ff"
  team2 "#ff3d6e"
  team3 "#3dffb0"
  team4 "#ffd23d"
  team5 "#c86bff"
  team6 "#ff8a3d"
  team7 "#5cfff0"
  team8 "#ff6af2"
  physical "#cdb6ea" pattern hatch
  fire "#ff6a3d" icon "fire"
  ice "#7ff4ff" icon "drop"
  lightning "#fff03d" icon "bolt"
  poison "#9dff5c" pattern dots
  holy "#fff4d0" icon "star"
  shadow "#9a6aff" pattern grid
  arcane "#ff6af2" pattern diamonds
  series1 "#36e8ff"
  series2 "#ff3df2"
  series3 "#ffd23d"
  series4 "#3dffb0"
  series5 "#c86bff"
  series6 "#ff8a3d"
  series7 "#5cfff0"
  series8 "#ff3d6e"
}
typography {
  # Added by og upgrade: what displayXl2 drew before typography (docs/ui.md §17.4).
  hero 56 60 -0.025 700 display
  display 50 54 0.02 700 display {
    phonePortrait 40 43
    phoneLandscape 45 49
  }
  title 32 36 0.02 700 display {
    phonePortrait 28 32
    phoneLandscape 30 34
  }
  heading 22 28 0 700 display
  body 15 20 0 700 body
  label 15 20 0.04 700 body
  caption 13 18 0 700 body
  numeric 19 24 0.02 600 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 3
  sm 6
  md 10
  lg 14
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.6
  regular 2
  thick 2.6
  focus 2
}
elevation {
  raised {
    shadow 0 4 12 0 "#00000080"
  }
  floating {
    shadow 0 4 14 0 "#00000099"
    shadow 0 0 8 0 "#c81ebc33"
  }
  overlay {
    shadow 0 6 18 0 "#000000a0"
    shadow 0 0 14 0 "#c81ebc40"
  }
  top {
    shadow 0 8 24 0 "#000000b0"
    shadow 0 0 18 0 "#c81ebc4d"
  }
}
shape {
  panel round 10
  dialog round 14
  card round 10
  tooltip round 6
  button squircle 6
  field round 6
  chip round pill
  badge round pill
  tab squircle 6
  slot round 6
  bar round 6
  hud round 10
  avatar round pill
}
# Legacy ramp archived by og upgrade; edit typography (docs/ui.md §17.4).
# ramp {
#   body 15 20
#   meta 13 18
#   caption 13 18
#   lg 19 24
#   xl 22 28
#   xl2 26 30
#   xl3 30 34
#   displaySm 32 36
#   displayMd 40 44
#   displayLg 50 54
# }
fonts {
  body "Rajdhani-Bold.ttf"
  display "ChakraPetch-BoldItalic.ttf"
  numeric "ChakraPetch-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
corner 320 104 32 32 20 20 primary 2
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 36 16 primary 0
tile 204 172 64 64 48 48 0.05 10
textGlow display 1.4 primary 0.45
motion {
  enter pop
  toast slideLeft
  progress 260
  shake 7
  pop 0.16
  spring ui 140 0.1
  spring panel 260 0.15
  spring emphasis 380 0.3
  spring playful 460 0.4
  ease standard 0.3 0 0.1 1
  ease enter 0.12 1 0.3 1
  ease exit 0.5 0 0.9 0.3
  ease emphasis 0.3 1.6 0.6 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 380
  duration spring 520
  duration bounce 640
  stagger 35
  staggerCap 280
  overshoot 0.12
}
sounds {
  hover none volume 0.4 0.5 pitch 0.98 1.04 haptic tick
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none pitch 1 1.5 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none pitch 1 1.3 haptic 0 30 0.3 0.8 60 30 0.3 0.8 120 60 0.6 1
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 22 authored
  tone 0.006 0.003 0.018 0.93
  shadow 0 6 18 0 "#000000a0"
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 14 tint
  tone 0.010 0.010 0.010 0.86
  corners
}
dress "Button.base" {
  slice 172 4 48 48 16 tint
  tone 0.040 0.040 0.040 0.90
  glow 4 primary 0.22
  press 0.96 0.96 0
  hover 0 1.04
}
dress "Button.base[hover]" {
  slice 224 4 48 48 16 tint
  tone 0.084 0.084 0.084 0.94
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 16 tint
  tone 0.262 0.262 0.262 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 16 tint
  tone 0.027 0.027 0.027 0.80
}
dress "Field.frame" {
  slice 4 104 48 48 10 tint
  tone 0.007 0.007 0.007 0.94
}
dress "Slot.frame" {
  slice 56 104 48 48 12 tint
  tone 0.014 0.014 0.014 0.88
  glow 3 focus 0.16
}
dress "Tooltip.frame" {
  slice 108 104 32 32 10 tint
  tone 0.014 0.014 0.014 0.94
}
dress "Hud.frame" {
  slice 144 104 32 32 14 tint
  tone 0.014 0.014 0.014 0.90
}
dress "Meter.track" {
  slice 180 104 32 16 6 tint
  tone 0.034 0.034 0.034 0.90
}
dress "Meter.fill" {
  slice 216 104 32 16 6 tint
  tone 0.791 0.791 0.791 1.00
}
