type screen
version 1
---
# Hollowbell's title, ejected from the library's main-menu (og ui eject
# main-menu) and made the game's own: the game's name and its line in a
# card in the middle of the frame, Continue (primary with a save, disabled
# without), New game and Settings, and the keys under them in the card,
# as the title shipped (the card on the style's panel frame in its hud
# fill). Every word is a key of assets/strings/<locale>.ogt.
#
# Viewmodel: canContinue. Events to code: continue, new, settings. src/ui.ts mounts it
# while the title is the screen. It has no entrance, so the title the game
# opens on is built settled (the web draws it behind the play gate).
name "main-menu"
layer menu
under none
back none
focus "Card/Items/new"
props {
  canContinue bool "A save exists: Continue is live and the primary."
}
actions {
  confirm "Select"
}
fixture default "{\"canContinue\": true}"
column Title {
  width grow
  height grow
  align center
  cross center
  at phone {
    align end
  }
  column Card {
    width 380
    padding 24
    gap 24
    cross center
    background token hud
    frame panel
    at phone {
      width grow
      padding 16
    }
    column Heading {
      width grow
      gap 4
      cross center
      label Title {
        key "title.name"
        text "Hollowbell"
        step displayLg
        font display
        textAlign center
        width grow
        heading true
        at phone {
          step displayMd
        }
      }
      label Subtitle {
        key "title.tagline"
        text "Three chimes were carried under the hill"
        color token inkMuted
        textAlign center
        width grow
      }
    }
    column Items {
      width grow
      gap 8
      cross stretch
      if "canContinue" {
        button continue {
          key "title.continue"
          text "Continue"
          variant primary
          size large
          width grow
          autofocus true
          on click emit continue
        }
      }
      if "!canContinue" {
        button continue {
          key "title.continue"
          text "Continue"
          size large
          width grow
          disabled true
        }
      }
      if "!canContinue" {
        button new {
          key "title.new"
          text "New game"
          variant primary
          size large
          width grow
          autofocus true
          on click emit new
        }
      }
      if "canContinue" {
        button new {
          key "title.new"
          text "New game"
          size large
          width grow
          on click emit new
        }
      }
      button settings {
        key "title.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
    }
    label Footer {
      key "title.footer"
      text "Arrows run · Space jump · X strike · Down drop · Up talk · Esc pause"
      step meta
      color token inkFaint
      textAlign center
      width grow
    }
  }
}
