type screen
version 1
---
# Old Burrow's wares, ejected from the library's vendor (og ui eject vendor,
# renamed shop) and made the game's own, laid out as the shop shipped: one
# tab of three wares, so no tabs, no selling and no amounts. A panel with
# its title, the purse in glimmers on the style's hud frame at the end of
# the bar, then the wares and the selected one's name, line, price and Buy.
# Short of the price, Buy reads Not enough and a press shakes it with the
# error sound, buying nothing. Every word is a key of
# assets/strings/<locale>.ogt.
#
# Viewmodel: glimmers. Events to code: back (Escape, the pad's B). Slots:
# Amount takes og.ui.counter (the purse counting to its new value), Body
# the wares' og.ui.grid (plain cells, the style's own selection) and the
# selected ware's column with Buy (src/ui.ts, shop).
name "shop"
layer menu
under dim
back emit back
props {
  glimmers number "The purse."
}
actions {
  confirm "Buy"
  back "Leave"
}
fixture default "{\"glimmers\": 8}"
column Shop {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 760
    padding 24
    gap 12
    background token panelRaised
    frame panel
    enter slideDown 24 token enter
    label Title {
      key "shop.title"
      text "Old Burrow's wares"
      step xl
      heading true
    }
    row Bar {
      width grow
      gap 8
      align spaceBetween
      cross center
      wrap true
      spacer Gap {
      }
      row Balance {
        height 32
        padding 12 0
        gap 8
        cross center
        background token hud
        frame hud
        icon Icon {
          icon coin
          iconSize 18
          color token gold
        }
        slot Amount {
        }
        label Unit {
          key "shop.currency"
          text "glimmers"
          step base
          color token inkMuted
          nowrap true
        }
      }
    }
    slot Body {
      width grow
    }
  }
}
