type terrain
version 1
---
# The cliff-top meadow (tools/make-terrain.ts makes the maps): 160 m square,
# a meadow at y 900 that ends in a broken cliff falling into the clouds.
heightmap "meadow.png"
height 580 910
size 160 160
control "meadow-control.png"
heightBlend 0.2
castShadows true
# Meadow grass (control R).
layer {
  albedo "textures/grass.png"
  tile 5
  roughness 0.95
  slope 0 38
  slopeFade 8
}
# Grass with wildflowers along the edge (control G).
layer {
  albedo "textures/flowers.png"
  tile 5
  roughness 0.95
  slope 0 38
  slopeFade 8
}
# The cliff's rock, projected three ways, wherever it is steep (control B):
# horizontal sandstone strata like the authored cliff stack's, so a face seen
# edge-on from the close shot shows bands across its slope (the isotropic
# rock.png foreshortened into streaks down it, at any anisotropy). Tinted to
# the stack's mean albedo (models/cliff.glb, linear 0.26 0.25 0.15 against
# the strata's 0.47 0.28 0.19), so the wall and the stack read as one cliff.
layer {
  albedo "textures/rock-strata.png"
  color 0.55 0.89 0.81
  tile 12
  roughness 0.9
  triplanar true
  slope 34 90
  slopeFade 8
}
# Worn earth on the outcrop (control A).
layer {
  albedo "textures/dirt.png"
  tile 3
  roughness 1
  slope 0 38
  slopeFade 8
}
