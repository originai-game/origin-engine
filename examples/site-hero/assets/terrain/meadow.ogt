type terrain
version 1
---
# The cliff-top meadow (tools/make-terrain.ts makes the maps): 160 m square,
# a meadow at y 900 that ends in a broken cliff falling into the clouds.
heightmap "meadow.png"
height 580 910
size 160 160
control "meadow-control.png"
heightBlend 0.2
castShadows true
# Meadow grass (control R).
layer {
  albedo "textures/grass.png"
  tile 5
  roughness 0.95
  slope 0 38
  slopeFade 8
}
# Grass with wildflowers along the edge (control G).
layer {
  albedo "textures/flowers.png"
  tile 5
  roughness 0.95
  slope 0 38
  slopeFade 8
}
# The cliff's rock, projected three ways, wherever it is steep (control B).
# Tinted to the authored cliff stack's mean albedo (models/cliff.glb, linear
# 0.26 0.25 0.15 against rock.png's 0.37 0.35 0.30), so the height field's
# wall and the stack in front of it read as one warm sandstone cliff rather
# than a pale grey sheet behind it.
layer {
  albedo "textures/rock.png"
  color 0.7 0.72 0.5
  tile 9
  roughness 0.9
  triplanar true
  slope 34 90
  slopeFade 8
}
# Worn earth on the outcrop (control A).
layer {
  albedo "textures/dirt.png"
  tile 3
  roughness 1
  slope 0 38
  slopeFade 8
}
