type style
version 2
---
# site: the cinematic look, generated by og style new (docs/ui.md §12.5) for "a live ocean hero: a thin glass control bar over a sea at dusk".
# Choices: scheme dark, seed #f2a65a, shape pill, ornament none, motion calm, finish glass.
name "site"
scheme dark
palette {
  backdrop "#19130d"
  well "#120d09"
  panel "#2f2820"
  panelHover "#403932"
  panelRaised "#39332b"
  line "#544e46"
  lineStrong "#97918b"
  ink "#fefaf5"
  inkMuted "#d1cec8"
  inkFaint "#b8b5af"
  inkInverse "#2f2820"
  control "#3d372f"
  controlStrong "#4c453e"
  primary "#f3aa61"
  primaryHover "#f4b16e"
  primaryActive "#f5b87a"
  onPrimary "#352514"
  primarySoft "#f3aa6138"
  highlight "#fcecdb"
  focus "#f3ad68"
  knob "#58524b"
  hud "#2f2820f0"
  scrim "#0d0a07b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f1b558"
  danger "#ec9f9b"
  info "#8cbaeb"
  health "#64d877"
  mana "#88b7f5"
  xp "#cca2e7"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#ad4cf0" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a54bff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8c5ff6"
  arcane "#ff4fd8"
  series1 "#5780ab"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 12
  sm 22
  md 24
  lg 36
  xl 48
  pill 9999
}
stroke {
  hairline 1.5
  thin 2
  regular 2.5
  thick 3.5
  focus 2.5
}
elevation {
  raised {
    shadow 0 2 6 0 "#0000002b"
    shadow 0 1 2 0 "#0000001f"
  }
  floating {
    shadow 0 4 12 0 "#00000031"
    shadow 0 1 2 0 "#0000001f"
  }
  overlay {
    shadow 0 8 24 0 "#00000038"
    shadow 0 1 2 0 "#0000001f"
  }
  top {
    shadow 0 14 36 0 "#0000003e"
    shadow 0 1 2 0 "#0000001f"
  }
}
shape {
  panel round 24
  dialog round 28.8
  card round 19.2
  tooltip round 12
  button round pill
  field round pill
  chip round pill
  badge round pill
  tab round 17.6
  slot round 18
  bar round pill
  hud round 22
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/InstrumentSans-Regular.ttf"
  display "@styles/shared/InstrumentSans-Regular.ttf"
  numeric "@styles/shared/PTMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/shared/ink-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter fade
  toast slideUp
  progress 460
  shake 4
  pop 0.04
  spring ui 220 0
  spring panel 380 0
  spring emphasis 480 0.06
  spring playful 560 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 120
  duration fast 200
  duration base 300
  duration slow 460
  duration spring 560
  duration bounce 680
  stagger 50
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.32 0.4 pitch 0.97 1.03 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.32 0.4 pitch 0.97 1.03 haptic tick
  confirm "sfx-confirm.ogt" volume 0.34 0.4 pitch 0.985 1.015 haptic tap
  cancel "sfx-back.ogt" volume 0.32 0.4 pitch 0.97 1.03 haptic tick
  back "sfx-back.ogt" volume 0.32 0.4 pitch 0.97 1.03 haptic tick
  open "sfx-open.ogt" volume 0.24 0.28 pitch 1.02 1.08 haptic none
  close "sfx-open.ogt" volume 0.2 0.24 pitch 0.82 0.88 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.28 0.36 pitch 1.12 1.18 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.24 0.28 pitch 1.17 1.23 haptic tick
  toggleOff "sfx-back.ogt" volume 0.24 0.28 pitch 1.07 1.13 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.2 pitch 1.34 1.46 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.08 0.12 pitch 1.51 1.69 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.18 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.28 0.32 pitch 1.27 1.33 haptic tap
  warning "sfx-error.ogt" volume 0.24 0.28 pitch 1.22 1.28 haptic warning
  error "sfx-error.ogt" volume 0.32 0.4 pitch 0.985 1.015 haptic error
  success "sfx-reward.ogt" volume 0.32 0.4 pitch 1.085 1.115 haptic success
  reward "sfx-reward.ogt" volume 0.36 0.4 pitch 0.985 1.015 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.24 0.28 pitch 0.87 0.93 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.28 0.32 pitch 0.92 0.98 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.32 0.36 pitch 1.12 1.18 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.34 0.4 pitch 0.885 0.915 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.36 0.4 pitch 0.785 0.815 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.4 0.4 pitch 0.685 0.715 haptic thud
}
dress "Button.base" {
  press 0.98 0.98 1
  hover -1 1
  stroke 1 "#ffffff33" inside
}
dress "Panel.frame" {
  fill "#2f2820d1"
  effect backdrop 18 saturation 1.3 tint "#2f282066"
  stroke 1 "#ffffff2e" inside
}
dress "Card.frame" {
  fill linear 160 "#39332beb" "#2f2820e0"
  stroke 1 "#ffffff24" inside
}
dress "Hud.frame" {
  effect backdrop 12 saturation 1.2 tint "#2f282080"
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#f3ad68" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
