type screen
version 1
---
# The Kestrel Stair's bag, ejected from the library's inventory (og ui
# eject inventory, renamed bag) and made the game's own: a panel over the
# held stair with the title and Close, the bag's twelve cells (the letter,
# the sigils carried, the hillwort) and beside them the selected item's
# name, its line, its count and Use, or the hint while none is selected.
# No filters, sort, weight or breadcrumb: one bag, a handful of things.
# Every word is a key of assets/strings/<locale>.ogt or a line the game
# says from them.
#
# Viewmodel: chosen (an item is selected), name, about, count (shown from
# 2), usable (Use shows). Events to code: use, close (Close and Back).
# Slots: Grid takes og.ui.inventoryGrid (src/ui.ts `bag`: drag to move,
# a press selects, a double press uses).
name "bag"
layer menu
under dim
back emit close
focus "Panel/Body/Grid"
props {
  chosen bool "An item is selected: its detail shows."
  name string "The selected item's name."
  about string "Its line."
  count number "How many (shown from 2)."
  usable bool "Use shows (the hillwort)."
}
actions {
  confirm "Select"
  back "Close"
}
fixture default "{\"chosen\": true, \"name\": \"Hillwort\", \"about\": \"Bitter leaves. Restores 40 strength.\", \"count\": 2, \"usable\": true}"
column Screen {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 760
    padding 24
    gap 16
    frame panel
    enter slideUp 24 token enter
    at phone {
      padding 12
      gap 8
    }
    row Header {
      width grow
      gap 12
      cross center
      label Title {
        key "bag.title"
        text "Bag"
        step xl2
        font display
        heading true
        width grow
      }
      button Close {
        key "bag.close"
        text "Close"
        variant quiet
        on click emit close
      }
    }
    row Body {
      width grow
      gap 16
      wrap true
      slot Grid {
      }
      column Detail {
        width grow
        gap 8
        label Hint {
          key "bag.hint"
          text "Choose an item. Drag it to another slot to move it."
          step meta
          color token inkMuted
          width grow
          visible bind "!chosen"
        }
        label Name {
          text bind name
          step lg
          width grow
          visible bind chosen
        }
        label About {
          text bind about
          step meta
          color token inkMuted
          width grow
          visible bind chosen
        }
        row Count {
          width grow
          gap 12
          visible bind "chosen && count > 1"
          label Key {
            key "bag.count"
            text "Count"
            color token inkMuted
            nowrap true
          }
          spacer
          label Value {
            text bind count
            font mono
            nowrap true
          }
        }
        button Use {
          key "bag.use"
          text "Use"
          variant primary
          width grow
          visible bind "chosen && usable"
          on click emit use
        }
      }
    }
  }
}
