type screen
version 1
---
# The Kestrel Stair's bag, ejected from the library's inventory (og ui
# eject inventory, renamed bag) and made the game's own, laid out as the
# game shipped it: a dialog panel 752 px wide in the middle of the held
# stair, its title, the bag's twelve slots six a row (the letter, the
# sigils carried, the hillwort) and beside them the selected item's name,
# its line, its count and Use, or the hint while none is selected.
# Every word is a key of assets/strings/<locale>.ogt or a line the game
# says from them.
#
# Viewmodel: none. Events to code: close (Back). Slots: Body takes the
# slots (og.ui.grid) and the detail beside them (src/ui.ts `bag`: a press
# selects, a drag moves, Use eats).
name "bag"
layer menu
under dim
back emit close
actions {
  confirm "Select"
  back "Close"
}
column Screen {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width 752
    padding 24
    gap 12
    background token panelRaised
    radius 6
    frame panel
    enter slideUp 24 token enter
    at phone {
      width grow
    }
    label Title {
      key "bag.title"
      text "Bag"
      step xl
      heading true
    }
    slot Body {
      width grow
    }
  }
}
