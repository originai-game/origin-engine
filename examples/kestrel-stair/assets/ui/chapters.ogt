type screen
version 1
---
# The Kestrel Stair's chapters, ejected from the library's saga-map (og ui
# eject saga-map, renamed chapters) and made the game's own, laid out as
# the game shipped them: a dialog panel 720 px wide in the middle of the
# title, its title, the stars earned of all, the four chapters as two
# wide cards a row (each named whole, its stars; one not yet reached a
# lock, refused) and Back. Every word is a key of
# assets/strings/<locale>.ogt or a line the game says from them.
#
# Viewmodel: none. Events to code: back (a tap on the scrim, Escape, the
# pad's B). Slots: Body takes the stars line, the cards (og.ui.grid) and
# Back (src/ui.ts `chapters`: a card pressed starts its chapter).
name "chapters"
layer menu
under dim
back emit back
actions {
  confirm "Play"
  back "Back"
}
column Screen {
  width grow
  height grow
  padding 16
  align center
  cross center
  interactive true
  on click emit back
  column Panel {
    width 720
    padding 24
    gap 12
    background token panelRaised
    radius 6
    frame panel
    interactive true
    enter slideUp 24 token enter
    at phone {
      width grow
    }
    label Title {
      key "chapters.title"
      text "Chapters"
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
  }
}
