type screen
version 1
---
# The Kestrel Stair's title, ejected from the library's main-menu (og ui
# eject main-menu) and made the game's own: the game's name and its line
# in a card in the middle of the frame, Continue (only with a save, naming
# its place and hour, then primary and focused), New journey, Chapters,
# Records and Settings, and the keys under them in the card, as the
# game shipped. Every
# word is a key of assets/strings/<locale>.ogt or a line the game says
# from them.
#
# Viewmodel: hasSave, continueLine (Continue's words: the place and the
# hour). Events to code: continue, new, chapters, records, settings.
# src/ui.ts mounts it while the title is the screen. No entrance: the
# title the game opens on is drawn settled behind the web's play gate.
name "main-menu"
layer menu
under none
back none
props {
  hasSave bool "The save slot answered: Continue shows, primary and focused."
  continueLine string "Continue's words (Continue · The Crypt Terrace, 16:30)."
}
actions {
  confirm "Select"
}
fixture default "{\"hasSave\": true, \"continueLine\": \"Continue · The Crypt Terrace, 16:30\"}"
column Title {
  width grow
  height grow
  align center
  cross center
  at phone {
    align end
  }
  column Card {
    width 380
    padding 24
    gap 24
    cross center
    background token hud
    frame panel
    radius 6
    at phone {
      width grow
      padding 16
    }
    column Heading {
      width grow
      gap 4
      cross center
      label Title {
        key "title.name"
        text "The Kestrel Stair"
        step displayLg
        font display
        textAlign center
        width grow
        heading true
        at phone {
          step displayMd
        }
      }
      label Subtitle {
        key "title.tagline"
        text "Carry the letter to the summit bell before nightfall"
        color token inkMuted
        textAlign center
        width grow
      }
    }
    column Items {
      width grow
      gap 8
      cross stretch
      focusGroup wrap
      if "hasSave" {
        button continue {
          text bind continueLine
          variant primary
          size large
          width grow
          autofocus true
          on click emit continue
        }
        button new {
          key "title.new"
          text "New journey"
          size large
          width grow
          on click emit new
        }
      }
      if "!hasSave" {
        button new {
          key "title.new"
          text "New journey"
          variant primary
          size large
          width grow
          autofocus true
          on click emit new
        }
      }
      button chapters {
        key "title.chapters"
        text "Chapters"
        size large
        width grow
        on click emit chapters
      }
      button records {
        key "title.records"
        text "Records"
        size large
        width grow
        on click emit records
      }
      button settings {
        key "title.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
    }
    label Footer {
      key "title.footer"
      text "WASD move · Shift run · Space jump · J strike · F use · Tab bag · Q/E turn · Esc pause"
      step meta
      color token inkFaint
      textAlign center
      width grow
    }
  }
}
