type screen
version 1
---
# The Kestrel Stair's records, ejected from the library's leaderboard (og
# ui eject leaderboard) and made the game's own, laid out as the game
# shipped them: a dialog panel 520 px wide in the middle of the frame,
# its title, the two scopes as tabs (the fastest ascents, the ones round
# the courier) and under them the rows (the courier's lit, ranks 1 to 3 on
# medals), the loading rows, the error with Try again, or the empty line.
# Every word is a key of assets/strings/<locale>.ogt or a line the game
# says from them.
#
# Viewmodel: none. Events to code: back (Escape, the pad's B). Slots: Body
# takes the tabs and the rows (src/ui.ts `records`).
name "leaderboard"
layer menu
under dim
back emit back
actions {
  confirm "Select"
  back "Back"
}
column Board {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width 520
    padding 24
    gap 12
    background token panelRaised
    radius 6
    frame panel
    enter slideUp 24 token enter
    at phone {
      width grow
    }
    label Title {
      key "records.title"
      text "Records"
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
  }
}
