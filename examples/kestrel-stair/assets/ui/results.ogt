type screen
version 1
---
# The Kestrel Stair's results, ejected from the library's results (og ui
# eject results) and made the game's own, laid out as the game shipped
# them: a dialog panel 420 px wide in the middle of the frame, its title
# (how the climb ended), and in its Body slot the stars,
# the score counting up, the best and the New record badge when it lands,
# the time, the sigils, the foes and the hillwort eaten as rows, and
# Again, Records and Title. Every word is a key of
# assets/strings/<locale>.ogt or a line the game says from them.
#
# Viewmodel: title. Events to code: none. Slots: Body takes the stars
# landing one by one, the score counting up, the best and the New record
# badge, the rows and Again, Records and Title (src/ui.ts `results`).
name "results"
layer menu
under dim
back none
props {
  title string "How the run ended."
}
actions {
  confirm "Select"
}
fixture default "{\"title\": \"The bell rings\"}"
column Results {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width 420
    padding 24
    gap 12
    background token panelRaised
    radius 6
    frame panel
    enter slideUp 24 token enter
    at phone {
      width 360
    }
    label Title {
      text bind title
      step xl
      heading true
    }
    slot Body {
      width grow
      gap 12
    }
  }
}
