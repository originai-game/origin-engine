type style
version 2
---
# Upgraded to version 2 by og style upgrade: its version 1 values kept, the new tokens derived from its palette and scheme (docs/ui.md §12).
name "kestrel"
scheme light
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#efe6d2"
  well "#e4d9c1"
  panel "#fbf8f0"
  panelHover "#f3eee2"
  panelRaised "#fbf8f0"
  line "#cfc6b2"
  lineStrong "#1c1a17"
  ink "#1c1a17"
  inkMuted "#57524a"
  inkFaint "#57524a"
  inkInverse "#fbf8f0"
  control "#efe9dc"
  controlStrong "#e2dac8"
  primary "#9c2a1d"
  primaryHover "#8f2618"
  primaryActive "#7f2013"
  onPrimary "#fffaf3"
  primarySoft "#a02b1a26"
  highlight "#86210f"
  focus "#2b5cc8"
  knob "#fbf8f0"
  hud "#fbf8f0f5"
  scrim "#2a261f73"
  shadow "#2a261f40"
  sheen "#ffffff52"
  success "#1a6034"
  warn "#7b4802"
  danger "#8e1d16"
  info "#1c4bb6"
  health "#1a6034"
  mana "#007aff"
  xp "#af52de"
  gold "#9c2a1d"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#909090" pips 1
  uncommon "#36a444" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#e17100" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#36a452"
  team4 "#b28b12"
  team5 "#a347ff"
  team6 "#da761b"
  team7 "#19a0a0"
  team8 "#f056a5"
  physical "#968f82"
  fire "#f16429"
  ice "#4999bd"
  lightning "#a88e26"
  poison "#5da040"
  holy "#9d8f63"
  shadow "#8a5cf6"
  arcane "#f04bcc"
  series1 "#4e79a7"
  series2 "#d17b25"
  series3 "#e15759"
  series4 "#639a96"
  series5 "#59a04f"
  series6 "#a88e33"
  series7 "#b07aa1"
  series8 "#c77b83"
}
typography {
  display 48 54 0 700 display {
    phonePortrait 38 43
    phoneLandscape 43 49
  }
  title 30 36 0 700 display {
    phonePortrait 26 32
    phoneLandscape 28 34
  }
  heading 22 30 0 600 display
  body 15 22 0 400 body
  label 13 18 0 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 600 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 4
  md 6
  lg 9
  xl 12
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 3 8 0 "#2a261f2e"
  }
  floating {
    shadow 0 2 6 0 "#2a261f33"
  }
  overlay {
    shadow 0 6 16 0 "#2a261f3a"
  }
  top {
    shadow 0 9 24 0 "#2a261f3a"
  }
}
shape {
  panel round 6
  dialog round 6
  card round 6
  tooltip round 6
  button round 4
  field round 4
  chip round 4
  badge round 4
  tab round 4
  slot round 4
  bar round 4
  hud round 4
  avatar round 4
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 30
  xl2 26 32
  xl3 30 36
  displaySm 30 36
  displayMd 38 44
  displayLg 48 54
}
fonts {
  body "InstrumentSans-Regular.ttf"
  display "Newsreader-SemiBold.ttf"
  numeric "PTMono-Regular.ttf"
  fallback "fonts/NotoSansJP-kestrel.otf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 120 18 ink
flourish 136 172 64 24 22 10 primary 2
tile 204 172 64 64 64 64 0.6 4
motion {
  enter slideUp
  toast slideUp
  progress 380
  shake 5
  pop 0.08
  spring ui 180 0
  spring panel 260 0
  spring emphasis 420 0.15
  spring playful 520 0.3
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 120
  duration fast 180
  duration base 260
  duration slow 420
  duration spring 520
  duration bounce 640
  stagger 40
  staggerCap 300
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 12 tint
  shadow 0 6 16 0 "#2a261f3a"
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 10 tint
  shadow 0 3 8 0 "#2a261f2e"
  tile
}
dress "Button.base" {
  slice 172 4 48 48 12 tint
  shadow 0 2 4 0 "#2a261f33"
  press 0.98 0.98 1
  hover -1 1.0
}
dress "Button.base[hover]" {
  slice 224 4 48 48 12 tint
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 12 tint
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 12 tint
}
dress "Field.frame" {
  slice 4 104 48 48 8 tint
}
dress "Slot.frame" {
  slice 56 104 48 48 8 tint
}
dress "Tooltip.frame" {
  slice 108 104 32 32 8 tint
  shadow 0 2 6 0 "#2a261f33"
}
dress "Hud.frame" {
  slice 144 104 32 32 14 tint
  shadow 0 2 6 0 "#2a261f33"
}
dress "Meter.track" {
  slice 180 104 32 16 7 tint
}
dress "Meter.fill" {
  slice 216 104 32 16 7 tint
}
