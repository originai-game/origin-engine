type strings
version 1
---
# The Kestrel Stair's Japanese strings (og.i18n); the font is Noto Sans JP
# subset to these characters by tools/subset-font.py (og-i18n §3).
locale "ja"
fonts "fonts/NotoSansJP-kestrel.otf"
string "title.name" "隼の階段"
string "title.tagline" "日暮れまでに、手紙を山頂の鐘へ届けよ"
string "title.continue" "つづきから · {place}、{clock}"
string "title.new" "新しい旅"
string "title.chapters" "章をえらぶ"
string "title.records" "記録"
string "title.settings" "設定"
string "title.footer" "WASD 移動 · Shift 走る · Space 跳ぶ · J 斬る · F 使う · Tab 鞄 · Q/E 視点 · Esc 一時停止"
string "place.court" "下の中庭"
string "place.terrace" "地下墓所のテラス"
string "place.high" "高いテラス"
string "place.gate" "山頂の門"
string "chapter.court" "I"
string "chapter.terrace" "II"
string "chapter.high" "III"
string "chapter.gate" "IV"
string "chapters.title" "章"
string "hud.health" "体力"
string "hud.sigils" "{n}/3"
string "hud.bag" "鞄"
string "hud.pause" "一時停止"
string "prompt.sigil" "F · 紋章を取る"
string "prompt.herb" "F · 薬草を摘む"
string "prompt.waystone" "F · 道標石で休む"
string "prompt.gate" "F · 門を上げる"
string "prompt.gateShut" "門には紋章が三つ必要だ（{n}/3）"
string "prompt.bell" "F · 鐘を鳴らす"
string "toast.sigil" "{n, plural, other {紋章 #/3}}"
string "toast.herb" "薬草を摘んだ"
string "toast.healed" "体力が戻った"
string "toast.saved" "{place}で休んだ。道標石が覚えている"
string "toast.gate" "山頂の門が上がる"
string "toast.noHerb" "鞄に薬草がない"
string "toast.full" "体力は満ちている"
string "toast.welcome" "階段に戻った · {place}"
string "toast.warden" "番兵に見つかった"
string "toast.drop" "番兵が紋章を落とした"
string "pause.title" "一時停止"
string "pause.resume" "再開"
string "pause.bag" "鞄"
string "pause.settings" "設定"
string "pause.quit" "休んで終わる"
string "bag.title" "鞄"
string "bag.use" "使う"
string "item.letter" "封をした手紙"
string "item.letter.about" "院長から、山頂の鐘守へ。"
string "item.sigil0" "墓所の紋章"
string "item.sigil0.about" "地下墓所の祭壇にあった冷たい青銅。"
string "item.sigil1" "岩棚の紋章"
string "item.sigil1.about" "岩棚の上、チョウゲンボウの巣のそばで見つけた。"
string "item.sigil2" "番兵の紋章"
string "item.sigil2.about" "石の番兵の胸に収められていた。"
string "item.herb" "薬草"
string "item.herb.about" "苦い葉。体力が40戻る。"
string "records.title" "記録"
string "records.fastest" "最速"
string "records.around" "あなたの周り"
string "records.empty" "まだ記録がない"
string "records.error" "記録を読めなかった"
string "records.you" "あなた"
string "records.courier" "使者 {n}"
string "results.won" "鐘が鳴る"
string "results.night" "夜が来た"
string "results.fallen" "階段に倒れた"
string "results.best" "最高 {best}"
string "results.newBest" "新記録"
string "results.time" "時間"
string "results.sigils" "紋章"
string "results.foes" "倒した敵"
string "results.herbs" "食べた薬草"
string "results.again" "もう一度"
string "results.records" "記録"
string "results.title" "タイトル"
string "intro.abbess" "院長マレン"
string "intro.courier" "イルゼ"
string "intro.1" "使者よ、山頂の鐘守がこの手紙を待っています。"
string "intro.2" "古い階段は荒れています。中庭には茨の小鬼、テラスには石の番兵が。"
string "intro.3" "山頂の門は紋章三つで上がる。必ず見つけます。"
string "intro.4" "日暮れまでに行きなさい。道標石で休むのです。あなたを覚えています。"
string "end.keeper" "鐘守オズウィン"
string "end.1" "こんな時刻に使者が？階段をずっと登ってきたのか。"
string "end.2" "院長からです。朝まで待てない手紙でした。"
string "end.3" "では、鐘が院長の返事を谷へ運ぼう。"
string "tut.health.title" "体力"
string "tut.health.text" "小鬼は噛み、番兵は叩きつぶす。薬草と道標石で回復する。"
string "tut.sigils.title" "三つの紋章"
string "tut.sigils.text" "墓所に一つ、岩棚の上に一つ、番兵の胸に一つ。"
string "tut.clock.title" "日暮れ"
string "tut.clock.text" "七時半までに山頂の鐘を鳴らせ。"
string "tut.bag.title" "鞄"
string "tut.bag.text" "Tab で開く。薬草を食べ、持ち物を読む。"
