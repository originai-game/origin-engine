string "intro.abbess" "Abbess Maren"
string "intro.courier" "Ilse"
string "intro.1" "Courier, the bell-keeper on the summit waits for this letter."
string "intro.2" "The old stair is overrun: thorn imps in the court, stone wardens on the terraces."
string "intro.3" "Three sigils raise the summit gate. I will find them."
string "intro.4" "Go before nightfall. Rest at the waystones: they remember you."
string "end.keeper" "Oswin the bell-keeper"
string "end.1" "A courier, at this hour? Up the whole stair?"
string "end.2" "From the Abbess. It could not wait for morning."
string "end.3" "Then the bell will carry her answer down the valley."
string "tut.health.title" "Your strength"
string "tut.health.text" "Imps bite and wardens crush. Hillwort and the waystones restore it."
string "tut.sigils.title" "Three sigils"
string "tut.sigils.text" "One in the crypt, one atop the ledges, one in a warden's chest."
string "tut.clock.title" "Nightfall"
string "tut.clock.text" "Ring the summit bell before half past seven."
string "tut.bag.title" "Your bag"
string "tut.bag.text" "Tab opens it: eat hillwort, read what you carry."
