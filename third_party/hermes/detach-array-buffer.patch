+/// Detaching an ArrayBuffer from native code: an embedder that hands
+/// JavaScript buffers over memory it owns (jsi::MutableBuffer) detaches them
+/// before that memory moves or is freed, so a kept typed array reads as
+/// empty instead of reaching it. The ECMAScript DetachArrayBuffer operation.
+class HERMES_EXPORT IHermesArrayBufferDetach : public jsi::ICast {
+ public:
+  static constexpr jsi::UUID uuid{
+      0x3b0d6c2e,
+      0x8f41,
+      0x4a6b,
+      0x9c1e,
+      0x5d2f7a90c413};
+  /// Detaches \p buffer; a detached one is left as it is.
+  virtual void detachArrayBuffer(const jsi::ArrayBuffer &buffer) = 0;
+
+ protected:
+  ~IHermesArrayBufferDetach() = default;
+};
