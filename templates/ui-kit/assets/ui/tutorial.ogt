type screen
version 1
---
# Tutorial and onboarding overlays (docs/ui.md Appendix B). A coach mark
# over the game: a scrim with the target left clear, a card beside it with
# the step's title, text and its art, the step's count, Next and Skip;
# the game's input passes through to the target when the step waits for
# the player to do it.
#
# The kit's copy (og ui eject): a Kit slot in the bottom end corner takes
# the kit's own chrome (the Gallery and the showcase's next page), clear
# of the HUD's top corners; the card is the pack's panel over a 40 %
# scrim, so its copy reads over any scene.
#
# Viewmodel: title, text, step, steps, waits (the step waits for the
# player's action: no Next), x, y (where the card sits, CSS px from the
# top start). Events to code: next, skip. Slots: Highlight takes the
# target's ring or the scrim's hole (og.ui.shapeBox, og.ui.effectLayer);
# Hint takes the device's glyph for what to press (og.ui.actionHints).
name "tutorial"
layer popover
under none
back emit skip
props {
  title string "The step's title."
  text string "What to do."
  step number "The step, from 1."
  steps number "Steps in the lesson."
  waits bool "The step waits for the player to act (Next hidden)."
  x number "The card's left, CSS px."
  y number "The card's top, CSS px."
  texture number "The step's art (0: none)."
}
actions {
  confirm "Next"
  back "Skip"
}
fixture default "{\"title\": \"Dodge\", \"text\": \"Press the dodge button just before an attack lands to slip past it.\", \"step\": 2, \"steps\": 5, \"waits\": false, \"x\": 64, \"y\": 120, \"texture\": 0}"
stack Tutorial {
  width grow
  height grow
  column Scrim {
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
    background "#000000"
    opacity 0.4
  }
  slot Highlight {
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
  }
  column Card {
    position absolute
    start bind x
    top bind y
    width grow 0 360
    padding 16
    gap 8
    frame panel
    enter pop
    at phonePortrait {
      start 12
      end 12
      top bind y
    }
    art Art {
      kind tutorial
      width grow
      texture bind texture
      visible bind "texture != 0"
    }
    label Title {
      text bind title
      step lg
      heading true
    }
    label Text {
      text bind text
      step reading
      maxLines 5
    }
    slot Hint {
      width grow
    }
    row Foot {
      width grow
      gap 8
      cross center
      label Step {
        text "{step}/{steps}"
        step caption
        color token inkMuted
      }
      spacer
      button Skip {
        key "screen.tutorial.skip"
        text "Skip"
        variant quiet
        size small
        at phone {
          size medium
        }
        on click emit skip
      }
      button Next {
        key "screen.tutorial.next"
        text "Next"
        variant primary
        size small
        at phone {
          size medium
        }
        visible bind "!waits"
        on click emit next
        on action confirm emit next
      }
    }
  }
  slot Kit {
    position absolute
    end 16
    bottom 16
    at phone {
      end 8
      bottom 42
    }
  }
}
