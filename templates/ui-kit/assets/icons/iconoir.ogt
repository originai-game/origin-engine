type icons
version 1
---
# 64 game-UI glyphs of iconoir 7.12.1 (MIT, iconoir/LICENSE), cooked into
# a distance-field atlas like a font (og-cook cook::icons) for UiDesc.icons.font.
source "iconoir"
size 48
range 8
# Navigation and controls
icon "home"
icon "settings"
icon "play"
icon "pause"
icon "refresh"
icon "undo"
icon "menu"
icon "search"
icon "xmark"
icon "check"
icon "plus"
icon "minus"
icon "nav-arrow-left"
icon "nav-arrow-right"
icon "nav-arrow-up"
icon "nav-arrow-down"
# Sound
icon "sound-high"
icon "sound-off"
icon "music-double-note"
# Status
icon "info-circle"
icon "warning-triangle"
icon "help-circle"
icon "bell"
icon "lock"
icon "key"
icon "eye"
icon "eye-closed"
# Game items
icon "heart"
icon "star"
icon "coins"
icon "trophy"
icon "medal"
icon "crown"
icon "gift"
icon "shield"
icon "flash"
icon "fire-flame"
icon "potion"
icon "magic-wand"
icon "sparks"
icon "flask"
icon "cube"
icon "puzzle"
# Shop and people
icon "cart"
icon "shopping-bag"
icon "user"
icon "group"
icon "chat-bubble"
icon "share-android"
icon "leaderboard-star"
# World and time
icon "map"
icon "map-pin"
icon "compass"
icon "globe"
icon "clock"
icon "hourglass"
icon "timer"
# Other
icon "gamepad"
icon "dice-five"
icon "rocket"
icon "floppy-disk"
icon "trash"
icon "edit-pencil"
icon "language"
