type skin
version 1
---
# The cartoon style pack: generated by templates/ui-kit/tools/make-skins.py (CC0 art, OFL fonts; LICENSES.md).
name "cartoon"
base light
atlas "atlas.png" 384 256
scale 1
palette {
  bg "#2a1d5c"
  bgSubtle "#33246e"
  surface "#fff4dc"
  surfaceRaised "#fff4dc"
  surfaceHover "#ffe9bd"
  materialThick "#fff4dcf5"
  materialRegular "#fff4dcee"
  materialThin "#fff4dce0"
  fg "#2b1a4a"
  fgMuted "#5a4880"
  fgSubtle "#61527c"
  fgInverse "#fff4dc"
  fill "#fff3cc"
  fillStrong "#ffecb5"
  border "#2b1a4a"
  borderStrong "#2b1a4a"
  accent "#a24112"
  accentHover "#a94414"
  accentActive "#8c370e"
  accentFg "#fff4dc"
  accentInk "#b4430a"
  accentSoft "#a2411240"
  focus "#3fa7ff"
  thumb "#ffffff"
  scrim "#1a0f3ccc"
  success "#2fb85a"
  warn "#f2a516"
  danger "#6a0a16"
  info "#2f8ff0"
  shadow "#2b1a4a99"
}
radius {
  control 12
  field 14
  block 14
  card 18
  panel 28
  sheet 28
  button 9999
}
ramp {
  body 15 20
  meta 13 18
  caption 13 18
  lg 19 26
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 52 56
}
durations {
  instant 110
  fast 160
  base 280
  slow 420
}
fonts {
  body "Fredoka-SemiBold.ttf"
  display "LilitaOne-Regular.ttf"
  numeric "LilitaOne-Regular.ttf"
  fallback "fonts/NotoSansSC-Regular-subset.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 30 tint
slice card 104 4 64 64 20 tint
slice button 172 4 48 48 20 tint
slice buttonHover 224 4 48 48 20 tint
slice buttonPressed 276 4 48 48 20 tint
slice buttonDisabled 328 4 48 48 20 tint
slice field 4 104 48 48 16 tint
slice slot 56 104 48 48 16 tint
slice tooltip 108 104 32 32 13 tint
slice capsule 144 104 32 32 15 tint
slice track 180 104 32 16 7 tint
slice fill 216 104 32 16 7 tint
soft 252 104 64 64 24
divider 4 172 128 24 48 16 accent
flourish 136 172 64 24 22 10 accent 2
shadow panel 0 8 0 0 "#2b1a4acc"
shadow card 0 5 0 0 "#2b1a4a99"
shadow button 0 5 0 0 "#2b1a4acc"
shadow capsule 0 4 0 0 "#2b1a4a99"
shadow slot 0 3 0 0 "#2b1a4a66"
textShadow display 0 4 0 "#2b1a4a"
press 1.08 0.88 3
hover -3 1.04
motion {
  enter pop
  stagger 50
  toast pop
  progress 360
  shake 8
  pop 0.22
}
