type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset ascii cjk-punct
  chars "。あいかがきくこさしすずせただちつづてでとなにのはへべまみめもらりるれわをんアィイェエオカキギクグコゴシジスズセタッテデトドニハバビフブプベポマミムメャュョラリルレロン・ー一上下中了以低体作価個停元入内再冒冶出別削効動反古右周回場売失完定射小屋左度必感戻所手持振操数星時枚果枠格楽標次止残水況済減点物状率画発目確示祈秒移粉終行表製視言設試語読質購足車転農込逃進選鍛開除険音願高？"
  em_px 32
  px_range 4
}
