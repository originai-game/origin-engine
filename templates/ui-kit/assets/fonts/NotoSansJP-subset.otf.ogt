type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset ascii cjk-punct
  chars "。あいかきこさしすせちつづてでとなにのはべまみらりるれわをんィイエオキギクグコシジスセタッデトニハバフブプマミムメャュョラリルレロン・ー一上下中了低作価停元入再冒削効動反古売失完定小屋度感戻所持振操時枚果格楽止水況済減点物状画示終行表視言設語質購足車転進開除険音高？"
  em_px 32
  px_range 4
}
