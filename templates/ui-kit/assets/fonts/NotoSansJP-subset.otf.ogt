type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset ascii cjk-punct
  chars "。あいかきくこさしすせただちつづてでとなにのはへべまみめらりるれわをんアィイエオキギクグコシジスセタッテデトドニハバフブプマミムメャュョラリルレロン・ー一上下中了低作価個停元入再冒別削効動反古売失完定小屋度感戻所持振操数時枚果枠格楽次止水況済減点物状画示移終行表視言設試語読質購足車転込進選開除険音高？"
  em_px 32
  px_range 4
}
