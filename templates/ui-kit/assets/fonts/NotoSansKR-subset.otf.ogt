type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset ascii cjk-punct
  chars "가간감개갤거건격계고과구그기길까끌나낮너높뉴니다단대도돌동되된두디뛰라래량러레로롯료른를리릴마매메모못물반방버보부불비사삭상서선설세소속수스슬습시아악앗액어언없오옮완요움유으은을음의이인일임있작잔장저전점정제조족종줄중지직진질집취칸코퀘택터템통트판표프플픽하할했행험화황효"
  em_px 32
  px_range 4
}
