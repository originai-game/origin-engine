type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset ascii cjk-punct
  chars "가간감개갤거건격계고골과구그기길까끌나남낮너농높뉴니다단대도돌동되된두드디뛰라래랩량러레로롯료른를리릴마매메모목못물반발방버벨보부불브비빈사삭상서석선설세섹소속수스슬습시아악앗액어언없오옮완왼요움유으은을음의이인일임있작잔장저전점정제조족종줄중지직진질집쪽처초최취치카칸코퀘크택탭터템통트판표프플픽하할했행험화황효"
  em_px 32
  px_range 4
}
