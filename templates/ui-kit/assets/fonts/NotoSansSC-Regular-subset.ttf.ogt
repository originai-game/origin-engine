type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset latin cjk-punct
  chars "简体中文原点引擎设置。一下不东丢个中主乐买件价会低余作停全共冒减出分删到加动单卖即原反取另可向品商回图场坊失始子存它完对将小少已币帧库店度开态戏成把拖拥择振探撤操效敏数无旧显暂有本枚果格档槽此步比没法消游灵点版物率画的磨示移第纵继续置菜西视角言设试语质购足跳转载过返这进退选部里重量金销除险静面音频额高，？"
  em_px 32
  px_range 4
  runtime true
}
