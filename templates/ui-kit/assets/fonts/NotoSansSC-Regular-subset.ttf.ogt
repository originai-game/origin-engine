type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset latin cjk-punct
  chars "简体中文原点引擎设置。一下不东丢个中主乐买件价会低余作佳停全公共关冒农减出击分删到刹剩加动匠区单卖卡即原反取另可右向品商回图圈场坊失始子存它完宝宾对将小少左已币帧库店度开态戏成把拖拥择振探撤操效敏数无旧时显暂最有本杀枚果枪标格档槽此步比没法消游火灵点版物率画的目石磨示秒移第级纵继续置菜西视角言设试语质购足跃跳车转载过返这进退选速部里重量金铁铺销除险静面音频额高，？"
  em_px 32
  px_range 4
  runtime true
}
