type import
version 1
---
# The characters the UI kit's string tables use (tools/make-locale-fonts.py).
font {
  charset latin cjk-punct
  chars "简体中文原点引擎设置。一不东丢个中主乐买价会低余作停全冒减出删动单卖原反取可向商回图场坊失始存完对将小少已币帧库店度开态戏成拥振探撤操效敏无旧显暂有本枚果格档槽此比没法消游灵点版率画的磨示纵继续置菜西视角言设语质购足转返这进退部里量金销除险静面音频额高？"
  em_px 32
  px_range 4
  runtime true
}
