type strings
version 1
---
# The UI kit's zh-CN strings (og.i18n; templates/ui-kit/README.md §Locales).
locale "zh-CN"
fonts "fonts/NotoSansSC-Regular-subset.ttf"
string "gallery.button" "图库"
string "menu.title" "原点探险"
string "menu.subtitle" "一场小小的冒险"
string "menu.greeting" "欢迎回来，旅人晨星"
string "menu.mixed" "原点探险 Origin Quest مغامرة صغيرة"
string "menu.play" "开始"
string "menu.continue" "继续"
string "menu.settings" "设置"
string "menu.quit" "退出"
string "menu.footer" "版本 {version}"
string "pause.title" "已暂停"
string "pause.resume" "继续游戏"
string "pause.settings" "设置"
string "pause.quit" "返回菜单"
string "hud.level" "1-2 旧磨坊"
string "hud.coins" "{n, plural, other {# 枚金币}}"
string "confirm.title" "删除这个存档？"
string "confirm.message" "存档槽 [b]{slot}[/b] 中的进度将会丢失。[color=danger]此操作无法撤销。[/color]"
string "confirm.delete" "删除"
string "confirm.cancel" "取消"
# og.ui's templates' own words (SettingsDesc, ShopDesc, InventoryDesc, LeaderboardDesc, TutorialDesc, CutsceneDesc: og-i18n §2).
string "settings.title" "设置"
string "settings.audio" "音频"
string "settings.graphics" "画面"
string "settings.controls" "操作"
string "settings.language" "语言"
string "settings.master" "主音量"
string "settings.music" "音乐"
string "settings.effects" "音效"
string "settings.mute" "全部静音"
string "settings.quality" "画质"
string "settings.low" "低"
string "settings.medium" "中"
string "settings.high" "高"
string "settings.fps" "显示帧率"
string "settings.motion" "减少动态效果"
string "settings.contrast" "高对比度"
string "settings.sensitivity" "灵敏度"
string "settings.invert" "反转纵向视角"
string "settings.vibration" "振动"
string "settings.done" "完成"
string "shop.title" "商店"
string "shop.price" "价格"
string "shop.buy" "购买"
string "shop.short" "余额不足"
string "shop.owned" "已拥有"
string "shop.empty" "这里没有可卖的东西"
string "inventory.hint" "选择一件物品。把它拖到另一个格子即可移动。"
string "inventory.count" "数量"
string "leaderboard.error" "无法加载分数。"
string "leaderboard.retry" "重试"
string "tutorial.skip" "跳过"
string "tutorial.next" "下一步"
string "tutorial.done" "完成"
string "tutorial.step" "第 {step} 步，共 {count} 步"
string "cutscene.skip" "跳过"
