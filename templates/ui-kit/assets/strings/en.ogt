string "hud.stage" "Level 7"
string "hud.moves" "moves left"
string "hud.target" "Target {target}"
string "hud.tap" "Tap"
string "hud.generatorLevel" "Lv {level}"
string "hud.rate" "+{rate}/s"
string "hud.gold" "Gold"
