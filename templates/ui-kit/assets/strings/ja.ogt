string "inventory.count" "個数"
string "leaderboard.error" "スコアを読み込めませんでした。"
string "leaderboard.retry" "再試行"
string "tutorial.skip" "スキップ"
string "tutorial.next" "次へ"
string "tutorial.done" "完了"
string "tutorial.step" "{step} / {count}"
string "cutscene.skip" "スキップ"
