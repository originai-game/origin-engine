string "settings.medium" "中"
string "settings.high" "高"
string "settings.fps" "フレームレートを表示"
string "settings.motion" "動きを減らす"
string "settings.contrast" "ハイコントラスト"
string "settings.sensitivity" "感度"
string "settings.invert" "上下の視点を反転"
string "settings.vibration" "振動"
