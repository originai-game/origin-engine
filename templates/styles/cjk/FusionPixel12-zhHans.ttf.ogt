type import
version 1
---
# The pixel style's one face, Latin and Chinese on one 12-pixel grid: cooked
# as its cells (`pixel 12`; og-ui sets it at 12, 24, 36 ... px only), Latin-1,
# the typographic punctuation and CJK punctuation in the atlas, every other
# character rendered from the outlines at run time on the same cells.
# 48 px per em (four texels a font pixel), px_range a third of the em.
font {
  charset latin punct cjk-punct
  chars "−←→"
  em_px 48
  px_range 16
  runtime true
  pixel 12
}
