type style
version 3
---
# clean: clear numeric hierarchy, restrained menus, a HUD that keeps out of
# the scene (docs/ui.md §4). Commercial review references: Forza Horizon 5
# and Portal 2. Started from `og style new clean --look "minimal modern"
# --scheme dark` and authored by hand from there.
#
# The language, in one place:
# - Neutral graphite grounds a step apart; one cool blue for the primary
#   action and selection, one warm amber for emphasis. Colour never carries
#   a state alone: selection adds a rule, a check adds a mark.
# - Numbers on Barlow Semi Condensed with tabular figures, labels on
#   Instrument Sans; the numeral is the largest thing in a readout and its
#   unit sits beside it, quieter.
# - Small radii (2 to 8 px), flat fills, hairline rules; elevation only on
#   what floats over content (menus, dialogs, tooltips).
# - The HUD sits on thin low-alpha plates (`--hud`, `--scene-plate`) with a
#   soft shadow under its ink, so it reads on a bright sky and a dark room.
name "clean"
scheme dark
palette {
  --backdrop: #0d1015
  --well: #080a0d
  --panel: #151920
  --panel-hover: #1d222b
  --panel-raised: #1a1f27
  --line: #2a313b
  --line-strong: #5d6774
  --ink: #f2f4f7
  --ink-muted: #b4bcc7
  --ink-faint: #8d96a3
  --ink-inverse: #11151b
  --control: #1f252e
  --control-strong: #2a313b
  --primary: #1d6ae0
  --primary-hover: #3880ee
  --primary-active: #1654b5
  --on-primary: #ffffff
  --primary-soft: #1d6ae033
  --highlight: #5aa9ff
  --selection: #233554
  --on-selection: #f2f4f7
  --accent: #ffb547
  --scene-ink: #f7f9fb
  --scene-plate: #0b0e13bf
  --scene-shadow: #000000b3
  --focus: #7cc0ff
  --knob: #e8ecf1
  --hud: #0b0e13a3
  --scrim: #05070acc
  --shadow: #00000099
  --sheen: #ffffff1f
  --success: #4fd18b
  --warn: #ffb547
  --danger: #ff5c5c
  --info: #5aa9ff
  --health: #e9eef4
  --mana: #5aa9ff
  --xp: #b28cff
  --gold: #ffcc4d
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #a3abb5 pips 1
  --uncommon: #4fd18b pips 2
  --rare: #4c9bff pips 3
  --epic: #b07cff pips 4
  --legendary: #ffb547 pips 5
  --mythic: #ff5c7a pips 6
  --team1: #4c9bff
  --team2: #ff5c5c
  --team3: #4fd18b
  --team4: #ffcc4d
  --team5: #b07cff
  --team6: #ff8f3d
  --team7: #3fd6d0
  --team8: #ff6fb5
  --physical: #c9c2b4
  --fire: #ff7a3d
  --ice: #6fd3ff
  --lightning: #ffe14d
  --poison: #8fe35a
  --holy: #fff0b3
  --shadow: #9b7bff
  --arcane: #ff5cde
  --series1: #4c9bff
  --series2: #ffb547
  --series3: #ff5c5c
  --series4: #3fd6d0
  --series5: #4fd18b
  --series6: #ffe14d
  --series7: #b07cff
  --series8: #ff8fab
}
typography {
  display 52 56 -0.01 600 display tnum {
    phonePortrait 40 44
    phoneLandscape 44 48
  }
  title 30 36 0 600 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 21 27 0.01 600 display
  body 15 22 0 400 body
  label 13 18 0.02 400 body
  caption 12 16 0.02 400 body
  numeric 22 26 0 600 numeric tnum
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 2px
  --radius-sm: 4px
  --radius-md: 6px
  --radius-lg: 8px
  --radius-xl: 12px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1px
  --stroke-regular: 1.5px
  --stroke-thick: 2px
  --stroke-focus: 2px
}
elevation {
  raised none
  floating {
    shadow 0 4 12 0 "#00000059"
    shadow 0 1 2 0 "#00000040"
  }
  overlay {
    shadow 0 12 32 0 "#00000073"
    shadow 0 2 4 0 "#00000040"
  }
  top {
    shadow 0 20 48 0 "#00000080"
    shadow 0 2 4 0 "#00000040"
  }
}
shape {
  panel round 8
  dialog round 8
  card round 6
  tooltip round 4
  button round 4
  field round 4
  chip round 4
  badge round 2
  tab round 4
  slot round 4
  bar round 2
  hud round 4
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 12 16
  reading 16 25
  lg 19 25
  xl 22 28
  xl2 26 32
  xl3 30 36
  displaySm 34 38 tnum
  displayMd 42 46 tnum
  displayLg 52 56 tnum
}
fonts {
  body "@styles/shared/InstrumentSans-Regular.ttf"
  display "@styles/shared/BarlowSemiCondensed-SemiBold.ttf"
  numeric "@styles/shared/BarlowSemiCondensed-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/shared/ink-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter fade
  toast slideUp
  progress 360
  shake 3
  pop 0.03
  spring ui 200 0
  spring panel 320 0
  spring emphasis 420 0.04
  spring playful 480 0.08
  ease standard 0.2 0 0 1
  ease enter 0.16 1 0.3 1
  ease exit 0.4 0 1 1
  ease emphasis 0.3 1.3 0.6 1
  ease widgetEnter 0.16 1 0.3 1
  ease widgetExit 0.4 0 1 1
  duration instant 100
  duration fast 160
  duration base 240
  duration slow 380
  duration spring 480
  duration bounce 560
  stagger 40
  staggerCap 240
  overshoot 0.0
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.28 0.34 pitch 0.98 1.02 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.28 0.34 pitch 0.98 1.02 haptic tick
  confirm "sfx-confirm.ogt" volume 0.32 0.38 pitch 0.99 1.01 haptic tap
  cancel "sfx-back.ogt" volume 0.28 0.34 pitch 0.98 1.02 haptic tick
  back "sfx-back.ogt" volume 0.28 0.34 pitch 0.98 1.02 haptic tick
  open "sfx-open.ogt" volume 0.2 0.24 pitch 1.02 1.06 haptic none
  close "sfx-open.ogt" volume 0.18 0.22 pitch 0.84 0.88 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.24 0.3 pitch 1.12 1.16 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.22 0.26 pitch 1.18 1.22 haptic tick
  toggleOff "sfx-back.ogt" volume 0.22 0.26 pitch 1.08 1.12 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.16 pitch 1.36 1.44 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.06 0.1 pitch 1.52 1.66 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.16 pitch 0.9 1.4 haptic none
  notification "sfx-confirm.ogt" volume 0.26 0.3 pitch 1.28 1.32 haptic tap
  warning "sfx-error.ogt" volume 0.22 0.26 pitch 1.22 1.26 haptic warning
  error "sfx-error.ogt" volume 0.3 0.36 pitch 0.99 1.01 haptic error
  success "sfx-reward.ogt" volume 0.3 0.36 pitch 1.09 1.11 haptic success
  reward "sfx-reward.ogt" volume 0.34 0.38 pitch 0.99 1.01 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.22 0.26 pitch 0.88 0.92 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.26 0.3 pitch 0.93 0.97 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.3 0.34 pitch 1.13 1.17 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.32 0.38 pitch 0.89 0.91 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.34 0.38 pitch 0.79 0.81 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.38 0.4 pitch 0.69 0.71 haptic thud
}

# Containers: flat grounds a step apart, a hairline, elevation only on what
# floats over content.
Panel::frame {
  -og-fill: var(--panel)
  -og-stroke: 1px #ffffff12 inside
  -og-effect: none
}
Card::frame {
  -og-fill: var(--panel-raised)
  -og-stroke: 1px #ffffff0f inside
  -og-effect: none
}
Card::frame:hover {
  -og-fill: var(--panel-hover)
}
Card::frame:selected {
  -og-stroke: 1px var(--primary) inside
}
Dialog::backdrop {
  -og-fill: var(--scrim)
}
Dialog::frame {
  -og-fill: var(--panel)
  -og-stroke: 1px #ffffff17 inside
  -og-effect: drop-shadow 0 16 40 0 #00000080
}
Dialog::panel {
  -og-fill: var(--panel)
  -og-stroke: 1px #ffffff17 inside
  -og-effect: drop-shadow 0 16 40 0 #00000080
}
Tooltip::frame {
  -og-fill: #232a34f2
  -og-stroke: 1px #ffffff1a inside
  -og-effect: drop-shadow 0 4 12 0 #00000066
}
Hud::frame {
  -og-fill: var(--hud)
  -og-stroke: none
  -og-effect: none
}
Details::root {
  -og-fill: none
  -og-stroke: none
}
Details::summary {
  -og-fill: none
  -og-stroke: none
}
Details::summary:hover {
  -og-fill: #ffffff0a
}
Details::content {
  -og-fill: none
}
Scroll::bar[axis=vertical] {
  -og-fill: #ffffff33
  width: 4px
}
Scroll::bar[axis=horizontal] {
  -og-fill: #ffffff33
  height: 4px
}

# Buttons: a flat control fill, the primary filled, one press depth for all.
Button::base {
  -og-fill: var(--control)
  -og-stroke: none
  -og-effect: none
  -og-press: 0.98 0.98 1
  -og-hover: 0 1
}
Button::base:hover {
  -og-fill: #333b47
}
Button::base:active {
  -og-fill: #171c23
}
Button::base:disabled {
  -og-fill: #1a1f26
}
Button::base.primary {
  -og-fill: var(--primary)
}
Button::base.primary:hover {
  -og-fill: var(--primary-hover)
}
Button::base.primary:active {
  -og-fill: var(--primary-active)
}
Button::base.primary:disabled {
  -og-fill: #1d3354
}
Button::base.ghost {
  -og-fill: none
  -og-stroke: 1px var(--line-strong) inside
}
Button::base.ghost:hover {
  -og-fill: var(--panel-hover)
}
Button::base.ghost:active {
  -og-fill: var(--well)
}
Button::base.quiet {
  -og-fill: none
}
Button::base.quiet:hover {
  -og-fill: var(--panel-hover)
}
Button::base.quiet:active {
  -og-fill: var(--well)
}
Button::base.quiet:disabled {
  -og-fill: none
}
Button::base.danger {
  -og-fill: #3a1d21
  -og-stroke: 1px #ff5c5c59 inside
}
Button::base.danger:hover {
  -og-fill: #4a2329
}

# Selection: one grammar. A selected chip, tab, slot or option takes the
# selection ground and a primary rule, never colour alone.
Chip::base {
  -og-fill: var(--control)
  -og-stroke: none
}
Chip::base:hover {
  -og-fill: var(--control-strong)
}
Chip::base:selected {
  -og-fill: var(--selection)
  -og-stroke: 1px var(--primary) inside
}
Tabs::tab {
  -og-fill: none
  -og-stroke: none
}
Tabs::tab:hover {
  -og-fill: var(--panel-hover)
}
Tabs::tab:active {
  -og-fill: var(--well)
}
Tabs::track {
  -og-fill: none
  -og-stroke: none
  -og-effect: inner-shadow 0 -1 0 0 var(--line)
}
Tabs::indicator {
  -og-fill: var(--selection)
  -og-stroke: none
  -og-effect: inner-shadow 0 -2 0 0 #3880ee
}
Tabs::tab:selected {
  -og-fill: none
  -og-stroke: none
  -og-effect: none
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
  -og-effect: none
}
Segmented::track {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
}
Segmented::thumb {
  -og-fill: var(--control-strong)
  -og-stroke: 1px #ffffff1f inside
  -og-effect: none
}
Segmented::item {
  -og-fill: none
}
Slot::frame {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
  -og-effect: none
}
Slot::frame:hover {
  -og-stroke: 1px var(--line-strong) inside
}
Slot::frame:selected {
  -og-fill: var(--selection)
  -og-stroke: 2px var(--primary) inside
  -og-effect: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #4c9bff inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #b07cff inside
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #ffb547 inside
  -og-effect: inner-glow 10 #ffb54733
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ff5c7a inside
  -og-effect: inner-glow 10 #ff5c7a33
}
Inventory::item:selected {
  -og-fill: var(--selection)
  -og-stroke: 2px var(--primary) inside
}

# Fields and choices.
Field::frame {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
  -og-effect: none
}
Field::frame:hover {
  -og-stroke: 1px var(--line-strong) inside
}
Field::frame.invalid {
  -og-stroke: 1px var(--danger) inside
}
Dropdown::trigger {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
}
Dropdown::trigger:hover {
  -og-stroke: 1px var(--line-strong) inside
}
Dropdown::trigger.open {
  -og-stroke: 1px var(--primary) inside
}
Dropdown::list {
  -og-fill: #1d232c
  -og-stroke: 1px #ffffff17 inside
  -og-effect: drop-shadow 0 8 24 0 #00000073
}
Dropdown::option {
  -og-fill: none
  -og-stroke: none
  -og-effect: none
}
Dropdown::option:hover {
  -og-fill: #ffffff0d
}
Dropdown::option:selected {
  -og-fill: var(--selection)
}
Toggle::row {
  -og-stroke: none
  -og-effect: none
}
Toggle::row:active {
  -og-fill: var(--panel-hover)
}
Toggle::track {
  -og-fill: var(--control-strong)
  -og-stroke: none
  -og-effect: none
}
Toggle::track:checked {
  -og-fill: var(--primary)
}
Toggle::knob {
  -og-fill: var(--knob)
  -og-effect: drop-shadow 0 1 2 0 #00000066
}
Checkbox::row {
  -og-stroke: none
  -og-effect: none
}
Checkbox::row:active {
  -og-fill: var(--panel-hover)
}
Checkbox::box {
  -og-fill: var(--well)
  -og-stroke: 1.5px var(--line-strong) inside
}
Checkbox::box:checked {
  -og-fill: var(--primary)
  -og-stroke: none
}
Checkbox::box.mixed {
  -og-fill: var(--primary)
  -og-stroke: none
}
Radio::option {
  -og-stroke: none
  -og-effect: none
}
Radio::option:active {
  -og-fill: var(--panel-hover)
}
Radio::ring {
  -og-fill: var(--well)
  -og-stroke: 1.5px var(--line-strong) inside
}
Radio::ring:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Radio::dot {
  -og-fill: var(--primary)
}
Radio::card {
  -og-fill: var(--panel-raised)
  -og-stroke: 1px var(--line) inside
}
Radio::card:selected {
  -og-fill: var(--selection)
  -og-stroke: 2px var(--primary) inside
}
Radio::chosen {
  -og-stroke: none
}
Stepper::frame {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
}
Stepper::button {
  -og-fill: var(--control)
}
Stepper::button:hover {
  -og-fill: var(--control-strong)
}

# Ranges: a thin track, a solid fill, a light knob.
Slider::track {
  -og-fill: #3a424e
  -og-effect: none
}
Slider::fill {
  -og-fill: var(--primary)
}
Slider::knob {
  -og-fill: var(--knob)
  -og-effect: drop-shadow 0 1 3 0 #00000080
}
Slider::bubble {
  -og-fill: var(--knob)
  -og-stroke: none
  -og-effect: drop-shadow 0 2 6 0 #00000080
}
Meter::track {
  -og-fill: var(--control-strong)
  -og-effect: none
}
Meter::fill {
  -og-effect: none
}

# On-screen keyboard.
Keyboard::panel {
  -og-fill: var(--panel)
  -og-stroke: 1px #ffffff12 inside
}
Keyboard::key {
  -og-fill: var(--control)
}
Keyboard::key:hover {
  -og-fill: var(--control-strong)
}
Keyboard::key.action {
  -og-fill: #262d37
}
Keyboard::key.primary {
  -og-fill: var(--primary)
}
Keyboard::preview {
  -og-fill: var(--well)
  -og-stroke: 1px var(--line) inside
}
Keyboard::candidates {
  -og-fill: none
}
Keyboard::candidate:hover {
  -og-fill: #ffffff0d
}

# shooter kit (packages/engine/extensions/shooter). The reticle is white
# over a dark keyline so it reads on any scene; hit marks are white, a
# headshot amber, a kill red.
Crosshair::arm {
  -og-fill: #f7f9fbf2
  -og-stroke: 1px #000000a6 outside
}
Crosshair::dot {
  -og-fill: #f7f9fb
  -og-stroke: 1px #000000a6 outside
}
Crosshair::arm.aimed {
  -og-fill: #ff5c5c
}
Crosshair::dot.aimed {
  -og-fill: #ff5c5c
}
Crosshair::hit {
  -og-fill: #ffffff
  -og-stroke: 1px #00000099 outside
}
Crosshair::hit.headshot {
  -og-fill: #ffb547
}
Crosshair::hit.kill {
  -og-fill: #ff5c5c
}
Crosshair::hit.shieldBreak {
  -og-fill: #5aa9ff
}
Ammo::frame {
  -og-fill: var(--scene-plate)
  -og-stroke: none
}
Ammo::reload {
  -og-fill: var(--scene-ink)
}
DamageDirection::arc {
  -og-fill: #ff5c5cd9
}
DamageDirection::arc.shield {
  -og-fill: #5aa9ffd9
}
DamageDirection::arc.critical {
  -og-fill: #ff3030
}
# Near-opaque: the compositor blends in linear light, so over the brightest
# sky a lighter plate leaves a team name under 4.5:1 (97 % keeps it 4.8:1).
Killfeed::row {
  -og-fill: #0b0e13f7
  -og-stroke: none
}
Killfeed::row.self {
  -og-fill: #0b0e13fa
  -og-stroke: 1px #f2f4f7b3 inside
}
Loadout::item {
  -og-fill: var(--panel-raised)
  -og-stroke: 1px var(--line) inside
  -og-effect: none
}
Loadout::item:hover {
  -og-fill: var(--panel-hover)
  -og-stroke: 1px var(--line-strong) inside
}
Loadout::item:active {
  -og-fill: #171c23
}
Loadout::item:selected {
  -og-fill: var(--selection)
  -og-stroke: 2px var(--primary) inside
}
Loadout::item.equipped {
  -og-effect: inner-shadow 3 0 0 0 #ffb547
}
Loadout::item.locked {
  -og-fill: #13171d
  -og-stroke: 1px #2a313b inside
}
Loadout::item:disabled {
  -og-fill: #13171d
}
