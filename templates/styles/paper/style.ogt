type style
version 2
---
# The paper style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "paper"
scheme light
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#e8e2d4"
  well "#ded7c6"
  panel "#fbf8f0"
  panelHover "#f3eee2"
  panelRaised "#fbf8f0"
  line "#cfc6b2"
  lineStrong "#1c1a17"
  ink "#1c1a17"
  inkMuted "#57524a"
  inkFaint "#68635a"
  inkInverse "#fbf8f0"
  control "#efe9dc"
  controlStrong "#e2dac8"
  primary "#a02b1a"
  primaryHover "#942717"
  primaryActive "#85220f"
  onPrimary "#fffaf3"
  primarySoft "#a02b1a26"
  highlight "#a8321f"
  focus "#2b5cc8"
  knob "#fbf8f0"
  hud "#fbf8f0f5"
  scrim "#2a261f73"
  shadow "#2a261f40"
  sheen "#ffffff52"
  success "#1a6034"
  warn "#7b4802"
  danger "#8e1d16"
  info "#1c4bb6"
  health "#1a6034"
  mana "#007aff"
  xp "#af52de"
  gold "#a02b1a"
}
colors {
  success icon "check"
  warn icon "flag"
  danger icon "close"
  info pattern hatch
  common "#8a857a" pips 1
  uncommon "#3a7a3a" pips 2
  rare "#2b5cc8" pips 3
  epic "#6a3aa8" pips 4
  legendary "#b8781a" pips 5
  mythic "#a02b1a" pips 6
  team1 "#2b5cc8"
  team2 "#a02b1a"
  team3 "#3a7a3a"
  team4 "#a87a10"
  team5 "#6a3aa8"
  team6 "#c0601a"
  team7 "#1f7f7a"
  team8 "#a83a7a"
  physical "#6a655a" icon "sword"
  fire "#c0461a" icon "fire"
  ice "#2f7fb0" icon "drop"
  lightning "#a8861a" icon "bolt"
  poison "#4f7a1f" pattern dots
  holy "#a8861a" icon "star"
  shadow "#3a2a5a" pattern crosshatch
  arcane "#8a2a9a" pattern waves
  series1 "#2b5cc8"
  series2 "#c0601a"
  series3 "#a02b1a"
  series4 "#3a7a3a"
  series5 "#6a3aa8"
  series6 "#a87a10"
  series7 "#1f7f7a"
  series8 "#68635a"
}
typography {
  display 48 54 -0.01 600 display {
    phonePortrait 38 43
    phoneLandscape 43 49
  }
  title 30 36 -0.005 600 display {
    phonePortrait 26 32
    phoneLandscape 28 34
  }
  heading 22 30 0 600 display
  body 15 22 0 400 body
  label 15 22 0.01 500 body
  caption 13 18 0 400 body
  numeric 19 26 0 400 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 2
  sm 4
  md 6
  lg 8
  xl 12
  pill 9999
}
stroke {
  hairline 1
  thin 1.2
  regular 1.6
  thick 2.2
  focus 2
}
elevation {
  raised {
    shadow 0 3 8 0 "#2a261f2e"
  }
  floating {
    shadow 0 2 6 0 "#2a261f33"
  }
  overlay {
    shadow 0 6 16 0 "#2a261f3a"
    shadow 0 1 2 0 "#2a261f26"
  }
  top {
    shadow 0 10 24 0 "#2a261f40"
    shadow 0 1 3 0 "#2a261f26"
  }
}
shape {
  panel round 6
  dialog round 8
  card round 6
  tooltip round 4
  button round 4
  field round 4
  chip round pill
  badge round pill
  tab round 4
  slot round 4
  bar round 4
  hud round pill
  avatar round pill
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 30
  xl2 26 32
  xl3 30 36
  displaySm 30 36
  displayMd 38 44
  displayLg 48 54
}
fonts {
  body "InstrumentSans-Regular.ttf"
  display "Newsreader-SemiBold.ttf"
  numeric "PTMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 120 18 ink
flourish 136 172 64 24 22 10 primary 2
tile 204 172 64 64 64 64 0.6 4
motion {
  enter slideUp
  toast slideUp
  progress 380
  shake 5
  pop 0.08
  spring ui 200 0
  spring panel 320 0.05
  spring emphasis 440 0.12
  spring playful 520 0.2
  ease standard 0.25 0.1 0.25 1
  ease enter 0.22 1 0.36 1
  ease exit 0.55 0 1 0.45
  ease emphasis 0.3 1.3 0.5 1
  duration instant 120
  duration fast 180
  duration base 260
  duration slow 420
  duration spring 520
  duration bounce 640
  stagger 40
  staggerCap 360
  overshoot 0.03
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none volume 0.5 0.7 pitch 0.9 1.1 haptic none
  counterTick none pitch 1 1.2 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic tap
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic thud
}
dress "Panel.frame" {
  slice 4 4 96 96 12 tint
  tone 0.966 0.966 0.966 1.00
  shadow 0 6 16 0 "#2a261f3a"
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 10 tint
  tone 0.967 0.967 0.967 1.00
  shadow 0 3 8 0 "#2a261f2e"
  tile
}
dress "Button.base" {
  slice 172 4 48 48 12 tint
  tone 0.967 0.967 0.967 1.00
  shadow 0 2 4 0 "#2a261f33"
  press 0.98 0.98 1
  hover -1 1.0
}
dress "Button.base[hover]" {
  slice 224 4 48 48 12 tint
  tone 0.967 0.967 0.967 1.00
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 12 tint
  tone 0.848 0.848 0.848 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 12 tint
  tone 0.913 0.913 0.913 1.00
}
dress "Field.frame" {
  slice 4 104 48 48 8 tint
  tone 0.966 0.966 0.966 1.00
}
dress "Slot.frame" {
  slice 56 104 48 48 8 tint
  tone 0.901 0.901 0.901 1.00
}
dress "Tooltip.frame" {
  slice 108 104 32 32 8 tint
  tone 0.966 0.966 0.966 1.00
  shadow 0 2 6 0 "#2a261f33"
}
dress "Hud.frame" {
  slice 144 104 32 32 14 tint
  tone 0.967 0.967 0.967 1.00
  shadow 0 2 6 0 "#2a261f33"
}
dress "Meter.track" {
  slice 180 104 32 16 7 tint
  tone 0.965 0.965 0.965 1.00
}
dress "Meter.fill" {
  slice 216 104 32 16 7 tint
  tone 0.965 0.965 0.965 1.00
}
