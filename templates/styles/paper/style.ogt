type style
version 1
---
# The paper style pack: generated by templates/ui-kit/tools/make-skins.py (CC0 art, OFL fonts; LICENSES.md).
name "paper"
scheme light
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#e8e2d4"
  well "#ded7c6"
  panel "#fbf8f0"
  panelHover "#f3eee2"
  panelRaised "#fbf8f0"
  line "#cfc6b2"
  lineStrong "#1c1a17"
  ink "#1c1a17"
  inkMuted "#57524a"
  inkFaint "#68635a"
  inkInverse "#fbf8f0"
  control "#efe9dc"
  controlStrong "#e2dac8"
  primary "#a02b1a"
  primaryHover "#942717"
  primaryActive "#85220f"
  onPrimary "#fffaf3"
  primarySoft "#a02b1a26"
  highlight "#a8321f"
  focus "#2b5cc8"
  knob "#fbf8f0"
  hud "#fbf8f0f5"
  scrim "#2a261f73"
  shadow "#2a261f40"
  sheen "#ffffff52"
  success "#1a6034"
  warn "#7b4802"
  danger "#8e1d16"
  info "#1c4bb6"
  health "#1a6034"
  mana "#007aff"
  xp "#af52de"
  gold "#a02b1a"
}
radius {
  small 4
  control 4
  bar 4
  panel 6
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 30
  xl2 26 32
  xl3 30 36
  displaySm 30 36
  displayMd 38 44
  displayLg 48 54
}
durations {
  fast 180
  base 260
  slow 420
}
fonts {
  body "InstrumentSans-Regular.ttf"
  display "Newsreader-SemiBold.ttf"
  numeric "PTMono-Regular.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 12 tint
slice card 104 4 64 64 10 tint
slice button 172 4 48 48 12 tint
slice buttonHover 224 4 48 48 12 tint
slice buttonPressed 276 4 48 48 12 tint
slice buttonDisabled 328 4 48 48 12 tint
slice field 4 104 48 48 8 tint
slice slot 56 104 48 48 8 tint
slice tooltip 108 104 32 32 8 tint
slice hud 144 104 32 32 14 tint
slice track 180 104 32 16 7 tint
slice fill 216 104 32 16 7 tint
soft 252 104 64 64 24
divider 4 172 128 24 120 18 ink
flourish 136 172 64 24 22 10 primary 2
tile 204 172 64 64 64 64 0.6 4 panel card
shadow panel 0 6 16 0 "#2a261f3a"
shadow card 0 3 8 0 "#2a261f2e"
shadow button 0 2 4 0 "#2a261f33"
shadow hud 0 2 6 0 "#2a261f33"
shadow tooltip 0 2 6 0 "#2a261f33"
press 0.98 0.98 1
hover -1 1.0
motion {
  enter slideUp
  stagger 40
  toast slideUp
  progress 380
  shake 5
  pop 0.08
}
