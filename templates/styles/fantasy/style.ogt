type style
version 1
---
# The fantasy style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "fantasy"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#1a120b"
  well "#241910"
  panel "#efdfb8"
  panelHover "#f4e8c8"
  panelRaised "#efdfb8"
  line "#9b7a4a"
  lineStrong "#5c4127"
  ink "#2a1a0c"
  inkMuted "#3d2a18"
  inkFaint "#654b31"
  inkInverse "#f4e8c8"
  control "#e2cc98"
  controlStrong "#d6bc82"
  primary "#7a520f"
  primaryHover "#74500e"
  primaryActive "#6a470c"
  onPrimary "#fff4dc"
  primarySoft "#7a520f40"
  highlight "#6e470d"
  focus "#8f2d1f"
  knob "#f4e8c8"
  hud "#efdfb8"
  scrim "#0d0805cc"
  shadow "#000000aa"
  sheen "#ffffff52"
  success "#2d5a1e"
  warn "#704713"
  danger "#6e1b10"
  info "#22517f"
  health "#2d5a1e"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#7a520f"
}
radius {
  small 4
  control 4
  bar 4
  panel 4
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 24
  lg 19 26
  xl 22 28
  xl2 24 30
  xl3 28 32
  displaySm 28 34
  displayMd 34 40
  displayLg 42 48
}
durations {
  fast 200
  base 300
  slow 480
}
fonts {
  body "Newsreader-Medium.ttf"
  display "Cinzel-Bold.ttf"
  numeric "Cinzel-Bold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 16 authored
tone panel 0.861 0.736 0.478 1.00
slice card 104 4 64 64 10 authored
tone card 0.860 0.735 0.478 1.00
slice button 172 4 48 48 10 tint
tone button 0.789 0.789 0.789 1.00
slice buttonHover 224 4 48 48 10 tint
tone buttonHover 0.890 0.890 0.890 1.00
slice buttonPressed 276 4 48 48 10 tint
tone buttonPressed 0.693 0.693 0.693 1.00
slice buttonDisabled 328 4 48 48 10 tint
tone buttonDisabled 0.630 0.630 0.630 1.00
slice field 4 104 48 48 8 tint
tone field 0.912 0.912 0.912 1.00
slice slot 56 104 48 48 10 tint
tone slot 0.808 0.808 0.808 1.00
slice tooltip 108 104 32 32 8 tint
tone tooltip 0.934 0.934 0.934 1.00
slice hud 144 104 32 32 12 tint
tone hud 0.848 0.848 0.848 1.00
slice track 180 104 32 16 6 tint
tone track 0.692 0.692 0.692 1.00
slice fill 216 104 32 16 6 tint
tone fill 0.788 0.788 0.788 1.00
soft 252 104 64 64 24
corner 320 104 32 32 28 28 authored 6
corners panel
divider 4 172 128 24 112 20 authored
flourish 136 172 64 24 48 18 authored 0
tile 204 172 64 64 64 64 0.5 6 panel card
shadow panel 0 10 18 2 "#000000b3"
shadow card 0 4 8 0 "#00000066"
shadow button 0 3 4 0 "#00000073"
shadow hud 0 3 6 0 "#00000080"
press 0.98 0.96 1
hover 0 1.0
motion {
  enter scale
  stagger 35
  toast slideDown
  progress 420
  shake 5
  pop 0.1
}
