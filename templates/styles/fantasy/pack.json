      "accent-ink": {
        "dark": "#f6d17c",
        "light": "#5e4a1b"
      },
      "art-fg": "#fff3e4",
      "art-primary-fg": "#fff3e4",
      "gold": {
        "dark": "#e2b84f",
        "light": "#8a5a12"
      },
      "health": "#b8322a",
      "mana": "#3a68c8",
