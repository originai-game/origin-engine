type style
version 3
---
# wasteland: the post-apocalyptic survival look, generated by og style new (docs/ui.md §12.5) for "a survival and extraction game of scavenged stashes, crafting and radiation".
# Choices: scheme dark, seed #f5821f, shape sharp, ornament light, motion heavy, finish bevel.
atlas "atlas.png" 512 284 2 3
# The painted art follows the palette: a copy with another primary recolours it at cook (docs/art.md §2.7).
recolour "#f5821f" primary
name "wasteland"
scheme dark
palette {
  --backdrop: #12110f
  --well: #0d0c0b
  --panel: #292520
  --panel-hover: #3a3632
  --panel-raised: #34302b
  --line: #4c4740
  --line-strong: #8a857a
  --ink: #ebe4d4
  --ink-muted: #cbc5ba
  --ink-faint: #b1ada5
  --ink-inverse: #292520
  --control: #37322d
  --control-strong: #444039
  --primary: #f5821f
  --primary-hover: #f68c31
  --primary-active: #f79643
  --on-primary: #120a04
  --primary-soft: #f5821f38
  --highlight: #fbd2a6
  --focus: #f59a3c
  --knob: #504b44
  --hud: #292520f0
  --scrim: #090908b3
  --shadow: #000000bf
  --sheen: #ffffff38
  --success: #69d390
  --warn: #f0af4c
  --danger: #ec9893
  --info: #87b6ea
  --health: #64d877
  --mana: #81b4f5
  --xp: #c89de6
  --gold: #f0c54c
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #9e9e9e pips 1
  --uncommon: #3fbf4f pips 2
  --rare: #2f7fef pips 3
  --epic: #ab45ef pips 4
  --legendary: #ff8000 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #3fbf5f
  --team4: #ffc61a
  --team5: #a347ff
  --team6: #ff8a1f
  --team7: #1fc7c7
  --team8: #ff5cb0
  --physical: #b8b0a0
  --fire: #ff6a2b
  --ice: #62cfff
  --lightning: #ffd83a
  --poison: #7ed957
  --holy: #ffe9a0
  --shadow: #8a5cf6
  --arcane: #ff4fd8
  --series1: #527ca9
  --series2: #f28e2b
  --series3: #e15759
  --series4: #76b7b2
  --series5: #59a14f
  --series6: #edc948
  --series7: #b07aa1
  --series8: #ff9da7
}
typography {
  display 51 57 0.03 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 0.03 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 13 18 0.06 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 0
  --radius-sm: 2px
  --radius-md: 2px
  --radius-lg: 3px
  --radius-xl: 4px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.25px
  --stroke-regular: 1.75px
  --stroke-thick: 2.5px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000064"
  }
  floating {
    shadow 0 4 0 0 "#00000073"
  }
  overlay {
    shadow 0 6 0 0 "#00000081"
  }
  top {
    shadow 0 6 0 0 "#0000008f"
  }
}
shape {
  panel round 2
  dialog round 2.4
  card round 1.6
  tooltip square 0
  button round 2
  field round 1.6
  chip round 2
  badge round 2
  tab round 1.6
  slot square 0
  bar square 0
  hud round 2
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/BarlowSemiCondensed-SemiBold.ttf"
  display "@styles/shared/BigShouldersStencilDisplay-SemiBold.ttf"
  numeric "@styles/shared/BarlowCondensed-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
  displayMin 26
}
icons "@styles/shared/stencil-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 2 2 0 "#000000c0"
motion {
  enter slideUp
  toast slideUp
  progress 520
  shake 10
  pop 0.03
  spring ui 240 0
  spring panel 500 0.03
  spring emphasis 640 0.06
  spring playful 700 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 130
  duration fast 220
  duration base 360
  duration slow 520
  duration spring 640
  duration bounce 760
  stagger 70
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.95 1.05 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.95 1.05 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 0.975 1.025 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 0.95 1.05 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 0.95 1.05 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 1 1.1 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.8 0.9 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.1 1.2 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.15 1.25 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 1.05 1.15 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.3 1.5 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.45 1.75 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.25 1.35 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.2 1.3 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 0.975 1.025 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.075 1.125 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 0.975 1.025 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.85 0.95 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.9 1 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.1 1.2 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.875 0.925 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.775 0.825 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.675 0.725 haptic thud
}
Button::base {
  -og-press: 1 0.96 2
  -og-hover: 0 1
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 2 2 0 0 #ffffff4d
  -og-effect: inner-shadow -2 -2 0 0 #0000004d
}
Panel::frame {
  -og-slice: 1 1 96 96 24 24 24 24 authored
  -og-tone: 0.025 0.014 0.008 1
  -og-stroke: 2px #8a857a inside
  -og-effect: inner-shadow 2 2 0 0 #ffffff38
  -og-effect: inner-shadow -2 -2 0 0 #00000059
}
Button::base:active {
  -og-effect: inner-shadow 2 2 0 0 #00000059
}
Slot::frame {
  -og-slice: 197 1 64 64 16 16 16 16 authored
  -og-tone: 0.016 0.012 0.008 1
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 2 2 0 0 #0000004d
}
Field::frame {
  -og-slice: 1 237 191 40 20 12 20 12 authored
  -og-tone: 0.012 0.009 0.007 1
  -og-effect: inner-shadow 2 2 0 0 #0000004d
}
Meter::track {
  -og-stroke: 2px var(--line-strong) inside
}
Button::base.primary {
  -og-slice: 369 145 138 44 22 14 22 14 authored
  -og-tone: 1 0.344 0.024 0.99
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 1px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 1px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Slider::track {
  -og-segments: 16 2
}
AbilitySlot::frame.active {
  -og-stroke: 2px var(--primary) outside
  -og-effect: drop-shadow 0 3 10 0 #0000008c
  -og-effect: outer-glow 12 #f5821fa6
}
AbilitySlot::edge.active {
  -og-stroke: 2px var(--primary) inside
}
AbilitySlot::icon {
  -og-fill: linear 180 var(--panel-raised) var(--well)
}
StatusGrid::tile.buff {
  -og-stroke: 1px var(--line-strong) inside
}
StatusGrid::tile.debuff {
  -og-stroke: 2px var(--primary) inside
}
StatusGrid::icon.buff {
  -og-fill: linear 180 var(--panel-raised) var(--well)
}
StatusGrid::icon.debuff {
  -og-fill: linear 180 #7a3512 #2e150a
}
Compass::strip {
  -og-fill: var(--hud)
  -og-stroke: 1px var(--line) inside
}
Inventory::item {
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 2 2 0 0 #0000004d
}
Inventory::item:selected {
  -og-stroke: 2px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Card::frame {
  -og-slice: 99 1 96 96 20 20 20 20 authored
  -og-tone: 0.021 0.016 0.011 1
}
Tooltip::frame {
  -og-slice: 263 1 95 48 12 12 12 12 authored
  -og-tone: 0.016 0.012 0.008 1
}
Hud::frame {
  -og-slice: 194 237 85 40 14 12 14 12 authored
  -og-tone: 0.017 0.012 0.008 1
}
Button::base.secondary {
  -og-slice: 1 99 182 44 22 14 22 14 authored
  -og-tone: 0.026 0.02 0.014 0.99
}
Button::base.secondary:hover {
  -og-slice: 185 99 182 44 22 14 22 14 authored
  -og-tone: 0.068 0.059 0.049 0.99
}
Button::base.secondary:active {
  -og-slice: 1 145 182 44 22 14 22 14 authored
  -og-tone: 0.017 0.013 0.01 0.99
}
Button::base.secondary:disabled {
  -og-slice: 185 145 182 44 22 14 22 14 authored
  -og-tone: 0.016 0.015 0.014 0.99
}
Button::base.primary:hover {
  -og-slice: 1 191 138 44 22 14 22 14 authored
  -og-tone: 1 0.412 0.066 0.99
}
Button::base.primary:active {
  -og-slice: 141 191 138 44 22 14 22 14 authored
  -og-tone: 0.604 0.211 0.016 0.99
}
Button::base.primary:disabled {
  -og-slice: 281 191 138 44 22 14 22 14 authored
  -og-tone: 0.377 0.282 0.188 0.99
}
corner 281 237 32 32 32 32 authored
divider 1 279 192 4 192 4 authored
flourish 377 237 64 20 64 20 authored
Slider::knob {
  -og-slice: 315 237 8 24 1 1 1 1 authored
  -og-tone: 0.575 0.102 0.009 0.99
}
Toggle::knob:checked {
  -og-slice: 325 237 24 24 1 1 1 1 authored
  -og-tone: 0.151 0.115 0.087 0.99
}
Toggle::knob.off {
  -og-slice: 351 237 24 24 1 1 1 1 authored
  -og-tone: 0.073 0.05 0.035 0.99
}
