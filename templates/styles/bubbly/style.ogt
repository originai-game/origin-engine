type style
version 2
---
# bubbly: the casual cartoon look, generated by og style new (docs/ui.md §12.5) for "a bright match-and-collect puzzle game for everyone".
# Choices: scheme light, seed #2f7bff, shape round, ornament light, motion bouncy, finish gradient.
name "bubbly"
scheme light
palette {
  backdrop "#ffe7b0"
  well "#f0d9a5"
  panel "#fbf6eb"
  panelHover "#f2ede3"
  panelRaised "#fdfaf3"
  line "#cfcec9"
  lineStrong "#82868d"
  ink "#08162e"
  inkMuted "#444c5b"
  inkFaint "#595d63"
  inkInverse "#fefdf9"
  control "#eae6de"
  controlStrong "#d9d7d1"
  primary "#7aabff"
  primaryHover "#85b2ff"
  primaryActive "#8fb8ff"
  onPrimary "#0a1b38"
  primarySoft "#7aabff38"
  highlight "#944710"
  focus "#ce6215"
  knob "#fefdfa"
  hud "#fbf6ebf0"
  scrim "#807458b3"
  shadow "#0c1f403d"
  sheen "#ffffff80"
  success "#1a5932"
  warn "#6f4509"
  danger "#8b1c18"
  info "#174b87"
  health "#175a22"
  mana "#0c4796"
  xp "#5b2183"
  gold "#654b08"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#919191" pips 1
  uncommon "#37a645" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#e47200" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#37a552"
  team4 "#b48c12"
  team5 "#a347ff"
  team6 "#dc771b"
  team7 "#19a1a1"
  team8 "#f257a7"
  physical "#979184"
  fire "#f36529"
  ice "#499abe"
  lightning "#a99027"
  poison "#5ea141"
  holy "#9f9164"
  shadow "#8a5cf6"
  arcane "#f34bce"
  series1 "#4e79a7"
  series2 "#d47c26"
  series3 "#e15759"
  series4 "#649b97"
  series5 "#59a14f"
  series6 "#a98f33"
  series7 "#b07aa1"
  series8 "#c97c84"
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 10
  sm 14
  md 20
  lg 30
  xl 40
  pill 9999
}
stroke {
  hairline 1.5
  thin 2
  regular 2.5
  thick 3.5
  focus 2.5
}
elevation {
  raised {
    shadow 0 2 0 0 "#0c1f400a"
  }
  floating {
    shadow 0 4 0 0 "#0c1f400c"
  }
  overlay {
    shadow 0 6 0 0 "#0c1f400d"
  }
  top {
    shadow 0 6 0 0 "#0c1f400f"
  }
}
shape {
  panel round 20
  dialog round 24
  card round 16
  tooltip round 10
  button round 14
  field round 11.2
  chip round pill
  badge round pill
  tab round 11.2
  slot round 15
  bar round pill
  hud round 14
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/cartoon/Fredoka-SemiBold.ttf"
  display "@styles/cartoon/LilitaOne-Regular.ttf"
  numeric "@styles/cartoon/LilitaOne-Regular.ttf"
  cjk "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "@styles/cartoon/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0713263d"
motion {
  enter pop
  toast pop
  progress 420
  shake 8
  pop 0.2
  spring ui 260 0.3
  spring panel 420 0.32
  spring emphasis 520 0.42
  spring playful 620 0.5
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 110
  duration fast 170
  duration base 280
  duration slow 420
  duration spring 560
  duration bounce 700
  stagger 60
  staggerCap 300
  overshoot 0.18
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.9 1.1 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.9 1.1 haptic tick
  confirm "sfx-confirm.ogt" volume 0.595 0.7 pitch 0.95 1.05 haptic tap
  cancel "sfx-back.ogt" volume 0.56 0.7 pitch 0.9 1.1 haptic tick
  back "sfx-back.ogt" volume 0.56 0.7 pitch 0.9 1.1 haptic tick
  open "sfx-open.ogt" volume 0.42 0.49 pitch 0.95 1.15 haptic none
  close "sfx-open.ogt" volume 0.35 0.42 pitch 0.75 0.95 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.49 0.63 pitch 1.05 1.25 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.42 0.49 pitch 1.1 1.3 haptic tick
  toggleOff "sfx-back.ogt" volume 0.42 0.49 pitch 1 1.2 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.35 pitch 1.2 1.6 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.21 pitch 1.3 1.9 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.315 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.49 0.56 pitch 1.2 1.4 haptic tap
  warning "sfx-error.ogt" volume 0.42 0.49 pitch 1.15 1.35 haptic warning
  error "sfx-error.ogt" volume 0.56 0.7 pitch 0.95 1.05 haptic error
  success "sfx-reward.ogt" volume 0.56 0.7 pitch 1.05 1.15 haptic success
  reward "sfx-reward.ogt" volume 0.63 0.7 pitch 0.95 1.05 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.49 pitch 0.8 1 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.49 0.56 pitch 0.85 1.05 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.56 0.63 pitch 1.05 1.25 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.595 0.7 pitch 0.85 0.95 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.63 0.7 pitch 0.75 0.85 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.7 0.7 pitch 0.65 0.75 haptic thud
}
dress "Button.base" {
  press 1.06 0.9 3
  hover -3 1.04
  fill linear 180 controlStrong control
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#0c1f4015"
  effect innerShadow 0 -3 0 0 "#0000001f"
}
dress "Panel.frame" {
  fill linear 180 panelRaised panel
  stroke 3 lineStrong inside
  effect dropShadow 0 5 0 0 "#0c1f4015"
}
dress "Card.frame" {
  fill linear 180 panelRaised panel
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#0c1f400f"
}
dress "Button.base[pressed]" {
  effect innerShadow 0 3 0 0 "#0000002e"
}
dress "Field.frame" {
  stroke 2 lineStrong inside
}
dress "Slot.frame" {
  stroke 2 lineStrong inside
  effect innerShadow 0 3 0 0 "#0000001f"
}
dress "Meter.fill" {
  effect innerShadow 0 -3 0 0 "#0000002e"
  effect innerShadow 0 2 0 0 "#ffffff59"
}
dress "Chip.base" {
  stroke 2 lineStrong inside
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#ce6215" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
