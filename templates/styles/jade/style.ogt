type style
version 2
---
# jade: the eastern jade xianxia look, generated by og style new (docs/ui.md §12.5) for "a xianxia cultivation saga of sects, flying swords and jade pavilions above the clouds".
# Choices: scheme dark, seed #dcbc72, shape soft, ornament rich, motion calm, finish gradient.
atlas "atlas.png" 512 342 2 3
name "jade"
scheme dark
palette {
  backdrop "#0b1a16"
  well "#08120f"
  panel "#222e28"
  panelHover "#343f39"
  panelRaised "#2d3833"
  line "#49534d"
  lineStrong "#909590"
  ink "#fdfbf7"
  inkMuted "#d1d3ce"
  inkFaint "#b6bab6"
  inkInverse "#222e28"
  control "#313c36"
  controlStrong "#414b45"
  primary "#dcbc72"
  primaryHover "#dfc17d"
  primaryActive "#e2c789"
  onPrimary "#302919"
  primarySoft "#dcbc7238"
  highlight "#fbf3dc"
  focus "#f2d68c"
  knob "#4e5751"
  hud "#222e28f0"
  scrim "#060d0bb3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#72d696"
  warn "#f1b75d"
  danger "#eda09b"
  info "#91bdec"
  health "#6ada7c"
  mana "#8dbbf6"
  xp "#cda4e8"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#af4ff0" pips 4
  legendary "#ff8000" pips 5
  mythic "#e93a53" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a74eff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8e61f6"
  arcane "#ff4fd8"
  series1 "#5982ad"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 6
  sm 8
  md 12
  lg 18
  xl 24
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel round 12
  dialog round 14.4
  card round 9.6
  tooltip round 6
  button round 8
  field round 6.4
  chip round pill
  badge round pill
  tab round 6.4
  slot round 9
  bar round pill
  hud round 8
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/EBGaramond-Medium.ttf"
  display "@styles/shared/KaushanScript-Regular.ttf"
  numeric "@styles/shared/EBGaramond-Medium.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/MaShanZheng-Regular.ttf"
}
icons "@styles/fantasy/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0000008c"
motion {
  enter fade
  toast slideUp
  progress 460
  shake 4
  pop 0.04
  spring ui 220 0
  spring panel 380 0
  spring emphasis 480 0.06
  spring playful 560 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 120
  duration fast 200
  duration base 300
  duration slow 460
  duration spring 560
  duration bounce 680
  stagger 50
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  confirm "sfx-confirm.ogt" volume 0.425 0.5 pitch 0.975 1.025 haptic tap
  cancel "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  back "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  open "sfx-open.ogt" volume 0.3 0.35 pitch 1 1.1 haptic none
  close "sfx-open.ogt" volume 0.25 0.3 pitch 0.8 0.9 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.35 0.45 pitch 1.1 1.2 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.3 0.35 pitch 1.15 1.25 haptic tick
  toggleOff "sfx-back.ogt" volume 0.3 0.35 pitch 1.05 1.15 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.25 pitch 1.3 1.5 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.1 0.15 pitch 1.45 1.75 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.225 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.35 0.4 pitch 1.25 1.35 haptic tap
  warning "sfx-error.ogt" volume 0.3 0.35 pitch 1.2 1.3 haptic warning
  error "sfx-error.ogt" volume 0.4 0.5 pitch 0.975 1.025 haptic error
  success "sfx-reward.ogt" volume 0.4 0.5 pitch 1.075 1.125 haptic success
  reward "sfx-reward.ogt" volume 0.45 0.5 pitch 0.975 1.025 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.3 0.35 pitch 0.85 0.95 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.35 0.4 pitch 0.9 1 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.4 0.45 pitch 1.1 1.2 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.425 0.5 pitch 0.875 0.925 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.45 0.5 pitch 0.775 0.825 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.5 0.5 pitch 0.675 0.725 haptic thud
}
dress "Button.base" {
  press 0.98 0.98 1
  hover -1 1
  fill linear 180 controlStrong control
  stroke 2.5 linear 180 "#f2d68c" primary primaryActive inside
  effect dropShadow 0 4 0 0 "#0000006c"
  effect innerShadow 0 -3 0 0 "#00000029"
}
dress "Panel.frame" {
  slice 1 1 96 96 24 24 24 24 authored
  tone 0.008 0.03 0.023 1
  fill linear 180 panelRaised panel well
  fill radial "#f2d68c1a" "#f2d68c00"
  stroke 3 linear 180 "#f2d68c" primary primaryActive inside
  stroke 1 "#f2d68c59" outside
  effect dropShadow 0 6 0 0 "#0000006c"
  effect innerGlow 16 "#f2d68c24"
  ornament corner
}
dress "Card.frame" {
  slice 99 1 96 96 20 20 20 20 authored
  tone 0.007 0.021 0.016 1
  fill linear 180 panelRaised panel
  stroke 2 linear 180 "#f2d68c" primary primaryActive inside
  effect dropShadow 0 4 0 0 "#0000004d"
  effect innerGlow 10 "#f2d68c1a"
  ornament corner
}
dress "Button.base[hover]" {
  effect outerGlow 8 "#f2d68c4d"
}
dress "Button.base[pressed]" {
  effect innerShadow 0 3 0 0 "#00000038"
}
dress "Field.frame" {
  slice 1 283 137 40 12 12 12 12 authored
  tone 0.006 0.015 0.013 1
  stroke 1.5 linear 180 "#f2d68c" primary primaryActive inside
}
dress "Slot.frame" {
  slice 197 1 64 64 16 16 16 16 authored
  tone 0.006 0.018 0.014 1
  stroke 2 linear 180 "#f2d68c" primary primaryActive inside
  effect innerShadow 0 3 0 0 "#0000002e"
}
dress "Tooltip.frame" {
  slice 263 1 99 48 12 12 12 12 authored
  tone 0.008 0.026 0.021 1
  stroke 1.5 linear 180 "#f2d68c" primary primaryActive inside
}
dress "Meter.track" {
  stroke 1.5 "#f2d68c8c" inside
}
dress "Meter.fill" {
  slice 1 325 113 16 12 4 12 4 tint
  tone 0.876 0.876 0.876 0.99
  effect innerShadow 0 -3 0 0 "#0000002e"
  effect innerShadow 0 2 0 0 "#ffffff59"
}
dress "Chip.base" {
  stroke 1.5 linear 180 "#f2d68c" primary primaryActive inside
}
dress "Tabs.tab[selected]" {
  stroke 2 linear 180 "#f2d68c" primary primaryActive inside
}
dress "Button.base[primary]" {
  slice 1 191 207 44 18 14 18 14 authored
  tone 0.693 0.474 0.178 0.99
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#f2d68c" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Dialog.frame" {
  ornament corner
}
dress "Hud.frame" {
  slice 140 283 182 40 14 12 14 12 authored
  tone 0.008 0.024 0.021 0.99
}
corner 324 283 32 32 32 32 authored
divider 182 325 192 8 192 8 authored
flourish 116 325 64 13 64 13 authored
dress "Slider.knob" {
  slice 358 283 24 24 1 1 1 1 authored
  tone 0.166 0.307 0.194 0.99
}
dress "Toggle.knob[off]" {
  slice 410 283 24 24 1 1 1 1 authored
  tone 0.422 0.424 0.378 0.99
}
dress "Button.base[secondary]" {
  slice 1 99 205 44 18 14 18 14 authored
  tone 0.009 0.032 0.026 0.99
}
dress "Button.base[secondary][hover]" {
  slice 208 99 205 44 18 14 18 14 authored
  tone 0.04 0.078 0.069 0.99
}
dress "Button.base[secondary][pressed]" {
  slice 1 145 205 44 18 14 18 14 authored
  tone 0.007 0.021 0.017 0.99
}
dress "Button.base[secondary][disabled]" {
  slice 208 145 205 44 18 14 18 14 authored
  tone 0.014 0.019 0.018 0.99
}
dress "Button.base[primary][hover]" {
  slice 210 191 207 44 18 14 18 14 authored
  tone 0.732 0.534 0.247 0.99
}
dress "Button.base[primary][pressed]" {
  slice 1 237 207 44 18 14 18 14 authored
  tone 0.421 0.29 0.111 0.99
}
dress "Button.base[primary][disabled]" {
  slice 210 237 207 44 18 14 18 14 authored
  tone 0.374 0.338 0.276 0.99
}
dress "Toggle.knob[on]" {
  slice 384 283 24 24 1 1 1 1 authored
  tone 0.57 0.577 0.441 0.99
}
