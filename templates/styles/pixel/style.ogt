type style
version 3
---
# The pixel style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "pixel"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  --backdrop: #14111f
  --well: #1d1930
  --panel: #2b2745
  --panel-hover: #3a3459
  --panel-raised: #2b2745
  --line: #5b5480
  --line-strong: #a79ccf
  --ink: #f4f1de
  --ink-muted: #c9c2a8
  --ink-faint: #ada792
  --ink-inverse: #14111f
  --control: #3f3a5e
  --control-strong: #4c4570
  --primary: #ffcd4a
  --primary-hover: #ffdb75
  --primary-active: #e6ad1f
  --on-primary: #14111f
  --primary-soft: #ffcd4a25
  --highlight: #ffd86b
  --focus: #ffcd4a
  --knob: #5b5480
  --hud: #221e38f2
  --scrim: #0a0812b3
  --shadow: #00000099
  --sheen: #ffffff52
  --success: #6bd36b
  --warn: #ffa53d
  --danger: #ff8080
  --info: #5dc2ff
  --health: #6bd36b
  --mana: #3097ff
  --xp: #c76ff4
  --gold: #ffcd4a
}
colors {
  --success: icon "check"
  --warn: icon "flag"
  --danger: icon "skull"
  --info: pattern checks
  --common: #bcbcbc pips 1
  --uncommon: #58d854 pips 2
  --rare: #3cbcfc pips 3
  --epic: #d878f8 pips 4
  --legendary: #fca044 pips 5
  --mythic: #f83800 pips 6
  --team1: #3cbcfc
  --team2: #f83800
  --team3: #58d854
  --team4: #f8b800
  --team5: #d878f8
  --team6: #fca044
  --team7: #00e8d8
  --team8: #f878f8
  --physical: #bcbcbc icon "sword"
  --fire: #f83800 icon "fire"
  --ice: #3cbcfc icon "drop"
  --lightning: #f8b800 icon "bolt"
  --poison: #58d854 pattern checks
  --holy: #fcfcfc icon "star"
  --shadow: #9878f8 pattern grid
  --arcane: #f878f8 pattern diamonds
  --series1: #3cbcfc
  --series2: #f8b800
  --series3: #f83800
  --series4: #58d854
  --series5: #d878f8
  --series6: #00e8d8
  --series7: #fca044
  --series8: #bcbcbc
}
typography {
  display 72 80 0 400 display {
    phonePortrait 60 68
    phoneLandscape 60 68
  }
  title 48 56 0 400 display
  heading 36 44 0 400 display
  body 24 32 0 400 body
  label 12 16 0 400 body
  button 24 32 0 400 body
  caption 12 16 0 400 body
  numeric 24 32 0 400 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 0
  --radius-sm: 0
  --radius-md: 0
  --radius-lg: 0
  --radius-xl: 0
  --radius-pill: 0
}
stroke {
  --stroke-hairline: 2px
  --stroke-thin: 2px
  --stroke-regular: 2px
  --stroke-thick: 4px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 4 4 0 0 "#00000080"
  }
  floating {
    shadow 3 3 0 0 "#00000080"
  }
  overlay {
    shadow 6 6 0 0 "#000000b0"
  }
  top {
    shadow 8 8 0 0 "#000000c0"
  }
}
shape {
  panel square 0
  dialog square 0
  card square 0
  tooltip square 0
  button square 0
  field square 0
  chip notch 2
  badge notch 2
  tab square 0
  slot square 0
  bar square 0
  hud square 0
  avatar notch 4
}
ramp {
  xs 12 16
  meta 12 16
  caption 12 16
  sm 12 16
  body 24 32
  reading 24 32
  base 24 32
  lg 24 32
  xl 36 44
  xl2 36 44
  xl3 48 56
  xl4 36 44
  xl5 36 44
  xl6 48 56
  xl7 48 56
  xl8 60 68
  displaySm 48 56
  displayMd 60 68
  displayLg 72 80
  displayXl 48 56
  displayXl2 60 68
}
fonts {
  body "@styles/cjk/FusionPixel12-zhHans.ttf"
  display "@styles/cjk/FusionPixel12-zhHans.ttf"
  numeric "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjk "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjkDisplay "@styles/cjk/FusionPixel12-zhHans.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 128 24 line
tile 204 172 64 64 16 16 0.06 6
textShadow display 2 2 0 "#000000c0"
textShadow body 1 1 0 "#00000080"
motion {
  enter slideDown
  toast slideUp
  progress 240
  shake 4
  pop 0.0
  spring ui 100 0
  spring panel 160 0
  spring emphasis 240 0
  spring playful 320 0.1
  ease standard linear
  ease enter steps 4
  ease exit steps 3
  ease emphasis steps 6
  duration instant 80
  duration fast 120
  duration base 160
  duration slow 320
  duration spring 520
  duration bounce 640
  stagger 0
  staggerCap 0
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none pitch 0.9 1.1 haptic tick
  counterTick none pitch 1 1.5 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
Panel::frame {
  -og-slice: 4 4 96 96 8 tint
  -og-tone: 0.745 0.745 0.745 1.00
  box-shadow: 6px 6px 0 0 #000000b0
  -og-tile: true
}
Card::frame {
  -og-slice: 104 4 64 64 4 tint
  -og-tone: 0.791 0.791 0.791 1.00
  box-shadow: 4px 4px 0 0 #00000080
}
Button::base {
  -og-slice: 172 4 48 48 6 tint
  -og-tone: 0.708 0.708 0.708 1.00
  box-shadow: 0 4px 0 0 #000000a0
  -og-press: 1.0 1.0 3
  -og-hover: -1 1.0
}
Button::base:hover {
  -og-slice: 224 4 48 48 6 tint
  -og-tone: 0.913 0.913 0.913 1.00
}
Button::base:active {
  -og-slice: 276 4 48 48 6 tint
  -og-tone: 0.604 0.604 0.604 1.00
}
Button::base:disabled {
  -og-slice: 328 4 48 48 6 tint
  -og-tone: 0.521 0.521 0.521 1.00
}
Field::frame {
  -og-slice: 4 104 48 48 4 tint
  -og-tone: 0.871 0.871 0.871 1.00
}
Slot::frame {
  -og-slice: 56 104 48 48 4 tint
  -og-tone: 0.791 0.791 0.791 1.00
}
Tooltip::frame {
  -og-slice: 108 104 32 32 4 tint
  box-shadow: 3px 3px 0 0 #00000080
}
Hud::frame {
  -og-slice: 144 104 32 32 4 tint
  -og-tone: 0.791 0.791 0.791 1.00
  box-shadow: 3px 3px 0 0 #00000080
}
Meter::track {
  -og-slice: 180 104 32 16 4 tint
  -og-tone: 0.694 0.694 0.694 1.00
}
Meter::fill {
  -og-slice: 216 104 32 16 4 tint
  -og-tone: 0.791 0.791 0.791 1.00
}
Chip::base:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 2px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--primary) inside
}
Slider::track {
  -og-segments: 10 2 ramp var(--primary-active) var(--primary)
}
Inventory::item:selected {
  -og-stroke: 2px var(--primary) inside
}
