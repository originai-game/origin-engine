type style
version 1
---
# The pixel style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "pixel"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#14111f"
  well "#1d1930"
  panel "#2b2745"
  panelHover "#3a3459"
  panelRaised "#2b2745"
  line "#5b5480"
  lineStrong "#a79ccf"
  ink "#f4f1de"
  inkMuted "#c9c2a8"
  inkFaint "#ada792"
  inkInverse "#14111f"
  control "#3f3a5e"
  controlStrong "#4c4570"
  primary "#ffcd4a"
  primaryHover "#ffdb75"
  primaryActive "#e6ad1f"
  onPrimary "#14111f"
  primarySoft "#ffcd4a25"
  highlight "#ffd86b"
  focus "#ffcd4a"
  knob "#5b5480"
  hud "#221e38f2"
  scrim "#0a0812b3"
  shadow "#00000099"
  sheen "#ffffff52"
  success "#6bd36b"
  warn "#ffa53d"
  danger "#ff8080"
  info "#5dc2ff"
  health "#6bd36b"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#ffcd4a"
}
radius {
  small 0
  control 0
  bar 0
  panel 0
}
ramp {
  xs 12 16
  meta 13 18
  caption 13 18
  sm 14 18
  body 16 20
  reading 16 22
  base 16 22
  lg 18 24
  xl 22 28
  xl2 24 28
  xl3 28 32
  displaySm 32 36
  displayMd 36 40
  displayLg 44 48
}
durations {
  instant 80
  fast 120
  base 160
  slow 320
}
fonts {
  body "DotGothic16-Regular.ttf"
  display "DotGothic16-Regular.ttf"
  numeric "DotGothic16-Regular.ttf"
  cjk "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjkDisplay "@styles/cjk/FusionPixel12-zhHans.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 8 tint
tone panel 0.745 0.745 0.745 1.00
slice card 104 4 64 64 4 tint
tone card 0.791 0.791 0.791 1.00
slice button 172 4 48 48 6 tint
tone button 0.708 0.708 0.708 1.00
slice buttonHover 224 4 48 48 6 tint
tone buttonHover 0.913 0.913 0.913 1.00
slice buttonPressed 276 4 48 48 6 tint
tone buttonPressed 0.604 0.604 0.604 1.00
slice buttonDisabled 328 4 48 48 6 tint
tone buttonDisabled 0.521 0.521 0.521 1.00
slice field 4 104 48 48 4 tint
tone field 0.871 0.871 0.871 1.00
slice slot 56 104 48 48 4 tint
tone slot 0.791 0.791 0.791 1.00
slice tooltip 108 104 32 32 4 tint
slice hud 144 104 32 32 4 tint
tone hud 0.791 0.791 0.791 1.00
slice track 180 104 32 16 4 tint
tone track 0.694 0.694 0.694 1.00
slice fill 216 104 32 16 4 tint
tone fill 0.791 0.791 0.791 1.00
soft 252 104 64 64 24
divider 4 172 128 24 128 24 line
flourish 136 172 64 24 32 12 primary 0
tile 204 172 64 64 16 16 0.06 6 panel
shadow panel 6 6 0 0 "#000000b0"
shadow card 4 4 0 0 "#00000080"
shadow button 0 4 0 0 "#000000a0"
shadow hud 3 3 0 0 "#00000080"
shadow tooltip 3 3 0 0 "#00000080"
textShadow display 3 3 0 "#000000c0"
textShadow body 1 1 0 "#00000080"
textWeight body 0.5
press 1.0 1.0 3
hover -1 1.0
motion {
  enter slideDown
  stagger 0
  toast slideUp
  progress 240
  shake 4
  pop 0.0
}
