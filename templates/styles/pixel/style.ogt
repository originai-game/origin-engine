type style
version 2
---
# The pixel style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "pixel"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#14111f"
  well "#1d1930"
  panel "#2b2745"
  panelHover "#3a3459"
  panelRaised "#2b2745"
  line "#5b5480"
  lineStrong "#a79ccf"
  ink "#f4f1de"
  inkMuted "#c9c2a8"
  inkFaint "#ada792"
  inkInverse "#14111f"
  control "#3f3a5e"
  controlStrong "#4c4570"
  primary "#ffcd4a"
  primaryHover "#ffdb75"
  primaryActive "#e6ad1f"
  onPrimary "#14111f"
  primarySoft "#ffcd4a25"
  highlight "#ffd86b"
  focus "#ffcd4a"
  knob "#5b5480"
  hud "#221e38f2"
  scrim "#0a0812b3"
  shadow "#00000099"
  sheen "#ffffff52"
  success "#6bd36b"
  warn "#ffa53d"
  danger "#ff8080"
  info "#5dc2ff"
  health "#6bd36b"
  mana "#3097ff"
  xp "#c76ff4"
  gold "#ffcd4a"
}
colors {
  success icon "check"
  warn icon "flag"
  danger icon "skull"
  info pattern checks
  common "#bcbcbc" pips 1
  uncommon "#58d854" pips 2
  rare "#3cbcfc" pips 3
  epic "#d878f8" pips 4
  legendary "#fca044" pips 5
  mythic "#f83800" pips 6
  team1 "#3cbcfc"
  team2 "#f83800"
  team3 "#58d854"
  team4 "#f8b800"
  team5 "#d878f8"
  team6 "#fca044"
  team7 "#00e8d8"
  team8 "#f878f8"
  physical "#bcbcbc" icon "sword"
  fire "#f83800" icon "fire"
  ice "#3cbcfc" icon "drop"
  lightning "#f8b800" icon "bolt"
  poison "#58d854" pattern checks
  holy "#fcfcfc" icon "star"
  shadow "#9878f8" pattern grid
  arcane "#f878f8" pattern diamonds
  series1 "#3cbcfc"
  series2 "#f8b800"
  series3 "#f83800"
  series4 "#58d854"
  series5 "#d878f8"
  series6 "#00e8d8"
  series7 "#fca044"
  series8 "#bcbcbc"
}
typography {
  display 72 80 0 400 display {
    phonePortrait 60 68
    phoneLandscape 60 68
  }
  title 48 56 0 400 display
  heading 36 44 0 400 display
  body 24 32 0 400 body
  label 12 16 0 400 body
  button 24 32 0 400 body
  caption 12 16 0 400 body
  numeric 24 32 0 400 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 0
  sm 0
  md 0
  lg 0
  xl 0
  pill 0
}
stroke {
  hairline 2
  thin 2
  regular 2
  thick 4
  focus 2
}
elevation {
  raised {
    shadow 4 4 0 0 "#00000080"
  }
  floating {
    shadow 3 3 0 0 "#00000080"
  }
  overlay {
    shadow 6 6 0 0 "#000000b0"
  }
  top {
    shadow 8 8 0 0 "#000000c0"
  }
}
shape {
  panel square 0
  dialog square 0
  card square 0
  tooltip square 0
  button square 0
  field square 0
  chip notch 2
  badge notch 2
  tab square 0
  slot square 0
  bar square 0
  hud square 0
  avatar notch 4
}
ramp {
  xs 12 16
  meta 12 16
  caption 12 16
  sm 12 16
  body 24 32
  reading 24 32
  base 24 32
  lg 24 32
  xl 36 44
  xl2 36 44
  xl3 48 56
  xl4 36 44
  xl5 36 44
  xl6 48 56
  xl7 48 56
  xl8 60 68
  displaySm 48 56
  displayMd 60 68
  displayLg 72 80
  displayXl 48 56
  displayXl2 60 68
}
fonts {
  body "@styles/cjk/FusionPixel12-zhHans.ttf"
  display "@styles/cjk/FusionPixel12-zhHans.ttf"
  numeric "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjk "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjkDisplay "@styles/cjk/FusionPixel12-zhHans.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 128 24 line
tile 204 172 64 64 16 16 0.06 6
textShadow display 2 2 0 "#000000c0"
textShadow body 1 1 0 "#00000080"
motion {
  enter slideDown
  toast slideUp
  progress 240
  shake 4
  pop 0.0
  spring ui 100 0
  spring panel 160 0
  spring emphasis 240 0
  spring playful 320 0.1
  ease standard linear
  ease enter steps 4
  ease exit steps 3
  ease emphasis steps 6
  duration instant 80
  duration fast 120
  duration base 160
  duration slow 320
  duration spring 520
  duration bounce 640
  stagger 0
  staggerCap 0
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none pitch 0.9 1.1 haptic tick
  counterTick none pitch 1 1.5 haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 8 tint
  tone 0.745 0.745 0.745 1.00
  shadow 6 6 0 0 "#000000b0"
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 4 tint
  tone 0.791 0.791 0.791 1.00
  shadow 4 4 0 0 "#00000080"
}
dress "Button.base" {
  slice 172 4 48 48 6 tint
  tone 0.708 0.708 0.708 1.00
  shadow 0 4 0 0 "#000000a0"
  press 1.0 1.0 3
  hover -1 1.0
}
dress "Button.base[hover]" {
  slice 224 4 48 48 6 tint
  tone 0.913 0.913 0.913 1.00
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 6 tint
  tone 0.604 0.604 0.604 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 6 tint
  tone 0.521 0.521 0.521 1.00
}
dress "Field.frame" {
  slice 4 104 48 48 4 tint
  tone 0.871 0.871 0.871 1.00
}
dress "Slot.frame" {
  slice 56 104 48 48 4 tint
  tone 0.791 0.791 0.791 1.00
}
dress "Tooltip.frame" {
  slice 108 104 32 32 4 tint
  shadow 3 3 0 0 "#00000080"
}
dress "Hud.frame" {
  slice 144 104 32 32 4 tint
  tone 0.791 0.791 0.791 1.00
  shadow 3 3 0 0 "#00000080"
}
dress "Meter.track" {
  slice 180 104 32 16 4 tint
  tone 0.694 0.694 0.694 1.00
}
dress "Meter.fill" {
  slice 216 104 32 16 4 tint
  tone 0.791 0.791 0.791 1.00
}
