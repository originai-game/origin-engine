type style
version 2
---
# midcore: the mobile midcore strategy look, generated by og style new (docs/ui.md §12.5) for "a competitive card battler of chunky heroes, stone forts and lane pushes on floating islands".
# Choices: scheme dark, seed #52c234, shape round, ornament light, motion bouncy, finish bevel.
atlas "atlas.png" 512 262 2 3
name "midcore"
scheme dark
palette {
  backdrop "#1c2128"
  well "#14171c"
  panel "#2d3537"
  panelHover "#3e4547"
  panelRaised "#383f41"
  line "#515959"
  lineStrong "#919895"
  ink "#f5fbf3"
  inkMuted "#dadfdb"
  inkFaint "#bfc4c1"
  inkInverse "#2d3537"
  control "#3b4344"
  controlStrong "#495151"
  primary "#6acb50"
  primaryHover "#76cf5e"
  primaryActive "#82d36c"
  onPrimary "#122b0b"
  primarySoft "#6acb5038"
  highlight "#fff1c9"
  focus "#ffc83a"
  knob "#555d5d"
  hud "#2d3537f0"
  scrim "#0e1114b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#8ddeaa"
  warn "#f4c479"
  danger "#f0ada9"
  info "#6eb5ff"
  health "#86e195"
  mana "#9cc5f7"
  xp "#d4b1eb"
  gold "#f2cb5e"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#3b87f0" pips 3
  epic "#b65ff1" pips 4
  legendary "#ff8000" pips 5
  mythic "#eb5065" pips 6
  team1 "#4282ff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#af5eff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#976ef7"
  arcane "#ff4fd8"
  series1 "#658bb2"
  series2 "#f28e2b"
  series3 "#e25b5c"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 10
  sm 14
  md 20
  lg 30
  xl 40
  pill 9999
}
stroke {
  hairline 1.5
  thin 2
  regular 2.5
  thick 3.5
  focus 2.5
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel round 20
  dialog round 24
  card round 16
  tooltip round 10
  button round 14
  field round 11.2
  chip round pill
  badge round pill
  tab round 11.2
  slot round 15
  bar round pill
  hud round 14
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/Rubik-SemiBold.ttf"
  display "@styles/shared/TitanOne-Regular.ttf"
  numeric "@styles/shared/TitanOne-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/ZCOOLQingKeHuangYou-Regular.ttf"
}
icons "@styles/cartoon/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter pop
  toast pop
  progress 420
  shake 8
  pop 0.2
  spring ui 260 0.3
  spring panel 420 0.32
  spring emphasis 520 0.42
  spring playful 620 0.5
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 110
  duration fast 170
  duration base 280
  duration slow 420
  duration spring 560
  duration bounce 700
  stagger 60
  staggerCap 300
  overshoot 0.18
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.92 1.08 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.92 1.08 haptic tick
  confirm "sfx-confirm.ogt" volume 0.595 0.7 pitch 0.96 1.04 haptic tap
  cancel "sfx-back.ogt" volume 0.56 0.7 pitch 0.92 1.08 haptic tick
  back "sfx-back.ogt" volume 0.56 0.7 pitch 0.92 1.08 haptic tick
  open "sfx-open.ogt" volume 0.42 0.49 pitch 0.97 1.13 haptic none
  close "sfx-open.ogt" volume 0.35 0.42 pitch 0.77 0.93 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.49 0.63 pitch 1.07 1.23 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.42 0.49 pitch 1.12 1.28 haptic tick
  toggleOff "sfx-back.ogt" volume 0.42 0.49 pitch 1.02 1.18 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.35 pitch 1.24 1.56 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.21 pitch 1.36 1.84 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.315 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.49 0.56 pitch 1.22 1.38 haptic tap
  warning "sfx-error.ogt" volume 0.42 0.49 pitch 1.17 1.33 haptic warning
  error "sfx-error.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic error
  success "sfx-reward.ogt" volume 0.56 0.7 pitch 1.06 1.14 haptic success
  reward "sfx-reward.ogt" volume 0.63 0.7 pitch 0.96 1.04 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.49 pitch 0.82 0.98 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.49 0.56 pitch 0.87 1.03 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.56 0.63 pitch 1.07 1.23 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.595 0.7 pitch 0.86 0.94 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.63 0.7 pitch 0.76 0.84 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.7 0.7 pitch 0.66 0.74 haptic thud
}
dress "Button.base" {
  press 1.06 0.9 3
  hover -3 1.04
  fill linear 180 controlStrong control
  stroke 2 lineStrong inside
  effect innerShadow 2 2 0 0 "#ffffff4d"
  effect innerShadow -2 -2 0 0 "#0000004d"
}
dress "Panel.frame" {
  slice 1 1 96 96 24 24 24 24 authored
  tone 0.027 0.034 0.044 1
  stroke 2 "#919895" inside
  effect innerShadow 2 2 0 0 "#ffffff38"
  effect innerShadow -2 -2 0 0 "#00000059"
}
dress "Button.base[pressed]" {
  effect innerShadow 2 2 0 0 "#00000059"
}
dress "Slot.frame" {
  slice 197 1 64 64 16 16 16 16 authored
  tone 0.016 0.02 0.026 1
  stroke 2 lineStrong inside
  effect innerShadow 2 2 0 0 "#0000004d"
}
dress "Field.frame" {
  slice 144 191 135 40 12 12 12 12 authored
  tone 0.013 0.016 0.023 1
  effect innerShadow 2 2 0 0 "#0000004d"
}
dress "Meter.track" {
  stroke 2 lineStrong inside
}
dress "Button.base[primary]" {
  slice 1 145 141 44 18 14 18 14 authored
  tone 0.164 0.615 0.077 0.99
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#ffc83a" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Card.frame" {
  slice 99 1 96 96 20 20 20 20 authored
  tone 0.025 0.034 0.05 1
}
dress "Tooltip.frame" {
  slice 263 1 86 48 12 12 12 12 authored
  tone 0.033 0.04 0.055 1
}
dress "Hud.frame" {
  slice 281 191 124 40 14 12 14 12 authored
  tone 0.025 0.032 0.047 0.99
}
dress "Button.base[secondary]" {
  slice 351 1 154 44 18 14 18 14 authored
  tone 0.066 0.077 0.099 0.99
}
dress "Button.base[secondary][hover]" {
  slice 1 99 154 44 18 14 18 14 authored
  tone 0.075 0.088 0.111 0.99
}
dress "Button.base[secondary][pressed]" {
  slice 157 99 154 44 18 14 18 14 authored
  tone 0.042 0.049 0.062 0.99
}
dress "Button.base[secondary][disabled]" {
  slice 313 99 154 44 18 14 18 14 authored
  tone 0.053 0.055 0.059 0.99
}
dress "Button.base[primary][hover]" {
  slice 144 145 141 44 18 14 18 14 authored
  tone 0.233 0.663 0.136 0.99
}
dress "Button.base[primary][pressed]" {
  slice 287 145 141 44 18 14 18 14 authored
  tone 0.102 0.374 0.049 0.99
}
dress "Button.base[primary][disabled]" {
  slice 1 191 141 44 18 14 18 14 authored
  tone 0.216 0.295 0.19 0.99
}
corner 407 191 32 32 32 32 authored
divider 27 237 192 7 192 7 authored
dress "Slider.knob" {
  slice 441 191 24 24 1 1 1 1 authored
  tone 0.05 0.275 0.884 0.99
}
dress "Toggle.knob[on]" {
  slice 467 191 24 24 1 1 1 1 authored
  tone 0.823 0.857 0.897 0.99
}
dress "Toggle.knob[off]" {
  slice 1 237 24 24 1 1 1 1 authored
  tone 0.524 0.564 0.639 0.99
}
