type style
version 2
---
# kawaii: the kawaii anime gacha look, generated by og style new (docs/ui.md §12.5) for "an idol-collecting gacha game of pastel banners and star pulls".
# Choices: scheme light, seed #ff4f9a, shape pill, ornament light, motion bouncy, finish glass.
name "kawaii"
scheme light
palette {
  backdrop "#fff0f6"
  well "#f0e2e7"
  panel "#fff8fb"
  panelHover "#f6eff2"
  panelRaised "#fffbfd"
  line "#d9ced3"
  lineStrong "#97838c"
  ink "#2e0e1c"
  inkMuted "#5f4651"
  inkFaint "#6b5961"
  inkInverse "#fffdfe"
  control "#f0e8eb"
  controlStrong "#e2d7dc"
  primary "#ff87ba"
  primaryHover "#ff91c0"
  primaryActive "#ff9ac5"
  onPrimary "#381122"
  primarySoft "#ff87ba38"
  highlight "#694cc5"
  focus "#8a63ff"
  knob "#fffdfe"
  hud "#fff8fbf0"
  scrim "#80787bb3"
  shadow "#4014273d"
  sheen "#ffffff80"
  success "#1c5f35"
  warn "#764a0a"
  danger "#8b1c18"
  info "#184e8b"
  health "#186124"
  mana "#0c4897"
  xp "#5b2183"
  gold "#6c5109"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#929292" pips 1
  uncommon "#37a745" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#e67300" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#37a753"
  team4 "#b68d13"
  team5 "#a347ff"
  team6 "#de781b"
  team7 "#19a3a3"
  team8 "#f458a9"
  physical "#999285"
  fire "#f56629"
  ice "#4a9cc1"
  lightning "#ab9127"
  poison "#5fa342"
  holy "#a09265"
  shadow "#8a5cf6"
  arcane "#f54ccf"
  series1 "#4e79a7"
  series2 "#d67d26"
  series3 "#e15759"
  series4 "#659c98"
  series5 "#59a14f"
  series6 "#aa9134"
  series7 "#b07aa1"
  series8 "#cb7d85"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 12
  sm 22
  md 24
  lg 36
  xl 48
  pill 9999
}
stroke {
  hairline 1.5
  thin 2
  regular 2.5
  thick 3.5
  focus 2.5
}
elevation {
  raised {
    shadow 0 2 6 0 "#40142708"
    shadow 0 1 2 0 "#40142706"
  }
  floating {
    shadow 0 4 12 0 "#40142709"
    shadow 0 1 2 0 "#40142706"
  }
  overlay {
    shadow 0 8 24 0 "#4014270b"
    shadow 0 1 2 0 "#40142706"
  }
  top {
    shadow 0 14 36 0 "#4014270c"
    shadow 0 1 2 0 "#40142706"
  }
}
shape {
  panel round 24
  dialog round 28.8
  card round 19.2
  tooltip round 12
  button round pill
  field round pill
  chip round pill
  badge round pill
  tab round 17.6
  slot round 18
  bar round pill
  hud round 22
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/cartoon/Fredoka-SemiBold.ttf"
  display "@styles/cartoon/LilitaOne-Regular.ttf"
  numeric "@styles/cartoon/Fredoka-SemiBold.ttf"
  cjk "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "@styles/cartoon/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter pop
  toast pop
  progress 420
  shake 8
  pop 0.2
  spring ui 260 0.3
  spring panel 420 0.32
  spring emphasis 520 0.42
  spring playful 620 0.5
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 110
  duration fast 170
  duration base 280
  duration slow 420
  duration spring 560
  duration bounce 700
  stagger 60
  staggerCap 300
  overshoot 0.18
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.88 1.12 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.88 1.12 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 0.94 1.06 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 0.88 1.12 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 0.88 1.12 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 0.93 1.17 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.73 0.97 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.03 1.27 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.08 1.32 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 0.98 1.22 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.16 1.64 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.24 1.96 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.18 1.42 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.13 1.37 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 0.94 1.06 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.04 1.16 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 0.94 1.06 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.78 1.02 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.83 1.07 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.03 1.27 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.84 0.96 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.74 0.86 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.64 0.76 haptic thud
}
dress "Button.base" {
  press 1.06 0.9 3
  hover -3 1.04
  stroke 1 "#ffffff33" inside
}
dress "Panel.frame" {
  fill "#fff8fbd1"
  effect backdrop 18 saturation 1.3 tint "#fff8fb66"
  stroke 1 "#ffffff2e" inside
}
dress "Card.frame" {
  fill linear 160 "#fffbfdeb" "#fff8fbe0"
  stroke 1 "#ffffff24" inside
}
dress "Hud.frame" {
  effect backdrop 12 saturation 1.2 tint "#fff8fb80"
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#8a63ff" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
