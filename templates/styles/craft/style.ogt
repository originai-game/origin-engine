type style
version 3
---
# craft: the paper and craft look, generated by og style new (docs/ui.md §12.5) for "a cosy crafting sim of cut paper, stickers and tape".
# Choices: scheme light, seed #2f7d6d, shape round, ornament light, motion snappy, finish paper.
name "craft"
scheme light
palette {
  --backdrop: #d9bf94
  --well: #ccb48b
  --panel: #f2ede2
  --panel-hover: #eae5da
  --panel-raised: #f7f4ee
  --line: #c8c6bd
  --line-strong: #7d827b
  --ink: #081714
  --ink-muted: #38403d
  --ink-faint: #4d504d
  --ink-inverse: #fbfaf7
  --control: #e2ded4
  --control-strong: #d1cfc5
  --primary: #225a4e
  --primary-hover: #1f5348
  --primary-active: #1d4c42
  --on-primary: #f9fbfb
  --primary-soft: #225a4e38
  --highlight: #682e1c
  --focus: #a74b2d
  --knob: #fcfbf8
  --hud: #f2ede2f0
  --scrim: #6d604ab3
  --shadow: #0c1f1b3d
  --sheen: #ffffff80
  --success: #134024
  --warn: #503207
  --danger: #641412
  --info: #10355e
  --health: #114119
  --mana: #093269
  --xp: #491b6a
  --gold: #4a3706
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #8d8d8d pips 1
  --uncommon: #35a143 pips 2
  --rare: #2f7fef pips 3
  --epic: #a335ee pips 4
  --legendary: #dd6f00 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #35a150
  --team4: #b08812
  --team5: #a347ff
  --team6: #d6741a
  --team7: #199d9d
  --team8: #eb55a3
  --physical: #938d80
  --fire: #ec6228
  --ice: #4796b9
  --lightning: #a58b25
  --poison: #5b9d3f
  --holy: #9b8d61
  --shadow: #8a5cf6
  --arcane: #ec49c8
  --series1: #4e79a7
  --series2: #cd7925
  --series3: #e15759
  --series4: #629793
  --series5: #579d4d
  --series6: #a48c32
  --series7: #b07aa1
  --series8: #c47880
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 10px
  --radius-sm: 14px
  --radius-md: 20px
  --radius-lg: 30px
  --radius-xl: 40px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1.5px
  --stroke-thin: 2px
  --stroke-regular: 2.5px
  --stroke-thick: 3.5px
  --stroke-focus: 2.5px
}
elevation {
  raised {
    shadow 0 2 6 0 "#0c1f1b08"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  floating {
    shadow 0 4 12 0 "#0c1f1b09"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  overlay {
    shadow 0 8 24 0 "#0c1f1b0b"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  top {
    shadow 0 14 36 0 "#0c1f1b0c"
    shadow 0 1 2 0 "#0c1f1b06"
  }
}
shape {
  panel round 20
  dialog round 24
  card round 16
  tooltip round 10
  button round 14
  field round 11.2
  chip round pill
  badge round pill
  tab round 11.2
  slot round 15
  bar round pill
  hud round 14
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/InstrumentSans-Regular.ttf"
  display "@styles/cartoon/LilitaOne-Regular.ttf"
  numeric "@styles/shared/PTMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "@styles/shared/ink-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter slideUp
  toast slideDown
  progress 340
  shake 6
  pop 0.06
  spring ui 150 0
  spring panel 240 0.04
  spring emphasis 320 0.12
  spring playful 400 0.18
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 340
  duration spring 420
  duration bounce 520
  stagger 30
  staggerCap 300
  overshoot 0.04
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  confirm "sfx-confirm.ogt" volume 0.468 0.55 pitch 0.955 1.045 haptic tap
  cancel "sfx-back.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  back "sfx-back.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  open "sfx-open.ogt" volume 0.33 0.385 pitch 0.96 1.14 haptic none
  close "sfx-open.ogt" volume 0.275 0.33 pitch 0.76 0.94 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.385 0.495 pitch 1.06 1.24 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.33 0.385 pitch 1.11 1.29 haptic tick
  toggleOff "sfx-back.ogt" volume 0.33 0.385 pitch 1.01 1.19 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.275 pitch 1.22 1.58 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.11 0.165 pitch 1.33 1.87 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.248 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.385 0.44 pitch 1.21 1.39 haptic tap
  warning "sfx-error.ogt" volume 0.33 0.385 pitch 1.16 1.34 haptic warning
  error "sfx-error.ogt" volume 0.44 0.55 pitch 0.955 1.045 haptic error
  success "sfx-reward.ogt" volume 0.44 0.55 pitch 1.055 1.145 haptic success
  reward "sfx-reward.ogt" volume 0.495 0.55 pitch 0.955 1.045 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.33 0.385 pitch 0.81 0.99 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.385 0.44 pitch 0.86 1.04 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.44 0.495 pitch 1.06 1.24 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.468 0.55 pitch 0.855 0.945 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.495 0.55 pitch 0.755 0.845 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.55 0.55 pitch 0.655 0.745 haptic thud
}
Button::base {
  -og-press: 0.97 0.97 1
  -og-hover: -1 1.01
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: drop-shadow 2 3 0 0 #0817144d
}
Panel::frame {
  -og-fill: linear 174 var(--panel-raised) var(--panel) 0.2 var(--panel-raised) 0.38 var(--panel) 0.55 var(--panel-raised) 0.8 var(--panel)
  -og-stroke: 2px var(--line-strong) inside dash 7 4 round
  -og-effect: drop-shadow 4 5 0 0 #08171433
}
Card::frame {
  -og-fill: linear 174 var(--panel-raised) var(--panel) 0.2 var(--panel-raised) 0.38 var(--panel) 0.55 var(--panel-raised) 0.8 var(--panel)
  -og-stroke: 1.5px var(--line-strong) inside dash 6 4 round
  -og-effect: drop-shadow 3 4 0 0 #0817142e
}
Button::base:active {
  -og-effect: drop-shadow 0 1 0 0 #0817144d
  -og-effect: inner-shadow 1 2 0 0 #0c1f1b0f
}
Field::frame {
  -og-stroke: 1.5px var(--line-strong) inside dash 5 3
}
Slot::frame {
  -og-stroke: 1.5px var(--line-strong) inside dash 4 3 round
  -og-effect: drop-shadow 2 2 0 0 #08171424
}
Tooltip::frame {
  -og-effect: drop-shadow 2 3 0 0 #08171438
}
Chip::base {
  -og-stroke: 1.5px var(--line-strong) inside dash 4 3
}
Button::base.primary {
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Inventory::item {
  -og-stroke: 1.5px var(--line-strong) inside dash 4 3 round
  -og-effect: drop-shadow 2 2 0 0 #08171424
}
Inventory::item:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
