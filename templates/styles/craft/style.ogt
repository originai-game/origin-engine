type style
version 2
---
# craft: the paper and craft look, generated by og style new (docs/ui.md §12.5) for "a cosy crafting sim of cut paper, stickers and tape".
# Choices: scheme light, seed #2f7d6d, shape round, ornament light, motion snappy, finish paper.
name "craft"
scheme light
palette {
  backdrop "#d9bf94"
  well "#ccb48b"
  panel "#f2ede2"
  panelHover "#eae5da"
  panelRaised "#f7f4ee"
  line "#c8c6bd"
  lineStrong "#7d827b"
  ink "#081714"
  inkMuted "#38403d"
  inkFaint "#4d504d"
  inkInverse "#fbfaf7"
  control "#e2ded4"
  controlStrong "#d1cfc5"
  primary "#225a4e"
  primaryHover "#1f5348"
  primaryActive "#1d4c42"
  onPrimary "#f9fbfb"
  primarySoft "#225a4e38"
  highlight "#682e1c"
  focus "#a74b2d"
  knob "#fcfbf8"
  hud "#f2ede2f0"
  scrim "#6d604ab3"
  shadow "#0c1f1b3d"
  sheen "#ffffff80"
  success "#134024"
  warn "#503207"
  danger "#641412"
  info "#10355e"
  health "#114119"
  mana "#093269"
  xp "#491b6a"
  gold "#4a3706"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#8d8d8d" pips 1
  uncommon "#35a143" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#dd6f00" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#35a150"
  team4 "#b08812"
  team5 "#a347ff"
  team6 "#d6741a"
  team7 "#199d9d"
  team8 "#eb55a3"
  physical "#938d80"
  fire "#ec6228"
  ice "#4796b9"
  lightning "#a58b25"
  poison "#5b9d3f"
  holy "#9b8d61"
  shadow "#8a5cf6"
  arcane "#ec49c8"
  series1 "#4e79a7"
  series2 "#cd7925"
  series3 "#e15759"
  series4 "#629793"
  series5 "#579d4d"
  series6 "#a48c32"
  series7 "#b07aa1"
  series8 "#c47880"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 10
  sm 14
  md 20
  lg 30
  xl 40
  pill 9999
}
stroke {
  hairline 1.5
  thin 2
  regular 2.5
  thick 3.5
  focus 2.5
}
elevation {
  raised {
    shadow 0 2 6 0 "#0c1f1b08"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  floating {
    shadow 0 4 12 0 "#0c1f1b09"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  overlay {
    shadow 0 8 24 0 "#0c1f1b0b"
    shadow 0 1 2 0 "#0c1f1b06"
  }
  top {
    shadow 0 14 36 0 "#0c1f1b0c"
    shadow 0 1 2 0 "#0c1f1b06"
  }
}
shape {
  panel round 20
  dialog round 24
  card round 16
  tooltip round 10
  button round 14
  field round 11.2
  chip round pill
  badge round pill
  tab round 11.2
  slot round 15
  bar round pill
  hud round 14
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/InstrumentSans-Regular.ttf"
  display "@styles/cartoon/LilitaOne-Regular.ttf"
  numeric "@styles/shared/PTMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "@styles/shared/ink-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter slideUp
  toast slideDown
  progress 340
  shake 6
  pop 0.06
  spring ui 150 0
  spring panel 240 0.04
  spring emphasis 320 0.12
  spring playful 400 0.18
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 340
  duration spring 420
  duration bounce 520
  stagger 30
  staggerCap 300
  overshoot 0.04
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  confirm "sfx-confirm.ogt" volume 0.468 0.55 pitch 0.955 1.045 haptic tap
  cancel "sfx-back.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  back "sfx-back.ogt" volume 0.44 0.55 pitch 0.91 1.09 haptic tick
  open "sfx-open.ogt" volume 0.33 0.385 pitch 0.96 1.14 haptic none
  close "sfx-open.ogt" volume 0.275 0.33 pitch 0.76 0.94 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.385 0.495 pitch 1.06 1.24 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.33 0.385 pitch 1.11 1.29 haptic tick
  toggleOff "sfx-back.ogt" volume 0.33 0.385 pitch 1.01 1.19 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.275 pitch 1.22 1.58 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.11 0.165 pitch 1.33 1.87 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.248 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.385 0.44 pitch 1.21 1.39 haptic tap
  warning "sfx-error.ogt" volume 0.33 0.385 pitch 1.16 1.34 haptic warning
  error "sfx-error.ogt" volume 0.44 0.55 pitch 0.955 1.045 haptic error
  success "sfx-reward.ogt" volume 0.44 0.55 pitch 1.055 1.145 haptic success
  reward "sfx-reward.ogt" volume 0.495 0.55 pitch 0.955 1.045 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.33 0.385 pitch 0.81 0.99 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.385 0.44 pitch 0.86 1.04 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.44 0.495 pitch 1.06 1.24 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.468 0.55 pitch 0.855 0.945 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.495 0.55 pitch 0.755 0.845 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.55 0.55 pitch 0.655 0.745 haptic thud
}
dress "Button.base" {
  press 0.97 0.97 1
  hover -1 1.01
  stroke 2 lineStrong inside
  effect dropShadow 2 3 0 0 "#0817144d"
}
dress "Panel.frame" {
  fill linear 174 panelRaised panel 0.2 panelRaised 0.38 panel 0.55 panelRaised 0.8 panel
  stroke 2 lineStrong inside dash 7 4 round
  effect dropShadow 4 5 0 0 "#08171433"
}
dress "Card.frame" {
  fill linear 174 panelRaised panel 0.2 panelRaised 0.38 panel 0.55 panelRaised 0.8 panel
  stroke 1.5 lineStrong inside dash 6 4 round
  effect dropShadow 3 4 0 0 "#0817142e"
}
dress "Button.base[pressed]" {
  effect dropShadow 0 1 0 0 "#0817144d"
  effect innerShadow 1 2 0 0 "#0c1f1b0f"
}
dress "Field.frame" {
  stroke 1.5 lineStrong inside dash 5 3
}
dress "Slot.frame" {
  stroke 1.5 lineStrong inside dash 4 3 round
  effect dropShadow 2 2 0 0 "#08171424"
}
dress "Tooltip.frame" {
  effect dropShadow 2 3 0 0 "#08171438"
}
dress "Chip.base" {
  stroke 1.5 lineStrong inside dash 4 3
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Chip.base[selected]" {
  stroke 1.5 primary inside
}
dress "Tabs.tab[selected]" {
  stroke 1.5 primary inside
}
dress "Slot.frame[selected]" {
  stroke 1.5 primary inside
}
dress "Tabs.tab[selected][underline]" {
  fill none
  stroke none
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
