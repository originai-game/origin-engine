type style
version 1
---
# The cartoon style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "cartoon"
scheme light
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#2a1d5c"
  well "#33246e"
  panel "#fff4dc"
  panelHover "#ffe9bd"
  panelRaised "#fff4dc"
  line "#2b1a4a"
  lineStrong "#2b1a4a"
  ink "#2b1a4a"
  inkMuted "#5a4880"
  inkFaint "#61527c"
  inkInverse "#fff4dc"
  control "#fff3cc"
  controlStrong "#ffecb5"
  primary "#8c360f"
  primaryHover "#933a10"
  primaryActive "#772d0b"
  onPrimary "#fff4dc"
  primarySoft "#8c360f40"
  highlight "#9b3a09"
  focus "#3fa7ff"
  knob "#ffffff"
  hud "#fff4dcf5"
  scrim "#1a0f3ccc"
  shadow "#2b1a4a99"
  sheen "#ffffff52"
  success "#06681b"
  warn "#7b5102"
  danger "#6a0a16"
  info "#2256af"
  health "#06681b"
  mana "#007aff"
  xp "#af52de"
  gold "#a24112"
}
radius {
  small 6
  control 6
  bar 6
  panel 10
}
ramp {
  body 15 20
  meta 13 18
  caption 13 18
  lg 19 26
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 52 56
}
durations {
  instant 110
  fast 160
  base 280
  slow 420
}
fonts {
  body "Fredoka-SemiBold.ttf"
  display "LilitaOne-Regular.ttf"
  numeric "LilitaOne-Regular.ttf"
  cjk "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
  cjkDisplay "@styles/cjk/ZCOOLKuaiLe-Regular.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 16 tint
tone panel 0.933 0.933 0.933 1.00
slice card 104 4 64 64 14 tint
tone card 0.922 0.922 0.922 1.00
slice button 172 4 48 48 12 tint
tone button 0.830 0.830 0.830 1.00
slice buttonHover 224 4 48 48 12 tint
tone buttonHover 0.913 0.913 0.913 1.00
slice buttonPressed 276 4 48 48 12 tint
tone buttonPressed 0.711 0.711 0.711 1.00
slice buttonDisabled 328 4 48 48 12 tint
tone buttonDisabled 0.711 0.711 0.711 1.00
slice field 4 104 48 48 10 tint
tone field 0.890 0.890 0.890 1.00
slice slot 56 104 48 48 10 tint
tone slot 0.828 0.828 0.828 1.00
slice tooltip 108 104 32 32 10 tint
tone tooltip 0.944 0.944 0.944 1.00
slice hud 144 104 32 32 10 tint
tone hud 0.890 0.890 0.890 1.00
slice track 180 104 32 16 7 tint
tone track 0.738 0.738 0.738 1.00
slice fill 216 104 32 16 7 tint
tone fill 0.839 0.839 0.839 1.00
soft 252 104 64 64 24
divider 4 172 128 24 48 16 primary
flourish 136 172 64 24 22 10 primary 2
shadow panel 0 8 0 0 "#2b1a4acc"
shadow card 0 5 0 0 "#2b1a4a99"
shadow button 0 5 0 0 "#2b1a4acc"
shadow hud 0 4 0 0 "#2b1a4a99"
shadow slot 0 3 0 0 "#2b1a4a66"
textShadow display 0 4 0 "#2b1a4a"
press 1.08 0.88 3
hover -3 1.04
motion {
  enter pop
  stagger 50
  toast pop
  progress 360
  shake 8
  pop 0.22
}
