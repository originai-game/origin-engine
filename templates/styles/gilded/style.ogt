type style
version 3
---
# gilded: the ornate fantasy look, generated by og style new (docs/ui.md §12.5) for "a high-fantasy RPG of guilds, relics and gilded halls".
# Choices: scheme dark, seed #c9973a, shape notch, ornament rich, motion heavy, finish gradient.
name "gilded"
scheme dark
palette {
  --backdrop: #15100b
  --well: #0f0b08
  --panel: #2a251d
  --panel-hover: #3b362f
  --panel-raised: #353028
  --line: #504b44
  --line-strong: #938f88
  --ink: #fcf9f3
  --ink-muted: #cdcac4
  --ink-faint: #b4b1ac
  --ink-inverse: #2a251d
  --control: #39342c
  --control-strong: #47433b
  --primary: #d4ac61
  --primary-hover: #d7b36e
  --primary-active: #dbb97a
  --on-primary: #2c210d
  --primary-soft: #d4ac6138
  --highlight: #f5e5ba
  --focus: #e8c46a
  --knob: #544f48
  --hud: #2a251df0
  --scrim: #0b0806b3
  --shadow: #0000008c
  --sheen: #ffffff38
  --success: #69d390
  --warn: #f0af4c
  --danger: #ec9893
  --info: #87b6ea
  --health: #64d877
  --mana: #81b4f5
  --xp: #c89de6
  --gold: #f0c54c
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #9e9e9e pips 1
  --uncommon: #3fbf4f pips 2
  --rare: #2f7fef pips 3
  --epic: #ab45ef pips 4
  --legendary: #ff8000 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #3fbf5f
  --team4: #ffc61a
  --team5: #a347ff
  --team6: #ff8a1f
  --team7: #1fc7c7
  --team8: #ff5cb0
  --physical: #b8b0a0
  --fire: #ff6a2b
  --ice: #62cfff
  --lightning: #ffd83a
  --poison: #7ed957
  --holy: #ffe9a0
  --shadow: #8a5cf6
  --arcane: #ff4fd8
  --series1: #527ca9
  --series2: #f28e2b
  --series3: #e15759
  --series4: #76b7b2
  --series5: #59a14f
  --series6: #edc948
  --series7: #b07aa1
  --series8: #ff9da7
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 4px
  --radius-sm: 6px
  --radius-md: 10px
  --radius-lg: 15px
  --radius-xl: 20px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.5px
  --stroke-regular: 2px
  --stroke-thick: 3px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel notch 10
  dialog notch 12
  card notch 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 4
  badge bevel 4
  tab bevel 4.8
  slot notch 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/fantasy/Newsreader-Medium.ttf"
  display "@styles/fantasy/Cinzel-Bold.ttf"
  numeric "@styles/fantasy/Cinzel-Bold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/fantasy/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0000008c"
motion {
  enter slideUp
  toast slideUp
  progress 520
  shake 10
  pop 0.03
  spring ui 240 0
  spring panel 500 0.03
  spring emphasis 640 0.06
  spring playful 700 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 130
  duration fast 220
  duration base 360
  duration slow 520
  duration spring 640
  duration bounce 760
  stagger 70
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  confirm "sfx-confirm.ogt" volume 0.595 0.7 pitch 0.98 1.02 haptic tap
  cancel "sfx-back.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  back "sfx-back.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  open "sfx-open.ogt" volume 0.42 0.49 pitch 1.01 1.09 haptic none
  close "sfx-open.ogt" volume 0.35 0.42 pitch 0.81 0.89 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.49 0.63 pitch 1.11 1.19 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.42 0.49 pitch 1.16 1.24 haptic tick
  toggleOff "sfx-back.ogt" volume 0.42 0.49 pitch 1.06 1.14 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.35 pitch 1.32 1.48 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.21 pitch 1.48 1.72 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.315 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.49 0.56 pitch 1.26 1.34 haptic tap
  warning "sfx-error.ogt" volume 0.42 0.49 pitch 1.21 1.29 haptic warning
  error "sfx-error.ogt" volume 0.56 0.7 pitch 0.98 1.02 haptic error
  success "sfx-reward.ogt" volume 0.56 0.7 pitch 1.08 1.12 haptic success
  reward "sfx-reward.ogt" volume 0.63 0.7 pitch 0.98 1.02 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.49 pitch 0.86 0.94 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.49 0.56 pitch 0.91 0.99 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.56 0.63 pitch 1.11 1.19 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.595 0.7 pitch 0.88 0.92 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.63 0.7 pitch 0.78 0.82 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.7 0.7 pitch 0.68 0.72 haptic thud
}
Button::base {
  -og-press: 1 0.96 2
  -og-hover: 0 1
  -og-fill: linear 180 var(--control-strong) var(--control)
  -og-stroke: 2.5px linear 180 #e8c46a var(--primary) var(--primary-active) inside
  -og-effect: drop-shadow 0 4 0 0 #0000006c
  -og-effect: inner-shadow 0 -3 0 0 #00000029
}
Panel::frame {
  -og-fill: linear 180 var(--panel-raised) var(--panel) var(--well)
  -og-fill: radial #e8c46a1a #e8c46a00
  -og-stroke: 3px linear 180 #e8c46a var(--primary) var(--primary-active) inside
  -og-stroke: 1px #e8c46a59 outside
  -og-effect: drop-shadow 0 6 0 0 #0000006c
  -og-effect: inner-glow 16 #e8c46a24
  -og-ornament: corner
}
Card::frame {
  -og-fill: linear 180 var(--panel-raised) var(--panel)
  -og-stroke: 2px linear 180 #e8c46a var(--primary) var(--primary-active) inside
  -og-effect: drop-shadow 0 4 0 0 #0000004d
  -og-effect: inner-glow 10 #e8c46a1a
  -og-ornament: corner
}
Button::base:hover {
  -og-effect: outer-glow 8 #e8c46a4d
}
Button::base:active {
  -og-effect: inner-shadow 0 3 0 0 #00000038
}
Field::frame {
  -og-stroke: 1.5px linear 180 #e8c46a var(--primary) var(--primary-active) inside
}
Slot::frame {
  -og-stroke: 2px linear 180 #e8c46a var(--primary) var(--primary-active) inside
  -og-effect: inner-shadow 0 3 0 0 #0000002e
}
Tooltip::frame {
  -og-stroke: 1.5px linear 180 #e8c46a var(--primary) var(--primary-active) inside
}
Meter::track {
  -og-stroke: 1.5px #e8c46a8c inside
}
Meter::fill {
  -og-effect: inner-shadow 0 -3 0 0 #0000002e
  -og-effect: inner-shadow 0 2 0 0 #ffffff59
}
Chip::base {
  -og-stroke: 1.5px linear 180 #e8c46a var(--primary) var(--primary-active) inside
}
Button::base.primary {
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Dialog::frame {
  -og-ornament: corner
}
Inventory::item {
  -og-stroke: 2px linear 180 #e8c46a var(--primary) var(--primary-active) inside
  -og-effect: inner-shadow 0 3 0 0 #0000002e
}
Inventory::item:selected {
  -og-stroke: 2px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
