type style
version 2
---
# gilded: the ornate fantasy look, generated by og style new (docs/ui.md §12.5) for "a high-fantasy RPG of guilds, relics and gilded halls".
# Choices: scheme dark, seed #c9973a, shape notch, ornament rich, motion heavy, finish gradient.
name "gilded"
scheme dark
palette {
  backdrop "#15100b"
  well "#0f0b08"
  panel "#2a251d"
  panelHover "#3b362f"
  panelRaised "#353028"
  line "#504b44"
  lineStrong "#938f88"
  ink "#fcf9f3"
  inkMuted "#cdcac4"
  inkFaint "#b4b1ac"
  inkInverse "#2a251d"
  control "#39342c"
  controlStrong "#47433b"
  primary "#d4ac61"
  primaryHover "#d7b36e"
  primaryActive "#dbb97a"
  onPrimary "#2c210d"
  primarySoft "#d4ac6138"
  highlight "#f5e5ba"
  focus "#e8c46a"
  knob "#544f48"
  hud "#2a251df0"
  scrim "#0b0806b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f0af4c"
  danger "#ec9893"
  info "#87b6ea"
  health "#64d877"
  mana "#81b4f5"
  xp "#c89de6"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#ab45ef" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#527ca9"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel notch 10
  dialog notch 12
  card notch 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 4
  badge bevel 4
  tab bevel 4.8
  slot notch 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/fantasy/Newsreader-Medium.ttf"
  display "@styles/fantasy/Cinzel-Bold.ttf"
  numeric "@styles/fantasy/Cinzel-Bold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/fantasy/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0000008c"
motion {
  enter slideUp
  toast slideUp
  progress 520
  shake 10
  pop 0.03
  spring ui 240 0
  spring panel 500 0.03
  spring emphasis 640 0.06
  spring playful 700 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 130
  duration fast 220
  duration base 360
  duration slow 520
  duration spring 640
  duration bounce 760
  stagger 70
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  confirm "sfx-confirm.ogt" volume 0.595 0.7 pitch 0.98 1.02 haptic tap
  cancel "sfx-back.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  back "sfx-back.ogt" volume 0.56 0.7 pitch 0.96 1.04 haptic tick
  open "sfx-open.ogt" volume 0.42 0.49 pitch 1.01 1.09 haptic none
  close "sfx-open.ogt" volume 0.35 0.42 pitch 0.81 0.89 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.49 0.63 pitch 1.11 1.19 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.42 0.49 pitch 1.16 1.24 haptic tick
  toggleOff "sfx-back.ogt" volume 0.42 0.49 pitch 1.06 1.14 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.35 pitch 1.32 1.48 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.14 0.21 pitch 1.48 1.72 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.245 0.315 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.49 0.56 pitch 1.26 1.34 haptic tap
  warning "sfx-error.ogt" volume 0.42 0.49 pitch 1.21 1.29 haptic warning
  error "sfx-error.ogt" volume 0.56 0.7 pitch 0.98 1.02 haptic error
  success "sfx-reward.ogt" volume 0.56 0.7 pitch 1.08 1.12 haptic success
  reward "sfx-reward.ogt" volume 0.63 0.7 pitch 0.98 1.02 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.49 pitch 0.86 0.94 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.49 0.56 pitch 0.91 0.99 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.56 0.63 pitch 1.11 1.19 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.595 0.7 pitch 0.88 0.92 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.63 0.7 pitch 0.78 0.82 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.7 0.7 pitch 0.68 0.72 haptic thud
}
dress "Button.base" {
  press 1 0.96 2
  hover 0 1
  fill linear 180 controlStrong control
  stroke 2.5 linear 180 "#e8c46a" primary primaryActive inside
  effect dropShadow 0 4 0 0 "#0000006c"
  effect innerShadow 0 -3 0 0 "#00000029"
}
dress "Panel.frame" {
  fill linear 180 panelRaised panel well
  fill radial "#e8c46a1a" "#e8c46a00"
  stroke 3 linear 180 "#e8c46a" primary primaryActive inside
  stroke 1 "#e8c46a59" outside
  effect dropShadow 0 6 0 0 "#0000006c"
  effect innerGlow 16 "#e8c46a24"
  ornament corner
}
dress "Card.frame" {
  fill linear 180 panelRaised panel
  stroke 2 linear 180 "#e8c46a" primary primaryActive inside
  effect dropShadow 0 4 0 0 "#0000004d"
  effect innerGlow 10 "#e8c46a1a"
  ornament corner
}
dress "Button.base[hover]" {
  effect outerGlow 8 "#e8c46a4d"
}
dress "Button.base[pressed]" {
  effect innerShadow 0 3 0 0 "#00000038"
}
dress "Field.frame" {
  stroke 1.5 linear 180 "#e8c46a" primary primaryActive inside
}
dress "Slot.frame" {
  stroke 2 linear 180 "#e8c46a" primary primaryActive inside
  effect innerShadow 0 3 0 0 "#0000002e"
}
dress "Tooltip.frame" {
  stroke 1.5 linear 180 "#e8c46a" primary primaryActive inside
}
dress "Meter.track" {
  stroke 1.5 "#e8c46a8c" inside
}
dress "Meter.fill" {
  effect innerShadow 0 -3 0 0 "#0000002e"
  effect innerShadow 0 2 0 0 "#ffffff59"
}
dress "Chip.base" {
  stroke 1.5 linear 180 "#e8c46a" primary primaryActive inside
}
dress "Tabs.tab[selected]" {
  stroke 2 linear 180 "#e8c46a" primary primaryActive inside
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#e8c46a" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Dialog.frame" {
  ornament corner
}
