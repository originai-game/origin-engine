type style
version 2
---
# holo: the sci-fi holographic look, generated by og style new (docs/ui.md §12.5) for "a starship command game on holographic consoles".
# Choices: scheme dark, seed #3cc8ff, shape cut, ornament light, motion snappy, finish hologram.
name "holo"
scheme dark
palette {
  backdrop "#050d16"
  well "#04090f"
  panel "#18232d"
  panelHover "#2a353e"
  panelRaised "#242e38"
  line "#3f4a53"
  lineStrong "#869096"
  ink "#f3fcff"
  inkMuted "#bdc7cb"
  inkFaint "#a5aeb3"
  inkInverse "#18232d"
  control "#27323c"
  controlStrong "#37414a"
  primary "#3cc8ff"
  primaryHover "#4cccff"
  primaryActive "#5bd1ff"
  onPrimary "#0d2c38"
  primarySoft "#3cc8ff38"
  highlight "#b1f6ff"
  focus "#7ef0ff"
  knob "#444e57"
  hud "#18232df0"
  scrim "#03070bb3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f0af4c"
  danger "#eb918c"
  info "#82b3e9"
  health "#64d877"
  mana "#7cb1f4"
  xp "#c597e4"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#a73eef" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#4e79a7"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 12 17 0.06 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.25
  regular 1.75
  thick 2.5
  focus 2
}
elevation {
  raised {
    shadow 0 2 6 0 "#0000002b"
    shadow 0 1 2 0 "#0000001f"
  }
  floating {
    shadow 0 4 12 0 "#00000031"
    shadow 0 1 2 0 "#0000001f"
  }
  overlay {
    shadow 0 8 24 0 "#00000038"
    shadow 0 1 2 0 "#0000001f"
  }
  top {
    shadow 0 14 36 0 "#0000003e"
    shadow 0 1 2 0 "#0000001f"
  }
}
shape {
  panel bevel 10
  dialog bevel 12
  card bevel 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 6
  badge bevel 6
  tab bevel 4.8
  slot bevel 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/scifi/ChakraPetch-Medium.ttf"
  display "@styles/scifi/Orbitron-Bold.ttf"
  numeric "@styles/scifi/JetBrainsMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/scifi/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textGlow display 1.4 primary 0.45
motion {
  enter slideUp
  toast slideDown
  progress 340
  shake 6
  pop 0.06
  spring ui 150 0
  spring panel 240 0.04
  spring emphasis 320 0.12
  spring playful 400 0.18
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 340
  duration spring 420
  duration bounce 520
  stagger 30
  staggerCap 300
  overshoot 0.04
}
sounds {
  hover "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.125 0.175 pitch 1.2 1.3 haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  confirm "sfx-confirm.ogt" volume 0.425 0.5 pitch 0.975 1.025 haptic tap
  cancel "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  back "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  open "sfx-open.ogt" volume 0.3 0.35 pitch 1 1.1 haptic none
  close "sfx-open.ogt" volume 0.25 0.3 pitch 0.8 0.9 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.35 0.45 pitch 1.1 1.2 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.3 0.35 pitch 1.15 1.25 haptic tick
  toggleOff "sfx-back.ogt" volume 0.3 0.35 pitch 1.05 1.15 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.25 pitch 1.3 1.5 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.1 0.15 pitch 1.45 1.75 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.225 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.35 0.4 pitch 1.25 1.35 haptic tap
  warning "sfx-error.ogt" volume 0.3 0.35 pitch 1.2 1.3 haptic warning
  error "sfx-error.ogt" volume 0.4 0.5 pitch 0.975 1.025 haptic error
  success "sfx-reward.ogt" volume 0.4 0.5 pitch 1.075 1.125 haptic success
  reward "sfx-reward.ogt" volume 0.45 0.5 pitch 0.975 1.025 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.3 0.35 pitch 0.85 0.95 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.35 0.4 pitch 0.9 1 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.4 0.45 pitch 1.1 1.2 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.425 0.5 pitch 0.875 0.925 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.45 0.5 pitch 0.775 0.825 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.5 0.5 pitch 0.675 0.725 haptic thud
}
dress "Button.base" {
  press 0.97 0.97 1
  hover -1 1.01
  stroke 1.5 "#7ef0ffbf" inside
  effect outerGlow 6 "#7ef0ff24"
}
dress "Panel.frame" {
  fill linear 180 panel well
  stroke 1.5 "#7ef0ffcc" inside
  effect outerGlow 10 "#7ef0ff2d"
  effect innerGlow 14 "#7ef0ff1f"
}
dress "Card.frame" {
  stroke 1 "#7ef0ff8c" inside
  effect innerGlow 10 "#7ef0ff1a"
}
dress "Button.base[primary]" {
  effect outerGlow 12 "#3cc8ff59"
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Button.base[hover]" {
  effect outerGlow 12 "#7ef0ff3e"
}
dress "Field.frame[focused]" {
  effect outerGlow 8 "#7ef0ff36"
}
dress "Meter.fill" {
  effect outerGlow 8 "#3cc8ff36"
}
dress "Tabs.tab[selected]" {
  stroke 1.5 "#7ef0ffe6" inside
}
dress "Hud.frame" {
  effect backdrop 10 saturation 1.2 tint "#18232d73"
}
dress "Slot.frame[selected]" {
  stroke 2 "#7ef0ff" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
