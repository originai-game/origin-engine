type style
version 3
---
# dread: the diegetic horror look, generated by og style new (docs/ui.md §12.5) for "a survival horror game read through notes, tapes and a dying torch".
# Choices: scheme dark, seed #a3241f, shape sharp, ornament light, motion heavy, finish brush.
name "dread"
scheme dark
palette {
  --backdrop: #0c0a09
  --well: #080706
  --panel: #211b1a
  --panel-hover: #332d2c
  --panel-raised: #2c2625
  --line: #484241
  --line-strong: #8d8786
  --ink: #f9f2f2
  --ink-muted: #c3bcbc
  --ink-faint: #aaa4a4
  --ink-inverse: #211b1a
  --control: #302a29
  --control-strong: #3f3938
  --primary: #9c231e
  --primary-hover: #90201c
  --primary-active: #831d19
  --on-primary: #fcf8f8
  --primary-soft: #9c231e38
  --highlight: #c9b28a
  --focus: #c9b28a
  --knob: #4c4645
  --hud: #211b1af0
  --scrim: #060505b3
  --shadow: #0000008c
  --sheen: #ffffff38
  --success: #69d390
  --warn: #f0af4c
  --danger: #ea8b86
  --info: #76ace6
  --health: #64d877
  --mana: #71a9f3
  --xp: #c292e3
  --gold: #f0c54c
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #9e9e9e pips 1
  --uncommon: #3fbf4f pips 2
  --rare: #2f7fef pips 3
  --epic: #a335ee pips 4
  --legendary: #ff8000 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #3fbf5f
  --team4: #ffc61a
  --team5: #a347ff
  --team6: #ff8a1f
  --team7: #1fc7c7
  --team8: #ff5cb0
  --physical: #b8b0a0
  --fire: #ff6a2b
  --ice: #62cfff
  --lightning: #ffd83a
  --poison: #7ed957
  --holy: #ffe9a0
  --shadow: #8a5cf6
  --arcane: #ff4fd8
  --series1: #4e79a7
  --series2: #f28e2b
  --series3: #e15759
  --series4: #76b7b2
  --series5: #59a14f
  --series6: #edc948
  --series7: #b07aa1
  --series8: #ff9da7
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 13 18 0.01 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 0
  --radius-sm: 2px
  --radius-md: 2px
  --radius-lg: 3px
  --radius-xl: 4px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.25px
  --stroke-regular: 1.75px
  --stroke-thick: 2.5px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 6 0 "#0000002b"
    shadow 0 1 2 0 "#0000001f"
  }
  floating {
    shadow 0 4 12 0 "#00000031"
    shadow 0 1 2 0 "#0000001f"
  }
  overlay {
    shadow 0 8 24 0 "#00000038"
    shadow 0 1 2 0 "#0000001f"
  }
  top {
    shadow 0 14 36 0 "#0000003e"
    shadow 0 1 2 0 "#0000001f"
  }
}
shape {
  panel round 2
  dialog round 2.4
  card round 1.6
  tooltip square 0
  button round 2
  field round 1.6
  chip round 2
  badge round 2
  tab round 1.6
  slot square 0
  bar square 0
  hud round 2
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/fantasy/Newsreader-Medium.ttf"
  display "@styles/shared/Newsreader-SemiBold.ttf"
  numeric "@styles/shared/PTMono-Regular.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/fantasy/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter slideUp
  toast slideUp
  progress 520
  shake 10
  pop 0.03
  spring ui 240 0
  spring panel 500 0.03
  spring emphasis 640 0.06
  spring playful 700 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 130
  duration fast 220
  duration base 360
  duration slow 520
  duration spring 640
  duration bounce 760
  stagger 70
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.94 1.06 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.94 1.06 haptic tick
  confirm "sfx-confirm.ogt" volume 0.425 0.5 pitch 0.97 1.03 haptic tap
  cancel "sfx-back.ogt" volume 0.4 0.5 pitch 0.94 1.06 haptic tick
  back "sfx-back.ogt" volume 0.4 0.5 pitch 0.94 1.06 haptic tick
  open "sfx-open.ogt" volume 0.3 0.35 pitch 0.99 1.11 haptic none
  close "sfx-open.ogt" volume 0.25 0.3 pitch 0.79 0.91 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.35 0.45 pitch 1.09 1.21 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.3 0.35 pitch 1.14 1.26 haptic tick
  toggleOff "sfx-back.ogt" volume 0.3 0.35 pitch 1.04 1.16 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.25 pitch 1.28 1.52 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.1 0.15 pitch 1.42 1.78 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.225 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.35 0.4 pitch 1.24 1.36 haptic tap
  warning "sfx-error.ogt" volume 0.3 0.35 pitch 1.19 1.31 haptic warning
  error "sfx-error.ogt" volume 0.4 0.5 pitch 0.97 1.03 haptic error
  success "sfx-reward.ogt" volume 0.4 0.5 pitch 1.07 1.13 haptic success
  reward "sfx-reward.ogt" volume 0.45 0.5 pitch 0.97 1.03 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.3 0.35 pitch 0.84 0.96 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.35 0.4 pitch 0.89 1.01 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.4 0.45 pitch 1.09 1.21 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.425 0.5 pitch 0.87 0.93 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.45 0.5 pitch 0.77 0.83 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.5 0.5 pitch 0.67 0.73 haptic thud
}
Button::base {
  -og-press: 1 0.96 2
  -og-hover: 0 1
  -og-stroke: 1.75px #f9f2f2a6 inside dash 28 4 offset 6 round
}
Panel::frame {
  -og-fill: radial var(--panel-raised) var(--panel-raised) var(--panel) var(--well)
  -og-fill: linear 176 #00000000 #0000000d 0.14 #00000000 0.27 #00000009 0.41 #00000000 0.58 #0000000d 0.72 #00000000 0.86 #00000008
  -og-stroke: 2.5px #f9f2f2cc inside dash 46 5 offset 9 round
  -og-stroke: 1px #f9f2f266 outside dash 13 7 offset 3 round
  -og-effect: inner-shadow 0 0 18 0 #f9f2f21a
}
Card::frame {
  -og-fill: radial var(--panel-raised) var(--panel-raised) var(--panel) var(--well)
  -og-fill: linear 176 #00000000 #0000000d 0.14 #00000000 0.27 #00000009 0.41 #00000000 0.58 #0000000d 0.72 #00000000 0.86 #00000008
  -og-stroke: 1.5px #f9f2f2a6 inside dash 30 4 offset 5 round
  -og-effect: inner-shadow 0 0 12 0 #f9f2f214
}
Button::base.primary {
  -og-effect: inner-shadow 0 0 10 0 #0000002e
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Field::frame {
  -og-stroke: 1.5px #f9f2f28c inside dash 22 3 offset 4 round
}
Slot::frame {
  -og-stroke: 1.5px #f9f2f280 inside dash 18 4 offset 2 round
}
Meter::fill {
  -og-effect: inner-shadow 0 0 6 0 #00000033
}
Chip::base:selected {
  -og-stroke: 1px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 1px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Inventory::item {
  -og-stroke: 1.5px #f9f2f280 inside dash 18 4 offset 2 round
}
Inventory::item:selected {
  -og-stroke: 1.5px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
