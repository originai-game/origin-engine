type style
version 2
---
# broadcast: the sports broadcast look, generated by og style new (docs/ui.md §12.5) for "an arcade football game framed like a live TV broadcast".
# Choices: scheme dark, seed #e8322b, shape cut, ornament light, motion snappy, finish gradient.
atlas "atlas.png" 512 282 2 3
name "broadcast"
scheme dark
palette {
  backdrop "#0b1c4f"
  well "#081437"
  panel "#222c5a"
  panelHover "#343d67"
  panelRaised "#2d3762"
  line "#4a5075"
  lineStrong "#9090a6"
  ink "#fef3f2"
  inkMuted "#d7d4db"
  inkFaint "#bbbbc8"
  inkInverse "#222c5a"
  control "#313a65"
  controlStrong "#41486f"
  primary "#f28884"
  primaryHover "#f3928e"
  primaryActive "#f49b98"
  onPrimary "#0a1431"
  primarySoft "#f2888438"
  highlight "#ffe36c"
  focus "#ffd21a"
  knob "#4e5478"
  hud "#222c5af0"
  scrim "#060e28b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#7dd99e"
  warn "#f2ba63"
  danger "#eea4a0"
  info "#68aeff"
  health "#76dc86"
  mana "#94c0f6"
  xp "#d0abe9"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#3181ef" pips 3
  epic "#b257f1" pips 4
  legendary "#ff8000" pips 5
  mythic "#ea455c" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#ab56ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#9267f7"
  arcane "#ff4fd8"
  series1 "#5f86af"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 12 17 0.06 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.25
  regular 1.75
  thick 2.5
  focus 2
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel bevel 10
  dialog bevel 12
  card bevel 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 6
  badge bevel 6
  tab bevel 4.8
  slot bevel 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/Kanit-MediumItalic.ttf"
  display "@styles/shared/Kanit-ExtraBoldItalic.ttf"
  numeric "@styles/shared/Kanit-BoldItalic.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/shared/slant-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0000008c"
motion {
  enter slideUp
  toast slideDown
  progress 340
  shake 6
  pop 0.06
  spring ui 150 0
  spring panel 240 0.04
  spring emphasis 320 0.12
  spring playful 400 0.18
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 340
  duration spring 420
  duration bounce 520
  stagger 30
  staggerCap 300
  overshoot 0.04
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  confirm "sfx-confirm.ogt" volume 0.553 0.65 pitch 0.98 1.02 haptic tap
  cancel "sfx-back.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  back "sfx-back.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  open "sfx-open.ogt" volume 0.39 0.455 pitch 1.01 1.09 haptic none
  close "sfx-open.ogt" volume 0.325 0.39 pitch 0.81 0.89 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.455 0.585 pitch 1.11 1.19 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.39 0.455 pitch 1.16 1.24 haptic tick
  toggleOff "sfx-back.ogt" volume 0.39 0.455 pitch 1.06 1.14 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.227 0.325 pitch 1.32 1.48 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.13 0.195 pitch 1.48 1.72 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.227 0.293 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.455 0.52 pitch 1.26 1.34 haptic tap
  warning "sfx-error.ogt" volume 0.39 0.455 pitch 1.21 1.29 haptic warning
  error "sfx-error.ogt" volume 0.52 0.65 pitch 0.98 1.02 haptic error
  success "sfx-reward.ogt" volume 0.52 0.65 pitch 1.08 1.12 haptic success
  reward "sfx-reward.ogt" volume 0.585 0.65 pitch 0.98 1.02 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.39 0.455 pitch 0.86 0.94 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.455 0.52 pitch 0.91 0.99 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.52 0.585 pitch 1.11 1.19 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.553 0.65 pitch 0.88 0.92 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.585 0.65 pitch 0.78 0.82 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.65 0.65 pitch 0.68 0.72 haptic thud
}
dress "Button.base" {
  press 0.97 0.97 1
  hover -1 1.01
  fill linear 180 controlStrong control
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#0000006c"
  effect innerShadow 0 -3 0 0 "#0000001f"
}
dress "Panel.frame" {
  fill linear 180 panelRaised panel
  stroke 3 lineStrong inside
  effect dropShadow 0 5 0 0 "#0000006c"
}
dress "Card.frame" {
  slice 1 1 108 96 20 20 20 20 authored
  tone 0.003 0.016 0.093 1
  fill linear 180 panelRaised panel
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#0000004d"
}
dress "Button.base[pressed]" {
  effect innerShadow 0 3 0 0 "#0000002e"
}
dress "Field.frame" {
  slice 224 237 149 40 12 12 12 12 authored
  tone 0.003 0.011 0.061 1
  stroke 2 lineStrong inside
}
dress "Slot.frame" {
  slice 111 1 64 64 16 16 16 16 authored
  tone 0.004 0.019 0.103 1
  stroke 2 lineStrong inside
  effect innerShadow 0 3 0 0 "#0000001f"
}
dress "Meter.fill" {
  effect innerShadow 0 -3 0 0 "#0000002e"
  effect innerShadow 0 2 0 0 "#ffffff59"
}
dress "Chip.base" {
  stroke 2 lineStrong inside
}
dress "Button.base[primary]" {
  slice 210 145 221 44 18 14 18 14 authored
  tone 0.98 0.231 0.187 1
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Chip.base[selected]" {
  stroke 2 primary inside
}
dress "Tabs.tab[selected]" {
  fill primary
  stroke none
}
dress "Slot.frame[selected]" {
  stroke 2 primary inside
}
dress "Tabs.tab[selected][underline]" {
  fill none
  stroke none
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Slider.track" {
  segments 10 3
}
dress "Tabs.tab[selected][pill]" {
  fill none
  stroke none
}
dress "Inventory.item" {
  stroke 2 lineStrong inside
  effect innerShadow 0 3 0 0 "#0000001f"
}
dress "Inventory.item[selected]" {
  stroke 2 primary inside
}
dress "Inventory.item[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Inventory.item[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Inventory.item[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Inventory.item[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Button.base[secondary]" {
  slice 177 1 207 44 18 14 18 14 authored
  tone 0.011 0.027 0.121 0.99
}
dress "Button.base[secondary][hover]" {
  slice 1 99 207 44 18 14 18 14 authored
  tone 0.044 0.069 0.186 0.99
}
dress "Button.base[secondary][pressed]" {
  slice 210 99 207 44 18 14 18 14 authored
  tone 0.008 0.018 0.076 0.99
}
dress "Button.base[secondary][disabled]" {
  slice 1 145 207 44 18 14 18 14 authored
  tone 0.017 0.02 0.032 0.99
}
dress "Button.base[primary][hover]" {
  slice 1 191 221 44 18 14 18 14 authored
  tone 0.98 0.302 0.257 1
}
dress "Button.base[primary][pressed]" {
  slice 224 191 221 44 18 14 18 14 authored
  tone 0.591 0.143 0.116 1
}
dress "Button.base[primary][disabled]" {
  slice 1 237 221 44 18 14 18 14 authored
  tone 0.352 0.24 0.23 1
}
