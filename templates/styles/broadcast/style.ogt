type style
version 3
---
# broadcast: the sports broadcast look, generated by og style new (docs/ui.md §12.5) for "an arcade football game framed like a live TV broadcast".
# Choices: scheme dark, seed #e8322b, shape sharp, ornament none, motion snappy, finish gradient.
name "broadcast"
scheme dark
palette {
  --backdrop: #0a1431
  --well: #070e22
  --panel: #21243e
  --panel-hover: #33364d
  --panel-raised: #2c2f48
  --line: #49495e
  --line-strong: #908c98
  --ink: #fef3f2
  --ink-muted: #cec7cd
  --ink-faint: #b3afb7
  --ink-inverse: #21243e
  --control: #30324b
  --control-strong: #404157
  --primary: #f28c88
  --primary-hover: #f39592
  --primary-active: #f49e9b
  --on-primary: #330b09
  --primary-soft: #f28c8838
  --highlight: #ffde52
  --focus: #ffd21a
  --knob: #4d4d62
  --hud: #21243ef0
  --scrim: #050a19b3
  --shadow: #0000008c
  --sheen: #ffffff38
  --success: #69d390
  --warn: #f0af4c
  --danger: #ec9792
  --info: #88b7ea
  --health: #64d877
  --mana: #83b5f5
  --xp: #c99ee6
  --gold: #f0c54c
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #9e9e9e pips 1
  --uncommon: #3fbf4f pips 2
  --rare: #2f7fef pips 3
  --epic: #ab45ef pips 4
  --legendary: #ff8000 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #3fbf5f
  --team4: #ffc61a
  --team5: #a347ff
  --team6: #ff8a1f
  --team7: #1fc7c7
  --team8: #ff5cb0
  --physical: #b8b0a0
  --fire: #ff6a2b
  --ice: #62cfff
  --lightning: #ffd83a
  --poison: #7ed957
  --holy: #ffe9a0
  --shadow: #8a5cf6
  --arcane: #ff4fd8
  --series1: #537ca9
  --series2: #f28e2b
  --series3: #e15759
  --series4: #76b7b2
  --series5: #59a14f
  --series6: #edc948
  --series7: #b07aa1
  --series8: #ff9da7
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 12 17 0.08 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 0
  --radius-sm: 2px
  --radius-md: 2px
  --radius-lg: 3px
  --radius-xl: 4px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.25px
  --stroke-regular: 1.75px
  --stroke-thick: 2.5px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel round 2
  dialog round 2.4
  card round 1.6
  tooltip square 0
  button round 2
  field round 1.6
  chip round 2
  badge round 2
  tab round 1.6
  slot square 0
  bar square 0
  hud round 2
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/Rajdhani-Bold.ttf"
  display "@styles/shared/ChakraPetch-BoldItalic.ttf"
  numeric "@styles/shared/ChakraPetch-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/scifi/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#0000008c"
motion {
  enter slideUp
  toast slideDown
  progress 340
  shake 6
  pop 0.06
  spring ui 150 0
  spring panel 240 0.04
  spring emphasis 320 0.12
  spring playful 400 0.18
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 340
  duration spring 420
  duration bounce 520
  stagger 30
  staggerCap 300
  overshoot 0.04
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  confirm "sfx-confirm.ogt" volume 0.553 0.65 pitch 0.98 1.02 haptic tap
  cancel "sfx-back.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  back "sfx-back.ogt" volume 0.52 0.65 pitch 0.96 1.04 haptic tick
  open "sfx-open.ogt" volume 0.39 0.455 pitch 1.01 1.09 haptic none
  close "sfx-open.ogt" volume 0.325 0.39 pitch 0.81 0.89 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.455 0.585 pitch 1.11 1.19 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.39 0.455 pitch 1.16 1.24 haptic tick
  toggleOff "sfx-back.ogt" volume 0.39 0.455 pitch 1.06 1.14 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.227 0.325 pitch 1.32 1.48 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.13 0.195 pitch 1.48 1.72 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.227 0.293 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.455 0.52 pitch 1.26 1.34 haptic tap
  warning "sfx-error.ogt" volume 0.39 0.455 pitch 1.21 1.29 haptic warning
  error "sfx-error.ogt" volume 0.52 0.65 pitch 0.98 1.02 haptic error
  success "sfx-reward.ogt" volume 0.52 0.65 pitch 1.08 1.12 haptic success
  reward "sfx-reward.ogt" volume 0.585 0.65 pitch 0.98 1.02 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.39 0.455 pitch 0.86 0.94 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.455 0.52 pitch 0.91 0.99 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.52 0.585 pitch 1.11 1.19 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.553 0.65 pitch 0.88 0.92 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.585 0.65 pitch 0.78 0.82 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.65 0.65 pitch 0.68 0.72 haptic thud
}
Button::base {
  -og-press: 0.97 0.97 1
  -og-hover: -1 1.01
  -og-fill: linear 180 var(--control-strong) var(--control)
  -og-stroke: 2.5px var(--line-strong) inside
  -og-effect: drop-shadow 0 4 0 0 #0000006c
  -og-effect: inner-shadow 0 -3 0 0 #0000001f
}
Panel::frame {
  -og-fill: linear 180 var(--panel-raised) var(--panel)
  -og-stroke: 3px var(--line-strong) inside
  -og-effect: drop-shadow 0 5 0 0 #0000006c
}
Card::frame {
  -og-fill: linear 180 var(--panel-raised) var(--panel)
  -og-stroke: 2.5px var(--line-strong) inside
  -og-effect: drop-shadow 0 4 0 0 #0000004d
}
Button::base:active {
  -og-effect: inner-shadow 0 3 0 0 #0000002e
}
Field::frame {
  -og-stroke: 2px var(--line-strong) inside
}
Slot::frame {
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 0 3 0 0 #0000001f
}
Meter::fill {
  -og-effect: inner-shadow 0 -3 0 0 #0000002e
  -og-effect: inner-shadow 0 2 0 0 #ffffff59
}
Chip::base {
  -og-stroke: 2px var(--line-strong) inside
}
Button::base.primary {
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 2px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Inventory::item {
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 0 3 0 0 #0000001f
}
Inventory::item:selected {
  -og-stroke: 2px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
