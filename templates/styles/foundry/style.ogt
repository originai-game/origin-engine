type style
version 3
---
# foundry: the industrial iron and brass look, generated by og style new (docs/ui.md §12.5) for "a city builder of furnaces, steam engines and a research tree, in a frozen industrial age".
# Choices: scheme dark, seed #f0843a, shape cut, ornament light, motion mechanical, finish gradient.
atlas "atlas.png" 512 283 2 3
# The painted art follows the palette: a copy with another primary recolours it at cook (docs/art.md §2.7).
recolour "#f0843a" primary
name "foundry"
scheme dark
palette {
  --backdrop: #111214
  --well: #0c0d0e
  --panel: #282625
  --panel-hover: #393736
  --panel-raised: #333130
  --line: #4c4842
  --line-strong: #8d8576
  --ink: #f1e4c6
  --ink-muted: #cec7b5
  --ink-faint: #b4aea1
  --ink-inverse: #282625
  --control: #363330
  --control-strong: #44413c
  --primary: #f0843a
  --primary-hover: #f18e4a
  --primary-active: #f2985a
  --on-primary: #140b05
  --primary-soft: #f0843a38
  --highlight: #edd6b1
  --focus: #d8a85a
  --knob: #504c45
  --hud: #282625f0
  --scrim: #09090ab3
  --shadow: #000000bf
  --sheen: #ffffff38
  --success: #69d390
  --warn: #f0b04d
  --danger: #ec9995
  --info: #89b8ea
  --health: #64d877
  --mana: #82b4f5
  --xp: #c99fe6
  --gold: #f0c54c
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #9e9e9e pips 1
  --uncommon: #3fbf4f pips 2
  --rare: #2f7fef pips 3
  --epic: #ab47ef pips 4
  --legendary: #ff8000 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #3fbf5f
  --team4: #ffc61a
  --team5: #a347ff
  --team6: #ff8a1f
  --team7: #1fc7c7
  --team8: #ff5cb0
  --physical: #b8b0a0
  --fire: #ff6a2b
  --ice: #62cfff
  --lightning: #ffd83a
  --poison: #7ed957
  --holy: #ffe9a0
  --shadow: #8a5cf6
  --arcane: #ff4fd8
  --series1: #537da9
  --series2: #f28e2b
  --series3: #e15759
  --series4: #76b7b2
  --series5: #59a14f
  --series6: #edc948
  --series7: #b07aa1
  --series8: #ff9da7
}
typography {
  display 51 57 0.12 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 0.12 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 13 18 0.07 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 4px
  --radius-sm: 6px
  --radius-md: 10px
  --radius-lg: 15px
  --radius-xl: 20px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.25px
  --stroke-regular: 1.75px
  --stroke-thick: 2.5px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000064"
  }
  floating {
    shadow 0 4 0 0 "#00000073"
  }
  overlay {
    shadow 0 6 0 0 "#00000081"
  }
  top {
    shadow 0 6 0 0 "#0000008f"
  }
}
shape {
  panel bevel 10
  dialog bevel 12
  card bevel 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 6
  badge bevel 6
  tab bevel 4.8
  slot bevel 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/Spectral-SemiBold.ttf"
  display "@styles/shared/SpectralSC-SemiBold.ttf"
  numeric "@styles/shared/Spectral-SemiBold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/shared/plate-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#000000bf"
motion {
  enter slideLeft
  toast slideLeft
  progress 240
  shake 6
  pop 0
  spring ui 100 0
  spring panel 180 0
  spring emphasis 240 0
  spring playful 300 0.04
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 60
  duration fast 100
  duration base 160
  duration slow 240
  duration spring 320
  duration bounce 400
  stagger 25
  staggerCap 300
  overshoot 0
}
sounds {
  hover "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.15 0.21 pitch 1.22 1.28 haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 0.985 1.015 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 1.02 1.08 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.82 0.88 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.12 1.18 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.17 1.23 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 1.07 1.13 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.34 1.46 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.51 1.69 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.27 1.33 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.22 1.28 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 0.985 1.015 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.085 1.115 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 0.985 1.015 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.87 0.93 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.92 0.98 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.12 1.18 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.885 0.915 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.785 0.815 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.685 0.715 haptic thud
}
Button::base {
  -og-press: 1 1 1
  -og-hover: 0 1
  -og-fill: linear 180 var(--control-strong) var(--control)
  -og-stroke: 2.5px var(--line-strong) inside
  -og-effect: drop-shadow 0 4 0 0 #000000bf
  -og-effect: inner-shadow 0 -3 0 0 #0000001f
}
Panel::frame {
  -og-slice: 1 1 96 96 24 24 24 24 authored
  -og-tone: 0.016 0.013 0.01 1
  -og-fill: linear 180 var(--panel-raised) var(--panel)
  -og-stroke: 3px var(--line-strong) inside
  -og-effect: drop-shadow 0 5 0 0 #000000bf
}
Card::frame {
  -og-slice: 99 1 96 96 20 20 20 20 authored
  -og-tone: 0.021 0.017 0.013 1
  -og-fill: linear 180 var(--panel-raised) var(--panel)
  -og-stroke: 2.5px var(--line-strong) inside
  -og-effect: drop-shadow 0 4 0 0 #0000008f
}
Button::base:active {
  -og-effect: inner-shadow 0 3 0 0 #0000002e
}
Field::frame {
  -og-slice: 1 237 215 40 20 12 20 12 authored
  -og-tone: 0.01 0.008 0.006 1
  -og-stroke: 2px var(--line-strong) inside
}
Slot::frame {
  -og-slice: 197 1 64 64 16 16 16 16 authored
  -og-tone: 0.019 0.016 0.013 1
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 0 3 0 0 #0000001f
}
Meter::fill {
  -og-effect: inner-shadow 0 -3 0 0 #0000002e
  -og-effect: inner-shadow 0 2 0 0 #ffffff59
}
Chip::base {
  -og-stroke: 2px var(--line-strong) inside
}
Button::base.primary {
  -og-slice: 141 145 164 44 22 14 22 14 authored
  -og-tone: 0.99 0.357 0.05 0.99
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 2px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
AbilitySlot::frame {
  -og-fill: linear 180 var(--panel-raised) var(--well)
  -og-stroke: 1.5px #a9844a outside
}
AbilitySlot::frame.active {
  -og-stroke: 2px var(--primary) outside
  -og-effect: drop-shadow 0 3 10 0 #0000008c
  -og-effect: outer-glow 12 #f0843aa6
}
AbilitySlot::edge.active {
  -og-stroke: 2px var(--primary) inside
}
AbilitySlot::icon {
  -og-fill: linear 180 var(--panel-raised) var(--well)
}
StatusGrid::tile.buff {
  -og-stroke: 1px #a9844a inside
}
StatusGrid::tile.debuff {
  -og-stroke: 2px var(--primary) inside
}
StatusGrid::icon.buff {
  -og-fill: linear 180 var(--panel-raised) var(--well)
}
StatusGrid::icon.debuff {
  -og-fill: linear 180 #7a3a14 #2c160b
}
ObjectiveTracker::frame {
  -og-fill: var(--hud)
  -og-stroke: 1px var(--line) inside
}
Compass::strip {
  -og-fill: var(--hud)
  -og-stroke: 1px var(--line) inside
}
Inventory::item {
  -og-stroke: 2px var(--line-strong) inside
  -og-effect: inner-shadow 0 3 0 0 #0000001f
}
Inventory::item:selected {
  -og-stroke: 2px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Tooltip::frame {
  -og-slice: 263 1 139 48 12 12 12 12 authored
  -og-tone: 0.01 0.009 0.007 1
}
Hud::frame {
  -og-slice: 218 237 92 40 14 12 14 12 authored
  -og-tone: 0.018 0.015 0.012 1
}
Button::base.secondary {
  -og-slice: 1 99 138 44 22 14 22 14 authored
  -og-tone: 0.017 0.013 0.01 0.99
}
Button::base.secondary:hover {
  -og-slice: 141 99 138 44 22 14 22 14 authored
  -og-tone: 0.054 0.048 0.042 0.99
}
Button::base.secondary:active {
  -og-slice: 281 99 138 44 22 14 22 14 authored
  -og-tone: 0.012 0.009 0.007 0.99
}
Button::base.secondary:disabled {
  -og-slice: 1 145 138 44 22 14 22 14 authored
  -og-tone: 0.011 0.011 0.01 0.99
}
Button::base.primary:hover {
  -og-slice: 307 145 164 44 22 14 22 14 authored
  -og-tone: 0.99 0.424 0.102 0.99
}
Button::base.primary:active {
  -og-slice: 1 191 164 44 22 14 22 14 authored
  -og-tone: 0.596 0.219 0.033 0.99
}
Button::base.primary:disabled {
  -og-slice: 167 191 164 44 22 14 22 14 authored
  -og-tone: 0.387 0.294 0.211 0.99
}
corner 312 237 32 32 32 32 authored
divider 1 279 192 3 192 3 authored
flourish 346 237 23 24 23 24 authored
Slider::knob {
  -og-slice: 371 237 8 24 1 1 1 1 authored
  -og-tone: 0.274 0.146 0.04 0.99
}
Toggle::knob:checked {
  -og-slice: 381 237 24 24 1 1 1 1 authored
  -og-tone: 0.305 0.17 0.057 0.99
}
Toggle::knob.off {
  -og-slice: 407 237 24 24 1 1 1 1 authored
  -og-tone: 0.137 0.079 0.038 0.99
}
