type style
version 2
---
# foundry: the industrial iron and brass look, generated by og style new (docs/ui.md §12.5) for "a city builder of furnaces, steam engines and a research tree, in a frozen industrial age".
# Choices: scheme dark, seed #f0843a, shape cut, ornament light, motion mechanical, finish gradient.
atlas "atlas.png" 512 283 2 3
name "foundry"
scheme dark
palette {
  backdrop "#111214"
  well "#0c0d0e"
  panel "#282625"
  panelHover "#393736"
  panelRaised "#333130"
  line "#4c4842"
  lineStrong "#8d8576"
  ink "#f1e4c6"
  inkMuted "#cec7b5"
  inkFaint "#b4aea1"
  inkInverse "#282625"
  control "#363330"
  controlStrong "#44413c"
  primary "#f0843a"
  primaryHover "#f18e4a"
  primaryActive "#f2985a"
  onPrimary "#140b05"
  primarySoft "#f0843a38"
  highlight "#edd6b1"
  focus "#d8a85a"
  knob "#504c45"
  hud "#282625f0"
  scrim "#09090ab3"
  shadow "#000000bf"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f0b04d"
  danger "#ec9995"
  info "#89b8ea"
  health "#64d877"
  mana "#82b4f5"
  xp "#c99fe6"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#ab47ef" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#537da9"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 51 57 0.12 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 0.12 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 13 18 0.07 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.25
  regular 1.75
  thick 2.5
  focus 2
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000064"
  }
  floating {
    shadow 0 4 0 0 "#00000073"
  }
  overlay {
    shadow 0 6 0 0 "#00000081"
  }
  top {
    shadow 0 6 0 0 "#0000008f"
  }
}
shape {
  panel bevel 10
  dialog bevel 12
  card bevel 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 6
  badge bevel 6
  tab bevel 4.8
  slot bevel 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/Spectral-SemiBold.ttf"
  display "@styles/shared/SpectralSC-SemiBold.ttf"
  numeric "@styles/shared/Spectral-SemiBold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/shared/plate-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
textShadow display 0 3 0 "#000000bf"
motion {
  enter slideLeft
  toast slideLeft
  progress 240
  shake 6
  pop 0
  spring ui 100 0
  spring panel 180 0
  spring emphasis 240 0
  spring playful 300 0.04
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 60
  duration fast 100
  duration base 160
  duration slow 240
  duration spring 320
  duration bounce 400
  stagger 25
  staggerCap 300
  overshoot 0
}
sounds {
  hover "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.15 0.21 pitch 1.22 1.28 haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 0.985 1.015 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 0.97 1.03 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 1.02 1.08 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.82 0.88 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.12 1.18 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.17 1.23 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 1.07 1.13 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.34 1.46 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.51 1.69 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.27 1.33 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.22 1.28 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 0.985 1.015 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.085 1.115 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 0.985 1.015 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.87 0.93 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.92 0.98 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.12 1.18 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.885 0.915 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.785 0.815 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.685 0.715 haptic thud
}
dress "Button.base" {
  press 1 1 1
  hover 0 1
  fill linear 180 controlStrong control
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#000000bf"
  effect innerShadow 0 -3 0 0 "#0000001f"
}
dress "Panel.frame" {
  slice 1 1 96 96 24 24 24 24 authored
  tone 0.016 0.013 0.01 1
  fill linear 180 panelRaised panel
  stroke 3 lineStrong inside
  effect dropShadow 0 5 0 0 "#000000bf"
}
dress "Card.frame" {
  slice 99 1 96 96 20 20 20 20 authored
  tone 0.021 0.017 0.013 1
  fill linear 180 panelRaised panel
  stroke 2.5 lineStrong inside
  effect dropShadow 0 4 0 0 "#0000008f"
}
dress "Button.base[pressed]" {
  effect innerShadow 0 3 0 0 "#0000002e"
}
dress "Field.frame" {
  slice 1 237 215 40 20 12 20 12 authored
  tone 0.01 0.008 0.006 1
  stroke 2 lineStrong inside
}
dress "Slot.frame" {
  slice 197 1 64 64 16 16 16 16 authored
  tone 0.019 0.016 0.013 1
  stroke 2 lineStrong inside
  effect innerShadow 0 3 0 0 "#0000001f"
}
dress "Meter.fill" {
  effect innerShadow 0 -3 0 0 "#0000002e"
  effect innerShadow 0 2 0 0 "#ffffff59"
}
dress "Chip.base" {
  stroke 2 lineStrong inside
}
dress "Button.base[primary]" {
  slice 141 145 164 44 22 14 22 14 authored
  tone 0.99 0.357 0.05 0.99
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Chip.base[selected]" {
  stroke 2 primary inside
}
dress "Tabs.tab[selected]" {
  stroke 2 primary inside
}
dress "Slot.frame[selected]" {
  stroke 2 primary inside
}
dress "Tabs.tab[selected][underline]" {
  fill none
  stroke none
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "AbilitySlot.frame" {
  fill linear 180 panelRaised well
  stroke 1.5 "#a9844a" outside
}
dress "AbilitySlot.frame[active]" {
  stroke 2 primary outside
  effect dropShadow 0 3 10 0 "#0000008c"
  effect outerGlow 12 "#f0843aa6"
}
dress "AbilitySlot.edge[active]" {
  stroke 2 primary inside
}
dress "AbilitySlot.icon" {
  fill linear 180 panelRaised well
}
dress "StatusGrid.tile[buff]" {
  stroke 1 "#a9844a" inside
}
dress "StatusGrid.tile[debuff]" {
  stroke 2 primary inside
}
dress "StatusGrid.icon[buff]" {
  fill linear 180 panelRaised well
}
dress "StatusGrid.icon[debuff]" {
  fill linear 180 "#7a3a14" "#2c160b"
}
dress "ObjectiveTracker.frame" {
  fill hud
  stroke 1 line inside
}
dress "Compass.strip" {
  fill hud
  stroke 1 line inside
}
dress "Inventory.item" {
  stroke 2 lineStrong inside
  effect innerShadow 0 3 0 0 "#0000001f"
}
dress "Inventory.item[selected]" {
  stroke 2 primary inside
}
dress "Inventory.item[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Inventory.item[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Inventory.item[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Inventory.item[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Tooltip.frame" {
  slice 263 1 139 48 12 12 12 12 authored
  tone 0.01 0.009 0.007 1
}
dress "Hud.frame" {
  slice 218 237 92 40 14 12 14 12 authored
  tone 0.018 0.015 0.012 1
}
dress "Button.base[secondary]" {
  slice 1 99 138 44 22 14 22 14 authored
  tone 0.017 0.013 0.01 0.99
}
dress "Button.base[secondary][hover]" {
  slice 141 99 138 44 22 14 22 14 authored
  tone 0.054 0.048 0.042 0.99
}
dress "Button.base[secondary][pressed]" {
  slice 281 99 138 44 22 14 22 14 authored
  tone 0.012 0.009 0.007 0.99
}
dress "Button.base[secondary][disabled]" {
  slice 1 145 138 44 22 14 22 14 authored
  tone 0.011 0.011 0.01 0.99
}
dress "Button.base[primary][hover]" {
  slice 307 145 164 44 22 14 22 14 authored
  tone 0.99 0.424 0.102 0.99
}
dress "Button.base[primary][pressed]" {
  slice 1 191 164 44 22 14 22 14 authored
  tone 0.596 0.219 0.033 0.99
}
dress "Button.base[primary][disabled]" {
  slice 167 191 164 44 22 14 22 14 authored
  tone 0.387 0.294 0.211 0.99
}
corner 312 237 32 32 32 32 authored
divider 1 279 192 3 192 3 authored
flourish 346 237 23 24 23 24 authored
dress "Slider.knob" {
  slice 371 237 8 24 1 1 1 1 authored
  tone 0.274 0.146 0.04 0.99
}
dress "Toggle.knob[on]" {
  slice 381 237 24 24 1 1 1 1 authored
  tone 0.305 0.17 0.057 0.99
}
dress "Toggle.knob[off]" {
  slice 407 237 24 24 1 1 1 1 authored
  tone 0.137 0.079 0.038 0.99
}
