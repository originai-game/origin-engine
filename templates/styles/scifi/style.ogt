type style
version 3
---
# The scifi style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "scifi"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  --backdrop: #05080c
  --well: #080b0f
  --panel: #0d1217
  --panel-hover: #161d25
  --panel-raised: #121820
  --line: #ffffff1f
  --line-strong: #46525f
  --ink: #eef2f6
  --ink-muted: #a8b2bd
  --ink-faint: #808b97
  --ink-inverse: #0a0e13
  --control: #1a222b
  --control-strong: #2a3440
  --primary: #9ccdf5
  --primary-hover: #b5dbf9
  --primary-active: #86bdea
  --on-primary: #0b1520
  --primary-soft: #9ccdf526
  --highlight: #9ccdf5
  --focus: #d2e8fb
  --knob: #9ccdf5
  --hud: #0d1217e6
  --scrim: #000000b3
  --shadow: #000000aa
  --sheen: #ffffff1f
  --success: #5fd38a
  --warn: #e8b84a
  --danger: #ea6b5f
  --info: #9ccdf5
  --health: #5fd38a
  --mana: #6aa8ff
  --xp: #b49cf0
  --gold: #e8c46a
}
colors {
  --success: icon "check"
  --warn: pattern stripes
  --danger: pattern chevrons
  --info: pattern grid
  --common: #8a96a3 pips 1
  --uncommon: #5fd38a pips 2
  --rare: #4f8fef pips 3
  --epic: #b49cf0 pips 4
  --legendary: #e8c46a pips 5
  --mythic: #d0584c pips 6
  --team1: #9ccdf5
  --team2: #d0584c
  --team3: #5fd38a
  --team4: #e8c46a
  --team5: #b49cf0
  --team6: #e89a5a
  --team7: #6ad6c8
  --team8: #e88ab8
  --physical: #a8b2bd pattern hatch
  --fire: #e8845a icon "fire"
  --ice: #9ccdf5 icon "drop"
  --lightning: #e8d06a icon "bolt"
  --poison: #9fd36a pattern dots
  --holy: #f4ecc8 icon "star"
  --shadow: #a896f0 pattern grid
  --arcane: #e88ab8 pattern diamonds
  --series1: #9ccdf5
  --series2: #e8c46a
  --series3: #d0584c
  --series4: #5fd38a
  --series5: #b49cf0
  --series6: #e89a5a
  --series7: #6ad6c8
  --series8: #a8b2bd
}
typography {
  display 42 48 0.0 300 display {
    phonePortrait 34 38
    phoneLandscape 38 43
  }
  title 28 34 0.0 300 display {
    phonePortrait 24 30
    phoneLandscape 26 32
  }
  heading 19 26 0.01 400 display
  body 14 20 0 400 body
  label 14 20 0.08 500 body
  caption 12 16 0.08 500 body
  numeric 17 24 0 400 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 1px
  --radius-sm: 2px
  --radius-md: 3px
  --radius-lg: 4px
  --radius-xl: 6px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1px
  --stroke-regular: 1.5px
  --stroke-thick: 2px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 4 12 0 "#00000066"
  }
  floating {
    shadow 0 8 24 0 "#00000080"
  }
  overlay {
    shadow 0 12 32 0 "#00000099"
  }
  top {
    shadow 0 16 40 0 "#000000aa"
  }
}
shape {
  panel round 4
  dialog round 6
  card round 4
  tooltip round 3
  button round 3
  field round 3
  chip round 3
  badge round 2
  tab round 3
  slot round 2
  bar round 2
  hud round 3
  avatar round pill
}
ramp {
  body 14 20
  meta 12 16
  caption 12 16
  lg 17 24
  xl 19 26
  xl2 22 28
  xl3 26 30
  displaySm 28 34
  displayMd 34 40
  displayLg 42 48
}
fonts {
  body "IBMPlexSans-Regular.ttf"
  display "IBMPlexSans-Light.ttf"
  numeric "IBMPlexMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Regular.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 128 24 line
motion {
  enter fade
  toast slideLeft
  progress 300
  shake 4
  pop 0.06
  spring ui 160 0
  spring panel 260 0
  spring emphasis 320 0.05
  spring playful 360 0.08
  ease standard 0.4 0 0.2 1
  ease enter 0 0 0.2 1
  ease exit 0.4 0 1 1
  ease emphasis 0.2 0 0 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 360
  duration spring 520
  duration bounce 640
  stagger 30
  staggerCap 240
  overshoot 0.0
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none volume 0.5 0.6 haptic tick
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic tick
  typewriter none volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  counterTick none pitch 1 1.4 haptic tick
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
Panel::frame {
  -og-slice: 4 4 96 96 8 tint
  -og-tone: 0.171 0.171 0.171 1.00
  box-shadow: 0 12px 32px 0 #00000080
  -og-glass: 20 0.9 0.1
}
Card::frame {
  -og-slice: 104 4 64 64 8 tint
  -og-tone: 0.133 0.133 0.133 1.00
}
Button::base {
  -og-slice: 172 4 48 48 8 tint
  -og-tone: 0.791 0.791 0.791 1.00
  -og-press: 0.98 0.98 0
  -og-hover: 0 1.0
}
Button::base:hover {
  -og-slice: 224 4 48 48 8 tint
}
Button::base:active {
  -og-slice: 276 4 48 48 8 tint
  -og-tone: 0.571 0.571 0.571 1.00
}
Button::base:disabled {
  -og-slice: 328 4 48 48 8 tint
  -og-tone: 0.319 0.319 0.319 1.00
}
Field::frame {
  -og-slice: 4 104 48 48 6 tint
  -og-tone: 0.133 0.133 0.133 1.00
}
Slot::frame {
  -og-slice: 56 104 48 48 6 tint
  -og-tone: 0.133 0.133 0.133 1.00
}
Tooltip::frame {
  -og-slice: 108 104 32 32 6 tint
  -og-tone: 0.319 0.319 0.319 1.00
}
Hud::frame {
  -og-slice: 144 104 32 32 6 tint
  -og-tone: 0.262 0.262 0.262 1.00
}
Meter::track {
  -og-slice: 180 104 32 16 4 tint
}
Meter::fill {
  -og-slice: 216 104 32 16 4 tint
}
Button::base.secondary {
  -og-slice: 4 204 40 40 8 tint
  -og-tone: 0.072 0.072 0.072 1.00
}
Button::base.secondary:hover {
  -og-slice: 48 204 40 40 8 tint
  -og-tone: 0.171 0.171 0.171 1.00
}
Button::base.secondary:active {
  -og-slice: 92 204 40 40 8 tint
  -og-tone: 0.047 0.047 0.047 1.00
}
Button::base.secondary:disabled {
  -og-slice: 136 204 40 40 8 tint
  -og-tone: 0.047 0.047 0.047 1.00
}
Toggle::knob:checked {
  -og-fill: #f4f7fa
}
Toggle::knob.off {
  -og-fill: #8e98a3
}
Slider::knob {
  -og-fill: #f4f7fa
}
Tabs::track {
  -og-fill: none
  -og-stroke: none
  -og-effect: none
}
Tabs::tab:selected {
  -og-fill: none
  -og-stroke: none
  -og-effect: none
}
Tabs::indicator {
  -og-fill: #9ccdf5
}
Chip::base:selected {
  -og-stroke: 1px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 2px var(--focus) inside
}
Button::base.danger {
  -og-slice: none
  -og-fill: #9a1f17
  -og-stroke: none
}
Inventory::item:selected {
  -og-stroke: 2px var(--focus) inside
}
