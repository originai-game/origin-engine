type style
version 2
---
# The scifi style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "scifi"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#05080c"
  well "#0a0e13"
  panel "#252d36"
  panelHover "#2c3540"
  panelRaised "#29323c"
  line "#2a323c"
  lineStrong "#46525f"
  ink "#eef2f6"
  inkMuted "#a8b2bd"
  inkFaint "#808b97"
  inkInverse "#0a0e13"
  control "#2f3842"
  controlStrong "#3c4652"
  primary "#9ccdf5"
  primaryHover "#b5dbf9"
  primaryActive "#86bdea"
  onPrimary "#0b1520"
  primarySoft "#9ccdf526"
  highlight "#9ccdf5"
  focus "#d2e8fb"
  knob "#9ccdf5"
  hud "#0f1318e6"
  scrim "#000000b3"
  shadow "#000000aa"
  sheen "#ffffff1f"
  success "#5fd38a"
  warn "#e8b84a"
  danger "#ea6b5f"
  info "#9ccdf5"
  health "#5fd38a"
  mana "#6aa8ff"
  xp "#b49cf0"
  gold "#e8c46a"
}
colors {
  success icon "check"
  warn pattern stripes
  danger pattern chevrons
  info pattern grid
  common "#8a96a3" pips 1
  uncommon "#5fd38a" pips 2
  rare "#9ccdf5" pips 3
  epic "#b49cf0" pips 4
  legendary "#e8c46a" pips 5
  mythic "#d0584c" pips 6
  team1 "#9ccdf5"
  team2 "#d0584c"
  team3 "#5fd38a"
  team4 "#e8c46a"
  team5 "#b49cf0"
  team6 "#e89a5a"
  team7 "#6ad6c8"
  team8 "#e88ab8"
  physical "#a8b2bd" pattern hatch
  fire "#e8845a" icon "fire"
  ice "#9ccdf5" icon "drop"
  lightning "#e8d06a" icon "bolt"
  poison "#9fd36a" pattern dots
  holy "#f4ecc8" icon "star"
  shadow "#a896f0" pattern grid
  arcane "#e88ab8" pattern diamonds
  series1 "#9ccdf5"
  series2 "#e8c46a"
  series3 "#d0584c"
  series4 "#5fd38a"
  series5 "#b49cf0"
  series6 "#e89a5a"
  series7 "#6ad6c8"
  series8 "#a8b2bd"
}
typography {
  display 42 48 0.0 300 display {
    phonePortrait 34 38
    phoneLandscape 38 43
  }
  title 28 34 0.0 300 display {
    phonePortrait 24 30
    phoneLandscape 26 32
  }
  heading 19 26 0.01 400 display
  body 14 20 0 400 body
  label 14 20 0.08 400 body
  caption 12 16 0.04 400 body
  numeric 17 24 0 400 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 1
  sm 2
  md 3
  lg 4
  xl 6
  pill 9999
}
stroke {
  hairline 1
  thin 1
  regular 1.5
  thick 2
  focus 2
}
elevation {
  raised {
    shadow 0 4 12 0 "#00000066"
  }
  floating {
    shadow 0 8 24 0 "#00000080"
  }
  overlay {
    shadow 0 12 32 0 "#00000099"
  }
  top {
    shadow 0 16 40 0 "#000000aa"
  }
}
shape {
  panel round 4
  dialog round 6
  card round 4
  tooltip round 3
  button round 3
  field round 3
  chip round 3
  badge round 2
  tab round 3
  slot round 2
  bar round 2
  hud round 3
  avatar round pill
}
ramp {
  body 14 20
  meta 12 16
  caption 12 16
  lg 17 24
  xl 19 26
  xl2 22 28
  xl3 26 30
  displaySm 28 34
  displayMd 34 40
  displayLg 42 48
}
fonts {
  body "IBMPlexSans-Regular.ttf"
  display "IBMPlexSans-Light.ttf"
  numeric "IBMPlexMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Regular.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
divider 4 172 128 24 128 24 line
motion {
  enter fade
  toast slideLeft
  progress 300
  shake 4
  pop 0.06
  spring ui 160 0
  spring panel 260 0
  spring emphasis 320 0.05
  spring playful 360 0.08
  ease standard 0.4 0 0.2 1
  ease enter 0 0 0.2 1
  ease exit 0.4 0 1 1
  ease emphasis 0.2 0 0 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 360
  duration spring 520
  duration bounce 640
  stagger 30
  staggerCap 240
  overshoot 0.0
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none volume 0.5 0.6 haptic tick
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic tick
  typewriter none volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  counterTick none pitch 1 1.4 haptic tick
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 8 tint
  tone 0.171 0.171 0.171 1.00
  shadow 0 12 32 0 "#00000080"
  glass 20 0.92 0.1
}
dress "Card.frame" {
  slice 104 4 64 64 8 tint
  tone 0.262 0.262 0.262 1.00
}
dress "Button.base" {
  slice 172 4 48 48 8 tint
  tone 0.791 0.791 0.791 1.00
  press 0.98 0.98 0
  hover 0 1.0
}
dress "Button.base[hover]" {
  slice 224 4 48 48 8 tint
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 8 tint
  tone 0.571 0.571 0.571 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 8 tint
  tone 0.319 0.319 0.319 1.00
}
dress "Field.frame" {
  slice 4 104 48 48 6 tint
  tone 0.216 0.216 0.216 1.00
}
dress "Slot.frame" {
  slice 56 104 48 48 6 tint
  tone 0.216 0.216 0.216 1.00
}
dress "Tooltip.frame" {
  slice 108 104 32 32 6 tint
  tone 0.319 0.319 0.319 1.00
}
dress "Hud.frame" {
  slice 144 104 32 32 6 tint
  tone 0.262 0.262 0.262 1.00
}
dress "Meter.track" {
  slice 180 104 32 16 4 tint
}
dress "Meter.fill" {
  slice 216 104 32 16 4 tint
}
dress "Toggle.knob[on]" {
  fill "#f4f7fa"
}
dress "Toggle.knob[off]" {
  fill "#8e98a3"
}
