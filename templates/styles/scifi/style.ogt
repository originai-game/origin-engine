type style
version 1
---
# The scifi style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "scifi"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#03080f"
  well "#071220"
  panel "#1a4a66"
  panelHover "#225a7a"
  panelRaised "#1a4a66"
  line "#2c6a88"
  lineStrong "#6fd3f5"
  ink "#e2f7ff"
  inkMuted "#a6cde0"
  inkFaint "#6f93a6"
  inkInverse "#03080f"
  control "#3f8fb3"
  controlStrong "#5aaed4"
  primary "#38e1ff"
  primaryHover "#30d4f0"
  primaryActive "#16c4e6"
  onPrimary "#e2f7ff"
  primarySoft "#38e1ff2d"
  highlight "#7fecff"
  focus "#ffd23f"
  knob "#2f7194"
  hud "#1a4a66"
  scrim "#010409cc"
  shadow "#00000099"
  sheen "#ffffff52"
  success "#3dffa0"
  warn "#ffc53d"
  danger "#ff4d6a"
  info "#38e1ff"
  health "#3dffa0"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#38e1ff"
}
radius {
  small 2
  control 2
  bar 2
  panel 2
}
ramp {
  body 14 20
  meta 12 16
  caption 12 16
  lg 17 24
  xl 19 26
  xl2 22 28
  xl3 26 30
  displaySm 26 32
  displayMd 32 38
  displayLg 38 44
}
durations {
  instant 90
  fast 140
  base 220
  slow 360
}
fonts {
  body "ChakraPetch-Medium.ttf"
  display "Orbitron-Bold.ttf"
  numeric "JetBrainsMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 18 tint
tone panel 0.027 0.027 0.027 0.94
slice card 104 4 64 64 12 tint
tone card 0.040 0.040 0.040 0.94
slice button 172 4 48 48 12 tint
tone button 0.074 0.074 0.074 0.95
slice buttonHover 224 4 48 48 12 tint
tone buttonHover 0.147 0.147 0.147 0.96
slice buttonPressed 276 4 48 48 12 tint
tone buttonPressed 0.319 0.319 0.319 1.00
slice buttonDisabled 328 4 48 48 12 tint
tone buttonDisabled 0.054 0.054 0.054 0.85
slice field 4 104 48 48 8 tint
tone field 0.018 0.018 0.018 0.94
slice slot 56 104 48 48 10 tint
tone slot 0.033 0.033 0.033 0.90
slice tooltip 108 104 32 32 8 tint
tone tooltip 0.033 0.033 0.033 0.96
slice hud 144 104 32 32 10 tint
tone hud 0.040 0.040 0.040 0.94
slice track 180 104 32 16 5 tint
tone track 0.072 0.072 0.072 0.90
slice fill 216 104 32 16 2 tint
tone fill 0.790 0.790 0.790 1.00
soft 252 104 64 64 24
corner 320 104 32 32 18 18 primary 4
corners panel card slot
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 32 14 primary 0
tile 204 172 64 64 64 64 0.08 3 panel
shadow panel 0 0 18 0 "#000000aa"
glow button 5 primary 0.22
glow panel 10 primary 0.12
glow hud 4 primary 0.18
glass panel 16 0.85 0.15
textGlow display 1.5 primary 0.55
press 0.98 0.98 0
hover 0 1.02
motion {
  enter fade
  stagger 30
  toast slideLeft
  progress 300
  shake 6
  pop 0.1
}
