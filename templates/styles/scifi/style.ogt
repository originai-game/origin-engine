type style
version 2
---
# The scifi style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "scifi"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#03080f"
  well "#071220"
  panel "#1a4a66"
  panelHover "#225a7a"
  panelRaised "#1a4a66"
  line "#2c6a88"
  lineStrong "#6fd3f5"
  ink "#e2f7ff"
  inkMuted "#a6cde0"
  inkFaint "#6f93a6"
  inkInverse "#03080f"
  control "#3f8fb3"
  controlStrong "#5aaed4"
  primary "#38e1ff"
  primaryHover "#30d4f0"
  primaryActive "#16c4e6"
  onPrimary "#e2f7ff"
  primarySoft "#38e1ff2d"
  highlight "#7fecff"
  focus "#ffd23f"
  knob "#2f7194"
  hud "#1a4a66"
  scrim "#010409cc"
  shadow "#00000099"
  sheen "#ffffff52"
  success "#3dffa0"
  warn "#ffc53d"
  danger "#ff4d6a"
  info "#38e1ff"
  health "#3dffa0"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#38e1ff"
}
colors {
  success icon "check"
  warn pattern stripes
  danger pattern chevrons
  info pattern grid
  common "#8aa4b4" pips 1
  uncommon "#3dffa0" pips 2
  rare "#38c8ff" pips 3
  epic "#a87cff" pips 4
  legendary "#ffc53d" pips 5
  mythic "#ff516d" pips 6
  team1 "#38c8ff"
  team2 "#ff516d"
  team3 "#3dffa0"
  team4 "#ffc53d"
  team5 "#a87cff"
  team6 "#ff8a3d"
  team7 "#3df0e0"
  team8 "#ff6ad8"
  physical "#a6cde0" pattern hatch
  fire "#ff7a3d" icon "fire"
  ice "#7fecff" icon "drop"
  lightning "#ffe03d" icon "bolt"
  poison "#9dff3d" pattern dots
  holy "#fff4c0" icon "star"
  shadow "#9a7cff" pattern grid
  arcane "#ff6ad8" pattern diamonds
  series1 "#38e1ff"
  series2 "#ffc53d"
  series3 "#ff516d"
  series4 "#3dffa0"
  series5 "#a87cff"
  series6 "#ff8a3d"
  series7 "#3df0e0"
  series8 "#a6cde0"
}
typography {
  display 38 44 0.08 700 display {
    phonePortrait 30 35
    phoneLandscape 34 40
  }
  title 26 32 0.06 700 display
  heading 19 26 0.04 500 display
  body 14 20 0 500 body
  label 12 16 0.06 500 body
  caption 12 16 0.04 500 body
  numeric 17 24 0 400 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 1
  sm 2
  md 2
  lg 4
  xl 6
  pill 9999
}
stroke {
  hairline 1
  thin 1
  regular 1.5
  thick 2
  focus 2
}
elevation {
  raised {
    shadow 0 0 8 0 "#00000080"
  }
  floating {
    shadow 0 0 12 0 "#00000099"
    shadow 0 0 4 0 "#38e1ff26"
  }
  overlay {
    shadow 0 0 18 0 "#000000aa"
    shadow 0 0 6 0 "#38e1ff33"
  }
  top {
    shadow 0 0 24 0 "#000000bb"
    shadow 0 0 8 0 "#38e1ff40"
  }
}
shape {
  panel bevel 2
  dialog bevel 16
  card bevel 10
  tooltip bevel 6
  button bevel 2
  field bevel 2
  chip bevel 6
  badge notch 4
  tab bevel 6
  slot bevel 2
  bar bevel 2
  hud bevel 8
  avatar bevel 8
}
ramp {
  body 14 20
  meta 12 16
  caption 12 16
  lg 17 24
  xl 19 26
  xl2 22 28
  xl3 26 30
  displaySm 26 32
  displayMd 32 38
  displayLg 38 44
}
fonts {
  body "ChakraPetch-Medium.ttf"
  display "Orbitron-Bold.ttf"
  numeric "JetBrainsMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
corner 320 104 32 32 18 18 primary 4
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 32 14 primary 0
tile 204 172 64 64 64 64 0.08 3
textGlow display 1.5 primary 0.55
motion {
  enter fade
  toast slideLeft
  progress 300
  shake 6
  pop 0.1
  spring ui 140 0
  spring panel 240 0
  spring emphasis 360 0.1
  spring playful 420 0.15
  ease standard 0.4 0 0.2 1
  ease enter 0 0 0.2 1
  ease exit 0.4 0 1 1
  ease emphasis 0.2 0 0 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 360
  duration spring 520
  duration bounce 640
  stagger 30
  staggerCap 240
  overshoot 0.02
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none volume 0.5 0.6 haptic tick
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic tick
  typewriter none volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  counterTick none pitch 1 1.4 haptic tick
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 18 tint
  tone 0.027 0.027 0.027 0.94
  shadow 0 0 18 0 "#000000aa"
  glow 10 primary 0.12
  glass 16 0.85 0.15
  corners
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 12 tint
  tone 0.040 0.040 0.040 0.94
  corners
}
dress "Button.base" {
  slice 172 4 48 48 12 tint
  tone 0.074 0.074 0.074 0.95
  glow 5 primary 0.22
  press 0.98 0.98 0
  hover 0 1.02
}
dress "Button.base[hover]" {
  slice 224 4 48 48 12 tint
  tone 0.147 0.147 0.147 0.96
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 12 tint
  tone 0.319 0.319 0.319 1.00
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 12 tint
  tone 0.054 0.054 0.054 0.85
}
dress "Field.frame" {
  slice 4 104 48 48 8 tint
  tone 0.018 0.018 0.018 0.94
}
dress "Slot.frame" {
  slice 56 104 48 48 10 tint
  tone 0.033 0.033 0.033 0.90
  corners
}
dress "Tooltip.frame" {
  slice 108 104 32 32 8 tint
  tone 0.033 0.033 0.033 0.96
}
dress "Hud.frame" {
  slice 144 104 32 32 10 tint
  tone 0.040 0.040 0.040 0.94
  glow 4 primary 0.18
}
dress "Meter.track" {
  slice 180 104 32 16 5 tint
  tone 0.072 0.072 0.072 0.90
}
dress "Meter.fill" {
  slice 216 104 32 16 2 tint
  tone 0.790 0.790 0.790 1.00
}
