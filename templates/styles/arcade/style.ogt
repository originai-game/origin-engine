type style
version 2
---
# arcade: the pixel retro look, generated by og style new (docs/ui.md §12.5) for "an 8-bit arcade platformer with a high-score table".
# Choices: scheme dark, seed #ffcc1a, shape pixel, ornament none, motion mechanical, finish bevel.
name "arcade"
scheme dark
palette {
  backdrop "#0f0f26"
  well "#0b0b1b"
  panel "#272534"
  panelHover "#383644"
  panelRaised "#32303e"
  line "#4e4c56"
  lineStrong "#939193"
  ink "#fffcf1"
  inkMuted "#cecbc8"
  inkFaint "#b5b2b3"
  inkInverse "#272534"
  control "#363441"
  controlStrong "#45434e"
  primary "#ffcc1a"
  primaryHover "#ffd02c"
  primaryActive "#ffd43f"
  onPrimary "#382d06"
  primarySoft "#ffcc1a2e"
  highlight "#d5f9ff"
  focus "#40e0ff"
  knob "#52505a"
  hud "#272534f0"
  scrim "#080813b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f0af4c"
  danger "#ec9994"
  info "#89b8ea"
  health "#64d877"
  mana "#84b6f5"
  xp "#c99fe6"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#ab47f0" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#547daa"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 0
  sm 0
  md 0
  lg 0
  xl 0
  pill 9999
}
stroke {
  hairline 2
  thin 2
  regular 2
  thick 4
  focus 2
}
elevation {
  raised {
    shadow 0 2 0 0 "#00000036"
  }
  floating {
    shadow 0 4 0 0 "#0000003e"
  }
  overlay {
    shadow 0 6 0 0 "#00000045"
  }
  top {
    shadow 0 6 0 0 "#0000004d"
  }
}
shape {
  panel square 0
  dialog square 0
  card square 0
  tooltip square 0
  button square 0
  field square 0
  chip square 0
  badge square 0
  tab square 0
  slot square 0
  bar square 0
  hud square 0
  avatar square 0
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/pixel/DotGothic16-Regular.ttf"
  display "@styles/pixel/DotGothic16-Regular.ttf"
  numeric "@styles/pixel/DotGothic16-Regular.ttf"
  cjk "@styles/cjk/FusionPixel12-zhHans.ttf"
  cjkDisplay "@styles/cjk/FusionPixel12-zhHans.ttf"
}
icons "@styles/pixel/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter slideLeft
  toast slideLeft
  progress 240
  shake 6
  pop 0
  spring ui 100 0
  spring panel 180 0
  spring emphasis 240 0
  spring playful 300 0.04
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 60
  duration fast 100
  duration base 160
  duration slow 240
  duration spring 320
  duration bounce 400
  stagger 25
  staggerCap 300
  overshoot 0
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 1 1 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 1 1 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 1 1 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 1 1 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 1 1 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 1.05 1.05 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.85 0.85 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.15 1.15 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.2 1.2 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 1.1 1.1 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.4 1.4 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.6 1.6 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.3 1.3 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.25 1.25 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 1 1 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.1 1.1 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 1 1 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.9 0.9 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.95 0.95 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.15 1.15 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.9 0.9 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.8 0.8 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.7 0.7 haptic thud
}
dress "Button.base" {
  press 1 1 1
  hover 0 1
  stroke 2 lineStrong inside
  effect innerShadow 2 2 0 0 "#ffffff4d"
  effect innerShadow -2 -2 0 0 "#0000004d"
}
dress "Panel.frame" {
  stroke 2 "#939193" inside
  effect innerShadow 2 2 0 0 "#ffffff38"
  effect innerShadow -2 -2 0 0 "#00000059"
}
dress "Button.base[pressed]" {
  effect innerShadow 2 2 0 0 "#00000059"
}
dress "Slot.frame" {
  stroke 2 lineStrong inside
  effect innerShadow 2 2 0 0 "#0000004d"
}
dress "Field.frame" {
  effect innerShadow 2 2 0 0 "#0000004d"
}
dress "Meter.track" {
  stroke 2 lineStrong inside
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Slot.frame[selected]" {
  stroke 2 "#40e0ff" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
