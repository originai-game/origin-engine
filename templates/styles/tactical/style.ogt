type style
version 2
---
# tactical: the tactical military look, generated by og style new (docs/ui.md §12.5) for "a squad tactics game of briefings, loadouts and grid maps".
# Choices: scheme dark, seed #9aae5c, shape cut, ornament light, motion mechanical, finish flat.
name "tactical"
scheme dark
palette {
  backdrop "#101210"
  well "#0b0d0b"
  panel "#252723"
  panelHover "#363835"
  panelRaised "#30322e"
  line "#4b4d49"
  lineStrong "#8f918c"
  ink "#f9faf5"
  inkMuted "#cbccc8"
  inkFaint "#b2b3af"
  inkInverse "#252723"
  control "#343632"
  controlStrong "#434540"
  primary "#aabb76"
  primaryHover "#b1c081"
  primaryActive "#b8c68c"
  onPrimary "#222614"
  primarySoft "#aabb7638"
  highlight "#f5e7bf"
  focus "#e0b13a"
  knob "#4f514d"
  hud "#252723f0"
  scrim "#080908b3"
  shadow "#0000008c"
  sheen "#ffffff38"
  success "#69d390"
  warn "#f0af4d"
  danger "#ec9994"
  info "#87b7ea"
  health "#64d877"
  mana "#82b5f5"
  xp "#c99ee6"
  gold "#f0c54c"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#ab47ef" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#537da9"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 48 54 -0.01 700 display {
    phonePortrait 38 43
    phoneLandscape 43 48
  }
  title 30 36 -0.005 700 display {
    phonePortrait 26 31
    phoneLandscape 28 34
  }
  heading 22 29 0 600 display
  body 15 22 0 400 body
  label 12 17 0.12 600 body
  caption 13 18 0 400 body
  numeric 19 26 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 4
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.25
  regular 1.75
  thick 2.5
  focus 2
}
elevation {
  raised {
    shadow 0 2 6 0 "#0000002b"
    shadow 0 1 2 0 "#0000001f"
  }
  floating {
    shadow 0 4 12 0 "#00000031"
    shadow 0 1 2 0 "#0000001f"
  }
  overlay {
    shadow 0 8 24 0 "#00000038"
    shadow 0 1 2 0 "#0000001f"
  }
  top {
    shadow 0 14 36 0 "#0000003e"
    shadow 0 1 2 0 "#0000001f"
  }
}
shape {
  panel bevel 10
  dialog bevel 12
  card bevel 8
  tooltip bevel 4
  button bevel 6
  field bevel 4.8
  chip bevel 6
  badge bevel 6
  tab bevel 4.8
  slot bevel 6
  bar bevel 2
  hud bevel 6
  avatar round pill
}
ramp {
  body 15 21
  meta 13 18
  caption 13 18
  reading 16 25
  lg 19 26
  xl 22 29
  xl2 26 32
  xl3 30 35
  displaySm 32 36
  displayMd 40 45
  displayLg 50 55
}
fonts {
  body "@styles/shared/Rajdhani-Bold.ttf"
  display "@styles/shared/ChakraPetch-SemiBold.ttf"
  numeric "@styles/scifi/JetBrainsMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "@styles/scifi/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter slideLeft
  toast slideLeft
  progress 240
  shake 6
  pop 0
  spring ui 100 0
  spring panel 180 0
  spring emphasis 240 0
  spring playful 300 0.04
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 60
  duration fast 100
  duration base 160
  duration slow 240
  duration spring 320
  duration bounce 400
  stagger 25
  staggerCap 300
  overshoot 0
}
sounds {
  hover "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.15 0.21 pitch 1.23 1.27 haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.98 1.02 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.48 0.6 pitch 0.98 1.02 haptic tick
  confirm "sfx-confirm.ogt" volume 0.51 0.6 pitch 0.99 1.01 haptic tap
  cancel "sfx-back.ogt" volume 0.48 0.6 pitch 0.98 1.02 haptic tick
  back "sfx-back.ogt" volume 0.48 0.6 pitch 0.98 1.02 haptic tick
  open "sfx-open.ogt" volume 0.36 0.42 pitch 1.03 1.07 haptic none
  close "sfx-open.ogt" volume 0.3 0.36 pitch 0.83 0.87 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.42 0.54 pitch 1.13 1.17 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.36 0.42 pitch 1.18 1.22 haptic tick
  toggleOff "sfx-back.ogt" volume 0.36 0.42 pitch 1.08 1.12 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.3 pitch 1.36 1.44 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.12 0.18 pitch 1.54 1.66 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.21 0.27 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.42 0.48 pitch 1.28 1.32 haptic tap
  warning "sfx-error.ogt" volume 0.36 0.42 pitch 1.23 1.27 haptic warning
  error "sfx-error.ogt" volume 0.48 0.6 pitch 0.99 1.01 haptic error
  success "sfx-reward.ogt" volume 0.48 0.6 pitch 1.09 1.11 haptic success
  reward "sfx-reward.ogt" volume 0.54 0.6 pitch 0.99 1.01 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.36 0.42 pitch 0.88 0.92 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.42 0.48 pitch 0.93 0.97 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.48 0.54 pitch 1.13 1.17 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.51 0.6 pitch 0.89 0.91 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.54 0.6 pitch 0.79 0.81 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.6 0.6 pitch 0.69 0.71 haptic thud
}
dress "Button.base" {
  press 1 1 1
  hover 0 1
}
dress "Panel.frame" {
  stroke 1 line inside
}
dress "Button.base[primary]" {
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Chip.base[selected]" {
  stroke 1 primary inside
}
dress "Tabs.tab[selected]" {
  stroke 1 primary inside
}
dress "Slot.frame[selected]" {
  stroke 1 primary inside
}
dress "Tabs.tab[selected][underline]" {
  fill none
  stroke none
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
dress "Inventory.item[selected]" {
  stroke 1 primary inside
}
dress "Inventory.item[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Inventory.item[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Inventory.item[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Inventory.item[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
