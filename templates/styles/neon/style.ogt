type style
version 1
---
# The neon style pack: generated by templates/ui-kit/tools/make-styles.py (CC0 art, OFL fonts; LICENSES.md).
name "neon"
scheme dark
atlas "atlas.png" 384 256
scale 1
palette {
  backdrop "#07020f"
  well "#0e0520"
  panel "#1b0f36"
  panelHover "#26164a"
  panelRaised "#1b0f36"
  line "#4a2f86"
  lineStrong "#b18cff"
  ink "#fbefff"
  inkMuted "#cdb6ea"
  inkFaint "#8d76ad"
  inkInverse "#07020f"
  control "#7a4fe6"
  controlStrong "#7650d8"
  primary "#c81ebc"
  primaryHover "#d42ac8"
  primaryActive "#b018a6"
  onPrimary "#fbefff"
  primarySoft "#c81ebc40"
  highlight "#ff8af8"
  focus "#36e8ff"
  knob "#5a3aa6"
  hud "#1b0f36"
  scrim "#030008cc"
  shadow "#000000aa"
  sheen "#ffffff52"
  success "#3dffb0"
  warn "#ffd23d"
  danger "#ff3d6e"
  info "#36e8ff"
  health "#3dffb0"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#c81ebc"
}
radius {
  small 6
  control 6
  bar 6
  panel 10
}
ramp {
  body 15 20
  meta 13 18
  caption 13 18
  lg 19 24
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 50 54
}
durations {
  instant 90
  fast 140
  base 220
  slow 380
}
fonts {
  body "Rajdhani-Bold.ttf"
  display "ChakraPetch-BoldItalic.ttf"
  numeric "ChakraPetch-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 22 authored
tone panel 0.006 0.003 0.018 0.93
slice card 104 4 64 64 14 tint
tone card 0.010 0.010 0.010 0.86
slice button 172 4 48 48 16 tint
tone button 0.040 0.040 0.040 0.90
slice buttonHover 224 4 48 48 16 tint
tone buttonHover 0.084 0.084 0.084 0.94
slice buttonPressed 276 4 48 48 16 tint
tone buttonPressed 0.262 0.262 0.262 1.00
slice buttonDisabled 328 4 48 48 16 tint
tone buttonDisabled 0.027 0.027 0.027 0.80
slice field 4 104 48 48 10 tint
tone field 0.007 0.007 0.007 0.94
slice slot 56 104 48 48 12 tint
tone slot 0.014 0.014 0.014 0.88
slice tooltip 108 104 32 32 10 tint
tone tooltip 0.014 0.014 0.014 0.94
slice hud 144 104 32 32 14 tint
tone hud 0.014 0.014 0.014 0.90
slice track 180 104 32 16 6 tint
tone track 0.034 0.034 0.034 0.90
slice fill 216 104 32 16 6 tint
tone fill 0.791 0.791 0.791 1.00
soft 252 104 64 64 24
corner 320 104 32 32 20 20 primary 2
corners card
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 36 16 primary 0
tile 204 172 64 64 48 48 0.05 10 panel
shadow panel 0 6 18 0 "#000000a0"
glow button 4 primary 0.22
glow slot 3 focus 0.16
textGlow display 1.4 primary 0.45
press 0.96 0.96 0
hover 0 1.04
motion {
  enter pop
  stagger 35
  toast slideLeft
  progress 260
  shake 7
  pop 0.16
}
