type style
version 2
---
# inkwash: the ink and eastern brush look, generated by og style new (docs/ui.md §12.5) for "a wuxia journey painted in ink on rice paper".
# Choices: scheme light, seed #b22f26, shape soft, ornament light, motion calm, finish brush.
name "inkwash"
scheme light
palette {
  backdrop "#ece3cf"
  well "#ded5c3"
  panel "#f9f4ef"
  panelHover "#f0ebe7"
  panelRaised "#fbf8f5"
  line "#d2cac5"
  lineStrong "#8d7e7b"
  ink "#200807"
  inkMuted "#564341"
  inkFaint "#665757"
  inkInverse "#fdfcfa"
  control "#eae3df"
  controlStrong "#dbd3cf"
  primary "#992821"
  primaryHover "#8d251e"
  primaryActive "#81221c"
  onPrimary "#fdf9f8"
  primarySoft "#99282138"
  highlight "#2d4a43"
  focus "#2d4a43"
  knob "#fdfcfb"
  hud "#f9f4eff0"
  scrim "#767268b3"
  shadow "#2d0c0a3d"
  sheen "#ffffff80"
  success "#1a5630"
  warn "#6a4309"
  danger "#881b18"
  info "#164881"
  health "#175721"
  mana "#0b4590"
  xp "#5b2183"
  gold "#614908"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#909090" pips 1
  uncommon "#36a444" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#e27100" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#36a452"
  team4 "#b28b12"
  team5 "#a347ff"
  team6 "#da761b"
  team7 "#19a0a0"
  team8 "#f057a5"
  physical "#969083"
  fire "#f16429"
  ice "#4999bd"
  lightning "#a88e26"
  poison "#5da040"
  holy "#9d9063"
  shadow "#8a5cf6"
  arcane "#f04bcc"
  series1 "#4e79a7"
  series2 "#d27b25"
  series3 "#e15759"
  series4 "#649a96"
  series5 "#59a04f"
  series6 "#a88e33"
  series7 "#b07aa1"
  series8 "#c77b83"
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 6
  sm 8
  md 12
  lg 18
  xl 24
  pill 9999
}
stroke {
  hairline 1
  thin 1.25
  regular 1.75
  thick 2.5
  focus 2
}
elevation {
  raised {
    shadow 0 2 6 0 "#2d0c0a08"
    shadow 0 1 2 0 "#2d0c0a06"
  }
  floating {
    shadow 0 4 12 0 "#2d0c0a09"
    shadow 0 1 2 0 "#2d0c0a06"
  }
  overlay {
    shadow 0 8 24 0 "#2d0c0a0b"
    shadow 0 1 2 0 "#2d0c0a06"
  }
  top {
    shadow 0 14 36 0 "#2d0c0a0c"
    shadow 0 1 2 0 "#2d0c0a06"
  }
}
shape {
  panel round 12
  dialog round 14.4
  card round 9.6
  tooltip round 6
  button round 8
  field round 6.4
  chip round pill
  badge round pill
  tab round 6.4
  slot round 9
  bar round pill
  hud round 8
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/fantasy/Newsreader-Medium.ttf"
  display "@styles/paper/Newsreader-SemiBold.ttf"
  numeric "@styles/paper/Newsreader-SemiBold.ttf"
  cjk "@styles/cjk/NotoSerifSC-SemiBold.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/fantasy/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter fade
  toast slideUp
  progress 460
  shake 4
  pop 0.04
  spring ui 220 0
  spring panel 380 0
  spring emphasis 480 0.06
  spring playful 560 0.1
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 120
  duration fast 200
  duration base 300
  duration slow 460
  duration spring 560
  duration bounce 680
  stagger 50
  staggerCap 300
  overshoot 0.02
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  confirm "sfx-confirm.ogt" volume 0.425 0.5 pitch 0.975 1.025 haptic tap
  cancel "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  back "sfx-back.ogt" volume 0.4 0.5 pitch 0.95 1.05 haptic tick
  open "sfx-open.ogt" volume 0.3 0.35 pitch 1 1.1 haptic none
  close "sfx-open.ogt" volume 0.25 0.3 pitch 0.8 0.9 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.35 0.45 pitch 1.1 1.2 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.3 0.35 pitch 1.15 1.25 haptic tick
  toggleOff "sfx-back.ogt" volume 0.3 0.35 pitch 1.05 1.15 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.25 pitch 1.3 1.5 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.1 0.15 pitch 1.45 1.75 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.175 0.225 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.35 0.4 pitch 1.25 1.35 haptic tap
  warning "sfx-error.ogt" volume 0.3 0.35 pitch 1.2 1.3 haptic warning
  error "sfx-error.ogt" volume 0.4 0.5 pitch 0.975 1.025 haptic error
  success "sfx-reward.ogt" volume 0.4 0.5 pitch 1.075 1.125 haptic success
  reward "sfx-reward.ogt" volume 0.45 0.5 pitch 0.975 1.025 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.3 0.35 pitch 0.85 0.95 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.35 0.4 pitch 0.9 1 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.4 0.45 pitch 1.1 1.2 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.425 0.5 pitch 0.875 0.925 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.45 0.5 pitch 0.775 0.825 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.5 0.5 pitch 0.675 0.725 haptic thud
}
dress "Button.base" {
  press 0.98 0.98 1
  hover -1 1
  stroke 1.75 "#200807a6" inside dash 28 4 offset 6 round
}
dress "Panel.frame" {
  fill radial panelRaised panelRaised panel well
  fill linear 176 "#20080700" "#2008070d" 0.14 "#20080700" 0.27 "#20080709" 0.41 "#20080700" 0.58 "#2008070d" 0.72 "#20080700" 0.86 "#20080708"
  stroke 2.5 "#200807cc" inside dash 46 5 offset 9 round
  stroke 1 "#20080766" outside dash 13 7 offset 3 round
  effect innerShadow 0 0 18 0 "#2008071a"
}
dress "Card.frame" {
  fill radial panelRaised panelRaised panel well
  fill linear 176 "#20080700" "#2008070d" 0.14 "#20080700" 0.27 "#20080709" 0.41 "#20080700" 0.58 "#2008070d" 0.72 "#20080700" 0.86 "#20080708"
  stroke 1.5 "#200807a6" inside dash 30 4 offset 5 round
  effect innerShadow 0 0 12 0 "#20080714"
}
dress "Button.base[primary]" {
  effect innerShadow 0 0 10 0 "#0000002e"
  fill linear 180 primary primaryActive primaryActive primaryActive
}
dress "Field.frame" {
  stroke 1.5 "#2008078c" inside dash 22 3 offset 4 round
}
dress "Slot.frame" {
  stroke 1.5 "#20080780" inside dash 18 4 offset 2 round
}
dress "Tabs.tab[selected]" {
  stroke 2 primary inside
}
dress "Meter.fill" {
  effect innerShadow 0 0 6 0 "#00000033"
}
dress "Slot.frame[selected]" {
  stroke 2 "#2d4a43" inside
}
dress "Slot.frame[rarity=rare]" {
  stroke 2 "#3d8bfd" inside
}
dress "Slot.frame[rarity=epic]" {
  stroke 2 "#a855f7" inside
  effect outerGlow 8 "#a855f766"
}
dress "Slot.frame[rarity=legendary]" {
  stroke 2 "#f59e0b" inside
  effect outerGlow 10 "#f59e0b80"
  material shine 0.6
}
dress "Slot.frame[rarity=mythic]" {
  stroke 2 "#ef4444" inside
  effect outerGlow 12 "#ef444480"
  material hologram 0.5 2
}
