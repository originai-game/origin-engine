type icons
version 1
---
# The engine's game icon set (templates/tools/make-game-icons.py writes
# this file and game/): our own hero icons in tones first, drawn as
# stickers (an icon-outline rim and an icon-shadow drop, in 24ths of
# the em), then game-icons.net silhouettes (CC BY 3.0,
# third_party/game-icons/ICONS.md) in the icon's ink.
source "game"
size 48
range 8
join round
sticker 1.3 0 1.2
icon "coin"
icon "gem"
icon "star"
icon "heart"
icon "shield"
icon "energy"
icon "ammo"
icon "lock"
icon "key"
icon "chest"
icon "gift"
icon "crown"
icon "potion"
icon "ticket"
icon "xp"
icon "alert"
icon "new"
icon "rarity"
icon "trophy"
icon "hourglass"
icon "attack"
icon "sword"
icon "axe"
icon "bow"
icon "staff"
icon "magic"
icon "armor"
icon "speed"
icon "crit"
icon "accuracy"
icon "strength"
icon "intellect"
icon "luck"
icon "levelUp"
icon "bomb"
icon "skull"
icon "flame"
icon "barrier"
icon "home"
icon "shop"
icon "bag"
icon "hero"
icon "team"
icon "friends"
icon "quest"
icon "map"
icon "mail"
icon "chat"
icon "leaderboard"
icon "calendar"
icon "event"
icon "castle"
icon "banner"
icon "compass"
icon "book"
icon "search"
