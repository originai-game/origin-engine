type style
version 3
---
# storybook: the storybook look, generated by og style new (docs/ui.md §12.5) for "a gentle illustrated adventure told like a picture book".
# Choices: scheme light, seed #b5523b, shape soft, ornament rich, motion floaty, finish paper.
name "storybook"
scheme light
palette {
  --backdrop: #efe3c8
  --well: #e1d5bc
  --panel: #faf5ed
  --panel-hover: #f1ece5
  --panel-raised: #fcf9f4
  --line: #d3ccc4
  --line-strong: #8e827c
  --ink: #210f0b
  --ink-muted: #564844
  --ink-faint: #645957
  --ink-inverse: #fefcfa
  --control: #ebe5dd
  --control-strong: #dcd5cd
  --primary: #863d2c
  --primary-hover: #7b3828
  --primary-active: #713325
  --on-primary: #fdfaf9
  --primary-soft: #863d2c38
  --highlight: #3a5a43
  --focus: #4f7d5b
  --knob: #fefdfb
  --hud: #faf5edf0
  --scrim: #787264b3
  --shadow: #2d150f3d
  --sheen: #ffffff80
  --success: #1a5630
  --warn: #6a4309
  --danger: #891b18
  --info: #164881
  --health: #175721
  --mana: #0c4591
  --xp: #5b2183
  --gold: #624908
}
colors {
  --success: icon "check"
  --warn: icon "bolt"
  --danger: icon "close"
  --info: pattern waves
  --common: #919191 pips 1
  --uncommon: #37a544 pips 2
  --rare: #2f7fef pips 3
  --epic: #a335ee pips 4
  --legendary: #e27200 pips 5
  --mythic: #e8364f pips 6
  --team1: #3d7eff
  --team2: #ff4747
  --team3: #36a552
  --team4: #b48b12
  --team5: #a347ff
  --team6: #db761b
  --team7: #19a1a1
  --team8: #f157a7
  --physical: #979083
  --fire: #f26429
  --ice: #499abe
  --lightning: #a98f27
  --poison: #5ea141
  --holy: #9e9063
  --shadow: #8a5cf6
  --arcane: #f24bcd
  --series1: #4e79a7
  --series2: #d27c25
  --series3: #e15759
  --series4: #649a96
  --series5: #59a14f
  --series6: #a98f33
  --series7: #b07aa1
  --series8: #c97b83
}
typography {
  display 51 57 -0.01 700 display {
    phonePortrait 41 46
    phoneLandscape 46 52
  }
  title 32 38 -0.005 700 display {
    phonePortrait 27 32
    phoneLandscape 29 35
  }
  heading 24 32 0 600 display
  body 16 23 0 400 body
  label 14 19 0.01 600 body
  caption 14 19 0 400 body
  numeric 20 27 0 500 numeric
}
space {
  --space-xxs: 2px
  --space-xs: 4px
  --space-sm: 8px
  --space-md: 12px
  --space-lg: 16px
  --space-xl: 24px
  --space-xxl: 32px
  --space-xl3: 48px
}
size {
  --size-xs: 16px
  --size-sm: 24px
  --size-md: 32px
  --size-lg: 48px
  --size-xl: 64px
  --size-xxl: 96px
  --size-touch: 44px
}
radius {
  --radius-xs: 6px
  --radius-sm: 8px
  --radius-md: 12px
  --radius-lg: 18px
  --radius-xl: 24px
  --radius-pill: 9999px
}
stroke {
  --stroke-hairline: 1px
  --stroke-thin: 1.5px
  --stroke-regular: 2px
  --stroke-thick: 3px
  --stroke-focus: 2px
}
elevation {
  raised {
    shadow 0 2 6 0 "#2d150f08"
    shadow 0 1 2 0 "#2d150f06"
  }
  floating {
    shadow 0 4 12 0 "#2d150f09"
    shadow 0 1 2 0 "#2d150f06"
  }
  overlay {
    shadow 0 8 24 0 "#2d150f0b"
    shadow 0 1 2 0 "#2d150f06"
  }
  top {
    shadow 0 14 36 0 "#2d150f0c"
    shadow 0 1 2 0 "#2d150f06"
  }
}
shape {
  panel round 12
  dialog round 14.4
  card round 9.6
  tooltip round 6
  button round 8
  field round 6.4
  chip round pill
  badge round pill
  tab round 6.4
  slot round 9
  bar round pill
  hud round 8
  avatar round pill
}
ramp {
  body 16 23
  meta 14 19
  caption 14 19
  reading 17 26
  lg 20 27
  xl 24 32
  xl2 28 34
  xl3 32 38
  displaySm 34 39
  displayMd 43 48
  displayLg 53 58
}
fonts {
  body "@styles/shared/InstrumentSans-Regular.ttf"
  display "@styles/shared/Newsreader-SemiBold.ttf"
  numeric "@styles/shared/Newsreader-SemiBold.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSerifSC-SemiBold.ttf"
}
icons "@styles/shared/ink-icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
motion {
  enter fade
  toast fade
  progress 560
  shake 4
  pop 0.05
  spring ui 320 0.1
  spring panel 560 0.14
  spring emphasis 680 0.22
  spring playful 760 0.28
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 140
  duration fast 240
  duration base 380
  duration slow 560
  duration spring 680
  duration bounce 820
  stagger 80
  staggerCap 300
  overshoot 0.06
}
sounds {
  hover none haptic none
  press "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.92 1.08 haptic tick
  focus none haptic none
  select "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.44 0.55 pitch 0.92 1.08 haptic tick
  confirm "sfx-confirm.ogt" volume 0.468 0.55 pitch 0.96 1.04 haptic tap
  cancel "sfx-back.ogt" volume 0.44 0.55 pitch 0.92 1.08 haptic tick
  back "sfx-back.ogt" volume 0.44 0.55 pitch 0.92 1.08 haptic tick
  open "sfx-open.ogt" volume 0.33 0.385 pitch 0.97 1.13 haptic none
  close "sfx-open.ogt" volume 0.275 0.33 pitch 0.77 0.93 haptic none
  tab "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.385 0.495 pitch 1.07 1.23 haptic tick
  toggleOn "sfx-confirm.ogt" volume 0.33 0.385 pitch 1.12 1.28 haptic tick
  toggleOff "sfx-back.ogt" volume 0.33 0.385 pitch 1.02 1.18 haptic tick
  sliderTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.275 pitch 1.24 1.56 haptic tick
  scrollTick none haptic none
  typewriter "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.11 0.165 pitch 1.36 1.84 haptic none
  counterTick "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.193 0.248 pitch 0.9 1.5 haptic none
  notification "sfx-confirm.ogt" volume 0.385 0.44 pitch 1.22 1.38 haptic tap
  warning "sfx-error.ogt" volume 0.33 0.385 pitch 1.17 1.33 haptic warning
  error "sfx-error.ogt" volume 0.44 0.55 pitch 0.96 1.04 haptic error
  success "sfx-reward.ogt" volume 0.44 0.55 pitch 1.06 1.14 haptic success
  reward "sfx-reward.ogt" volume 0.495 0.55 pitch 0.96 1.04 haptic double
  revealCommon "sfx-tap.ogt" "sfx-tap2.ogt" volume 0.33 0.385 pitch 0.82 0.98 haptic none
  revealUncommon "sfx-confirm.ogt" volume 0.385 0.44 pitch 0.87 1.03 haptic tick
  revealRare "sfx-confirm.ogt" volume 0.44 0.495 pitch 1.07 1.23 haptic tap
  revealEpic "sfx-reward.ogt" volume 0.468 0.55 pitch 0.86 0.94 haptic double
  revealLegendary "sfx-reward.ogt" volume 0.495 0.55 pitch 0.76 0.84 haptic thud
  revealMythic "sfx-reward.ogt" volume 0.55 0.55 pitch 0.66 0.74 haptic thud
}
Button::base {
  -og-press: 0.99 0.99 0
  -og-hover: -2 1.01
  -og-stroke: 1.5px var(--line-strong) inside
}
Panel::frame {
  -og-stroke: 1.5px var(--line-strong) inside
  -og-effect: drop-shadow 1 3 6 0 #2d150f0f
  -og-ornament: corner
}
Card::frame {
  -og-stroke: 1.5px var(--line-strong) inside
  -og-effect: drop-shadow 2 3 0 0 #2d150f0f
}
Button::base:active {
  -og-effect: inner-shadow 1 2 0 0 #2d150f0f
}
Field::frame {
  -og-stroke: 1.5px var(--line-strong) inside dash 5 3
}
Button::base.primary {
  -og-fill: linear 180 var(--primary) var(--primary-active) var(--primary-active) var(--primary-active)
}
Chip::base:selected {
  -og-stroke: 1px var(--primary) inside
}
Tabs::tab:selected {
  -og-stroke: 1px var(--primary) inside
}
Slot::frame:selected {
  -og-stroke: 1px var(--primary) inside
}
Tabs::tab:selected.underline {
  -og-fill: none
  -og-stroke: none
}
Slot::frame[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Slot::frame[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Slot::frame[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Slot::frame[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
Dialog::frame {
  -og-ornament: corner
}
Inventory::item:selected {
  -og-stroke: 1px var(--primary) inside
}
Inventory::item[rarity=rare] {
  -og-stroke: 2px #3d8bfd inside
}
Inventory::item[rarity=epic] {
  -og-stroke: 2px #a855f7 inside
  -og-effect: outer-glow 8 #a855f766
}
Inventory::item[rarity=legendary] {
  -og-stroke: 2px #f59e0b inside
  -og-effect: outer-glow 10 #f59e0b80
  -og-material: shine 0.6
}
Inventory::item[rarity=mythic] {
  -og-stroke: 2px #ef4444 inside
  -og-effect: outer-glow 12 #ef444480
  -og-material: hologram 0.5 2
}
