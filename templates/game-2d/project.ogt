type project
version 1
---
# The project manifest (docs/design.md §2.5): `og run`, `og build`, `og cook`,
# `og dev` and `og test` read it. `npm create @origingame/game` writes this
# 2D starter for a 2D premise (or `--profile 2d`) and fills in the name and id.
name "Origin Game 2D"
id "origin-game-2d"
# The engine this game is written against (design §9: upgrades are explicit).
engine "0.7.6"
entry "src/main.ts"
# 2d: an orthographic camera, sprites, flipbooks, tilemaps and 2D physics.
profile "2d"
tick 60
seed 1
publish {
  # `og build --publish` keeps only the player-facing probe members
  # (hello, tick, state, pick, entity, input, capture).
  probe player
  out "dist"
  # Colour textures cook as etc1s (the default, a quarter of the bytes);
  # `cook { color_textures uastc }` above publish packs them without
  # ETC1S's block loss, and `color_textures etc1s` here keeps the web
  # export (`og build`) at etc1s.
}
