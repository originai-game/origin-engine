type tileset
version 1
---
# The city (the runner archetype's tileset, tools/make-assets.py there):
# 0 roof, 1-3 bricks, 4-7 far skyline, 8-14 near buildings, 15 the
# antenna's light on. The roof and the bricks collide as whole cells on a
# layer marked `collision true` (og-game §8).
texture "tiles/city.png"
grid 16 16 4 4
spacing 2
filter nearest
solid 0 1 2 3
# A far window that goes on and off.
tile 5 {
  frames 5 4 5
  durations 2.5 0.4 1.8
}
