type strings
version 1
---
# 繁體中文: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "zh-TW"
string "menu.title" "Origin Engine"
string "menu.prompt" "按「開始」進入遊戲"
string "menu.start" "開始"
string "hud.cells" "能量塊 {n}/{total}"
string "hud.seat" "玩家 {n}"
string "hud.pause" "暫停"
string "hud.jump" "跳躍"
string "hud.run" "奔跑"
string "hud.goal" "收集能量塊，然後站上運輸船下方的平台"
string "hud.ready" "能量塊已集齊：快去平台！"
string "pause.title" "已暫停"
string "pause.resume" "繼續"
string "pause.settings" "設定"
string "settings.title" "設定"
string "settings.master" "音量"
string "settings.effects" "音效"
string "settings.language" "語言"
string "settings.motion" "減少動態效果"
string "settings.done" "完成"
string "over.escaped" "成功逃脫！"
string "over.caught" "被抓住了！"
string "over.cells" "能量塊"
string "over.time" "用時"
string "over.best" "最佳"
string "over.grabs" "被抓次數"
string "over.again" "再玩一次"
