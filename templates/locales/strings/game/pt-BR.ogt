type strings
version 1
---
# Português (Brasil): templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "pt-BR"
string "menu.title" "Origin Engine"
string "menu.prompt" "Pressione Iniciar para começar"
string "menu.spinning" "Girando  {speed} rad/s"
string "menu.start" "Iniciar"
string "menu.started" "Iniciado"
