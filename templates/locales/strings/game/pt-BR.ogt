type strings
version 1
---
# Português (Brasil): templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "pt-BR"
string "menu.title" "Origin Engine"
string "menu.prompt" "Pressione Iniciar para começar"
string "menu.start" "Iniciar"
string "hud.cells" "Células {n}/{total}"
string "hud.seat" "Jogador {n}"
string "hud.pause" "Pausa"
string "hud.jump" "Pular"
string "hud.run" "Correr"
string "hud.goal" "Colete as células de energia e depois suba na plataforma sob a nave"
string "hud.ready" "Todas as células coletadas: vá para a plataforma!"
string "pause.title" "Pausado"
string "pause.resume" "Continuar"
string "pause.settings" "Configurações"
string "settings.title" "Configurações"
string "settings.master" "Volume"
string "settings.effects" "Efeitos"
string "settings.language" "Idioma"
string "settings.motion" "Reduzir movimento"
string "settings.done" "Concluído"
string "over.escaped" "Você escapou!"
string "over.caught" "Você foi pego!"
string "over.cells" "Células"
string "over.time" "Tempo"
string "over.best" "Recorde"
string "over.grabs" "Capturas"
string "over.again" "Jogar de novo"
