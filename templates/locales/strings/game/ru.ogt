type strings
version 1
---
# Русский: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ru"
string "menu.title" "Origin Engine"
string "menu.prompt" "Нажмите «Старт», чтобы начать"
string "menu.start" "Старт"
string "hud.cells" "Энергоячейки {n}/{total}"
string "hud.seat" "Игрок {n}"
string "hud.pause" "Пауза"
string "hud.jump" "Прыжок"
string "hud.run" "Бег"
string "hud.goal" "Соберите энергоячейки, затем встаньте на площадку под кораблём"
string "hud.ready" "Все ячейки собраны: бегите к площадке!"
string "pause.title" "Пауза"
string "pause.resume" "Продолжить"
string "pause.settings" "Настройки"
string "settings.title" "Настройки"
string "settings.master" "Громкость"
string "settings.effects" "Эффекты"
string "settings.language" "Язык"
string "settings.motion" "Меньше анимации"
string "settings.done" "Готово"
string "over.escaped" "Побег удался!"
string "over.caught" "Пойман!"
string "over.cells" "Ячейки"
string "over.time" "Время"
string "over.best" "Рекорд"
string "over.grabs" "Захваты"
string "over.again" "Играть снова"
