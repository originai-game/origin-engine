type strings
version 1
---
# Русский: templates/game's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ru"
string "menu.title" "Origin Engine"
string "menu.prompt" "Нажмите «Старт», чтобы начать"
string "menu.spinning" "Вращение  {speed} рад/с"
string "menu.start" "Старт"
string "menu.started" "Запущено"
