type strings
version 1
---
# العربية: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ar"
string "menu.title" "Origin Engine"
string "menu.prompt" "اضغط ابدأ للبدء"
string "menu.start" "ابدأ"
string "hud.cells" "الخلايا {n}/{total}"
string "hud.seat" "اللاعب {n}"
string "hud.pause" "إيقاف مؤقت"
string "hud.jump" "اقفز"
string "hud.run" "اركض"
string "hud.goal" "اجمع خلايا الطاقة، ثم قف على المنصة أسفل سفينة الإنزال"
string "hud.ready" "اكتملت الخلايا: توجّه إلى المنصة!"
string "pause.title" "متوقف مؤقتًا"
string "pause.resume" "استئناف"
string "pause.settings" "الإعدادات"
string "settings.title" "الإعدادات"
string "settings.master" "مستوى الصوت"
string "settings.effects" "المؤثرات"
string "settings.language" "اللغة"
string "settings.motion" "تقليل الحركة"
string "settings.done" "تم"
string "over.escaped" "نجوت!"
string "over.caught" "أُمسك بك!"
string "over.cells" "الخلايا"
string "over.time" "الوقت"
string "over.best" "الأفضل"
string "over.grabs" "مرات الإمساك"
string "over.again" "العب مجددًا"
