type strings
version 1
---
# العربية: templates/game's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ar"
string "menu.title" "Origin Engine"
string "menu.prompt" "اضغط ابدأ للبدء"
string "menu.spinning" "يدور  {speed} راديان/ث"
string "menu.start" "ابدأ"
string "menu.started" "تم البدء"
