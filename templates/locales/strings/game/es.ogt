type strings
version 1
---
# Español: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "es"
string "menu.title" "Origin Engine"
string "menu.prompt" "Pulsa Empezar para comenzar"
string "menu.start" "Empezar"
string "hud.cells" "Células {n}/{total}"
string "hud.seat" "Jugador {n}"
string "hud.pause" "Pausa"
string "hud.jump" "Saltar"
string "hud.run" "Correr"
string "hud.goal" "Reúne las células de energía y luego súbete a la plataforma bajo la nave"
string "hud.ready" "¡Tienes todas las células: ve a la plataforma!"
string "pause.title" "En pausa"
string "pause.resume" "Continuar"
string "pause.settings" "Ajustes"
string "settings.title" "Ajustes"
string "settings.master" "Volumen"
string "settings.effects" "Efectos"
string "settings.language" "Idioma"
string "settings.motion" "Reducir movimiento"
string "settings.done" "Listo"
string "over.escaped" "¡Escapaste!"
string "over.caught" "¡Te atraparon!"
string "over.cells" "Células"
string "over.time" "Tiempo"
string "over.best" "Récord"
string "over.grabs" "Capturas"
string "over.again" "Volver a jugar"
