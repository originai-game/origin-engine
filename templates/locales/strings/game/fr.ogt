type strings
version 1
---
# Français: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "fr"
string "menu.title" "Origin Engine"
string "menu.prompt" "Appuie sur Démarrer pour commencer"
string "menu.start" "Démarrer"
string "hud.cells" "Cellules {n}/{total}"
string "hud.seat" "Joueur {n}"
string "hud.pause" "Pause"
string "hud.jump" "Sauter"
string "hud.run" "Courir"
string "hud.goal" "Récupère les cellules d'énergie, puis monte sur la plateforme sous le vaisseau"
string "hud.ready" "Toutes les cellules sont là : file à la plateforme !"
string "pause.title" "En pause"
string "pause.resume" "Reprendre"
string "pause.settings" "Paramètres"
string "settings.title" "Paramètres"
string "settings.master" "Volume"
string "settings.effects" "Effets"
string "settings.language" "Langue"
string "settings.motion" "Réduire les animations"
string "settings.done" "Terminé"
string "over.escaped" "Évadé !"
string "over.caught" "Attrapé !"
string "over.cells" "Cellules"
string "over.time" "Temps"
string "over.best" "Record"
string "over.grabs" "Prises"
string "over.again" "Rejouer"
