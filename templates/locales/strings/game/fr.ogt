type strings
version 1
---
# Français: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "fr"
string "menu.title" "Origin Engine"
string "menu.prompt" "Appuie sur Démarrer pour commencer"
string "menu.spinning" "Rotation  {speed} rad/s"
string "menu.start" "Démarrer"
string "menu.started" "Démarré"
