type strings
version 1
---
# Italiano: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "it"
string "menu.title" "Origin Engine"
string "menu.prompt" "Premi Inizia per cominciare"
string "menu.start" "Inizia"
string "hud.cells" "Celle {n}/{total}"
string "hud.seat" "Giocatore {n}"
string "hud.pause" "Pausa"
string "hud.jump" "Salta"
string "hud.run" "Corri"
string "hud.goal" "Raccogli le celle di energia, poi sali sulla piattaforma sotto la navetta"
string "hud.ready" "Hai tutte le celle: corri alla piattaforma!"
string "pause.title" "In pausa"
string "pause.resume" "Riprendi"
string "pause.settings" "Impostazioni"
string "settings.title" "Impostazioni"
string "settings.master" "Volume"
string "settings.effects" "Effetti"
string "settings.language" "Lingua"
string "settings.motion" "Riduci movimento"
string "settings.done" "Fatto"
string "over.escaped" "Fuggito!"
string "over.caught" "Preso!"
string "over.cells" "Celle"
string "over.time" "Tempo"
string "over.best" "Record"
string "over.grabs" "Prese"
string "over.again" "Gioca ancora"
