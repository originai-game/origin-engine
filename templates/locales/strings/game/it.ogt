type strings
version 1
---
# Italiano: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "it"
string "menu.title" "Origin Engine"
string "menu.prompt" "Premi Inizia per cominciare"
string "menu.spinning" "In rotazione  {speed} rad/s"
string "menu.start" "Inizia"
string "menu.started" "Iniziato"
