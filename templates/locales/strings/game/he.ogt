type strings
version 1
---
# עברית: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "he"
string "menu.title" "Origin Engine"
string "menu.prompt" "לחצו על התחל כדי להתחיל"
string "menu.start" "התחל"
string "hud.cells" "תאים {n}/{total}"
string "hud.seat" "שחקן {n}"
string "hud.pause" "השהיה"
string "hud.jump" "קפיצה"
string "hud.run" "ריצה"
string "hud.goal" "אספו את תאי האנרגיה ואז עמדו על המנחת שמתחת לחללית"
string "hud.ready" "כל התאים נאספו: רוצו למנחת!"
string "pause.title" "מושהה"
string "pause.resume" "המשך"
string "pause.settings" "הגדרות"
string "settings.title" "הגדרות"
string "settings.master" "עוצמת קול"
string "settings.effects" "אפקטים"
string "settings.language" "שפה"
string "settings.motion" "הפחתת תנועה"
string "settings.done" "סיום"
string "over.escaped" "ברחתם!"
string "over.caught" "נתפסתם!"
string "over.cells" "תאים"
string "over.time" "זמן"
string "over.best" "שיא"
string "over.grabs" "תפיסות"
string "over.again" "שחקו שוב"
