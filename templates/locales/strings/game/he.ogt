type strings
version 1
---
# עברית: templates/game's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "he"
string "menu.title" "Origin Engine"
string "menu.prompt" "לחצו על התחל כדי להתחיל"
string "menu.spinning" "מסתובב  {speed} רד׳/ש׳"
string "menu.start" "התחל"
string "menu.started" "התחיל"
