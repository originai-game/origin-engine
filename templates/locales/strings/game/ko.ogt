type strings
version 1
---
# 한국어: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ko"
string "menu.title" "Origin Engine"
string "menu.prompt" "시작을 눌러 플레이하세요"
string "menu.start" "시작"
string "hud.cells" "셀 {n}/{total}"
string "hud.seat" "플레이어 {n}"
string "hud.pause" "일시정지"
string "hud.jump" "점프"
string "hud.run" "달리기"
string "hud.goal" "파워 셀을 모은 뒤 수송선 아래 착륙장에 올라서세요"
string "hud.ready" "셀을 모두 모았습니다: 착륙장으로!"
string "pause.title" "일시정지됨"
string "pause.resume" "계속"
string "pause.settings" "설정"
string "settings.title" "설정"
string "settings.master" "볼륨"
string "settings.effects" "효과음"
string "settings.language" "언어"
string "settings.motion" "동작 줄이기"
string "settings.done" "완료"
string "over.escaped" "탈출 성공!"
string "over.caught" "잡혔다!"
string "over.cells" "셀"
string "over.time" "시간"
string "over.best" "최고 기록"
string "over.grabs" "잡힌 횟수"
string "over.again" "다시 하기"
