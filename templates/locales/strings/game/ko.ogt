type strings
version 1
---
# 한국어: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ko"
string "menu.title" "Origin Engine"
string "menu.prompt" "시작을 눌러 플레이하세요"
string "menu.spinning" "회전 중  {speed} rad/s"
string "menu.start" "시작"
string "menu.started" "시작됨"
