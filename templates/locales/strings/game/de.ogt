type strings
version 1
---
# Deutsch: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "de"
string "menu.title" "Origin Engine"
string "menu.prompt" "Drücke Start, um zu beginnen"
string "menu.spinning" "Dreht sich  {speed} rad/s"
string "menu.start" "Start"
string "menu.started" "Gestartet"
