type strings
version 1
---
# Deutsch: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "de"
string "menu.title" "Origin Engine"
string "menu.prompt" "Drücke Start, um zu beginnen"
string "menu.start" "Start"
string "hud.cells" "Zellen {n}/{total}"
string "hud.seat" "Spieler {n}"
string "hud.pause" "Pause"
string "hud.jump" "Springen"
string "hud.run" "Rennen"
string "hud.goal" "Sammle die Energiezellen und stell dich dann auf die Plattform unter dem Landungsschiff"
string "hud.ready" "Alle Zellen gesammelt: ab zur Plattform!"
string "pause.title" "Pausiert"
string "pause.resume" "Weiter"
string "pause.settings" "Einstellungen"
string "settings.title" "Einstellungen"
string "settings.master" "Lautstärke"
string "settings.effects" "Effekte"
string "settings.language" "Sprache"
string "settings.motion" "Bewegung reduzieren"
string "settings.done" "Fertig"
string "over.escaped" "Entkommen!"
string "over.caught" "Erwischt!"
string "over.cells" "Zellen"
string "over.time" "Zeit"
string "over.best" "Rekord"
string "over.grabs" "Gepackt"
string "over.again" "Nochmal spielen"
