type strings
version 1
---
# 简体中文: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "zh-CN"
string "menu.title" "Origin Engine"
string "menu.prompt" "按开始键出发"
string "menu.start" "开始"
string "hud.cells" "能量块 {n}/{total}"
string "hud.seat" "玩家 {n}"
string "hud.pause" "暂停"
string "hud.jump" "跳跃"
string "hud.run" "奔跑"
string "hud.goal" "收集能量块，然后站上运输船下方的平台"
string "hud.ready" "能量块已集齐：快去平台！"
string "pause.title" "已暂停"
string "pause.resume" "继续"
string "pause.settings" "设置"
string "settings.title" "设置"
string "settings.master" "音量"
string "settings.effects" "音效"
string "settings.language" "语言"
string "settings.motion" "减少动态效果"
string "settings.done" "完成"
string "over.escaped" "成功逃脱！"
string "over.caught" "被抓住了！"
string "over.cells" "能量块"
string "over.time" "用时"
string "over.best" "最佳"
string "over.grabs" "被抓次数"
string "over.again" "再玩一次"
