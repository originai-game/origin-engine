type strings
version 1
---
# 日本語: templates/game's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ja"
string "menu.title" "Origin Engine"
string "menu.prompt" "「スタート」を押して始めよう"
string "menu.start" "スタート"
string "hud.cells" "セル {n}/{total}"
string "hud.seat" "プレイヤー {n}"
string "hud.pause" "ポーズ"
string "hud.jump" "ジャンプ"
string "hud.run" "ダッシュ"
string "hud.goal" "パワーセルを集めて、輸送船の下の発着台に立とう"
string "hud.ready" "セルがそろった：発着台へ急げ！"
string "pause.title" "ポーズ中"
string "pause.resume" "再開"
string "pause.settings" "設定"
string "settings.title" "設定"
string "settings.master" "音量"
string "settings.effects" "効果音"
string "settings.language" "言語"
string "settings.motion" "動きを減らす"
string "settings.done" "完了"
string "over.escaped" "脱出成功！"
string "over.caught" "捕まった！"
string "over.cells" "セル"
string "over.time" "タイム"
string "over.best" "ベスト"
string "over.grabs" "捕まった回数"
string "over.again" "もう一度遊ぶ"
