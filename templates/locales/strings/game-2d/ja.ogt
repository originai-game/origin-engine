type strings
version 1
---
# 日本語: templates/game-2d's assets/strings/en.ogt translated (og-i18n §1).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ja"
string "hud.level" "屋上"
string "hud.clear" "屋上クリア！"
string "hud.yard" "中庭"
string "hud.yardClear" "中庭クリア！"
string "hud.lives" "ライフ"
string "hud.pause" "ポーズ"
string "hud.jump" "ジャンプ"
string "pause.title" "ポーズ中"
string "pause.resume" "再開"
