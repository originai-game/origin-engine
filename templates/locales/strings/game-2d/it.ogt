type strings
version 1
---
# Italiano: templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "it"
string "hud.level" "I tetti"
string "hud.clear" "Tetti superati!"
string "hud.lives" "Vite"
string "hud.pause" "Pausa"
string "hud.jump" "Salta"
string "pause.title" "In pausa"
string "pause.resume" "Riprendi"
