type strings
version 1
---
# Русский: templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "ru"
string "hud.level" "Крыши"
string "hud.clear" "Крыши пройдены!"
string "hud.lives" "Жизни"
string "hud.pause" "Пауза"
string "hud.jump" "Прыжок"
string "pause.title" "Пауза"
string "pause.resume" "Продолжить"
