type strings
version 1
---
# 繁體中文: templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "zh-TW"
string "hud.level" "屋頂"
string "hud.clear" "屋頂過關！"
string "hud.lives" "生命"
string "hud.pause" "暫停"
string "hud.jump" "跳躍"
string "pause.title" "已暫停"
string "pause.resume" "繼續"
