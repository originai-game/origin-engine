type strings
version 1
---
# Português (Brasil): templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "pt-BR"
string "hud.level" "Os telhados"
string "hud.clear" "Telhados concluídos!"
string "hud.lives" "Vidas"
string "hud.pause" "Pausa"
string "hud.jump" "Pular"
string "pause.title" "Pausado"
string "pause.resume" "Continuar"
