type strings
version 1
---
# 简体中文: templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "zh-CN"
string "hud.level" "屋顶"
string "hud.clear" "屋顶通关！"
string "hud.lives" "生命"
string "hud.pause" "暂停"
string "hud.jump" "跳跃"
string "pause.title" "已暂停"
string "pause.resume" "继续"
