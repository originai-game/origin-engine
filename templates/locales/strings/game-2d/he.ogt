type strings
version 1
---
# עברית: templates/game-2d's assets/strings/en.ogt translated (og.i18n).
# og new --lang copies it into a game, adding the locale's font chain and
# direction; every key is the base table's, with the same arguments.
locale "he"
string "hud.level" "הגגות"
string "hud.clear" "הגגות הושלמו!"
string "hud.lives" "חיים"
string "hud.pause" "השהיה"
string "hud.jump" "קפיצה"
string "pause.title" "מושהה"
string "pause.resume" "המשך"
