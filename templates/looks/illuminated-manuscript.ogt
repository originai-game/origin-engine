type look
version 1
---
# Flat colour fields with a dark contour and a warm vignette, as gold-leaf pages.
name "Illuminated manuscript illustration"
ui "paper"
MaterialStyle {
  outlineWidth 2
  outlineColor "#3a2410"
}
Stylise {
  posterize 8
}
PostEffects {
  vignette true
  vignetteIntensity 0.4
  vignetteColor "#4a3418"
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 10 to 16 colours; the preset's 2 px iron-gall line; flat figures,
# never perspective.
ArtPalette {
  maxColors 16
}
ArtLine {
  width 2
  color "#3a2410"
}
ArtCamera {
  projection orthographic
}
