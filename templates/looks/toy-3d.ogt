type look
version 1
---
# Toy pieces on a sunny table: every material satin plastic (the engine's
# plastic surface), every hard edge bevelled round, soft ambient occlusion
# where the pieces meet, colour pushed bright and AgX keeping it from
# clipping.
# Its variants (templates/looks/variants/toy-3d/) build the same pieces of
# voxels, clay, card or a tabletop diorama.
name "Toy 3D"
mood "bright"
ui "cartoon"
MaterialStyle {
  surface plastic
}
RenderSettings {
  toneMapping agx
}
PostEffects {
  saturation 0.35
  contrast 0.1
  ao true
  vignette true
  vignetteIntensity 0.2
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 24 to 48 bright colours; chunky props of 500 to 3k triangles and
# figures under 8k with rounded bevels; simple colour textures.
ArtPalette {
  maxColors 48
}
ArtTexels {
  maxSize 256
}
ArtShape {
  propFaces 3000
  characterFaces 8000
  normals smooth
  bevel 0.05
}
