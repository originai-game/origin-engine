type look
version 1
---
# Anisotropic brush strokes with pigment pooling and a little bleed over the lit scene, on a woven canvas (the engine's @canvas/linen).
name "Painterly 3D"
ui "fantasy"
Stylise {
  paintRadius 3
  paintAnisotropy 0.7
  paintEdgeDarkening 0.4
  paintBleed 0.3
  paintCanvas "@canvas/linen"
  paintCanvasStrength 0.45
}
PostEffects {
  vignette true
  vignetteIntensity 0.25
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: a free palette graded by a LUT; 10k to 30k triangles; hand-painted
# at up to 1 texel per screen pixel on 250 px characters.
ArtTexels {
  density 128
}
ArtShape {
  characterFaces 30000
}
