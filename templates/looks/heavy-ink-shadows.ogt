type look
version 1
---
# Cel bands with near-black shadows, thick ink and three tones.
name "Heavy ink and shadow"
ui "fantasy"
MaterialStyle {
  toon true
  shadowTint "#000000"
  shadowTintAmount 0
}
Stylise {
  ink true
  inkThreshold 0.1
  inkWidth 2
  posterize 3
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 12 to 24 muted colours plus black; a rough 3 to 6 px black line (its
# middle); 2k to 10k triangles.
ArtPalette {
  maxColors 25
}
ArtShape {
  characterFaces 10000
}
ArtLine {
  width 4.5
  color "#000000"
}
