type look
version 1
---
# Soft strokes that bleed into each other and pool at their rims on cold-pressed paper (the engine's @canvas/watercolor), a bright exposure.
name "Watercolor washes"
ui "paper"
Stylise {
  paintRadius 3
  paintAnisotropy 0.4
  paintEdgeDarkening 0.8
  paintBleed 0.8
  paintCanvas "@canvas/watercolor"
  paintCanvasStrength 0.6
}
RenderSettings {
  exposure 1.15
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 12 to 24 colours, no line (pigment rims instead); soft low shapes;
# washes at 0.5 to 1 texel per screen pixel on 160 px characters.
ArtPalette {
  maxColors 24
}
ArtTexels {
  density 64
}
ArtShape {
  normals smooth
}
