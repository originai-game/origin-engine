type look
version 1
---
# Soft strokes that bleed into each other on cold-pressed paper (the engine's
# @canvas/watercolor), then the watercolour wash: pigment pooled in thin rims
# where the colour regions meet, granulated into the paper's pits, patchy
# with turbulence, the paper's tooth left bare under the lightest washes and
# every edge wavering with the relief, a bright exposure.
name "Watercolor washes"
mood "soft"
ui "storybook"
Stylise {
  paintRadius 3
  paintAnisotropy 0.4
  paintEdgeDarkening 0.25
  paintBleed 0.8
  paintCanvas "@canvas/watercolor"
  paintCanvasStrength 0.15
  watercolorEdgeDarkening 0.4
  watercolorGranulation 0.3
  watercolorTurbulence 0.4
  watercolorDryBrush 0.4
  watercolorWobble 1.0
}
RenderSettings {
  exposure 1.15
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 12 to 24 colours, no line (pigment rims instead); soft low shapes;
# washes at 0.5 to 1 texel per screen pixel on 160 px characters.
ArtPalette {
  maxColors 24
}
ArtTexels {
  density 64
}
ArtShape {
  normals smooth
}
