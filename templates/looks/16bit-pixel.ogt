type look
version 1
---
# A finer grid, eight tones per channel through a gentle Bayer 4 dither: the
# frame's quantise holds anything to the look, while art the cook conformed
# (64 colours in 6-step ramps, ArtPalette) keeps its own colours.
name "16-bit-inspired pixel art"
mood "bright"
ui "pixel"
antialias off
Stylise {
  pixelHeight 224
  pixelSnap true
  posterize 8
  dither bayer4
  ditherStrength 0.5
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 32 to 64 colours in 4- to 6-step ramps; 32 to 48 px characters on 16
# x 16 tiles at the preset's 224 lines; a 1-pixel dark line inside the sprite.
ArtPalette {
  maxColors 64
  rampSteps 6
}
ArtPixels {
  unit 16
  logicalHeight 224
  spriteSizes 16 32 48
  rotation cleanEdge
  snap true
}
ArtLine {
  width 1
  place inside
}
ArtCamera {
  projection orthographic
  pixelPerfect true
}
