type look
version 1
---
# AgX at lower exposure, grey fog and a strong vignette: a lit stage.
name "Muted theatrical lighting"
ui "scifi"
RenderSettings {
  toneMapping agx
  exposure 0.8
}
PostEffects {
  vignette true
  vignetteIntensity 0.5
}
Fog {
  enabled true
  color "#6a6a70"
  density 0.02
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: greys and one accent with no palette yet; simplified 2k to 10k
# triangles.
ArtShape {
  characterFaces 10000
}
