type look
version 1
---
# A pixel grid over a 3D set with sprites snapped to it, and a tilt-shift depth of field (give the sprites SpriteDesc.dropShadow or Sprite.dropShadow for shadows along the sun).
name "Pixel sprites in 3D worlds"
ui "fantasy"
antialias off
Stylise {
  pixelHeight 240
  pixelSnap true
  posterize 10
  dither bayer4
}
PostEffects {
  depthOfField true
  dofFocusDistance 10
  dofFocusRange 3
  dofMaxBlur 0.01
  dofQuality low
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: sprites of 32 to 64 colours, 48 to 64 px characters on one pixel
# size at 240 lines, nearest-filtered; set pieces of 2k to 20k triangles.
ArtPalette {
  maxColors 64
}
ArtPixels {
  unit 32
  logicalHeight 240
  spriteSizes 48 64
  rotation cleanEdge
  snap true
}
ArtShape {
  propFaces 20000
}
ArtCamera {
  projection perspective
}
