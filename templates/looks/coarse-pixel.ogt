type look
version 1
---
# Very few, very large pixels and four tones: the frame's quantise holds
# anything to the look, while art the cook conformed (16 colours, ArtPalette)
# keeps its own colours, so its far layer is not flattened into one mass.
name "Coarse minimal pixel art"
ui "pixel"
antialias off
Stylise {
  pixelHeight 90
  pixelSnap true
  posterize 4
  dither none
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 6 to 16 colours; 6 to 12 px characters at 90 lines; no outline.
ArtPalette {
  maxColors 16
}
ArtPixels {
  unit 8
  logicalHeight 90
  spriteSizes 6 8 12
  rotation nearest
  snap true
}
ArtCamera {
  projection orthographic
  pixelPerfect true
}
