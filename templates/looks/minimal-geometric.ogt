type look
version 1
---
# Flat facets and six clean tones, nothing else; the tones step value and tint
# apart (posterizeMode tone), so a mood moves a colour's value, never its hue.
name "Minimal geometric color"
mood "soft"
ui "default"
MaterialStyle {
  flatShading true
}
Stylise {
  posterize 6
  posterizeMode tone
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 3 to 6 colours; geometric primitives with flat faces.
ArtPalette {
  maxColors 6
}
ArtShape {
  normals flat
}
