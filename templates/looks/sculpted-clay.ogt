type look
version 1
---
# Soft rim light, a touch of grain and painterly smoothing: handmade surfaces (set AnimationPlayer.stepFps 12 on the characters for stop motion on twos).
name "Sculpted clay & stop-motion"
ui "cartoon"
MaterialStyle {
  rimIntensity 0.1
  rimPower 2.5
  rimColor "#fff2e0"
  # The engine's clay: lumps and thumb dents, warm wrapped light, matte.
  surface clay
}
Stylise {
  paintRadius 2
  paintAnisotropy 0.2
}
PostEffects {
  filmGrain 0.03
  ao true
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: characters 3k to 15k triangles, props 500 to 5k, blunt bevelled
# forms; stop motion on twos.
ArtShape {
  propFaces 5000
  characterFaces 15000
  normals smooth
  # Blunt edges at a radius that reads at play distance.
  bevel 0.05
}
ArtMotion {
  stepFps 12
}
