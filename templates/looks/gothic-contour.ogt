type look
version 1
---
# Thick ink contours, tinted shadows and a dark vignette. No posterize:
# rounding each channel on its own crushes the blue-grey haze into flat
# grey and violet bands (tests/evidence/art/samples/NOTES.md).
name "Gothic ornamental linework"
ui "fantasy"
Stylise {
  ink true
  inkThreshold 0.08
  inkWidth 2
}
MaterialStyle {
  shadowTint "#1a1030"
  shadowTintAmount 0.6
}
PostEffects {
  vignette true
  vignetteIntensity 0.6
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: a cool desaturated base whose accents have no palette yet; the
# preset's 2 px clean contour.
ArtLine {
  width 2
}
