type look
version 1
---
# Early-console 3D: a low grid, vertices snapped to it, affine textures, a coarse depth buffer, sixteen tones.
name "Low-resolution retro 3D"
ui "scifi"
antialias off
Stylise {
  pixelHeight 240
  vertexSnap 2
  affineTexturing 1
  depthBits 12
  posterize 16
  dither bayer2
}
Fog {
  enabled true
  color "#5a6070"
  density 0.03
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: dithered gradients; 64 to 256 px nearest-filtered textures (about 64
# texels per metre on a 2 m model) at 240 lines; characters 300 to 1000
# triangles, props under 300.
ArtPalette {
  dither bayer2
}
ArtPixels {
  logicalHeight 240
}
ArtTexels {
  density 64
  maxSize 256
  filter nearest
  mips none
}
ArtShape {
  propFaces 300
  characterFaces 1000
}
ArtCamera {
  projection perspective
}
