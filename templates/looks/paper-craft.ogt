type look
version 1
---
# Flat facets with a fine contour, twelve tones, ambient occlusion in the folds and a paper grain over all of it (the engine's @canvas/paper).
name "Folded paper & papercraft"
ui "paper"
MaterialStyle {
  flatShading true
  outlineWidth 1
  outlineColor "#5a4a3a"
}
Stylise {
  posterize 12
  paintCanvas "@canvas/paper"
  paintCanvasStrength 0.5
}
PostEffects {
  ao true
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 8 to 16 paper colours; characters of 200 to 600 triangles, props
# under 2k, planar folds; no line (folds and shadows).
ArtPalette {
  maxColors 16
}
ArtShape {
  propFaces 2000
  characterFaces 600
  normals flat
}
