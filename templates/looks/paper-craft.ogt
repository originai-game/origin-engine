type look
version 1
---
# Flat facets with a fine contour, ambient occlusion in the folds, the engine's paper surface on every material and a paper grain over all of it (the engine's @canvas/paper). No posterize: its per-channel rounding turns near-neutral card colours another hue.
name "Folded paper & papercraft"
ui "paper"
MaterialStyle {
  flatShading true
  outlineWidth 1
  outlineColor "#5a4a3a"
  # The engine's paper: fibre grain in the colour and the normal, fully rough.
  surface paper
}
Stylise {
  paintCanvas "@canvas/paper"
  paintCanvasStrength 0.5
}
PostEffects {
  ao true
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 8 to 16 paper colours; characters of 200 to 600 triangles, props
# under 2k, planar folds; no line (folds and shadows).
ArtPalette {
  maxColors 16
}
ArtShape {
  propFaces 2000
  characterFaces 600
  normals flat
}
