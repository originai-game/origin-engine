type model
version 1
---
# paper-craft's version: the far layer as cut card (og-model §5, paper
# fold): four sheets of card stood one behind the other, each a hill line
# cut along a spline, so each casts its contact shadow on the one behind;
# the village folded from boxes and four-sided roofs.
material "far-card" {
  color 0.3 0.36 0.42
  roughness 1
}
material "mid-card" {
  color 0.25 0.36 0.24
  roughness 1
}
material "near-card" {
  color 0.18 0.3 0.15
  roughness 1
}
material "wall" {
  color 0.82 0.77 0.66
  roughness 1
}
material "roof" {
  color 0.62 0.27 0.18
  roughness 1
}
part "sheet-far" {
  material "far-card"
  position 0 0 -9
  extrudeGeometry {
    shape {
      moveTo -30 -3
      lineTo -30.0 2.52
      splineThru -25.0 2.88 -20.0 4.66 -15.0 6.91 -10.0 5.77 -5.0 3.62 0.0 4.13 5.0 6.79 10.0 7.92 15.0 5.75 20.0 5.28 25.0 4.03 30.0 2.55
      lineTo 30 -3
      closePath
    }
    depth 0.12
    bevelEnabled false
    curveSegments 4
  }
}
part "sheet-back" {
  material "mid-card"
  position 0 0 -6
  extrudeGeometry {
    shape {
      moveTo -28 -3
      lineTo -28.0 1.5
      splineThru -22.4 1.51 -16.8 1.91 -11.2 4.13 -5.6 4.48 0.0 2.15 5.6 2.23 11.2 4.06 16.8 4.06 22.4 2.21 28.0 1.55
      lineTo 28 -3
      closePath
    }
    depth 0.12
    bevelEnabled false
    curveSegments 4
  }
}
part "sheet-mid" {
  material "near-card"
  position 0 0 -2.5
  extrudeGeometry {
    shape {
      moveTo -26 -3
      lineTo -26.0 0.6
      splineThru -20.8 0.6 -15.6 0.66 -10.4 1.37 -5.2 2.91 0.0 2.14 5.2 0.85 10.4 1.18 15.6 2.59 20.8 1.4 26.0 0.64
      lineTo 26 -3
      closePath
    }
    depth 0.12
    bevelEnabled false
    curveSegments 4
  }
}
part "sheet-near" {
  material "mid-card"
  position 0 0 1.8
  extrudeGeometry {
    shape {
      moveTo -24 -3
      lineTo -24.0 -0.48
      splineThru -19.2 0.46 -14.4 0.84 -9.6 -0.29 -4.8 -0.58 0.0 -0.4 4.8 0.3 9.6 0.52 14.4 -0.22 19.2 -0.56 24.0 -0.6
      lineTo 24 -3
      closePath
    }
    depth 0.12
    bevelEnabled false
    curveSegments 4
  }
}
part "house" {
  material "wall"
  boxGeometry {
    width 1.6
    height 1.2
    depth 1.2
  }
  at {
    position 4 1.6 0
  }
  at {
    position 6.2 1.4 0.6
  }
  at {
    position 2 1.3 1
  }
}
part "roof" {
  material "roof"
  coneGeometry {
    radius 1.2
    height 0.9
    radialSegments 4
  }
  at {
    position 4 2.65 0
    quaternion 0 0.3827 0 0.9239
  }
  at {
    position 6.2 2.45 0.6
    quaternion 0 0.3827 0 0.9239
  }
  at {
    position 2 2.35 1
    quaternion 0 0.3827 0 0.9239
  }
}
part "tower" {
  material "wall"
  position 5 2.4 -0.6
  boxGeometry {
    width 0.7
    height 3
    depth 0.7
  }
}
