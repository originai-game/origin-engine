type model
version 1
---
# paper-craft's version: the ground as sheets of card, not one plane: the
# table card, and over it a cut sheet the scene stands on whose edge is
# the card's thickness, with its contact shadow on the sheet below.
material "table-card" {
  color 0.2 0.32 0.15
  roughness 1
}
material "path-card" {
  color 0.3 0.44 0.2
  roughness 1
}
material "sand-card" {
  color 0.6 0.46 0.28
  roughness 1
}
part "table" {
  material "table-card"
  position 0 -0.02 0
  boxGeometry {
    width 40
    height 0.04
    depth 40
  }
}
part "plateau" {
  material "path-card"
  position 0 0.06 0
  quaternion -0.7071068 0 0 0.7071068
  extrudeGeometry {
    shape {
      moveTo -6 -4
      splineThru -2 -5.5 3 -4.8 6.5 -3 7 1.5 4 4 -1 3.6 -5.5 4.2 -7.5 0.5
      closePath
    }
    depth 0.06
    bevelEnabled false
    curveSegments 6
  }
}
part "path" {
  material "sand-card"
  position 0 0.12 0
  quaternion -0.7071068 0 0 0.7071068
  extrudeGeometry {
    shape {
      moveTo -1.2 4
      splineThru -0.2 1.5 0.9 -0.6 2.6 -1.6 4.5 -2.4
      lineTo 4.8 -1.4
      splineThru 2.9 -0.5 1.8 0.6 0.9 2.2 0.4 4
      closePath
    }
    depth 0.02
    bevelEnabled false
    curveSegments 6
  }
}
