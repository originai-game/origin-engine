type look
version 1
---
# Flat cel shading with thick outlines, no shadows to speak of: the cel
# bands are the toon material's, the flat fills the art's. No Stylise
# posterize: it rounds each channel on its own, so a sepia print's close
# channels land on different steps and turn olive and pink (at 4 tones,
# still visibly at 8; tests/evidence/art/samples/NOTES.md).
name "Rubber-hose animation"
ui "cartoon"
MaterialStyle {
  toon true
  outlineWidth 3
  outlineColor "#101010"
  shadowTint "#ffffff"
  shadowTintAmount 1
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 12 to 24 colours; the preset's 3 px ink line; drawn at 24 fps and
# played on twos, constant squash and stretch.
ArtPalette {
  maxColors 24
}
ArtLine {
  width 3
  color "#101010"
}
ArtMotion {
  stepFps 12
  squash 1
}
