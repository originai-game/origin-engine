type look
version 1
---
# Flat cel shading with thick outlines and four tones, no shadows to speak of.
name "Rubber-hose animation"
ui "cartoon"
MaterialStyle {
  toon true
  outlineWidth 3
  outlineColor "#101010"
  shadowTint "#ffffff"
  shadowTintAmount 1
}
Stylise {
  posterize 4
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 12 to 24 colours; the preset's 3 px ink line; drawn at 24 fps and
# played on twos, constant squash and stretch.
ArtPalette {
  maxColors 24
}
ArtLine {
  width 3
  color "#101010"
}
ArtMotion {
  stepFps 12
  squash 1
}
