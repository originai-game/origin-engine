type look
version 1
---
# Visible facets, broad colour fields, a soft vignette and AgX.
name "Faceted low-poly"
ui "paper"
MaterialStyle {
  flatShading true
}
RenderSettings {
  toneMapping agx
}
PostEffects {
  vignette true
  vignetteIntensity 0.3
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 16 to 32 colours, one per material; characters 300 to 1500
# triangles, props 50 to 500, flat facets; no textures beyond one small
# palette texture.
ArtPalette {
  maxColors 32
}
ArtTexels {
  maxSize 64
  filter nearest
  mips none
}
ArtShape {
  propFaces 500
  characterFaces 1500
  normals flat
}
