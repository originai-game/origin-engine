type look
version 1
---
# A tall grid with twelve-tone ramps and a fine dither.
name "Densely detailed pixel art"
ui "fantasy"
antialias off
Stylise {
  pixelHeight 270
  pixelSnap true
  posterize 12
  dither bayer8
  ditherStrength 0.6
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 48 to 128 colours; 32 to 64 px characters at the preset's 270 lines;
# lines selective and coloured, so not fixed.
ArtPalette {
  maxColors 128
}
ArtPixels {
  unit 32
  logicalHeight 270
  spriteSizes 32 48 64
  rotation cleanEdge
  snap true
}
ArtCamera {
  projection orthographic
  pixelPerfect true
}
