type look
version 1
---
# A tilt-shift depth of field, a vignette and AgX: a tabletop model.
name "Miniature dioramas"
ui "cartoon"
PostEffects {
  depthOfField true
  dofFocusDistance 12
  dofFocusRange 2.5
  dofMaxBlur 0.014
  dofQuality high
  vignette true
  vignetteIntensity 0.35
}
RenderSettings {
  toneMapping agx
}
# Toy pieces: satin plastic or painted wood, a little more colour.
MaterialStyle {
  surface plastic
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 24 to 48 soft pastels; buildings of 500 to 3k triangles with rounded
# bevels; simple colour textures.
ArtPalette {
  maxColors 48
}
ArtTexels {
  maxSize 256
}
ArtShape {
  propFaces 3000
  normals smooth
  # Rounded edges at a radius that reads from the table's height.
  bevel 0.05
}
