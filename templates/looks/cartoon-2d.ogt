type look
version 1
---
# Flat cartoon colour: a few clean tones a material, stepped in value only
# (posterize in tone mode keeps a hue from drifting), a dark warm contour
# round every sprite and a soft vignette. Its variants
# (templates/looks/variants/cartoon-2d/) wash it in watercolour, ornament it
# as a storybook or ink it as a rubber-hose cartoon.
name "Cartoon 2D"
mood "bright"
ui "cartoon"
Stylise {
  posterize 10
  posterizeMode tone
}
PostEffects {
  vignette true
  vignetteIntensity 0.2
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 16 to 32 colours in ramps of three; a 2 px dark warm line round
# every sprite; characters 96 to 160 px.
ArtPalette {
  maxColors 32
  rampSteps 3
}
ArtLine {
  width 2
  color "#2a1a10"
  place outside
}
ArtCamera {
  projection orthographic
}
