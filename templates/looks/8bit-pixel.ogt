type look
version 1
---
# A coarse grid, no antialiasing, four tones per channel and no dither, so
# fields stay flat and gradients step in bands, as NES art does (a Bayer
# dither, however narrow, turned a floor whose tone sat on a step into a
# checker): the frame's quantise holds anything to the look, while art
# the cook conformed (16 colours in 4-step ramps, ArtPalette) keeps its own
# colours, so its flat fields stay flat instead of turning to a checker.
name "8-bit-inspired pixel art"
mood "bright"
ui "pixel"
antialias off
Stylise {
  pixelHeight 192
  pixelSnap true
  posterize 4
  dither none
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 8 to 16 colours in 3- or 4-step ramps; 16 x 16 to 16 x 24 characters
# on 8 or 16 px tiles at the preset's 192 lines; no rotated sprites, no sub-
# pixel movement.
ArtPalette {
  maxColors 16
  rampSteps 4
}
ArtPixels {
  unit 16
  logicalHeight 192
  spriteSizes 8 16 24
  rotation nearest
  snap true
}
ArtCamera {
  projection orthographic
  pixelPerfect true
}
