type look
version 1
---
# Cel shading, heavy outlines, ink marks hatched on the surfaces (strokes that follow the form, darken the shadows and gather along the contours) and ink on every edge.
name "Inked comic-book 3D"
ui "scifi"
MaterialStyle {
  toon true
  outlineWidth 3
  outlineDistance 8
  outlineColor "#0a0810"
}
Stylise {
  hatching 0.45
  hatchingScale 5
  hatchingLevels 3
  hatchingAngle 30
  hatchingColor "#0a0810"
  hatchingSpace surface
  hatchingDepth 0.7
  ink true
  inkThreshold 0.15
  inkWidth 1.5
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: a free, saturated palette; 10k to 30k triangles; the preset's 3 px
# ink line, thinning with distance; hand-inked at 1 texel per screen pixel on
# 300 px characters.
ArtTexels {
  density 128
}
ArtShape {
  characterFaces 30000
}
ArtLine {
  width 3
  color "#0a0810"
  distanceFalloff 8
}
