type look
version 1
---
# Cel shading, heavy outlines, ink marks hatched on the surfaces (strokes that follow the form, darken the shadows and gather along the contours) and ink on every edge.
name "Inked comic-book 3D"
mood "high-contrast"
ui "default"
# The UI's seed colours (UiSeeds), so the default style matches the
# scene: print red and yellow over its ink.
uiSeeds {
  primary "#d7263d"
  accent "#ffd23f"
  neutral "#0a0810"
}
MaterialStyle {
  toon true
  outlineWidth 3
  outlineDistance 8
  outlinePlace outside
  outlineColor "#0a0810"
}
Stylise {
  hatching 0.45
  hatchingScale 5
  hatchingLevels 3
  hatchingAngle 30
  hatchingColor "#0a0810"
  hatchingSpace surface
  hatchingDepth 0.7
  hatchingKeepColor true
  ink true
  inkThreshold 0.15
  inkWidth 1.5
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: a free, saturated palette; 10k to 30k triangles; the preset's 3 px
# ink line, thinning with distance; hand-inked at 1 texel per screen pixel on
# 300 px characters. Props are held to the same 30k, and no texture is
# longer than 2048 texels (1 texel per screen pixel on a model filling a
# 1080-line frame).
# The palette is free (the catalogue's), so it states no colours: measure
# reports the palette facts absent, never against invented colours.
ArtTexels {
  density 128
  maxSize 2048
}
ArtShape {
  propFaces 30000
  characterFaces 30000
}
ArtLine {
  width 3
  color "#0a0810"
  distanceFalloff 8
}
