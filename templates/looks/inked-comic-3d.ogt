type look
version 1
---
# Cel shading, heavy outlines, ink marks hatched on the surfaces (strokes that follow the form, darken the shadows and gather along the contours) and ink on every edge.
name "Inked comic-book 3D"
ui "scifi"
MaterialStyle {
  toon true
  outlineWidth 3
  outlineDistance 8
  outlineColor "#0a0810"
}
Stylise {
  hatching 0.45
  hatchingScale 5
  hatchingLevels 3
  hatchingAngle 30
  hatchingColor "#0a0810"
  hatchingSpace surface
  hatchingDepth 0.7
  ink true
  inkThreshold 0.15
  inkWidth 1.5
}
