type look
version 1
---
# Bright outlines that bloom: glowing tubes on a dark scene.
name "Neon vector-like graphics"
ui "neon"
MaterialStyle {
  outlineWidth 2
  outlineColor "#40f0ff"
}
RenderSettings {
  bloom true
  bloomThreshold 0.6
  bloomIntensity 1.2
  toneMapping agx
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: black plus 2 to 4 saturated hues; the line is the shape (geometry,
# not an outline).
ArtPalette {
  maxColors 5
}
