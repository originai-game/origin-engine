type look
version 1
---
# Two depth bands: black figures on terracotta, with ink contours.
name "Black-figure pottery"
ui "fantasy"
Stylise {
  depthBands 2
  depthBandsNear 2
  depthBandsFar 25
  depthBandsNearColor "#100c08"
  depthBandsFarColor "#b0552a"
  depthBandsFlatten 1
  ink true
  inkThreshold 0.2
  inkWidth 1
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 2 to 4 colours; incised 1 px lines inside the figures in the
# ground's colour; never perspective depth.
ArtPalette {
  maxColors 4
}
ArtLine {
  width 1
  color "#b0552a"
  place inside
}
ArtCamera {
  projection orthographic
}
