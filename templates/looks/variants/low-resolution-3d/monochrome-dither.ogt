type look
version 1
---
# A low grid, two tones per channel through a Bayer 8 dither, every pixel black or white (the engine's @palettes/1bit): true 1-bit.
# The monochrome-dither variant of low-resolution-3d (`variant "monochrome-dither"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Monochrome dithered 3D"
mood "high-contrast"
Stylise {
  posterize 2
  palette "@palettes/1bit"
  dither bayer8
  vertexSnap 0
  affineTexturing 0
  depthBits 0
}
Fog {
  enabled false
  color 0.62 0.68 0.76
  density 0.02
}
Sky {
  enabled false
  zenith 0.18 0.36 0.78
  horizon 0.78 0.84 0.92
  ground 0.16 0.14 0.12
}
ArtPalette {
  colors "@palettes/1bit"
  maxColors 4
  dither bayer8
}
ArtTexels {
  density 0
  maxSize 0
  filter any
  mips any
}
ArtShape {
  characterFaces 10000
  propFaces 0
}
RenderSettings {
  toneMapping none
}
