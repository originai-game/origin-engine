type look
version 1
---
# Flat faces with ambient occlusion in the corners (.vox models cook to flat-shaded meshes).
# The voxel variant of toy-3d (`variant "voxel"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Voxel worlds"
MaterialStyle {
  flatShading true
  surface none
}
RenderSettings {
  toneMapping aces
}
PostEffects {
  aoIntensity 1.2
  vignette false
  vignetteIntensity 0.35
}
ArtPalette {
  maxColors 64
}
ArtTexels {
  filter nearest
  mips none
  maxSize 0
}
ArtShape {
  propFaces 5000
  characterFaces 5000
  normals flat
  voxel 0.1
  bevel 0
}
