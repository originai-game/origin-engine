type look
version 1
---
# A tilt-shift depth of field, a vignette and AgX: a tabletop model.
# The diorama variant of toy-3d (`variant "diorama"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Miniature dioramas"
PostEffects {
  depthOfField true
  dofFocusDistance 12
  dofFocusRange 2.5
  dofMaxBlur 0.014
  dofQuality high
  vignetteIntensity 0.35
  ao false
}
ArtShape {
  characterFaces 0
}
