type look
version 1
---
# Cel shading with thick outlines, ink on every edge and six flat tones, the
# shade printed as four-colour process dots a pixel out of register.
# The bold-comic variant of inked-comic-3d (`variant "bold-comic"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Bold comic illustration"
MaterialStyle {
  outlineDistance 0
  outlinePlace inside
}
Stylise {
  inkThreshold 0.12
  posterize 6
  halftone 0.7
  halftoneMode cmyk
  halftoneSize 5
  halftoneRegion shade
  halftoneMisregistration 1
  hatching 0
  hatchingScale 6
  hatchingLevels 4
  hatchingAngle 45
  hatchingColor 0.04 0.035 0.03
  hatchingSpace screen
  hatchingDepth 0
  hatchingKeepColor false
}
ArtShape {
  characterFaces 20000
  normals smooth
}
ArtLine {
  distanceFalloff 0
}
ArtPalette {
  maxColors 40
}
