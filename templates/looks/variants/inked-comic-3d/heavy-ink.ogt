type look
version 1
---
# Cel bands whose dark side and cast shadows are solid black ink
# (MaterialStyle.shadowDarkness 1: no sun and no ambient light there), thick
# ink, six muted tones (value and tint stepped apart, so a mood never turns
# the drained hills pastel), a near-black sky and a blood-red haze.
# The heavy-ink variant of inked-comic-3d (`variant "heavy-ink"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Heavy ink and shadow"
mood "dark"
MaterialStyle {
  shadowDarkness 1
  outlineWidth 0
  outlineDistance 0
  outlinePlace inside
  outlineColor 0.02 0.02 0.03
}
Stylise {
  inkThreshold 0.1
  inkWidth 2
  posterize 6
  posterizeMode tone
  hatching 0
  hatchingScale 6
  hatchingLevels 4
  hatchingAngle 45
  hatchingColor 0.04 0.035 0.03
  hatchingSpace screen
  hatchingDepth 0
  hatchingKeepColor false
}
ArtTexels {
  density 0
}
ArtShape {
  characterFaces 10000
}
ArtLine {
  width 4.5
  color "#000000"
  distanceFalloff 0
}
Sky {
  enabled true
  zenith 0.01 0.01 0.012
  horizon 0.12 0.03 0.025
  ground 0.01 0.01 0.01
}
Fog {
  enabled true
  color "#3a0a08"
  density 0.03
}
PostEffects {
  saturation -0.6
  contrast 0.25
  vignette true
  vignetteIntensity 0.6
}
ArtPalette {
  maxColors 25
}
