type look
version 1
---
# Ten flat tones with a fine dark contour and a soft vignette.
# The storybook variant of cartoon-2d (`variant "storybook"`): only what it changes of
# the preset, a field it turns off written at its default.
name "Decorative storybook illustration"
mood "soft"
PostEffects {
  vignetteIntensity 0.3
}
ArtPalette {
  rampSteps 0
}
MaterialStyle {
  outlineWidth 2
  outlineColor "#2a1a10"
}
ArtShape {
  normals flat
}
