type look
version 1
---
# Smoothed strokes with pooled edges, AgX, a dark vignette and grain: varnished canvas.
name "Old-master painting collage"
ui "paper"
Stylise {
  paintRadius 3
  paintEdgeDarkening 0.5
}
RenderSettings {
  toneMapping agx
  exposure 0.9
}
PostEffects {
  vignette true
  vignetteIntensity 0.5
  filmGrain 0.025
}
# The art contract (docs/art.md §2.1): none; the catalogue fixes no number (the
# source paintings' own palette, cut edges, scans at 1x): the art is authored.
