type model
version 1
---
# A flat field of one colour for looks that voxelise the set (toy-3d's voxel
# variant): the rolling meadow is past a prop's face budget at 0.1 m cubes,
# so the cook doubles its cube edge and the land rises over the props; one
# flat colour meshes greedily into a few faces and keeps its height.
material "grass" {
  color 0.24 0.42 0.16
  roughness 1
}
part "field" {
  material "grass"
  quaternion -0.7071068 0 0 0.7071068
  planeGeometry {
    width 40
    height 40
  }
}
