type look
version 1
---
# Wide anisotropic strokes, heavy pigment pooling and bleed, a lifted exposure.
name "Expressionist painting"
ui "paper"
Stylise {
  paintRadius 5
  paintAnisotropy 0.9
  paintEdgeDarkening 0.7
  paintBleed 0.5
}
RenderSettings {
  exposure 1.1
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: the palette is free (3 to 5 masses a scene) and the edges are paint,
# so neither is fixed; portraits up to 1024 px painted at 1.5x.
ArtTexels {
  maxSize 2048
}
