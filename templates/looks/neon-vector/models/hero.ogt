type model
version 1
---
# neon-vector's version (tools/art-samples/neon.py): black faces, glowing hues.
# The lantern keeper (og-model §5): a hooded traveller carrying a lit lamp,
# about 1.8 m, facing +Z, its feet on y = 0. Moderate counts: the look's
# ArtShape decides the facets, voxels or bevel at cook time.
material "coat" {
  color 0.02 0.02 0.04
  roughness 1
  emissive 0.1 0.9 1
  emissiveIntensity 0.6
}
material "skin" {
  color 0.02 0.02 0.04
  roughness 1
  emissive 1 0.3 0.8
  emissiveIntensity 0.6
}
material "boot" {
  color 0.02 0.02 0.04
  roughness 1
  emissive 0.1 0.9 1
  emissiveIntensity 0.6
}
material "iron" {
  color 0.02 0.02 0.04
  roughness 1
  emissive 0.1 0.9 1
  emissiveIntensity 0.6
}
material "flame" {
  color 0.02 0.02 0.04
  roughness 1
  emissive 1 0.3 0.8
  emissiveIntensity 0.6
}
part "leg-left" {
  material "boot"
  position -0.12 0.3 0
  capsuleGeometry {
    radius 0.09
    height 0.45
    radialSegments 12
  }
}
