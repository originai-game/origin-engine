type look
version 1
---
# Five depth bands tinted from a dark foreground to a glowing distance, with bloom.
name "Luminous layered environments"
ui "fantasy"
Stylise {
  depthBands 5
  depthBandsNear 3
  depthBandsFar 60
  depthBandsNearColor "#1a1430"
  depthBandsFarColor "#ffd9a0"
  depthBandsFlatten 0.6
}
RenderSettings {
  bloom true
  bloomIntensity 0.5
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: dark masses and luminous accents, no fixed palette; at most a 1 px
# line, so not fixed; 3D props of 2k to 10k triangles.
ArtShape {
  propFaces 10000
}
