type look
version 1
---
# Thin ink on every edge, light hatching in the shadows that keeps their
# colour, and six tones, with no tone curve (a flat illustration, as
# rubber-hose): art the cook conformed (eight colours, ArtPalette) reaches
# the frame as drawn and keeps its colours, so its pale sky and tints stay.
name "Fine-line doodle worlds"
ui "storybook"
Stylise {
  ink true
  inkThreshold 0.1
  inkWidth 1
  hatching 0.5
  hatchingLevels 2
  hatchingScale 5
  hatchingKeepColor true
  posterize 6
}
RenderSettings {
  toneMapping none
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: 4 to 8 light colours (or one ink); the preset's 1 px ink line.
ArtPalette {
  maxColors 8
}
ArtLine {
  width 1
}
