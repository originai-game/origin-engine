type look
version 1
---
# Six flat depth bands from a dark foreground to a pale distance.
name "Layered silhouettes"
ui "neon"
Stylise {
  depthBands 6
  depthBandsNear 3
  depthBandsFar 50
  depthBandsNearColor "#141028"
  depthBandsFarColor "#c8d8ec"
  depthBandsFlatten 1
}
# The art contract (docs/art.md §2.1), from the catalogue entry's palette and
# assets: one hue in 4 to 6 values: at most 6 colours, a 6-step ramp; no line.
ArtPalette {
  maxColors 6
  rampSteps 6
}
