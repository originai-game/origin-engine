type scene
version 1
---
# The baked station's Cornell box (src/light.ts): the box is a static
# model, so `og bake lightmaps` gives it a lightmap of the light bounced
# between its walls (red and green bleeding onto the white); the probes
# light the ball that rolls through it. The ceiling spot's direct term and
# its shadows are drawn every frame; the ceiling itself is lit by bounces.
name "Cornell"
entity "cornell-box" {
  model "models/cornell.glb"
  static true
  Transform {
    position 4000 0 0
    quaternion 0 0 0 1
    scale 1 1 1
  }
}
entity "cornell-light" {
  Transform {
    position 4000 1.96 0.1
    quaternion -0.7071068 0 0 0.7071068
    scale 1 1 1
  }
  SpotLight {
    color 1 0.9 0.78
    intensity 6
    distance 8
    angle 1.15
    penumbra 0.35
    castShadow true
  }
}
entity "cornell-probes" {
  Transform {
    position 4000 1 0
    quaternion 0 0 0 1
    scale 1 1 1
  }
  LightVolume {
    size 1.9 1.9 1.9
    spacing 0.3
  }
}
