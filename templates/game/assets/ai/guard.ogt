type behaviour
version 1
---
# The guard's state machine (og.ai; every node is in the og-ai skill). It
# patrols its post until it sees the trickster in its view cone, raises the
# alarm (the game's `alarm` command) and chases; when it loses sight it
# searches where it last saw it for 3 seconds, then goes back to its post.
name "guard"
route post {
  point -6 0 -3
  point -6 0 4
  point -1 0 6
}
machine {
  initial patrol
  state patrol {
    patrol post {
      wait 1
      speed 1.5
    }
    to alert {
      check sees
    }
  }
  state alert {
    enter {
      command alarm
    }
    chase {
      speed 3
      reach 1.5
    }
    to search {
      check sees is false
    }
  }
  state search {
    move_to lastSeen {
      speed 2
    }
    to alert {
      check sees
    }
    to patrol {
      after 3
    }
  }
}
