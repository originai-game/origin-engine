type strings
version 1
---
# The template's strings (og.i18n, og-i18n §1): every word the screens show
# is a key here, never a literal in a system. This is the base table, in
# the game's source language; a locale is its own file beside it
# (`zh-CN.ogt`, with the same keys and its `fonts` line), loaded in `start`.
locale "en"
base true
string "menu.title" "Origin Engine"
string "menu.prompt" "Press Start to begin"
string "menu.start" "Start"
string "hud.cells" "Cells {n}/{total}"
string "hud.seat" "Player {n}"
string "hud.pause" "Pause"
string "hud.jump" "Jump"
string "hud.run" "Run"
string "hud.goal" "Gather the power cells, then stand on the pad under the dropship"
string "hud.ready" "Every cell is in: get to the pad!"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
string "settings.title" "Settings"
string "settings.master" "Volume"
string "settings.effects" "Effects"
string "settings.language" "Language"
string "settings.motion" "Reduce motion"
string "settings.done" "Done"
string "lang.en" "English"
string "lang.zh" "简体中文"
string "over.escaped" "Escaped!"
string "over.caught" "Caught!"
string "over.cells" "Cells"
string "over.time" "Time"
string "over.best" "Best"
string "over.grabs" "Grabs"
string "over.again" "Play again"
