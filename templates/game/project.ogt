type project
version 1
---
# The project manifest (docs/design.md §2.5): `og run`, `og build`, `og cook`,
# `og dev` and `og test` read it. `npm create @origingame/game` fills in the
# name and id.
name "Origin Game"
id "origin-game"
# The engine this game is written against (design §9: upgrades are explicit).
engine "0.7.7"
entry "src/main.ts"
# 2d (orthographic camera, sprites, 2D physics) or 3d.
profile "3d"
tick 60
seed 1
scenes {
  main "scenes/main.ogt"
}
scene main
# The look's cook contract (og-build §8) holds every asset; an opt-out keeps
# one as made and `og cook --report` lists it. The dropship is the intro's
# hero set piece: its panels keep it near 4.5k triangles at any silhouette
# error, past faceted-low-poly's 200, so it stays whole as made, and `og
# style check` still names it off the contract: a game replaces it with a
# set piece made for its own look (og-model §5).
conform {
  off "models/dropship.glb"
}
publish {
  # `og build --publish` keeps only the player-facing probe members
  # (hello, tick, state, pick, entity, input, capture).
  probe player
  out "dist"
  # Colour textures cook as etc1s (the default, a quarter of the bytes);
  # `cook { color_textures uastc }` above publish packs them without
  # ETC1S's block loss, and `color_textures etc1s` here keeps the web
  # export (`og build`) at etc1s.
}
