type scene
version 1
---
# The match3 scene: the board, with the round's tuning. `start` in
# src/main.ts gives it its nine-sliced panel and adds the backdrop, the
# checker tilemap, the 49 gems and the selection frame.
name "Main"
entity "board" {
  Transform {
    position 0 -0.4 -2
    quaternion 0 0 0 1
    scale 1 1 1
  }
  # Tune's parameters: edit them here, live with `set:board.Tuning.<field>=<value>`.
  Tuning {
    moves 20
    target 1500
    colours 5
    tileScore 10
    swapTicks 8
    clearTicks 12
    fallSpeed 14
  }
}
