type scene
version 1
---
# The match3 scene: the board, with the round's tuning. `start` in
# src/main.ts adds the sprites: the backdrop, the cells, the 49 tiles and
# the selection frame.
name "Main"
entity "board" {
  Transform {
    position 0 -0.4 -2
    scale 7.5 7.5 1
  }
  # Tune's parameters: edit them here, live with `set:board.Tuning.<field>=<value>`.
  Tuning {
    moves 20
    target 1500
    colours 5
    tileScore 10
    swapTicks 8
    clearTicks 12
    fallSpeed 14
  }
}
