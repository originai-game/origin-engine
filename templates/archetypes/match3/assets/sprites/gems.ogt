type flipbook
version 1
---
# Written by tools/make-assets.py. Clip 2c is colour c's idle loop, 2c + 1 its clear
# burst (src/art.ts relies on that order).
texture "gems.png"
filter linear
pivot 0.5 0.5
grid 80 80 8 6
clip idle_ruby {
  frames 0 1 2 3
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_ruby {
  frames 4 5 6 7
  fps 24
  mode once
  event 1 "burst"
}
clip idle_sky {
  frames 8 9 10 11
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_sky {
  frames 12 13 14 15
  fps 24
  mode once
  event 1 "burst"
}
clip idle_leaf {
  frames 16 17 18 19
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_leaf {
  frames 20 21 22 23
  fps 24
  mode once
  event 1 "burst"
}
clip idle_sun {
  frames 24 25 26 27
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_sun {
  frames 28 29 30 31
  fps 24
  mode once
  event 1 "burst"
}
clip idle_plum {
  frames 32 33 34 35
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_plum {
  frames 36 37 38 39
  fps 24
  mode once
  event 1 "burst"
}
clip idle_coral {
  frames 40 41 42 43
  durations 2.4 0.05 0.06 0.05
  mode loop
}
clip clear_coral {
  frames 44 45 46 47
  fps 24
  mode once
  event 1 "burst"
}
