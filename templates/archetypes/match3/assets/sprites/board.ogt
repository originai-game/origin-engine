type tilemap
version 1
---
# Written by tools/make-assets.py: the 7 x 7 checker under the gems, one world unit a cell;
# src/main.ts places its top-left corner at the board's.
size 7 7
tile 64 64
unit 1
tileset "sprites/cells.ogt"
layer cells {
  z 0
  legend "a" 0
  legend "b" 1
  row "abababa"
  row "bababab"
  row "abababa"
  row "bababab"
  row "abababa"
  row "bababab"
  row "abababa"
}
