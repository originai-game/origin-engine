string "quest.seal" "The Warden's Seal"
string "quest.seal.summary" "The dead walk in Greywatch's yard. Put them down, take the warden's seal from the chest by the crypt door, and bring it to Castellan Maren."
string "quest.seal.risen" "Put down the risen"
string "quest.seal.captain" "Destroy their captain"
string "quest.seal.chest" "Take the seal from the chest"
string "quest.seal.report" "Bring the seal to Maren"
