type style
version 2
---
# Upgraded to version 2 by og style upgrade: its version 1 values kept, the new tokens derived from its palette and scheme (docs/ui.md §12).
name "sparkorb"
scheme dark
atlas "styles/sparkorb/atlas.png" 384 256
scale 1
palette {
  backdrop "#0a0614"
  well "#120a22"
  panel "#1c1232"
  panelHover "#281a46"
  panelRaised "#1c1232"
  line "#4a3470"
  lineStrong "#c9a6ff"
  ink "#fff6e6"
  inkMuted "#e3d4bd"
  inkFaint "#b9a890"
  inkInverse "#140a00"
  control "#3a2a5c"
  controlStrong "#4a3874"
  primary "#ad690a"
  primaryHover "#d98f1f"
  primaryActive "#a8650a"
  onPrimary "#fff6e6"
  primarySoft "#ffb02e28"
  highlight "#ffc35c"
  focus "#ffd27a"
  knob "#5a3aa6"
  hud "#1c1232"
  scrim "#030008cc"
  shadow "#000000aa"
  sheen "#ffffff52"
  success "#3ddc97"
  warn "#ffd23d"
  danger "#f45f80"
  info "#36e8ff"
  health "#3ddc97"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#ad690a"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#4e79a7"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 50 54 0 700 display {
    phonePortrait 40 43
    phoneLandscape 45 49
  }
  title 32 36 0 700 display {
    phonePortrait 28 32
    phoneLandscape 30 34
  }
  heading 22 28 0 600 display
  body 16 21 0 400 body
  label 13 18 0 600 body
  caption 13 18 0 400 body
  numeric 19 24 0 600 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 6
  sm 6
  md 10
  lg 15
  xl 20
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 1 3 0 "#00000033"
  }
  floating {
    shadow 0 4 12 0 "#0000003c"
  }
  overlay {
    shadow 0 0 0 0 "#00000000"
  }
  top {
    shadow 0 0 0 0 "#00000000"
  }
}
shape {
  panel round 10
  dialog round 10
  card round 10
  tooltip round 10
  button round 6
  field round 6
  chip round 6
  badge round 6
  tab round 6
  slot round 6
  bar round 6
  hud round 6
  avatar round 6
}
ramp {
  body 16 21
  meta 13 18
  caption 13 18
  lg 19 24
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 50 54
}
fonts {
  body "styles/sparkorb/Rajdhani-Bold.ttf"
  display "styles/sparkorb/ChakraPetch-BoldItalic.ttf"
  numeric "styles/sparkorb/Orbitron-Medium.ttf"
  cjk "@styles/cjk/NotoSansSC-Bold.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "styles/sparkorb/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
corner 320 104 32 32 20 20 primary 2
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 36 16 primary 0
tile 204 172 64 64 48 48 0.12 10
textGlow display 2.0 primary 0.7
textGlow numeric 1.2 focus 0.5
motion {
  enter pop
  toast slideLeft
  progress 260
  shake 7
  pop 0.16
  spring ui 140 0
  spring panel 220 0
  spring emphasis 380 0.15
  spring playful 520 0.3
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 380
  duration spring 520
  duration bounce 640
  stagger 35
  staggerCap 300
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 22 authored
  shadow 0 0 0 0 "#00000000"
  glow 14 primary 0.18
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 14 tint
  corners
}
dress "Button.base" {
  slice 172 4 48 48 16 tint
  glow 6 primary 0.35
  press 0.96 0.96 0
  hover 0 1.04
}
dress "Button.base[hover]" {
  slice 224 4 48 48 16 tint
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 16 tint
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 16 tint
}
dress "Field.frame" {
  slice 4 104 48 48 10 tint
}
dress "Slot.frame" {
  slice 56 104 48 48 12 tint
  glow 3 focus 0.2
}
dress "Tooltip.frame" {
  slice 108 104 32 32 10 tint
}
dress "Hud.frame" {
  slice 144 104 32 32 14 tint
  glow 4 primary 0.25
}
dress "Meter.track" {
  slice 180 104 32 16 6 tint
}
dress "Meter.fill" {
  slice 216 104 32 16 6 tint
}
