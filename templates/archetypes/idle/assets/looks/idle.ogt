type look
version 1
---
# Spark Orb's look (og-taste §12): the frame's art direction as data, named
# by GameDesc.look in src/main.ts and applied before start runs. It extends
# no preset: a catalogue slug in `extends` (luminous-pixel and neon-vector
# suit a glowing orb) adds that style's treatment under the lines below,
# and the reference frames are then recorded again (OG_FX_CAPTURE=1 og test .).
name "Spark Orb"
# The UI wears the sparkorb style (start keeps it and adds the sounds).
ui "styles/sparkorb/style.ogt"
# The night and the orb are authored colour: not tone mapped, and no light
# from the sky.
RenderSettings {
  toneMapped false
  environmentIntensity 0
}
