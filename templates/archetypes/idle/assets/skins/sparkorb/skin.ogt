type skin
version 1
---
# Spark Orb's skin: the engine's neon style pack (templates/ui-kit/tools/make-skins.py, CC0 art,
# OFL fonts; LICENSES.md) with this game's palette (the orb's gold as the one accent on night
# violet) and its Chinese fallback font, edited by hand.
name "sparkorb"
base dark
atlas "skins/sparkorb/atlas.png" 384 256
scale 1
palette {
  backdrop "#0a0614"
  well "#120a22"
  panel "#1c1232"
  panelRaised "#1c1232"
  panelHover "#281a46"
  hud "#1c1232"
  ink "#fff6e6"
  inkMuted "#e3d4bd"
  inkFaint "#b9a890"
  inkInverse "#140a00"
  control "#3a2a5c"
  controlStrong "#4a3874"
  line "#4a3470"
  lineStrong "#c9a6ff"
  primary "#ad690a"
  primaryHover "#d98f1f"
  primaryActive "#a8650a"
  onPrimary "#fff6e6"
  highlight "#ffc35c"
  primarySoft "#ffb02e28"
  focus "#ffd27a"
  knob "#5a3aa6"
  scrim "#030008cc"
  success "#3ddc97"
  warn "#ffd23d"
  danger "#f45f80"
  info "#36e8ff"
  shadow "#000000aa"
}
radius {
  small 6
  control 6
  bar 6
  panel 10
}
ramp {
  body 16 21
  meta 13 18
  caption 13 18
  lg 19 24
  xl 22 28
  xl2 26 30
  xl3 30 34
  displaySm 32 36
  displayMd 40 44
  displayLg 50 54
}
durations {
  instant 90
  fast 140
  base 220
  slow 380
}
fonts {
  body "skins/sparkorb/Rajdhani-Bold.ttf"
  display "skins/sparkorb/ChakraPetch-BoldItalic.ttf"
  numeric "skins/sparkorb/Orbitron-Medium.ttf"
  fallback "fonts/NotoSansSC-subset.ttf"
}
icons "skins/sparkorb/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 22 authored
slice card 104 4 64 64 14 tint
slice button 172 4 48 48 16 tint
slice buttonHover 224 4 48 48 16 tint
slice buttonPressed 276 4 48 48 16 tint
slice buttonDisabled 328 4 48 48 16 tint
slice field 4 104 48 48 10 tint
slice slot 56 104 48 48 12 tint
slice tooltip 108 104 32 32 10 tint
slice capsule 144 104 32 32 14 tint
slice track 180 104 32 16 6 tint
slice fill 216 104 32 16 6 tint
soft 252 104 64 64 24
corner 320 104 32 32 20 20 primary 2
corners card
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 36 16 primary 0
tile 204 172 64 64 48 48 0.12 10 panel
shadow panel 0 0 0 0 "#00000000"
glow button 6 primary 0.35
glow capsule 4 primary 0.25
glow panel 14 primary 0.18
glow slot 3 focus 0.2
textGlow display 2.0 primary 0.7
textGlow numeric 1.2 focus 0.5
press 0.96 0.96 0
hover 0 1.04
motion {
  enter pop
  stagger 35
  toast slideLeft
  progress 260
  shake 7
  pop 0.16
}
