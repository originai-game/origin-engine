string "tower.frost" "Frost lily"
string "tower.hedge" "Hedge"
string "float.gold" "+{n}"
string "float.leak" "-{n}"
string "float.blocked" "That closes the path"
string "float.poor" "Need {n}"
string "float.taken" "Taken"
string "float.wave" "Wave {n}"
string "float.clear" "Wave cleared +{n}"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
