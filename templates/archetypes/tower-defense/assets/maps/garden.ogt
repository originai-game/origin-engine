type tilemap
version 1
---
# Path Guard's field (tools/make-assets.py): 9 x 13 cells of 32 px, one
# world unit each. Visitors come through the gate (top) and walk to the
# doorstep (bottom); hedges and stones block them; the pads layer is
# empty until a plant is set on a cell.
size 9 13
tile 32 32
unit 1
tileset "tiles/garden.ogt"
layer ground {
  z -12
  legend "a" 0
  legend "b" 1
  legend "g" 4
  legend "d" 5
  row "aaaagaaaa"
  row "aabaaaaaa"
  row "aaaaaaaaa"
  row "aaaaaaaaa"
  row "aaaaaabaa"
  row "aabaaaaaa"
  row "aaaaaaaaa"
  row "aaaaaaaaa"
  row "aaaaaaaaa"
  row "aaaaabaaa"
  row "aaaaaaaaa"
  row "aabaaaaaa"
  row "aaaadaaaa"
}
layer decor {
  z -11
  legend "f" 7
  row "........."
  row "......ff."
  row "......f.."
  row "........."
  row "........."
  row ".f.ff...."
  row "...f....."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
}
layer walls {
  z -10
  collision true
  legend "H" 2
  legend "R" 3
  row "HHHH.HHHH"
  row "H.......H"
  row "H.......H"
  row "H.R...R.H"
  row "H.......H"
  row "H.......H"
  row "H...R...H"
  row "H.......H"
  row "HR.....RH"
  row "H.......H"
  row "H..R.R..H"
  row "H.......H"
  row "HHHH.HHHH"
}
layer pads {
  z -9
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
  row "........."
}
object gate {
  kind "spawn"
  at 4.5 0.5
}
object doorstep {
  kind "goal"
  at 4.5 12.5
}
