type flipbook
version 1
---
# Written by tools/make-assets.py: 32 px frames, eight a row. The visitors
# crawl, the plants sway and open on the frame they shoot ("shoot" ends the
# once-clips), the lantern flickers.
texture "garden.png"
pivot 0.5 0.5
grid 32 32 8 3
clip beetle {
  frames 0 1
  fps 6
}
clip moth {
  frames 2 3
  fps 10
}
clip snail {
  frames 4 5
  fps 3
}
clip lantern {
  frames 6 7
  durations 0.6 0.25
}
clip thorn {
  frames 8 9
  fps 2
  mode pingPong
}
clip thorn_shoot {
  frames 10 8
  durations 0.12 0.1
  mode once
}
clip frost {
  frames 11 12
  fps 2
  mode pingPong
}
clip frost_shoot {
  frames 13 11
  durations 0.14 0.1
  mode once
}
clip hedge {
  frames 14 15
  fps 1.5
  mode pingPong
}
clip seed {
  frames 16
  fps 1
}
clip flake {
  frames 17
  fps 1
}
clip cursor {
  frames 18
  fps 1
}
clip refused {
  frames 19
  fps 1
}
