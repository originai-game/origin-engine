type behaviour
version 1
---
# The slime (crates/og-ai/README.md has every node). og.ai runs it before
# the game's systems; the first branch that does not fail decides, and the
# tree is re-checked every tick, so seeing the hero halts the patrol at once.
name "slime"
route beat {                       # the west room's middle, round the key's corner
  point 13.5 6.5 0
  point 17.5 6.5 0
  point 17.5 3.5 0
  point 13.5 3.5 0
}
tree {
  selector {
    sequence flee {                # hurt and recently threatened: keep away
      check Slime.hp below 30
      check sinceSeen below 3
      flee {
        speed 2.6
        distance 5
      }
    }
    sequence attack {              # in reach: bite (the game's `bite` command)
      check sees
      check targetDistance below 0.8
      command bite {
        cooldown 0.5
      }
    }
    sequence chase {               # in sight (Perception.sight is Tuning.slimeSight)
      check sees
      chase {
        speed Tuning.slimeSpeed
        reach 0.6
      }
    }
    sequence search {              # lost it: go where it was last seen
      check sinceSeen below 2
      move_to lastSeen {
        speed Tuning.slimeSpeed
      }
    }
    patrol beat {
      wait 0.6
      speed 0.8
    }
  }
}
