type screen
version 1
---
# Holdout's title (ejected from the library's main-menu, docs/ui.md
# §11.1): the game's name and tagline on a card over the arena (the
# style's panel frame in its hud fill), Hold the line, Duel (two seats
# only) and Settings, and the controls under them: the keys', or on a
# touch screen the touch controls' (on a phone the card stands at the
# bottom). Its words are the game's string keys (assets/strings/*.ogt).
#
# Viewmodel: touch, duel, online. Events to code (src/ui.ts): play, duel, settings.
name "main-menu"
layer menu
under none
back none
props {
  touch bool "A touch screen: the footer names the touch controls."
  duel bool "Two seats: Duel is offered beside the holdout."
  online bool "A room: kept for the copy (both peers see one title)."
}
actions {
  confirm "Select"
}
fixture default "{\"touch\": false, \"duel\": false, \"online\": false}"
stack Title {
  width grow
  height grow
  column Screen {
    width grow
    height grow
    padding 32
    align center
    cross center
    at phone {
      padding 16
      align end
    }
    column Card {
      width 380
      padding 24
      gap 24
      cross center
      background token hud
      frame panel
      radius 4
      at phone {
        width grow
        padding 16
      }
      column Heading {
        width grow
        gap 4
        cross center
        label Name {
          key "title.name"
          text "Holdout"
          step displayLg
          font display
          textAlign center
          heading true
          width grow
          at phone {
            step displayMd
          }
        }
        label Tagline {
          key "title.tagline"
          text "Hold the landing field through five waves"
          color token inkMuted
          textAlign center
          width grow
        }
      }
      column Menu {
        width grow
        gap 8
        focusGroup wrap
        button Play {
          key "title.play"
          text "Hold the line"
          variant primary
          size large
          width grow
          on click emit play
        }
        button Duel {
          key "title.duel"
          text "Duel"
          size large
          width grow
          visible bind duel
          on click emit duel
        }
        button Settings {
          key "title.settings"
          text "Settings"
          size large
          width grow
          on click emit settings
        }
      }
      label Footer {
        key "title.footer"
        text "WASD moves · the mouse aims · click or F fires · R reloads · Space jumps"
        step meta
        color token inkFaint
        visible bind "!touch"
        textAlign center
        width grow
      }
      label DuelFooter {
        key "title.footer.duel"
        text "Hold the line together, or duel: first to five"
        step meta
        color token inkMuted
        visible bind duel
        textAlign center
        width grow
      }
      label TouchFooter {
        key "title.footer.touch"
        text "The stick moves · drag to aim · hold Fire · Reload · Jump"
        step meta
        color token inkFaint
        visible bind touch
        textAlign center
        width grow
      }
    }
  }
}
