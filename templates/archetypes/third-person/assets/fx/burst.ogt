type particles
version 1
---
# A beacon catching: one burst of embers thrown high from the bowl, falling
# back and bouncing (src/world.ts restarts it with startTick when it lights).
maxParticles 256
shape sphere 0.3
spread 60
rate 0
burst 0 90
duration 1.2
looping false
lifetime 0.9 1.8
speed 4 8
size 0.04 0.08
colorOverLife {
  key 0 8 4 1 1
  key 1 2 0.4 0.1 0
}
gravity 0 -7 0
drag 0.3
texture "textures/spark.png"
blend additive
align velocity 0.06
collision 0.45 0.25
