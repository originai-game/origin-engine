type strings
version 1
---
# Ember Vale's English strings (og.i18n); every key is in zh-CN.ogt too.
locale "en"
base true
string "title.name" "Ember Vale"
string "title.tagline" "Light the four beacons before night falls"
string "title.play" "Set out"
string "title.settings" "Settings"
string "title.footer" "WASD to move · Shift runs · Space jumps · hold F to kindle · Q and E turn the view"
string "title.footer.touch" "The stick moves · Jump jumps · hold Kindle by a beacon · the view swings behind you"
string "hud.beacons" "{n}/{total}"
string "hud.pause" "Pause"
string "hud.jump" "Jump"
string "hud.kindle" "Kindle"
string "hud.hint.keys" "Hold F to kindle the beacon"
string "hud.hint.pad" "Hold X to kindle the beacon"
string "hud.hint.touch" "Hold Kindle to light the beacon"
string "hud.lit" "Beacon {n} of {total} burns"
string "hud.dusk" "Night is near"
string "float.alarm" "!"
string "float.hurt" "-1"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
string "pause.quit" "Leave the vale"
string "settings.title" "Settings"
string "settings.master" "Master"
string "settings.music" "Music"
string "settings.effects" "Effects"
string "settings.language" "Language"
string "settings.motion" "Reduce motion"
string "settings.done" "Done"
string "over.won" "Dawn will find the vale lit"
string "over.night" "Night took the vale"
string "over.caught" "The sentinels caught you"
string "over.time" "Time"
string "over.beacons" "Beacons lit"
string "over.hurts" "Hearts lost"
string "over.best" "Best time"
string "over.none" "None yet"
string "over.record" "Runs {runs} · beacons all lit {wins}"
string "over.again" "Again"
string "over.menu" "Title"
string "lang.en" "English"
string "lang.zh" "简体中文"
