type strings
version 1
---
# 余烬谷的简体中文字符串（og.i18n）；每个键都与 en.ogt 一一对应。
locale "zh-CN"
fonts "fonts/NotoSansSC-subset.ttf"
string "title.name" "余烬谷"
string "title.tagline" "在夜幕降临前点燃四座烽火"
string "title.play" "出发"
string "title.settings" "设置"
string "title.footer" "WASD 移动 · Shift 奔跑 · 空格跳跃 · 按住 F 点火 · Q 和 E 转动视角"
string "title.footer.touch" "摇杆移动 · 跳跃键跳跃 · 在烽火旁按住点火键 · 视角会转到身后"
string "hud.beacons" "{n}/{total}"
string "hud.pause" "暂停"
string "hud.jump" "跳跃"
string "hud.kindle" "点火"
string "hud.hint.keys" "按住 F 点燃烽火"
string "hud.hint.pad" "按住 X 点燃烽火"
string "hud.hint.touch" "按住点火键点燃烽火"
string "hud.lit" "第 {n}/{total} 座烽火已燃起"
string "hud.dusk" "夜色将至"
string "float.alarm" "！"
string "float.hurt" "-1"
string "pause.title" "已暂停"
string "pause.resume" "继续"
string "pause.settings" "设置"
string "pause.quit" "离开山谷"
string "settings.title" "设置"
string "settings.master" "总音量"
string "settings.music" "音乐"
string "settings.effects" "音效"
string "settings.language" "语言"
string "settings.motion" "减少动态效果"
string "settings.done" "完成"
string "over.won" "黎明将见山谷灯火通明"
string "over.night" "夜色吞没了山谷"
string "over.caught" "你被守卫抓住了"
string "over.time" "用时"
string "over.beacons" "已点燃烽火"
string "over.hurts" "失去的生命"
string "over.best" "最佳用时"
string "over.none" "尚无"
string "over.record" "出发 {runs} 次 · 点燃全部烽火 {wins} 次"
string "over.again" "再来一次"
string "over.menu" "标题"
string "lang.en" "English"
string "lang.zh" "简体中文"
