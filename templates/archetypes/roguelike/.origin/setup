#!/bin/sh
# Prepares this Game's cloud sandbox snapshot: Origin runs it once per
# snapshot build, in the checkout, without a terminal, for at most 20 minutes,
# and saves the result for new sandboxes of the Game. Keep it idempotent; it
# never receives credentials. Only ignored output is kept: node_modules/ and
# cooked/ (og cook is incremental, so a new sandbox starts cooked).
set -eu
if [ -f bun.lock ]; then bun install --frozen-lockfile; else bun install; fi
og="${ORIGIN_OG_BIN:-og}"
if ! command -v "$og" >/dev/null 2>&1; then
  echo "no og on this executor class; the first og run cooks instead"
  exit 0
fi
"$og" cook .
