type screen
version 1
---
# Lamp Dive's title (ejected from the library's main-menu, docs/ui.md
# §11.1): the game's name and tagline on a card over the tomb, Dive and
# Settings, and the keys in the corner (not on a phone, where the card
# stands at the bottom). Its words are the game's string keys
# (assets/strings/*.ogt).
#
# Events to code (src/ui.ts): play, settings.
name "main-menu"
layer menu
under none
back none
actions {
  confirm "Select"
}
stack Title {
  width grow
  height grow
  column Screen {
    width grow
    height grow
    padding 32
    align center
    cross center
    at phone {
      padding 16
      align end
    }
    column Card {
      width 380
      padding 24
      gap 24
      cross center
      frame hud
      at phone {
        width grow
        padding 16
      }
      column Heading {
        width grow
        gap 4
        cross center
        label Name {
          key "title.name"
          text "Lamp Dive"
          step displayLg
          font display
          textAlign center
          heading true
          width grow
          at phone {
            step displayMd
          }
        }
        label Tagline {
          key "title.tagline"
          text "Two floors down, one lamp, no second chances"
          color token inkMuted
          textAlign center
          width grow
        }
      }
      column Menu {
        width grow
        gap 8
        focusGroup wrap
        button Play {
          key "title.play"
          text "Dive"
          variant primary
          size large
          width grow
          on click emit play
        }
        button Settings {
          key "title.settings"
          text "Settings"
          size large
          width grow
          on click emit settings
        }
      }
    }
  }
  label Footer {
    key "title.footer"
    text "Arrows or WASD to move · walk into a foe to strike · Q drinks"
    step meta
    color token inkFaint
    nowrap true
    position absolute
    end 16
    bottom 16
    at phone {
      visible false
    }
  }
}
