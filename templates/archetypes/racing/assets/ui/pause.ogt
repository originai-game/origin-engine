type screen
version 1
---
# Redline Ring's pause (ejected from the library's pause, docs/ui.md
# §11.1): over the dimmed circuit, Resume, Settings and Retire (back to
# the title). Its words are the game's string keys (assets/strings/*.ogt).
#
# Events to code (src/ui.ts): resume (also Back), settings, quit. The
# game holds its own world and clock while it is up (src/ui.ts), so the
# layer does not pause it.
name "pause"
layer menu
under dim
back emit resume
focus "Panel/Menu/Resume"
actions {
  confirm "Select"
  back "Resume"
}
column Pause {
  width grow
  height grow
  padding 16
  align center
  cross center
  column Panel {
    width grow 0 340
    padding 24
    gap 12
    background token panelRaised
    frame panel
    radius 4
    enter scale
    label Title {
      key "pause.title"
      text "Paused"
      step xl
      font display
      heading true
    }
    column Menu {
      width grow
      gap 8
      focusGroup wrap
      button Resume {
        key "pause.resume"
        text "Resume"
        variant primary
        size large
        width grow
        on click emit resume
      }
      button Settings {
        key "pause.settings"
        text "Settings"
        size large
        width grow
        on click emit settings
      }
      button Quit {
        key "pause.quit"
        text "Retire"
        size large
        width grow
        on click emit quit
      }
    }
  }
}
