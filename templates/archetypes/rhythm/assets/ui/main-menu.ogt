type screen
version 1
---
# Three-Lane Beat's title (ejected from the library's main-menu, docs/ui.md
# §11.1): the game's name and tagline on a card over the highway (the
# style's panel frame in its hud fill), Play, Calibrate and Settings, and
# the keys under them in the card, as the title shipped (on a phone the
# card stands at the bottom). Its words are the game's string keys
# (assets/strings/*.ogt).
#
# Events to code (src/ui.ts): play, calibrate, settings.
name "main-menu"
layer menu
under none
back none
actions {
  confirm "Select"
}
stack Title {
  width grow
  height grow
  column Screen {
    width grow
    height grow
    padding 32
    align center
    cross center
    at phone {
      padding 16
      align end
    }
    column Card {
      width 380
      padding 24
      gap 24
      cross center
      background token hud
      frame panel
      radius 2
      at phone {
        width grow
        padding 16
      }
      column Heading {
        width grow
        gap 4
        cross center
        label Name {
          key "title.name"
          text "Three-Lane Beat"
          step displayLg
          font display
          textAlign center
          heading true
          width grow
          at phone {
            step displayMd
          }
        }
        label Tagline {
          key "title.tagline"
          text "Neon Pulse · 120 BPM · three lanes, one groove"
          color token inkMuted
          textAlign center
          width grow
        }
      }
      column Menu {
        width grow
        gap 8
        focusGroup wrap
        button Play {
          key "title.play"
          text "Play"
          variant primary
          size large
          width grow
          on click emit play
        }
        button Calibrate {
          key "title.calibrate"
          text "Calibrate"
          size large
          width grow
          on click emit calibrate
        }
        button Settings {
          key "title.settings"
          text "Settings"
          size large
          width grow
          on click emit settings
        }
      }
      label Footer {
        key "title.footer"
        text "A S D or the arrows to hit · tap the lanes · Escape pauses"
        step meta
        color token inkFaint
        textAlign center
        width grow
      }
    }
  }
}
