type style
version 2
---
# Upgraded to version 2 by og style upgrade: its version 1 values kept, the new tokens derived from its palette and scheme (docs/ui.md §12).
name "lanebeat"
scheme dark
atlas "styles/lanebeat/atlas.png" 384 256
scale 1
palette {
  backdrop "#03080f"
  well "#071220"
  panel "#0f2a3d"
  panelHover "#16384f"
  panelRaised "#0f2a3d"
  line "#2c6a88"
  lineStrong "#6fd3f5"
  ink "#e2f7ff"
  inkMuted "#a6cde0"
  inkFaint "#8fb3c6"
  inkInverse "#03080f"
  control "#3f8fb3"
  controlStrong "#5aaed4"
  primary "#38e1ff"
  primaryHover "#30d4f0"
  primaryActive "#16c4e6"
  onPrimary "#e2f7ff"
  primarySoft "#38e1ff2a"
  highlight "#7fecff"
  focus "#ffd23f"
  knob "#2f7194"
  hud "#0f2a3d"
  scrim "#010409cc"
  shadow "#00000099"
  sheen "#ffffff52"
  success "#3dffa0"
  warn "#ffc53d"
  danger "#ff4d6a"
  info "#38e1ff"
  health "#3dffa0"
  mana "#0a84ff"
  xp "#bf5af2"
  gold "#38e1ff"
}
colors {
  success icon "check"
  warn icon "bolt"
  danger icon "close"
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#4e79a7"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 38 44 0 700 display {
    phonePortrait 30 35
    phoneLandscape 34 40
  }
  title 26 32 0 700 display {
    phonePortrait 23 28
    phoneLandscape 24 30
  }
  heading 19 26 0 600 display
  body 16 22 0 400 body
  label 13 18 0 600 body
  caption 13 18 0 400 body
  numeric 17 24 0 600 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 2
  sm 2
  md 2
  lg 3
  xl 4
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 1 3 0 "#0000002e"
  }
  floating {
    shadow 0 4 12 0 "#00000036"
  }
  overlay {
    shadow 0 0 18 0 "#000000aa"
  }
  top {
    shadow 0 0 27 0 "#000000aa"
  }
}
shape {
  panel round 2
  dialog round 2
  card round 2
  tooltip round 2
  button round 2
  field round 2
  chip round 2
  badge round 2
  tab round 2
  slot round 2
  bar round 2
  hud round 2
  avatar round 2
}
ramp {
  body 16 22
  meta 13 18
  caption 13 18
  lg 17 24
  xl 19 26
  xl2 22 28
  xl3 26 30
  displaySm 26 32
  displayMd 32 38
  displayLg 38 44
}
fonts {
  body "styles/lanebeat/ChakraPetch-Medium.ttf"
  display "styles/lanebeat/Orbitron-Bold.ttf"
  numeric "styles/lanebeat/JetBrainsMono-Regular.ttf"
  cjk "@styles/cjk/NotoSansSC-Regular.ttf"
  cjkDisplay "@styles/cjk/NotoSansSC-Bold.ttf"
}
icons "styles/lanebeat/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
soft 252 104 64 64 24
corner 320 104 32 32 18 18 primary 4
divider 4 172 128 24 128 24 primary
flourish 136 172 64 24 32 14 primary 0
tile 204 172 64 64 64 64 0.08 3
textGlow display 1.5 primary 0.55
motion {
  enter fade
  toast slideLeft
  progress 300
  shake 6
  pop 0.1
  spring ui 140 0
  spring panel 220 0
  spring emphasis 360 0.15
  spring playful 520 0.3
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 90
  duration fast 140
  duration base 220
  duration slow 360
  duration spring 520
  duration bounce 640
  stagger 30
  staggerCap 300
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
dress "Panel.frame" {
  slice 4 4 96 96 18 tint
  shadow 0 0 18 0 "#000000aa"
  glow 10 primary 0.12
  corners
  tile
}
dress "Card.frame" {
  slice 104 4 64 64 12 tint
  corners
}
dress "Button.base" {
  slice 172 4 48 48 12 tint
  glow 5 primary 0.22
  press 0.98 0.98 0
  hover 0 1.02
}
dress "Button.base[hover]" {
  slice 224 4 48 48 12 tint
}
dress "Button.base[pressed]" {
  slice 276 4 48 48 12 tint
}
dress "Button.base[disabled]" {
  slice 328 4 48 48 12 tint
}
dress "Field.frame" {
  slice 4 104 48 48 8 tint
}
dress "Slot.frame" {
  slice 56 104 48 48 10 tint
  corners
}
dress "Tooltip.frame" {
  slice 108 104 32 32 8 tint
}
dress "Hud.frame" {
  slice 144 104 32 32 10 tint
  glow 4 primary 0.18
}
dress "Meter.track" {
  slice 180 104 32 16 5 tint
}
dress "Meter.fill" {
  slice 216 104 32 16 2 tint
}
