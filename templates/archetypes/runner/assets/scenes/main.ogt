type scene
version 1
---
# The runner's scene: the runner with its hit box and tuning. `start` in src/main.ts adds the courier's
# sprite, the sky, the city's tilemaps and the pools of crates, fences, coins and dust around the runner.
name "Main"
entity "runner" {
  Transform {
    position -5 0 0
    # Given whole: a field left out loads as 0, not its default (an engine bug), and a 0 scale hides the sprite.
    quaternion 0 0 0 1
    scale 1 1 1
  }
  # The position is the courier's feet; the hit box is centred 0.8125 m above them, narrower than the
  # sprite (1.3 x 1.625 m) and clear of the shoes.
  Actor {
    kind 6
    w 0.5
    h 1.2
    parallax 0
  }
  # Tune's parameters: edit them here, live with `set:runner.Tuning.<field>=<value>`.
  Tuning {
    speed 6
    speedRamp 0.12
    speedMax 12
    jumpHeight 2
    timeToApex 0.333
    jumpCut 1.8
    apexGravity 0.75
    fallGravity 1.15
    spawnInterval 1.3
    coinValue 10
  }
}
