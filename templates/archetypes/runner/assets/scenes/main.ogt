type scene
version 1
---
# The runner's scene: the runner with its hit box and tuning. `start` in src/main.ts adds the sprites, the
# scenery and the pools of crates, fences and coins around the runner.
name "Main"
entity "runner" {
  Transform {
    position -5 0.8125 0
    scale 1.3 1.625 1
  }
  # The hit box is narrower than the sprite and starts above the shoes.
  Actor {
    kind 6
    w 0.5
    h 1.2
    parallax 0
  }
  # Tune's parameters: edit them here, live with `set:runner.Tuning.<field>=<value>`.
  Tuning {
    speed 6
    speedRamp 0.12
    speedMax 12
    gravity 36
    jumpSpeed 12
    jumpCut 0.5
    spawnInterval 1.3
    coinValue 10
  }
}
