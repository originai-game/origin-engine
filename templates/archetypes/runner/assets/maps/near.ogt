type tilemap
version 1
---
# The near buildings, 0.65 units a tile (tools/make-assets.py).
size 24 6
tile 16 16
unit 0.65
tileset "tiles/city.ogt"
layer near {
  z 0
  repeat x
  legend "n" 8
  legend "L" 9
  legend "l" 14
  legend "d" 10
  legend "c" 11
  legend "t" 12
  legend "s" 13
  row "................ccc....."
  row "....cccc........Lnl....."
  row "....nlnd..ccccc.nln....."
  row "ccc.lndl..lnslL.lnd.cccc"
  row "lLn.ndlL..ndlLn.ndl.nlnd"
  row "Lnl.dlLn.tdlLnl.dlL.lndl"
}
