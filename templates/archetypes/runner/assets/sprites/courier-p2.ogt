type flipbook
version 1
---
# The second seat's courier (tools/make-assets.py: P2_SWAP's palette): 32 x 40 frames standing on their feet
# (the pivot: the entity's position is the feet, so a squash keeps them down).
texture "courier-p2.png"
pivot 0.5 0
grid 32 40 8 2
spacing 2
clip idle {
  frames 14 15
  fps 2
}
clip run {
  frames 0 1 2 3 4 5 6 7
  fps 14
  event 2 "step"
  event 6 "step"
}
clip jump {
  frames 8
  fps 1
}
clip fall {
  frames 9
  fps 1
}
clip crash {
  frames 10 11 12 13
  fps 12
  mode once
}
