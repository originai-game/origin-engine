// The clouds' baked fields (clouds.rs `CloudNoise`), generated by compute
// passes from `Clouds.seed` (`noise_params.x`), each tiling in every axis:
//
//   shape, 128³ rgba16float (one tile a quarter of Clouds.scale):
//     r: Perlin-Worley billow erosion (0 solid billow core, 1 deep crease),
//        combining multi-octave Worley F1 with C2 periodic gradient lumps
//        without collapsing creases on large billows (mean ~0.5)
//     g: ridged C2 periodic gradient noise at 4, 8 and 16 cells (cirrus fibres)
//     b: inverted Worley fBm at 8, 16 and 32 cells (cirrus patches)
//     a: smooth-minimum Worley wisps for ragged cloud undersides
//   detail, 64³ rgba16float (one tile a thirty-second of the scale):
//     r: fine multi-octave Worley billows
//     g: divergence-free curl-warped billows (Nubis³ wispy edges)
//     b: inverted Worley web at 8 and 16 cells
//     a: fine ridged streaks for wispy high edges
//   map, 512² rgba16float (the whole cloud field: four tiles of the scale):
//     r: macro cloud coverage field (curl-warped C2 gradient + cellular banks),
//        smoothly equalised via C∞ tanh mapping for any seed
//     g: cloud top height (correlated with wide banks + medium variation)
//     b: closer cellular/roll field for stratocumulus sheets
//     a: convective vigour driving cumulonimbus tower anvils
//
// and the box-averaged mips of both 3D volumes. Prepended by `wgsl_library!`
// (hash.wgsl, common.wgsl, color.wgsl, noise.wgsl).

@group(0) @binding(0) var volume_out: texture_storage_3d<rgba8unorm, write>;
@group(0) @binding(1) var map_out: texture_storage_2d<rgba16float, write>;
@group(0) @binding(2) var mip_src: texture_3d<f32>;
@group(0) @binding(3) var<uniform> noise_params: vec4<u32>;

fn cloud_seed(salt: u32) -> u32 {
  return pcg(noise_params.x ^ (salt * 0x9e3779b9u));
}

fn hash_cell(c: vec3<i32>, salt: u32) -> f32 {
  return lattice3(c, cloud_seed(salt));
}

fn wrap3(c: vec3<i32>, f: i32) -> vec3<i32> {
  return ((c % f) + f) % f;
}

// Distance to the nearest feature point of a periodic lattice of `f` cells
// (Worley F1), in [0, 1].
fn cell_distance(p: vec3<f32>, f: f32, salt: u32) -> f32 {
  let q = p * f;
  let cell = vec3<i32>(floor(q));
  let fi = i32(f);
  var d = 1e9;
  for (var z = -1; z <= 1; z++) {
    for (var y = -1; y <= 1; y++) {
      for (var x = -1; x <= 1; x++) {
        let c = cell + vec3<i32>(x, y, z);
        let w = wrap3(c, fi);
        let fp = vec3<f32>(c) + vec3<f32>(hash_cell(w, salt), hash_cell(w, salt + 1u), hash_cell(w, salt + 2u));
        let v = q - fp;
        d = min(d, dot(v, v));
      }
    }
  }
  return clamp(sqrt(d), 0.0, 1.0);
}

// Smooth-minimum Worley distance (log-sum-exp, k = 8): round crests with no
// sharp ridges along Voronoi cell bisectors.
fn cell_distance_smooth(p: vec3<f32>, f: f32, salt: u32) -> f32 {
  let q = p * f;
  let cell = vec3<i32>(floor(q));
  let fi = i32(f);
  var sum = 0.0;
  for (var z = -1; z <= 1; z++) {
    for (var y = -1; y <= 1; y++) {
      for (var x = -1; x <= 1; x++) {
        let c = cell + vec3<i32>(x, y, z);
        let w = wrap3(c, fi);
        let fp = vec3<f32>(c) + vec3<f32>(hash_cell(w, salt), hash_cell(w, salt + 1u), hash_cell(w, salt + 2u));
        sum += exp(-8.0 * length(q - fp));
      }
    }
  }
  return clamp(-log(max(sum, 1e-12)) / 8.0, 0.0, 1.0);
}

// Periodic 2D Worley inverted cell value (1 at feature point, 0 at edge).
fn cell2_inv(p: vec2<f32>, f: f32, salt: u32) -> f32 {
  let q = p * f;
  let cell = vec2<i32>(floor(q));
  let fi = i32(f);
  var d = 1e9;
  for (var y = -1; y <= 1; y++) {
    for (var x = -1; x <= 1; x++) {
      let c = cell + vec2<i32>(x, y);
      let w = wrap3(vec3<i32>(c, 0), fi);
      let fp = vec2<f32>(c) + vec2<f32>(hash_cell(w, salt), hash_cell(w, salt + 1u));
      let v = q - fp;
      d = min(d, dot(v, v));
    }
  }
  let r = clamp(sqrt(d), 0.0, 1.0);
  return 1.0 - r * r * (3.0 - 2.0 * r);
}

// Periodic C2 3D gradient noise in [-1, 1] using unified `noise.wgsl`.
fn perlin3(p: vec3<f32>, f: i32, salt: u32) -> f32 {
  return grad_noise3_periodic(p * f32(f), vec3<i32>(f), cloud_seed(salt));
}

// Periodic C2 2D gradient noise in [-1, 1] using unified `noise.wgsl`.
fn perlin2(p: vec2<f32>, f: i32, salt: u32) -> f32 {
  return grad_noise2_periodic(p * f32(f), vec2<i32>(f), cloud_seed(salt));
}

// Periodic divergence-free 2D curl displacement for organic weather fronts.
fn curl2_periodic(p: vec2<f32>, f: i32, salt: u32) -> vec2<f32> {
  let e = 0.004;
  let dx = (perlin2(p + vec2<f32>(e, 0.0), f, salt) - perlin2(p - vec2<f32>(e, 0.0), f, salt)) / (2.0 * e);
  let dy = (perlin2(p + vec2<f32>(0.0, e), f, salt) - perlin2(p - vec2<f32>(0.0, e), f, salt)) / (2.0 * e);
  return vec2<f32>(dy, -dx) / f32(f);
}

// Periodic divergence-free 3D curl displacement for Nubis³ wispy detail erosion.
fn curl3_periodic(p: vec3<f32>, f: i32, salt: u32) -> vec3<f32> {
  let e = 0.008;
  let inv = 1.0 / (2.0 * e * f32(f));
  let px_dy = (perlin3(p + vec3<f32>(0.0, e, 0.0), f, salt) - perlin3(p - vec3<f32>(0.0, e, 0.0), f, salt)) * inv;
  let px_dz = (perlin3(p + vec3<f32>(0.0, 0.0, e), f, salt) - perlin3(p - vec3<f32>(0.0, 0.0, e), f, salt)) * inv;
  let py_dx = (perlin3(p + vec3<f32>(e, 0.0, 0.0), f, salt + 1u) - perlin3(p - vec3<f32>(e, 0.0, 0.0), f, salt + 1u)) * inv;
  let py_dz = (perlin3(p + vec3<f32>(0.0, 0.0, e), f, salt + 1u) - perlin3(p - vec3<f32>(0.0, 0.0, e), f, salt + 1u)) * inv;
  let pz_dx = (perlin3(p + vec3<f32>(e, 0.0, 0.0), f, salt + 2u) - perlin3(p - vec3<f32>(e, 0.0, 0.0), f, salt + 2u)) * inv;
  let pz_dy = (perlin3(p + vec3<f32>(0.0, e, 0.0), f, salt + 2u) - perlin3(p - vec3<f32>(0.0, e, 0.0), f, salt + 2u)) * inv;
  return vec3<f32>(pz_dy - py_dz, px_dz - pz_dx, py_dx - px_dy);
}

fn ridged3(p: vec3<f32>, f: i32, salt: u32) -> f32 {
  return 1.0 - min(abs(perlin3(p, f, salt)) * 2.2, 1.0);
}

// Multi-octave Worley billows normalised across [0, 1] (0 billow core, 1 crease).
fn billows(p: vec3<f32>, f: f32, salt: u32) -> f32 {
  let d = 0.50 * cell_distance(p, f, salt)
    + 0.30 * cell_distance(p, f * 2.0, salt + 3u)
    + 0.20 * cell_distance(p, f * 4.0, salt + 6u);
  return clamp((d - 0.28) / 0.46, 0.0, 1.0);
}

// Shape volume's Perlin-Worley erosion: large C2 Perlin lumps modulate billow
// prominence while Worley creases always retain definition (never collapsing to
// 0 on high Perlin lumps). Centered cleanly at ~0.5 across [0, 1].
fn perlin_worley(p: vec3<f32>) -> f32 {
  let d = 0.45 * cell_distance(p, 4.0, 10u)
    + 0.27 * cell_distance(p, 8.0, 13u)
    + 0.18 * cell_distance(p, 16.0, 16u)
    + 0.10 * cell_distance(p, 32.0, 19u);
  let worley = clamp((d - 0.30) / 0.42, 0.0, 1.0);
  let low = 0.50 * perlin3(p, 2, 22u)
    + 0.30 * perlin3(p, 4, 23u)
    + 0.20 * perlin3(p, 8, 24u);
  let lumps = clamp(0.5 + 0.85 * low, 0.0, 1.0);
  return clamp((0.65 * worley + 0.35 * (1.0 - lumps) - 0.08) / 0.84, 0.0, 1.0);
}

// Smooth C∞ CDF equaliser for zero-mean noise fields: maps roughly Gaussian
// inputs uniformly onto (0, 1) with no piecewise quantile creases, for any seed.
fn smooth_cdf(x: f32, gain: f32) -> f32 {
  return 0.5 + 0.5 * tanh(x * gain);
}

@compute @workgroup_size(4, 4, 4)
fn shape(@builtin(global_invocation_id) id: vec3<u32>) {
  let n = textureDimensions(volume_out);
  if (any(id >= n)) { return; }
  let p = (vec3<f32>(id) + 0.5) / vec3<f32>(n);
  let streaks = 0.50 * ridged3(p, 4, 26u) + 0.30 * ridged3(p, 8, 27u) + 0.20 * ridged3(p, 16, 28u);
  let w8 = 1.0 - cell_distance(p, 8.0, 30u);
  let w16 = 1.0 - cell_distance(p, 16.0, 33u);
  let w32 = 1.0 - cell_distance(p, 32.0, 36u);
  let wisps = 1.0
    - 0.625 * cell_distance_smooth(p, 8.0, 30u)
    - 0.250 * cell_distance_smooth(p, 16.0, 33u)
    - 0.125 * cell_distance_smooth(p, 32.0, 36u);
  textureStore(volume_out, vec3<i32>(id), vec4<f32>(
    perlin_worley(p),
    streaks,
    w8 * 0.625 + w16 * 0.25 + w32 * 0.125,
    wisps,
  ));
}

@compute @workgroup_size(4, 4, 4)
fn detail(@builtin(global_invocation_id) id: vec3<u32>) {
  let n = textureDimensions(volume_out);
  if (any(id >= n)) { return; }
  let p = (vec3<f32>(id) + 0.5) / vec3<f32>(n);
  // Divergence-free 3D curl warp for organic wispy detail (Nubis³).
  let warp = curl3_periodic(p, 4, 50u);
  let web = 1.0 - 0.60 * cell_distance(p, 8.0, 60u) - 0.40 * cell_distance(p, 16.0, 63u);
  let fine_streak = 0.60 * ridged3(p, 4, 66u) + 0.40 * ridged3(p, 8, 67u);
  textureStore(volume_out, vec3<i32>(id), vec4<f32>(
    billows(p, 4.0, 40u),
    billows(fract(p + warp * 0.045), 4.0, 40u),
    web,
    fine_streak,
  ));
}

@compute @workgroup_size(8, 8, 1)
fn map(@builtin(global_invocation_id) id: vec3<u32>) {
  let n = textureDimensions(map_out);
  if (any(id.xy >= n)) { return; }
  let p = (vec2<f32>(id.xy) + 0.5) / vec2<f32>(n);

  // Synoptic domain warp: bends cloud fronts and banks organically without
  // circular cookie-cutter stamps.
  let warp_lo = curl2_periodic(p, 3, 70u);
  let warp_hi = curl2_periodic(p, 6, 72u);
  let pw = fract(p + warp_lo * 0.075 + warp_hi * 0.025);

  // Broad synoptic regions: clear skies and cloud streets / banks across the sky.
  let region = 0.55 * perlin2(pw, 2, 80u)
    + 0.30 * perlin2(pw, 4, 81u)
    + 0.15 * perlin2(pw, 8, 82u);

  // Multi-scale irregular cloud clusters: continuous C2 gradient fBm blended
  // with curl-warped cellular clusters of two natural scales.
  let fbm_macro = 0.50 * perlin2(pw, 4, 84u)
    + 0.30 * perlin2(pw, 8, 85u)
    + 0.20 * perlin2(pw, 16, 86u);
  let cell_scale = smooth_cdf(perlin2(p, 3, 88u), 2.0);
  let small_cells = 0.65 * cell2_inv(pw, 12.0, 90u) + 0.35 * cell2_inv(pw, 24.0, 92u);
  let large_cells = 0.65 * cell2_inv(pw, 6.0, 94u) + 0.35 * cell2_inv(pw, 12.0, 96u);
  let clusters = (mix(small_cells, large_cells, cell_scale) - 0.45) * 1.4;

  // Macro cloud cover field: uniform-ish across (0, 1) via smooth_cdf so
  // `coverage` corresponds naturally to sky fraction for any seed.
  let raw_field = 0.48 * region + 0.34 * fbm_macro + 0.28 * clusters;
  let field = smooth_cdf(raw_field, 2.55);

  // Cloud top height: wider/stronger banks grow taller, modulated by independent
  // convective noise so narrow clouds stay shallow instead of turning into pillars.
  let tall_var = 0.60 * perlin2(pw, 6, 100u) + 0.40 * perlin2(pw, 12, 101u);
  let tall = clamp(0.45 * field + 0.55 * smooth_cdf(tall_var + 0.35 * region, 2.2), 0.0, 1.0);

  // Stratocumulus sheet field: tighter warped rolls and patches with clear gaps.
  let pw_sc = fract(p + warp_hi * 0.05);
  let sc_cells = 0.55 * cell2_inv(pw_sc, 20.0, 104u) + 0.45 * cell2_inv(pw_sc, 40.0, 106u);
  let sc_rolls = 0.55 * perlin2(pw_sc, 10, 108u) + 0.45 * perlin2(pw_sc, 20, 109u);
  let cells = smooth_cdf((sc_cells - 0.46) * 1.6 + 0.45 * sc_rolls + 0.35 * region, 2.3);

  // Convective vigour (anvil strength for cumulonimbus towers).
  let vig = 0.60 * perlin2(pw, 4, 112u) + 0.40 * perlin2(pw, 8, 113u);
  let vigour = smooth_cdf(vig + 0.25 * region, 2.2);

  textureStore(map_out, vec2<i32>(id.xy), vec4<f32>(field, tall, cells, vigour));
}

// A level of a volume from the level above it (`mip_src`, that level alone).
@compute @workgroup_size(4, 4, 4)
fn mips(@builtin(global_invocation_id) id: vec3<u32>) {
  let n = textureDimensions(volume_out);
  if (any(id >= n)) { return; }
  let base = vec3<i32>(id) * 2;
  var sum = vec4<f32>(0.0);
  for (var z = 0; z < 2; z++) {
    for (var y = 0; y < 2; y++) {
      for (var x = 0; x < 2; x++) {
        sum += textureLoad(mip_src, base + vec3<i32>(x, y, z), 0);
      }
    }
  }
  textureStore(volume_out, vec3<i32>(id), sum * 0.125);
}
