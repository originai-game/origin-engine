  "materialScope": {
    "_doc": "Lenses on Liquid Glass: inside bars and capsules the hover, current and selected fills become the clear control tints of the material they sit on, and the control rim becomes the ringless lens so a selection never draws a second border inside the bar's rim (each key is a semantic colour or shadow, each value the one it takes there). Overlays that carry text (`reset`, glass-thick menus, popovers, dialogs) take the palette back even inside a bar, and solid glass (reduced transparency, increased contrast) keeps the surrounding values.",
    "selector": ".glass, .glass-thin",
    "reset": ".glass-thick",
    "color": {
      "fill": "material-control-hover",
      "fill-strong": "material-control",
      "thumb": "material-control"
    },
    "shadow": {
      "rim": "lens"
    }
  },
  "radius": {
    "control": "6px",
    "field": "8px",
    "block": "10px",
    "card": "14px",
    "panel": "18px",
    "sheet": "22px",
    "button": "9999px"
  },
  "shadow": {
    "edge": "inset 0 0 0 0.5px rgb(0 0 0 / 0.06)",
    "raised": "0 0 0 0.5px rgb(0 0 0 / 0.04), 0 1px 2px rgb(0 0 0 / 0.05), 0 4px 14px -4px rgb(0 0 0 / 0.08)",
    "float": "0 2px 8px -2px rgb(0 0 0 / 0.12), 0 18px 44px -12px rgb(0 0 0 / 0.28)",
    "overlay": "0 16px 40px -12px rgb(0 0 0 / 0.35), 0 2px 6px -2px rgb(0 0 0 / 0.2)",
    "lift": "0 10px 24px -8px rgb(0 0 0 / 0.25), 0 32px 64px -16px rgb(0 0 0 / 0.4)",
    "focus-tile": "0 12px 32px -10px rgb(0 0 0 / 0.55)",
    "rim": "inset 0.75px 1px 0 rgb(255 255 255 / 0.85), inset 0 0 0 0.5px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.06), 0 3px 10px -4px rgb(0 0 0 / 0.1)",
    "lens": "0 1px 2px rgb(0 0 0 / 0.06), 0 2px 8px -2px rgb(0 0 0 / 0.08)"
  },
  "motion": {
    "duration": {
      "instant": "120ms",
      "fast": "180ms",
      "base": "240ms",
      "slow": "400ms",
      "spring": "520ms",
      "bounce": "640ms"
    },
    "easing": {
      "out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001)",
      "snappy": "linear(0, 0.016, 0.063 4.1%, 0.25 8.7%, 0.684 17.5%, 0.86 22.6%, 0.967 28%, 1.03 34%, 1.05 39.6%, 1.045 46.2%, 1.017 58.5%, 0.997 75.2%, 1)",
      "bounce": "linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1)"
    },
    "spring": {
      "_doc": "Springs as damping ratio (1 = critically damped, below 1 overshoots) and response (seconds to reach the target; not a duration), the parameters Apple ships. build.mjs emits --ease-spring-<name> (a linear() easing), --dur-spring-<name> (its settle time) and --spring-<name>-damping/-response for the runtime spring (ui-svelte motion/spring.ts); Swift gets the pair for .spring(response:dampingFraction:). default: overlays, menus, highlights; sheet: sheets and drawers; momentum: releases that carried velocity (a flick, a throw).",
      "default": {
        "damping": 1,
        "response": "350ms"
      },
      "sheet": {
        "damping": 0.85,
        "response": "300ms"
      },
      "momentum": {
        "damping": 0.8,
        "response": "400ms"
      }
    }
  },
