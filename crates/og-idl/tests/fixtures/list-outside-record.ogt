# expect: 47: `List<f32,4>` is a list column: only a component, resource or event field takes it
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  skill og-core
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
  column str {
    doc "Text of at most a capacity of bytes."
    array Uint8Array
    capacity true
    value String
  }
  column list {
    doc "A list of another column's values."
    list true
  }
  handle Post "A post pass."
  column Post {
    doc "A Post field."
    array Uint32Array
    stride 2
    value Post
  }
}

module game {
  skill og-core
  doc "The game."
  struct ChainDesc {
    doc "A chain."
    field passes List.f32.4 "The passes."
  }
}
