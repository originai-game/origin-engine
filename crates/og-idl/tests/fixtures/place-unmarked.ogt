type api
version 1
---
# expect: 67: reads as a place: mark how og.WorldOrigin's shift moves it
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  skill og-core
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  struct Vector3 {
    doc "A 3D vector."
    field x f32 "The x component."
    field y f32 "The y component."
    field z f32 "The z component."
  }
  column Vector3 {
    doc "A Vector3 field."
    array Float32Array
    stride 3
    value Vector3
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
  column str {
    doc "Text of at most a capacity of bytes."
    array Uint8Array
    capacity true
    value String
  }
  column list {
    doc "A list of another column's values."
    list true
  }
  handle Post "A post pass."
  column Post {
    doc "A Post field."
    array Uint32Array
    stride 2
    value Post
  }
}

module game {
  skill og-core
  doc "The game: records with text fields (`str.N`) and list fields (`List.X.N`), which tests/idl.rs follows into every generated output."
  component Label {
    doc "A label."
    field text str.48 "The text." {
      default "Ada"
    }
    field size f32 "Its size."
  }
  component Beacon {
    doc "A beacon: its offset is its own, its place is the world's."
    field offset Vector3 "From its entity."
    field homePoint Vector3 "Where it calls home, unmarked."
  }
  resource Profile {
    doc "The player's profile."
    field name str.16 "The player's name."
  }
  resource Chain {
    doc "A chain of passes: list fields (`List.X.N`)."
    field passes List.Post.4 "The passes, in order."
    field weights List.f32.2 "Two weights at most."
  }
}
