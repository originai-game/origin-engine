type api
version 1
---
# expect: 47: a list is never tunable and has no range
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  skill og-core
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
  column str {
    doc "Text of at most a capacity of bytes."
    array Uint8Array
    capacity true
    value String
  }
  column list {
    doc "A list of another column's values."
    list true
  }
  handle Post "A post pass."
  column Post {
    doc "A Post field."
    array Uint32Array
    stride 2
    value Post
  }
}

module game {
  skill og-core
  doc "The game."
  resource Weights {
    doc "Weights."
    field values List.f32.4 "The values." {
      tunable true
    }
  }
}
