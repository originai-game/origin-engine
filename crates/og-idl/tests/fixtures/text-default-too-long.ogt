type api
version 1
---
# expect: 34: 'Bartholomew' is 11 bytes of UTF-8 and `str<8>` holds 8
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
  column str {
    doc "Text of at most a capacity of bytes."
    array Uint8Array
    capacity true
    value String
  }
}

module game {
  doc "The game."
  component Label {
    doc "A label."
    field text str.8 "The text." {
      default "Bartholomew"
    }
  }
}
