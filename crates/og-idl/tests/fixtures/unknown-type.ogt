# expect: 30: unknown type `Vectr3`
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  skill og-core
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
}

module world {
  skill og-core
  doc "The world."
  struct Spawn {
    doc "Where to spawn."
    field at Vectr3 "The position."
  }
}
