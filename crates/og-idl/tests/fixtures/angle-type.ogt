type api
version 1
---
# expect: 30: 'List<u32>' is not a number, string or word
package "@origingame/fixture"
doc "A fixture: the smallest valid API plus one mistake below."

module reflect {
  skill og-core
  doc "Reflection."
  place top
  struct FieldOptions {
    doc "Field metadata."
    desc true
    field min Option.f32 "The smallest meaningful value."
  }
  column f32 {
    doc "A float."
    array Float32Array
    stride 1
    value f32
  }
}

module world {
  skill og-core
  doc "The world."
  struct Ids {
    doc "Ids."
    field all List<u32> "Every id."
  }
}
