module platform {
  skill og-platform-sdk
  doc "Platform services as host capabilities (docs/design.md §2.8): cloud store, leaderboards, telemetry, Origin Point and AI marks. Game code names a method and its arguments, never a credential, a URL or a cookie: the host owns them. On the web the shell forwards each call to the Player through origin-checked postMessage (Player protocol 2, docs/web-export.md); natively the host answers from a local JSON store (`og run --platform-store`, default `<project>/.og/platform.json`)."
  doc "Calls are asynchronous: each returns a request number at once, and the answer arrives at the start of a later tick, when og.platform sends PlatformAnswered; read it with og.platform.result. Answers are host input, like key presses: the probe's `dump_platform` lists every call, its arguments, its answer and the ticks."
  doc "Errors carry the Player's stable codes: offline, timeout, invalid, unauthorized, not_found, conflict, too_large, rate_limited, unavailable, failed, cancelled (the player backed out of a purchase, an ad or a share sheet) and no_fill (no ad to show now); retryable is true for offline, timeout, unavailable, rate_limited and no_fill."
  doc "Purchases, ads, achievements, the player, friends, invites and share (products, purchase, showAd, achievementUnlock, player, friends, inviteSend, share, ...) are the platform's: accounts and money never enter the engine. Each call is a method name and its arguments, the host attaches the player's game-scoped credential, and every id it hands back (the player, a friend, a purchase, an invite) is opaque and scoped to this game. A host that lacks one answers it `unavailable`: ask og.platform.supports first. Natively and in playtests a deterministic fake answers them (`og run --platform-fake`, PlaytestDesc.platform); a published page never fakes them. Entitlements are always the host's answer, never the engine's log or a save: ask og.platform.entitlements when the game starts, and grant a consumable once per purchase with og.platform.grant."
  doc "Unasked host input (a pending purchase settled, a refund, an entitlement changed on another device, an invite arrived) is a notice: og.PlatformNotice at the start of a tick, read with og.platform.notice, logged with the answers. In a running lockstep or rollback session (og.Lockstep) a platform answer or notice is this peer's alone: a system that reads og.PlatformAnswered or og.PlatformNotice, or calls og.platform.result or og.platform.notice, while it writes shared state (anything but the session's own records: input, audio, camera, og.Lockstep) hears nothing and reads null, and the engine logs it once; carry what every peer must see in og.PlayerInput (og.net.submit)."
  doc "Rooms (roomCreate, roomJoin, roomSend, ...) put this engine with other players' engines: the host carries them (natively `og relay` with `og run --room`, on the web the platform's rooms through the shell, docs/platform-asks.md) and its answers and the other peers' messages arrive as events at the start of a tick (og.RoomJoined, og.RoomPeerJoined, og.RoomPeerLeft, og.RoomMessage), host input like key presses. Deterministic play over a room is og.net's lockstep."

  enum PlatformOrder {
    doc "How a leaderboard sorts; the first submission to a board fixes it."
    variant desc "Higher is better (scores)."
    variant asc "Lower is better (times)."
  }

  event PlatformAnswered {
    doc "An answer arrived: sent by og.platform at the start of the tick it was applied, read by systems the tick after (og.platform.result has it at once)."
    field request u32 "The call's request number."
    field ok bool "Whether it succeeded; og.platform.result has the data or the error."
  }

  struct StoreSetDesc {
    doc "A write to the store."
    desc true
    field key String "The key: 1 to 64 of letters, digits, `.`, `_` and `-`."
    field value Json "Any JSON value, at most 64 KiB encoded."
    field revision u32 "Write only if the key is at this revision (a conflict otherwise, whose error carries the revision the key is at now); 0 writes whatever is there (the last write wins)."
    field create bool "Write only if the key has never been written (a conflict otherwise); revision is then ignored."
  }

  struct LeaderboardSubmitDesc {
    doc "A score."
    desc true
    field board String "The board (default `main`)." {
      default "main"
    }
    field score f64 "The score, or a time in seconds for an ascending board."
    field order PlatformOrder "How the board sorts, fixed by its first submission."
  }

  struct LeaderboardQueryDesc {
    doc "Which entries."
    desc true
    field board String "The board (default `main`)." {
      default "main"
    }
    field count u32 "How many entries: the top `count`, or `count` around the player." {
      default 10
      min 1
      max 100
    }
  }

  struct PointDesc {
    doc "Origin Point for something the player did."
    desc true
    field reason String "Why, as the game names it: `level.completed`, `daily.streak` (1 to 64 of letters, digits, `.`, `_` and `-`)."
    field amount u32 "How many points the game asks for; the platform decides what it grants." {
      default 1
      min 1
      max 1000
    }
  }

  struct AiMarkDesc {
    doc "Marks content the game shows as generated by AI, for the platform's disclosure."
    desc true
    field kind String "What: `text`, `image`, `audio`, `level`, `character` (1 to 32 of a-z, 0-9, `_` and `-`, a letter first)."
    field label String "What the player sees it as, at most 120 characters."
    field model String "The model or service, when known (at most 80 characters)."
  }

  struct SaveSlotDesc {
    doc "A save slot: a long text (a world.snapshot()) kept across as many store keys as it needs."
    desc true
    field slot String "The slot's name: 1 to 60 of letters, digits, `.`, `_` and `-` (`slot1`). Its keys are the name itself (the manifest) and `<slot>.a0`, `<slot>.a1`, ... or `<slot>.b0`, ... (the parts)."
    field text String "The text: at most 512 KiB of UTF-8 (eight parts of 64 KiB)."
    field meta Json "What a title screen shows of the slot (`{ place, hour }`), kept in the manifest so loadSlot with metaOnly reads it without the parts: any JSON, at most 4 KiB encoded."
  }

  struct LoadSlotDesc {
    doc "Which slot to read, and how much of it."
    desc true
    field slot String "The slot's name, as saveSlot wrote it."
    field metaOnly bool "Read the manifest alone: the answer's text stays null (a title's Continue label, before the player asks for the world)."
  }

  struct PlatformError {
    doc "Why a call failed."
    field code String "offline, timeout, invalid, unauthorized, not_found, conflict, too_large, rate_limited, unavailable, failed, cancelled or no_fill."
    field message String "What happened, in words."
    field retryable bool "Whether the same call may succeed later."
    field revision u32 "For a conflict of a conditional write: the revision the key is at now (read it again, merge, write at it); 0 otherwise."
  }

  struct PlatformResult {
    doc "The answer to one call."
    field request u32 "The call's request number."
    field method String "Its method, such as `store.get`."
    field ok bool "Whether it succeeded."
    field data Json "The answer (see each function); null on failure."
    field error PlatformError "Why it failed." {
      optional true
    }
    field tick u32 "The tick it was answered at."
    field time f64 "The host's clock when it answered, UTC milliseconds since 1970 (PlatformInfo.clock says whose); 0 when the host gave none. A slot call (saveSlot, loadSlot) answers the time of the store answer that ended it." {
      unit ms
    }
  }

  struct PlatformInfo {
    doc "What answers platform calls here."
    field host String "`player` (a Player frames the game), `local` (the native host's JSON store or the browser's own storage) or `none`."
    field capabilities List.String "The methods it answers: store.get, store.set, store.list, leaderboard.submit, leaderboard.top, leaderboard.around, telemetry, point, ai.mark, purchase.products, purchase.buy, purchase.entitlements, purchase.consume, ad.ready, ad.show, achievement.unlock, achievement.progress, achievement.list, player.get, friends.list, invite.send, invite.list, share (og.platform.supports asks for one)."
    field pending u32 "Calls not answered yet."
    field clock String "Whose clock og.platform.now and the answers' `time` read: `player` (the Player's answers carry its time), `browser` (the web host's own clock: the Player gives no time yet, docs/platform-asks.md), `system` (the native host's system clock), `fixed` (`og run --clock` and playtests: a clock that starts where it is told and moves with the ticks) or `none`."
  }

  fn storeGet {
    doc "Read one key of the player's store for this game."
    param world World "The world."
    param key String "The key."
    returns Result.u32 "Refused for a malformed key. The answer's data is `{ key, value, revision }` (value null and revision 0 for a key never written)."
  }

  fn storeSet {
    doc "Write one key of the player's store for this game; with a revision, only if nobody wrote it since (another device, another tab)."
    param world World "The world."
    param desc StoreSetDesc "The key, the value and the revision it must be at."
    returns Result.u32 "Refused for a malformed key or a value over 64 KiB. The answer's data is `{ key, revision }` (the new revision); `conflict` when the key moved past desc.revision."
  }

  fn storeList {
    doc "The keys of the player's store and their revisions."
    param world World "The world."
    returns u32 "The answer's data is `{ keys: [{ key, revision }] }`."
  }

  fn leaderboardSubmit {
    doc "Submit a score; the board keeps the player's best."
    param world World "The world."
    param desc LeaderboardSubmitDesc "The board, the score and its order."
    returns Result.u32 "Refused for a score that is not finite. The answer's data is `{ board, rank, best }`, or `{ board, rank: null, queued: true }` while offline."
  }

  fn leaderboardTop {
    doc "The best entries of a board, and the player's own."
    param world World "The world."
    param desc LeaderboardQueryDesc "The board and how many."
    returns u32 "The answer's data is `{ board, order, entries: [{ rank, name, score, me }], me }`."
  }

  fn leaderboardAround {
    doc "The entries around the player's rank."
    param world World "The world."
    param desc LeaderboardQueryDesc "The board and how many around the player."
    returns u32 "The answer's data is the leaderboardTop shape with the entries around the player's rank."
  }

  fn telemetry {
    doc "Record a game event for the game's analytics."
    param world World "The world."
    param name String "The event: `level.started`, `level.completed`, `boss.defeated` (letters, digits, `.`, `_`; the Player files it as `game.custom.<name>`)."
    param attrs Json "Its attributes: an object of at most 16 strings (up to 512 characters), numbers, booleans or null, keys a lowercase letter then letters, digits and `_`." {
      optional true
    }
    returns Result.Void "Refused for a malformed name or attributes. Fire and forget: nothing answers."
  }

  fn point {
    doc "Ask for Origin Point for something the player did."
    param world World "The world."
    param desc PointDesc "Why and how many."
    returns Result.u32 "Refused for a reason outside 1 to 64 of letters, digits, `.`, `_` and `-`. The answer's data is `{ granted, balance }`; under a Player today always `{ granted: 0, balance: null }` (the platform grants nothing until a release carries an approved point policy), locally the amount asked."
  }

  fn aiMark {
    doc "Disclose AI-generated content the game shows."
    param world World "The world."
    param desc AiMarkDesc "What was generated."
    returns Result.u32 "Refused for an empty kind or label. The answer's data is `{ marked: true }`."
  }

  fn loadSettings {
    doc "Ask for the game's saved settings (volume, controls, language): store.get of the key `og.settings`. Where the Player has no store, or is offline, the shell answers from the browser's own storage; natively, from the local store."
    param world World "The world."
    returns u32 "The request; its answer's data is `{ key, value, revision }` (value null before the first save)."
  }

  fn saveSettings {
    doc "Save the game's settings under `og.settings` (the last save wins), with the same local fallback as loadSettings."
    param world World "The world."
    param value Json "The settings: an object, at most 64 KiB encoded."
    returns Result.u32 "Refused for a value that is not an object or is too large."
  }

  fn saveSlot {
    doc "Save a long text under a slot, in as many store keys as it needs: a mid-size 3D world's snapshot is over a key's 64 KiB (examples/kestrel-stair's 93 entities: about 78 KB). The parts go in the bank of keys the slot's last save did not use (`<slot>.a*` or `<slot>.b*`), then the manifest (`<slot>`: the bank, the part count, the length, a checksum and `meta`) is written last, at the revision read before: so a save cut short leaves the last one whole, and another device's save landing meanwhile is a conflict, never a mix. One request for all of it; a slot takes at most 17 of the player's 64 keys for this game (its two banks and the manifest: 1 MiB, the platform's budget for a player and game), and a world that would take more saves a selection of what it keeps (world.snapshot's SnapshotDesc). og-game §8."
    param world World "The world."
    param desc SaveSlotDesc "The slot, the text and what a title shows of it."
    returns Result.u32 "Refused for a malformed slot name, a text over 512 KiB or a meta over 4 KiB. The answer arrives when the manifest is written: data `{ slot, parts, bytes, revision }`; an error is the first refused part's, or the manifest's (`conflict`: another save of the slot landed meanwhile; the slot holds that one)."
  }

  fn loadSlot {
    doc "Read a slot saveSlot wrote: its manifest, then its parts, joined and checked against the manifest's length and checksum. One request for all of it."
    param world World "The world."
    param desc LoadSlotDesc "The slot, and whether to read its meta alone."
    returns Result.u32 "Refused for a malformed slot name. The answer's data is `{ slot, text, meta, parts, bytes, revision }`: text and meta null for a slot never saved, text null with metaOnly; `invalid` for a key that holds no slot manifest or parts that do not match it."
  }

  # ── purchases, ads, achievements, identity and share (G3-6) ──

  enum AdKind {
    doc "Which kind of ad."
    variant rewarded "The player chose to watch it for a reward: the answer says whether they watched it to the end."
    variant interstitial "Shown at a break the game picks (between levels): the player may close it."
  }

  enum PlatformNoticeKind {
    doc "What a notice is about."
    variant purchase "A purchase settled: a pending one completed or failed, or one was refunded. Data `{ purchase, product, quantity, state }`, state `completed`, `failed` or `refunded`."
    variant entitlements "The player's entitlements changed without a call (bought on another device, a subscription expired): data `{ entitlements }`, the entitlements answer's shape."
    variant invite "An invite to this game arrived: data `{ invite, from: { player, name }, payload, time }`."
    variant host "A message from the page that frames the game, outside any platform service (a site steering a showcase, a launcher handing over a choice): data `{ name, ... }`, its meaning agreed between the game and that page. The engine gives it no meaning of its own; a game reading it handles an unknown name by ignoring it."
  }

  event PlatformNotice {
    doc "Unasked host input arrived: sent by og.platform at the start of the tick it was applied, read by systems the tick after; read it with og.platform.notice. Registered when a game first names it (a system's reads); without it notices are still logged and readable."
    field notice u32 "The notice's number, for og.platform.notice: 1 for the first, counting up."
    field kind PlatformNoticeKind "What it is about."
  }

  resource PlatformGrants {
    doc "The purchases this world granted (og.platform.grant), so a consumable is granted once however its answer or notice comes back: a replay, a relaunch, a restored save. World state: saved, restored and hashed. Registered when a game first names it or calls og.platform.grant. Write it only through og.platform.grant."
    field ids List.u32.512 "The 64-bit hashes of the granted purchase ids, each as two u32 (low, high), oldest first: the last 256 grants."
  }

  struct PlatformNoticeData {
    doc "A notice og.PlatformNotice announced."
    field notice u32 "Its number."
    field kind String "`purchase`, `entitlements` or `invite`."
    field data Json "What it carries (see og.PlatformNoticeKind)."
    field tick u32 "The tick it was applied at."
    field time f64 "The host's clock when it sent it, UTC milliseconds; 0 when it gave none." {
      unit ms
    }
  }

  struct ProductsDesc {
    doc "Which products to describe."
    desc true
    field ids List.String "Product ids as the game's store lists them (1 to 64 of letters, digits, `.`, `_` and `-`), at most 100; empty: every product the game sells."
  }

  struct PurchaseDesc {
    doc "A purchase to ask the player for."
    desc true
    field product String "The product's id."
    field quantity u32 "How many, for a consumable." {
      default 1
      min 1
      max 99
    }
  }

  struct AdDesc {
    doc "An ad to show."
    desc true
    field kind AdKind "Rewarded or interstitial (default rewarded)."
    field placement String "Where in the game, as the game names it (`level.end`, `continue`): 1 to 64 of letters, digits, `.`, `_` and `-` (default `default`)." {
      default "default"
    }
  }

  struct AchievementProgressDesc {
    doc "Progress towards an achievement."
    desc true
    field id String "The achievement's id (1 to 64 of letters, digits, `.`, `_` and `-`)."
    field percent f32 "How far, 0 to 100: 100 unlocks it. Progress never goes back (a lower value keeps the higher one)." {
      min 0
      max 100
    }
  }

  struct FriendsDesc {
    doc "How many friends."
    desc true
    field count u32 "At most this many, those playing this game first." {
      default 50
      min 1
      max 200
    }
  }

  struct InviteDesc {
    doc "An invite to this game."
    desc true
    field to String "The friend's player id (og.platform.friends); empty: the host offers an invite link through the share sheet."
    field message String "What the invite says, at most 120 characters; empty: the host's own words."
    field payload Json "What the game hands the invited player (a room id, a level): any JSON, at most 1 KiB encoded; their og.platform.invites carries it back."
  }

  struct ShareDesc {
    doc "What to share through the device's share sheet."
    desc true
    field text String "The text, 1 to 280 characters."
    field title String "A title, at most 80 characters; empty: the game's name."
    field path String "A short query the game's own Play link carries back (`?share=<path>`), at most 256 of letters, digits, `.`, `_`, `-`, `/` and `=`; empty: the plain Play link. The host builds the link: a game names no URL."
    field image bool "Attach the frame drawn last (a score screen)."
  }

  fn products {
    doc "Describe the products the game sells: titles and prices as the player's store shows them. The catalogue and the prices are the platform's."
    param world World "The world."
    param desc ProductsDesc "Which products." {
      optional true
    }
    returns Result.u32 "Refused for a malformed id or more than 100. The answer's data is `{ products: [{ id, kind, title, description, price: { amount, currency, display } }] }`: kind `consumable`, `durable` or `subscription`, amount in the currency's units, display as the player's store writes it."
  }

  fn purchase {
    doc "Ask the player to buy a product: the host shows its own purchase sheet and takes the money. The answer is the host's word on it; deliver a consumable with og.platform.grant and then og.platform.consume."
    param world World "The world."
    param desc PurchaseDesc "The product and how many."
    returns Result.u32 "Refused for a malformed product id. The answer's data is `{ purchase, product, quantity, state }`: state `completed`, or `pending` (waiting for a parent's approval or a payment; a `purchase` notice settles it). Errors: `cancelled` (the player backed out), `not_found` (no such product), `conflict` (a durable already owned), `unavailable`."
  }

  fn entitlements {
    doc "What the player owns in this game, as the host knows it: durables, active subscriptions and consumables not yet consumed. Ask when the game starts and after a restore, never trust a save for it."
    param world World "The world."
    returns u32 "The answer's data is `{ entitlements: [{ purchase, product, kind, quantity, expires }] }`, expires UTC milliseconds for a subscription, null otherwise."
  }

  fn consume {
    doc "Tell the host a consumable purchase was delivered: it leaves the entitlements. Grant it first (og.platform.grant)."
    param world World "The world."
    param purchase String "The purchase id an answer, an entitlement or a notice carried."
    returns Result.u32 "Refused for a malformed id (1 to 128 of letters, digits, `.`, `_`, `-` and `:`). The answer's data is `{ purchase, product, consumed: true }`; `not_found` for a purchase not owned or already consumed."
  }

  fn grant {
    doc "Record that this world granted purchase `purchase` (in og.PlatformGrants): true the first time, false for one already granted, so a purchase's answer, notice or entitlement seen again (a replay, a relaunch, a save restored from before og.platform.consume) grants once. It records; it is not proof of payment (the host's answer is). Inside a system, declare og.PlatformGrants among its writes."
    param world World "The world."
    param purchase String "The purchase id."
    returns Result.bool "Whether it was new. Refused for a malformed id, or inside a system that did not declare og.PlatformGrants."
  }

  fn granted {
    doc "Whether this world granted purchase `purchase` (og.platform.grant). Inside a system, declare og.PlatformGrants among its reads."
    param world World "The world."
    param purchase String "The purchase id."
    returns bool
  }

  fn adReady {
    doc "Ask whether an ad can be shown now, to offer a rewarded one only when there is one."
    param world World "The world."
    param desc AdDesc "The kind and placement."
    returns Result.u32 "Refused for a malformed placement. The answer's data is `{ kind, placement, ready }`."
  }

  fn showAd {
    doc "Show an ad. While it shows, the host pauses the game through its lifecycle (no ticks, no audio: on the web the Player's pause and resume) and the answer arrives after it resumed, at a tick's start. Grant a reward only on `completed`."
    param world World "The world."
    param desc AdDesc "The kind and placement."
    returns Result.u32 "Refused for a malformed placement. The answer's data is `{ kind, placement, outcome }`: outcome `completed` or `skipped` for a rewarded ad, `shown` for an interstitial. Errors: `no_fill` (no ad now; retryable), `rate_limited` (the platform's frequency cap), `unavailable`."
  }

  fn achievementUnlock {
    doc "Unlock an achievement. The achievements and their titles are the platform's, by id."
    param world World "The world."
    param id String "The achievement's id."
    returns Result.u32 "Refused for a malformed id. The answer's data is `{ id, percent: 100, unlocked: true, new }`, new false when it was unlocked before."
  }

  fn achievementProgress {
    doc "Report progress towards an achievement; 100 unlocks it."
    param world World "The world."
    param desc AchievementProgressDesc "The id and how far."
    returns Result.u32 "Refused for a malformed id or a percent outside 0 to 100. The answer's data is `{ id, percent, unlocked, new }`."
  }

  fn achievements {
    doc "The player's achievements in this game."
    param world World "The world."
    returns u32 "The answer's data is `{ achievements: [{ id, percent, unlocked, time }] }`, time the unlock's UTC milliseconds or null."
  }

  fn player {
    doc "Who is playing: an id scoped to this game (the same player has another id in another game) and the name to show."
    param world World "The world."
    returns u32 "The answer's data is `{ player, name, guest }`, guest true for a player without an account."
  }

  fn friends {
    doc "The player's friends, those playing this game first."
    param world World "The world."
    param desc FriendsDesc "How many." {
      optional true
    }
    returns u32 "The answer's data is `{ friends: [{ player, name, online, playing }] }`, ids scoped to this game; `unauthorized` for a guest."
  }

  fn inviteSend {
    doc "Invite a friend to this game, or offer an invite link through the share sheet. The invited player opens the game with the invite in og.platform.invites."
    param world World "The world."
    param desc InviteDesc "Whom, the words and what the game hands them." {
      optional true
    }
    returns Result.u32 "Refused for a malformed friend id, a message over 120 characters or a payload over 1 KiB. The answer's data is `{ invite, to }` (to null for a link); `cancelled` when the player closed the share sheet."
  }

  fn invites {
    doc "The invites to this game the player has not acted on, the one the game was opened with marked `opened`."
    param world World "The world."
    returns u32 "The answer's data is `{ invites: [{ invite, from: { player, name }, payload, time, opened }] }`."
  }

  fn share {
    doc "Share through the device's share sheet: the text, the game's own Play link and, with image, the frame drawn last."
    param world World "The world."
    param desc ShareDesc "What to share."
    returns Result.u32 "Refused for an empty text, one over 280 characters, a title over 80 or a malformed path. The answer's data is `{ shared: true, target }` (target the app the player picked, when the host knows it, else null); `cancelled` when the player closed the sheet."
  }

  fn supports {
    doc "Whether the host answers platform method `method` (`purchase.buy`, `ad.show`, `share`: og.platform.info's capabilities): what to offer the player before asking. A method it lacks is answered `unavailable`."
    param world World "The world."
    param method String "The method."
    returns bool
  }

  fn notice {
    doc "A notice og.PlatformNotice announced. The engine keeps the last 256."
    param world World "The world."
    param notice u32 "og.PlatformNotice.notice."
    returns Option.PlatformNoticeData "Null for a number never given, one older than the last 256, or inside a system that writes shared state in a running lockstep session."
  }

  fn result {
    doc "The answer to a call, once it arrived."
    param world World "The world."
    param request u32 "The call."
    returns Option.PlatformResult "Null while it is in flight, for an unknown request, or inside a system that writes shared state in a running lockstep session."
  }

  fn info {
    doc "What answers platform calls here, and what it answers."
    param world World "The world."
    returns PlatformInfo
  }

  fn now {
    doc "The host's wall-clock time, UTC milliseconds since 1970, as of this tick: what the host last told the engine (when it attached, and with every answer, applied at a tick's start like the answers) moved on by the ticks since. The one wall-clock read game code may make: it is host input, so a replay with the same answers gives the same values. Use it to know how long the game was closed (a save's time against a launch's), never to time play (that is og.Time)."
    param world World "The world."
    returns f64 "UTC milliseconds; 0 until a host has told the time (`none`)."
  }

  # ── rooms (docs/design.md §2.8) ──

  struct RoomDesc {
    doc "A room to create."
    desc true
    field name String "What the room is called (at most 64 of letters, digits, `.`, `_` and `-`); empty for none. The host gives the room its id."
    field capacity u32 "The most peers it takes." {
      default 2
      min 1
      max 16
    }
  }

  struct QuickPlayDesc {
    doc "Quick play: what this engine waits to be matched for (og.platform.quickPlay)."
    desc true
    field mode String "The mode to play (at most 32 of letters, digits, `.`, `_` and `-`): only engines asking for the same mode and players are matched. Empty is `default`."
    field players u32 "How many play together: the room is made once this many wait (set og.Lockstep.players to the same)." {
      default 2
      min 1
      max 16
    }
    field timeoutMs u32 "How long to wait for the others, in milliseconds; then og.RoomJoined says `timeout`. 0 waits until roomLeave." {
      default 30000
      min 0
      max 600000
      unit ms
    }
    field name String "This player's name, as the other peers see it (og.platform.roomPeers); empty for none."
  }

  struct RoomPeer {
    doc "One peer in the room."
    field peer u32 "Its number: the room numbers peers in join order from 0 and never gives one twice."
    field name String "Its name, as its host gave it; empty for none."
    field local bool "Whether it is this engine."
  }

  struct RoomInfo {
    doc "The room this engine is in."
    field state String "`none` (in no room), `joining` (roomCreate, roomJoin or quickPlay asked, not answered yet: quick play waiting for its match) or `in`."
    field room String "The room's id; empty in none."
    field host String "What carries rooms here: `relay` (natively, `og run --room` through `og relay`), `player` (the platform's rooms through the Player, on the web) or `none` (roomCreate and roomJoin are refused)."
    field peer u32 "This engine's peer number; 0 in none."
    field peers List.RoomPeer "Every peer present, this one included, by number."
    field link String "The room a Play link to a room (`?room=<id>` on the play page) named: the engine joined it at load (og.RoomJoined answers, as for roomJoin); empty without one."
  }

  struct RoomMessageData {
    doc "A message another peer sent: what og.RoomMessage announced."
    field message u32 "Its number (og.RoomMessage.message): 1 for the first message this engine received, counting up."
    field from u32 "The sender's peer number."
    field tick u32 "The tick it was delivered at."
    field data Json "What it carries, when it was sent as a JSON value; null when it was sent as bytes."
    field bytes Option.Bytes "What it carries, when it was sent as bytes."
  }

  event RoomJoined {
    doc "roomCreate, roomJoin or quickPlay finished, or the host put this engine in a room (`og run --room`, a Play link to a room): sent at the start of the tick after the host answered. With ok false the engine is in no room and `reason` says why."
    field ok bool "Whether this engine is in the room now."
    field room String "The room's id (at most 63 bytes); empty when not ok."
    field peer u32 "This engine's peer number."
    field peers u32 "How many peers are in the room, this one included."
    field reason String "Why it failed: `unavailable` (no rooms here), `not_found`, `full`, `invalid`, `offline`, `timeout` (quick play matched nobody in time) or `cancelled` (roomLeave while joining), then a colon and the host's words; empty when ok."
  }

  event RoomPeerJoined {
    doc "Another peer joined this engine's room."
    field peer u32 "Its peer number."
    field peers u32 "How many peers are in the room now."
  }

  event RoomPeerLeft {
    doc "A peer left this engine's room (it left, closed, or lost its connection), after every message it sent; or, with peer equal to this engine's own number, this engine is in no room any more (roomLeave, or the host lost the room)."
    field peer u32 "Its peer number."
    field peers u32 "How many peers are in the room now (0 once this engine left)."
  }

  event RoomMessage {
    doc "Another peer's message arrived; read it with og.platform.roomMessage. Messages from one peer arrive in the order it sent them. While lockstep runs (og.Lockstep) a message is this peer's host input alone: a system that changes the world from one makes it differ from the other peers' (og.Desync); carry what all must see in og.PlayerInput."
    field from u32 "The sender's peer number."
    field message u32 "The message's number, for og.platform.roomMessage."
    field binary bool "Whether it was sent as bytes (else as a JSON value)."
  }

  fn roomCreate {
    doc "Create a room and join it. The answer is og.RoomJoined, with the room's id to share (natively the relay names it `room-N`; on the web the platform does)."
    param world World "The world."
    param desc RoomDesc "Its name and capacity." {
      optional true
    }
    returns Result.Void "Refused with no room host (og.platform.roomInfo's host `none`), while in or joining a room (roomLeave first), or for a malformed name."
  }

  fn roomJoin {
    doc "Join a room by its id. The answer is og.RoomJoined (with ok false and `not_found` or `full` when it cannot); then og.RoomPeerJoined and og.RoomPeerLeft as others come and go."
    param world World "The world."
    param room String "The room's id: 1 to 64 of letters, digits, `.`, `_` and `-`."
    returns Result.Void "Refused with no room host, while in or joining a room, or for a malformed id."
  }

  fn quickPlay {
    doc "Quick play: wait to be matched with other players asking for the same mode and number of players, then play in a room of their own. The answer is og.RoomJoined once the room has filled (every matched peer hears it at once, numbered in the order they asked), or ok false with `timeout` after timeoutMs. roomLeave stops waiting (og.RoomJoined with `cancelled`). Natively `og relay` matches the engines connected to it (`og run --room ws://127.0.0.1:<port>/`); on the web the platform's matchmaking does (platform ask 21: until then the Player answers `unavailable`)."
    param world World "The world."
    param desc QuickPlayDesc "The mode, the players, how long to wait and this player's name." {
      optional true
    }
    returns Result.Void "Refused with no room host, while in or joining a room, or for a malformed mode or name."
  }

  fn roomLeave {
    doc "Leave the room: og.RoomPeerLeft with this engine's own peer number answers, and the other peers hear it leave after its last message. While joining (quick play waiting for its match) it stops waiting: og.RoomJoined answers with ok false and `cancelled`."
    param world World "The world."
    returns Result.Void "Refused when in no room and not joining one."
  }

  fn roomSend {
    doc "Send a message to every other peer in the room, or to one: a JSON value, or bytes (a Uint8Array). It arrives as og.RoomMessage, after every earlier message of this peer."
    param world World "The world."
    param data OneOf.Bytes.Json "What to send: a Uint8Array, or any JSON value; at most 64 KiB encoded."
    param to u32 "The one peer to send it to; omitted is every other peer." {
      optional true
    }
    returns Result.Void "Refused when in no room, for a message over 64 KiB, or a peer not in the room."
  }

  fn roomPeers {
    doc "The peers in this engine's room, this one included, by number; empty in none."
    param world World "The world."
    returns List.RoomPeer
  }

  fn roomInfo {
    doc "The room this engine is in, and what carries rooms here."
    param world World "The world."
    returns RoomInfo
  }

  fn roomMessage {
    doc "A message og.RoomMessage announced: who sent it and what it carries. The engine keeps the last 256."
    param world World "The world."
    param message u32 "og.RoomMessage.message."
    returns Option.RoomMessageData "Null for a number never given, or a message older than the last 256."
  }
}

# ── i18n ──────────────────────────────────────────────────────────────────

