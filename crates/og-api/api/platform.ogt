module platform {
  skill og-platform-sdk
  doc "Platform services as host capabilities (docs/design.md §2.8): cloud store, leaderboards, telemetry, Origin Point and AI marks. Game code names a method and its arguments, never a credential, a URL or a cookie: the host owns them. On the web the shell forwards each call to the Player through origin-checked postMessage (Player protocol 2, docs/web-export.md); natively the host answers from a local JSON store (`og run --platform-store`, default `<project>/.og/platform.json`)."
  doc "Calls are asynchronous: each returns a request number at once, and the answer arrives at the start of a later tick, when og.platform sends PlatformAnswered; read it with og.platform.result. Answers are host input, like key presses: the probe's `dump_platform` lists every call, its arguments, its answer and the ticks."
  doc "Errors carry the Player's stable codes: offline, timeout, invalid, unauthorized, not_found, conflict, too_large, rate_limited, unavailable, failed; retryable is true for offline, timeout, unavailable and rate_limited."
  doc "Rooms (roomCreate, roomJoin, roomSend, ...) put this engine with other players' engines: the host carries them (natively `og relay` with `og run --room`, on the web the platform's rooms through the shell, docs/platform-asks.md) and its answers and the other peers' messages arrive as events at the start of a tick (og.RoomJoined, og.RoomPeerJoined, og.RoomPeerLeft, og.RoomMessage), host input like key presses. Deterministic play over a room is og.net's lockstep."

  enum PlatformOrder {
    doc "How a leaderboard sorts; the first submission to a board fixes it."
    variant desc "Higher is better (scores)."
    variant asc "Lower is better (times)."
  }

  event PlatformAnswered {
    doc "An answer arrived: sent by og.platform at the start of the tick it was applied, read by systems the tick after (og.platform.result has it at once)."
    field request u32 "The call's request number."
    field ok bool "Whether it succeeded; og.platform.result has the data or the error."
  }

  struct StoreSetDesc {
    doc "A write to the store."
    desc true
    field key String "The key: 1 to 64 of letters, digits, `.`, `_` and `-`."
    field value Json "Any JSON value, at most 64 KiB encoded."
    field revision u32 "Write only if the key is at this revision (a conflict otherwise, whose error carries the revision the key is at now); 0 writes whatever is there (the last write wins)."
    field create bool "Write only if the key has never been written (a conflict otherwise); revision is then ignored."
  }

  struct LeaderboardSubmitDesc {
    doc "A score."
    desc true
    field board String "The board (default `main`)." {
      default "main"
    }
    field score f64 "The score, or a time in seconds for an ascending board."
    field order PlatformOrder "How the board sorts, fixed by its first submission."
  }

  struct LeaderboardQueryDesc {
    doc "Which entries."
    desc true
    field board String "The board (default `main`)." {
      default "main"
    }
    field count u32 "How many entries: the top `count`, or `count` around the player." {
      default 10
      min 1
      max 100
    }
  }

  struct PointDesc {
    doc "Origin Point for something the player did."
    desc true
    field reason String "Why, as the game names it: `level.completed`, `daily.streak` (1 to 64 of letters, digits, `.`, `_` and `-`)."
    field amount u32 "How many points the game asks for; the platform decides what it grants." {
      default 1
      min 1
      max 1000
    }
  }

  struct AiMarkDesc {
    doc "Marks content the game shows as generated by AI, for the platform's disclosure."
    desc true
    field kind String "What: `text`, `image`, `audio`, `level`, `character` (1 to 32 of a-z, 0-9, `_` and `-`, a letter first)."
    field label String "What the player sees it as, at most 120 characters."
    field model String "The model or service, when known (at most 80 characters)."
  }

  struct SaveSlotDesc {
    doc "A save slot: a long text (a world.snapshot()) kept across as many store keys as it needs."
    desc true
    field slot String "The slot's name: 1 to 60 of letters, digits, `.`, `_` and `-` (`slot1`). Its keys are the name itself (the manifest) and `<slot>.a0`, `<slot>.a1`, ... or `<slot>.b0`, ... (the parts)."
    field text String "The text: at most 512 KiB of UTF-8 (eight parts of 64 KiB)."
    field meta Json "What a title screen shows of the slot (`{ place, hour }`), kept in the manifest so loadSlot with metaOnly reads it without the parts: any JSON, at most 4 KiB encoded."
  }

  struct LoadSlotDesc {
    doc "Which slot to read, and how much of it."
    desc true
    field slot String "The slot's name, as saveSlot wrote it."
    field metaOnly bool "Read the manifest alone: the answer's text stays null (a title's Continue label, before the player asks for the world)."
  }

  struct PlatformError {
    doc "Why a call failed."
    field code String "offline, timeout, invalid, unauthorized, not_found, conflict, too_large, rate_limited, unavailable or failed."
    field message String "What happened, in words."
    field retryable bool "Whether the same call may succeed later."
    field revision u32 "For a conflict of a conditional write: the revision the key is at now (read it again, merge, write at it); 0 otherwise."
  }

  struct PlatformResult {
    doc "The answer to one call."
    field request u32 "The call's request number."
    field method String "Its method, such as `store.get`."
    field ok bool "Whether it succeeded."
    field data Json "The answer (see each function); null on failure."
    field error PlatformError "Why it failed." {
      optional true
    }
    field tick u32 "The tick it was answered at."
    field time f64 "The host's clock when it answered, UTC milliseconds since 1970 (PlatformInfo.clock says whose); 0 when the host gave none. A slot call (saveSlot, loadSlot) answers the time of the store answer that ended it." {
      unit ms
    }
  }

  struct PlatformInfo {
    doc "What answers platform calls here."
    field host String "`player` (a Player frames the game), `local` (the native host's JSON store or the browser's own storage) or `none`."
    field capabilities List.String "The methods it answers: store.get, store.set, store.list, leaderboard.submit, leaderboard.top, leaderboard.around, telemetry, point, ai.mark."
    field pending u32 "Calls not answered yet."
    field clock String "Whose clock og.platform.now and the answers' `time` read: `player` (the Player's answers carry its time), `browser` (the web host's own clock: the Player gives no time yet, docs/platform-asks.md), `system` (the native host's system clock), `fixed` (`og run --clock` and playtests: a clock that starts where it is told and moves with the ticks) or `none`."
  }

  fn storeGet {
    doc "Read one key of the player's store for this game."
    param world World "The world."
    param key String "The key."
    returns Result.u32 "Refused for a malformed key. The answer's data is `{ key, value, revision }` (value null and revision 0 for a key never written)."
  }

  fn storeSet {
    doc "Write one key of the player's store for this game; with a revision, only if nobody wrote it since (another device, another tab)."
    param world World "The world."
    param desc StoreSetDesc "The key, the value and the revision it must be at."
    returns Result.u32 "Refused for a malformed key or a value over 64 KiB. The answer's data is `{ key, revision }` (the new revision); `conflict` when the key moved past desc.revision."
  }

  fn storeList {
    doc "The keys of the player's store and their revisions."
    param world World "The world."
    returns u32 "The answer's data is `{ keys: [{ key, revision }] }`."
  }

  fn leaderboardSubmit {
    doc "Submit a score; the board keeps the player's best."
    param world World "The world."
    param desc LeaderboardSubmitDesc "The board, the score and its order."
    returns Result.u32 "Refused for a score that is not finite. The answer's data is `{ board, rank, best }`, or `{ board, rank: null, queued: true }` while offline."
  }

  fn leaderboardTop {
    doc "The best entries of a board, and the player's own."
    param world World "The world."
    param desc LeaderboardQueryDesc "The board and how many."
    returns u32 "The answer's data is `{ board, order, entries: [{ rank, name, score, me }], me }`."
  }

  fn leaderboardAround {
    doc "The entries around the player's rank."
    param world World "The world."
    param desc LeaderboardQueryDesc "The board and how many around the player."
    returns u32 "The answer's data is the leaderboardTop shape with the entries around the player's rank."
  }

  fn telemetry {
    doc "Record a game event for the game's analytics."
    param world World "The world."
    param name String "The event: `level.started`, `level.completed`, `boss.defeated` (letters, digits, `.`, `_`; the Player files it as `game.custom.<name>`)."
    param attrs Json "Its attributes: an object of at most 16 strings (up to 512 characters), numbers, booleans or null, keys a lowercase letter then letters, digits and `_`." {
      optional true
    }
    returns Result.Void "Refused for a malformed name or attributes. Fire and forget: nothing answers."
  }

  fn point {
    doc "Ask for Origin Point for something the player did."
    param world World "The world."
    param desc PointDesc "Why and how many."
    returns Result.u32 "Refused for a reason outside 1 to 64 of letters, digits, `.`, `_` and `-`. The answer's data is `{ granted, balance }`; under a Player today always `{ granted: 0, balance: null }` (the platform grants nothing until a release carries an approved point policy), locally the amount asked."
  }

  fn aiMark {
    doc "Disclose AI-generated content the game shows."
    param world World "The world."
    param desc AiMarkDesc "What was generated."
    returns Result.u32 "Refused for an empty kind or label. The answer's data is `{ marked: true }`."
  }

  fn loadSettings {
    doc "Ask for the game's saved settings (volume, controls, language): store.get of the key `og.settings`. Where the Player has no store, or is offline, the shell answers from the browser's own storage; natively, from the local store."
    param world World "The world."
    returns u32 "The request; its answer's data is `{ key, value, revision }` (value null before the first save)."
  }

  fn saveSettings {
    doc "Save the game's settings under `og.settings` (the last save wins), with the same local fallback as loadSettings."
    param world World "The world."
    param value Json "The settings: an object, at most 64 KiB encoded."
    returns Result.u32 "Refused for a value that is not an object or is too large."
  }

  fn saveSlot {
    doc "Save a long text under a slot, in as many store keys as it needs: a mid-size 3D world's snapshot is over a key's 64 KiB (examples/kestrel-stair's 93 entities: about 78 KB). The parts go in the bank of keys the slot's last save did not use (`<slot>.a*` or `<slot>.b*`), then the manifest (`<slot>`: the bank, the part count, the length, a checksum and `meta`) is written last, at the revision read before: so a save cut short leaves the last one whole, and another device's save landing meanwhile is a conflict, never a mix. One request for all of it; a slot takes at most 17 of the player's 64 keys for this game (its two banks and the manifest: 1 MiB, the platform's budget for a player and game), and a world that would take more saves a selection of what it keeps (world.snapshot's SnapshotDesc). og-game §8."
    param world World "The world."
    param desc SaveSlotDesc "The slot, the text and what a title shows of it."
    returns Result.u32 "Refused for a malformed slot name, a text over 512 KiB or a meta over 4 KiB. The answer arrives when the manifest is written: data `{ slot, parts, bytes, revision }`; an error is the first refused part's, or the manifest's (`conflict`: another save of the slot landed meanwhile; the slot holds that one)."
  }

  fn loadSlot {
    doc "Read a slot saveSlot wrote: its manifest, then its parts, joined and checked against the manifest's length and checksum. One request for all of it."
    param world World "The world."
    param desc LoadSlotDesc "The slot, and whether to read its meta alone."
    returns Result.u32 "Refused for a malformed slot name. The answer's data is `{ slot, text, meta, parts, bytes, revision }`: text and meta null for a slot never saved, text null with metaOnly; `invalid` for a key that holds no slot manifest or parts that do not match it."
  }

  fn result {
    doc "The answer to a call, once it arrived."
    param world World "The world."
    param request u32 "The call."
    returns Option.PlatformResult "Null while it is in flight, or for an unknown request."
  }

  fn info {
    doc "What answers platform calls here, and what it answers."
    param world World "The world."
    returns PlatformInfo
  }

  fn now {
    doc "The host's wall-clock time, UTC milliseconds since 1970, as of this tick: what the host last told the engine (when it attached, and with every answer, applied at a tick's start like the answers) moved on by the ticks since. The one wall-clock read game code may make: it is host input, so a replay with the same answers gives the same values. Use it to know how long the game was closed (a save's time against a launch's), never to time play (that is og.Time)."
    param world World "The world."
    returns f64 "UTC milliseconds; 0 until a host has told the time (`none`)."
  }

  # ── rooms (docs/design.md §2.8) ──

  struct RoomDesc {
    doc "A room to create."
    desc true
    field name String "What the room is called (at most 64 of letters, digits, `.`, `_` and `-`); empty for none. The host gives the room its id."
    field capacity u32 "The most peers it takes." {
      default 2
      min 1
      max 16
    }
  }

  struct RoomPeer {
    doc "One peer in the room."
    field peer u32 "Its number: the room numbers peers in join order from 0 and never gives one twice."
    field name String "Its name, as its host gave it; empty for none."
    field local bool "Whether it is this engine."
  }

  struct RoomInfo {
    doc "The room this engine is in."
    field state String "`none` (in no room), `joining` (roomCreate or roomJoin asked, not answered yet) or `in`."
    field room String "The room's id; empty in none."
    field host String "What carries rooms here: `relay` (natively, `og run --room` through `og relay`), `player` (the platform's rooms through the Player, on the web) or `none` (roomCreate and roomJoin are refused)."
    field peer u32 "This engine's peer number; 0 in none."
    field peers List.RoomPeer "Every peer present, this one included, by number."
    field link String "The room a Play link to a room (`?room=<id>` on the play page) named: the engine joined it at load (og.RoomJoined answers, as for roomJoin); empty without one."
  }

  struct RoomMessageData {
    doc "A message another peer sent: what og.RoomMessage announced."
    field message u32 "Its number (og.RoomMessage.message): 1 for the first message this engine received, counting up."
    field from u32 "The sender's peer number."
    field tick u32 "The tick it was delivered at."
    field data Json "What it carries, when it was sent as a JSON value; null when it was sent as bytes."
    field bytes Option.Bytes "What it carries, when it was sent as bytes."
  }

  event RoomJoined {
    doc "roomCreate or roomJoin finished, or the host put this engine in a room (`og run --room`, a Play link to a room): sent at the start of the tick after the host answered. With ok false the engine is in no room and `reason` says why."
    field ok bool "Whether this engine is in the room now."
    field room String "The room's id (at most 63 bytes); empty when not ok."
    field peer u32 "This engine's peer number."
    field peers u32 "How many peers are in the room, this one included."
    field reason String "Why it failed: `unavailable` (no rooms here), `not_found`, `full`, `invalid` or `offline`, then a colon and the host's words; empty when ok."
  }

  event RoomPeerJoined {
    doc "Another peer joined this engine's room."
    field peer u32 "Its peer number."
    field peers u32 "How many peers are in the room now."
  }

  event RoomPeerLeft {
    doc "A peer left this engine's room (it left, closed, or lost its connection), after every message it sent; or, with peer equal to this engine's own number, this engine is in no room any more (roomLeave, or the host lost the room)."
    field peer u32 "Its peer number."
    field peers u32 "How many peers are in the room now (0 once this engine left)."
  }

  event RoomMessage {
    doc "Another peer's message arrived; read it with og.platform.roomMessage. Messages from one peer arrive in the order it sent them. While lockstep runs (og.Lockstep) a message is this peer's host input alone: a system that changes the world from one makes it differ from the other peers' (og.Desync); carry what all must see in og.PlayerInput."
    field from u32 "The sender's peer number."
    field message u32 "The message's number, for og.platform.roomMessage."
    field binary bool "Whether it was sent as bytes (else as a JSON value)."
  }

  fn roomCreate {
    doc "Create a room and join it. The answer is og.RoomJoined, with the room's id to share (natively the relay names it `room-N`; on the web the platform does)."
    param world World "The world."
    param desc RoomDesc "Its name and capacity." {
      optional true
    }
    returns Result.Void "Refused with no room host (og.platform.roomInfo's host `none`), while in or joining a room (roomLeave first), or for a malformed name."
  }

  fn roomJoin {
    doc "Join a room by its id. The answer is og.RoomJoined (with ok false and `not_found` or `full` when it cannot); then og.RoomPeerJoined and og.RoomPeerLeft as others come and go."
    param world World "The world."
    param room String "The room's id: 1 to 64 of letters, digits, `.`, `_` and `-`."
    returns Result.Void "Refused with no room host, while in or joining a room, or for a malformed id."
  }

  fn roomLeave {
    doc "Leave the room: og.RoomPeerLeft with this engine's own peer number answers, and the other peers hear it leave after its last message."
    param world World "The world."
    returns Result.Void "Refused when in no room."
  }

  fn roomSend {
    doc "Send a message to every other peer in the room, or to one: a JSON value, or bytes (a Uint8Array). It arrives as og.RoomMessage, after every earlier message of this peer."
    param world World "The world."
    param data OneOf.Bytes.Json "What to send: a Uint8Array, or any JSON value; at most 64 KiB encoded."
    param to u32 "The one peer to send it to; omitted is every other peer." {
      optional true
    }
    returns Result.Void "Refused when in no room, for a message over 64 KiB, or a peer not in the room."
  }

  fn roomPeers {
    doc "The peers in this engine's room, this one included, by number; empty in none."
    param world World "The world."
    returns List.RoomPeer
  }

  fn roomInfo {
    doc "The room this engine is in, and what carries rooms here."
    param world World "The world."
    returns RoomInfo
  }

  fn roomMessage {
    doc "A message og.RoomMessage announced: who sent it and what it carries. The engine keeps the last 256."
    param world World "The world."
    param message u32 "og.RoomMessage.message."
    returns Option.RoomMessageData "Null for a number never given, or a message older than the last 256."
  }
}

# ── i18n ──────────────────────────────────────────────────────────────────

