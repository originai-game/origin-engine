module render {
  doc "What is drawn: meshes with materials. Draws are instanced by (geometry, material) automatically; there is no per-object draw call."

  handle Geometry "Vertex and index data, as three.js BufferGeometry. Comes from a loaded glTF."
  handle Material "A material instance."
  handle Texture "A cooked texture."

  column Geometry {
    doc "A Geometry handle field."
    array Uint32Array
    stride 2
    value Geometry
  }

  column Material {
    doc "A Material handle field."
    array Uint32Array
    stride 2
    value Material
  }

  enum Side {
    doc "Which faces are drawn, as three.js FrontSide, BackSide and DoubleSide."
    variant front "Front faces only."
    variant back "Back faces only."
    variant double "Both."
  }

  enum RenderTier {
    doc "The backend the renderer runs on; the probe's hello reports it."
    variant webgpu "WebGPU in a browser: the full feature set."
    variant vulkan "Native Vulkan on a GPU."
    variant vulkan-cpu "Native Vulkan on a CPU rasterizer (Mesa lavapipe or llvmpipe, SwiftShader): the executors' sandboxes. Frame times there say nothing about a player's GPU."
    variant metal "Native Metal."
    variant none "No renderer (a sandbox without a GPU; natively also OG_RENDERER=none): the simulation, the dumps and the world hash are the same as with one, a screenshot step writes no PNG and reports its frame unchecked, and capture answers null."
  }

  enum Antialias {
    doc "Antialiasing, as og-render's Antialias. RenderCapabilities.antialias reports what the device resolved."
    guide "render §2"
    variant tier "The engine's default method, on every backend (WebGPU, Metal, Vulkan, DX12): 4x MSAA in a 2D project (project.ogt's profile 2d), where TAA's jitter and history blend would soften nearest-sampled pixel art; TAA in a 3D one."
    variant off "One sample per pixel."
    variant msaa4 "4x MSAA (what tier resolves to in a 2D project): sharp sprites and text, no temporal blur; FXAA where the HDR format cannot be multisampled."
    variant taa "Temporal antialiasing (what tier resolves to in a 3D project): a sub-pixel jitter per frame and a reprojected history; converges over about eight frames. RenderOptions.taaHistory and taaSharpen refine it."
    variant fxaa "FXAA: one full-screen pass over the tonemapped image (the overlay stays sharp), no extra samples and nothing to converge; softer than MSAA on fine texture."
    variant smaa "SMAA 1x high preset: perceptual luma edges, area/search weights and neighbourhood blending over the tonemapped image; the overlay stays sharp. No jitter or history; an alternative to TAA, not combined with TAAU."
    variant smaaT2x "SMAA temporal 2x: two quarter-pixel-jittered SMAA frames, reprojected with the engine's camera and object velocity and neighbourhood rejection. Exclusive of TAA, TAAU and MSAA; render scale uses spatial upscaling, and taaHistory and taaSharpen do not apply."
  }

  enum PointShadows {
    doc "How a point light's shadow map is stored, as og-render's PointShadows. RenderCapabilities.pointShadows reports what the device resolved."
    variant auto "Cube faces."
    variant cube "Six 90 degree faces: six shadow passes per light."
    variant paraboloid "Two paraboloid hemispheres (below and above the light): two passes per light instead of six, coarser, and large casters' silhouettes approximate (their edges stay straight in the curved projection)."
    guide "render §3"
  }

  enum TaaHistory {
    doc "How TAA resamples its history each frame, as og-render's TaaHistory."
    variant bilinear "One bilinear tap: cheap, slightly soft while the camera moves."
    variant catmullRom "A Catmull-Rom filter over 4x4 texels (9 taps): the history stays sharp under camera motion."
  }

  enum Upscaler {
    doc "The temporal resolve under TAA (RenderSettings.upscaler), as og-render's Upscaler: what turns the jittered frame, drawn at the render scale, into the output. RenderCapabilities.upscalers names the ones this device draws. Without TAA neither runs: the frame is scaled bilinearly."
    variant taau "The engine's TAA resolve with temporal upscaling: one pass, a neighbourhood clamp of the history and the RenderOptions.taaHistory filter, then RenderOptions.taaSharpen."
    variant fsr3 "AMD FidelityFX Super Resolution 3.1's upscaler (MIT), in fp32 without subgroups so it runs alike on every host: depth-based disocclusion, thin-geometry locks, luma instability, Lanczos upsampling and RCAS sharpening (taaSharpen's strength); transparent surfaces feed its reactive mask."
    guide "render §2"
  }

  column Upscaler {
    doc "An Upscaler field: the variant's index."
    array Uint32Array
    stride 1
    value Upscaler
  }

  enum DebugView {
    doc "What the debug overlay shows besides og.debug's draws (og.debug.setView, RenderOptions.debugView, `debug:<view>`), drawn over the finished frame; the lit image's views (cascades, ao, albedo, iblDiffuse, iblSpecular, direct, aoDepth, aoRaw) draw in place of the lit image instead, for looking at one term of the lighting. Streams add views as they add what to show."
    variant none "Only og.debug's draws."
    variant physics "The colliders' shapes, joints and contacts as the last physics step left them."
    variant nav "The navigation grids (blocked cells) and navmeshes (polygon edges), and every og.NavAgent's path."
    variant bounds "Every drawn mesh's bounds (its geometry's box at its transform)."
    variant lod "Every og.Model tinted by the level of detail it draws (green the full mesh, yellow level 1, orange level 2, red level 3 and beyond), so the levels' distances read in one frame."
    variant cascades "In place of the lit image: each lit pixel coloured by the directional light's shadow cascade that covers it (red, green, blue, yellow for cascades 0 to 3; black beyond the last)."
    variant ao "In place of the lit image: the screen-space ambient occlusion term (white unoccluded), with PostEffects.ao set."
    variant albedo "In place of the lit image: the lit materials' base colour after their maps and hooks, unlit."
    variant iblDiffuse "In place of the lit image: the diffuse image-based light (Environment's map or sky) each lit material receives."
    variant iblSpecular "In place of the lit image: the specular image-based light each lit material reflects."
    variant direct "In place of the lit image: the direct light (directional, point and spot lights, shadows applied) each lit material receives."
    variant aoDepth "The ao view with the depth the ambient occlusion pass reads in place of its term, as its fraction of a metre (one ramp per metre), to check the depth the AO sees."
    variant aoRaw "The ao view before the term's depth-aware blur, to tell the search's noise from the blur's."
    variant terrain "Terrain projection weights: XYZ as RGB (green is planar XZ). Dark lines show clipmap cells and white marks the outer morph band. dump_entity reports the clipmap regions and their triangle spacing."
    variant terrainLayers "Terrain's strongest raw layer (control times slope and altitude), coloured by index; magenta means the first-layer fallback. Brightness shows its share before height blending."
    variant terrainMip "Terrain normal-map mip footprint: one colour per estimated isotropic mip, darkening between levels. This is a derivative-based estimate, not the hardware anisotropic mip selection."
    variant terrainProjection "Dominant raw terrain layer's actual projection weights, XYZ as RGB, without cell or morph overlays. Planar layers are green (top-down Y projection)."
    variant terrainDensity "Dominant raw terrain layer's vertical albedo texel footprints for X/Y/Z projections as RGB, each linear channel d/(1+d) for d base-level texels per vertical screen pixel (0.5: one texel per pixel), measured before projection weighting; a missing albedo shows the unsupported checker."
  }

  enum Transparency {
    doc "How the main camera's blended surfaces (transparent materials, alpha billboards, alpha particles and trails) are composited, as og-render's Transparency: in any order, never sorted. Additive effects stay additive and drawn after them; 2D sprites, text and the UI keep their layer order; secondary cameras, reflections and probe faces still sort back to front. RenderCapabilities.transparency reports what the device resolved."
    variant weighted "Weighted blended OIT (McGuire and Bavoil 2013) with each pixel's nearest fragment at least 1/8 opaque kept exact (Maule et al. 2013); the layers behind it show as their weighted mean. Any two submission orders agree within half-float rounding. Without fragment storage writes, all are weighted."
    variant linkedList "Per-pixel fragment lists: up to RenderOptions.transparencyLayers a pixel, sorted by depth (ties by a stable draw and primitive key) and composited exactly in any order. A pixel with more is resolved as weighted and counted (render dump transparency.fallbackPixels). Weighted where lists cannot run."
    guide "render §2"
  }

  enum LitFeature {
    doc "An optional feature of the lit shaders that RenderOptions.without can leave out. Every lit shader (meshes, material shaders, clustered meshes, terrain, grass, water, scattered copies, lit particles) carries each one's code behind a runtime test, and its pipelines compile it whether or not a scene uses it. RenderCapabilities.without lists those the renderer was made without."
    variant surfaceWeather "The weather on lit surfaces: og.WeatherState's wet ground, rain streaks, puddles, snow and dust, and the shore a sea's surf wets (og.Water). Left out, surfaces stay dry; og.Weather's particles, fog and light still draw."
    variant gi "The probes of GlobalIllumination (method probes or both): left out, they are not traced and lit surfaces do not gather them, so those methods bounce no light from probes (both keeps its screen-space rays). The screen-space method and LightVolume are not this feature."
    variant areaLights "Rect lights (og.RectLight): left out, a rect light is not drawn, lights nothing and casts no shadow."
    variant decals "Decals (og.Decal): left out, none is drawn."
    variant caustics "The caustics a water surface casts on what lies below it (og.Water.caustics): left out, none is drawn."
  }

  struct RenderOptions {
    doc "How the renderer is created for a game (GameDesc.render). The host reads it once, when it attaches the renderer."
    guide "render §2"
    desc true
    group "Antialiasing"
    field antialias Antialias "The antialiasing method; left out, tier (4x MSAA in a 2D project, TAA in a 3D one)."
    field taaHistory TaaHistory "With TAA: how the history is resampled."
    field taaSharpen f32 "With TAA: a sharpening pass after it, 0 (none) to 1; it never pushes a pixel past its neighbours' range." {
      min 0
      max 1
      unit ratio
    }
    group "Display"
    field hdr bool "Request extended-range HDR surface output; false keeps SDR and its tone operator. Unsupported surfaces and headless renderers stay SDR; capabilities.hdrSupported reports the extended-sRGB path, capabilities.hdr the resolved mode. HDR maps with LPM, composes the UI linearly, transfers last." {
      guide "render §12"
    }
    field paperWhiteNits f32 "HDR reference white; 0 means 203 nits. Clamped to 80..1000. On Apple EDR and web, absolute display nits are unavailable: white follows OS SDR white and peakNits/paperWhiteNits sets relative headroom. On DXGI/Vulkan scRGB this sets absolute paper white. Read once at renderer creation."
    field peakNits f32 "HDR target peak; 0 means 1000 nits. Clamped to 80..10000 and at least paperWhiteNits. A display can limit actual output below this target. Read once at renderer creation."
    group "Shadows and reflections"
    field shadowMapSize u32 "The side of each of the directional light's cascade maps (RenderSettings.shadowCascades of them), in texels." {
      default 2048
      min 256
      max 4096
      guide "render §3"
    }
    field pointShadows PointShadows "How point lights' shadows are stored: cube faces, or two paraboloid hemispheres (fewer passes, coarser)."
    field planarReflections u32 "How many planar reflections (og.Water.planarReflection) draw at once. 1: the first asking (a grid before a mesh); others reflect as if they did not ask, logged once. 2: a second in view mirrors too; shaders read the first's (`planar_reflection`). RenderCapabilities.planarReflections reports it." {
      default 1
      min 1
      max 2
      guide "render §8"
    }
    group "Transparency"
    field transparency Transparency "How blended surfaces are composited: weighted (the default) or the exact per-pixel lists where the device allows them."
    field transparencyLayers u32 "With transparency linkedList: the fragments a pixel keeps and sorts exactly (0: 4), as far as the device's largest storage buffer holds them for every pixel at the render size; RenderCapabilities.transparency says whether the lists run at all." {
      default 0
      min 0
      max 32
    }
    group "Shaders and debugging"
    field without List.LitFeature "Optional lit features left out of every lit pipeline, on any host; empty (the default) builds them all. A scene using one left out draws as if it did not, logged once. Each name once, in any order. Read once, when the renderer is created; RenderCapabilities.without reports it." {
      guide "render §10"
    }
    field debugView DebugView "A debug overlay from the first frame (og.debug.setView, the command channel's `debug:<view>`): none in a game, a view while building one. Not in publish builds."
  }

  struct FoliageDesc {
    doc "Leaf lighting. Zero keeps ordinary opaque-surface lighting; this does not enable glass transmission or change alpha coverage."
    desc true
    field translucency f32 "Thin-leaf backlighting tinted by the base colour and attenuated by the light's shadow." {
      min 0
      max 1
    }
    field domeNormals f32 "Blend leaf normals towards the canopy dome, before normal mapping. Requires cooked foliage anchors." {
      min 0
      max 1
    }
  }

  struct StandardMaterialDesc {
    doc "A physically based metallic-roughness material with three.js MeshStandardMaterial parameter names."
    doc "It is og-render's reflected StandardMaterial field for field. Its tangents come from the model (the cook generates MikkTSpace ones where a glTF has none) or are generated when the geometry is made; normals follow a non-uniform scale correctly."
    guide "render §6"
    desc true
    group "Surface" "The metallic-roughness surface and its maps."
    field color Color "The base colour." {
      default 1 1 1
    }
    field map Option.Texture "The base colour texture."
    field metalness f32 "How metallic the surface is." {
      min 0
      max 1
    }
    field metalnessMap Option.Texture "Metalness from the texture's blue channel (a glTF metallic-roughness texture, the same as roughnessMap's)."
    field roughness f32 "How rough the surface is." {
      default 1
      min 0
      max 1
    }
    field roughnessMap Option.Texture "Roughness from the texture's green channel."
    field normalMap Option.Texture "A tangent-space normal map in glTF's tangent frame: red tilts towards +u, green up the image."
    field normalScale Vector2 "How strongly the normal map bends the normal, per tangent axis." {
      default 1 1
    }
    field aoMap Option.Texture "Ambient occlusion from the texture's red channel."
    field aoMapIntensity f32 "How strongly aoMap darkens the ambient light." {
      default 1
      min 0
    }
    field emissive Color "The emitted colour."
    field emissiveIntensity f32 "A multiplier on the emitted colour." {
      default 1
      min 0
    }
    field emissiveMap Option.Texture "The emitted colour texture."
    field envMapIntensity f32 "A multiplier on image-based lighting." {
      default 1
      min 0
    }
    group "Alpha and faces"
    field opacity f32 "The opacity; below 1 only with transparent." {
      default 1
      min 0
      max 1
    }
    field transparent bool "Blend instead of writing opaque pixels, composited as RenderOptions.transparency says." {
      guide "render §2"
    }
    field alphaTest f32 "Above 0, discard pixels whose alpha is below this." {
      min 0
      max 1
    }
    field alphaToCoverage bool "With MSAA (antialias msaa4), an alpha-tested material turns alpha into sample coverage instead of a hard cut at alphaTest, as three.js alphaToCoverage. Without MSAA it cuts half a pixel's change of alpha below alphaTest (where coverage reaches 0): an edge keeps a few more pixels." {
      guide "render §6"
    }
    field side Side "Which faces are drawn."
    field flatShading bool "Shade with face normals."
    group "Stylised" "Unlit, toon, rim, hit flash, dissolve and outline, all off at their defaults; og.MaterialStyle fills the ones a material leaves at their defaults (styled)."
    field unlit bool "No lighting at all, as three.js MeshBasicMaterial: the colour (times map) plus emissive."
    field toon bool "Cel shading, as three.js MeshToonMaterial: light is quantized by gradientMap (three built-in bands without one), highlights are hard."
    field gradientMap Option.Texture "The toon ramp: a texture whose first row maps the light's angle (left dark, right lit) to the light received, read without filtering."
    field rimColor Color "Rim (fresnel) light added at grazing angles, unshadowed (linear)." {
      default 1 1 1
    }
    field rimIntensity f32 "The rim light's strength; 0 is none." {
      min 0
    }
    field rimPower f32 "How tight the rim is (higher: thinner)." {
      default 3
      min 0.1
    }
    field flashColor Color "The colour a hit flash mixes towards (linear, may exceed 1)." {
      default 1 1 1
    }
    field flash f32 "How far the final colour is mixed towards flashColor (0 none, 1 flat): animate it per tick for a hit flash." {
      min 0
      max 1
    }
    field dissolve f32 "The dissolved fraction: 0 whole, 1 gone. Pixels whose noise is below it are discarded (shadows too); the band just above glows with dissolveEdgeColor." {
      min 0
      max 1
    }
    field dissolveMap Option.Texture "The dissolve noise from the texture's red channel; without one, value noise over the object-space position."
    field dissolveEdgeColor Color "The glowing edge (linear, usually above 1 so it blooms)." {
      default 4 1.5 0.375
    }
    field dissolveEdgeWidth f32 "The width of the glowing band in noise units." {
      default 0.0625
      min 0
      max 1
    }
    field dissolveScale f32 "The frequency of the built-in noise (cells per object-space unit)." {
      default 4
      min 0
    }
    field outlineColor Color "This material's outline colour (linear)."
    field outlineWidth f32 "This material's hull outline width in pixels; 0 is none (PostEffects.outline outlines everything). It lines the silhouette, where one part passes in front of another and creases against other objects, never edges between its own faces; a face at a grazing angle is lined only where it ends." {
      min 0
      max 31
      guide "render §6"
    }
    field styled bool "Whether og.MaterialStyle (a look's scene-wide stylised fields) reaches this material; false keeps it as declared under any look. A material with a physical lobe (any Physical layers field, or ior not 1.5) keeps that shading under the style's toon and takes the rest; its own toon still applies." {
      default true
      guide "render §6"
    }
    group "Physical layers" "MeshPhysicalMaterial's fields under three.js's names and glTF's KHR_materials_* meanings, all off at their defaults; drawn on every backend, ignored by unlit and toon materials."
    field clearcoat f32 "A clear lacquer over the surface, as three.js MeshPhysicalMaterial.clearcoat: a second, 4 % reflective specular layer on the surface's normal before normalMap (car paint, varnished wood, wet plastic); 0 is none." {
      min 0
      max 1
      unit ratio
    }
    field clearcoatRoughness f32 "How rough the clear coat is, as three.js MeshPhysicalMaterial.clearcoatRoughness." {
      min 0
      max 1
      unit ratio
    }
    field clearcoatMap Option.Texture "The coat's strength from the texture's red channel, times clearcoat (MeshPhysicalMaterial.clearcoatMap)."
    field clearcoatRoughnessMap Option.Texture "The coat's roughness from the texture's green channel, times clearcoatRoughness."
    field clearcoatNormalMap Option.Texture "A tangent-space normal map of the coat alone; the base keeps normalMap (MeshPhysicalMaterial.clearcoatNormalMap)."
    field clearcoatNormalScale Vector2 "How strongly clearcoatNormalMap bends the coat's normal, per tangent axis." {
      default 1 1
    }
    field sheen f32 "A velvet layer brightening grazing angles, as MeshPhysicalMaterial.sheen (KHR_materials_sheen): Estevez and Kulla's Charlie fibres with shadowing and a soft terminator, lit by the environment through its directional albedo, its light taken from the surface below. Strength times sheenColor; 0 none." {
      min 0
      max 1
      unit ratio
      guide "render §6"
    }
    field sheenColor Color "The sheen's colour (linear), times sheenColorMap; black is none."
    field sheenRoughness f32 "How rough the sheen is: low keeps it to a thin rim, high spreads it over the surface." {
      default 1
      min 0
      max 1
      unit ratio
    }
    field sheenColorMap Option.Texture "The sheen's colour from the texture's RGB (sRGB)."
    field sheenRoughnessMap Option.Texture "The sheen's roughness from the texture's alpha channel."
    field transmission f32 "How much light passes through, as MeshPhysicalMaterial.transmission (glass, water): drawn after the opaque scene, back to front with the transparent ones, it refracts what was drawn before it (not other transmissive or transparent objects), blurred by roughness; 0 is none. It keeps its reflections." {
      min 0
      max 1
      unit ratio
    }
    field transmissionMap Option.Texture "Transmission from the texture's red channel."
    field thickness f32 "The volume's thickness under the surface in the mesh's own units, scaled with it (glTF KHR_materials_volume): how far refraction bends the view and how much attenuationColor absorbs; 0 is a thin wall." {
      min 0
    }
    field thicknessMap Option.Texture "Thickness from the texture's green channel."
    field attenuationDistance f32 "The distance light travels in the volume before it is tinted to attenuationColor (world units); 0 is no absorption, three.js's Infinity." {
      min 0
    }
    field attenuationColor Color "The colour white light becomes after attenuationDistance in the volume (linear)." {
      default 1 1 1
    }
    field ior f32 "The index of refraction (glTF KHR_materials_ior): the reflectance of a dielectric, ((ior - 1) / (ior + 1))^2 (4 % at 1.5), and how far transmission refracts." {
      default 1.5
      min 1
      max 2.333
    }
    field iridescence f32 "A thin-film interference layer, as MeshPhysicalMaterial.iridescence (soap bubbles, oil, beetle shells); 0 is none." {
      min 0
      max 1
      unit ratio
    }
    field iridescenceIOR f32 "The film's index of refraction." {
      default 1.3
      min 1
      max 2.333
    }
    field iridescenceThicknessRange Vector2 "The film's thickness in nanometres: x where iridescenceThicknessMap is black, y where it is white and everywhere without the map (three.js's [100, 400])." {
      default 100 400
    }
    field iridescenceMap Option.Texture "Iridescence from the texture's red channel."
    field iridescenceThicknessMap Option.Texture "The film's thickness between iridescenceThicknessRange's ends from the texture's green channel."
    field anisotropy f32 "Stretches the specular highlight along a direction of the surface, as MeshPhysicalMaterial.anisotropy (brushed metal, hair, satin); 0 is none, 1 fully stretched. Needs the geometry's tangents (generated when it has none)." {
      min 0
      max 1
      unit ratio
    }
    field anisotropyRotation f32 "The stretch's direction in radians from the tangent (+u) towards the bitangent."
    field anisotropyMap Option.Texture "The stretch's direction in red and green (-1 to 1 in the tangent frame, turned by anisotropyRotation) and its strength in blue, times anisotropy."
    group "Texture arrays"
    field mapArray Option.TextureArray "The base colour from layer mapLayer of a texture array (og.load.textureArray) instead of map, each Mesh picking its layer (Mesh.materialLayer), in one draw. With mapArray or normalMapArray, colour and normals come from arrays only (map and normalMap unread). Physical and shader materials take none." {
      guide "render §6"
    }
    field mapLayer u32 "The layer of mapArray drawn where the Mesh does not pick one (past the array's last layer: the last)."
    field normalMapArray Option.TextureArray "A tangent-space normal map from layer normalMapLayer of a texture array (linear: cook it with `kind normal`), the counterpart of mapArray."
    field normalMapLayer u32 "The layer of normalMapArray read where the Mesh does not pick one."
    group "Texture transforms" "Every map samples TEXCOORD_0; a glTF transform's own texCoord (a second uv set) is not read, and the cook notes it."
    field mapOffset Vector2 "The uv offset map is sampled at, as three.js Texture.offset and glTF KHR_texture_transform: uv' = offset + rotation(rotation) * (repeat * uv), glTF's order. A loaded glTF's transform is here unless the cook baked it into the model's uvs." {
      guide "render §6"
    }
    field mapRepeat Vector2 "How many times map repeats across the uvs, as three.js Texture.repeat (glTF's scale): tiling and atlas cells." {
      default 1 1
    }
    field mapRotation f32 "The uv rotation of map, counter-clockwise in uv space about the uv origin, as glTF KHR_texture_transform's rotation." {
      unit rad
    }
    field metalnessMapOffset Vector2 "The uv offset metalnessMap and roughnessMap (one glTF texture; a physical material's other maps and aoMap are packed with them and sampled here too) are sampled at, as mapOffset. A loaded glTF's transform is here unless the cook baked it into the model's uvs."
    field metalnessMapRepeat Vector2 "How many times metalnessMap and roughnessMap (and the maps packed with them, as metalnessMapOffset) repeat across the uvs, as three.js Texture.repeat (glTF's scale): tiling and atlas cells." {
      default 1 1
    }
    field metalnessMapRotation f32 "The uv rotation of metalnessMap and roughnessMap (and the maps packed with them, as metalnessMapOffset), counter-clockwise in uv space about the uv origin, as glTF KHR_texture_transform's rotation." {
      unit rad
    }
    field normalMapOffset Vector2 "The uv offset normalMap is sampled at, as three.js Texture.offset and glTF KHR_texture_transform: uv' = offset + rotation(rotation) * (repeat * uv), glTF's order. A loaded glTF's transform is here unless the cook baked it into the model's uvs."
    field normalMapRepeat Vector2 "How many times normalMap repeats across the uvs, as three.js Texture.repeat (glTF's scale): tiling and atlas cells." {
      default 1 1
    }
    field normalMapRotation f32 "The uv rotation of normalMap, counter-clockwise in uv space about the uv origin, as glTF KHR_texture_transform's rotation." {
      unit rad
    }
    field emissiveMapOffset Vector2 "The uv offset emissiveMap is sampled at, as three.js Texture.offset and glTF KHR_texture_transform: uv' = offset + rotation(rotation) * (repeat * uv), glTF's order. A loaded glTF's transform is here unless the cook baked it into the model's uvs."
    field emissiveMapRepeat Vector2 "How many times emissiveMap repeats across the uvs, as three.js Texture.repeat (glTF's scale): tiling and atlas cells." {
      default 1 1
    }
    field emissiveMapRotation f32 "The uv rotation of emissiveMap, counter-clockwise in uv space about the uv origin, as glTF KHR_texture_transform's rotation." {
      unit rad
    }
    field aoMapOffset Vector2 "The uv offset aoMap is sampled at, as three.js Texture.offset and glTF KHR_texture_transform: uv' = offset + rotation(rotation) * (repeat * uv), glTF's order. A loaded glTF's transform is here unless the cook baked it into the model's uvs."
    field aoMapRepeat Vector2 "How many times aoMap repeats across the uvs, as three.js Texture.repeat (glTF's scale): tiling and atlas cells." {
      default 1 1
    }
    field aoMapRotation f32 "The uv rotation of aoMap, counter-clockwise in uv space about the uv origin, as glTF KHR_texture_transform's rotation." {
      unit rad
    }
    group "Wireframe"
    field wireframe bool "Draw the edges of the mesh's triangles instead of its faces, as three.js Material.wireframe: one CSS pixel wide lines, unlit, depth tested, in the surface's colour along each edge (color × map × vertex colour + emissive × emissiveMap) or wireframeColor. Its meshes cast no shadow." {
      guide "render §6"
    }
    field wireframeAngle f32 "With wireframe: only the mesh's feature edges, its open borders and the edges whose two faces meet at more than this angle (welded by position, so uv seams and split hard edges do not show): a box's 12 edges, nothing across a smooth sphere but where it ends. 0 is every triangle edge." {
      min 0
      max 180
      unit deg
    }
    field wireframeColor Color "With wireframe: one colour for every edge (linear, above 1 blooms) instead of the colour the surface shows along it; black (the zero value) is the surface's."
    group "Leaves, paint and weather"
    field foliage FoliageDesc "Leaf shading; omitted parameters keep their values on updateMaterial. The reflected foliage vector stores translucency in x and domeNormals in y."
    field paintDetail f32 "How much of its detail the painterly filter (Stylise.paintRadius) keeps on this material, times Stylise.paintDetail: 0 painted at the full radius, 1 kept as drawn (a face, a hand, a sign's lettering)." {
      min 0
      max 1
      unit ratio
    }
    field weathering f32 "How much og.WeatherState reaches this material: its wetness, rain streaks, puddles, snow and dust (1 all of it, 0 none). 0 for what the weather never touches: an indoor floor seen through a door, a screen, a hero kept clean, a surface a game wets itself; between for a coat that sheds some." {
      default 1
      min 0
      max 1
      unit ratio
    }
  }

  component Mesh {
    doc "Draws a geometry with a material at the entity's MatrixWorld, as a three.js Mesh."
    doc "The material is a handle from og.render.standardMaterial or from a loaded glTF (GltfInfo.materials); its StandardMaterialDesc maps to the renderer as that struct's docs say."
    field geometry Geometry "The geometry."
    field material Material "The material."
    field castShadow bool "Cast shadows, as three.js Object3D.castShadow: drawn into the sun's cascades and the shadowed lights' maps. Off by default: a lamp's own glass around its light, a glow card or a decal-like slab casts none."
    field receiveShadow bool "Receive shadows, as three.js Object3D.receiveShadow: darkened where the sun's cascades and the shadowed lights' maps say something stands between it and the light. On by default (three.js's is off). false lights it as if unshadowed by every light, while it still casts as castShadow says." {
      default true
      guide "render §3"
    }
    field visible bool "Whether it is drawn." {
      default true
    }
    field flash f32 "A hit flash on this mesh only: the lit colour mixed towards flashColor by this much (og.tween.flash fades it out). Carried with its transform to the lit shaders, as og.Model's, so a flashing mesh is one draw with the other meshes of its geometry and material, and the amount is continuous." {
      min 0
      max 1
      tunable true
    }
    field flashColor Color "The flash's linear colour, 0 to 1 a channel (8 bits a channel)." {
      default 1 1 1
    }
    field materialLayer i32 "The texture-array layer this mesh's material reads (StandardMaterialDesc.mapArray and normalMapArray), in place of the material's mapLayer and normalMapLayer: one material, one draw, a layer per mesh (a tile set, a crowd's skins). -1 keeps the material's layers; a material without arrays ignores it." {
      default -1
      min -1
      tunable true
    }
    field layers u32 "Three.js layers, as Object3D.layers.mask: bit n set puts it on layer n. A camera (og.Camera, og.CameraView, og.Mirror) draws it when their masks share a bit, and og.render.raycast tests it when its own `layers` does. Shadow maps take every caster whatever its layers." {
      default 1
      guide "render §3"
    }
  }

  component DirectionalLight {
    doc "The sun, as three.js DirectionalLight: parallel light along the entity's local -Z (aim it with transform.lookAt, as a camera). The first one found is drawn, with RenderSettings.shadowCascades shadow cascades (3 by default)."
    doc "Without one, the renderer's default sun (from above and to the side, intensity 3) lights the scene."
    aliases "sun, directional light, Godot DirectionalLight3D"
    guide "render §3"
    field color Color "The light's linear colour." {
      default 1 1 1
    }
    field intensity f32 "The radiance multiplier, as three.js DirectionalLight.intensity." {
      default 3
      min 0
      tunable true
    }
    field castShadow bool "Cast shadows through the cascades (RenderSettings.shadowCascades), as three.js Light.castShadow." {
      default true
    }
    field shadowDistance f32 "How far from the camera shadows reach; they fade over the last tenth. Smaller is sharper." {
      default 200
      min 1
      unit m
    }
    field shadowSoftness f32 "Soft shadows (PCSS): the penumbra's width per metre between caster and receiver, the tangent of the sun's apparent radius (the real sun's is 0.005). 0 keeps the hard one-texel edge; 0.01 to 0.05 is a soft sun, sharp at contact and blurring with distance." {
      min 0
      max 0.2
      tunable true
    }
    field shadowBox f32 "One shadow map over a fixed box instead of the cascades: its half size across the light. 0 keeps the cascades. Everything outside the box is lit; the casters are drawn once, not once per cascade (three.js games that fit the light's orthographic shadow camera around the player draw this way)." {
      min 0
      unit m
      tunable true
    }
    field shadowFocus f32 "With shadowBox: how far ahead of the camera (along its level forward) the box is centred." {
      unit m
      tunable true
    }
    field shadowFocusDrop f32 "With shadowBox: how far below the camera the box's centre sits (the ground under a first-person eye)." {
      unit m
      tunable true
    }
    field shadowBias f32 "With shadowBox: the depth bias toward the light (three.js shadow.bias times its camera's depth range). 0 is one texel. Leaf cards need a few centimetres or they shadow each other dark." {
      min 0
      unit m
      tunable true
    }
    field shadowNormalBias f32 "With shadowBox: how far a receiver is pushed along its normal before it reads the map (three.js shadow.normalBias). 0 is one texel." {
      min 0
      unit m
      tunable true
    }
    field cascadeBlend f32 "The fraction of each shadow cascade's depth over which it fades into the next, hiding the seam where the shadow's resolution changes. 0 is none; 0.1 to 0.2 is typical (those pixels read two cascades)." {
      min 0
      max 0.5
      unit ratio
      tunable true
    }
  }

  component PointLight {
    doc "A light shining in every direction from the entity's position, as three.js PointLight. Its radiance at distance d is color * intensity / d^2, faded smoothly to zero at distance."
    doc "Lights are clustered (Forward+): each pixel shades only the lights whose distance reaches it. Up to MAX_LIGHTS in view are drawn (MAX_CLUSTER_LIGHTS a screen cluster), the brightest at the camera kept; RenderSettings.shadowedLights chooses how many with castShadow get shadows, the brightest first."
    aliases "omni light, point light, lamp, bulb, Godot OmniLight3D"
    guide "render §3"
    field color Color "The light's linear colour." {
      default 1 1 1
    }
    field intensity f32 "The radiance at one metre." {
      default 10
      min 0
      tunable true
    }
    field distance f32 "Where the light reaches zero, as three.js PointLight.distance (never infinite here)." {
      default 10
      min 0.01
      unit m
      tunable true
    }
    field castShadow bool "Cast shadows: six cube faces or two paraboloid hemispheres (RenderOptions.pointShadows)."
    field cookie Texture "A light cookie projected all around the light: six square faces stacked top to bottom as +X, -X, +Y, -Y, +Z, -Z, six times as tall as wide (a KTX2 cube's face order, a cube map's orientation, world axes). The light's colour is multiplied by the texel its direction meets. 0 is none." {
      guide "render §3"
    }
  }

  component SpotLight {
    doc "A cone of light along the entity's local -Z, as three.js SpotLight."
    field color Color "The light's linear colour." {
      default 1 1 1
    }
    field intensity f32 "The radiance at one metre on the axis." {
      default 10
      min 0
      tunable true
    }
    field distance f32 "Where the light reaches zero." {
      default 10
      min 0.01
      unit m
      tunable true
    }
    field angle f32 "The half-angle of the outer cone, as three.js SpotLight.angle." {
      default 0.5236
      min 0
      max 1.5708
      unit rad
      tunable true
    }
    field penumbra f32 "The fraction of the cone over which the light fades out, as three.js SpotLight.penumbra." {
      min 0
      max 1
      unit ratio
    }
    field castShadow bool "Cast a shadow map."
    field cookie Texture "A light cookie, as three.js SpotLight.map: the texture projected along the cone (its centre on the axis, its edges at the outer angle, its top towards world up), multiplying the light's colour. 0 is none. A shadowed spot keeps its shadow over the pattern." {
      guide "render §3"
    }
  }

  enum ToneMapping {
    doc "The curve from the lit HDR image to the display, as three.js toneMapping. RenderSettings.toneMapped false clamps instead, whichever is chosen."
    variant aces "ACES (the fitted filmic curve), as three.js ACESFilmicToneMapping: the default."
    variant agx "AgX (Blender 4's and three.js AgXToneMapping's fit, base look): bright saturated lights go to white instead of skewing hue, and keep their hue further up than under ACES."
    variant none "No curve: the exposed linear colour is clamped to 0..1, so 2D colours come out exactly as authored at exposure 1 (the same as toneMapped false)."
    variant neutral "Khronos PBR Neutral, as three.js NeutralToneMapping: colours up to about 0.8 come out as authored (a white-lit base colour shows as the colour picked), only brighter ones roll off to white. For product shots and saturated stylised colour that ACES would darken and shift."
  }

  column ToneMapping {
    doc "A ToneMapping field: the variant's index."
    array Uint32Array
    stride 1
    value ToneMapping
  }

  enum GraphicsQuality {
    doc "A graphics preset: a row of RenderSettings' quality fields that og.render.applyQuality writes (its doc has the table). A settings page offers the three."
    variant medium "The full frame: every quality field at its default."
    variant low "The cheapest frame: no rect-light shadows, two shadowed lights, half-size shadow maps, plain fog, hard particles, no SSR, ambient occlusion or GI, FXAA for MSAA; for a game that turns one back on, half-resolution AO and half the reflection and fog steps."
    variant high "The full frame refined: FSR 3.1 as the temporal upscaler, shadow maps at twice their side, ambient occlusion at full resolution whatever PostEffects.aoResolution asks, twice PostEffects.ssrSteps and twice the volumetric fog's slices (or raymarch steps)."
    guide "render §1"
  }

  enum AoResolutionSetting {
    doc "The resolution RenderSettings.aoResolution draws ambient occlusion at."
    variant postEffects "PostEffects.aoResolution's: the game's choice."
    variant full "Full resolution whatever PostEffects.aoResolution says (the high preset)."
    variant half "Half resolution whatever PostEffects.aoResolution says (the low preset)."
  }

  column AoResolutionSetting {
    doc "An AoResolutionSetting field: the variant's index."
    array Uint32Array
    stride 1
    value AoResolutionSetting
  }

  enum QualityPreset {
    doc "The preset RenderSettings' quality fields were last written with (RenderSettings.quality)."
    variant none "No preset applied: the fields are their defaults or the game's own."
    variant low "og.render.applyQuality(world, \"low\")."
    variant medium "og.render.applyQuality(world, \"medium\")."
    variant high "og.render.applyQuality(world, \"high\")."
  }

  column QualityPreset {
    doc "A QualityPreset field: the variant's index."
    array Uint32Array
    stride 1
    value QualityPreset
  }

  resource RenderSettings {
    doc "The frame's look after lighting: environment light, sky, bloom, exposure metering and tone mapping, and what the frame may cost: the quality fields (rectShadows to upscaler) that og.render.applyQuality sets from a graphics preset. Read after each tick; it never feeds back into the simulation. Camera.exposure is the manual exposure."
    guide "render §5"
    group "Sky light"
    field environmentIntensity f32 "The strength of the image-based ambient light from the sky; og.Environment.intensity takes its place while an environment map is set." {
      default 0.55
      min 0
      tunable true
    }
    field sky bool "Draw the procedural sky behind the scene instead of Camera.background (with an og.Environment map set, the map)."
    group "Bloom"
    field bloom bool "Light above the threshold bleeds into its surroundings."
    field bloomThreshold f32 "Brightness after exposure where bloom starts; 1 is display white." {
      default 1
      min 0
      tunable true
    }
    field bloomKnee f32 "Softens the threshold over threshold plus or minus knee; 0 is a hard cut." {
      default 0.5
      min 0
    }
    field bloomIntensity f32 "How much of the blurred light is added back." {
      default 0.6
      min 0
      tunable true
    }
    field bloomRadius f32 "Below 0 (the default) keeps Origin's bloom. 0 to 1 is three.js UnrealBloomPass at this radius: a half-resolution high pass from bloomThreshold to bloomThreshold + bloomKnee, five Gaussian mips mixed by mix(f, 1.2 - f, radius), added at bloomIntensity as EffectComposer's additive copy." {
      default -1
      min -1
      max 1
      guide "render §5"
    }
    field bloomContrast f32 "With bloomRadius 0 or more: the high pass (and the blur) sees each channel as 0.18 x (colour / 0.18) to this power before exposure, as a contrast grade run ahead of UnrealBloomPass (the way a three.js grade pass before the bloom does) would leave it. 1, the default, leaves the colour as lit." {
      default 1
      min 0.5
      max 2
    }
    group "Exposure and tone mapping"
    field autoExposure bool "Meter every frame to middle grey, then apply Camera.exposure as compensation. With both adapt speeds 0 the exposure is the frame's own; otherwise it adapts from the exposure metered on the first frame after the first tick (earlier frames meter at once), so every host draws the same exposures." {
      guide "render §5"
    }
    field adaptSpeedUp f32 "How fast auto exposure rises when the view gets darker, in EV per second of game time: each drawn frame moves it by at most the speed times the ticks since the last drawn frame, never by the wall clock; 0 is instant. Snapshots and probe sweeps carry the adapted exposure." {
      min 0
      max 100
      unit evPerSecond
      tunable true
    }
    field adaptSpeedDown f32 "How fast auto exposure falls when the view gets brighter, in EV per second of game time; 0 is instant." {
      min 0
      max 100
      unit evPerSecond
      tunable true
      guide "render §5"
    }
    field toneMapped bool "Tone mapping by toneMapping; false clamps, so 2D colours come out exactly as authored at exposure 1." {
      default true
    }
    field toneMapping ToneMapping "Which curve tone maps the frame while toneMapped is true: aces (the default), agx, neutral or none."
    field exposure f32 "A multiplier on every camera's Camera.exposure, as three.js renderer.toneMappingExposure is one for the whole frame: a look's brightness without touching the cameras; 1 leaves them as they are." {
      default 1
      min 0
      max 16
      tunable true
    }
    group "Scene"
    field decalAtlas Texture "The texture Decal components take their uvMin to uvMax region from; 0 draws decals as solid colour."
    field lodBias f32 "A multiplier on every model's projected level-of-detail error (og.Model.lodBias multiplies it again): a level is drawn while its error, measured by the cook against the full mesh, covers under a pixel. 1 is the engine's choice, 2 keeps full meshes twice as far; 0 draws every model in full." {
      default 1
      min 0
      max 16
      tunable true
      guide "render §10"
    }
    field bakedLighting bool "Draw the baked lighting of the scenes that have it (og bake lightmaps): static models with their lightmaps, everything else inside a LightVolume with its probes. False draws every scene as if unbaked, its ambient light from the sky or the environment map." {
      default true
      guide "render §4"
    }
    group "Quality" "The fields og.render.applyQuality writes from a graphics preset."
    field quality QualityPreset "The graphics preset og.render.applyQuality last wrote into the quality fields below (rectShadows to upscaler), or none. A record for the settings screen and the probe: the renderer reads the fields, never this, so a field the game sets after the preset is drawn as set."
    field rectShadows bool "Rect lights whose castShadow is on cast their soft shadows; false draws every rect light unshadowed, each keeping its castShadow for when this is on again. The low preset turns it off." {
      default true
      guide "render §3"
    }
    field shadowedLights u32 "At most this many point, spot and rect lights cast shadows in a frame, the brightest at the camera kept (RenderCapabilities.shadowedLights caps it, 16); 0 casts none. The high preset keeps 16, medium 8, low 2. The directional light's cascades are not counted." {
      default 8
      min 0
      max 16
    }
    field shadowCascades u32 "The directional light's shadow cascades, 1 to 4: more cover the same shadowDistance with finer shadows near the camera, at one more shadow pass and one more map each. The high preset draws 4, medium 3, low 2. Changing it makes the cascade maps again at the next frame." {
      default 3
      min 1
      max 4
    }
    field shadowMapScale f32 "The shadow maps at this fraction of their full side: the cascades (2048 texels by default) and local lights' layers (512), each within 64 texels and the device's limit (4096 for cascades). Changing it remakes the maps next frame; RenderCapabilities.shadowMapSize is the cascades' side drawn." {
      default 1
      min 0.125
      max 4
    }
    field volumetricFog bool "An og.VolumetricFog is drawn lit, with its light shafts; false draws the same medium as plain distance and height fog." {
      default true
    }
    field softParticles bool "Particles with a softDistance fade against the scene behind them; false draws them hard-edged and asks no depth prepass for them." {
      default true
    }
    field screenSpaceReflections bool "PostEffects.ssr draws; false leaves smooth surfaces the reflection probes' and the environment's reflection. PostEffects keeps its settings either way." {
      default true
    }
    field ambientOcclusion bool "PostEffects.ao darkens creases; false draws none. PostEffects keeps its settings either way." {
      default true
    }
    field aoResolution AoResolutionSetting "The resolution ambient occlusion is searched at: postEffects (the default) draws PostEffects.aoResolution; full or half is drawn in its place, and PostEffects keeps its own for when this is postEffects again." {
      guide "render §5"
    }
    field ssrStepScale f32 "PostEffects.ssrSteps times this (within the 4 to 128 steps the pass takes): 2 is 128 steps for the default 64, finer contact with thin and distant reflected surfaces at a higher GPU time. PostEffects keeps its steps." {
      default 1
      min 0
      max 32
    }
    field volumetricStepScale f32 "An og.VolumetricFog's samples along each view ray times this: the froxel grid's 64 slices deep (8 to 256), or the raymarch's 24 steps per pixel (4 to 96) where the renderer draws one (RenderCapabilities.volumetricFog). Changing it makes the grid again at the next frame." {
      default 1
      min 0
      max 4
      guide "render §7"
    }
    field msaaSamples u32 "Samples per pixel where the antialiasing multisamples (msaa4): 4, or 1, which draws FXAA instead. RenderCapabilities.maxMsaaSamples caps it: 1 where the device resolved no MSAA, which draws one sample whatever this says. Changing it remakes the multisampled targets and pipelines next frame." {
      default 4
      min 1
      max 4
      guide "render §2"
    }
    field upscaler Upscaler "Under TAA, the temporal resolve from the render scale (DisplaySettings.renderScale) to the output: taau (the default; the low and medium presets) or fsr3 (the high preset). A device lacking one (RenderCapabilities.upscalers) draws taau. Switching restarts the history next frame." {
      guide "render §1"
    }
    group "Interpolation"
    field interpolate bool "Draw what moves between the last two ticks: a frame between ticks blends entities, og.Camera and skinned joints from the tick before the last to the last, showing the world up to one tick late. Frames on a tick boundary, screenshots and captures draw the last tick. Presentation only." {
      default true
      guide "render §9"
    }
    field snapDistance f32 "An entity or og.Camera that moved further than this between the last two ticks is drawn at the last tick, not blended: a teleport or a respawn this far needs no og.render.snap. 0 never snaps by distance." {
      default 10
      min 0
      unit m
      tunable true
    }
  }

  component Interpolation {
    doc "How the renderer draws this entity between ticks while RenderSettings.interpolate is on; an entity without it is blended. Presentation only: the renderer reads it, the simulation never does."
    guide "render §9"
    field off bool "Draw this entity, and everything under it through og.Parent, at the last tick's transform on every frame, never blended: a marker the game already moves every frame, or an object that jumps on purpose (a clock hand that ticks)."
  }

  fn snap {
    doc "Draw entity, and everything under it through og.Parent, at its tick transform on the frames until the next tick instead of blending from where it was (RenderSettings.interpolate): call it on the tick a game teleports, respawns or resets an entity, so it does not glide across the screen. A move past RenderSettings.snapDistance snaps without it. Systems and commands may call it; it is presentation only and never reaches the world, world_hash or a snapshot."
    param world World "The world whose renderer draws it."
    param entity Entity "The entity that was moved."
    returns Result.Void "Refused for a dead entity."
  }

  fn snapCamera {
    doc "Draw og.Camera at its tick pose on the frames until the next tick instead of blending from where it was: a cut. A camera move past RenderSettings.snapDistance snaps without it. Presentation only, as og.render.snap."
    param world World "The world whose renderer draws it."
    returns Void
  }

