      min 0
    }
    field progress Option.f32 "Something it builds or researches, 0 to 1: a thin gold bar along the tile's foot; null is none." {
      unit ratio
    }
  }

  struct UnitStat {
    doc "A line of the focused unit's stats."
    desc true
    field key String "Its key (its probe id)."
    field icon String "An icon of the atlas before the label; empty is none."
    field label String "What it is (Armour)."
    field value String "Its value as the game words it (8 - 10)."
  }

  struct ControlGroup {
    doc "A control group's tab over the selection."
    desc true
    field key String "Its key (its probe id)."
    field label String "What its tab says (1)."
    field count u32 "Units in it; 0 draws an empty tab."
  }

  struct QueueItem {
    doc "Something in a production queue."
    desc true
    field key String "Its key (its probe id)."
    field name String "What it makes (Vanguard Marine)."
    field icon String "An icon of the atlas when it has no art."
    field image Option.Texture "Its art (art kind portrait or ability, 1:1)."
    field remaining f32 "Seconds left; only the first item counts down." {
      min 0
      unit s
    }
    field duration f32 "Its build time; the first item's bar shows remaining over it." {
      min 0
      unit s
    }
    field count u32 "How many of it are queued in this slot; over 1 shows a small count."
  }

  struct ProductionQueueDesc {
    doc "A building's production queue."
    desc true
    field items List.QueueItem "In build order, the one being built first."
    field slots u32 "Slots shown (empty ones dim); 0 is 5."
    field paused bool "Production is held (no supply, no power): the bar and its time in warn."
    field pausedLabel String "What the held bar says." {
      default "Paused"
    }
    field size f32 "A queued slot's side; 0 is 40 (36 on a phone)." {
      min 0
      unit cssPx
    }
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place (inside a selection panel)."
  }

  struct ProductionQueueResult {
    doc "What a production queue answered."
    field cancelled Option.String "The item pressed this tick to cancel it (its key)."
  }

  fn productionQueue {
    doc "A production queue to the bar of StarCraft II and Age of Empires IV: the item being built large, its art with a gold progress bar under it and the seconds left, the queued items smaller after it in order with a count on a stacked slot, empty slots as dim sockets; paused, the bar and its time turn warn and say so; pressing an item cancels it."
    doc "Parts: ProductionQueue.frame, ProductionQueue.current, ProductionQueue.bar[paused], ProductionQueue.time, ProductionQueue.item, ProductionQueue.count, ProductionQueue.empty, ProductionQueue.zone (a selected building's production beside its card). State groups: queue (idle, building, paused). Sounds: success when the first item completes (leaves the queue). Accessibility: list named Production queue, each item a button named by its name, the first with its seconds left. Probe ids: <id>, <id>/Current/Time, <id>/<key>, <id>/<key>/Count."
    host false
    param id String "Its id."
    param desc ProductionQueueDesc "What it builds."
    returns ProductionQueueResult
  }

  struct SelectionPanelDesc {
    doc "An RTS selection panel."
    desc true
    field units List.SelectedUnit "The selection, in its order."
    field focus String "The unit the detail card shows (its key); empty is the first. Its tile is outlined."
    field groups List.ControlGroup "Control group tabs over the panel; empty draws none."
    field group String "The current group's key."
    field stats List.UnitStat "The focused unit's stats in the detail card."
    field tags List.String "Its attributes, a quiet line at the card's foot (Biological, Light)."
    field queue Option.ProductionQueueDesc "A building's queue while it has items (a building selected): beside its card, the item being built large with its name over a progress bar and the time left, the rest as small slots under it; on a phone a row of small slots under the card's line."
    field columns u32 "Tiles per row; 0 fits the panel (6 on a desktop, 4 on a phone)."
    field rows u32 "Rows before the selection pages; 0 is 2."
    field page u32 "The page shown, from 0."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default bottom
    }
  }

  struct SelectionPanelResult {
    doc "What a selection panel answered."
    field clicked Option.String "A unit's tile pressed this tick (its key): the game focuses it, or selects only it."
    field group Option.String "A control group's tab pressed this tick (its key)."
    field cancelled Option.String "A queue item pressed this tick (its key)."
  }

  fn selectionPanel {
    doc "A selection panel to the bar of StarCraft II, Age of Empires IV and Company of Heroes: control group tabs over one panel of the style's HUD glass; the selection as a grid of portrait tiles, each with its health (green to amber to red as it falls), shield and energy as slim bars under its art and a gold progress line when it builds; the focused tile outlined; a selection larger than the grid pages, a count of what is left in the last tile; beside it a unit card for the focused unit (its portrait at full height, its name at the heading step and its type muted, its health numeral over a bar, its stats in rows of icon, label and tabular value, and its attributes in a muted line at the foot); one unit or building selected has no grid of one: its card takes the zone, and a building with a queue shows its production beside the card (the item being built large, its name over a gold progress bar with the time left, the rest of the queue as small slots under it). Built in place (anchor null, as rtsConsole does) it draws no panel of its own. A phone drops the unit card to a single line under the tiles (beside the one tile of a single selection), and trims the grid to the rows its units fill. The control group tabs stay under a fifth of the zone's height at any text size."
    doc "Parts: SelectionPanel.frame, SelectionPanel.tab[current][empty], SelectionPanel.tile[focused], SelectionPanel.health[low|critical], SelectionPanel.shield, SelectionPanel.energy, SelectionPanel.progress, SelectionPanel.more, SelectionPanel.detail, SelectionPanel.portrait, SelectionPanel.name, SelectionPanel.kind, SelectionPanel.stat, SelectionPanel.stats (a single selection with nothing queued: its stats in the grid's zone), SelectionPanel.tags, SelectionPanel.rule. State groups: selection (empty, single, many) on the panel. Accessibility: group named Selection; each tile a button named by its unit with its health; each tab a tab with its count. Probe ids: <id>, <id>/Tabs/<key>, <id>/Body/Tiles/<key>, <id>/Body/Detail/Name, <id>/Body/Detail/Health/Value, <id>/Body/Detail/Stats/<key>/Value (one selected with nothing queued: <id>/Body/Stats/Columns/Col#<n>/<key>/Value), a building's <id>/Body/Production/Current/Queue/<key> and <id>/Body/Production/Next/<key>."
    host false
    param id String "Its id."
    param desc SelectionPanelDesc "The selection."
    returns SelectionPanelResult
  }

  struct CommandCardDesc {
    doc "An RTS command card."
    desc true
    field commands List.AbilitySlotDesc "The commands in reading order, each one's key its id; an empty key leaves its cell empty."
    field columns u32 "Columns; 0 is 5."
    field size f32 "A cell's side; 0 is 56 (48 on a phone)." {
      min 0
      unit cssPx
    }
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default bottomRight
    }
  }

  fn commandCard {
    doc "A command card to the bar of StarCraft II and Age of Empires IV: a grid of ability slots (abilitySlot, with its cooldowns, costs, charges and states) on one panel of the style's HUD glass (none when built in place), each with its hotkey a small muted letter in its top-left corner as grid layouts print it, empty cells the panel's well so the grid's places stay fixed."
    doc "Parts: CommandCard.frame, CommandCard.empty, CommandCard.key and each slot's. Accessibility: group named Commands. Probe ids: <id>, <id>/<key>, <id>/<key>/Slot/Key."
    host false
    param id String "Its id."
    param desc CommandCardDesc "The commands."
    returns AbilityBarResult
  }

  struct RtsConsoleDesc {
    doc "An RTS bottom console."
    desc true
    field map Option.MinimapViewDesc "The minimap zone at its start; null is none."
    field selection SelectionPanelDesc "The selection and unit card zones (its anchor is ignored)."
    field commands CommandCardDesc "The command card zone at its end (its anchor is ignored)."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default bottom
    }
  }

  struct RtsConsoleResult {
    doc "What an RTS console answered."
    field mapClicked bool "The minimap was pressed this tick (MinimapResult.clicked)."
    field clicked Option.String "A unit's tile pressed this tick (its key)."
    field group Option.String "A control group's tab pressed this tick (its key)."
    field cancelled Option.String "A queue item pressed this tick (its key)."
    field command Option.String "A command pressed and released this tick (its key)."
    field pressed List.String "The commands held."
  }

  fn rtsConsole {
    doc "An RTS bottom console to the bar of StarCraft II and Age of Empires IV: one continuous panel of the style's HUD glass along the bottom with four zones divided by hairlines, the minimap (minimapView, without its own bezel), the selection with its control group tabs over it, the focused unit's card with a building's production beside it (selectionPanel), and the command card (commandCard); every zone the same height. A screen too narrow for the four (a phone) drops the unit card to its line and the minimap out of the console (beside it in the bottom start corner where the band leaves the width, as a phone held sideways does, else the top end corner under what stands there), then stacks the command card over the selection."
    doc "Parts: RtsConsole.frame, RtsConsole.rule, and each zone's. Accessibility: group named Console. Probe ids: <id>, <id>/Map (the minimap's ids under it), <id>/Selection (selectionPanel's), <id>/Commands (commandCard's)."
    host false
    param id String "Its id."
    param desc RtsConsoleDesc "Its zones."
    returns RtsConsoleResult
  }

  struct DragSelectDesc {
    doc "An RTS drag selection."
    desc true
    field enabled bool "It follows the pointer: a press on the scene and a drag past the threshold draws the box." {
      default true
    }
    field from Option.Vector2 "Where the box starts, in the surface's pixels, instead of the press (a scripted or pad selection)."
    field to Option.Vector2 "Where it ends, with from."
    field threshold f32 "How far a press travels before it is a drag, not a click." {
      default 6
      min 0
      unit cssPx
    }
    field color Option.Paint "Its colour; null is the style's highlight."
    field exclude List.String "Element paths (HUD roots such as ConsoleHud) a press inside which is theirs, never the start of a box."
  }

  struct DragSelectResult {
    doc "What a drag selection answered."
    field dragging bool "The box is drawn this tick."
    field released bool "The box was let go this tick: select what lies inside x, y, width and height."
    field x f32 "The box's left." {
      unit cssPx
    }
    field y f32 "Its top." {
      unit cssPx
    }
    field width f32 "Its width." {
      unit cssPx
    }
    field height f32 "Its height." {
      unit cssPx
    }
  }

  fn dragSelect {
    doc "A drag-selection box to the bar of StarCraft II and Age of Empires IV: a thin bright edge over a faint fill of the style's highlight with small corner ticks, drawn from the press to the pointer once it travels past the threshold, answered as a rectangle the tick it is let go. A press on a HUD element is the element's, never a selection."
    doc "Parts: DragSelect.box, DragSelect.corner. Accessibility: none (the selection it makes is the game's). Probe ids: <id>."
    host false
    param id String "Its id."
    param desc DragSelectDesc "Where it follows from."
    returns DragSelectResult
  }

  struct DamageHit {
    doc "A hit from a direction."
    desc true
    field angle f32 "Where it came from, clockwise from straight ahead." {
      unit rad
    }
    field at u32 "og.ui.tick() when it landed."
    field strength f32 "How hard, 0 to 1 (its width and opacity)." {
      default 1
      unit ratio
    }
  }

  struct DamageDirectionDesc {
    doc "Damage direction indicators."
    desc true
    field hits List.DamageHit "Recent hits."
    field durationMs f32 "How long an indicator shows; 0 is 1400." {
      min 0
      unit ms
    }
    field radius f32 "Its distance from the centre; 0 is a fifth of the surface's shorter side." {
      min 0
      unit cssPx
    }
    field color Option.Paint "Its ink; null is danger."
  }

  fn damageDirection {
    doc "Damage direction to the bar of Call of Duty and Apex: a curved wedge round the centre toward each hit's source, wider and brighter for a harder hit, flaring in and fading over its time; the newest hits over the older."
    doc "Parts: DamageDirection.wedge. Accessibility: none (the game announces damage). Probe ids: <id>, <id>/Hit#i."
    host false
    param id String "Its id."
    param desc DamageDirectionDesc "The hits."
    returns Void
  }

  struct LowHealthDesc {
    doc "A low-health and hit vignette."
    desc true
    field health f32 "Health as a fraction, 0 to 1." {
      unit ratio
    }
    field threshold f32 "Under this the vignette shows, deepening to 0." {
      default 0.35
      unit ratio
    }
    field hitAt Option.u32 "og.ui.tick() of the last hit: a quick red flash at the edges."
    field color Option.Paint "Its ink; null is a deep red."
  }

  fn lowHealthVignette {
    doc "The low-health vignette of action games (a meta layer over the scene, under the HUD): red at the screen's edges deepening as health falls under the threshold, pulsing like a heartbeat faster near death, and a short flash on each hit. Under reduced motion it holds still at its depth."
    doc "Parts: none (a meta layer). Accessibility: none. Probe ids: its meta layer <id>."
    host false
    param id String "Its id."
    param desc LowHealthDesc "Health and the last hit."
    returns Void
  }

  # ── components: world (docs/ui.md §14, on anchored and mass elements) ──
  # Tags on a unit or a point (nameplates, prompts, waypoints, loot labels,
  # speech) open a world anchor and so draw under the screen's elements,
  # follow the camera, fade behind the scene and declutter. Thousands of
  # one kind (overhead bars, damage numbers) are mass elements. Shapes on
  # the ground (selection rings, telegraphs, path lines, placement ghosts)
  # are the ground plane's points projected with og.Camera and drawn as one
  # world element: flat at their height, so on uneven ground a decal of the
  # game's own follows the terrain better.

  enum Reaction {
    doc "How a unit stands toward the player, which colours its tag."
    variant hostile "An enemy (danger)."
    variant neutral "Neither (warn)."
    variant friendly "An ally or a friendly NPC (success)."
    variant player "Another player (info)."
    variant self "The player (primary)."
  }

  struct NameplateDesc {
    doc "A nameplate over a unit."
    desc true
    field target WorldTarget "What it sits over."
    field height f32 "World units above the target's point (its head)." {
      default 2
      unit m
    }
    field name String "The name."
    field title String "A line under it (<Guild>, a role); empty is none."
    field level String "Its level on a badge; empty is none."
    field reaction Reaction "Its colour."
    field health Option.f32 "Health 0 to 1 for a bar under the name; null draws none." {
      unit ratio
    }
    field shield f32 "An absorb over the health, 0 to 1." {
      unit ratio
    }
    field castName String "What it is casting; empty is nothing."
    field castProgress f32 "How far the cast is." {
      unit ratio
    }
    field icon String "A class, quest or role icon before the name."
    field unitClass UnitClass "Elite, rare or boss: a dressed frame."
    field targeted bool "The player's target: larger, outlined, drawn over the rest."
    field priority i32 "Who keeps its place when tags overlap: a nameplate ranks 100 over loot labels (the target 1000 more), and waypoints rank over every tag."
    field lod List.f32 "Distances where it sheds detail: past the first the title goes, past the second the name goes and only the bar stays; empty is 25 and 50."
    field maxDistance f32 "Hidden past this; 0 is 80." {
      unit m
      min 0
    }
    field occlusion WorldOcclusion "Behind the scene; the default fades."
  }

  fn nameplate {
    doc "A nameplate to the bar of World of Warcraft and Final Fantasy XIV: the name in its reaction's colour with a level badge and an icon, a title under it, a slim health bar with its absorb and a cast bar under that, an elite or boss frame, the target larger and outlined and kept on top; crowds stack instead of overlapping, it fades behind walls and sheds detail with distance (title, then name)."
    doc "Parts: Nameplate.frame[<reaction>][targeted][<class>], Nameplate.name, Nameplate.title, Nameplate.level, Nameplate.bar, Nameplate.fill[<reaction>], Nameplate.shield, Nameplate.cast. States: group lod (full, compact, bar), group selection (none, targeted). Accessibility: text named name, value level and health. Probe ids: <id>, <id>/Name, <id>/Bar/Fill, <id>/Cast."
    host false
    param id String "Its id."
    param desc NameplateDesc "The unit."
    returns AnchorInfo
  }

  struct OverheadBar {
    doc "One overhead bar."
    desc true
    field key String "The unit's key (its ghost is tracked by it)."
    field position Vector3 "The world point it sits on (over the unit's head)."
    field value f32 "Health 0 to 1." {
      unit ratio
    }
    field reaction Reaction "Its colour."
    field color Option.Paint "A colour of its own."
  }

  struct OverheadBarsDesc {
    doc "Overhead bars over many units."
    desc true
    field bars List.OverheadBar "The bars this tick."
    field width f32 "A bar's width; 0 is 56." {
      min 0
      unit cssPx
    }
    field height f32 "A bar's height; 0 is 6." {
      min 0
      unit cssPx
    }
    field reference f32 "The distance at which a bar is its size (nearer larger, farther smaller); 0 keeps the screen size." {
      default 12
      unit m
      min 0
    }
    field hideFull bool "A bar at full health is not drawn (an RTS's default)."
  }

  fn overheadBars {
    doc "Overhead bars to the bar of RTS and MOBA crowds (StarCraft II, League of Legends): one mass element per unit, thousands a frame, each a dark track with its fill in its reaction's colour and a pale ghost that holds after a hit then drains, scaled by distance and faded behind the scene."
    doc "Parts: none per bar (mass elements); the template is named <id>. Accessibility: none (the units' frames carry it). Probe: og.ui.massCount."
    host false
    param id String "Its id (its mass template's name)."
    param desc OverheadBarsDesc "The bars."
    returns Void
  }

  enum DamageKind {
    doc "What a damage number is."
    variant normal "A hit."
    variant critical "A critical hit: larger, in gold, popping past its size."
    variant heal "Healing: success, with a +."
    variant dot "Damage over time: smaller and dimmer."
    variant miss "A miss, a dodge, a block or immune: the word, grey."
    variant shield "Absorbed: the info colour."
    variant self "Damage the player took: danger."
  }

  struct DamageHitDesc {
    doc "A damage number to throw."
    desc true
    field position Vector3 "Where the hit landed (a world point)."
    field amount f64 "How much."
    field kind DamageKind "What it is."
    field word String "A miss's word (Miss, Dodge, Block, Immune); empty is Miss."
    field color Option.Paint "A damage type's colour (fire, frost); null is the kind's."
    field seed u32 "Which way it drifts (a hit's index)."
  }

  struct DamageNumbersDesc {
    doc "Damage numbers."
    desc true
    field hits List.DamageHitDesc "The hits that landed this tick (give each hit once)."
    field compact bool "12.3K over 12,300 (the default)." {
      default true
    }
    field size f32 "A normal hit's text size; 0 is 22." {
      min 0
      unit cssPx
    }
    field reference f32 "The distance at which numbers are their size; 0 keeps the screen size." {
      default 10
      unit m
      min 0
    }
  }

  fn damageNumbers {
    doc "Damage numbers to the bar of Diablo IV, Genshin Impact and World of Warcraft: each hit thrown from where it landed, rising and drifting to its side as it fades, outlined so it reads on any scene; a critical larger in gold, popping past its size and settling; heals in green with a +; damage over time smaller; misses as their word in grey; the player's own damage in danger; numbers compact past ten thousand. Mass elements: thousands at once, in the snapshot."
    doc "Parts: none per number (mass elements); the templates are named <id>.number and <id>.word. Accessibility: none (combat text is decoration; the game announces what matters). Probe: og.ui.massCount."
    host false
    param id String "Its id (its mass templates' prefix)."
    param desc DamageNumbersDesc "This tick's hits."
    returns Void
  }

  struct InteractionPromptDesc {
    doc "An interaction prompt over a thing."
    desc true
    field target WorldTarget "What it is over."
    field height f32 "World units above the target's point." {
      default 1.2
      unit m
    }
    field action String "The action whose glyph it shows, its binding on the device used last: a gameplay action's (og.input.glyph), else a UI action's (og.ui.glyph)."
    field verb String "What it does (Open, Talk, Pick up)."
    field name String "What it is (Chest); empty is none."
    field hold Option.f32 "A hold's progress 0 to 1: a ring fills round the glyph; null is a press." {
      unit ratio
    }
    field disabled bool "It cannot be used now (locked, out of reach): dimmed, with reason."
    field reason String "Why it cannot (Locked)."
    field maxDistance f32 "Hidden past this; 0 is 6." {
      unit m
      min 0
    }
  }

  fn interactionPrompt {
    doc "An interaction prompt to the bar of The Last of Us, Elden Ring and Genshin Impact: the action's glyph for the device used last (a key cap, a pad's face button) and the verb, the thing's name over it, a ring filling round the glyph for a hold and a pop when it completes, dimmed with its reason when it cannot be used; it springs in when it appears and stays upright and readable at any distance it shows."
    doc "Parts: InteractionPrompt.frame[disabled], InteractionPrompt.glyph, InteractionPrompt.hold, InteractionPrompt.verb, InteractionPrompt.name, InteractionPrompt.reason. States: group use (ready, holding, disabled). Accessibility: button named the verb and name, value the glyph's text. Probe ids: <id>, <id>/Glyph, <id>/Verb."
    host false
    param world World "The world (for the glyph)."
    param id String "Its id."
    param desc InteractionPromptDesc "The action and the thing."
    returns AnchorInfo
  }

  enum WaypointKind {
    doc "What a waypoint marks."
    variant objective "A quest or mode objective (gold)."
    variant marker "The player's own marker (info)."
    variant ping "A teammate's ping (warn), pulsing; it leaves after its time."
    variant enemy "A spotted enemy (danger)."
    variant ally "A teammate (their colour)."
    variant loot "Loot (its rarity)."
  }

  struct WaypointDesc {
    doc "A waypoint or a ping in the world."
    desc true
    field target WorldTarget "What it marks."
    field height f32 "World units above the point." {
      default 0.5
      unit m
    }
    field kind WaypointKind "What it is."
    field icon String "Its icon; empty is the kind's."
    field label String "A word under it (Defend, Enemy spotted); empty is none."
    field by String "Who pinged it (shown with the label)."
    field color Option.Paint "A colour of its own."
    field rarity Rarity "Loot's tier."
    field at u32 "og.ui.tick() when it was placed: a ping drops in and pulses from then."
    field durationMs f32 "A ping leaves after this; 0 is 8000 for a ping, never for the rest." {
      min 0
      unit ms
    }
    field units String "The distance's unit." {
      default "m"
    }
    field clampMargin f32 "Inset from the safe area's edges when clamped; 0 is 32." {
      min 0
      unit cssPx
    }
  }

  fn waypoint {
    doc "A waypoint or ping to the bar of Apex Legends and Destiny: a diamond with its kind's icon in its colour, the distance under it, a label and who pinged it; off screen or behind it stays on the safe area's edge with an arrow toward its point; a ping drops in with rings rippling from it and leaves after its time; it shrinks a little far away and dims when the crosshair is not near."
    doc "Parts: Waypoint.marker[<kind>][clamped], Waypoint.icon, Waypoint.distance, Waypoint.label, Waypoint.ripple. States: group place (onScreen, clamped). Sounds: notify when a ping lands. Accessibility: image named the label, value the distance. Probe ids: <id>, <id>/Marker, <id>/Distance, <id>/Label."
    host false
    param id String "Its id."
    param desc WaypointDesc "What it marks."
    returns AnchorInfo
  }

  struct GroundDesc {
    doc "What a ground shape (a selection ring, a telegraph, a path line, a placement ghost) lies on: its outline is cut into vertices `spacing` apart and each is lifted to the surface under it, so it follows a slope or terrain instead of floating over or cutting into it. With neither a terrain nor colliders it lies flat at its points' own y."
    desc true
    field terrain TerrainData "A terrain sampled under each vertex (og.terrain.sample); 0 is none."
    field origin Vector3 "Where the terrain stands: its og.Terrain entity's world position."
    field quaternion Quaternion "How the terrain is turned (the zero value: along world x and z)."
    field scale Vector3 "How the terrain is scaled." {
      default 1 1 1
    }
    field colliders bool "Also cast straight down against colliders (og.physics.raycast, as the tick began); the highest surface of the two wins. Exclude the unit itself (exclude) or keep units off mask's layers, or the ring climbs onto it."
    field mask u32 "The layers the downward cast considers; 0 every layer."
    field exclude Option.Entity "An entity the cast ignores (the selected unit)."
    field reach f32 "How far above and below a vertex's own y the cast looks." {
      default 50
      min 0.1
    }
    field bias f32 "Lifted this far above the surface, so the shape never z-fights or sinks between samples." {
      default 0.04
      min 0
    }
    field spacing f32 "The longest edge between sampled vertices; a shape's outline keeps to 512 vertices, spacing them wider when it would need more." {
      default 0.5
      min 0.05
    }
  }

  struct SelectionRingDesc {
    doc "A selection ring on the ground."
    desc true
    field center Vector3 "Its centre on the ground (a unit's feet)."
    field radius f32 "Its radius." {
      default 0.6
      unit m
      min 0
    }
    field reaction Reaction "Its colour (friendly green, hostile red, as RTS rings)." {
      default self
    }
    field color Option.Paint "A colour of its own."
    field hover bool "Hovered, not selected: thin and dim."
    field selectedAt u32 "og.ui.tick() when it was selected: it springs in from larger."
    field segments u32 "Broken into this many arcs turning slowly (a target ring); 0 is a whole ring."
    field ground Option.GroundDesc "What it lies on; null lies flat at its points' y."
  }

  fn selectionRing {
    doc "A selection ring to the bar of StarCraft II and Baldur's Gate 3: an ellipse on the ground under the unit (the ground circle projected, lying on the terrain or colliders under it with desc.ground), a bright edge and a soft inner glow in its reaction's colour, springing in from larger when selected, thin and dim on hover, or broken into arcs turning slowly."
    doc "Parts: SelectionRing.ring[<reaction>][hover], SelectionRing.glow. Accessibility: none (the unit's frame is selected). Probe ids: <id>, its shapes <id>/Box/Ring (or Arc#i) and Glow, each bounded by its points."
    host false
    param world World "The world: its og.Camera projects the ground, so the calling system declares og.Camera among its reads."
    param id String "Its id."
    param desc SelectionRingDesc "Where and how."
    returns Void
  }

  enum TelegraphShape {
    doc "A telegraph's area."
    variant circle "A disc of radius."
    variant ring "A ring between inner and radius (stand inside or outside it)."
    variant cone "A cone of angle, radius long, toward direction."
    variant line "A rectangle width wide and radius long toward direction (a charge)."
  }

  struct TelegraphDesc {
    doc "An area an attack will hit."
    desc true
    field center Vector3 "Its origin on the ground."
    field shape TelegraphShape "Its area."
    field radius f32 "A disc's or ring's radius, a cone's or line's length." {
      default 4
      unit m
      min 0
    }
    field inner f32 "A ring's inner radius." {
      unit m
      min 0
    }
    field angle f32 "A cone's width." {
      default 1.0471976
      unit rad
    }
    field width f32 "A line's width." {
      default 2
      unit m
      min 0
    }
    field direction f32 "Which way a cone or line faces, clockwise from +z seen from above (0 is +z, π/2 is +x)." {
      unit rad
    }
    field progress f32 "The wind-up 0 to 1: the fill grows to the edge as the hit nears." {
      unit ratio
    }
    field hostile bool "An enemy's (danger, the default); else an ally's (info)." {
      default true
    }
    field color Option.Paint "A colour of its own."
    field ground Option.GroundDesc "What it lies on; null lies flat at its points' y."
  }

  fn telegraph {
    doc "An attack telegraph to the bar of Final Fantasy XIV and WildStar: the area on the ground (disc, ring, cone or line; with desc.ground over slopes and hills, every vertex on the surface) tinted in danger with a bright edge, a fill growing from its origin to the edge as the wind-up runs so the moment of impact reads without a number, and a flash as it lands."
    doc "Parts: Telegraph.area[<shape>][hostile|friendly], Telegraph.edge, Telegraph.fill, Telegraph.flash. States: group windup (charging, impact). Accessibility: none (the game announces what is dangerous). Probe ids: <id>, <id>/Box/Area, Fill, Edge#i."
    host false
    param world World "The world: its og.Camera projects the ground, so the calling system declares og.Camera among its reads."
    param id String "Its id."
    param desc TelegraphDesc "The area and the wind-up."
    returns Void
  }

  struct PathLineDesc {
    doc "A path on the ground."
    desc true
    field points List.Vector3 "The path's world points, from the mover."
    field reach f32 "How far along it the mover can go this turn: past it the line turns danger; 0 is all of it." {
      unit m
      min 0
    }
    field label String "A label at its end (12 m · 2 AP); empty is none."
    field invalid bool "It cannot be taken: danger, with a cross at its end."
    field color Option.Paint "Its colour; null is the highlight."
    field width f32 "Its width; 0 is 4." {
      min 0
      unit cssPx
    }
    field arrow bool "An arrow head at its end (the default)." {
      default true
    }
    field ground Option.GroundDesc "What it lies on; null lies flat at its points' y."
  }

  fn pathLine {
    doc "A path line to the bar of Baldur's Gate 3, XCOM 2 and RTS move orders: the route on the ground (draped on the surface with desc.ground) as a line with chevrons marching toward its end, the part past this turn's reach in danger, an arrow head or a destination ring at its end with a label (the distance, the cost), a cross when it cannot be taken."
    doc "Parts: PathLine.line[reach|beyond][invalid], PathLine.chevron, PathLine.end, PathLine.label. Accessibility: text named the label. Probe ids: <id>, <id>Label (the label, a tag of its own: it declutters with the other tags and stays in the safe area)."
    host false
    param world World "The world: its og.Camera projects the ground, so the calling system declares og.Camera among its reads."
    param id String "Its id."
    param desc PathLineDesc "The route."
    returns Void
  }

  struct PlacementGhostDesc {
    doc "A building's footprint while it is placed."
    desc true
    field center Vector3 "Its footprint's centre on the ground."
    field width f32 "Its width along x before rotation." {
      default 2
      unit m
      min 0
    }
    field depth f32 "Its depth along z." {
      default 2
      unit m
      min 0
    }
    field rotation f32 "Its turn about y, clockwise from above." {
      unit rad
    }
    field cell f32 "The grid's cell; the footprint shows its cells; 0 shows none." {
      unit m
      min 0
    }
    field valid bool "It can be placed here (success); else danger with hatching." {
      default true
    }
    field label String "Its cost or why not (Blocked); empty is none."
    field range Option.f32 "A range ring round it (a tower's reach)." {
      unit m
    }
    field ground Option.GroundDesc "What it lies on; null lies flat at its points' y."
  }

  fn placementGhost {
    doc "A placement ghost to the bar of Age of Empires IV, Anno and Cities: Skylines: the footprint on the ground (draped on the surface with desc.ground) in success or danger (hatched when invalid, so it is not told by colour alone), its grid cells, a range ring for a tower's reach, and its cost or the reason it cannot go there; it breathes while held."
    doc "Parts: PlacementGhost.footprint[valid|invalid], PlacementGhost.cells, PlacementGhost.range, PlacementGhost.label. States: group place (valid, invalid). Accessibility: status named the label. Probe ids: <id>, <id>Label (the label, a tag of its own: it declutters with the other tags and stays in the safe area)."
    host false
    param world World "The world: its og.Camera projects the ground, so the calling system declares og.Camera among its reads."
    param id String "Its id."
    param desc PlacementGhostDesc "The footprint."
    returns Void
  }

  struct LootLabelDesc {
    doc "A label on an item lying in the world."
    desc true
    field target WorldTarget "The item."
    field height f32 "World units above it." {
      default 0.4
      unit m
    }
    field name String "The item's name."
    field rarity Rarity "Its tier: colour, pips, and a beam from rare up."
    field count u32 "A stack's count (×3); 0 and 1 show none."
    field icon String "Its icon."
    field beam bool "A light beam over it (the default for rare and up)." {
      default true
    }
    field maxDistance f32 "Hidden past this; 0 is 40." {
      unit m
      min 0
    }
  }

  struct LootLabelResult {
    doc "What a loot label answered."
    field clicked bool "Pressed this tick (pick it up)."
    field hovered bool "Under the pointer (show its tooltip)."
    field info AnchorInfo "Where it stands."
  }

  fn lootLabel {
    doc "A loot label to the bar of Diablo IV, Path of Exile and Borderlands: the name on a dark chip edged in its rarity's colour with pips so tiers do not rest on colour alone, the stack's count, a beam of light rising over rare and better items, labels stacking instead of overlapping (higher rarity on top), pressable to pick up."
    doc "Parts: LootLabel.chip[rarity=<r>], LootLabel.name, LootLabel.pip, LootLabel.count, LootLabel.beam. Accessibility: button named the name, value its rarity. Probe ids: <id>, <id>/Chip/Name."
    host false
    param id String "Its id."
    param desc LootLabelDesc "The item."
    returns LootLabelResult
  }

  struct SpeechBubbleDesc {
    doc "A speech bubble over a speaker."
    desc true
    field target WorldTarget "The speaker."
    field height f32 "World units above the speaker's point." {
      default 2.2
      unit m
    }
    field text String "What is said."
    field speaker String "Who says it, over the text; empty is none."
    field at u32 "og.ui.tick() when it was said: it types out from then and leaves after its time."
    field charsPerSecond f32 "How fast it types; 0 shows it at once." {
      default 40
      min 0
    }
    field durationMs f32 "How long it stays after it has typed; 0 is 1500 plus 60 per character." {
      min 0
      unit ms
    }
    field shout bool "A shout: bold, a jagged edge."
    field thought bool "A thought: rounder, the tail as bubbles."
    field maxWidth f32 "Its widest; 0 is 260." {
      min 0
      unit cssPx
    }
    field clamp bool "Off screen, it stays on the edge so its words are not missed."
  }

  fn speechBubble {
    doc "A speech bubble to the bar of Animal Crossing, Sea of Thieves and The Sims: a rounded bubble over the speaker with a tail pointing down to them, the speaker's name, the text typing out with a soft tick of sound, popping in and fading out after a time that grows with its length; a shout jagged and bold, a thought round with its tail as bubbles; it can hold on the edge when the speaker is off screen."
    doc "Parts: SpeechBubble.bubble[shout|thought], SpeechBubble.tail, SpeechBubble.speaker, SpeechBubble.text. States: group speech (typing, shown, leaving). Sounds: counterTick as it types. Accessibility: text named the speaker, value the whole text (a screen reader hears it at once). Probe ids: <id>, <id>/Bubble/Text, <id>/Bubble/Speaker."
    host false
    param id String "Its id."
    param desc SpeechBubbleDesc "The words."
    returns AnchorInfo
  }

  # ── element draws (docs/ui.md §5): shapes, paints, effects, masks, layers ──

  handle VectorArt "A cooked vector (an `.ogt` of `type vector`: an SVG subset) from og.load.vector, drawn by a VectorFill."
  handle UiMaterial "A custom UI material (an `.ogt` of `type ui-material`) from og.load.uiMaterial, which a LayerDesc composites through."

  column VectorArt {
    doc "A VectorArt handle field (0 is none): a vector og.load.vector answered, kept for a VectorFill."
    array Uint32Array
    stride 2
    value VectorArt
  }

  column UiMaterial {
    doc "A UiMaterial handle field (0 is none): a UI material og.load.uiMaterial answered, kept for a LayerDesc or a custom paint."
    array Uint32Array
    stride 2
    value UiMaterial
  }

  enum ShapeType {
    doc "An element's outline (DrawShape.kind)."
    variant rect "Its rectangle, with DrawShape.radii (or its radius) and corner."
    variant ellipse "The ellipse inscribed in its rectangle (a circle when square; a capsule is a rect with radii of half its height)."
    variant polygon "A regular polygon of sides vertices on the circle in its rectangle, the first at the top; inner under 1 makes a star."
    variant arc "A ring segment on the circle in its rectangle: start, sweep and thickness (a ring at a full turn), with caps."
    variant path "A line through points (CSS px from its top left), Béziers with curves; its fills draw the line."
  }

  enum CornerShape {
    doc "How a rect's corners turn."
    variant round "Circular arcs."
    variant squircle "Continuous corners: a superellipse of DrawShape.squircle."
    variant bevel "A straight cut across, the radius along each edge."
    variant notch "A concave quarter circle cut in (an inset notch)."
  }

  enum LineCap {
    doc "The end of an open line, an arc or a dash."
    variant butt "Cut square at the end."
    variant round "A half disc past the end."
    variant square "Cut square half the width past the end."
  }

  enum LineJoin {
    doc "Where a line's segments meet."
    variant miter "Sharp, cut to a bevel past DrawShape.miterLimit half widths."
    variant round "Rounded."
    variant bevel "Cut across."
  }

  struct DrawShape {
    doc "An element's outline; its fills, strokes, effects and clip take it."
    desc true
    field kind ShapeType "Which outline."
    field radii Option.Array.f32.4 "A rect's corner radii, top left, top right, bottom right, bottom left; null is the element's radius at every corner." {
      unit cssPx
    }
    field corner CornerShape "A rect's corner shape."
    field squircle f32 "A squircle corner's exponent: 2 is round, 4 the iOS look." {
      default 4
      min 2
      max 12
    }
    field sides u32 "A polygon's vertices." {
      default 6
      min 3
      max 64
    }
    field inner f32 "A star's inner vertices as a fraction of its radius; 1 (or more) is a plain polygon." {
      default 1
      min 0
      unit ratio
    }
    field rounding f32 "A polygon's corner rounding." {
      unit cssPx
    }
    field rotation f32 "A polygon's turn, clockwise." {
      unit rad
    }
    field start f32 "An arc's start, clockwise from 3 o'clock." {
      unit rad
    }
    field sweep f32 "An arc's sweep, clockwise (a full turn or more: a ring)." {
      default 6.2831855
      unit rad
    }
    field thickness f32 "An arc's thickness, inwards from the circle." {
      default 4
      unit cssPx
    }
    field cap LineCap "An arc's or a path's ends."
    field points List.Vector2 "A path's points, CSS px from the element's top left." {
      unit cssPx
    }
    field curves bool "A path's points after the first come in threes: a cubic Bézier's two controls and its end."
    field closed bool "A path returns to its first point."
    field filled bool "A path is an area: its fills cover the inside of the closed outline through its points (even-odd) instead of drawing its line, and its strokes outline it, as any other shape's (an area chart, a radar's polygon, a pie's wedge)."
    field width f32 "A path's line width." {
      default 2
      min 0
      unit cssPx
    }
    field join LineJoin "Where a path's segments meet."
  }

  enum GradientType {
    doc "How a gradient (Gradient.type) runs over the element's box (fractions: 0,0 top left, 1,1 bottom right)."
    variant linear "From `from` to `to`."
    variant radial "Centred on `from`, `to` its x and y radii."
    variant conic "Around `from`, starting at the angle to.x (radians clockwise from 3 o'clock)."
    variant diamond "Centred on `from`, `to` its x and y radii, by |x|/rx + |y|/ry."
  }

  enum GradientSpread {
    doc "What a gradient does past its ends."
    variant pad "Holds the end stops' colours."
    variant repeat "Starts over."
    variant reflect "Runs back and forth."
  }

  struct GradientStop {
    doc "A gradient's colour at an offset."
    desc true
    field offset f32 "Where along the gradient, 0 to 1." {
      min 0
      max 1
      unit ratio
    }
    field color Paint "Its colour: a theme token, resolved when the frame is drawn, or a literal."
  }

  struct Gradient {
    doc "A gradient of up to 8 stops, mixed in OKLab (no grey middle between complementary colours) and dithered so a long shallow one shows no bands."
    desc true
    field type GradientType "Its shape."
    field from Vector2 "Its start or centre, a fraction of the box." {
      unit ratio
    }
    field to Vector2 "Its end, or its radii, a fraction of the box." {
      default 0 1
      unit ratio
    }
    field stops List.GradientStop "Its stops in order (at most 8)."
    field spread GradientSpread "Past its ends."
    field noDither bool "Draws it without the dither."
  }

  enum ImageFit {
    doc "How an image fills the element's box."
    variant fill "Stretched to the box."
    variant cover "Scaled to cover the box, cropped around the focal point."
    variant contain "Scaled to fit inside the box, placed by the focal point."
    variant none "At its own size (one image pixel per CSS px), placed by the focal point."
    variant nineSlice "Nine-slice: corners kept at slice, edges and centre filled by edges."
    variant pattern "Tiled at tile CSS px, turned, offset and scrolling."
  }

  enum SliceEdges {
    doc "How a nine-slice's edges and centre fill their length."
    variant stretch "Stretched."
    variant repeat "Tiled at the border's scale, cut at the end."
    variant round "Tiled a whole number of times, stretched to fit."
  }

  struct SolidFill {
    doc "A colour."
    desc true
    field color Paint "The colour: a theme token, resolved when the frame is drawn, or a literal."
  }

  struct ImageFill {
    doc "A texture region with a fit."
    desc true
    field texture Texture "The texture (og.load.texture)."
    field uv Option.Array.f32.4 "The region, [u0, v0, u1, v1] with v down; null is the whole texture."
    field size Vector2 "The region's size in image pixels (none, nineSlice and pattern read it); zero is the texture's."
    field tint Option.Paint "Multiplies it; null is white."
    field fit ImageFit "How it fills the box."
    field focal Vector2 "Where cover crops and contain or none place it, fractions of the free space." {
      default 0.5 0.5
      unit ratio
    }
    field slice Array.f32.4 "A nine-slice's border in image pixels: left, top, right, bottom."
    field border Option.Array.f32.4 "A nine-slice's border as drawn, CSS px; null is slice."
    field edges SliceEdges "A nine-slice's edges and centre."
    field hollow bool "A nine-slice leaves its centre empty."
    field tile Vector2 "A pattern's tile, CSS px; zero is size." {
      unit cssPx
    }
    field patternRotation f32 "A pattern's turn." {
      unit rad
    }
    field offset Vector2 "A pattern's offset." {
      unit cssPx
    }
    field scroll Vector2 "A pattern's scroll, CSS px a second of the UI clock." {
      unit cssPx
    }
  }

  struct VectorFill {
    doc "A cooked vector contained and centred in the box."
    desc true
    field vector VectorArt "The vector (og.load.vector)."
    field tint Option.Paint "Multiplies its paints; null is white."
  }

  union Fill {
    doc "One layer of an element's fill, or a stroke's paint."
    tag kind
    case solid SolidFill "A colour."
    case gradient Gradient "A gradient."
    case image ImageFill "An image with a fit, a nine-slice or a pattern."
    case vector VectorFill "A cooked vector (as a stroke's paint, its tint)."
  }

  enum StrokeAlign {
    doc "Which side of the outline a stroke lies on."
    variant center "Across the outline."
    variant inside "Inside it."
    variant outside "Outside it."
  }

  struct Stroke {
    doc "A stroke along the element's outline with a paint of its own (a gradient border is one stroke)."
    desc true
    field width f32 "Its width." {
      default 1
      min 0
      unit cssPx
    }
    field align StrokeAlign "Which side of the outline."
    field dash f32 "A dash's length; 0 is solid." {
      min 0
      unit cssPx
    }
    field gap f32 "The gap between dashes; 0 is the dash's length." {
      min 0
      unit cssPx
    }
    field dashOffset f32 "Where the dashes start along the outline (move it by the tick for marching ants)." {
      unit cssPx
    }
    field dashCap LineCap "The dashes' ends."
    field paint Option.Fill "Its paint; null is the theme's line colour."
  }

  struct ShadowEffect {
    doc "A shadow: a drop shadow under the element, or an inner shadow cast inwards."
    desc true
    field offset Vector2 "How far it falls." {
      default 0 4
      unit cssPx
    }
    field blur f32 "Its softness (CSS blur: the Gaussian's deviation is half of it)." {
      default 12
      min 0
      unit cssPx
    }
    field spread f32 "How far it grows (or with a negative value shrinks) past the shape." {
      unit cssPx
    }
    field color Option.Paint "Its colour; null is the theme's shadow."
  }

  struct GlowEffect {
    doc "A glow: around the element, or along its inside."
    desc true
    field blur f32 "Its softness." {
      default 12
      min 0
      unit cssPx
    }
    field spread f32 "How far it grows past the shape." {
      unit cssPx
    }
    field color Option.Paint "Its colour; null is the theme's primary."
  }

  struct BlurEffect {
    doc "The element and its subtree blurred (drawn offscreen)."
    desc true
    field radius f32 "The blur." {
      default 4
      min 0
      unit cssPx
    }
  }

  struct BackdropEffect {
    doc "What is under the element (the scene and the UI below it) blurred, its saturation and brightness scaled and tinted: glass."
    desc true
    field blur f32 "The blur." {
      default 16
      min 0
      unit cssPx
    }
    field saturation f32 "Multiplies the saturation." {
      default 1
      min 0
      unit ratio
    }
    field brightness f32 "Multiplies the brightness." {
      default 1
      min 0
      unit ratio
    }
    field tint Option.Paint "Over the blur, by its alpha; null is the theme's panel at 60 % (with a glass weight, the weight's tint)."
    field glass GlassWeight "One of flat glass's weights (docs/ui.md §5.3): it sets the blur, 200 % saturation, the tint (unless tint is given), a 0.5 px hairline inside the edge and CSS mixing, in the theme's scheme; under reduced transparency the solid raised surface, under high contrast solid with a strong 1 px edge. none is the fields as given."
    field elevation Elevation "The soft shadow outside it, as the design language's shadows (with a glass weight, raised by default)."
    field edge f32 "A hairline just inside the edge (CSS inset 0 0 0 <edge>px); 0 is none, or the weight's." {
      min 0
      unit cssPx
    }
    field edgeColor Option.Paint "The hairline's colour; null is the weight's (or the theme's line)."
    field solid bool "The tint drawn opaque, with the hairline and shadow: nothing under it is read (reduced transparency, increased contrast)."
    field cssMix bool "Mix the tint, hairline and shadow in sRGB-encoded values, as CSS does, so a tint reads as it does on a web page (glass weights always do)."
  }

  enum GlassWeight {
    doc "How heavy a glass surface is: flat glass, clear and coloured by what passes under it, with no rim, sheen or refraction."
    variant none "No weight: the backdrop's own fields."
    variant thin "10 px of blur and the lightest tint: icons and play discs over art, never text (it does not hold text at 4.5:1)."
    variant regular "22 px: bars, tab bars, capsules; holds the scheme's text at 4.5:1."
    variant thick "32 px and a denser tint: menus, popovers, dialogs, sheets, toasts."
  }

  enum Elevation {
    doc "The soft shadow a glass surface casts."
    variant none "No shadow (with a glass weight: raised)."
    variant raised "The hairline alone (an outer one in the light scheme)."
    variant float "One soft, short shadow: capsules and menus."
    variant lift "Two deeper shadows: dialogs and sheets."
  }

  union Effect {
    doc "An effect of the element."
    tag kind
    case dropShadow ShadowEffect "A drop shadow (several layer)."
    case innerShadow ShadowEffect "An inner shadow."
    case outerGlow GlowEffect "A glow around it."
    case innerGlow GlowEffect "A glow along its inside."
    case layerBlur BlurEffect "Its subtree blurred."
    case backdrop BackdropEffect "Glass: what is under it blurred."
  }

  enum ClipMode {
    doc "How an element cuts its children."
    variant none "Not at all (a scroll container still clips to its rectangle)."
    variant shape "To its shape, antialiased (a round avatar, a hex frame)."
    variant mask "By DrawDesc.mask's alpha (the subtree draws offscreen)."
  }

  struct MaskDesc {
    doc "An alpha mask over an element's subtree: a gradient's alpha, else an image's."
    desc true
    field gradient Option.Gradient "The gradient whose alpha masks (a list fading at its edge)."
    field texture Option.Texture "The image whose alpha masks, stretched over the element."
    field uv Option.Array.f32.4 "The image's region; null is the whole texture."
  }

  enum MaterialName {
    doc "What a layer composites through: a built-in UI material, or a custom one. params is read per material."
    variant plain "The layer as drawn."
    variant dissolve "[threshold 0–1, edge width, noise scale (CSS px), _], [edge colour rgba]."
    variant shine "[position 0–1 across the diagonal (negative sweeps by the clock at -position a second), width, angle (rad), intensity], [colour rgba]."
    variant hologram "[scanline spacing (CSS px), flicker 0–1, chromatic split (CSS px), scanline strength], [tint rgba]."
    variant glitch "[strength 0–1, slice height (CSS px), split (CSS px), rate (Hz)]."
    variant ripple "[amplitude (CSS px), wavelength (CSS px), speed (CSS px/s), _], [centre x, y as fractions]."
    variant pixelate "[cell size (CSS px)]."
    variant colorAdjust "[hue (rad), saturation, brightness, grayscale 0–1]."
    variant outline "[width (CSS px), _, _, _], [colour rgba]: an outline of the layer's alpha."
    variant blur "[radius (CSS px)]."
    variant custom "LayerDesc.custom, a `type ui-material`."
  }

  struct LayerDesc {
    doc "The element's subtree drawn offscreen, then composited through a material (a card that dissolves, a hologram panel)."
    desc true
    field material MaterialName "The material."
    field custom Option.UiMaterial "The custom material, for material custom."
    field params List.f32 "Its parameters: up to four vec4s, flattened (16 numbers); for a custom material, missing ones are its defaults."
  }

  struct TextShadowDesc {
    doc "A shadow under an element's text."
    desc true
    field offset Vector2 "How far it falls." {
      default 0 2
      unit cssPx
    }
    field blur f32 "Its softness." {
      default 2
      min 0
      unit cssPx
    }
    field color Option.Paint "Its colour; null is the theme's shadow."
  }

  struct TextOutlineDesc {
    doc "An outline around an element's glyphs."
    desc true
    field width f32 "Its width (up to the font's distance range)." {
      default 2
      min 0
      unit cssPx
    }
    field color Option.Paint "Its colour; null is the theme's shadow."
    field align StrokeAlign "Across the glyph's edge, inside it or outside it."
  }

  struct TextEffectsDesc {
    doc "Effects of the text an element holds (its labels and rich text)."
    desc true
    field shadows List.TextShadowDesc "Shadows, under everything, in order."
    field outline Option.TextOutlineDesc "An outline."
    field fill Option.Gradient "A gradient fill over each line's box instead of its colour."
  }

  struct DrawDesc {
    doc "What an element draws with (og.ui.setDraw), over its background: its shape, fills and strokes in order, effects, opacity and blend, how it clips its children, and whether its subtree draws offscreen through a material. Colours given as theme tokens follow the style; every value is data an agent can read and set."
    desc true
    field shape Option.DrawShape "Its outline; null is its rectangle with its radius."
    field fills List.Fill "Fills, bottom first."
    field strokes List.Stroke "Strokes, over the fills and the children, bottom first."
    field effects List.Effect "Shadows, glows, blurs and backdrops."
    field opacity f32 "Multiplies its paints (with a layer, its composite)." {
      default 1
      min 0
      max 1
    }
    field blend BlendMode "How its paints (or its layer) mix with what is under them."
    field clip ClipMode "How it cuts its children."
    field mask Option.MaskDesc "The mask, for clip mask."
    field layer Option.LayerDesc "Its subtree drawn offscreen and composited through a material."
    field text Option.TextEffectsDesc "Effects of its text."
    field dressable bool "The draw is a component's own look for the part its element names (ElementDesc.part): where the style dresses that part, each list the dressing sets (fills, strokes, effects, material, mask, blend) replaces the draw's, a rect takes the dressing's corner, and atlas art replaces the draw. The draw's shape stays, so a ring, a star or a segment keeps its geometry in every style. False: the draw is the game's and the style never touches it."
  }

  enum BlendMode {
    doc "How a paint mixes with what is under it."
    variant normal "Over it."
    variant multiply "Multiplied: darkens."
    variant screen "Screened: lightens."
    variant add "Added: glows."
    variant overlay "Multiply under half grey, screen over it."
    variant softLight "A gentle overlay."
    variant colorDodge "Brightens what is under it by the paint."
  }

  struct SemanticsDesc {
    doc "What a component tells the accessibility tree about an element it built from containers (docs/ui.md §11): a role other than its kind's, a name, a value and states. Absent fields leave what the element's kind gives it."
    desc true
    field role String "Its role: button, link, text, heading, image, checkbox, radio, switch, slider, spinbutton, textbox, combobox, listbox, option, tab, tablist, tabpanel, radiogroup, progressbar, meter, timer, status, alert, log (a feed whose new lines are read: a killfeed, subtitles), dialog, alertdialog, tooltip, separator, group, region, navigation, toolbar, menu, menubar, menuitem, menuitemcheckbox, menuitemradio, list, listitem, tree, treeitem, table, grid, row, rowheader, columnheader, cell, gridcell, figure or scrollbar; empty keeps its kind's."
    field name Option.String "Its accessible name; null keeps what it shows."
    field description Option.String "Read after the name; null is none."
    field value Option.String "Its value as people read it (`3 of 12`, `Sorted ascending`); null is none."
    field checked Option.bool "Checked (a menu item's check); null is not checkable."
    field selected Option.bool "Selected (a tab, a row, an option); null is not selectable."
    field expanded Option.bool "Expanded (an accordion header, a tree item, a menu button); null is not expandable."
    field busy bool "Loading."
    field disabled bool "Shown but inert (a disabled menu item, a locked tab): disabled in the tree, and its interaction state group's disabled state."
    field valueMin Option.f32 "A range's smallest value."
    field valueMax Option.f32 "A range's largest value."
    field valueNow Option.f32 "A range's value as a number (a scroll position, a page); null is no range."
  }

  fn semantics {
    doc "Give the element built just before (a container just closed, or a widget) a role, a name, a value and states for the accessibility tree and the probe's dump (dump_ui's role, name, value, states). Components built from containers call it so a screen reader meets a menu, a tree or a table, not rows of buttons. Answers false, with a frame warning, when no element was built before it or the role is unknown."
    param desc SemanticsDesc "Its role, name, value and states."
    returns bool
  }

  fn partAttr {
    doc "Gives the element open now (a grid's cell, a panel, a card) a selector attribute its style dresses by: partAttr(\"rarity\", \"epic\") in a bag's cell makes it `Slot.frame[rarity=epic]`, so a style that dresses the tier recolours the cell's own frame (one stroke, never a second). Call it right after the element opens, inside it."
    param key String "The attribute's name (rarity, tone, team)."
    param value String "Its value (epic, success)."
    returns bool "Whether the style dresses this part by the attribute (for any of its values, `Slot.frame[rarity=rare]` answers for every tier): false, its values draw alike, and a caller that wants a mark draws its own."
  }

  fn setDraw {
    doc "Draws the element added last (a container just opened, or the last control) with desc: shapes beyond rectangles, layered gradient, image and vector fills, strokes with their own paints, shadows, glows, glass, clipping to its shape, masks, blend modes and materials (docs/ui.md §5). Call it right after the element's open or control; immediate mode, so every tick it is drawn."
    param desc DrawDesc "What it draws with."
    returns Void
  }

  # ── world-space UI (docs/ui.md §14, §5.5) ───────────────────────────────

  struct WorldTarget {
    doc "What an anchored element or a world panel is placed on: an entity (its world pose, down og.Parent) or a world point."
    desc true
    field entity Option.Entity "The entity; null places it on point."
    field point Vector3 "The world point, when entity is null."
  }

  enum AnchorScaleMode {
    doc "How an anchored element's size follows its distance from the camera."
    variant constant "Its laid-out size at every distance (a nameplate that stays readable)."
    variant distance "1 at reference world units, larger nearer and smaller farther, between minScale and maxScale (a tag that feels in the world)."
  }

  enum WorldOcclusion {
    doc "What the scene in front of an anchored element does to it: a depth test of its point against the frame's depth, on the GPU."
    variant none "Drawn over the scene."
    variant fade "Drawn at occludedAlpha where the scene is in front."
    variant hide "Not drawn where the scene is in front."
  }

  enum Declutter {
    doc "How an anchored element that overlaps one of higher priority (or as high and nearer) resolves."
    variant none "It overlaps."
    variant shift "Moved the shortest way clear (else stacked above)."
    variant stack "Moved above what it overlaps, one over another (a crowd's nameplates)."
    variant hide "Faded out while it overlaps."
  }

  struct EdgeClampDesc {
    doc "Edge clamping for a waypoint or a ping: off the screen or behind the camera it stays inside the safe area, on the edge toward its point, with an arrow pointing there."
    desc true
    field margin f32 "Inset from the safe area's edges." {
      default 24
      unit cssPx
      min 0
    }
    field arrow Option.Paint "The arrow's ink; null draws none."
    field arrowSize f32 "The arrow's length." {
      default 14
      unit cssPx
      min 0
    }
  }

  struct WorldAnchorDesc {
    doc "An element anchored in the world (docs/ui.md §14): laid out at its own size and placed each tick on its target's point projected with the tick's camera. A nameplate, an interaction prompt, a speech bubble, a waypoint."
    desc true
    field target WorldTarget "What it sits on."
    field offset Vector3 "Added to the point in world units (above a head: 0, 2, 0)."
    field screenOffsetX f32 "Moves it right on the screen." {
      unit cssPx
    }
    field screenOffsetY f32 "Moves it down on the screen." {
      unit cssPx
    }
    field pivot Anchor "Its point that sits on the projected point; the default is its bottom centre."
    field direction Direction "Which way it lays out its children; the default is a column."
    field gap f32 "Space between children." {
      unit cssPx
    }
    field padding Insets "Space inside its edges."
    field align Align "Where children sit along the main axis."
    field cross Cross "Where children sit across it."
    field background Option.Paint "Its fill; null draws none."
    field radius f32 "Corner radius." {
      unit cssPx
    }
    field scale AnchorScaleMode "How its size follows its distance."
    field reference f32 "For scale distance: the distance at which it is its laid-out size." {
      default 10
      unit m
      min 0
    }
    field minScale f32 "For scale distance: the smallest it gets." {
      default 0.25
      min 0
    }
    field maxScale f32 "For scale distance: the largest it gets." {
      default 2
      min 0
    }
    field occlusion WorldOcclusion "What the scene in front of it does."
    field occludedAlpha f32 "Its opacity behind the scene, for occlusion fade." {
      default 0.25
      min 0
      max 1
    }
    field lod List.f32 "Level-of-detail distances, ascending: level k from lod[k - 1] on (AnchorInfo.lod; build less at a higher level)."
    field maxDistance f32 "Hidden past this distance, fading over its last tenth; 0 never." {
      unit m
      min 0
    }
    field declutter Declutter "How it resolves against the anchors it overlaps."
    field priority i32 "Higher keeps its place; equal priorities favour the nearer."
    field clamp Option.EdgeClampDesc "Edge clamping; null lets it leave the screen."
    field fadeTicks u32 "Ticks a fade (declutter, distance, appearing) takes; 0 is 6."
    field contain bool "Without clamp: while its point is in the safe area its box is kept inside it (a nameplate near the edge slides in rather than being cut), and it fades out as the point leaves the safe area."
  }

  struct AnchorInfo {
    doc "Where an anchored element stands: its distance and level of detail from this tick's camera, the rest as last tick placed it."
    field inView bool "Its point is in front of the camera and within maxDistance (or clamped to the edge)."
    field onScreen bool "Its point projects inside the screen."
    field clamped bool "Held on the screen's edge."
    field lod u32 "Its level of detail."
    field distance f32 "From the camera." {
      unit m
    }
    field x f32 "Where its pivot was drawn." {
      unit cssPx
    }
    field y f32 "Where its pivot was drawn." {
      unit cssPx
    }
    field angle f32 "Toward its point from the screen's centre, clockwise from +x (the edge arrow's)." {
      unit rad
    }
    field scale f32 "The scale it was drawn at."
    field alpha f32 "Its eased opacity (declutter, distance)." {
      unit ratio
    }
  }

  fn openWorldAnchor {
    doc "Open an element anchored in the world, closed by close(): its children are an ordinary subtree (labels, bars, icons, buttons) laid out at its own size, then projected, scaled, depth tested, decluttered and clamped as desc says. Drawn under the screen's own elements. og.ui.setDraw after it draws its box. For thousands of tags of one kind (overhead bars on an army) use mass elements instead."
    param id String "Its id; the probe path is the id alone."
    param desc WorldAnchorDesc "What it sits on and how it follows the camera."
    returns AnchorInfo
  }

  struct WorldPanelDesc {
    doc "A world panel (docs/ui.md §14): a UI tree drawn into a render target that a mesh shows (a terminal, a cockpit screen, a shop sign), reached by the pointer through a ray onto its quad."
    desc true
    field target Option.Texture "The colour of an og.render.renderTarget made with format rgba16float (RenderTargetInfo.texture); give the mesh's material it as map (lit) or emissiveMap with colour black (unlit). It shows the frame after the UI drew it. Null: laid out and hit, drawn nowhere."
    field width f32 "Its layout width; the target's pixels spread over it." {
      default 480
      unit cssPx
      min 1
    }
    field height f32 "Its layout height." {
      default 320
      unit cssPx
      min 1
    }
    field quad Option.WorldTarget "Where its quad is: centred on the target's pose, facing its +Z (an og.render.planeGeometry of quadWidth by quadHeight on that entity). Null: no ray reaches it."
    field rotation Quaternion "The quad's rotation after its target's."
    field quadWidth f32 "The quad's width along its +X." {
      default 1
      unit m
      min 0
    }
    field quadHeight f32 "The quad's height along its +Y." {
      default 1
      unit m
      min 0
    }
    field direction Direction "Which way it lays out its children; the default is a column."
    field gap f32 "Space between children." {
      unit cssPx
    }
    field padding Insets "Space inside its edges."
    field background Option.Paint "Its fill; null draws none (the target clears to transparent)."
  }

  struct PanelInfo {
    doc "What the pointer does on a world panel this tick."
    field pointed bool "The ray from the pointer meets the panel's quad (and no screen element is under it): its controls take the press."
    field x f32 "Where on the panel, from its top left." {
      unit cssPx
    }
    field y f32 "Where on the panel, from its top left." {
      unit cssPx
    }
    field distance f32 "Along the ray to the hit." {
      unit m
    }
  }

  fn openWorldPanel {
    doc "Open a world panel, closed by close(): its children are an ordinary UI (buttons, lists, fields) laid out at width by height and drawn into desc.target; a press on its quad reaches its controls. One render target per panel."
    param id String "Its id; the probe path is the id alone."
    param desc WorldPanelDesc "Its target, size and quad."
    returns PanelInfo
  }

  enum MassKind {
    doc "What a mass element template draws."
    variant number "The instance's value as a number (a damage number, a score)."
    variant text "One of strings, by the instance's value (a nameplate, a loot label)."
    variant bar "A bar filled to the instance's value 0–1 with a ghost at its ghost (an overhead health bar)."
    variant icon "Frame value of frames on texture (a status icon)."
    variant particle "A particle of particleShape (confetti, sparks)."
  }

  enum MassEase {
    doc "How a mass element's timeline moves into a key."
    variant linear "Evenly."
    variant out "Fast then slow."
    variant in "Slow then fast."
    variant back "Out, past the key and back (a pop)."
    variant step "Holds the key before until this one."
  }

  enum MassSpace {
    doc "Where a mass element's position is."
    variant world "A world point, projected by the GPU each frame."
    variant screen "CSS pixels of the screen."
  }

  enum ParticleShape {
    doc "A particle's shape."
    variant square "A rectangle of size (a long thin one is a streak)."
    variant circle "A disc."
    variant diamond "A diamond."
  }

  struct MassKey {
    doc "A key of a mass element's timeline, evaluated in the shader."
    desc true
    field t f32 "Where in its life, 0–1." {
      unit ratio
      min 0
      max 1
    }
    field offsetX f32 "Moves it right." {
      unit cssPx
    }
    field offsetY f32 "Moves it down (negative rises)." {
      unit cssPx
    }
    field scale f32 "Its scale." {
      default 1
      min 0
    }
    field alpha f32 "Its opacity." {
      default 1
      min 0
      max 1
    }
    field ease MassEase "How it moves into this key."
  }

  struct MassTemplateDesc {
    doc "A mass element template (docs/ui.md §14): declared once, then instanced thousands of times a frame with a few values each. No instance is laid out; its motion is the timeline, evaluated on the GPU."
    desc true
    field kind MassKind "What it draws."
    field space MassSpace "Where instances' positions are."
    field font Option.Font "Numbers and text: the font (one page); null is the UI's body font."
    field texture Option.Texture "Icons: the texture its frames are in."
    field strings List.String "Text: the strings an instance's value picks."
    field frames List.f32 "Icons: uv rectangles, four numbers each (u0, v0, u1, v1)."
    field decimals u32 "Numbers: digits after the point."
    field plus bool "Numbers: a + before positive values."
    field compact bool "Numbers: 12.3k, 4.5M."
    field barBack Option.Paint "Bars: the track's ink; null is near black at 85 %."
    field barGhost Option.Paint "Bars: the ghost's ink; null is pale."
    field barRadius f32 "Bars: corner radius." {
      unit cssPx
      min 0
    }
    field particleShape ParticleShape "Particles: the shape."
    field size Vector2 "Text and numbers: x is the em size; bars, icons and particles: width and height." {
      unit cssPx
    }
    field pivot Vector2 "The element's point on its position, fractions (0.5, 1: its bottom centre)."
    field lifetime u32 "Ticks an instance lives; 0 shows pushed instances for their tick only."
    field keys List.MassKey "The timeline over its life (up to 8)."
    field drift f32 "Each instance drifts sideways up to this far over its life, by its seed." {
      unit cssPx
    }
    field gravity f32 "Added downward over its life, this much at its end." {
      unit cssPx
    }
    field drag bool "Instances' velocity slows to rest over the life."
    field reference f32 "World space: the distance at which it is its size, nearer larger and farther smaller; 0 keeps its screen size." {
      unit m
      min 0
    }
    field minScale f32 "World space: the smallest distance scale." {
      default 0.25
      min 0
    }
    field maxScale f32 "World space: the largest distance scale." {
      default 4
      min 0
    }
    field occlusion WorldOcclusion "World space: what the scene in front of an instance does."
    field occludedAlpha f32 "Its opacity behind the scene, for occlusion fade." {
      default 0.25
      min 0
      max 1
    }
    field outline Option.Paint "Text and numbers: an outline's ink; null draws none."
    field outlineWidth f32 "Its width." {
      default 2
      unit cssPx
      min 0
    }
  }

  struct MassInstance {
    doc "One mass element: a few values; its template does the rest."
    desc true
    field position Vector3 "A world point, or CSS pixels (x, y) in screen space."
    field value f64 "The number, the string or frame index, or the bar's fill 0–1."
    field color Option.Paint "Its ink (text, icon tint, bar fill, particle); null is white."
    field scale f32 "Multiplies its timeline's scale (a critical hit)." {
      default 1
      min 0
    }
    field seed u32 "Its drift's side."
    field ghost f32 "Bars: the ghost's fill 0–1." {
      unit ratio
    }
    field velocity Vector2 "Travelled over its life." {
      unit cssPx
    }
    field spin f32 "Turns over its life."
    field rotation f32 "Its starting rotation, clockwise." {
      unit rad
    }
  }

  fn defineMass {
    doc "Declare a mass element template by name and answer its handle; declaring the name again replaces it and keeps the handle."
    param name String "Its name."
    param desc MassTemplateDesc "What it draws and how it moves."
    returns u32
  }

  fn spawnMass {
    doc "Start instances of a template on this tick: each plays its template's timeline over its lifetime and leaves after it (damage numbers, pickups). They live in the UI's state, so a snapshot or a replay carries them."
    param template u32 "From defineMass."
    param instances List.MassInstance "The instances."
    returns Void
  }

  fn pushMass {
    doc "Show instances of a template for this tick only (overhead bars, nameplates, status icons rebuilt every tick with their values)."
    param template u32 "From defineMass."
    param instances List.MassInstance "The instances."
    returns Void
  }

  fn massCount {
    doc "The live spawned instances of a template."
    param template u32 "From defineMass."
    returns u32
  }

  enum EmitFrom {
    doc "Where on its element a particle starts."
    variant center "Its centre."
    variant area "Anywhere inside its box."
    variant edges "On its edges."
  }

  struct ParticlesDesc {
    doc "UI particles from an element (docs/ui.md §5.5): confetti, sparks, coin streams, rarity bursts. Drawn over it on its layer, clipped by its clip, seeded so a replay throws the same. Nothing under reduced motion."
    desc true
    field rate f32 "Particles a second while it is built." {
      min 0
    }
    field burst u32 "Particles at once on a tick fire is set."
    field fire bool "Throw the burst this tick."
    field lifetimeMs f32 "How long a particle lives; 0 is 900." {
      unit ms
      min 0
    }
    field shape ParticleShape "Its shape."
    field size Vector2 "Its size." {
      default 8 8
      unit cssPx
    }
    field colors List.Paint "Picked by each particle's seed; empty is the accent."
    field travelMin f32 "The shortest way a particle flies over its life." {
      default 40
      unit cssPx
      min 0
    }
    field travelMax f32 "The longest." {
      default 120
      unit cssPx
      min 0
    }
    field direction f32 "Its heading, clockwise from +x (-π/2 is up)." {
      default -1.5707964
      unit rad
    }
    field spread f32 "The spread about the heading (2π is every way)." {
      default 6.2831855
      unit rad
      min 0
    }
    field gravity f32 "Added downward over its life, this much at its end." {
      unit cssPx
    }
    field drag bool "Its flight slows to rest." {
      default true
    }
    field spin f32 "Turns over its life, up to this many either way." {
      min 0
    }
    field align bool "Its rotation follows its heading (a streak flying outward)."
    field from EmitFrom "Where it starts."
    field endScale f32 "Its scale at the end of its life." {
      default 1
      min 0
    }
    field fade bool "Fades out toward its end." {
      default true
    }
    field clip bool "Clipped by the element's clip (a scroll view, a masked panel)." {
      default true
    }
  }

  fn particles {
    doc "Emit particles from the element built just before (a control, or a container just opened). Call every tick it emits; a burst throws on the ticks desc.fire is set. og.ui.burst is a preset of it."
    param desc ParticlesDesc "What it throws."
    returns Void
  }

  enum MetaKind {
    doc "What a meta layer draws over the scene."
    variant vignette "Its colour at the edges, clear in the middle (a damage vignette)."
    variant tint "A flat tint."
    variant material "The frame under it composited through a UI material (a ripple for sanity, a glitch for a hit)."
  }

  struct MetaDesc {
    doc "A meta layer (docs/ui.md §14): full screen, over the scene and under the screen's elements, never taking input."
    desc true
    field kind MetaKind "What it draws."
    field color Option.Paint "Vignette and tint: its ink; null is a deep red."
    field inner f32 "Vignette: clear out to this fraction of the half diagonal." {
      default 0.55
      unit ratio
      min 0
      max 1
    }
    field outer f32 "Vignette: full colour from this fraction on." {
      default 1
      unit ratio
      min 0
      max 1
    }
    field material MaterialName "Material: the built-in material, or custom."
    field custom Option.UiMaterial "Material: the custom material."
    field params List.f32 "Material: its parameters, up to four vec4s flattened."
    field intensity f32 "Its opacity." {
      default 1
      min 0
      max 1
    }
    field pulseHz f32 "Pulses this many times a second (a low-health heartbeat); 0 is steady." {
      unit hz
      min 0
    }
    field pulseDepth f32 "How far a pulse dims it." {
      default 0.5
      unit ratio
      min 0
      max 1
    }
  }

  fn meta {
    doc "A meta layer this tick: a damage vignette, a low-health pulse, a material over the whole frame."
    param id String "Its id."
    param desc MetaDesc "What it draws."
    returns Void
  }

  struct SceneViewportDesc {
    doc "The viewport element (docs/ui.md §5.5): a camera's view of a scene layer shown in the layout (a character on a turntable, an item to inspect). Draw it with an og.CameraView into a render target on its own layers, with its own lights; this element shows the target and passes input in."
    desc true
    field texture Option.Texture "The target's colour (RenderTargetInfo.texture)."
    field width Option.Size "Its width; null is 320 CSS px."
    field height Option.Size "Its height; null is 320 CSS px."
    field aspect f32 "Width over height; 0 is free." {
      min 0
    }
    field cameraPosition Vector3 "Its camera's position, for rays."
    field cameraTarget Vector3 "What its camera looks at, for rays."
    field fov f32 "Its camera's vertical field of view; 0 gives no ray." {
      default 50
      unit deg
      min 0
    }
    field background Option.Paint "Drawn under the view."
    field radius f32 "Corner radius." {
      unit cssPx
    }
    field label String "What the probe and the accessibility tree call it."
  }

  struct SceneViewportInfo {
    doc "What the pointer does in a viewport this tick."
    field width f32 "Its laid-out width, last tick." {
      unit cssPx
    }
    field height f32 "Its laid-out height, last tick." {
      unit cssPx
    }
    field pixelWidth u32 "The target width that fills it at the device's pixel ratio."
    field pixelHeight u32 "The target height that fills it."
    field hovered bool "The pointer is over it."
    field pressed bool "A press that started in it is held."
    field clicked bool "Pressed and released in it."
    field drag Vector2 "The pointer's move while held this tick (orbit, turn)." {
      unit cssPx
    }
    field wheel Vector2 "The wheel over it (zoom)."
    field at Option.Vector2 "The pointer in it, fractions of its box from the top left."
    field ray Option.Ray "The ray into its scene through the pointer."
  }

  fn sceneViewport {
    doc "A viewport: a camera's render target shown in the layout, its drag, wheel and pointer ray handed back so a menu can orbit, pick and rotate."
    param id String "Its id."
    param desc SceneViewportDesc "What it shows and its camera."
    returns SceneViewportInfo
  }
  # ── documents, layers and actions (docs/ui.md §8, §9, §10, §16) ─────────

  struct UiDocEvent {
    doc "Something a document did (docs/ui.md §10.2): a click, a changed control, a list row selected, a named event (`emit`, a timeline's callback), an action, a two-way write, or Back on a layer whose Back is `emit`."
    field mount String "The document's mount: the screen's name, or a component instance's path."
    field path String "The element's path."
    field kind String "click, changed, select, emit, action, set or back."
    field name String "The element's id (click), the prop (changed), the list (select), the event or action's name, or the viewmodel path a `set` wrote."
    field value Json "The new value (changed, set), the row's index (select); null otherwise."
  }

  struct UiDocResponse {
    doc "What mounting a document answers: its events this tick (and, for a screen, those of its builds code did not see), its root's path, and for a component its props after its two-way writes."
    field path String "Its root's path; empty when it was not built."
    field events List.UiDocEvent "Its events."
    field props Json "A component's props after its writes (a screen's viewmodel is og.ui.screenVm's)."
  }

  struct UiLayer {
    doc "A layer of the stack (docs/ui.md §8.1), as its screen declares it."
    field serial u32 "Its number, unique for the UI's life: what push answered."
    field screen String "The screen's name; also its layer's id, the first segment of its elements' paths."
    field kind String "hud, menu, modal, popover, toast, tooltip or system."
    field input String "game (input reaches gameplay), menu (input stays in the UI) or all."
    field capture bool "It takes the pointer on its gaps too."
    field pause bool "The game pauses while it is on the stack."
    field under String "What happens to the layers under it: none, dim, blur or hide."
    field back String "What Back does: pop, none or `emit <event>`."
    field focus String "Where focus starts, a path below its root (empty: its first control)."
    field remember bool "Focus returns where it was when it is the top again."
    field top bool "It is the top layer."
    field hidden bool "A layer above hides it: it is not built."
    field inert bool "A menu layer above takes its input."
  }

  enum UiActionTrigger {
    doc "When a UI action fires."
    variant press "When a binding goes down."
    variant release "When it comes up."
    variant hold "When it has been held holdMs."
  }

  struct UiActionDesc {
    doc "A named UI action (docs/ui.md §8.2) bound to og-input's controls: a component asks for an action, not a key."
    field name String "Its name: confirm, back, tabNext, tabPrev, details, or the game's own."
    field keys List.String "Key codes (KeyboardEvent.code: `Enter`, `KeyE`)."
    field buttons List.String "Standard-mapping pad buttons (GamepadButton's names: `a`, `rightBumper`)."
    field trigger UiActionTrigger "When it fires."
    field holdMs f32 "How long a hold is (0: 500)." {
      unit ms
    }
    field toggle bool "A hold's toggle alternative (XAG 107): a tap turns it on, the next tap off; og.ui.actionHeld answers true between."
    field label String "What it says when no document gives it a hint."
    field action String "A gameplay action (og.input.defineAction) it follows instead of keys and buttons: it is down when that action is, and its glyph is that action's binding on the device used last, so the player's rebinding moves the prompt too. Empty: keys and buttons." {
      optional true
    }
  }

  enum UiDevice {
    doc "The device a glyph set is for: the one the player used last."
    variant keyboardMouse "Keyboard and mouse."
    variant xbox "An Xbox pad."
    variant playstation "A PlayStation pad."
    variant switch "A Nintendo Switch pad (south is B)."
    variant gamepad "A generic standard-mapping pad."
    variant touch "A touch screen."
  }

  struct UiGlyph {
    doc "An action's control on the device used last."
    field icon String "The icon a style's set draws: `key.enter`, `xbox.a`, `ps.cross`, `switch.b`, `pad.south`, `touch.<action>`."
    field text String "The text that names it: `Enter`, `A`, `×`."
    field device UiDevice "The device it is for."
  }

  struct UiActionHint {
    doc "One entry of the action bar: an action the top layer accepts, its hint and glyph."
    field action String "The action."
    field hint String "What it does here (the document's `actions` line, else its label)."
    field icon String "Its glyph's icon."
    field text String "Its glyph's text."
    field hold bool "It is a hold."
  }

  fn screen {
    doc "Mount a screen document (`type screen`, loaded with og.load.document) as a layer of the stack, pushed when it is not on it, with its viewmodel for this tick, and build it here: code fills its slots after this call (og.ui.openSlot). Its bindings read the viewmodel every tick, a Capitalised root (`Wallet.gold`) the resource as of the last tick; two-way controls write into it (each write is a `set` event). Layers code does not mount are built at the frame's end with the viewmodel they have."
    param name String "The screen's name (its `name` line)."
    param vm Json "Its viewmodel: an object (null keeps the one it has)." {
      optional true
    }
    returns UiDocResponse
  }

  fn component {
    doc "Mount a component document (`type component`) here, inside whatever is open: its props are its viewmodel, its two-way writes come back in the answer's props."
    param id String "The instance's root id."
    param name String "The component's name."
    param props Json "Its props: an object." {
      optional true
    }
    returns UiDocResponse
  }

  fn openSlot {
    doc "Open a document's slot (a `slot` element built this tick) so code fills it; its children follow until og.ui.close. False when no such slot was built this tick."
    param path String "Its full path, or `<screen>/<slot id>`."
    returns bool
  }

  fn push {
    doc "Push a screen onto the layer stack (docs/ui.md §8.1); the layer under it remembers its focus. Callable anywhere (systems, commands, start); the stack is world state, so snapshots carry it."
    param world World "The world."
    param screen String "The screen's name."
    param vm Json "Its viewmodel (null: its document's first fixture, else an empty object)." {
      optional true
    }
    returns Result.u32 "The layer's serial. Refused for a name no screen document has."
  }

  fn pop {
    doc "Pop the top layer; the one under it takes its remembered focus. Answers the popped screen's name (empty: the stack was empty)."
    param world World "The world."
    returns String
  }

  fn replace {
    doc "Replace the top layer with a screen."
    param world World "The world."
    param screen String "The screen's name."
    param vm Json "Its viewmodel." {
      optional true
    }
    returns Result.u32 "The new layer's serial."
  }

  fn clear {
    doc "Empty the layer stack."
    param world World "The world."
    returns Void
  }

  fn layers {
    doc "The layer stack, bottom first."
    param world World "The world."
    returns List.UiLayer
  }

  fn screenVm {
    doc "A layer's viewmodel as its two-way bindings left it (the top layer of that screen); null when it is not on the stack."
    param world World "The world."
    param screen String "The screen's name."
    returns Json
  }

  fn docEvents {
    doc "Take the events of documents built where code did not see them (layers built at the frame's end); og.ui.screen answers its own."
    param world World "The world."
    returns List.UiDocEvent
  }

  fn gameInput {
    doc "Gameplay takes input this tick: no layer whose input is `menu` is on the stack. Input goes to the top layer that takes it, once per tick."
    param world World "The world."
    returns bool
  }

  fn paused {
    doc "A layer that pauses the game (`pause`) is on the stack: the engine holds the time scale at 0 while one is, and gives back the one it had."
    param world World "The world."
    returns bool
  }

  fn defineAction {
    doc "Define (or redefine) a UI action. confirm (Enter, Space, A), back (Escape, B), tabNext (E, ], RB), tabPrev (Q, [, LB), details (X, Y) and rotate (R, X) are defined by default."
    param world World "The world."
    param desc UiActionDesc "The action."
    returns Result.Void
  }

  fn action {
    doc "The action fired this tick (a document's `on action` fires on the top layer that takes input)."
    param name String "The action."
    returns bool
  }

  fn actionHeld {
    doc "A hold action is held past its hold, or its toggle is on."
    param name String "The action."
    returns bool
  }

  fn glyph {
    doc "An action's glyph on the device used last: its first binding there. Null for an unknown action or one with no binding on that device."
    param world World "The world."
    param action String "The action."
    returns Option.UiGlyph
  }

  fn frameGlyph {
    doc "An action's glyph on the device used last, as og.ui.glyph answers it, without the world: for a component that shows a prompt (a tab row's bumpers, the action bar) and only builds UI. It follows the device live (keyboard, Xbox, PlayStation, Switch, a generic pad, touch) and the player's rebinding. A name that is no UI action answers as og.input.glyph does for the world whose frame is being built (a gameplay action an ability slot names). Null for an unknown action, one with no binding on that device, or outside a frame being built."
    param action String "The action."
    returns Option.UiGlyph
  }

  fn device {
    doc "The device the player used last (glyphs follow it live): a key or the mouse, a pad of the family set with og.ui.setDevice (Xbox by default), or a touch on a coarse pointer."
    param world World "The world."
    returns UiDevice
  }

  fn setDevice {
    doc "Set the device (the host's when it knows: a pad's family from its id); a pad family also becomes what pad input shows from then on."
    param world World "The world."
    param device UiDevice "The device."
    returns Void
  }

  fn actionBar {
    doc "What an action bar component reads: the actions the top layer's document lists (`actions { confirm \"Buy\" }`), each with its hint and its glyph on the device used last."
    param world World "The world."
    returns List.UiActionHint
  }

  fn documentSchema {
    doc "The reflected schema documents are validated against (docs/ui.md §10): every element kind and every prop, with its value type, the kinds it applies to and whether a control writes it back."
    returns Json
  }

  fn setProp {
    doc "Set a prop of a document element live (Tune, the probe's ui:set): presentation only, over the document's own line until og.ui.saveEdits writes it into the file. The value is written as the document's line would be (`token primary`, `grow`, `bind gold compact`)."
    param world World "The world."
    param path String "The element's full path."
    param prop String "The prop (og.ui.documentSchema)."
    param value String "Its value as a document line writes it."
    returns Result.Void "Refused for an unknown prop or a value it does not take."
  }

  fn saveEdits {
    doc "Write the live edits into their documents' `.ogt` files under the project's assets (each edited element's line of that prop replaced, or one added; every other line kept), as save_scene writes scenes; the documents take the new text at once. Answers the files written."
    param world World "The world."
    returns Result.List.String "Refused on a host with no project directory, or a write that fails."
  }
}

# ── systems ───────────────────────────────────────────────────────────────

