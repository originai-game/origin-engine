  }

  fn confirmDialog {
    doc "The confirm dialog template."
    host false
    param id String "Its id."
    param desc ConfirmDesc "Question, consequence and labels."
    returns ConfirmResult
  }

  fn alertDialog {
    doc "The alert template. Returns true the tick it is dismissed."
    host false
    param id String "Its id."
    param desc AlertDesc "Title, message and label."
    returns bool
  }

  enum UiProp {
    doc "An animatable value of an element (docs/ui.md §7.1): a state, a timeline key, a presence or og.ui.animate moves it. Colours are sRGB components 0 to 1; rotation and skew are radians."
    variant x "Its horizontal offset, CSS px (the transform's x)."
    variant y "Its vertical offset, CSS px."
    variant scaleX "Its horizontal scale (1: unscaled)."
    variant scaleY "Its vertical scale."
    variant scale "Both scales at once."
    variant rotate "Its turn, radians, clockwise on screen."
    variant skewX "Its horizontal skew, radians."
    variant skewY "Its vertical skew, radians."
    variant opacity "Its opacity, 0 to 1, multiplied down the tree."
    variant radius "Its corner radius, CSS px."
    variant backgroundR "Its fill's red."
    variant backgroundG "Its fill's green."
    variant backgroundB "Its fill's blue."
    variant backgroundA "Its fill's alpha."
    variant inkR "Its text's red."
    variant inkG "Its text's green."
    variant inkB "Its text's blue."
    variant inkA "Its text's alpha."
    variant z "Its z among its siblings (stepped, never tweened)."
    variant inert "1: it and its subtree take no input (stepped): a results screen's buttons wait for the sequence."
  }

  enum LayoutMode {
    doc "How a container lays out its children."
    variant flex "The row and column walks of its direction (the default)."
    variant stack "Children overlaid in the same rectangle, each placed by its insets, else by the container's align (across) and cross (down): a card's art, frame, cost gem and name."
    variant grid "Tracks and cells (ElementProps.grid)."
  }

  enum Position {
    doc "How an element is placed."
    variant flow "In its parent's flow (the default)."
    variant absolute "Out of the flow, placed by its insets inside its parent's padding box."
    variant anchored "Out of the flow, its anchorSelf point on the anchorAt point of the element at anchorTo, moved by its start and top insets."
  }

  enum GridFlow {
    doc "Which way auto-placed items fill a grid."
    variant row "Along rows, adding rows (the default)."
    variant column "Down columns, adding columns."
  }

  enum DragAxis {
    doc "Which way a drag moves its element."
    variant both "Both ways."
    variant x "Across only."
    variant y "Down only."
    variant lock "Either, locked to the first one the drag moves along."
  }

  enum EaseName {
    doc "A named easing curve."
    variant linear "Constant speed."
    variant out "How things arrive: fast, then settling (the default)."
    variant exit "How things leave: slow, then away."
    variant inOut "Slow at both ends."
  }

  enum MotionToken {
    doc "A named motion of the style (docs/ui.md §7.7): components use these, so a style's personality changes every motion at once."
    variant ui "The control spring: hover, press, toggles."
    variant panel "Panels, sheets and drawers."
    variant emphasis "Rewards, results and level-ups."
    variant playful "Bouncy toys: chips, stickers, mascots."
    variant enter "The entrance ease and duration."
    variant exit "The exit ease and duration."
  }

  enum ReducedMotion {
    doc "What an animation does under reduced motion (docs/ui.md §7.7)."
    variant fade "Movement and scale jump; opacity and colour fade quickly (the default)."
    variant none "Everything jumps."
    variant keep "Plays as authored: motion that carries meaning, kept small."
  }

  enum Orientation {
    doc "A screen orientation."
    variant portrait "Taller than wide."
    variant landscape "Wider than tall."
  }

  enum Repeat {
    doc "How a play repeats."
    variant once "Once (the default)."
    variant loop "Over and over."
    variant pingPong "Forward then back, over and over."
  }

  struct UiTransform {
    doc "A transform applied after layout, about its pivot: CSS's translate(x, y) rotate(r) skew(kx, ky) scale(sx, sy) with its transform-origin. Hit tests, the probe's rectangles and the accessibility tree's bounds follow it; layout does not."
    desc true
    field x f32 "Moves it across." {
      unit cssPx
    }
    field y f32 "Moves it down." {
      unit cssPx
    }
    field scaleX f32 "Its horizontal scale." {
      default 1
    }
    field scaleY f32 "Its vertical scale." {
      default 1
    }
    field rotate f32 "Its turn, radians, clockwise on screen."
    field skewX f32 "Its horizontal skew, radians."
    field skewY f32 "Its vertical skew, radians."
    field pivotX f32 "The pivot across its box (0 its start edge, 1 its end)." {
      default 0.5
      unit ratio
    }
    field pivotY f32 "The pivot down its box." {
      default 0.5
      unit ratio
    }
  }

  struct Edges {
    doc "Insets of an absolute or anchored element from its parent's edges; an absent one is not set. start and end follow the writing direction: a right-to-left layout mirrors them."
    desc true
    field start Option.f32 "From the start edge." {
      unit cssPx
    }
    field top Option.f32 "From the top." {
      unit cssPx
    }
    field end Option.f32 "From the end edge." {
      unit cssPx
    }
    field bottom Option.f32 "From the bottom." {
      unit cssPx
    }
    field centerX bool "Centred across the parent (start, if given, moves it)."
    field centerY bool "Centred down the parent (top, if given, moves it)."
  }

  struct TrackPx {
    doc "A fixed track."
    field px f32 "Its size." {
      unit cssPx
    }
  }

  struct TrackFr {
    doc "A share of the space the other tracks leave."
    field fr f32 "Its share." {
      default 1
    }
  }

  struct TrackRange {
    doc "A track sized by its content, within bounds."
    field min f32 "The smallest it gets." {
      unit cssPx
    }
    field max f32 "The largest it gets." {
      unit cssPx
    }
  }

  struct TrackPercent {
    doc "A fraction of the grid's inner size."
    field fraction f32 "The fraction." {
      unit ratio
    }
  }

  struct TrackAuto {
    doc "Its largest single-cell item."
  }

  union Track {
    doc "A grid track's size."
    tag kind
    case px TrackPx "A fixed size."
    case fr TrackFr "A share of the free space."
    case auto TrackAuto "Its largest single-cell item."
    case minMax TrackRange "Its content between min and max."
    case percent TrackPercent "A fraction of the grid."
  }

  struct GridSpec {
    doc "A grid's tracks and areas."
    desc true
    field columns List.Track "The column tracks."
    field rows List.Track "The row tracks; items past them add autoTrack rows."
    field autoTrack Option.Track "The track added for items past the declared ones; null is auto."
    field columnGap Option.f32 "Space between columns; absent is the element's gap." {
      unit cssPx
    }
    field rowGap Option.f32 "Space between rows; absent is the element's gap." {
      unit cssPx
    }
    field areas List.String "Named areas, one string per row of space-separated cell names, as CSS grid-template-areas (`.` is an unnamed cell)."
    field flow GridFlow "Which way auto-placed items fill it."
    field dense bool "Auto-placement back-fills holes left by spanning items."
  }

  struct GridPlace {
    doc "Where an item sits in its parent grid; the zero value is auto-placed in one cell."
    desc true
    field column u32 "Its first column, 1-based (0: auto)."
    field row u32 "Its first row, 1-based (0: auto)."
    field columnSpan u32 "Columns spanned (0: 1)."
    field rowSpan u32 "Rows spanned (0: 1)."
    field area String "A named area of the grid (wins over the numbers)."
  }

  struct PropValue {
    doc "A value for an animatable prop."
    field prop UiProp "The prop."
    field value f32 "Its value."
  }

  struct UiQuery {
    doc "When a variant applies: every condition given must hold."
    desc true
    field breakpoints List.Breakpoint "The size classes it applies on (empty: any)."
    field orientation Option.Orientation "The orientation it applies in; null is either."
    field minWidth f32 "The narrowest width it applies at (0: unbounded): the viewport's, or with container the element's own laid-out width." {
      unit cssPx
    }
    field maxWidth f32 "The widest (0: unbounded)." {
      unit cssPx
    }
    field container bool "A container query: the widths are the element's own (the same card in a four-column shop and a one-column phone list)."
  }

  struct UiPatch {
    doc "What a variant changes: the box's layout, its arrangement and animatable values; absent fields are unchanged."
    desc true
    field direction Option.Direction "Its direction."
    field width Option.Size "Its width."
    field height Option.Size "Its height."
    field padding Option.Insets "Its padding."
    field gap Option.f32 "Its gap." {
      unit cssPx
    }
    field align Option.Align "Its main-axis alignment."
    field cross Option.Cross "Its cross-axis alignment."
    field wrap Option.bool "Its wrapping."
    field layout Option.LayoutMode "Its layout mode."
    field columns List.Track "Its grid columns (empty: unchanged)."
    field hidden Option.bool "Hide it and its subtree where the variant applies."
    field values List.PropValue "Animatable values it sets."
  }

  struct UiVariant {
    doc "A prop override under a condition (docs/ui.md §6.2: breakpoint variants and container queries). Later variants win."
    field when UiQuery "When it applies."
    field set UiPatch "What it changes."
  }

  struct SpringSpec {
    doc "A spring by how it feels: about how long it takes to settle and how much it overshoots. Retargeting it keeps its value and velocity, so an interrupted motion never jumps."
    desc true
    field durationMs f32 "About how long it takes to arrive, ms." {
      default 350
      unit ms
    }
    field bounce f32 "0 arrives without overshoot; 0.3 overshoots a little; up to 1 rings (below 0 is sluggish). The style's overshoot caps it." {
      min -0.95
      max 1
    }
  }

  struct TweenSpec {
    doc "A duration on an ease: a retarget starts a new ease from where it is."
    desc true
    field durationMs f32 "Its length, ms." {
      default 200
      unit ms
    }
    field ease EaseName "Its curve."
    field bezier List.f32 "A cubic Bézier (x1, y1, x2, y2) in place of the named ease (empty: the named one)."
  }

  struct TokenRef {
    doc "One of the style's motion tokens."
    field token MotionToken "The token."
  }

  struct InstantSpec {
    doc "At once."
  }

  union Transition {
    doc "How a value moves to a new target."
    tag kind
    case instant InstantSpec "At once."
    case spring SpringSpec "On a spring that keeps its velocity."
    case tween TweenSpec "Over a duration on an ease."
    case token TokenRef "The style's token."
  }

  struct DismissSpec {
    doc "Swipe to dismiss: a release past distance (or faster than velocity) along the drag's axis throws the element off."
    desc true
    field distance f32 "0: 40 % of its size along the axis." {
      unit cssPx
    }
    field velocity f32 "CSS px per second (0: 800)."
  }

  struct SnapPoint {
    doc "An offset a released drag can settle on."
    field x f32 "Its x offset." {
      unit cssPx
    }
    field y f32 "Its y offset." {
      unit cssPx
    }
  }

  struct DragSpec {
    doc "The element moves with a drag that starts on it (a card, a sheet, a carousel), released onto a spring that keeps the drag's velocity."
    desc true
    field axis DragAxis "Which way it moves."
    field bounds Option.UiRect "Bounds of its offset (x to x + width, y to y + height); null is free."
    field rubber f32 "Past the bounds it follows with resistance, iOS's rubber band with this constant (0 stops at the bounds; 0.55 is iOS's)."
    field snap List.SnapPoint "Offsets a release settles on: the nearest to where its momentum would carry it."
    field momentum bool "A release projects the offset by its velocity (0.3 s of it) before choosing a snap point: a flick."
    field returnHome bool "Without snap points, a release goes back to offset 0."
    field dismiss Option.DismissSpec "Swipe to dismiss; null never throws it off."
    field threshold f32 "Pointer travel before a press becomes a drag (0: 4)." {
      unit cssPx
    }
    field spring Option.Transition "The release spring; null is the style's ui spring."
    field tag String "What a drop target matches in DropSpec.accept."
  }

  struct PinchSpec {
    doc "Two touches on the element scale (and turn) it."
    desc true
    field minScale f32 "0: 0.5."
    field maxScale f32 "0: 4."
    field rotate bool "The touches turn it too."
  }

  struct DropSpec {
    doc "The element takes drops of dragged elements."
    desc true
    field accept List.String "The drag tags it takes (empty: any)."
  }

  struct PresenceSpec {
    doc "How an element arrives or leaves (docs/ui.md §7.5): the values it enters from or exits to, and how it moves between them and its own."
    desc true
    field values List.PropValue "Where it starts (entering) or ends (leaving)."
    field kind Option.TransitionKind "A transition kind's values in place of values: what the kind enters from and exits to."
    field distance f32 "A slide kind's distance (0: 24)." {
      unit cssPx
    }
    field transition Option.Transition "How it moves; null is the style's enter or exit token."
    field delayMs f32 "Wait this long before moving (a hand-built stagger)." {
      unit ms
    }
  }

  struct VisualState {
    doc "One state of a group: the values it sets, and timelines it starts."
    field name String "Its name."
    field values List.PropValue "The values it sets."
    field onEnter String "A timeline (og.ui.defineTimeline) played on the element when the state is entered (empty: none)."
    field onExit String "One played when it is left."
  }

  struct StateTransition {
    doc "The transition between two states of a group (`*` matches any state). The exact pair wins, then `* -> to`, `from -> *`, `* -> *`."
    field from String "The state left."
    field to String "The state entered."
    field transition Transition "How the values move."
  }

  struct StateGroup {
    doc "A visual state group (docs/ui.md §7.3): one of its states is current, and moving between them animates every value that changes. A group named interaction is derived from input: normal, hover, pressed, focused and disabled (a state the group lacks falls back: pressed to hover to normal, focused to hover). Other groups take their state from ElementProps.state, a timeline's state event or og.ui.forceState; the first state is the default."
    field name String "Its name."
    field states List.VisualState "Its states."
    field transitions List.StateTransition "Its transitions; a pair without one moves on the element's motion, else the style's ui spring."
  }

  struct StateValue {
    doc "The current state of a group."
    field group String "The group."
    field state String "Its state."
  }

  struct NavLinks {
    doc "Explicit focus moves from an element (docs/ui.md §8.3), over the spatial pick: each a path (a full one, `Hud/Bag`, or a sibling's id); empty leaves that move to the layout. A path to a focus group lands on its remembered member (or its first); one to any other container, on its first focusable control."
    desc true
    field up String "Where Up goes."
    field down String "Where Down goes."
    field left String "Where Left goes (the screen's left, also under a right-to-left layout)."
    field right String "Where Right goes."
    field next String "Where Tab goes."
    field prev String "Where Shift+Tab goes."
  }

  struct FocusGroup {
    doc "A container whose focusable controls are one group for keys and pads (docs/ui.md §8.3): arrows move among its members first. At its edge a group that wraps goes round to its far side; one that does not leaves for the nearest control outside that way (the group around it first) and stays put when there is none. The zero value neither wraps nor remembers."
    desc true
    field wrap bool "At its edge the focus wraps round inside it."
    field memory bool "Focus coming into it from outside lands on the member it last had."
  }

  struct GestureSpec {
    doc "Tap, double tap and long press on any element (docs/ui.md §8.5), answered by Response (tapped, doubleTapped, longPressed, longPress), og.ui.gesture and the frame's motion events. Nested elements compete for one press: of those that declare a gesture, the highest priority wins it, the innermost of equals. A tap waits for a double tap only where one is declared; a long press that fires takes the press, so its release clicks nothing; travel past the slop (a drag, a scroll) fails all three. The zero value recognises nothing."
    desc true
    field tap bool "Recognise a tap."
    field doubleTap bool "Recognise a double tap (its tap then waits for the double tap's window)."
    field longPress bool "Recognise a long press (the touch tooltip, a context menu)."
    field longPressMs f32 "How long a long press is held; 0 is 500." {
      unit ms
      min 0
    }
    field doubleTapMs f32 "The longest gap between a double tap's taps; 0 is 300." {
      unit ms
      min 0
    }
    field slop f32 "Pointer travel that fails a tap and a long press; 0 is 10." {
      unit cssPx
      min 0
    }
    field priority i32 "Among nested elements' recognisers of one press: higher wins (ties: the innermost)."
  }

  enum Cursor {
    doc "The pointer's shape over an element (CSS cursor, docs/ui.md §6.1), inherited by its subtree."
    variant auto "Its parent's; with none set above it, a text control's I-beam, a draggable element's open hand (closed while dragged), a link's hand, else the arrow."
    variant default "The arrow."
    variant pointer "The hand (a link)."
    variant text "The I-beam."
    variant grab "An open hand."
    variant grabbing "A closed hand."
    variant move "The move arrows."
    variant notAllowed "The slashed circle."
    variant crosshair "The crosshair."
    variant help "The question mark."
    variant wait "Busy."
    variant progress "Busy, still taking input."
    variant resizeEw "Left and right."
    variant resizeNs "Up and down."
    variant resizeNesw "Up right and down left."
    variant resizeNwse "Up left and down right."
    variant zoomIn "The magnifier with a plus."
    variant zoomOut "The magnifier with a minus."
    variant none "Hidden (a game drawing its own)."
  }

  struct ElementProps {
    doc "Everything an element carries beyond its box (docs/ui.md §6.1): set with og.ui.props right after the element. The zero value is an element in the flow, unmoved and opaque, with no motion."
    desc true
    field transform UiTransform "Its transform after layout."
    field opacity f32 "Its opacity, multiplied down the tree." {
      default 1
      min 0
      max 1
    }
    field z i32 "Its drawing and hit-testing order among its siblings: higher draws over lower without leaving the flow."
    field position Position "How it is placed."
    field insets Edges "Its insets, for an absolute or anchored element."
    field anchorTo String "The path of the element an anchored element is placed against."
    field anchorAt Anchor "The target's point it sits on."
    field anchorSelf Anchor "Its own point that sits there."
    field hitSlop f32 "Extra pointer reach around its box." {
      unit cssPx
    }
    field layout LayoutMode "How it lays out its children."
    field grid GridSpec "Its tracks and areas, for a grid."
    field place GridPlace "Its place in a grid parent."
    field container bool "Its container queries read its own width."
    field variants List.UiVariant "Prop overrides by breakpoint, orientation and width; later ones win."
    field overlaps List.String "Paths of elements it overlaps on purpose (an ancestor path covers its subtree; `*` covers everything, for what follows the pointer across the screen: a targeting arc, a dragged ghost). Undeclared overlaps are reported (og.ui.overlaps)."
    field dense bool "Its text and its subtree's are a dense HUD's readouts (strategy, MMO, simulation: docs/ui.md §15.2): og ui check holds them to 12 px at 1080p instead of 18, still growing with the player's text scale and passing the contrast rule. Never for menus, body text or controls."
    field match String "A shared-element key: the element with the same key on the screen being left morphs into this one."
    field drag Option.DragSpec "It moves with a drag."
    field pinch Option.PinchSpec "Two touches scale and turn it."
    field drop Option.DropSpec "It takes drops."
    field nav NavLinks "Where keys and pads move the focus from it, over the spatial pick."
    field focusGroup Option.FocusGroup "Its focusable controls are one focus group: arrows move among them first; at its edge it wraps or is left; it can remember its last member."
    field gestures Option.GestureSpec "Tap, double tap and long press on it."
    field cursor Cursor "The pointer's shape over it and its subtree; auto takes its parent's."
    field motion Option.Transition "How its animatable values move when they change; null is at once."
    field layoutMotion Option.Transition "Moves from its last laid-out rectangle to its new one (FLIP); null jumps."
    field enter Option.PresenceSpec "How it arrives."
    field exit Option.PresenceSpec "How it leaves: kept, inert and out of hit tests and the accessibility tree, while it plays after the element leaves the tree."
    field states List.StateGroup "Its visual state groups."
    field state List.StateValue "The current state of its groups that are not derived from input."
    field reduced Option.ReducedMotion "Its reduced-motion fallback; null is the style's."
    field inert bool "It and its subtree take no input."
  }

  struct EaseKey {
    doc "A named ease into a key."
    field ease EaseName "The curve."
  }

  struct HoldKey {
    doc "Holds the previous value, then jumps at the key."
  }

  struct LinearKey {
    doc "Constant speed into the key."
  }

  struct BezierKey {
    doc "A cubic Bézier into the key."
    field bezier List.f32 "x1, y1, x2, y2."
  }

  union KeyEase {
    doc "How the segment into a key moves."
    tag kind
    case linear LinearKey "Constant speed."
    case ease EaseKey "A named ease."
    case bezier BezierKey "A cubic Bézier."
    case spring SpringSpec "On a spring from the previous key's value (released at it)."
    case hold HoldKey "Holds, then jumps."
  }

  struct TimelineKey {
    doc "A keyframe: a value at a time."
    field atMs f32 "Its time." {
      unit ms
    }
    field value f32 "Its value."
    field ease Option.KeyEase "How the segment into it moves; null is the out ease."
  }

  struct TimelineTrack {
    doc "Keys over one prop of the element the timeline plays on, or of a descendant by its path below it (`Stars/Star#2`). Before its first key it holds that key's value, after its last the last."
    field target String "A path below the play's element (empty: the element itself)."
    field prop UiProp "The prop."
    field keys List.TimelineKey "In time order."
  }

  struct SoundEvent {
    doc "A UI sound of the style."
    field name String "hover, press, open, close, success or error."
    field pitch f32 "Its pitch (1: as recorded); a cascade step raises it 6 %." {
      default 1
    }
  }

  struct HapticEvent {
    doc "A haptic pattern for the host."
    field name String "light, medium, heavy, success, warning or error."
  }

  struct BurstEvent {
    doc "Rays and sparks from the target."
    field count u32 "How many (0: 12)."
    field radius f32 "How far they reach (0: the style's)." {
      unit cssPx
    }
    field color Option.Color "Their colour; null is the style's highlight."
  }

  struct StateEvent {
    doc "Sets a state group of the target."
    field group String "The group."
    field state String "Its new state."
  }

  struct CallbackEvent {
    doc "A callback to game code: it arrives in og.ui.motionEvents."
    field name String "Its name."
  }

  union TimelineAction {
    doc "What an event does when a play reaches it."
    tag kind
    case sound SoundEvent "A UI sound."
    case haptic HapticEvent "A haptic."
    case burst BurstEvent "A burst."
    case state StateEvent "A state change."
    case callback CallbackEvent "A callback."
  }

  struct TimelineEvent {
    doc "An event at a time, on the play's element or a descendant."
    field atMs f32 "Its time." {
      unit ms
    }
    field target String "A path below the play's element (empty: the element itself)."
    field action TimelineAction "What it does."
  }

  struct TimelineLabel {
    doc "A named time, for seeking (PlayDesc.fromLabel)."
    field name String "Its name."
    field atMs f32 "Its time." {
      unit ms
    }
  }

  struct UiTimeline {
    doc "Keyframed tracks and events (docs/ui.md §7.4)."
    desc true
    field tracks List.TimelineTrack "Its tracks."
    field events List.TimelineEvent "Its events."
    field labels List.TimelineLabel "Its named times."
    field durationMs f32 "Its length (0: its last key or event)." {
      unit ms
    }
  }

  struct ChoreoPlay {
    doc "A timeline on the play's element or a descendant."
    field timeline String "The timeline, by name."
    field target String "A path below the play's element (empty: the element itself)."
    field delayMs f32 "Wait this long first." {
      unit ms
    }
  }

  struct ChoreoSteps {
    doc "Steps composed."
    field steps List.Choreo "The steps."
  }

  struct ChoreoStagger {
    doc "One timeline on each target, each stepMs after the one before as ordered by from, the whole spread within capMs."
    field timeline String "The timeline, by name."
    field targets List.String "Paths below the play's element (empty: its children in order)."
    field stepMs f32 "Between one target's start and the next's (0: the style's stagger)." {
      unit ms
    }
    field capMs f32 "The most the whole stagger spreads over (0: the style's cap)." {
      unit ms
    }
    field from String "Where delays grow from: start, end, center (nearest the centre of their bounds first), or `x,y` (nearest that point first)." {
      default "start"
    }
  }

  struct ChoreoCascade {
    doc "Steps where each starts at the first `on` callback event of the one before (or its end): a score that counts chips, then multiplies, each step pitched higher."
    field steps List.Choreo "The steps."
    field on String "The callback that starts the next step."
  }

  union Choreo {
    doc "Timelines composed into one play (docs/ui.md §7.4)."
    tag kind
    case play ChoreoPlay "One timeline."
    case sequence ChoreoSteps "One after another."
    case parallel ChoreoSteps "All at once."
    case stagger ChoreoStagger "One timeline over many targets."
    case cascade ChoreoCascade "Steps chained on callbacks."
  }

  struct PlayDesc {
    doc "How a play runs."
    desc true
    field reverse bool "Plays backwards."
    field repeat Repeat "How it repeats."
    field speed f32 "Its rate (0: 1)."
    field fromMs f32 "Start this far in." {
      unit ms
    }
    field fromLabel String "Start at a label of its first timeline (wins over fromMs)."
    field hold bool "Keep the last values once it ends, until stopped."
    field decorative bool "Under reduced motion it does not play at all."
  }

  struct PlayInfo {
    doc "Where a play is."
    field atMs f32 "Its time (before a reverse's turn)." {
      unit ms
    }
    field lengthMs f32 "Its length." {
      unit ms
    }
    field paused bool "Held."
    field reverse bool "Playing backwards."
    field ended bool "Finished (a held play keeps its values)."
  }

  struct GestureInfo {
    doc "What a drag or pinch on an element is doing (last tick's answer, as responses are)."
    field held bool "A press is held on it."
    field dragging bool "It moves with the pointer (the press travelled past the threshold)."
    field offsetX f32 "Its offset from where it was laid out." {
      unit cssPx
    }
    field offsetY f32 "Its offset down." {
      unit cssPx
    }
    field velocityX f32 "CSS px per second."
    field velocityY f32 "CSS px per second."
    field scale f32 "A pinch's scale (1: none)."
    field rotation f32 "A pinch's turn, radians."
    field snapped i32 "The snap point the last release chose (-1: none)."
    field dismissed bool "A swipe threw it off."
    field over String "The drop target under the drag (empty: none)."
    field droppedOn String "The drop target it was dropped on this tick (empty: none)."
    field hovering bool "For a drop target: a drag is over it."
    field received String "For a drop target: the element dropped on it this tick (empty: none)."
    field tapped bool "Its tap this tick (ElementProps.gestures), as Response.tapped."
    field doubleTapped bool "Its double tap this tick."
    field longPressed bool "Its long press this tick."
    field longPress f32 "How far into its long press the held press is, 0 to 1." {
      unit ratio
    }
  }

  struct UiMotionEvent {
    doc "What happened in the UI's motion this tick."
    field kind String "sound, haptic, burst, state, callback, end (a play finished), dismiss (a swipe threw an element off), drop (a drag was dropped on a target), snap (a released drag chose a snap point), or tap, doubleTap and longPress (an element's ElementProps.gestures recognised one)."
    field name String "The sound, haptic, callback or state's name; for drop the target's path; for snap the point's index."
    field target String "The element's path."
    field play u32 "The play (0: none)."
    field index u32 "The clip's step in a cascade or stagger."
    field pitch f32 "A sound's pitch: its own times 1.06 per cascade step."
  }

  struct UiOverlap {
    doc "Two elements overlapping where neither declared it (docs/ui.md §6.2)."
    field path String "The element placed over the other (absolute, anchored or floating), or the later of two siblings in the flow."
    field other String "The other element."
    field rect UiRect "Where they overlap."
    field inFlow bool "Both are in their parent's flow: a layout bug, not a placement."
  }

  struct UiLayoutStats {
    doc "What the last frame rebuilt and laid out (docs/ui.md §6.3)."
    field elements u32 "Elements built."
    field rebuilt u32 "Elements whose inputs changed since the tick before (or are new)."
    field laidOut u32 "Elements laid out; the rest kept their last layout."
    field keptCommands u32 "Elements whose draw commands were kept from the tick before."
  }

  fn props {
    doc "Give the element built just before (any widget, or a container just closed) the element model's props: transform, opacity, z, placement, grid, variants, overlaps, motion, states, presence, gestures (docs/ui.md §6, §7). Call it right after the element."
    param desc ElementProps "Its props."
    returns bool "False when no element was built before it."
  }

  fn defineTimeline {
    doc "Define a timeline by name: configuration, like the theme, defined once at start. Plays and state groups name it."
    param name String "Its name."
    param timeline UiTimeline "Its tracks, events and labels."
    returns Void
  }

  fn play {
    doc "Play a choreography on an element from the end of this tick: its timelines' keys drive the elements' props and its events fire as it passes them (og.ui.motionEvents). Returns the play's id (0: no element, or a choreo of no known kind)."
    param path String "The element's full path; empty is the element built just before."
    param choreo Choreo "What plays."
    param desc PlayDesc "How it runs."
    returns u32
  }

  fn playTimeline {
    doc "Play one timeline (by name) on an element: og.ui.play with a single step."
    param path String "The element's full path; empty is the element built just before."
    param timeline String "The timeline."
    param desc PlayDesc "How it runs."
    returns u32
  }

  fn seek {
    doc "Move a play to a time; it fires no events on the way. Returns false for an unknown play."
    param play u32 "The play."
    param ms f32 "The time, ms."
    returns bool
  }

  fn pause {
    doc "Hold a play where it is."
    param play u32 "The play."
    returns bool
  }

  fn resume {
    doc "Let a held play go on."
    param play u32 "The play."
    returns bool
  }

  fn reverse {
    doc "Turn a play round where it is: an interrupted opening closes from where it got to."
    param play u32 "The play."
    returns bool
  }

  fn stop {
    doc "Stop a play: its elements go back to their own values (on their motion, if they have one)."
    param play u32 "The play."
    returns bool
  }

  fn playInfo {
    doc "Where a play is; null once it is gone."
    param play u32 "The play."
    returns Option.PlayInfo
  }

  fn forceState {
    doc "Force a state group of an element (the probe and agents render and check each state this way); null lets it go."
    param path String "The element's full path."
    param group String "The group."
    param state Option.String "The state; null releases it."
    returns Void
  }

  fn openPath {
    doc "The full path of the innermost open container (an open row, panel, anchor or world anchor), as bounds, visualState, forceState, playTimeline and the probe name it; empty at the top level. A component reads its root's path right after opening it, to name its parts in those calls."
    returns String
  }

  fn visualState {
    doc "The state a group of an element is in (last tick); empty for none."
    param path String "The element's full path."
    param group String "The group."
    returns String
  }

  fn animate {
    doc "Any number on a spring or an ease (docs/ui.md §7.1: every value is animatable): call it every tick with the target and it answers this tick's value. A retarget keeps its value and velocity; under reduced motion it jumps."
    param id String "Its id under the open element."
    param target f32 "Where it is going."
    param transition Transition "How it moves."
    returns f32
  }

  fn gesture {
    doc "What the drag or pinch on an element is doing."
    param path String "The element's full path."
    returns GestureInfo
  }

  fn motionEvents {
    doc "The UI's motion events of the last frame: sounds, haptics, bursts, state changes, callbacks, ends, dismissals, drops and snaps."
    returns List.UiMotionEvent
  }

  fn overlaps {
    doc "The last frame's undeclared overlaps between elements (docs/ui.md §6.2), with both paths."
    returns List.UiOverlap
  }

  fn layoutStats {
    doc "What the last frame built, rebuilt, laid out and kept."
    returns UiLayoutStats
  }

  # ── components: feedback (docs/ui.md §11, Appendix E) ─────────────────
  # Built only from the public primitives (open, setDraw, props, label,
  # icon, particles, anchors), each with named parts a style dresses
  # (`Notification.card[achievement]`), a viewmodel, state groups the
  # probe can force (`ui:state:<path>.<group>=<state>`), motion on the
  # style's tokens, sounds from its feedback set, an accessibility role
  # and probe ids under its own id. Every word is the game's.

  enum NotificationVariant {
    doc "What a notification is, which sets its look, sound and default time."
    variant standard "A plain message: a tone's accent and icon well (4 s)."
    variant achievement "An achievement: a medal well in gold, an eyebrow over the title, points (6 s); plays reward."
    variant reward "An item or currency received: the icon well glows in the rarity's colour (5 s); plays reward."
    variant alert "A warning that must be read: danger accent, read at once by a screen reader (8 s); plays warning."
    variant social "A friend, invite or message: a round avatar slot (5 s)."
  }

  enum Rarity {
    doc "A loot tier (the style's rarity colours, each paired with its pips so no tier is told by colour alone)."
    variant none "No tier."
    variant common "Common: one pip."
    variant uncommon "Uncommon: two pips."
    variant rare "Rare: three pips."
    variant epic "Epic: four pips."
    variant legendary "Legendary: five pips."
    variant mythic "Mythic: six pips."
  }

  struct NotificationItem {
    doc "One notification of a stack, as the game's viewmodel holds it. The game appends one when something happens and drops the keys the stack reports expired or dismissed."
    desc true
    field key String "Its key, stable while it lives (also its probe id): posting a key again with a higher count merges it (×3)."
    field title String "The headline."
    field body String "A line under it; empty is none (two lines at most, then an ellipsis)."
    field eyebrow String "A small line over the title (Achievement unlocked); empty is none."
    field icon String "An icon of the atlas in its well; empty draws the tone's mark."
    field image Option.Texture "An art slot in the well instead of the icon (an item, an avatar)."
    field tone Tone "Its tone: the accent edge and the icon well."
    field variant NotificationVariant "What it is."
    field rarity Rarity "A reward's tier: the well's glow and pips."
    field at u32 "og.ui.tick() when it was posted: its time runs from when it first shows (a queued one waits)."
    field durationMs f32 "How long it shows; 0 is the variant's time." {
      unit ms
      min 0
    }
    field sticky bool "It stays until dismissed or its action is pressed."
    field count u32 "How many times it happened (a ×3 chip from 2 on)."
    field progress Option.f32 "A progress bar under the body, 0 to 1 (an achievement 3 of 10 of the way)." {
      unit ratio
    }
    field progressText String "The progress in words (3 / 10); empty is none."
    field points String "A value at the end (+50 G, 120 XP); empty is none."
    field action String "A button's label (Accept, View); empty is none."
  }

  struct NotificationsDesc {
    doc "A stack of notifications (toasts) anchored in the safe area."
    desc true
    field items List.NotificationItem "The game's notifications, oldest first; past their time they leave on their own."
    field anchor Anchor "Where the stack sits; the default is the top right (the top centre on a phone in portrait)." {
      default topRight
    }
    field max u32 "The most shown at once (later ones queue); 0 is 3 (2 on a phone)."
    field width f32 "A card's width; 0 is 380 (the safe area's width less its gutters on a phone in portrait)." {
      unit cssPx
      min 0
    }
    field dismissLabel String "What a screen reader calls the swipe or press that dismisses one." {
      default "Dismiss"
    }
  }

  struct NotificationsResult {
    doc "What a notification stack answered this tick."
    field expired List.String "Keys whose time ran out this tick: drop them from the viewmodel."
    field dismissed List.String "Keys the player dismissed (a press on the card, a swipe, Back while it had focus)."
    field action Option.String "The key whose action button was pressed this tick."
    field shown List.String "The keys on screen, newest first."
  }

  fn notifications {
    doc "A notification stack (toasts, achievements, rewards, invites): cards anchored in the safe area, newest nearest the anchor's edge, that enter on the style's enter spring from that edge, reflow on its panel spring as others leave (layout animation), and leave sliding out. A card's lifetime drains along its bottom edge; the pointer resting on it holds the time; a press dismisses it, and a swipe toward the edge throws it off. More than max wait in a queue whose time does not run."
    doc "Parts: Notification.card[<variant>][<tone>] (the card, partClass hud), Notification.accent (the start edge in the tone), Notification.well[rarity=<tier>] (the icon or art slot), Notification.title, Notification.body, Notification.count (the ×3 chip), Notification.progress and Notification.progressFill, Notification.life (the draining time line), Notification.action. Slots: each item's image (art kind item, achievement or avatar, 1:1)."
    doc "States: on each card, group life (entering, shown, leaving) and group tone (the item's tone). Motion: enter and exit springs, layout motion for the reflow, an achievement's well pops (emphasis spring). Sounds: notification, reward (achievement, reward) or warning (alert) when a card first shows. Accessibility: each card is a status (an alert: an alert) named by its eyebrow, title and body; its action a button. Probe ids: <id>/<key>, its Title, Body, Count, Action, Life."
    host false
    param id String "Its id."
    param desc NotificationsDesc "The items and where they stack."
    returns NotificationsResult
  }

  enum BadgeKind {
    doc "What a count badge shows."
    variant count "A number (99+ past max)."
    variant dot "A dot: something new, unnumbered."
    variant label "A short word (NEW, HOT, -50%)."
  }

  struct CountBadgeDesc {
    doc "A count badge on the corner of the container it is built in (a tab, an inventory icon, a mailbox button)."
    desc true
    field kind BadgeKind "What it shows."
    field count u32 "The count; 0 hides a count badge."
    field max u32 "Past this it shows max+; 0 is 99."
    field text String "The label badge's word."
    field tone Tone "Its tone; the default is danger, the convention for unread counts." {
      default danger
    }
    field corner Anchor "The corner of the container it sits on: topRight is the end side's top (mirrored right to left)." {
      default topRight
    }
    field pulse bool "Pulse once when the count rises (the default)." {
      default true
    }
    field name String "What a screen reader says (3 unread); empty is the count."
  }

  fn countBadge {
    doc "A count badge: a small pill on a corner of the open container, outset by half its height so it straddles the edge, with a ring in the ground colour that cuts it from what it sits on. A count over max reads max+; a rise pops it (emphasis spring) and plays notification once. Hidden at 0."
    doc "Parts: CountBadge.base[<kind>][<tone>], CountBadge.text. States: group count (none, some, overflow). Accessibility: status named by name or the count. Probe ids: <id>, <id>/Text. Call it inside the container it decorates, after its content; the container should not clip."
    host false
    param id String "Its id."
    param desc CountBadgeDesc "What it shows and where."
    returns Void
  }

  struct TooltipStat {
    doc "A row of a tooltip's stats, with an optional comparison."
    desc true
    field label String "What it is (Damage)."
    field value String "Its value as shown (42–58)."
    field delta f32 "Against what is compared (the equipped item): positive is better, drawn with an up mark in success; negative with a down mark in danger; 0 none."
    field deltaText String "The delta as shown (+12); empty formats delta."
    field better bool "Higher is worse for this stat (a cooldown): flips the marks' colours."
  }

  struct TooltipLink {
    doc "What a keyword link in a tooltip's body opens: a nested tooltip of its own."
    desc true
    field key String "The `[link=key]` id in the body."
    field title String "Its title."
    field body String "Its body: rich text, with links of its own."
  }

  struct TooltipCardDesc {
    doc "A rich tooltip card beside its trigger."
    desc true
    field open bool "The trigger is hovered or focused (its Response's hovered or focused): it shows after delayMs and stays while open, while pinned, or while the pointer is over it."
    field target String "The trigger's path; a bare id names an element of the open container (built before this call). Empty places it at the pointer's last trigger rectangle of this tooltip."
    field title String "The title."
    field subtitle String "A line under it (Legendary sword, Passive)."
    field rarity Rarity "The title's colour and pips."
    field icon String "An icon of the atlas beside the title."
    field image Option.Texture "An art slot instead of the icon (item or ability icon, 1:1)."
    field body String "The body: rich text markup (og.ui.richText), its `[link=key]keyword[/link]` spans opening nested tooltips from links."
    field stats List.TooltipStat "Stat rows."
    field compareTitle String "With comparison deltas: the heading over a second card of what is equipped (Equipped); empty draws no second card."
    field compareStats List.TooltipStat "The equipped item's stats, in the second card."
    field footer String "A last line (Sell for 120, a flavour quote) in the muted ink."
    field hints List.String "Action hints (Right-click to equip), each with its action's glyph when one is named [action:equip]."
    field links List.TooltipLink "What the body's links open."
    field delayMs f32 "Rest before it shows; 0 is the style's slow duration." {
      unit ms
      min 0
    }
    field pinnable bool "It locks open: after pinMs of rest a ring fills on its corner and it stays when the pointer leaves the trigger, until the pointer leaves the card (as Paradox's games do); the pin action (middle mouse, T, a pad's Y) pins at once. Nested tooltips are always pinnable." {
      default true
    }
    field pinMs f32 "Rest before it pins; 0 is 900." {
      unit ms
      min 0
    }
    field width f32 "Its width; 0 is 320 (300 on a phone)." {
      unit cssPx
      min 0
    }
    field placement Anchor "Where it prefers to sit against the trigger: right (the end side), left, top or bottom. It sits beside the whole group the trigger is in (the panel or column, so it never covers its own trigger's panel) when there is room on either side of it, else beside the trigger; it flips and clamps to stay inside the safe area." {
      default right
    }
    field pinLabel String "The pin hint under a pinned card." {
      default "Pinned"
    }
  }

  struct TooltipCardResult {
    doc "What a tooltip card did this tick."
    field visible bool "It is on screen (or leaving)."
    field pinned bool "It is pinned."
    field link Option.String "The link pressed in it (or in a nested card) this tick: its key."
    field depth u32 "How many nested cards are open beneath it."
  }

  fn tooltipCard {
    doc "A rich tooltip: a card in the tooltip layer beside its trigger, flipped and clamped inside the safe area, with a title in its rarity's colour and pips, an art slot, rich-text body whose keyword links open nested cards (to any depth, each pinnable, as in Crusader Kings III and Baldur's Gate 3), stat rows, a comparison card of what is equipped with up and down deltas (Diablo IV), a footer and action hints. It fades and rises in on the style's enter spring after delayMs; a pinnable card fills a ring at its corner and locks; a locked card stays while the pointer is on it or on a card it opened."
    doc "Parts: TooltipCard.card[<rarity>][pinned], TooltipCard.header, TooltipCard.title, TooltipCard.subtitle, TooltipCard.well, TooltipCard.body, TooltipCard.stat, TooltipCard.delta[up|down], TooltipCard.compare (the second card), TooltipCard.footer, TooltipCard.hint, TooltipCard.pin (the ring). Slots: image (art kind item or ability, 1:1). States: group pin (resting, pinning, pinned); group cover (clear, hidden: a banner or level-up is announcing, and the card fades fully out and takes no input until it has gone). Sounds: open when it pins. Accessibility: tooltip named by the title, described by the body; its links are links. Probe ids: <id>, <id>/Title, <id>/Body (its links <id>/Body/<key>), <id>/Stat#i, <id>/Compare, <id>/Pin, a nested card <id>/<key>."
    host false
    param id String "Its id (one per trigger)."
    param desc TooltipCardDesc "When it shows, what it says and where."
    returns TooltipCardResult
  }

  enum ProgressStyle {
    doc "How a progress bar shows its value."
    variant bar "A track filled from its start."
    variant steps "Equal segments, each filled whole as the value passes it (a level's stages)."
    variant indeterminate "No value: a band sweeping along the track (loading of unknown length)."
  }

  struct ProgressBarDesc {
    doc "A progress bar."
    desc true
    field value f32 "Done, 0 to 1." {
      unit ratio
      min 0
      max 1
    }
    field buffer f32 "A second, paler fill ahead of value (downloaded, ahead of installed), 0 to 1." {
      unit ratio
      min 0
      max 1
    }
    field style ProgressStyle "How it shows."
    field steps u32 "For style steps: how many; 0 is 5."
    field label String "A caption over it at the start (Downloading); empty is none."
    field valueText String "The value in words at the end (2.1 of 4.5 GB); empty is the percent, with showValue."
    field showValue bool "Show the value at the end."
    field tone Tone "Its fill's tone; neutral is the primary."
    field width Option.Size "Its width; null grows."
    field thickness f32 "The track's height; 0 is 8 (6 on a phone)." {
      unit cssPx
      min 0
    }
    field sheen bool "A highlight sweeps over the fill while it is short of done (still under reduced motion it stops)." {
      default true
    }
  }

  fn progressBar {
    doc "A progress bar: a rounded track, a fill that moves to its value on the style's ui spring (never jumping back on a retarget), a buffer ahead of it, a sweeping sheen while it works, segments for steps, a sweeping band when indeterminate, and a caption and value over it. Reaching 1 flashes the fill once and plays success."
    doc "Parts: ProgressBar.track[<style>], ProgressBar.buffer, ProgressBar.fill[<tone>][done], ProgressBar.step[filled], ProgressBar.label, ProgressBar.value. States: group progress (working, done) and group mode (determinate, indeterminate). Accessibility: progressbar named by the label, 0 to 100 (busy when indeterminate). Probe ids: <id>, <id>/Track, <id>/Fill, <id>/Label, <id>/Value."
    host false
    param id String "Its id."
    param desc ProgressBarDesc "Its value and look."
    returns Void
  }

  struct ProgressRingDesc {
    doc "A progress ring or spinner."
    desc true
    field value Option.f32 "Done, 0 to 1; null spins (indeterminate)." {
      unit ratio
    }
    field size f32 "Its diameter; 0 is 48." {
      unit cssPx
      min 0
    }
    field thickness f32 "The ring's width; 0 is a tenth of the size, at least 3." {
      unit cssPx
      min 0
    }
    field tone Tone "The fill's tone; neutral is the primary."
    field label String "Text in the middle; empty is the percent for a value (none for a spinner), and none when the ring is under 40 px."
    field name String "What a screen reader calls it (Loading); empty is Progress."
  }

  fn progressRing {
    doc "A progress ring: an arc filled clockwise from the top on the style's ui spring, or a spinning arc that grows and shrinks as it turns (Material's indeterminate ring, which reads as working at any size); a label in the middle. Under reduced motion the spinner pulses its opacity instead of turning."
    doc "Parts: ProgressRing.track, ProgressRing.fill[<tone>][spinning], ProgressRing.label. States: group mode (determinate, indeterminate). Accessibility: progressbar (busy when spinning). Probe ids: <id>, <id>/Fill, <id>/Label."
    host false
    param id String "Its id."
    param desc ProgressRingDesc "Its value and size."
    returns Void
  }

  enum SkeletonShape {
    doc "What a skeleton stands in for."
    variant lines "Lines of text: the last one shorter."
    variant card "A card: an art block, a title and two lines."
    variant row "A list row: an avatar, a title and a line."
    variant avatar "A round avatar."
    variant block "A block of the given size."
  }

  struct SkeletonGroupDesc {
    doc "A skeleton standing in for content that is loading."
    desc true
    field shape SkeletonShape "What it stands in for."
    field lines u32 "Lines, for lines; 0 is 3."
    field count u32 "Repeats (rows of a list); 0 is 1."
    field width Option.Size "Its width; null grows."
    field height f32 "A block's or a card's art height; 0 is 120." {
      unit cssPx
      min 0
    }
    field name String "What a screen reader says while it loads." {
      default "Loading"
    }
  }

  fn skeletonGroup {
    doc "A skeleton: shapes of the neutral fill where content will arrive, swept by one sheen across the whole group (not each piece on its own clock), cornered as the parts they stand for. The sheen stops under reduced motion and the shapes breathe their opacity instead."
    doc "Parts: Skeleton.piece[<shape>], Skeleton.sheen. Accessibility: one progressbar, busy, named by name. Probe ids: <id>, <id>/Piece#i."
    host false
    param id String "Its id."
    param desc SkeletonGroupDesc "What it stands in for."
    returns Void
  }

  enum Notation {
    doc "How a number is written."
    variant grouped "Every digit, grouped by thousands (12,840,000)."
    variant compact "Shortened past 9,999 to three significant digits with K, M, B, T, then scientific (12.8M)."
    variant letters "Shortened as idle games do: K, M, B, T, then aa, ab, … az, ba … (1.25ab), never running out."
    variant scientific "Mantissa and exponent past 9,999 (1.28e7)."
    variant engineering "As scientific with the exponent a multiple of three (12.8e6)."
  }

  struct NumberFormatDesc {
    doc "How og.ui.formatNumber and the counters write a number."
    desc true
    field notation Notation "The notation."
    field decimals Option.u32 "Digits after the point; null is none below 10,000 and three significant digits in the shortened forms."
    field exponent i32 "The value is value × 10^exponent: numbers past 1e308 (an idle game's 1.5e420 is value 1.5, exponent 420)."
    field sign bool "A + before positive values."
    field prefix String "Text before it ($)."
    field suffix String "Text after it ( XP, %)."
    field group String "The thousands separator." {
      default ","
    }
    field point String "The decimal point." {
      default "."
    }
  }

  fn formatNumber {
    doc "A number written in a notation: grouped, compact, idle letters, scientific or engineering, with a sign, prefix and suffix and the locale's separators, and past 1e308 through its exponent. Deterministic: the same text on every host."
    host false
    param value f64 "The number (times 10^format.exponent)."
    param format NumberFormatDesc "How to write it."
    returns String
  }

  struct NumberCounterDesc {
    doc "A big number that counts to its value."
    desc true
    field format NumberFormatDesc "How it is written."
    field step Option.TypeStepName "The type step; null is xl3."
    field font FontRole "The font; the default is mono (tabular digits that do not jitter)." {
      default mono
    }
    field color Option.Paint "The ink; null is ink."
    field label String "A caption under it (Score, Gold); empty is none."
    field icon String "An icon of the atlas before it (coin); empty is none."
    field roll bool "Each digit rolls to its next like an odometer while it counts (the default); off, the number counts in place." {
      default true
    }
    field durationMs f32 "How long a change takes to count; 0 is 600 ms (a rise of more than a tenth takes up to 1.2 s)." {
      unit ms
      min 0
    }
    field delta bool "A rise throws its +n off the number, rising and fading (the default)." {
      default true
    }
    field ticks bool "Play counterTick as it counts, pitched higher through the count."
    field anchor Option.Anchor "Opens its own anchored group there (on the HUD chip); null builds it in place."
    field align TextAlign "How it aligns in its column."
  }

  fn numberCounter {
    doc "A number display for scores, currency and resources: written in its notation (idle letters past trillions, numbers past 1e308), counting to a new value on an ease-out, its digits rolling like an odometer, a +n delta flying off on a rise, a pop when it lands (emphasis spring) and a flash of danger on a fall; on the HUD chip with its outline when anchored. Returns the number shown this tick."
    doc "Parts: NumberCounter.frame[hud], NumberCounter.value, NumberCounter.digit, NumberCounter.icon, NumberCounter.label, NumberCounter.delta[up|down]. States: group change (still, rising, falling). Sounds: counterTick while counting, if ticks. Accessibility: text named by the label, value the final number written out (not each frame of the count). Probe ids: <id>, <id>/Value (its text is the whole number shown), <id>/Label, <id>/Delta."
    host false
    param id String "Its id."
    param value f64 "The value to count to (times 10^format.exponent)."
    param desc NumberCounterDesc "How it looks and counts."
    returns f64
  }

  enum BannerKind {
    doc "What a banner announces, which sets its look and timing."
    variant title "A title card: an area or chapter name over a thin rule (Elden Ring's place names), slow fade (3 s)."
    variant wave "A wave or round: a band across the screen with a large title that slams in (2.4 s)."
    variant victory "A win: a gold band with a burst (3.5 s); plays success."
    variant defeat "A loss: a dark band in danger (3.5 s); plays error."
    variant warning "A warning across the screen (Boss approaching): danger stripes that pulse (3 s); plays warning."
  }

  struct BannerDesc {
    doc "A full-width announcement."
    desc true
    field kind BannerKind "What it announces."
    field title String "The big line."
    field eyebrow String "A small line over it (Chapter II, Wave)."
    field subtitle String "A line under it."
    field shownAt u32 "og.ui.tick() when it should start: a later tick restarts it. Past its time it is gone."
    field durationMs f32 "How long it holds before it leaves; 0 is the kind's." {
      unit ms
      min 0
    }
    field anchor Anchor "Where it sits; the default is the centre." {
      default center
    }
    field image Option.Texture "An art slot behind the title (a boss portrait, a region's emblem; banner kind, about 4:1)."
  }

  struct BannerResult {
    doc "Where a banner is."
    field visible bool "On screen."
    field done bool "It finished this tick."
    field progress f32 "0 entering to 1 gone." {
      unit ratio
    }
  }

  fn banner {
    doc "A full-width announcement: a wave or round band that slams in with a squash and a shake, a title card that fades up over a rule that draws out from its centre, a victory band with a burst and confetti, a defeat band, a warning with sweeping danger stripes. Its letters track in as it enters; it holds, then leaves on the style's exit ease. The tick-driven timing makes it the same in a replay."
    doc "Parts: Banner.band[<kind>], Banner.rule, Banner.eyebrow, Banner.title, Banner.subtitle, Banner.stripes, Banner.art. Slots: image (art kind banner). States: group phase (entering, holding, leaving, gone). Sounds: by kind on entering. Accessibility: alert (warning, defeat) or status, named by eyebrow, title and subtitle. Probe ids: <id>, <id>/Title, <id>/Eyebrow, <id>/Subtitle."
    host false
    param id String "Its id."
    param desc BannerDesc "What it says and when."
    returns BannerResult
  }

  struct UiRibbonDesc {
    doc "A ribbon on a card or a result."
    desc true
    field text String "Its words (NEW, -50%, New best!)."
    field corner Anchor "Where on the open container: topLeft or topRight wrap the corner diagonally; top or bottom lie across as a banner with notched ends; center slaps it across the middle like a stamp." {
      default topRight
    }
    field tone Tone "Its colour; the default is primary." {
      default primary
    }
    field shownAt Option.u32 "og.ui.tick() when it slaps on (a stamp's motion and a sound); null shows it settled."
    field name String "What a screen reader says; empty is the text."
  }

  fn ribbon {
    doc "A ribbon: a diagonal band wrapping a corner of the open container with its folded tail, a notched banner across its top or bottom, or a stamp slapped across its middle (a New best!: it lands from large and turned, squashes, settles and puffs dust, emphasis spring). The open container should clip its corners for a corner ribbon."
    doc "Parts: Ribbon.band[<corner>][<tone>], Ribbon.fold, Ribbon.text. States: group slap (waiting, landing, settled). Sounds: confirm when it lands. Accessibility: status named by the text. Probe ids: <id>, <id>/Text."
    host false
    param id String "Its id."
    param desc UiRibbonDesc "Its words and place."
    returns Void
  }

  enum CelebrationKind {
    doc "Which celebration plays."
    variant confetti "Confetti falls over the screen from its top edge, tumbling and fluttering."
    variant burst "Rays, sparks and a ring thrown from the open container's centre (a reward, a level's star)."
    variant levelUp "A level up: a ring of light expands, rays turn behind a big LEVEL UP and the new level, sparks rise."
    variant fireworks "Shells rise and burst in rings across the top of the screen."
  }

  struct CelebrationDesc {
    doc "A celebration effect."
    desc true
    field kind CelebrationKind "Which one."
    field at u32 "og.ui.tick() when it fires: a later tick fires it again."
    field colors List.Paint "Its colours; empty is the primary, gold and the style's chart series."
    field intensity f32 "How much: confetti count and burst reach scale by it." {
      default 1
      min 0
      max 3
    }
    field title String "levelUp: the big word (LEVEL UP)." {
      default "Level up"
    }
    field value String "levelUp: the new level (12)."
    field durationMs f32 "How long it lasts; 0 is the kind's (confetti 3 s, burst 1 s, levelUp 2.6 s, fireworks 3.5 s)." {
      unit ms
      min 0
    }
  }

  fn celebration {
    doc "A celebration: confetti over the whole screen, a burst from the container it is built in, a level-up flourish centred on the screen, or fireworks. Particles are the UI's own (seeded, so a replay throws the same), drawn over the HUD and under dialogs; under reduced motion only the level-up's text and a soft glow show. Plays reward (levelUp, fireworks) or success (confetti, burst) when it fires."
    doc "Parts: Celebration.ring, Celebration.rays, Celebration.title, Celebration.value (level up). States: group play (idle, playing). Accessibility: a level up is a status named by its title and value. Probe ids: <id>, <id>/Title, <id>/Value."
    host false
    param id String "Its id."
    param desc CelebrationDesc "Which one and when."
    returns Void
  }

  struct StarRatingDesc {
    doc "A row of stars earned."
    desc true
    field earned u32 "Stars earned."
    field max u32 "Stars possible; 0 is 3."
    field size f32 "A star's size; 0 is 48 (the middle of three larger, as Angry Birds and Candy Crush do)." {
      unit cssPx
      min 0
    }
    field revealAt Option.u32 "og.ui.tick() when the stars start landing in turn (a results screen); null shows them settled."
    field staggerMs f32 "Between stars landing; 0 is 320." {
      unit ms
      min 0
    }
    field name String "What a screen reader says ({earned} of {max} stars)." {
      default "{earned} of {max} stars"
    }
  }

  fn starRating {
    doc "Stars earned: empty sockets, each earned star landing in turn from large with a turn and an overshoot (emphasis spring), a burst of sparks as it lands and a pitch rising star by star; the middle star of three sits higher and larger. Under reduced motion they fade in."
    doc "Parts: StarRating.socket, StarRating.star[earned]. States: on each star, group star (empty, landing, earned). Sounds: reward, pitched up a step per star. Accessibility: image named by name. Probe ids: <id>, <id>/Star#i."
    host false
    param id String "Its id."
    param desc StarRatingDesc "How many and when."
    returns Void
  }

  enum SubtitleSize {
    doc "The subtitle text size (XAG 104: the player chooses)."
    variant small "Small: the caption step, never under 18 px at 1080p."
    variant medium "Medium (the default)."
    variant large "Large."
    variant huge "Huge."
  }

  struct SubtitleSettings {
    doc "The player's subtitle settings (XAG 104), from a settings screen."
    desc true
    field enabled bool "Subtitles show." {
      default true
    }
    field captions bool "Sound captions show ([explosion], [footsteps])."
    field size SubtitleSize "The text size." {
      default medium
    }
    field background f32 "The box behind the text: 0 none (the text keeps its outline), 1 opaque." {
      default 0.75
      min 0
      max 1
      unit ratio
    }
    field speakerNames bool "Each line begins with its speaker's name." {
      default true
    }
    field speakerColors bool "Each speaker's name in its colour." {
      default true
    }
    field directions bool "An arrow beside a line whose speaker or sound is off screen, toward it." {
      default true
    }
  }

  struct SubtitleLine {
    doc "A line of dialogue or a sound caption showing now."
    desc true
    field key String "Its key (its probe id), stable while it shows."
    field text String "What is said, or the sound ([door creaks])."
    field speaker String "Who says it; empty for a sound caption or an unseen narrator."
    field color Option.Paint "The speaker's colour; null is the highlight."
    field caption bool "A sound caption, not speech: shown in brackets, only with captions on."
    field direction Option.f32 "Where its source is, clockwise from straight ahead (0 ahead, π/2 right); null on screen. With directions on, an arrow points there." {
      unit rad
    }
  }

  struct SubtitlesDesc {
    doc "The subtitles showing now."
    desc true
    field lines List.SubtitleLine "The lines showing now, oldest first: at most two speakers' lines show (the newest), captions above them."
    field settings SubtitleSettings "The player's settings."
    field bottom f32 "Extra space above the safe area's bottom (to sit over a HUD bar)." {
      unit cssPx
      min 0
    }
  }

  fn subtitles {
    doc "Subtitles and captions to the Xbox Accessibility Guidelines' 104: centred at the bottom of the safe area, at most two lines of at most about 42 characters each across 70 % of the width (the box wraps by words, never by letters), in the player's size (never under 18 px at 1080p), on a box of the player's opacity (an outline when it is clear), with the speaker's name in their colour, sound captions in brackets above speech, an arrow toward a speaker off screen, new lines fading in quickly (never sliding: text that moves is harder to read)."
    doc "Parts: Subtitles.box, Subtitles.line, Subtitles.speaker, Subtitles.text, Subtitles.caption, Subtitles.arrow. Accessibility: a log whose new lines are read, each line text named speaker: text. Probe ids: <id>, <id>/<key>, its Speaker, Text, Arrow."
    host false
    param id String "Its id."
    param desc SubtitlesDesc "The lines and the settings."
    returns Void
  }

  # ── components: HUD (docs/ui.md §11, Appendix C) ───────────────────────
  # Every HUD component builds in place (inside the game's own anchor or
  # row), or opens its own anchored group in the safe area when its desc
  # names an anchor: that group's id is the component's with Hud after it,
  # so an anchored component's path is <id>Hud/<id>. Components anchored at
  # one point stack in the order they are built (each moved past the ones
  # before it by their sizes the tick before), so two defaults at the top
  # never draw over each other. Sizes are a 1280×720 design scaled with the surface
  # (a 1080p HUD keeps its proportion; an ultrawide's extra width stays
  # margin), and text never drops under the checks' minimum.

  enum StatBarStyle {
    doc "A stat bar's shape."
    variant flat "A rounded track (the default)."
    variant slanted "Ends cut on a slant (sci-fi, fighting games)."
    variant pill "Fully round ends."
    variant pips "Discrete pips with a gap between them (a ship's shield cells, upgrade levels): one per segment (one per unit of max when segment is 0, at most 40), lit whole as the value reaches each, sharing the bar's length equally so bars of one width and count line up row over row."
  }

  struct StatBarDesc {
    doc "A health or resource bar."
    desc true
    field value f32 "The value."
    field max f32 "Its maximum." {
      default 100
    }
    field kind MeterKind "What it measures (its colour): health turns warn and danger as it falls."
    field color Option.Paint "A colour of its own instead of the kind's."
    field segment f32 "Value per segment: the bar is blocks of this much (Overwatch's 25-point blocks); 0 is one bar. With style pips, the value per pip (0 is 1)." {
      min 0
    }
    field shield f32 "Shield or armour on top of the value, drawn as a row of cells over the bar (Apex's armour)." {
      min 0
    }
    field shieldMax f32 "The most shield; 0 hides the row." {
      min 0
    }
    field shieldCell f32 "Shield per cell; 0 is one continuous strip." {
      min 0
    }
    field shieldTier Rarity "The shield's tier colour (white, blue, purple, gold, red as Apex's); none is the info colour."
    field heal f32 "Healing on its way, a pale preview past the fill." {
      min 0
    }
    field absorb f32 "An absorb on the health (World of Warcraft's, Diablo IV's): a white-blue overlay past the fill, laid back over its end when the bar is full." {
      min 0
    }
    field recoverable f32 "Damage that can still come back (a fighting game's grey health): drawn between the value and this." {
      min 0
    }
    field ghost bool "A drop leaves a pale chunk that holds, then drains to the new value (the default)." {
      default true
    }
    field label String "A short name at its start (HP); empty is none."
    field showValue bool "The value as text at its end (72 / 100)."
    field valueInside bool "The value inside the track at its end, over the fill, so the bar keeps its full length (a unit frame's health); the track grows to hold the text."
    field valueText String "The value as text instead (72%); empty formats value / max."
    field icon String "An icon of the atlas before it, as tall as its label's text at least (never only the track's height)."
    field width Option.Size "Its width; null is 240 (grows with the surface)."
    field thickness f32 "Its height; 0 is 14." {
      min 0
      unit cssPx
    }
    field low f32 "Below this fraction a health bar is low (warn)." {
      default 0.3
      unit ratio
    }
    field critical f32 "Below this fraction it is critical: danger, and it pulses." {
      default 0.15
      unit ratio
    }
    field reverse bool "Fills from the end (the right player's bar in a fighting game)."
    field style StatBarStyle "Its shape."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place."
    field name String "What a screen reader calls it; empty is the label, else Health."
  }

  fn statBar {
    doc "A health or resource bar to the bar of action games: blocks (segment), a ghost chunk that holds after a hit and then drains (Dark Souls, fighting games), a heal preview, an absorb overlay (World of Warcraft's white-blue), grey recoverable damage, the value inside its end or after it, a row of shield cells in their tier's colour over it (Apex Legends), low and critical states (warn, then danger pulsing), a mirrored fill for the right player, flat, slanted or pill ends, or discrete pips with a gap (style pips: n of max lit, the value after them). A drop is instant, a rise moves on the ui spring."
    doc "Parts: StatBar.frame[<style>][<level>], StatBar.track, StatBar.fill[<kind>][<level>], StatBar.ghost, StatBar.heal, StatBar.absorb[over], StatBar.recoverable, StatBar.block[filled], StatBar.cell[filled][<tier>], StatBar.track[pips], StatBar.pip[filled], StatBar.label, StatBar.value, StatBar.icon. States: group level (normal, low, critical, empty). Sounds: warning on crossing into critical. Accessibility: meter named by name, valueNow the value, valueMax max. Probe ids: <id>, <id>/Track, <id>/Track/Fill, <id>/Track/Ghost, <id>/Track/Block#i, <id>/Shield/Cell#i, <id>/Main/Pips/Pip#i (style pips), <id>/Main/Icon, <id>/Value (inside: <id>/Main/Track/Value/Text, outlined over a soft dark band that fades at both ends, with no absorb seam under it)."
    host false
    param id String "Its id."
    param desc StatBarDesc "The value and the look."
    returns Void
  }

  struct OrbMeterDesc {
    doc "An orb of health or mana."
    desc true
    field value f32 "The value."
    field max f32 "Its maximum." {
      default 100
    }
    field kind MeterKind "Its liquid's colour: health (red) or mana (blue)." {
      default health
    }
    field color Option.Paint "A colour of its own."
    field size f32 "Its diameter; 0 is 112." {
      min 0
      unit cssPx
    }
    field showValue bool "The value in the middle (the default)." {
      default true
    }
    field label String "A caption under it; empty is none."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place."
    field name String "What a screen reader calls it; empty is the label, else Health."
  }

  fn orbMeter {
    doc "An orb (Diablo's health and mana globes): a glass sphere filled from the bottom with a liquid whose surface sways, a highlight on the glass, a frame ring, the value in the middle; the level moves on the ui spring and a drop flashes it. Critical (under 15 %) pulses."
    doc "Parts: OrbMeter.frame, OrbMeter.glass, OrbMeter.liquid[<kind>], OrbMeter.surface, OrbMeter.value, OrbMeter.label. States: group level (normal, low, critical). Accessibility: meter. Probe ids: <id>, <id>/Orb/Liquid, <id>/Value."
    host false
    param id String "Its id."
    param desc OrbMeterDesc "The value and the look."
    returns Void
  }

  struct RadialMeterDesc {
    doc "A radial stamina wheel."
    desc true
    field value f32 "The value, in wheels: 1 is one full wheel."
    field wheels u32 "Wheels (an extended stamina's second and third ring); 0 is 1."
    field exhausted bool "Ran out: red, refilling slowly, until full (Breath of the Wild)."
    field size f32 "Its diameter; 0 is 56." {
      min 0
      unit cssPx
    }
    field hideWhenFull bool "Fades out a second after it is full (the default)." {
      default true
    }
    field color Option.Paint "Its fill; null is success."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place."
    field name String "What a screen reader calls it." {
      default "Stamina"
    }
  }

  fn radialMeter {
    doc "A radial stamina wheel (Breath of the Wild, Elden Ring's spirit gauge): a ring that drains clockwise, outer rings for extra wheels, warn under a third, red and pulsing when exhausted until it refills, fading out once full."
    doc "Parts: RadialMeter.track, RadialMeter.fill[normal|low|exhausted], RadialMeter.wheel#i. States: group level (full, normal, low, exhausted). Accessibility: meter. Probe ids: <id>, <id>/Wheel#i."
    host false
    param id String "Its id."
    param desc RadialMeterDesc "The value and the look."
    returns Void
  }

  struct AbilitySlotDesc {
    doc "An ability, item or spell on a bar."
    desc true
    field key String "Its key in an ability bar (and its probe id there)."
    field icon String "An icon of the atlas."
    field image Option.Texture "Its art (art kind ability, 1:1), filling the slot edge to edge; null draws the icon large on a gradient in a hue of its own."
    field name String "What a screen reader calls it (Fireball)."
    field action String "The action whose glyph the hotkey cap shows on the device used last (og.ui.frameGlyph: a gameplay action's binding, else a UI action's), so it follows a rebinding and the pad the player picks up; a pad's button draws as its icon where the style has one. Empty is none."
    field hotkey String "A label for the cap instead of the action's glyph (Q, LB, 1); empty shows the action's."
    field cooldown f32 "Seconds of cooldown left; 0 is ready." {
      min 0
      unit s
    }
    field cooldownMax f32 "The cooldown's length; the sweep shows cooldown over it." {
      min 0
      unit s
    }
    field charges u32 "Charges ready (a count at its corner when maxCharges is over 1)."
    field maxCharges u32 "Charges it holds; 0 or 1 is none."
    field chargeProgress f32 "How far the next charge has come, 0 to 1." {
      unit ratio
    }
    field cost String "Its cost (40): a small figure with a droplet at the bottom left corner while the slot is ready; empty is none."
    field unaffordable bool "Not enough resource: the art tinted red and the cost in danger."
    field outOfRange bool "The target is out of range: the art tinted red (the hotkey keeps its one quiet ink)."
    field active bool "Toggled on or channelling: a soft glow in the primary colour that breathes and a thin edge of it."
    field locked bool "Not learnt yet: the art greyed to about a third under a filled lock."
    field disabled bool "Cannot be used now (silenced, rooted, wrong stance): the art washed out under a red slash."
    field ultimate Option.f32 "An ultimate's charge 0 to 1: the slot is 1.15 times the others, a gold ring fills clockwise round its art with a small percent at the bottom; ready, a gold edge and glow breathe." {
      unit ratio
    }
    field level u32 "Ranks learnt (pips right under it)."
    field maxLevel u32 "Ranks it has; 0 draws no pips."
    field size f32 "Its side; 0 is 56 (48 on a phone)." {
      min 0
      unit cssPx
    }
  }

  fn abilitySlot {
    doc "An ability slot as shipped action bars draw it (Diablo IV, League, Destiny 2, Genshin): the art fills the frame edge to edge and stays the dominant element in every state; one centred numeral per state, the cooldown's seconds (tenths under ten, outlined) over a clockwise darkening of about 60 % (as seen) on the part to come, the part done clean, with a bright leading edge; a flash and a pop the tick it comes ready; charges in a small corner badge (none when the seconds show) with the next one's recharge along the bottom; the cost a small figure on a dark pill while ready; unaffordable, out-of-range, disabled (a red slash) and locked (a lock over dark art) treatments of the art; a soft glow and thin accent edge while active; an ultimate 1.15 times the others with a gold ring filling clockwise and a small percent; a frame of the style's corner with a top-lit rim, an inner shadow and a float shadow; rank pips right under it and the hotkey a quiet label in one neutral ink just below. A press answers on touch and with the pointer."
    doc "Parts: AbilitySlot.frame[ready|cooling|disabled|locked|active], AbilitySlot.icon, AbilitySlot.tint[locked|disabled|unaffordable|outOfRange], AbilitySlot.ultimate, AbilitySlot.sweep, AbilitySlot.flash, AbilitySlot.lock, AbilitySlot.slash, AbilitySlot.cost[unaffordable], AbilitySlot.recharge, AbilitySlot.charges, AbilitySlot.edge[active|ultimate], AbilitySlot.pip[filled], AbilitySlot.hotkey. Slots: image (art kind ability). States: group ready (ready, cooling, disabled, locked), group use (idle, active, unaffordable). Sounds: focus (the style's ready chime) the tick it comes ready. Accessibility: button named by name, value its seconds left, Unavailable, Locked or Ready. Probe ids: <id>, <id>/Slot/Time, <id>/Slot/Ultimate/Value, <id>/Slot/Cost/Value, <id>/Slot/ChargeBadge/Charges, <id>/Hotkey."
    host false
    param id String "Its id."
    param desc AbilitySlotDesc "The ability's state."
    returns Response
  }

  struct AbilityBarDesc {
    doc "A bar of ability slots."
    desc true
    field slots List.AbilitySlotDesc "The slots, in order; each one's key is its id."
    field size f32 "Each slot's side; 0 is 56 (48 on a phone)." {
      min 0
      unit cssPx
    }
    field gap f32 "Between slots; 0 is the style's sm space." {
      min 0
      unit cssPx
    }
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default bottom
    }
    field direction Direction "Which way the slots run."
  }

  struct AbilityBarResult {
    doc "What an ability bar answered."
    field clicked Option.String "The slot pressed and released this tick (its key)."
    field pressed List.String "The slots held."
  }

  fn abilityBar {
    doc "An ability bar: abilitySlot for each slot, in a row (or a column) straight on the scene (a style may dress AbilityBar.frame as a slim bar), evenly spaced; a row with more slots than the HUD band holds wraps into even rows whose columns line up (eight slots on a phone are two rows of four)."
    doc "Parts: AbilityBar.frame and each slot's. Accessibility: a group named by its slots. Probe ids: <id>/<key>."
    host false
    param id String "Its id."
    param desc AbilityBarDesc "The slots."
    returns AbilityBarResult
  }

  struct StatusEffect {
    doc "A buff or debuff on a unit."
    desc true
    field key String "Its key (its probe id)."
    field icon String "An icon of the atlas."
    field image Option.Texture "Its art (art kind buff, 1:1)."
    field name String "What it is (Haste); what a screen reader says."
    field stacks u32 "Stacks (a count at its corner from 2 on)."
    field remaining f32 "Seconds left; 0 lasts until removed." {
      min 0
      unit s
    }
    field duration f32 "Its whole length, for the sweep." {
      min 0
      unit s
    }
    field debuff bool "Harmful: in the debuff row, with a red border and a notch."
    field type String "A debuff's type for its border colour (magic, curse, poison, disease, bleed); empty is plain."
    field mine bool "Cast by the player (drawn larger in a target's grid)."
  }

  struct StatusGridDesc {
    doc "A grid of buffs and debuffs."
    desc true
    field effects List.StatusEffect "The effects, in the game's order."
    field columns u32 "Per row; 0 is 8."
    field size f32 "An icon's side; 0 is 32." {
      min 0
      unit cssPx
    }
    field max u32 "The most shown; more fold into a +n tile; 0 is no limit."
    field timers bool "The time left under each icon (the default)." {
      default true
    }
    field split bool "Debuffs in a row of their own under the buffs (the default)." {
      default true
    }
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place."
  }

  struct StatusGridResult {
    doc "What a status grid answered."
    field hovered Option.String "The effect under the pointer or focus (show its tooltip)."
    field clicked Option.String "The effect pressed (cancel a buff)."
  }

  fn statusGrid {
    doc "Buffs and debuffs to the bar of MMOs: icons in rows, a sweep darkening each as it runs out, the time left under it (12m, 45, 4.2), blinking in its last five seconds, stacks at its corner, debuffs in their own row bordered by their type's colour and notched so their kind is not told by colour alone, more than max folding into a +n tile; the columns as wide as the row's widest timer, so the tiles stay evenly spaced and each time overhangs its tile centred (WoW's auras)."
    doc "Parts: StatusGrid.tile[buff|debuff][type=<type>][expiring], StatusGrid.icon, StatusGrid.sweep, StatusGrid.time, StatusGrid.stacks, StatusGrid.more. States: on each tile, group time (lasting, running, expiring). Accessibility: list named Buffs and Debuffs; each tile an image named name, stacks and seconds. Probe ids: <id>/Buffs/<key>, <id>/Debuffs/<key>, their Time and Stacks, <id>/Buffs/More/Tile/Count."
    host false
    param id String "Its id."
    param desc StatusGridDesc "The effects."
    returns StatusGridResult
  }

  enum UnitClass {
    doc "A unit's standing, which dresses its frame."
    variant normal "A plain unit."
    variant elite "An elite: a gold dragon on its portrait's ring."
    variant rare "A rare: a silver one."
    variant boss "A boss: a skull and a heavier frame."
  }

  enum UnitFrameSize {
    doc "A unit frame's size."
    variant large "The player's or the target's frame (the default)."
    variant medium "A party member's."
    variant small "A target-of-target's or a pet's."
  }

  struct UnitFrameDesc {
    doc "A unit's frame: portrait, name, bars."
    desc true
    field key String "Its key in party frames (and its probe id there)."
    field name String "Its name."
    field level String "Its level (60, ??); empty is none."
    field title String "A line under the name (a guild, a class)."
    field portrait Option.Texture "Its portrait (art kind portrait, 1:1)."
    field icon String "A class or role icon of the atlas."
    field health f32 "Health."
    field healthMax f32 "Its maximum." {
      default 100
    }
    field shield f32 "An absorb shield over the health." {
      min 0
    }
    field resource Option.f32 "A resource bar's value (mana, rage, energy); null draws none."
    field resourceMax f32 "Its maximum." {
      default 100
    }
    field resourceColor Option.Paint "The resource's own colour instead of its kind's (rage red, energy yellow)."
    field resourceKind MeterKind "Its colour." {
      default mana
    }
    field castName String "What it is casting; empty is nothing."
    field castProgress f32 "How far the cast is, 0 to 1." {
      unit ratio
    }
    field effects List.StatusEffect "Buffs and debuffs, small under the bars."
    field hostile bool "An enemy: its name and bar in danger."
    field unitClass UnitClass "Elite, rare or boss."
    field targeted bool "The player's target: a highlight ring."
    field dead bool "Dead: grey, a skull."
    field offline bool "Disconnected: the portrait and bar greyed."
    field combat bool "In combat: crossed swords by the level."
    field leader bool "A party's leader: a crown."
    field size UnitFrameSize "How large."
    field reverse bool "Mirrored: the portrait at the end (a target frame)."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place."
  }

  fn unitFrame {
    doc "A unit frame to the bar of World of Warcraft and Final Fantasy XIV: a round portrait (an art slot, else a bust silhouette on a slate ground) in a neutral ring (danger for a hostile unit, gold for an elite or boss; targeted a step thicker with a light glow) ringed by the style and floating on its own shadow with no plate behind the frame, the level on a dark disc at most 40 % of it seated on its rim at the bottom inner side, a filled crown on the rim's upper outer side for a leader, an elite or boss dressing, the name on one line over the dominant health bar (its absorb as an overlay, its ghost, its numerals inside its end) and a resource bar, their names in the HUD's name treatment (a thin dark outline and a soft drop, no band behind them), the cast under them (compact: a slim bar about 60 % of the health's height in a darker amber, its name a step smaller over it), small buffs, and states for the target, dead (the portrait greyed to about 40 %, a small skull), offline (the portrait and bar greyed, the name readable), in combat and the leader's crown. A frame at a top or bottom corner takes half the HUD band beside the opposite corner's stack; where that leaves its bars too narrow (a phone at 200 % text) the later-built frame steps under the other onto its own row, so the two never share space. A press selects it."
    doc "Parts: UnitFrame.frame[<size>][hostile][targeted][dead], UnitFrame.portrait[<class>], UnitFrame.level, UnitFrame.name, UnitFrame.title, UnitFrame.health (a StatBar), UnitFrame.resource, UnitFrame.cast, UnitFrame.crown, UnitFrame.combat. Slots: portrait (art kind portrait). States: group life (alive, dead, offline), group selection (none, targeted). Accessibility: button named name, level and health. Probe ids: <id>, <id>/Avatar/Portrait, <id>/Avatar/Level, <id>/Bars/Head/Name, <id>/Bars/Health, <id>/Bars/Resource, <id>/Bars/Cast."
    host false
    param id String "Its id."
    param desc UnitFrameDesc "The unit."
    returns Response
  }

  struct PartyFramesDesc {
    doc "The party's frames."
    desc true
    field members List.UnitFrameDesc "The members, each with its key."
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default left
    }
    field gap f32 "Between frames; 0 is the style's sm space." {
      min 0
      unit cssPx
    }
  }

  struct FramesResult {
    doc "What a set of frames answered."
    field clicked Option.String "The member pressed this tick (its key)."
  }

  fn partyFrames {
    doc "Party frames: a column of medium unit frames, the leader crowned, each pressable to target."
    doc "Parts: PartyFrames.frame, and each member's unit frame. Accessibility: list named Party. Probe ids: <id>/<key>."
    host false
    param id String "Its id."
    param desc PartyFramesDesc "The members."
    returns FramesResult
  }

  enum RaidRole {
    doc "A raid member's role."
    variant none "No role shown."
    variant tank "Tank: a shield mark."
    variant healer "Healer: a cross."
    variant damage "Damage: a sword."
  }

