  # ── the component library: foundations and controls ─────────────────────
  # (docs/ui.md §11; TypeScript over the calls above, in
  # packages/engine/src/ui/foundations and ui/controls). Each control is an
  # interactive part a style dresses by its state (`Button.base[primary][hover]`,
  # `Toggle.track[on]`, `Slider.knob[focused]`), moving between its §7.3 state
  # groups on the style's motion (interaction from input; selection, validity
  # and load from its values: the probe's ui:state forces each); it takes the
  # pointer, a touch (44 CSS px at least on a coarse pointer), keys and a pad,
  # mirrors under a right-to-left locale, grows with the player's text size,
  # says its role to the accessibility tree and plays the style's sounds.

  enum TextRole {
    doc "A text's role in the hierarchy (docs/ui.md §12.2): its type step, font and weight come from the style's type tokens for the role."
    variant body "Running text (the default)."
    variant display "The largest: a title screen's name, a victory banner. A heading."
    variant title "A screen's or a dialog's title. A heading."
    variant heading "A section's heading. A heading."
    variant label "A control's or a field's name: one line, medium size."
    variant caption "Secondary detail under something: a timestamp, a hint."
    variant numeric "A number that changes (a score, a price, a timer): monospaced figures, so it never jiggles."
  }

  enum TextTone {
    doc "A text's ink by meaning."
    variant normal "The style's ink (the default)."
    variant muted "Secondary: inkMuted (4.5:1 on its panel in every built-in style)."
    variant faint "Tertiary, never for what must be read: inkFaint."
    variant primary "The style's primary as ink (a link, a highlight)."
    variant success "Success ink."
    variant warn "Warning ink."
    variant danger "Danger ink."
    variant info "Information ink."
    variant inverse "inkInverse, for text on an ink-coloured fill."
  }

  struct TextBlockDesc {
    doc "How a text block reads: its role, tone and how it fits."
    desc true
    field role TextRole "Its role: the type step, font and whether it is a heading."
    field tone TextTone "Its ink by meaning."
    field align TextAlign "How its lines align (start and end follow the writing direction)."
    field maxLines u32 "The most lines it shows, cut with an ellipsis after (0: all)."
    field nowrap bool "One line; with ellipsis it shrinks in a row and cuts."
    field width Option.Size "Its width; null fits the text (a centred or end-aligned text in a column takes the column)."
    field step Option.TypeStepName "A type step over the role's (a role's size, not its kind, changed)."
  }

  fn text {
    doc "Text in a role (docs/ui.md §11, Foundations): the style's type step, font and weight for display, title, heading, body, label, caption or numeric (monospaced figures), in a tone, cut after maxLines with an ellipsis (the probe and a screen reader still read it whole). Display, title and heading are headings to a screen reader (a style's flourish frames them). It grows with the player's text size and wraps between CJK characters by kinsoku. Probe: the element `<id>`, kind label, its whole text."
    host false
    param id String "Its id."
    param value String "The text (a string-table message, og.i18n.t)."
    param desc TextBlockDesc "Its role, tone and fit."
    returns Void
  }

  struct ProseDesc {
    doc "A passage of rich text: paragraphs at a readable measure."
    desc true
    field role TextRole "Each paragraph's role (body by default; caption for fine print)."
    field tone TextTone "Its ink."
    field width Option.Size "Its width; null grows, kept to a readable measure (about 66 characters) when measure is set."
    field measure bool "Keep lines to about 66 characters, as long reading wants." {
      default true
    }
    field gap Option.f32 "Space between paragraphs; null is the style's md." {
      unit cssPx
    }
    field align TextAlign "How its lines align."
  }

  fn prose {
    doc "A passage of rich text (og.ui.richText's markup: `[b]`, `[color=…]`, `[icon=…]`, `[link=…]`, `[wave]`…), split into paragraphs at blank lines, at a readable measure, each a text element `<id>/P#i` whose links are focusable children (`<id>/P#i/<link>`). Answers the link clicked this tick (keys and pads press links too). Its region reads as one group to a screen reader."
    host false
    param id String "Its id."
    param markup String "The markup; a blank line starts a paragraph."
    param desc ProseDesc "Its role, tone and measure."
    returns RichTextResult
  }

  enum IconPlate {
    doc "What an icon sits on."
    variant none "Nothing (the default)."
    variant circle "A disc of its tone's soft fill."
    variant square "A rounded square in the style's control radius."
  }

  struct IconMarkDesc {
    doc "An icon's size, tone, plate and badge."
    desc true
    field size f32 "Its size; 0 is 24." {
      unit cssPx
      min 0
    }
    field tone TextTone "Its ink by meaning."
    field plate IconPlate "What it sits on."
    field badge String "A count or word over its top end corner (`3`, `NEW`); empty for none. Past 99 it says 99+."
    field dot bool "A small dot over its top end corner (something new), when there is no badge."
    field label Option.String "What a screen reader calls it: null is the icon's name (an English word), empty is decoration."
  }

  fn iconMark {
    doc "An icon of the style's set (og.ui.icon) in a tone, on a plate, with a badge or a dot: the foundation every icon in a control is. An icon the set lacks is drawn as a mark of the same name where the controls know one (tick, cross, plus, minus, search, chevrons, lock, star, warning, info, eye, reset, globe), else a dot: never a missing glyph. Parts: `Icon.plate[circle]`, `Icon.badge`, `Icon.dot`. Probe: `<id>/Glyph`, `<id>/Badge` (its text)."
    host false
    param id String "Its id."
    param name String "The icon's name in the style's set."
    param desc IconMarkDesc "Its size, tone, plate, badge and name."
    returns Void
  }

  enum ArtFit {
    doc "How art fills its slot."
    variant cover "Fills it, cropped around the focal point (the default)."
    variant contain "Fits inside it whole, the rest the slot's ground."
    variant fill "Stretched to it."
  }

  enum ArtMask {
    doc "What art is cut to."
    variant round "The slot's rectangle with its radius (the default: the style's slot radius)."
    variant circle "A circle (a portrait, an avatar)."
    variant squircle "A continuous-corner square (an app-style icon)."
    variant none "Square corners."
  }

  struct ArtSlotDesc {
    doc "An art slot (docs/ui.md §13): where a generated or authored image goes, and what it shows until it is there."
    desc true
    field texture Option.Texture "The art; null shows the placeholder."
    field kind String "Its kind (Appendix F: keyArt, portrait, itemIcon, cardArt, banner…): the placeholder's silhouette is the kind's. A portrait, bust, character, splash, avatar, banner or keyArt waits as head and shoulders on a wash of two hues, a body (a paperdoll's figure) as a whole standing figure with no box; any other kind as an icon of its name in the style's set, else `image`."
    field aspect f32 "Width over height; 0 is 1 (a square)." {
      min 0
    }
    field fit ArtFit "How the art fills it."
    field focal Vector2 "The point cropping keeps, fractions of the art." {
      default 0.5 0.5
    }
    field mask ArtMask "What it is cut to."
    field radius Option.f32 "The corner radius for mask round; null is the style's slot radius." {
      unit cssPx
    }
    field loading bool "The art is on its way: the placeholder's sheen runs (still under reduced motion)."
    field frame Option.ThemeColor "A frame around it in this ink (a rarity's, a team's); null is the style's line."
    field width Option.Size "Its width; null grows."
    field height Option.Size "Its height; null follows the aspect."
    field label String "What a screen reader calls it; empty is decoration."
  }

  fn artSlot {
    doc "An image or art slot: the texture fitted and cut as its desc says, fading in when it arrives (the style's enter motion; at once under reduced motion); until then a placeholder drawn from the style (a gradient of its soft fills and the kind's silhouette, a passing sheen while loading), never a grey box. Parts: `Art.frame[placeholder][loading]` (a style dresses the frame by state), `Art.placeholder` (the kind's silhouette and sheen), `Art.image`. Role image when labelled. Probe: `<id>`, `<id>/Image` once loaded, `<id>/Placeholder` before."
    host false
    param id String "Its id."
    param desc ArtSlotDesc "The art, its slot and its placeholder."
    returns Void
  }

  enum ShapePreset {
    doc "A decorative shape."
    variant rect "A rectangle with the radius given (the default)."
    variant capsule "A rectangle rounded to half its height."
    variant ellipse "An ellipse (a circle when square)."
    variant polygon "A regular polygon of `sides`."
    variant star "A star of `sides` points."
    variant ring "A ring of `thickness`."
    variant diamond "A square on its point."
    variant line "A line across its box (vertical when taller than wide), `thickness` thick."
  }

  struct ShapeBoxDesc {
    doc "A decorative shape: its outline, fill, stroke and glow, in the style's colours."
    desc true
    field kind ShapePreset "Its outline."
    field width Option.Size "Its width; null is 24." 
    field height Option.Size "Its height; null is its width's."
    field fill Option.ThemeColor "Its fill's colour; null is primary."
    field fillTo Option.ThemeColor "A second colour: a linear gradient from fill to it at angle."
    field angle f32 "The gradient's direction, clockwise from the top (0 runs down)." {
      unit deg
    }
    field opacity f32 "Its opacity." {
      default 1
      min 0
      max 1
    }
    field stroke Option.ThemeColor "Its outline's colour; null for none."
    field strokeWidth f32 "Its outline's width; 0 is the style's hairline." {
      unit cssPx
      min 0
    }
    field glow Option.ThemeColor "An outer glow of this colour; null for none."
    field radius f32 "A rect's corner radius." {
      unit cssPx
      min 0
    }
    field sides u32 "A polygon's or a star's corners." {
      default 5
      min 3
    }
    field thickness f32 "A ring's or a line's thickness." {
      default 2
      unit cssPx
      min 0
    }
    field rotation f32 "Its turn, clockwise." {
      unit deg
    }
  }

  fn shapeBox {
    doc "A decorative shape drawn by the UI pass (docs/ui.md §5.1) in the style's colours: a pip, a gem, a star, a ring, a backdrop blob. It takes no input and is decoration to a screen reader. Part: `Shape.<kind>` (a style dresses `Shape.star` with art). Probe: `<id>`."
    host false
    param id String "Its id."
    param desc ShapeBoxDesc "Its outline and paints."
    returns Void
  }

  struct SeparatorDesc {
    doc "A separator: a hairline, upright or across, with an optional word in its middle."
    desc true
    field vertical bool "Upright (between items of a row)."
    field label String "A word in its middle (`OR`, a date); empty for a plain line."
    field inset f32 "Space kept at each end." {
      unit cssPx
      min 0
    }
    field strong bool "The style's strong line (between sections) rather than its hairline."
  }

  fn separator {
    doc "A separator between groups: the style's line (its divider ornament where the style has one and no label is given), across or upright, with a label in its middle between two lines. Role separator. Parts: `Separator.line[strong]`. Probe: `<id>`, `<id>/Label`."
    host false
    param id String "Its id."
    param desc SeparatorDesc "Its direction, label and weight."
    returns Void
  }

  enum SpaceStep {
    doc "A step of the style's spacing scale."
    variant md "The middle step (the default)."
    variant xxs "The smallest."
    variant xs "Extra small."
    variant sm "Small."
    variant lg "Large."
    variant xl "Extra large."
    variant xxl "Twice extra large."
    variant xl3 "The largest."
  }

  struct SpaceDesc {
    doc "Empty space by the style's scale."
    desc true
    field step SpaceStep "How much."
    field grow bool "Take all the space left in its row or column instead (pushes what follows to the end)."
  }

  fn space {
    doc "Empty space of a step of the style's spacing scale (so a style's density moves every gap at once), or all the room left. Probe: `<id>`, kind spacer."
    host false
    param id String "Its id."
    param desc SpaceDesc "How much."
    returns Void
  }

  struct ViewFrameDesc {
    doc "A framed 3D view (docs/ui.md §5.5): a camera's render target in the layout, turned by a drag, the wheel, keys and a pad."
    desc true
    field texture Option.Texture "The render target's colour; null shows the placeholder (loading)."
    field width Option.Size "Its width; null grows."
    field height Option.Size "Its height; null follows the aspect."
    field aspect f32 "Width over height; 0 is 1." {
      min 0
    }
    field yaw f32 "The turn shown, from game state (keep ViewFrameResult.yaw)." {
      unit deg
    }
    field pitch f32 "The tilt shown." {
      unit deg
    }
    field zoom f32 "The zoom shown." {
      default 1
    }
    field minZoom f32 "The least zoom." {
      default 0.6
    }
    field maxZoom f32 "The most zoom." {
      default 2.5
    }
    field minPitch f32 "The least tilt." {
      default -30
      unit deg
    }
    field maxPitch f32 "The most tilt." {
      default 60
      unit deg
    }
    field orbit bool "A drag turns and tilts it, the wheel zooms, Left and Right turn it while it has the focus." {
      default true
    }
    field cameraPosition Vector3 "Its camera's position, for the pointer ray."
    field cameraTarget Vector3 "What its camera looks at."
    field fov f32 "Its camera's vertical field of view; 0 gives no ray." {
      default 50
      unit deg
    }
    field label String "What a screen reader calls it (`Character preview`)."
    field hint String "A line over its bottom while it has not been turned (`Drag to rotate`); empty for none."
  }

  struct ViewFrameResult {
    doc "A view frame's turn, tilt and zoom after this tick's input, and its viewport's answer."
    field yaw f32 "The turn, to keep and pass back." {
      unit deg
    }
    field pitch f32 "The tilt." {
      unit deg
    }
    field zoom f32 "The zoom."
    field view SceneViewportInfo "The viewport's answer: its pixel size for the target, the ray, the pointer."
  }

  fn viewFrame {
    doc "A viewport in a frame (docs/ui.md §5.5, Foundations): og.ui.sceneViewport in a style-dressed slot that turns with a drag (keeping the fling's speed for a moment), tilts within its limits, zooms with the wheel or a pinch, and turns by 15° per Left or Right while it has the focus (Tab, a pad). Until the target has a texture it shows a placeholder with a spinner. Draw the scene into a target of view.pixelWidth × view.pixelHeight with the yaw, pitch and zoom it answers; a target of another shape covers the frame, cropped, never squashed. Parts: `ViewFrame.frame[focused]`, `ViewFrame.hint`. Role image (its label), its turn as its value. Probe: `<id>`, `<id>/Box/Picture/View`, `<id>/Box/HintRow/Hint`."
    host false
    param id String "Its id."
    param desc ViewFrameDesc "The target, its camera and its turn."
    returns ViewFrameResult
  }

  enum EmitterPreset {
    doc "A particle look."
    variant sparkle "Twinkling stars rising a little (the default): something rare, a reward."
    variant confetti "Paper squares falling and turning."
    variant embers "Sparks rising and fading: fire, heat, a forge."
    variant snow "Flakes drifting down."
    variant bubbles "Discs rising and swelling."
    variant dust "Motes drifting slowly every way: ambience behind a menu."
  }

  struct EmitterDesc {
    doc "An ambient particle emitter over the area of its parent."
    desc true
    field preset EmitterPreset "What it throws."
    field rate f32 "Particles a second; 0 is the preset's." {
      min 0
    }
    field colors List.ThemeColor "Its colours; empty is the preset's (the style's primary, highlight and gold)."
    field active bool "It throws (particles already thrown live out their lives when it stops)." {
      default true
    }
    field size f32 "Its particles' size, times the preset's." {
      default 1
      min 0
    }
  }

  fn emitter {
    doc "An ambient particle emitter (docs/ui.md §5.5) laid over its parent's area: sparkles on a rare card, embers on a forge, snow over a winter menu, confetti on a win. It takes no input, is decoration to a screen reader, and stops under reduced motion. Built on og.ui.particles; every particle is the engine's, seeded and in the snapshot. Probe: `<id>`."
    host false
    param id String "Its id."
    param desc EmitterDesc "Its look and rate."
    returns Void
  }

  struct EffectLayerDesc {
    doc "A subtree drawn offscreen and composited through a material, with the material's one number that matters as `amount`."
    desc true
    field material MaterialName "The material."
    field amount f32 "How far in it is, 0 to 1: dissolve's threshold, shine's sweep, hologram's flicker, glitch's strength, pixelate's cell, blur's radius, colorAdjust's grey." {
      min 0
      max 1
    }
    field color Option.ThemeColor "The material's colour (a dissolve's edge, a shine, a hologram's tint, an outline); null is the style's highlight."
    field sweep bool "Run amount from 0 to 1 and back by the clock (a shine passing, a hologram flickering); still under reduced motion."
    field periodMs f32 "One sweep's length." {
      default 2400
      unit ms
    }
    field custom Option.UiMaterial "A custom material (material custom)."
    field params List.f32 "A custom material's parameters."
  }

  fn effectLayer {
    doc "A layer (docs/ui.md §5.4): its subtree, built by `build`, drawn offscreen and composited through a material (a card dissolving as it is spent, a shine passing over a rare item, a hologram panel, a hit's glitch, a locked tile in grey), the material's parameters set from one amount. Its children keep their input and accessibility. Part: `Layer.frame`. Probe: `<id>` and its children."
    host false
    param id String "Its id."
    param desc EffectLayerDesc "The material and its amount."
    param build UiBuild "Builds what it draws."
    returns Void
  }

  struct PushButtonDesc {
    doc "A button: its role, size, icons, badge and states."
    desc true
    field variant ButtonVariant "Its role: primary (one per screen), secondary, ghost, quiet or danger."
    field size ControlSize "Its height (the style's control sizes; at least 44 CSS px of reach on a coarse pointer)."
    field icon String "An icon before the label (the style's set); empty for none."
    field iconEnd String "An icon after it (a chevron, an external mark); empty for none."
    field badge String "A count or word on its top end corner (`3`, `NEW`); empty for none."
    field loading bool "Working: a spinner takes the icon's place, it takes no press and says busy."
    field disabled bool "Shown but inert, dimmed."
    field disabledReason String "Why it is disabled, shown as its tooltip and read after its name (`Needs 300 gold`)."
    field width Option.Size "Its width; null fits the label."
    field selected bool "On (a toggle button: a filter, a pinned tool): its selection group, filled as pressed."
    field autofocus bool "Take the focus when it appears and no dialog is open."
    field tooltip String "A tooltip once the pointer rests on it; empty for none."
  }

  fn pushButton {
    doc "A button (docs/ui.md §11, Controls): primary, secondary, ghost (outlined), quiet (text) or danger, small, medium or large, with icons, a badge, a loading spinner and a disabled reason. It lifts under the pointer and the focus and sinks as it is pressed (its interaction group, on the style's motion), and the style dresses it as `Button.base[<variant>][hover|pressed|focused|disabled][selected]` (a version 1 style's button art included), its label in the ink that reads on its fill. A click is a press and a release inside it, Enter, Space or the pad's A while it has the focus. Role button (pressed while selected, busy while loading). Probe: `<id>`, `<id>/Label`, `<id>/Icon`, `<id>/Badge`."
    host false
    param id String "Its id."
    param label String "Its label."
    param desc PushButtonDesc "Its role, size, icons and states."
    returns Response
  }

  struct IconButtonDesc {
    doc "An icon button: an icon, its name and a badge."
    desc true
    field label String "Its name: read by a screen reader and shown as its tooltip (an icon alone is not a name)."
    field variant ButtonVariant "Its role; quiet (the default for an icon) draws only the icon until hovered." {
      default quiet
    }
    field size ControlSize "Its size: a square of the control height."
    field badge String "A count over its corner; empty for none."
    field dot bool "A dot over its corner (something new), when there is no badge."
    field selected bool "On (a toggled tool)."
    field disabled bool "Shown but inert."
    field round bool "A circle rather than the style's control corner."
  }

  fn iconButton {
    doc "An icon button: a square (or round) button of the control height around one icon, named by its label (its tooltip, and what a screen reader says), with a badge or a dot. It moves and is dressed as pushButton, `Button.base[icon]`. Probe: `<id>`, `<id>/Icon`, `<id>/Badge`."
    host false
    param id String "Its id."
    param icon String "The icon's name (the style's set; a drawn mark where it has none)."
    param desc IconButtonDesc "Its name, role, size and badge."
    returns Response
  }

  struct HoldButtonDesc {
    doc "A hold-to-confirm button."
    desc true
    field variant ButtonVariant "Its role (danger for a destructive confirm)." {
      default danger
    }
    field size ControlSize "Its height."
    field holdMs f32 "How long the hold takes." {
      default 1200
      unit ms
      min 100
    }
    field icon String "An icon before the label."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null fits the label."
    field toggle bool "The hold's toggle alternative for the pointer and touch too (XAG 107): a tap starts the fill, which runs on by itself; a second tap stops it. Keys and pads always work so (Enter, Space or A start it, again stops it, moving the focus away stops it)."
    field holdingLabel String "What it says while it fills (`Keep holding…`); empty keeps its label."
    field hint String "A line under it, what to do (`Hold to delete`); empty for none."
  }

  struct HoldResult {
    doc "A hold button's state after this tick."
    field response Response "What happened to it."
    field confirmed bool "The hold completed this tick: do the thing."
    field holding bool "It is filling."
    field progress f32 "How full it is, 0 to 1 (it drains back when let go)." {
      unit ratio
    }
  }

  fn holdButton {
    doc "A hold-to-confirm button: held (a press on it, a touch), it fills from its start edge over holdMs, ticking up in pitch, and confirms with the style's confirm sound and a pop; let go early, it drains back. Keys and pads take its toggle alternative (XAG 107: activate starts it, it runs by itself, activate again or moving the focus stops it), as the pointer does with toggle. Its progress is UI state (in snapshots). Parts: `HoldButton.base[<variant>][holding][hover|pressed|focused|disabled]`, `HoldButton.fill`. Role button, its fill as its value (percent). Probe: `<id>`, `<id>/Button`, `<id>/Button/Label`, `<id>/Button/Fill`."
    host false
    param id String "Its id."
    param label String "Its label."
    param desc HoldButtonDesc "Its role, time and alternative."
    returns HoldResult
  }

  enum LabelSide {
    doc "Which side of a switch or a check its label sits."
    variant start "Before it, the switch at the row's end (a settings row: the default for a switch)."
    variant end "After it (the default for a check)."
  }

  struct ToggleSwitchDesc {
    doc "A switch: its label, description and states."
    desc true
    field label String "Its label (the whole row takes the press)."
    field description String "A line under the label; empty for none."
    field disabled bool "Shown but inert."
    field side LabelSide "Where the label sits."
    field size ControlSize "Its size."
    field width Option.Size "The row's width; null fits (a settings row grows: pass grow)."
    field onLabel String "What a screen reader and the probe say when on (`On`); empty for none."
    field offLabel String "And when off."
  }

  struct SwitchResult {
    doc "A switch's or a check's state after this tick."
    field response Response "What happened to it."
    field on bool "Its state, to keep and pass back."
    field changed bool "It changed this tick."
  }

  fn toggleSwitch {
    doc "A switch: a track and a knob that slides from its start to its end as it turns on (its selection group, on the style's motion), the track filling with primary, with a label and a description; the whole row takes a press, Enter, Space or A. Plays toggleOn and toggleOff. Parts: `Toggle.track[on|off][hover|pressed|focused|disabled]`, `Toggle.knob[on]`, `Toggle.row[hover|pressed|focused|disabled]` (the whole row, which takes the press). Role switch, checked when on. Probe: `<id>` (its label as name), `<id>/Track`, `<id>/Track/Knob`."
    host false
    param id String "Its id."
    param on bool "Its state from game state."
    param desc ToggleSwitchDesc "Its label and states."
    returns SwitchResult
  }

  struct CheckFieldDesc {
    doc "A checkbox: its label, description and states."
    desc true
    field label String "Its label (the whole row takes the press)."
    field description String "A line under the label; empty for none."
    field mixed bool "Neither: some of what it stands for is on (a group's parent). A press turns it on."
    field disabled bool "Shown but inert."
    field invalid bool "It must be checked (terms to accept): danger outline and the validity group."
    field side LabelSide "Where the label sits." {
      default end
    }
    field width Option.Size "The row's width; null fits."
  }

  fn checkField {
    doc "A checkbox: a box that fills with primary and draws its tick (a dash when mixed) with a pop as it turns on (its selection group), with a label and a description; the whole row takes a press, Enter, Space or A. Plays toggleOn and toggleOff. Parts: `Checkbox.box[checked|mixed][invalid][hover|pressed|focused|disabled]`, `Checkbox.mark`, `Checkbox.row[hover|pressed|focused|disabled]` (the whole row). Role checkbox, checked when on (and its value `mixed`). Probe: `<id>`, `<id>/Box`, `<id>/Box/Mark`."
    host false
    param id String "Its id."
    param checked bool "Its state from game state."
    param desc CheckFieldDesc "Its label and states."
    returns SwitchResult
  }

  struct RadioOption {
    doc "One choice of a radio group."
    desc true
    field label String "Its label."
    field description String "A line under it; empty for none."
    field icon String "An icon before it (cards); empty for none."
    field disabled bool "Shown but cannot be chosen."
  }

  enum RadioVariant {
    doc "How a radio group draws its choices."
    variant list "A ring and a label per choice (the default)."
    variant cards "A framed card per choice, the chosen one ringed (a difficulty, a class)."
  }

  struct RadioGroupDesc {
    doc "A radio group: its choices and layout."
    desc true
    field options List.RadioOption "The choices."
    field selected i32 "The chosen one from game state; -1 is none." {
      default -1
    }
    field label String "The group's name: shown above it and read by a screen reader; empty for none."
    field variant RadioVariant "How it draws."
    field row bool "Lay the choices across (they wrap) rather than down."
    field disabled bool "Every choice inert."
    field width Option.Size "Its width; null fits."
  }

  struct ChoiceIndexResult {
    doc "A choice control's state after this tick."
    field selected i32 "The chosen index, to keep and pass back (-1: none)."
    field changed bool "It changed this tick."
    field focused i32 "The index with the focus (-1: none)."
  }

  fn radioGroup {
    doc "A radio group: one of several choices, as rings with labels or as cards. A press, Enter, Space or A chooses; Left and Right (and a pad's) step the choice while one has the focus, skipping disabled ones, as a native radio group does. The ring's dot grows in with a pop (selection group). Plays select. Parts: `Radio.option[selected][hover|pressed|focused|disabled]`, `Radio.ring[selected]`, `Radio.dot`, `Radio.card[selected]`. Role radiogroup with radio children, checked on the chosen. Probe: `<id>`, `<id>/Options/Option#i`."
    host false
    param id String "Its id."
    param desc RadioGroupDesc "Its choices and layout."
    returns ChoiceIndexResult
  }

  struct SliderMark {
    doc "A labelled point on a slider's track."
    field value f32 "Where it is."
    field label String "What it says under the track; empty for a tick only."
  }

  struct ValueFormat {
    doc "How a control shows a number."
    desc true
    field decimals i32 "Decimals; -1 follows the step (1 → 0, 0.5 → 1, 0.05 → 2)." {
      default -1
    }
    field unit String "Written after it (`%`, ` m`, `×`); empty for none."
    field percent bool "Show 0–1 as a whole percent."
    field labels List.String "Words for whole values from min (`Off`, `Low`, `Medium`, `High`): a setting's levels."
  }

  struct ValueSliderDesc {
    doc "A slider: range, step, label, readout, ticks and marks."
    desc true
    field min f32 "The range's low end."
    field max f32 "Its high end." {
      default 1
    }
    field step f32 "Snap to multiples of this from min (0: continuous; keys step a twentieth)."
    field label String "Its name, shown above it; empty for none."
    field showValue bool "Its value at the label row's end." {
      default true
    }
    field format ValueFormat "How its value reads."
    field ticks bool "A tick at every step (for a stepped slider of at most 20 steps)."
    field marks List.SliderMark "Labelled points under the track."
    field origin Option.f32 "Fill from this value rather than min (a balance, a bias: a bipolar slider)."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field bubble bool "A bubble over the knob with the value while it is dragged or focused." {
      default true
    }
  }

  struct ValueSliderResult {
    doc "A slider's value after this tick."
    field response Response "What happened to it."
    field value f32 "The value, to keep and pass back."
    field changed bool "It changed this tick."
    field committed bool "A drag ended, or a key or pad step landed: when to save or apply a costly setting."
  }

  fn valueSlider {
    doc "A slider: a track, a fill from min (or from an origin, both ways) and a knob. A press anywhere on the track jumps the knob there and a drag follows (a touch too; the knob grows under a finger), Left and Right step it while it has the focus (a held key or d-pad repeats), with ticks at its steps, labelled marks, a readout and a bubble over the knob while it moves. Plays sliderTick at each step passed (rising in pitch with the value). Parts: `Slider.track[hover|pressed|focused|disabled]`, `Slider.rail`, `Slider.fill`, `Slider.knob[pressed|focused]`, `Slider.core` (the knob's dot while held or focused), `Slider.tick[passed]`, `Slider.bubble`. Role slider with its range. Probe: `<id>`, `<id>/Track`, `<id>/Track/Knob`, `<id>/Head/Value`."
    host false
    param id String "Its id."
    param value f32 "The value from game state."
    param desc ValueSliderDesc "Its range, step and look."
    returns ValueSliderResult
  }

  struct RangeSliderDesc {
    doc "A range slider: two knobs on one track."
    desc true
    field min f32 "The range's low end."
    field max f32 "Its high end." {
      default 1
    }
    field step f32 "Snap to multiples of this (0: continuous)."
    field minGap f32 "The least distance between the knobs."
    field label String "Its name; empty for none."
    field showValue bool "Both values at the label row's end." {
      default true
    }
    field format ValueFormat "How its values read."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field lowLabel String "The low knob's accessible name; empty is `Minimum`."
    field highLabel String "The high knob's; empty is `Maximum`."
  }

  struct RangeResult {
    doc "A range slider's values after this tick."
    field low f32 "The low end, to keep and pass back."
    field high f32 "The high end."
    field changed bool "Either changed this tick."
    field committed bool "A drag ended or a step landed."
  }

  fn rangeSlider {
    doc "A range slider: two knobs on one track and the fill between them. A press on the track takes the nearer knob there and a drag moves it (never past the other, kept minGap apart); each knob is its own focus stop, Left and Right step it. Parts: `RangeSlider.track`, `RangeSlider.rail`, `RangeSlider.fill`, `RangeSlider.knob[low|high][pressed|focused]` (under a finger drawn inside `RangeSlider.reach`, its 44 px target). Two sliders to a screen reader (lowLabel, highLabel). Probe: `<id>/Track/Low`, `<id>/Track/High`."
    host false
    param id String "Its id."
    param low f32 "The low end from game state."
    param high f32 "The high end from game state."
    param desc RangeSliderDesc "Its range, step and look."
    returns RangeResult
  }

  struct NumberStepperDesc {
    doc "A number stepper: minus, the value and plus."
    desc true
    field min Option.f32 "The least value; null is unbounded."
    field max Option.f32 "The most; null is unbounded."
    field step f32 "What each press adds or takes." {
      default 1
    }
    field largeStep f32 "What a held press's repeats move by after a second; 0 is ten steps."
    field label String "Its name, before it in its row; empty for none."
    field format ValueFormat "How its value reads."
    field wrap bool "Past max it goes to min and back (needs both)."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null fits."
  }

  struct NumberResult {
    doc "A stepper's value after this tick."
    field value f32 "The value, to keep and pass back."
    field changed bool "It changed this tick."
  }

  fn numberStepper {
    doc "A number stepper: minus, the value and plus. A press steps once, a held press repeats after 400 ms and speeds up (large steps after a second); Left and Right step it while the value has the focus. A bound's button goes disabled at the bound. Plays sliderTick per step. Parts: `Stepper.frame[focused|disabled]`, `Stepper.button[dec|inc][hover|pressed|disabled]`, `Stepper.value`. Its label and the buttons share a line while they fit, the buttons go under the label when they do not (larger text, a narrow column). Role spinbutton with its range; its − and + are buttons under a finger (stops keys and pads reach too) and named images on a fine pointer (Left and Right on the focused stepper are theirs). Probe: `<id>/Frame/Dec`, `<id>/Frame/Value`, `<id>/Frame/Inc`."
    host false
    param id String "Its id."
    param value f32 "The value from game state."
    param desc NumberStepperDesc "Its range, step and look."
    returns NumberResult
  }

  struct CyclerDesc {
    doc "An option cycler: a setting's levels in one row."
    desc true
    field label String "Its name, before it; empty for none."
    field wrap bool "Past the last it goes to the first." {
      default true
    }
    field pips bool "A pip per option under the value, the current lit." {
      default true
    }
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field valueWidth Option.f32 "The value's width; null fits the longest option (so the arrows never move)." {
      unit cssPx
    }
  }

  fn cycler {
    doc "An option cycler, the console settings row: `‹ High ›` with pips. Left and Right (a pad's d-pad or stick) change it while it has the focus, the arrows take a press, and a press on the value steps forward; the value slides in from the side it came (selection on the style's motion). Arrows follow the writing direction. Plays select. Parts: `Cycler.frame[hover|focused|disabled]`, `Cycler.arrow[prev|next][disabled]`, `Cycler.pip[current]`. Role spinbutton reading the option; its arrows are buttons under a finger and named images on a fine pointer (Left and Right on the focused cycler are theirs). Probe: `<id>`, `<id>/Prev`, `<id>/Middle/Clip/Value#i` (the option shown), `<id>/Next`, `<id>/Middle/Pips/Pip#i`."
    host false
    param id String "Its id."
    param options List.String "The options."
    param index i32 "The current one from game state."
    param desc CyclerDesc "Its label and look."
    returns ChoiceIndexResult
  }

  struct SegmentItem {
    doc "One segment of a segmented control."
    desc true
    field label String "Its label; empty for an icon alone (name it with ariaLabel)."
    field icon String "An icon before it; empty for none."
    field disabled bool "Shown but cannot be chosen."
    field ariaLabel String "Its accessible name when it has no label."
  }

  struct SegmentedDesc {
    doc "A segmented control: its segments and layout."
    desc true
    field items List.SegmentItem "The segments."
    field selected i32 "The chosen one from game state."
    field size ControlSize "Its height."
    field equal bool "Every segment as wide as the widest." {
      default true
    }
    field width Option.Size "Its width; null fits."
    field label String "Its accessible name."
    field disabled bool "Every segment inert."
  }

  fn segmented {
    doc "A segmented control (segmented tabs): a track whose raised thumb slides to the chosen segment and takes its width on the style's spring (layout animation; it jumps under reduced motion). A press chooses; Left and Right step the choice while it has the focus, skipping disabled segments, mirrored right to left. The segments share the width they are given, never narrower than their labels: when they do not fit, the track scrolls sideways under a fade at the cut edge. Under a finger each segment is at least 44 px tall. Plays tab. Parts: `Segmented.track[focused|disabled]`, `Segmented.thumb`, `Segmented.item[selected][hover|pressed|disabled]`. Role radiogroup of radios. Probe: `<id>`, `<id>/Strip/Track/Item#i`, `<id>/Strip/Track/Thumb`."
    host false
    param id String "Its id."
    param desc SegmentedDesc "Its segments."
    returns ChoiceIndexResult
  }

  struct DropdownOption {
    doc "One option of a dropdown."
    desc true
    field label String "Its label."
    field description String "A line under it in the list; empty for none."
    field icon String "An icon before it; empty for none."
    field disabled bool "Shown but cannot be chosen."
    field group String "The heading it sits under; options of one group follow each other."
  }

  struct DropdownDesc {
    doc "A dropdown: its options, label and states."
    desc true
    field options List.DropdownOption "The options."
    field selected i32 "The chosen one from game state; -1 shows the placeholder." {
      default -1
    }
    field label String "Its name, above it; empty for none."
    field placeholder String "Shown while nothing is chosen; empty is `Select…`."
    field helper String "A line under it; empty for none."
    field error String "An error under it (and the danger frame); empty for none."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field searchable Option.bool "A filter field at the list's top; null shows it past 10 options."
    field searchPlaceholder String "The filter's placeholder; empty is `Filter`."
    field maxHeight f32 "The list's most height before it scrolls." {
      default 320
      unit cssPx
    }
  }

  struct DropdownResult {
    doc "A dropdown's state after this tick."
    field selected i32 "The chosen index, to keep and pass back."
    field changed bool "It changed this tick."
    field open bool "Its list is open."
  }

  fn dropdown {
    doc "A dropdown (a select): a field-like trigger with the chosen option and a chevron that turns as it opens; its list opens below it (above without room, kept on screen) as a floating layer that takes the focus at the chosen option, with groups, icons, descriptions, a tick on the chosen and a filter past 10 options. A press, Enter, Space or A opens it and chooses; Back, Escape or a press outside closes it and the focus returns to the trigger. Plays open, select and close. Parts: `Dropdown.trigger[open][invalid][hover|pressed|focused|disabled]`, `Dropdown.list`, `Dropdown.option[selected][hover|focused|disabled]`, `Dropdown.group`. Role combobox (expanded while open) and a listbox of options. Probe: `<id>/Trigger`, `<id>.list/Panel/Content/Option#i`."
    host false
    param id String "Its id."
    param desc DropdownDesc "Its options and states."
    returns DropdownResult
  }

  struct InputFieldDesc {
    doc "A text field with its label, helper, error and adornments."
    desc true
    field label String "Its name, above it (a screen reader names the field by it); empty for none."
    field placeholder String "Shown while it is empty."
    field helper String "A line under it; empty for none."
    field error String "An error under it, the danger frame, the validity group's invalid (a shake); empty for none."
    field required bool "A mark after the label."
    field icon String "An icon at its start; empty for none."
    field clearable bool "A clear button at its end while it has text." {
      default true
    }
    field maxChars u32 "The most characters it takes (0: no limit); with counter, `12/20` under it."
    field counter bool "Show the count under it (with maxChars, against the limit)."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field suffix String "Text at its end (`gold`, `.com`); empty for none."
  }

  struct InputResult {
    doc "A text field's state after this tick."
    field response Response "The field's response (focused while it is edited, submitted on Enter)."
    field value String "The text, to keep and pass back."
    field changed bool "The text changed this tick."
    field submitted bool "Enter was pressed in it."
    field cleared bool "The clear button emptied it."
  }

  fn inputField {
    doc "A text field (og.ui.textField's editing: IME, selection, clipboard, undo) in a framed row with a label above, an icon, a suffix, a clear button and a helper, error or counter line below. Its frame takes the focus ring as it is edited, turns danger and shakes once when an error appears (validity group). On a coarse pointer its row is 44 CSS px at least. Parts: `Input.frame[focused][invalid][disabled][hover]`, `Input.clear`. Role textbox named by its label; the error is an alert; the clear button is a button under a finger (a stop keys and pads reach too) and a named image on a fine pointer. Disabled, its text is drawn in muted ink on a fainter frame, out of the focus order, a textbox the tree calls disabled. Probe: `<id>/Frame/Field` (its text), `<id>/Frame/Clear`, `<id>/Foot/Error`."
    host false
    param id String "Its id."
    param value String "The text from game state."
    param desc InputFieldDesc "Its label and adornments."
    returns InputResult
  }

  struct InputAreaDesc {
    doc "A text area with its label, helper, error and counter."
    desc true
    field label String "Its name, above it; empty for none."
    field placeholder String "Shown while it is empty."
    field helper String "A line under it; empty for none."
    field error String "An error under it; empty for none."
    field rows u32 "Lines shown at once (more scroll)." {
      default 4
    }
    field maxChars u32 "The most characters (0: no limit)."
    field counter bool "Show the count under it."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
  }

  fn inputArea {
    doc "A text area (og.ui.textArea's editing) framed as inputField is, with its label, helper, error and counter. Parts: `Input.frame[area][focused][invalid]` and the field's. Probe: `<id>/Frame/Area`, `<id>/Foot/Counter`."
    host false
    param id String "Its id."
    param value String "The text from game state."
    param desc InputAreaDesc "Its label and adornments."
    returns InputResult
  }

  struct SearchBoxDesc {
    doc "A search box and its suggestions."
    desc true
    field placeholder String "Shown while it is empty; empty is `Search`."
    field suggestions List.String "What to suggest for the query now (the game's, already filtered), or with filter every candidate."
    field filter bool "Filter suggestions itself: those containing the query, case and accents ignored, those starting with it first."
    field recent List.String "Shown while the query is empty and it has the focus (recent searches); empty for none."
    field maxSuggestions u32 "The most shown." {
      default 6
    }
    field label String "Its accessible name; empty is the placeholder."
    field width Option.Size "Its width; null grows."
    field disabled bool "Shown but inert."
  }

  struct SearchResult {
    doc "A search box's state after this tick."
    field query String "The query, to keep and pass back."
    field changed bool "The query changed this tick."
    field submitted bool "Enter was pressed with the query (search for it)."
    field chosen Option.String "The suggestion chosen this tick (the query becomes it)."
    field cleared bool "The clear button emptied it."
    field focused bool "The field or a suggestion has the focus."
  }

  fn searchBox {
    doc "A search box with suggestions: a field with a lens, a clear button and, while it has the focus and something matches, a list of suggestions under it (recent searches while it is empty) whose matching part is bold, laid over what follows the field (it never pushes it down), or over what comes before it when below it would run past the screen's bottom. Down (or a pad's down) moves into the list, Enter or a press chooses; Escape (Back) closes the list and leaves the field focused, and typing or a press on the field opens it again. Typing stays in the field (the list takes no focus scope). Parts: `Search.frame[focused]`, `Search.list`, `Search.option[hover|focused]` (the query's match in bold). Role textbox with a listbox of options. Probe: `<id>/Frame/Field`, `<id>/List/Option#i`."
    host false
    param id String "Its id."
    param query String "The query from game state."
    param desc SearchBoxDesc "Its suggestions and look."
    returns SearchResult
  }

  struct PickedColor {
    doc "A colour as a picker answers it: sRGB components 0 to 1 and alpha."
    desc true
    field r f32 "Red."
    field g f32 "Green."
    field b f32 "Blue."
    field a f32 "Alpha." {
      default 1
    }
  }

  struct ColorPickerDesc {
    doc "A colour picker: its swatches and the parts it shows."
    desc true
    field swatches List.String "Preset colours as `#rrggbb` (a livery's, a team's); empty for none."
    field alpha bool "An opacity strip."
    field hex bool "A hex field." {
      default true
    }
    field label String "Its name; empty for none."
    field width Option.Size "Its width; null is 280."
    field disabled bool "Shown but inert."
  }

  struct ColorPickerResult {
    doc "A colour picker's colour after this tick."
    field color PickedColor "The colour, to keep and pass back."
    field hex String "It as `#rrggbb` (`#rrggbbaa` with alpha under 1)."
    field changed bool "It changed this tick."
    field committed bool "A drag ended, a swatch was chosen, a hex was entered or a step landed."
  }

  fn colorPicker {
    doc "A colour picker: a saturation and brightness square with a ring at the colour, a hue strip, an opacity strip, swatches and a hex field, with the colour before and after. A press or a drag on the square or a strip sets it (a touch too); Left and Right step the hue strip, the opacity strip and the square's saturation while they have the focus; swatches are buttons; a hex field takes `#rgb`, `#rrggbb` and `#rrggbbaa`. The hue is kept while the colour is grey (UI state). Parts: `ColorPicker.square[focused]`, `ColorPicker.hue` and `ColorPicker.alpha` (the strips' reach, 44 px tall under a finger) with `ColorPicker.hueBar` and `ColorPicker.alphaBar` (the strips drawn in them), `ColorPicker.thumb[focused]`, `ColorPicker.swatch[selected][hover|focused]`, `ColorPicker.preview`. Roles: two sliders and a slider-like square (its hex as its value), swatches as radios. Probe: `<id>/Square`, `<id>/Hue`, `<id>/Alpha`, `<id>/Swatches/Swatch#i`, `<id>/Bottom/Hex/Input/Frame/Field`."
    host false
    param id String "Its id."
    param color PickedColor "The colour from game state."
    param desc ColorPickerDesc "Its swatches and parts."
    returns ColorPickerResult
  }

  struct KeyBindingRowDesc {
    doc "A controls screen's row for one action: its name, its bindings on a device, and their capture."
    desc true
    field action String "The action (og.input.defineAction)."
    field label String "What it shows; empty is the action's label."
    field device Option.InputDevice "Whose bindings it shows and captures: keyboard and mouse, or a pad (its family's glyphs); null is the device used last (it follows live)."
    field slots u32 "How many bindings it shows on that device (primary, secondary)." {
      default 2
      min 1
      max 4
    }
    field reset bool "A reset button while the player changed it." {
      default true
    }
    field timeoutMs f32 "A capture cancels itself after this long (0: never)." {
      default 8000
      unit ms
    }
    field waitingLabel String "What a slot says while it waits; empty is `Press a key…` (`Press a button…` on a pad)."
    field cancelHint String "The hint beside it; empty is `Esc to cancel` (the pad's back glyph on a pad)."
    field emptyLabel String "What an unbound slot says; empty is `—`."
    field conflictLabel String "The conflict line, `{control}` and `{action}` filled; empty is `{control} is used by {action}`."
    field swapLabel String "The swap button; empty is `Swap`."
    field replaceLabel String "The replace button; empty is `Replace`."
    field cancelLabel String "The cancel button; empty is `Cancel`."
    field resetLabel String "The reset button's name; empty is `Reset to default`."
  }

  struct KeyBindingResult {
    doc "What a key-binding row did this tick."
    field capturing bool "One of its slots waits for input."
    field changed bool "Its bindings changed this tick (save with og.input.saveBindings)."
    field conflict bool "A captured control is used by another action: the row asks the player."
    field slot i32 "The slot capturing or in conflict (-1: none)."
  }

  fn keyBindingRow {
    doc "A key-binding row (the settings tree's controls page, docs/ui.md §11): the action's name and a slot per binding on a device (keyboard and mouse, or a pad, the device used last by default) showing its glyphs from og.input (keys as caps, pad buttons as their family's discs, composites as their parts). A press on a slot (Enter, A) starts og.input.startCapture for it: the slot pulses `Press a key…` with the cancel hint until the player presses something (Escape, the pad's back or the timeout cancels). A capture with no conflict is applied at once; one that shares a control asks inline (`W is used by Move forward`: Swap, Replace, Cancel) with og.input's conflict report. A locked action shows a lock and takes no press; a rebound one shows a reset. Plays select, confirm, cancel and error. Parts: `Rebind.row[capturing][conflict][locked]`, `Rebind.slot[empty][capturing][conflict][hover|pressed|focused|disabled]`, `Rebind.conflict`; the caps are the action bar's `ActionBar.glyph[key|face|shoulder]`, the reset an icon button (`Button.base[quiet][icon]`). A group named by the action, slots as buttons named `<action>, <slot>: <binding>`. Probe: `<id>/Main/Bound/Slots/Slot#i`, `<id>/Conflict/Swap`, `<id>/Conflict/Replace`, `<id>/Conflict/Cancel`, `<id>/Main/Bound/Reset` (once rebound). Where its slots and Reset do not fit beside each other at their least width (200 % text, a narrow column), the row stacks them, the first slot over the second, so every row of a list stacks alike; a key cluster (W A S D) keeps its order right to left."
    host false
    param world World "The world (the action map is world state)."
    param id String "Its id."
    param desc KeyBindingRowDesc "The action, device and labels."
    returns KeyBindingResult
  }

  enum KeyboardLayout {
    doc "An on-screen keyboard's keys."
    variant letters "Latin letters (QWERTY), shift and caps, digits on a long press of the top row (the default)."
    variant symbols "Digits and punctuation."
    variant numeric "A number pad: digits, a decimal point and a minus."
    variant kana "The Japanese kana table (gojūon) with the voicing marks, small kana and the long-vowel mark; typed kana compose until committed."
  }

  struct KeyboardDesc {
    doc "An on-screen keyboard: what it edits and how it types."
    desc true
    field value String "The text it edits, from game state."
    field layout KeyboardLayout "The keys it opens with (the player switches between letters and symbols, and kana when allowed)."
    field kana bool "The kana layout is offered."
    field compose bool "Letters compose (an IME: pinyin, romaji) instead of typing: the composition shows underlined and candidates take it."
    field candidates List.String "Conversions of the composition the game offers (a dictionary's, for KeyboardResult.composition); the kana layout adds its katakana itself."
    field maxChars u32 "The most characters (0: no limit)."
    field title String "What is being typed (`Name your hero`); empty for none."
    field placeholder String "Shown while the text is empty."
    field submitLabel String "The enter key's label; empty is `Done`."
    field password bool "Show the text as dots (the game keeps it); a numeric layout then takes digits only (a PIN: no sign, point or caret keys)."
  }

  struct KeyboardResult {
    doc "What an on-screen keyboard did this tick."
    field value String "The text, to keep and pass back."
    field composition String "What is being composed and not yet committed (show it, and look up candidates for it)."
    field changed bool "The text changed this tick."
    field submitted bool "Done was pressed: take the text."
    field closed bool "It was closed without submitting (Back, the close key, a press outside)."
    field layout KeyboardLayout "The keys shown now."
  }

  fn onScreenKeyboard {
    doc "An on-screen keyboard for pads and touch (docs/ui.md §11, Appendix D: search and names with a pad): a panel at the screen's bottom with the text being typed and its caret, a candidate bar while composing, and keys a pad walks with focus wrapping by rows (Y erases, LB and RB move the caret, Back closes) and a finger presses (a key pops its letter above the finger on a press). Letters (shift for one, double tap for caps), symbols, a number pad and the Japanese kana table, with composition for an IME: typed kana (or letters with compose) stay underlined in KeyboardResult.composition until a candidate (the game's, plus the katakana) or Enter commits them. Plays press, select and back sounds. Parts: `Keyboard.panel`, `Keyboard.key[wide][action][active][primary][hover|pressed|focused|disabled]` (primary: the enter key; disabled: a gap in the kana table), `Keyboard.preview`, `Keyboard.candidates`, `Keyboard.candidate[hover|pressed|focused]`, `Keyboard.popup`. A dialog named by its title; keys are buttons named by what they type. Probe: `<id>/Panel/Content/Keys/Row#r/Key#k`, `<id>/Panel/Content/Preview`, `<id>/Panel/Content/Candidates/Candidate#i`."
    host false
    param id String "Its id."
    param open bool "Whether it shows."
    param desc KeyboardDesc "What it edits and how it types."
    returns KeyboardResult
  }

  # ── the component library: genre patterns ──────────────────────────────
  # (docs/ui.md §11 and Appendix D; TypeScript over the calls above, in
  # packages/engine/src/ui/patterns). Each pattern draws named parts a
  # style dresses (`Inventory.item[rarity=epic][lifted]`), takes its
  # viewmodel as a desc and answers what the player did for the game to
  # apply, works with the pointer, a finger, keys and a pad, declares its
  # state groups (§7.3, forced with `ui:state:<path>.<group>=<state>`), moves
  # on the style's springs, plays its sounds and names its role. Every word
  # it shows is the game's (its labels are desc fields).

  struct GridItem {
    doc "An item of an inventory grid or a paperdoll slot, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable while it lives: its element id (letters, digits, - and _), so its probe path is <id>/Cells/<key>."
    field name String "What it is called: a screen reader's name and the tooltip's title."
    field icon String "An icon of the style's set drawn on it; empty draws its art, else its kind's silhouette."
    field image Option.Texture "Its art (art kind item: 1×1, 1×2, 2×3, 2×4 cells), covering its cells and turning with it."
    field x u32 "Its column from the start edge, 0 first."
    field y u32 "Its row from the top, 0 first."
    field w u32 "Columns it covers lying unturned." {
      default 1
      min 1
    }
    field h u32 "Rows it covers lying unturned." {
      default 1
      min 1
    }
    field rotated bool "It lies turned a quarter: it covers h columns and w rows, and its art turns with it."
    field count u32 "How many are in its stack: shown from 2, or from 1 when it stacks."
    field maxStack u32 "The most its stack holds; 0 and 1 do not stack."
    field rarity Rarity "Its tier: the tile's wash, its edge and its pips."
    field tag String "What kind of thing it is (helmet, ring, potion): a paperdoll slot takes the tags it lists, and InventoryGridDesc.highlight lights every item of one."
    field locked bool "It cannot be moved (a quest item, a bound one): a lock in its corner, and a drag or a pick-up of it shakes and is refused."
    field fresh bool "Picked up since the player last looked: a dot in its corner (the game clears it on InventoryGridResult.hovered)."
    field equipped bool "Worn or slotted elsewhere: a tick in its corner."
    field unusable bool "The player cannot use it (a class it does not fit, a level too high): a danger wash, and said so to a screen reader."
    field charge Option.f32 "Durability or charge, 0 to 1: a thin bar along its foot, danger under a quarter." {
      unit ratio
    }
  }

  struct InventoryCarry {
    doc "An item in the player's hand: dragged by the pointer or a finger, or picked up with confirm and moved with keys or a pad. A grid or paperdoll reports the one it holds; pass it to the others on the screen (their desc's carry) so the places that take it light up and a release over them lands it."
    field key String "The item."
    field source String "The id of the grid or paperdoll it was picked up from."
    field slot String "The paperdoll slot it was picked up from; empty when from a grid."
    field tag String "Its tag."
    field w u32 "Columns it covers as carried (turned when rotated)."
    field h u32 "Rows it covers as carried."
    field rotated bool "It is carried turned."
    field count u32 "How many are carried: its whole stack, or the part split from it."
    field x f32 "The pointer's x (for keys and pads, the centre of the place the focus is on)." {
      unit cssPx
    }
    field y f32 "The pointer's y." {
      unit cssPx
    }
    field byFocus bool "Keys or a pad carry it: it lands where confirm is pressed, not where the pointer lets go."
    field released bool "The pointer let it go this tick at x and y, outside the place that holds it: the grid or paperdoll under that point takes it (it is in no one's hand from the next tick)."
  }

  struct InventoryPick {
    doc "The game puts an item (or part of a stack) in the player's hand: after its own menu's Split 10, Take one, or a transfer it wants carried."
    desc true
    field key String "The item."
    field count u32 "How many to carry; 0 is the whole stack."
  }

  struct InventoryMove {
    doc "A move the player made: apply it to the viewmodel (the item is drawn where the viewmodel says, so it stays where it was until you do)."
    field key String "The item moved."
    field from String "The id of the grid or paperdoll it came from (this grid's own id for a move inside it)."
    field fromSlot String "The paperdoll slot it came from; empty when from a grid."
    field x u32 "Its new column."
    field y u32 "Its new row."
    field rotated bool "It now lies turned."
    field count u32 "How many moved: the whole stack, or the part split from it (leave the rest where it was, and give the moved part a new key)."
    field split bool "Part of a stack moved."
    field mergeInto Option.String "It was dropped on a stack of the same tag with room: add count to that stack (up to its maxStack) instead of placing it; what does not fit stays where it came from."
    field swapWith Option.String "It was dropped on one item it trades places with: that item goes where this one came from."
  }

  struct InventoryGridDesc {
    doc "A grid inventory (a backpack, a stash, a chest): items of several cells, rotation, stacks and splitting, quick transfer between containers."
    desc true
    field columns u32 "Its columns." {
      default 10
      min 1
    }
    field rows u32 "Its rows." {
      default 6
      min 1
    }
    field items List.GridItem "The items, each at its cell."
    field cellSize f32 "A cell's side; 0 is 52 on a desktop and 48 on touch. Cells never go below 44 on a coarse pointer: a grid wider than its room scrolls." {
      unit cssPx
      min 0
    }
    field capacity u32 "Cells past this many, in reading order, are locked (a bag not yet bought): drawn with a lock, taking nothing; 0 is every cell."
    field selected String "The selected item's key: ringed in the focus ink (a details panel beside shows it)."
    field highlight String "A tag whose items are lit and the others dimmed (what a slot or a recipe takes); empty lights none."
    field carry Option.InventoryCarry "An item carried from another grid or a paperdoll: its footprint shows where it would land under the pointer (or the focus), and a release or confirm there answers move with its from."
    field pick Option.InventoryPick "Put an item, or part of a stack, in the player's hand this tick (pass it once)."
    field label String "What a screen reader calls the grid (Backpack); it is also said with the cells used."
    field emptyLabel String "What a screen reader calls an empty cell." {
      default "Empty"
    }
    field lockedLabel String "What it calls a locked cell, and a locked item's state." {
      default "Locked"
    }
    field unusableLabel String "What it says of an item the player cannot use." {
      default "Cannot use"
    }
    field rotateLabel String "The touch button that turns the carried item." {
      default "Rotate"
    }
  }

  struct InventoryGridResult {
    doc "What an inventory grid answered this tick."
    field selected Option.String "The item pressed (a tap, a click, confirm on it while nothing is carried and it cannot be picked up): select it."
    field used Option.String "The item used: a double press or a double tap (drink the potion, equip the sword)."
    field menu Option.String "The item whose actions were asked for: a long press, or the details action (X, a pad's Y) on the focused item. Open its menu at menuAt (og.ui.contextMenu): split, drop, use."
    field menuAt Vector2 "Where that menu opens: the long press's point, or the focused item's corner." {
      unit cssPx
    }
    field quick Option.String "The item to send to the other container at once (quick transfer): a press with Shift held, or the details action held."
    field move Option.InventoryMove "A move to apply: an item placed, turned, merged, swapped or split, or one carried in from elsewhere."
    field carried Option.InventoryCarry "The item in the player's hand from this grid while it is carried (and on the tick it is let go outside the grid, with released): pass it to the paperdoll and the other grids on the screen."
    field hovered Option.String "The item under the pointer or the focus: show its tooltip beside hoveredRect (og.ui.tooltipCard, og.ui.popover)."
    field hoveredRect Option.UiRect "Where that item is on screen."
    field refused bool "A drop or a pick-up was refused this tick (no room, a locked cell or item): the place shook red and the error sound played."
  }

  fn inventoryGrid {
    doc "A grid inventory (Diablo, Path of Exile, Escape from Tarkov, Resident Evil): items covering several cells, drawn on wells in their tier's colour with pips, a count on stacks, a lock, a fresh dot, an equipped tick and a charge bar. The pointer or a finger drags an item (Shift splits half a stack off), its footprint lit success where it fits, primary where it merges or swaps, danger where it cannot; R (a pad's X, a touch button) turns it a quarter while carried; a release outside lands it on the paperdoll or grid under the pointer. Keys and a pad move the focus cell by cell; confirm picks the focused item up, the footprint follows the focus, confirm places it and Back puts it back. A long press or the details action asks for the item's menu; a double press uses it; Shift and a press, or the details action held, sends it to the other container."
    doc "Parts: Inventory.grid, Inventory.cell[empty|locked|target], Inventory.item[rarity=<tier>][selected][lifted][locked][unusable][dim], Inventory.art, Inventory.count, Inventory.charge, Inventory.footprint[valid|merge|swap|invalid], Inventory.ghost, Inventory.rotate. Slots: each item's image (art kind item, its cells' aspect). States: on each item, group selection (off, on), carry (resting, lifted) and highlight (normal, lit, dim); on the footprint, group drop (valid, merge, swap, invalid). Motion: the carried item lifts on the ui spring, items that move without a drag slide to their new cells (layout motion), a refused drop shakes. Sounds: select on a pick-up, confirm on a placing, error on a refusal, cancel when Back puts it back. Accessibility: a grid named by label and the cells used; items are gridcells named by their name, count, tier and states; empty cells too. Probe ids: <id>/Cells/<key>, <id>/Cells/Cell#<index>, <id>/Cells/Footprint, <id>/Ghost."
    host false
    param id String "Its id."
    param desc InventoryGridDesc "The grid, its items and what is carried in."
    returns InventoryGridResult
  }

  struct PaperdollSlot {
    doc "An equipment slot around the paperdoll's figure."
    desc true
    field key String "The slot's id (head, chest, mainHand): its element id."
    field label String "Its name (Head): said by a screen reader, and shown under an empty slot on a desktop."
    field accept List.String "The item tags it takes; empty takes any."
    field item Option.GridItem "What is worn there; null is empty (its w and h are not read: the item fills the slot)."
    field x f32 "Where its centre sits across the doll's box, 0 its start edge to 1 its end." {
      default 0.5
      unit ratio
    }
    field y f32 "Where its centre sits down the box, 0 the top to 1 the foot." {
      default 0.5
      unit ratio
    }
    field size f32 "Its side; 0 is 64 on a desktop, 56 on a phone." {
      unit cssPx
      min 0
    }
    field aspect f32 "Its width over its height (a two-handed weapon's tall slot is 0.5); 0 is square." {
      min 0
    }
    field icon String "The empty slot's silhouette, an icon of the style's set; without one (or one the set lacks) the kind its icon name, key or accepted tags say is drawn as a shape: helm, amulet, sword, shield, ring, glove, boot, armor or a relic's star, else a plain socket."
    field locked bool "Not open yet: a lock, taking nothing."
    field lockedHint String "Why it is locked (Unlocks at level 20)."
  }

  struct PaperdollStat {
    doc "A line of the paperdoll's stats, with the change the carried or hovered item would make."
    desc true
    field label String "What it is (Armor)."
    field value String "Its value as shown (1,240)."
    field delta f32 "The change the compared item makes: positive is better, drawn with an up mark in success; negative with a down mark in danger; 0 shows none."
    field deltaText String "The change as shown (+48); empty writes delta."
    field lowerIsBetter bool "A smaller value is better (a cooldown): flips the marks' meaning."
  }

  struct PaperdollEquip {
    doc "An item the player put in a slot."
    field slot String "The slot."
    field key String "The item."
    field from String "The id of the grid (or this paperdoll) it came from."
    field fromSlot String "The slot it came from when moved between slots."
    field swapped Option.String "The item that was in the slot: it goes where the new one came from."
  }

  struct PaperdollDesc {
    doc "A paperdoll: equipment slots around the character's figure, and its stats."
    desc true
    field slots List.PaperdollSlot "The slots, each placed around the figure."
    field title String "The character's name over the figure; empty is none."
    field subtitle String "A line under it (Level 42 Paladin); empty is none."
    field rating String "A headline number (812); empty is none."
    field ratingLabel String "What it is (Item power)."
    field stats List.PaperdollStat "The stats beside the figure (under it on a phone in portrait)."
    field statsTitle String "The stats' heading (Attributes); empty is none."
    field stack bool "The stats go under the figure, not beside it (a screen that puts the grids beside the doll); a phone in portrait always stacks them."
    field carry Option.InventoryCarry "An item carried from a grid: the slots that take its tag light up and the others dim; a release or confirm over one answers equip."
    field compare bool "The stats' deltas are shown (the game sets them from the carried or hovered item)."
    field selected String "The selected slot's key: ringed in the focus ink."
    field figureAspect f32 "The figure's box, width over height; 0 is 0.62 (a standing character)." {
      min 0
    }
    field emptyLabel String "What a screen reader adds for an empty slot." {
      default "Empty"
    }
    field lockedLabel String "What it adds for a locked slot." {
      default "Locked"
    }
    field width Option.Size "Its width; null grows."
  }

  struct PaperdollResult {
    doc "What a paperdoll answered this tick."
    field equip Option.PaperdollEquip "An item placed in a slot: apply it."
    field selected Option.String "The slot pressed while nothing is carried."
    field used Option.String "The slot double pressed (take the item off at once)."
    field carried Option.InventoryCarry "The item dragged out of a slot (or picked up with confirm) while it is carried, and on the tick it is let go outside with released: pass it to the grids."
    field hovered Option.String "The slot under the pointer or the focus: show its item's tooltip beside hoveredRect."
    field hoveredRect Option.UiRect "Where that slot is on screen."
    field refused bool "The carried item was refused this tick (a slot that does not take its tag, a locked slot): the slot shook and the error sound played."
  }

  fn paperdoll {
    doc "A paperdoll (Diablo, Baldur's Gate 3, World of Warcraft, Genshin's artifacts): the figure the game builds, framed in a well, with equipment slots placed around it by fractions of its box, each an item tile or an empty slot's silhouette and name; the character's name, a headline rating and the stats with the deltas of the item being compared beside it (under it on a phone in portrait). A carried item lights the slots that take its tag and dims the rest; dropping it there, or confirm on the slot with keys or a pad, equips it. An item is dragged out of its slot as from a grid."
    doc "Parts: Paperdoll.frame, Paperdoll.figure, Paperdoll.slot[empty|filled][accepts|rejects][locked][selected], Paperdoll.slotLabel, Paperdoll.rating, Paperdoll.stats, Paperdoll.stat, Paperdoll.delta[up|down]. Slots: the figure (built by the game: art kind character, a sceneViewport turntable); each worn item's image (art kind item). States: on each slot, group fill (empty, filled), target (none, accepts, rejects) and selection (off, on). Sounds: confirm on equip, error on a refusal. Accessibility: a group named by title; each slot a button named by its label and its item (or empty, locked); stats are text with their changes said. Probe ids: <id>/Doll/Slots/<slot key>, <id>/Doll/Figure, <id>/Stats/Stat#<i>."
    host false
    param id String "Its id."
    param desc PaperdollDesc "The slots, the stats and what is carried."
    param figure UiBuild "Builds the figure in its box (an art slot, a viewport)."
    returns PaperdollResult
  }

  # ·· card hands ··

  struct HandCard {
    doc "A card in the player's hand, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable while it is in the hand: its element id, so its probe path is <id>/Fan/<key>."
    field name String "Its name, on its banner."
    field cost Option.i32 "What it costs to play, in its gem in the top start corner; null draws no gem (a free card, a land)."
    field costUp bool "The cost is raised this turn: the gem's number in danger ink."
    field costDown bool "The cost is lowered: the number in success ink."
    field typeLine String "Its type (Attack, Skill · Fire): a line under the art."
    field text String "Its rules as rich-text markup (og.ui.richText): [b]Deal 6[/b] damage. [icon=…] and [color=…] are honoured."
    field image Option.Texture "Its art (art kind card); without it a placeholder in its tier's colour."
    field rarity Rarity "Its tier: its frame's colour and pips."
    field playable bool "The player can play it now (enough energy, a legal moment): unplayable cards are dimmed, their cost in danger ink, and a drag of one shakes and is refused."
    field needsTarget bool "Playing it asks for a target: dragged up, it stays over the hand and an arc follows the pointer to the target under it."
    field glow bool "It is worth playing now (a combo, a synergy): its edge glows in the primary ink."
    field fresh bool "Drawn this tick: it flies in from the draw pile."
  }

  struct CardTarget {
    doc "A place a targeted card can be played on: an enemy, an ally, a lane, as the game projects it onto the screen."
    desc true
    field key String "Its key, answered with the play."
    field name String "What a screen reader calls it."
    field rect UiRect "Where it is on the screen (og.ui.worldAnchor's or a HUD element's rectangle)."
    field valid bool "The aimed card can be played on it: the arc ends in success ink and a ring marks it; an invalid one turns the arc danger." {
      default true
    }
  }

  struct CardHandDesc {
    doc "A hand of cards, its targets and what it says."
    desc true
    field cards List.HandCard "The cards, first to last (start to end of the fan)."
    field targets List.CardTarget "Where a targeted card can go: aiming snaps the arc to the one under the pointer, and keys and pads step through the valid ones."
    field cardWidth f32 "A card's width at rest; 0 is 150 on a desktop (scaled with the screen) and 104 on a phone. Its height is 1.4 times it." {
      unit cssPx
      min 0
    }
    field spread f32 "How far the fan turns its outermost cards, in degrees; 0 is 3 a card, at most 18." {
      min 0
      max 40
    }
    field playLine f32 "How far up the screen a card must be dragged to play, as a fraction of the screen's height from its bottom; 0 is 0.36." {
      min 0
      max 1
    }
    field disabled bool "Not the player's turn: cards lift and can be read, none plays."
    field inspect String "The key of a card shown large in the middle (the details action, a long press); empty shows none."
    field label String "What a screen reader calls the hand." {
      default "Hand"
    }
    field targetPrompt String "What the arc's tip says while aiming with keys and pads." {
      default "Choose a target"
    }
  }

  struct CardPlay {
    doc "A card played: the game spends its cost and resolves it."
    field key String "The card."
    field target Option.String "The target's key, for a card that needs one."
  }

  struct CardAim {
    doc "A targeted card being aimed: what to preview (the damage on the enemy under it)."
    field key String "The card."
    field target Option.String "The valid or invalid target under the arc's tip; null over none."
    field x f32 "The arc's tip." {
      unit cssPx
    }
    field y f32 "The arc's tip." {
      unit cssPx
    }
  }

  struct CardHandResult {
    doc "What the hand did this tick."
    field played Option.CardPlay "A card played: a non-targeted one released above the play line (or confirmed with keys), a targeted one released on a valid target (or confirmed on one)."
    field aiming Option.CardAim "A targeted card being aimed."
    field hovered Option.String "The card under the pointer or the focus."
    field inspect Option.String "A card whose details were asked for: a long press, the details action; set CardHandDesc.inspect to it, and clear it on dismissed."
    field dismissed bool "The large card was dismissed (Back, a press)."
    field refused Option.String "An unplayable card the player tried to play: it shook, and the game may say why."
  }

  fn cardHand {
    doc "A hand of cards (Slay the Spire, Hearthstone, Marvel Snap, Balatro): fanned along an arc at the bottom of the play area, each card a frame in its tier's colour with its cost gem, art, name banner, type line and rich-text rules. The card under the pointer or the focus lifts clear of the fan, straightens and grows so it reads whole, and its neighbours part. Dragged above the play line a card plays on release; a card that needs a target stays over the hand while an arc follows the pointer, snapping to the target under it (success ink on a valid one, danger on an invalid one), and plays on release there. Keys and pads walk the hand with Left and Right, confirm plays or starts aiming (Left and Right then step through the valid targets, confirm plays, Back cancels), the details action shows a card large. An unplayable card is dimmed with its cost in danger ink, and trying it shakes it."
    doc "Parts: CardHand.fan, Card.frame[rarity=<tier>][lifted][dragging][aiming][unplayable][glow], Card.cost[up|down|unaffordable], Card.art, Card.name, Card.type, Card.text, CardHand.arc[valid|invalid|none], CardHand.reticle, CardHand.playLine, CardHand.inspect. Slots: each card's art (art kind card, 5:4). States: on each card, group lift (rest, lifted, held, aiming) and play (playable, unplayable); on the arc, group verdict (none, valid, invalid). Motion: cards move to their fan places on the ui spring (layout motion), a lifted card rises and grows, a fresh card flies in from the start edge, a played one leaves upward, a refusal shakes. Sounds: hover as a card lifts, select as a drag or aim starts, confirm on a play, error on a refusal, cancel when aiming stops. Accessibility: a listbox named by label; each card an option named by its name, cost and type, its rules as its description, unplayable said as disabled; aiming says the target. Probe ids: <id>/Fan/<key>, <id>/Arc, <id>/Reticle, <id>/Inspect."
    host false
    param id String "Its id."
    param desc CardHandDesc "The cards and their targets."
    returns CardHandResult
  }

  # ·· the call to action ··

  enum HeroTone {
    doc "A call to action's material."
    variant primary "The style's primary, lit from the top (End turn, Done, Play)."
    variant premium "Gold: the purchase a screen leads with (Summon ×10)."
    variant secondary "A raised neutral beside a primary or premium one (Summon ×1)."
    variant danger "A destructive action, raised in the danger colour."
  }

  struct HeroButtonDesc {
    doc "A call to action: tone, height, a keycap and whether it can be pressed now."
    desc true
    field tone HeroTone "Its material."
    field size ControlSize "Its height: the control heights of the density, at least 44 CSS px on touch."
    field disabled bool "Not now (the enemy's turn): it lies flat and inert, its label in the faint ink."
    field width Option.Size "Its width; null fits the label."
    field key String "The key or pad glyph of its action, in a keycap after the label (E, Space); empty shows none."
  }

  fn heroButton {
    doc "The one action a genre screen leads with (End turn, Summon, Play, Ready): a raised face lit from the top over a ledge of its own dark and a soft shadow on the scene, so it reads as a thing to press over any backdrop, beside the flat controls of og.ui.button. It lifts under the pointer and the focus and sinks when pressed; disabled it lies flat. A keycap after the label shows the action's binding on a desktop."
    doc "Parts: Pattern.button[primary|premium|secondary|danger][sm|md|lg], Pattern.buttonFace, Pattern.keycap. States: group interaction (normal, hover, pressed, focused, disabled). Motion: the ui token's lift and press. Sounds: the style's press. Accessibility: a button named by its label (and key). Probe id: <id>."
    host false
    param id String "Its id."
    param label String "What it does."
    param desc HeroButtonDesc "Tone, size, keycap, disabled and width."
    returns Response
  }

  # ·· rewards: pick one of N ··

  enum RewardTagKind {
    doc "What a reward's corner tag says."
    variant note "A plain note (Lv 3 → 4): the highlight."
    variant new "Never taken before: the tier's own ink, as a pull's New."
    variant upgrade "It improves one the player holds: the success ink with an up arrow."
  }

  struct RewardOption {
    doc "One reward of a choice, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable while offered: its element id, so its probe path is <id>/Options/<key>."
    field title String "What it is (Thunder Strike, +20 % Max Health)."
    field kind String "Its kind or source over the title (Relic, Gift of the Storm Warden, Weapon)."
    field text String "What it does, as rich-text markup (og.ui.richText): [b], [color=…] and [icon=…] are honoured."
    field image Option.Texture "Its art (art kind item or card); without it a placeholder in its tier's colour."
    field icon String "An icon of the style's set for the placeholder."
    field rarity Rarity "Its tier: the frame's colour, a glow from epic, and its pips."
    field tag String "A short tag in its corner (New, Upgrade, Lv 3 → 4); empty draws none."
    field tagKind RewardTagKind "What the tag says, which sets its ink: new in the tier's colour, upgrade in success ink with an up arrow."
    field locked bool "It cannot be taken (a requirement unmet): shaded with a lock, and a press shakes."
    field lockedHint String "Why, said under its text and to a screen reader."
  }

  struct RewardChoiceDesc {
    doc "A choice of rewards and what it allows."
    desc true
    field options List.RewardOption "The rewards, start to end."
    field title String "The heading over them (Choose a reward); empty is none."
    field subtitle String "A line under it (Pick 1 of 3)."
    field picks u32 "How many to take: 1 takes the one pressed at once (or after confirm with confirm); more need confirm." {
      default 1
      min 1
    }
    field confirm bool "A press selects; a Confirm button takes the selection (a choice the player should not take by a slip)."
    field selected List.String "The keys selected, for picks over one or confirm: the game passes back what it was answered."
    field rerolls i32 "Rerolls left: a Reroll button with the count; 0 shows it spent; -1 shows none." {
      default -1
    }
    field rerollCost String "What a reroll costs, beside its label (50 gold); empty is free."
    field banishes i32 "Banishes left: a Banish button that arms banishing, after which a press on a reward banishes it; -1 shows none." {
      default -1
    }
    field skipLabel String "A Skip button's label (Skip, Take 25 gold); empty shows none."
    field confirmLabel String "The Confirm button's label." {
      default "Confirm"
    }
    field rerollLabel String "The Reroll button's label." {
      default "Reroll"
    }
    field banishLabel String "The Banish button's label." {
      default "Banish"
    }
    field cardWidth f32 "A reward's width; 0 is 260 on a desktop (scaled with the screen) and the phone's room. Its height follows its content." {
      unit cssPx
      min 0
    }
  }

  struct RewardChoiceResult {
    doc "What the choice did this tick."
    field picked List.String "The rewards taken: one pressed (picks 1, no confirm), or the selection confirmed. Empty while none."
    field selected List.String "The selection after this tick's press (pass it back as RewardChoiceDesc.selected)."
    field rerolled bool "Reroll was pressed: offer new rewards and one fewer reroll."
    field banished Option.String "A reward banished: remove it and one banish."
    field skipped bool "Skip was pressed."
    field hovered Option.String "The reward under the pointer or the focus."
    field refused Option.String "A locked reward pressed: it shook."
  }

  fn rewardChoice {
    doc "A choice of N rewards (Slay the Spire's card reward, Hades' boons, Vampire Survivors' level-up, Balatro's shop packs): each reward a card in its tier's colour with its art, kind, title, tag and rich-text effect, dealt in one after another and flipped face up. The card under the pointer or the focus lifts and its edge brightens; a press takes it (or selects it, with confirm or several picks, its ring and a tick in the focus ink), the taken one rises and grows while the others fall away. Reroll, Banish (armed, every card shows a cross until one is pressed) and Skip sit under the cards. Keys and pads move along the cards, confirm takes or selects, Back disarms banishing. Side by side on a desktop and a phone on its side; one above another, compact, on a phone in portrait."
    doc "Parts: Reward.frame, Reward.card[rarity=<tier>][selected][banishing][locked], Reward.art, Reward.kind, Reward.title, Reward.text, Reward.tag, Reward.check, Reward.banishMark, Reward.actions, Reward.reroll, Reward.banish[armed], Reward.skip, Reward.confirm. Slots: each reward's art (art kind item or card). States: on each card, group selection (off, on) and fate (offered, banishing, locked). Motion: cards deal in with a stagger and turn face up on the emphasis spring; hover lifts on the ui spring; a taken card rises and the others fall and fade. Sounds: open as they deal, hover, select, confirm on a take, error on a locked one, toggle for banishing. Accessibility: a radiogroup (one pick) or group named by title; each reward a radio or checkbox named by its title, kind and tier, its effect as its description; locked said disabled with its hint. Probe ids: <id>/Options/<key>, <id>/Actions/Reroll, <id>/Actions/Banish, <id>/Actions/Skip, <id>/Actions/Confirm."
    host false
    param id String "Its id."
    param desc RewardChoiceDesc "The rewards and what the choice allows."
    returns RewardChoiceResult
  }

  # ·· gacha: the banner and the pull ··

  struct GachaFeatured {
    doc "A featured unit of a banner (its rate-up)."
    desc true
    field name String "Its name."
    field title String "A line under it (Lightning Swordswoman)."
    field stars u32 "Its stars, drawn as stars (never a glyph a font may lack)."
    field rarity Rarity "Its tier's colour."
    field image Option.Texture "Its portrait (art kind portrait), in its tile; without it the style's placeholder figure."
  }

  struct GachaBannerTab {
    doc "One banner of the set the player switches between."
    desc true
    field key String "Its key: its element id."
    field name String "Its short name (Event, Weapon, Standard)."
    field image Option.Texture "A thumbnail (art kind banner); without it the tier wash."
    field endsIn Option.f32 "Seconds until it ends; null for a permanent banner." {
      unit s
    }
    field fresh bool "New since the player last looked: a dot."
  }

  struct GachaBannerDesc {
    doc "A gacha banner (its art, its featured units, its rules) and the player's purse."
    desc true
    field banners List.GachaBannerTab "The banners; one or none draws no switcher."
    field current String "The key of the banner shown."
    field title String "The banner's title over the art."
    field subtitle String "A line under it (Limited banner · Character)."
    field image Option.Texture "The key art (art kind banner), across the frame around its focal point under the art builder's layer; null draws the style's placeholder: a figure on a gradient of two hues, lit at the focal point."
    field focal Option.Vector2 "The art's point kept in view, fractions from the top start; null is the featured unit's place on the art side (0.68, 0.36 on a desktop; 0.5, 0.3 in portrait)."
    field topInset f32 "Room kept clear over the words and tabs for the game's own chrome on the art (a back button, a menu): the art and a short top shade run under it. Laid out to the screen's edges, the banner also keeps its words and controls inside the safe area while its art fills the notch and status bar." {
      unit cssPx
      min 0
    }
    field featured List.GachaFeatured "The featured units: the first named large on the art (its name plate) and each in a row with its stars beside the title."
    field rateText String "The rate-up rule, as rich text ([b]50 %[/b] chance the 5★ is featured)."
    field endsIn Option.f32 "Seconds until it ends: a timer chip, urgent in its last hour." {
      unit s
    }
    field pity u32 "Pulls made toward the guarantee."
    field pityMax u32 "Pulls at which a top tier is guaranteed; 0 shows no pity meter."
    field pityLabel String "What the meter says ({left} is the pulls left)." {
      default "Guaranteed in {left}"
    }
    field currency String "The pull currency's name (its icon when the style has one)." {
      default "gem"
    }
    field currencyIcon Option.Texture "The currency's own art, drawn wherever a price or the purse names it; null draws the style's icon of that name, else a gem drawn as a shape."
    field balance u32 "How much of it the player has."
    field single u32 "What one pull costs."
    field multi u32 "What ten cost; 0 hides the ten-pull."
    field multiCount u32 "How many the multi pull draws." {
      default 10
    }
    field singleLabel String "The one-pull button." {
      default "Summon ×1"
    }
    field multiLabel String "The ten-pull button ({n} is multiCount)." {
      default "Summon ×{n}"
    }
    field shortLabel String "Said with a price the balance cannot pay." {
      default "not enough"
    }
    field detailsLabel String "The rates and details button." {
      default "Details"
    }
    field historyLabel String "The pull history button." {
      default "History"
    }
    field daysLabel String "A time left of a day or more, on the timer and the tabs ({d} days, {h} hours)." {
      default "{d}d {h}h"
    }
    field hoursLabel String "A time left of an hour or more ({h} hours, {m} minutes)." {
      default "{h}h {m}m"
    }
    field minutesLabel String "A time left under an hour, on the tabs ({m} minutes; the timer counts it down as m:ss)." {
      default "{m}m"
    }
  }

  struct GachaBannerResult {
    doc "What the banner did this tick."
    field pull u32 "Pulls asked for this tick: 1, multiCount, or 0. The game checks the purse, spends it and starts og.ui.pullSequence."
    field short u32 "Pulls asked for that the balance cannot pay: offer the top-up (0 when none)."
    field banner Option.String "Another banner picked."
    field details bool "Details was pressed."
    field history bool "History was pressed."
  }

  fn gachaBanner {
    doc "A gacha banner (Genshin Impact, Honkai: Star Rail, Fate/Grand Order, Marvel Snap's spotlight): the key art across the screen (the game's texture, or the style's placeholder figure) with the first featured unit's name plate large on the art side, and, on the other side over a scrim that keeps its text readable on any art, the title and subtitle, the featured units with their stars in their tier's colour, the rate-up rule, the time left (a timer chip, urgent in its last minute; a tab's time in warn ink in its last hour), and under them the purchase block: the pity meter, the purse, and the one and ten pull buttons with their prices (a price the purse cannot pay in danger ink, said not only shown). On a phone in portrait the purchase block sits at the foot, under the thumb. A switcher of banners sits at the start edge on a desktop and above on a phone. Bumpers or Q and E switch banners; keys and pads move between the buttons."
    doc "Parts: Gacha.frame, Gacha.art, Gacha.scrim, Gacha.featured, Gacha.unit[rarity=<tier>], Gacha.stars, Gacha.rate, Timer.chip[urgent], Gacha.pity, Gacha.purse, Gacha.pull[single|multi][short], Gacha.tabs, Gacha.tab[current][fresh], Gacha.details, Gacha.history. Slots: the key art (desc.image, art kind banner, the full frame; the art builder draws over it); each tab's thumbnail. Parts also: Gacha.spotlight (the name plate). States: on each tab, group selection (off, on); on each pull button, group purse (afford, short). Motion: the art and text cross-fade when the banner changes (layout motion on the ui spring); the pull buttons lift under the pointer. Sounds: tab on a switch, press on a pull, error when short. Accessibility: a tablist of banners; the pulls are buttons named by their label and price (and not enough when short); the pity meter a meter; the timer a timer. Probe ids: <id>/Spotlight, <id>/Body/Tabs/<key>, <id>/Body/Main/Info/Title, <id>/Body/Main/Info/Timer, <id>/Body/Main/Info/Featured/Unit#<n>, <id>/Body/Main/Foot/Pulls/Buttons/Single, …/Buttons/Multi, …/Pulls/Status/Pity, …/Pulls/Status/Purse, <id>/Body/Main/Foot/Bar/Details, …/Bar/History."
    host false
    param id String "Its id."
    param desc GachaBannerDesc "The banner and the purse."
    param art UiBuild "Builds over the key art, filling the frame (a sceneViewport, particles, a second figure); may build nothing."
    returns GachaBannerResult
  }

  struct PullItem {
    doc "One result of a pull."
    desc true
    field key String "Its key within the pull: its element id."
    field name String "What was drawn."
    field kind String "What sort it is (Character, Weapon, Light Cone)."
    field stars u32 "Its stars, drawn as stars."
    field rarity Rarity "Its tier: the reveal's colour (the highest tier of a pull tints its charge), its glow, its burst from legendary."
    field image Option.Texture "Its art (art kind character or item)."
    field isNew bool "Drawn for the first time: a New tag."
    field extra String "What a duplicate turned into (+10 Star Shards); empty for none."
    field rarityLabel String "Its tier's word in the player's language (Legendary), set in the tier's ink before its kind on the reveal, so the tier is read in a word as well as in colour and stars; empty takes the tier's English name."
    field title String "A character's epithet, a caption in its tier's ink under the name (the banner's grammar: the name large, the epithet under it); empty for none."
  }

  struct PullSequenceDesc {
    doc "A pull to reveal: start one by giving a new token."
    desc true
    field token u32 "The pull's number: a change starts the sequence again from its charge; 0 shows nothing."
    field items List.PullItem "What was drawn, in reveal order."
    field againLabel String "The pull-again button in the summary ({n} is the count); empty shows none." {
      default "Again ×{n}"
    }
    field againPrice u32 "Its price, in currency."
    field currency String "The currency of againPrice." {
      default "gem"
    }
    field currencyIcon Option.Texture "The currency's own art beside againPrice; null draws the style's icon, else a gem."
    field backdrop Option.Texture "The banner's scene behind the charge and the reveal, blurred and dimmed under the tier's light (the banner's key art); null is the stage's dark."
    field affordable bool "The purse pays againPrice." {
      default true
    }
    field doneLabel String "The summary's close button." {
      default "Done"
    }
    field skipLabel String "The skip-to-summary button." {
      default "Skip"
    }
    field tapLabel String "What the reveal says to go on on a touch screen." {
      default "Tap to continue"
    }
    field continueLabel String "What it says after the confirm glyph when a key or a pad was used last (one hint for the device in hand, never both)." {
      default "Continue"
    }
    field newLabel String "The badge on a unit seen for the first time." {
      default "NEW"
    }
  }

  enum PullPhase {
    doc "Where a pull sequence is."
    variant idle "Nothing shown (token 0, or closed)."
    variant charge "The charge: a light gathering in the colour of the pull's highest tier."
    variant reveal "One result shown large, one after another."
    variant summary "Every result at once."
  }

  struct PullSequenceResult {
    doc "What the sequence did this tick."
    field phase PullPhase "Where it is."
    field index u32 "The result shown in reveal (0 first)."
    field revealed Option.String "A result revealed this tick (play its voice line, count it seen)."
    field again bool "Pull again was pressed in the summary."
    field done bool "Done was pressed (or Back in the summary): it closed; set token to 0."
  }

  fn pullSequence {
    doc "A gacha pull's reveal (Genshin Impact's wish, Honkai: Star Rail's warp, a card pack opening), over everything as a modal layer: first the charge, a light that gathers and tints toward the pull's highest tier (blue, purple, gold) so the tier is felt before it is shown; then each result large, its art, name, epithet, kind and stars landing one by one in its tier's colour, a burst for legendary and above, a New tag or what a duplicate became; then every result in a summary grid, the highest tiers first in reading order. A press, a tap or confirm goes on; Skip (and Back during the charge or reveal) goes to the summary; Done or Back there closes it. Under reduced motion every step appears at once."
    doc "Parts: Pull.layer, Pull.charge[rarity=<tier>], Pull.reveal[rarity=<tier>], Pull.art, Pull.name, Pull.kind, Pull.stars, Pull.star, Pull.new, Pull.extra, Pull.summary, Pull.tile[rarity=<tier>][new], Pull.skip, Pull.again[short], Pull.done, Pull.hint. Slots: each result's art (art kind character or item). States: on the layer, group phase (charge, reveal, summary); on each star, group lit (off, on). Motion: the charge grows and brightens on the emphasis spring; a revealed card enters scaled and turned, its stars land with a stagger; summary tiles deal in with a stagger. Sounds: open at the charge, reward on each reveal (success for legendary and above), select on each tile, close on Done. Accessibility: a dialog named for the pull; each result announced as it is revealed (a status: name, stars, new); the summary a list. Probe ids: <id>Layer/Panel/Stage (a press goes on), …/Stage/Content/Charge, …/Content/Reveal, …/Content/Summary/Grid/Tiles/<key> (the grid scrolls when it outgrows the screen), …/Summary/Bar/Again, …/Summary/Bar/Done, …/Stage/Bar/Skip."
    host false
    param id String "Its id."
    param desc PullSequenceDesc "The pull."
    returns PullSequenceResult
  }

  # ·· saga map: a scrolling path of levels ··

  struct SagaNode {
    doc "One level on a saga map, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable for the run: its element id, so its probe path is <id>/View/Path/<key>."
    field label String "What its badge reads (47); empty is its place counted from 1."
    field stars u32 "Stars earned on it, 0 to maxStars."
    field maxStars u32 "Stars it can give; 0 shows none (a boss gives none)." {
      default 3
    }
    field locked bool "Not reached yet: dimmed with a lock, and a press shakes and is refused."
    field boss bool "A boss level: a larger badge in the danger ink, its portrait inside."
    field image Option.Texture "A boss's portrait (art kind portrait); null draws a crown."
    field lane f32 "Where it sits across the path, -1 to 1 (the map's art decides); 0 lets the map wind it." {
      min -1
      max 1
    }
  }

  struct SagaMapDesc {
    doc "A saga map: its levels in order, where the player stands, and its art."
    desc true
    field nodes List.SagaNode "The levels, first to last."
    field current String "The level the player stands on: the avatar's pin over it, lit, the path lit up to it; the map opens centred on it."
    field avatar Option.Texture "The player's avatar in the pin (art kind avatar); null draws a figure."
    field backdrop Option.Texture "The map's painted art behind the path, across the whole scroll (art kind map); null draws a dusk gradient."
    field spacing f32 "Space between levels along the path; 0 is 150 (scaled with the screen)." {
      unit cssPx
      min 0
    }
    field label String "What a screen reader calls the map." {
      default "Levels"
    }
    field levelLabel String "A level's name to a screen reader ({label} is its badge)." {
      default "Level {label}"
    }
    field bossLabel String "A boss level's name to a screen reader ({label} is its badge)." {
      default "Boss, level {label}"
    }
    field starsLabel String "Its stars to a screen reader ({n} earned of {max})." {
      default "{n} of {max} stars"
    }
    field lockedLabel String "What a locked level adds." {
      default "Locked"
    }
    field currentLabel String "What the current level adds." {
      default "You are here"
    }
    field footInset f32 "Room at the map's foot that the game's own chrome takes (a Play button docked at the thumb): the view of the path stops above it, so no level sits under the button, while the map's art runs on behind it; 0 is none." {
      unit cssPx
    }
  }

  struct SagaMapResult {
    doc "What the map did this tick."
    field picked Option.String "A level pressed that is open: start it (or show its goals first)."
    field refused Option.String "A locked level pressed: it shook."
    field hovered Option.String "The level under the pointer or the focus."
  }

  fn sagaMap {
    doc "A saga map (Candy Crush Saga, Royal Match, Gardenscapes): the run's levels as badges along a painted path that scrolls, sideways on a desktop and a phone on its side (start to end, mirrored right to left) and upward on a phone in portrait (the first level at the foot). Each badge reads its number with its stars under it; the path is lit up to the level the player stands on, where the avatar's pin floats and a soft ring breathes; locked levels lie dim behind a lock; a boss stands larger in danger ink with its portrait. It opens centred on the current level (og.ui.scrollIntoView) and keeps it in view when current changes. A press on an open level picks it; on a locked one it shakes and is refused. Keys and pads walk the badges in path order."
    doc "Parts: Saga.map, Saga.path[lit], Saga.node[done|current|open|locked][boss][selected], Saga.badge, Saga.label, Saga.stars, Saga.lock, Saga.pin, Saga.avatar. Slots: the backdrop (art kind map), each boss's portrait (art kind portrait), the avatar (art kind avatar). States: on each node, group progress (done, current, open, locked). Motion: the pin bobs and the current ring breathes (still under reduced motion); hover lifts a badge on the ui spring; a refused press shakes it. Sounds: hover, confirm on a pick, error on a locked level. Accessibility: a list named by label; each level a button named by its level or boss label, its stars, locked and current, said disabled when locked. Probe ids: <id>/View/Path/<key>, <id>/View/Path/Pin."
    host false
    param id String "Its id."
    param desc SagaMapDesc "The levels, the current one and the art."
    returns SagaMapResult
  }

  # ·· puzzle goals: the star bar and goal chips ··

  struct StarBarDesc {
    doc "A level's score toward its stars."
    desc true
    field value f32 "The score."
    field max f32 "The score that fills the bar; 0 is the last threshold."
    field thresholds List.f32 "The scores for each star, low to high; empty is a third, two thirds and all of max."
    field label String "The caption over the score (Score); empty is none."
    field valueText String "The score as written (18,450); empty writes value grouped."
    field compact bool "One line: the score beside the bar (a phone's top strip)."
    field starsLabel String "Its stars to a screen reader ({n} earned of {max})." {
      default "{n} of {max} stars"
    }
  }

  struct StarBarResult {
    doc "What the bar showed this tick."
    field earned u32 "Stars earned at this score."
    field crossed u32 "Stars earned this tick (a threshold crossed): play the game's own fanfare if it has one."
  }

  fn starBar {
    doc "A level's score toward its stars (Candy Crush, Homescapes, Angry Birds): the score in the display face over a bar that fills in a warm gold, a star standing on the bar at each threshold, lit as the score passes it with a pop and the success sound, an outline until then. The bar runs start to end, mirrored right to left."
    doc "Parts: StarBar.frame[compact], StarBar.label, StarBar.value, StarBar.track, StarBar.fill, StarBar.star[lit]. States: on each star, group lit (off, on). Motion: the fill eases to the score on the ui spring; a star crossed pops on the emphasis spring (still under reduced motion). Sounds: success on each star crossed. Accessibility: a meter named by label with the score as its value and its stars as its description. Probe ids: <id>/Bar/Track, <id>/Bar/Stars/Star#i, <id>/Value."
    host false
    param id String "Its id."
    param desc StarBarDesc "The score and its thresholds."
    returns StarBarResult
  }

  struct LevelGoal {
    doc "One goal of a level (collect 20 blue gems, break 6 ice tiles)."
    desc true
    field key String "Its key: its element id, <id>/<key>."
    field label String "What to do (Collect Blue Gems)."
    field have u32 "How many are done."
    field need u32 "How many it takes."
    field image Option.Texture "Its piece's art (art kind item); null draws icon or a gem."
    field icon String "An icon of the style's set for it when it has no art."
  }

  struct GoalChipsDesc {
    doc "A level's goals."
    desc true
    field goals List.LevelGoal "The goals, in the order the level states them."
    field compact bool "Counts only, as a row of icons with a number each (a phone's top strip): the label goes to a screen reader."
    field label String "What a screen reader calls them." {
      default "Goals"
    }
    field progressLabel String "A goal's count to a screen reader ({have} of {need})." {
      default "{have} of {need}"
    }
    field doneLabel String "What a goal met adds." {
      default "Done"
    }
  }

  fn goalChips {
    doc "A level's goals as chips (Candy Crush's orders, Royal Match's targets): each its piece's art, what to do, have / need and a thin bar; one met turns to the success ink with a tick. A count that rises pops; a goal met plays success."
    doc "Parts: Goals.frame[compact], Goals.chip[done], Goals.art, Goals.label, Goals.count, Goals.track, Goals.fill, Goals.check. States: on each chip, group goal (open, done). Motion: a count that rises pops on the emphasis spring (still under reduced motion). Sounds: success when a goal is met. Accessibility: a list named by label; each goal a list item named by its label and count, done when met. Probe ids: <id>/<key>, <id>/<key>/Count."
    host false
    param id String "Its id."
    param desc GoalChipsDesc "The goals."
    returns Void
  }

  # ·· idle: a generator and the prestige ··

  struct IdleGeneratorDesc {
    doc "A generator of an idle game, as the game's viewmodel holds it. The game writes its numbers (og.ui.formatNumber, idle letters), so they read in its notation and language."
    desc true
    field name String "What it is (Solar Array)."
    field image Option.Texture "Its art (art kind item); null draws icon or a bolt."
    field icon String "An icon of the style's set for it when it has no art."
    field level u32 "Its level."
    field ownedText String "How many the player owns, as written (348); empty hides it."
    field rateText String "What it makes, as written (+1.24 M / sec); empty hides it."
    field cycle f32 "How far its current cycle is, 0 to 1." {
      min 0
      max 1
    }
    field cycleSeconds f32 "How long a cycle takes: under a quarter second the bar stays full and shimmers (too fast to read as a fill). 0 hides the bar." {
      unit s
      min 0
    }
    field costText String "What the next purchase costs, as written (12.4 M)."
    field currencyIcon Option.Texture "The currency's art beside the cost; null draws a coin."
    field affordable bool "The purse pays the purchase: the buy button lights."
    field buyLabel String "The buy button's label ({n} is buyCount)." {
      default "Buy ×{n}"
    }
    field buyCount u32 "How many a press buys (×1, ×10, the most the purse pays)." {
      default 1
    }
    field levelLabel String "The level badge ({level})." {
      default "Lv. {level}"
    }
    field ownedLabel String "The owned line ({owned} is ownedText)." {
      default "Owned: {owned}"
    }
    field locked bool "Not unlocked yet: dimmed with a lock and lockedHint in place of its numbers; it cannot be bought."
    field lockedHint String "What unlocks it (Reach 1 B energy)."
  }

  struct IdleGeneratorResult {
    doc "What the generator's row did this tick."
    field bought bool "Buy was pressed, or held long enough to repeat, and the purse pays: buy buyCount."
    field short bool "Buy was pressed without the purse to pay: say so (it shook)."
    field held bool "Buy is being held: it repeats every few ticks while the purse pays."
  }

  fn idleGenerator {
    doc "One generator of an idle game (AdVenture Capitalist, Cookie Clicker, Idle Miner): its art, name, level, owned count, the cycle's bar filling toward its next payout, what it makes, and a buy button with its cost, lit when the purse pays and glass when it does not. Held, Buy repeats (after a beat, every few ticks) as long as the purse pays. A locked generator lies dim with what unlocks it. One row; a game stacks them in a scrolling list with the buy amount chosen above (og.ui.segmented)."
    doc "Parts: Idle.generator[locked][affordable], Idle.art, Idle.name, Idle.level, Idle.owned, Idle.cycle[fast], Idle.cycleFill, Idle.rate, Idle.buy[affordable|short], Idle.cost, Idle.lock. Slots: its art (art kind item), the currency's icon. States: group purse (afford, short) on the buy button; group cycle (slow, fast) on the bar. Motion: a fast cycle's shimmer and a purchase's pop (still under reduced motion); the buy button lifts and sinks as a raised button. Sounds: the style's press on a purchase, error when short. Accessibility: a group named by name; the bar a meter; Buy a button named by its label, cost and short when the purse cannot pay. Probe ids: <id>, <id>/Info/Name, <id>/Info/Cycle, <id>/Buy."
    host false
    param id String "Its id."
    param desc IdleGeneratorDesc "The generator."
    returns IdleGeneratorResult
  }

  struct PrestigeDesc {
    doc "An idle game's prestige: what a reset gives and what it costs."
    desc true
    field title String "The panel's heading (Prestige)." {
      default "Prestige"
    }
    field lead String "The line over the reward (Ascend for)."
    field rewardText String "What a reset gives, as written (+128 Shards): the panel's display line."
    field points List.String "What a reset does, one line each with a tick (Resets generators, Permanent progression)."
    field image Option.Texture "Its emblem (art kind emblem); null draws a crown."
    field actionLabel String "The hold-to-confirm button's label (Ascend)." {
      default "Ascend"
    }
    field available bool "A reset gives something now: the button can be held."
    field lockedHint String "Why not yet, under the button while unavailable (Reach 1 Qa energy)."
    field holdMs f32 "How long the button is held to confirm: a reset is not taken by a slip." {
      unit ms
      default 1200
    }
  }

  struct PrestigeResult {
    doc "What the prestige panel did this tick."
    field confirmed bool "The hold completed: reset the run and grant the reward."
    field holding bool "The button is being held."
  }

  fn prestigePanel {
    doc "An idle game's prestige (AdVenture Capitalist's angels, Cookie Clicker's ascension): its emblem, the line over what a reset gives in the display face, what a reset does with a tick each, and a premium hold-to-confirm button (og.ui.holdButton), so a run is never reset by a slip. Until a reset gives something, the button lies flat with why."
    doc "Parts: Prestige.frame[available], Prestige.emblem, Prestige.title, Prestige.lead, Prestige.reward, Prestige.point, Prestige.action, Prestige.hint. Slots: the emblem (art kind emblem). States: group availability (ready, waiting) on the frame. Motion: the hold fills the button from its start edge; the emblem glows while ready (still under reduced motion). Sounds: the hold button's rising ticks and confirm. Accessibility: a region named by title; the reward and points as text; the button a button whose value is the hold's progress. Probe ids: <id>, <id>/Body/Reward, <id>/Action (og.ui.holdButton's, its own /Button within)."
    host false
    param id String "Its id."
    param desc PrestigeDesc "What a reset gives."
    returns PrestigeResult
  }

  struct WalletEntry {
    doc "One currency in a store's or a pass's purse."
    desc true
    field key String "Its key: its element id, so its probe path is <id>/Wallet/<key>."
    field name String "Its name: what a screen reader says, and the style's icon of that name (gem, coin) when it has no art."
    field amount f64 "How much the player has."
    field image Option.Texture "Its art (art kind currency); null draws the style's icon of its name, else a coin or a gem drawn as shapes."
    field topUp bool "It can be bought: a plus after it, answered as topUp."
  }

  struct StoreOffer {
    doc "One offer of a store, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable while it is offered: its element id, so its probe path is <id>/Sections/<section>/Offers/<key>."
    field name String "What it is called."
    field kind String "A line under its name (Outfit, Bundle · 5 items)."
    field image Option.Texture "Its art covering the tile (art kind item, splash for a featured bundle); null draws the style's placeholder."
    field focal Option.Vector2 "The art's point kept in view, fractions from the top start; null is its centre a little above the middle."
    field rarity Rarity "Its tier: the tile's rim, a wash of its colour and its name's ink."
    field price f64 "Its price in currency; 0 with the store's freeLabel is free."
    field currency String "The purse's key it is priced in; empty with priceText is real money."
    field priceText String "The price as written for real money ($4.99, from the platform's store); empty writes price with the currency's icon."
    field original f64 "The price before a discount: struck through beside it, the saving on a ribbon."
    field contents List.String "What a bundle holds, a line each, listed on a featured tile."
    field badge String "A corner tag (New, Hot, Limited); empty is none."
    field badgeKind RewardTagKind "The tag's ink."
    field limit u32 "How many times it can be bought; 0 is no limit. A limit shows what is left, and none left is sold out."
    field bought u32 "How many times the player has bought it."
    field owned bool "Owned already (a cosmetic): a tick and the ownedLabel instead of the price; a press answers viewed."
    field affordable bool "The purse pays it: false draws the price in the danger ink, said short, and a press shakes and is refused." {
      default true
    }
    field featured bool "A featured tile: twice as wide and taller, its contents listed (a full row on a phone)."
    field endsIn Option.f32 "Seconds until it leaves the store: a timer chip on the tile, urgent in its last hour." {
      unit s
    }
  }

  struct StoreSection {
    doc "A section of a store (Featured, Daily, Bundles), its offers in order."
    desc true
    field key String "Its key: its element id, <id>/Sections/<key>."
    field title String "Its heading."
    field endsIn Option.f32 "Seconds until it refreshes (a daily rotation): a timer beside the heading." {
      unit s
    }
    field offers List.StoreOffer "Its offers, in the order shown."
  }

  struct StoreFrontDesc {
    doc "A store front: the purse, then sections of offers on rotation."
    desc true
    field title String "The store's title over the purse; empty shows none (the screen has its own header)."
    field sections List.StoreSection "The sections, top to bottom."
    field wallet List.WalletEntry "The purse at the head of the store, in order; empty shows none."
    field selected String "The offer the game has open (its detail or confirm): drawn selected."
    field columns u32 "Tiles a row on a desktop; 0 fits as many 220 px tiles as the width takes (two on a phone)."
    field label String "What a screen reader calls the store." {
      default "Store"
    }
    field freeLabel String "A free offer's price." {
      default "Free"
    }
    field ownedLabel String "An owned offer's line in place of its price." {
      default "Owned"
    }
    field soldOutLabel String "An offer bought up to its limit." {
      default "Sold out"
    }
    field leftLabel String "What a limited offer has left ({left} of {limit})." {
      default "{left} left"
    }
    field saveLabel String "A discount's ribbon ({pct} is the saving in whole percent)." {
      default "−{pct} %"
    }
    field refreshLabel String "Beside a section's timer." {
      default "Refreshes in"
    }
    field shortLabel String "Said with a price the purse cannot pay." {
      default "not enough"
    }
    field topUpLabel String "A currency's plus to a screen reader ({name})." {
      default "Get more {name}"
    }
    field daysLabel String "A time left of a day or more ({d} days, {h} hours)." {
      default "{d}d {h}h"
    }
    field hoursLabel String "A time left of an hour or more ({h} hours, {m} minutes)." {
      default "{h}h {m}m"
    }
  }

  struct StoreFrontResult {
    doc "What the store did this tick."
    field chosen Option.String "An offer pressed that can be bought: open its detail or a confirm (og.ui.confirm), then charge it and pass bought or owned back."
    field viewed Option.String "An owned offer pressed: show it (a preview, a fitting room)."
    field refused Option.String "An offer pressed that cannot be bought (short or sold out): it shook and said why."
    field topUp Option.String "A currency's plus pressed: open the currency's own offers."
    field hovered Option.String "The offer under the pointer or the focus."
  }

  fn storeFront {
    doc "A store (Fortnite's item shop, Genshin's, Clash Royale's): the purse at its head with a plus to top up, then each section under its heading with its refresh timer, its offers as tiles of art in their tier's rim. A tile's name sits on its art over a shade, its price at its foot (a struck original and a saving ribbon when discounted, the danger ink when short); a featured tile is twice as wide and lists its bundle; an owned one shows a tick, a sold-out one is dimmed. Pressing one that can be bought answers chosen; one that cannot shakes and says why."
    doc "Parts: Store.frame, Store.wallet, Store.currency, Store.topUp, Store.section, Store.heading, Store.refresh, Store.offer[rarity=<tier>][featured][owned][soldOut][short][selected], Store.art, Store.name, Store.kind, Store.contents, Store.price, Store.ribbon, Store.tag, Store.left, Store.timer. Slots: each offer's art (art kind item, or splash when featured), each currency's (art kind currency). States: on each offer, group availability (available, short, owned, soldOut) and group selection (off, on). Motion: a hovered tile lifts on the ui spring and its art eases in; a refused press shakes it. Sounds: hover, select on chosen, error on refused. Accessibility: a region named label; each section a list named by its title; each offer a button named by its name, kind, tier and price or state, its contents as its description. Probe ids: <id>/Wallet/<key>, <id>/Wallet/<key>/TopUp, <id>/Sections/<section>/Offers/<key>."
    host false
    param id String "Its id."
    param desc StoreFrontDesc "The purse and the offers."
    returns StoreFrontResult
  }

  struct PassReward {
    doc "One reward on a battle pass's track."
    desc true
    field key String "Its key: its element id within its tier."
    field name String "What it is (Neon Outfit, 500 Coins)."
    field amountText String "A count on its corner (×500); empty is none."
    field image Option.Texture "Its art (art kind item); null draws the style's placeholder."
    field rarity Rarity "Its tier: the cell's rim and wash."
  }

  struct PassTier {
    doc "One level of a battle pass: its free and premium rewards and what the player has claimed."
    desc true
    field level u32 "Its level."
    field free Option.PassReward "The free track's reward; null is none at this level."
    field premium Option.PassReward "The premium track's reward; null is none."
    field freeClaimed bool "The free reward is claimed."
    field premiumClaimed bool "The premium reward is claimed."
    field milestone bool "A milestone level (every tenth, the season's outfit): its cells larger, its level badge in gold."
  }

  struct PassClaim {
    doc "A reward claimed on a battle pass."
    field level u32 "The tier's level."
    field premium bool "From the premium track."
  }

  struct BattlePassDesc {
    doc "A battle pass: the season, the player's level and XP, the premium track's ownership and the tiers."
    desc true
    field title String "The season's name (Season 4 · Neon Tide)."
    field image Option.Texture "The season's key art behind the header (art kind banner); null draws a gradient of the style's hues."
    field endsIn Option.f32 "Seconds until the season ends: a timer chip in the header." {
      unit s
    }
    field level u32 "The player's level: tiers up to it can be claimed."
    field xp f32 "XP toward the next level."
    field xpNext f32 "XP the next level takes."
    field premium bool "The premium track is owned: its rewards can be claimed; until then they are locked."
    field tiers List.PassTier "The tiers, first to last."
    field unlockPriceText String "The premium track's price on the unlock button ($9.99, or 950 with its currency); empty shows only the label."
    field label String "What a screen reader calls the pass." {
      default "Battle pass"
    }
    field freeLabel String "The free track's name." {
      default "Free"
    }
    field premiumLabel String "The premium track's name." {
      default "Premium"
    }
    field levelLabel String "The player's level ({n})." {
      default "Level {n}"
    }
    field xpLabel String "The XP toward the next level ({xp} and {need})." {
      default "{xp} / {need} XP"
    }
    field claimLabel String "A claimable reward's word." {
      default "Claim"
    }
    field claimAllLabel String "The button claiming every reward ready ({n} of them)." {
      default "Claim all ({n})"
    }
    field claimedLabel String "What a claimed reward adds." {
      default "Claimed"
    }
    field unlockLabel String "The button unlocking the premium track." {
      default "Unlock Premium"
    }
    field lockedLabel String "What a premium reward adds while the track is locked." {
      default "Premium"
    }
    field reachLabel String "What a reward past the player's level adds ({n})." {
      default "Reach level {n}"
    }
    field daysLabel String "A time left of a day or more ({d} days, {h} hours)." {
      default "{d}d {h}h"
    }
    field hoursLabel String "A time left of an hour or more ({h} hours, {m} minutes)." {
      default "{h}h {m}m"
    }
  }

  struct BattlePassResult {
    doc "What the pass did this tick."
    field claimed List.PassClaim "Rewards claimed this tick (one pressed, or every one ready with Claim all): grant them and mark them claimed."
    field unlock bool "Unlock Premium pressed: open its purchase."
    field refused Option.PassClaim "A reward pressed that cannot be claimed yet (past the level, or premium while locked): it shook and said why."
    field hovered Option.u32 "The level of the tier under the pointer or the focus."
  }

  fn battlePass {
    doc "A battle pass (Fortnite, Apex Legends, Brawl Stars): a header over the season's art with its name, the time left, the level in a badge and the XP bar, then the track: the tiers side by side in a scrolling row on a desktop (the free track under the level line, the premium one over it) and stacked in portrait. Tiers reached are lit up to the player's level; a reward ready to claim glows and pulses with Claim, a claimed one shows a tick and dims, a premium one without the track wears a lock. The track opens on the player's level; Claim all and Unlock Premium stand at its head."
    doc "Parts: Pass.frame, Pass.header, Pass.title, Pass.level, Pass.xpTrack, Pass.xpFill, Pass.timer, Pass.track, Pass.tier[reached][current][milestone], Pass.levelBadge, Pass.line[lit], Pass.reward[premium][ready][claimed][locked][rarity=<tier>], Pass.art, Pass.amount, Pass.lock, Pass.check, Pass.claimAll, Pass.unlock. Slots: the season's art (art kind banner); each reward's (art kind item). States: on each reward, group claim (ahead, ready, claimed, locked); on each tier, group progress (ahead, reached, current). Motion: a ready reward breathes (still under reduced motion); a claim pops it on the emphasis spring; the XP bar eases on the ui spring; the track scrolls to the player's level when it opens. Sounds: select on a claim, success on Claim all, error on a refusal. Accessibility: a region named label; the XP bar a meter; the track a list of tiers named by level, each reward a button named by its name, track and claim state. Probe ids: <id>/Header/Level, <id>/Header/Xp, <id>/Actions/ClaimAll, <id>/Actions/Unlock, <id>/Track/Tiers/L<level>/Free, <id>/Track/Tiers/L<level>/Premium."
    host false
    param id String "Its id."
    param desc BattlePassDesc "The season and the tiers."
    returns BattlePassResult
  }

  # ·· story: the conversation, its backlog, barks, the quest log and tracker ··

  enum ConversationLayout {
    doc "How a conversation stands on the screen."
    variant cinematic "The speaker's portrait large at its side (SpeakerView.side), the line as a caption over a shade at the foot, the choices stacked on the other side: a CRPG's or an action game's conversation (Mass Effect, Baldur's Gate 3, Cyberpunk 2077)."
    variant box "A visual novel's text box across the foot, the speaker's name on a plate over its top edge and the portrait standing behind it; the choices centred over the scene (Ace Attorney, Persona, Fate)."
  }

  struct ConversationDesc {
    doc "A conversation on screen, as og.story.view answers it."
    desc true
    field view Option.DialogueView "What og.story.view answers this tick; null shows nothing (no conversation runs)."
    field portrait Option.Texture "The speaker's portrait (art kind portrait): the texture the game loaded for view.speaker.portrait and its expression (og.load.texture). Null draws the style's placeholder figure for a speaker with a portrait path, and no portrait for the narrator or a speaker without one."
    field layout ConversationLayout "How it stands."
    field charsPerSecond f32 "How fast the line types out; 0 shows it whole at once (also under reduced motion)." {
      default 45
      min 0
    }
    field auto bool "Auto: a whole line advances by itself once its voice has ended (DialogueView.voiceLeft) and autoDelayMs has passed; choices always wait."
    field autoDelayMs f32 "The pause after a whole line before auto advances; 0 is 900 plus 30 per character." {
      min 0
      unit ms
    }
    field statNames Json "A check's stat in words, by its variable ({ \"charm\": \"Persuasion\" }); a stat it lacks is written as its variable name."
    field skipLabel String "Skip (the back action); empty hides it." {
      default "Skip"
    }
    field logLabel String "Log (the details action); empty hides it." {
      default "Log"
    }
    field autoLabel String "Auto; empty hides it." {
      default "Auto"
    }
    field continueLabel String "What a press does on a whole line, said to a screen reader and beside the confirm glyph." {
      default "Continue"
    }
    field unavailableLabel String "A disabled choice's reason when the dialogue gives none." {
      default "Unavailable"
    }
    field checkLabel String "An active check's tag before its choice ({stat}, {chance} as a percent)." {
      default "{stat} · {chance}"
    }
    field passedLabel String "An active check passed." {
      default "Success"
    }
    field failedLabel String "An active check missed." {
      default "Failure"
    }
  }

  struct ConversationResult {
    doc "What the conversation's player did this tick: the game passes it on to og.story."
    field advanced bool "Go on: og.story.advance (a press or confirm on a whole line with no choices, or auto)."
    field chosen Option.u32 "A choice taken: og.story.choose with this ChoiceView.index."
    field skipped bool "Skip (or back) was pressed."
    field log bool "Log was pressed: show the backlog (og.ui.backlog)."
    field autoToggled bool "Auto was pressed: flip ConversationDesc.auto."
    field revealed bool "The whole line shows."
    field hovered Option.u32 "The ChoiceView.index under the pointer or the focus."
  }

  fn conversation {
    doc "A conversation to the bar of Mass Effect, Baldur's Gate 3, Disco Elysium and Persona, fed by og.story.view: the speaker's name in the display face over the line, which types out by the tick (a press shows it whole, the next goes on; skip-read lines, DialogueView.seen, show whole), a chevron bobbing when it waits, a voice cue (three bars) while its voice plays, and auto that holds until the voice ends. Choices stand in a stack, numbered for the keys: an active check leads with its stat and chance in a tag tinted by the odds, a passive one that passed with its stat, a disabled one muted behind a lock with its reason, a visited one in muted ink. A timed choice runs a bar under them that warms as it runs out, the default choice marked. A roll (DialogueView.lastCheck) pops a d20 with its number and Success or Failure. Skip, Log and Auto stand at the top end with the device's glyphs."
    doc "Parts: Conversation.frame[cinematic|box], Conversation.box, Conversation.name, Conversation.line[typing|shown], Conversation.more, Conversation.voice, Conversation.choices, Conversation.choice[enabled|disabled][visited][default][check], Conversation.number, Conversation.tag[passive|active], Conversation.reason, Conversation.timer[low], Conversation.roll[passed|failed], Conversation.die, Conversation.tools, Conversation.tool[on]. Slots: the portrait (art kind portrait). States: on the line, group reveal (typing, shown); on each choice, group choice (open, visited, disabled); on the roll, group roll (passed, failed). Motion: the line types by the tick; choices rise in one after another on the panel spring; the chevron bobs and the voice bars move (still under reduced motion); a roll pops on the emphasis spring; the timer pulses under its last fifth. Sounds: counterTick as the line types, select on a choice, confirm on going on, success or error on a roll. Accessibility: a region named by the speaker whose line is a live status (read whole, not letter by letter); the choices a list of buttons named by number, text, check and reason, said disabled when they are; the timer a timer. Probe ids: <id>/Line, <id>/Name, <id>/Choices/List/<choice id>, <id>/Timer, <id>/Roll, <id>/Tools/Skip, <id>/Tools/Log, <id>/Tools/Auto."
    host false
    param id String "Its id."
    param desc ConversationDesc "The view and the words."
    returns ConversationResult
  }

  struct BacklogDesc {
    doc "A conversation's backlog, as og.story.history answers it."
    desc true
    field lines List.StoryLine "The lines, oldest first (og.story.history)."
    field title String "Its title." {
      default "Log"
    }
    field closeLabel String "Close (and the back action)." {
      default "Close"
    }
    field replayLabel String "A voiced line's replay button, said to a screen reader." {
      default "Play voice"
    }
    field emptyLabel String "With no lines yet." {
      default "Nothing has been said yet."
    }
  }

  struct BacklogResult {
    doc "What the backlog's player did this tick."
    field closed bool "Close or back was pressed: hide it."
    field replay Option.u32 "A line's voice to play again: its StoryLine.seq (its voice is StoryLine.voice)."
  }

  fn backlog {
    doc "A visual novel's backlog (Ren'Py, Persona, Ace Attorney): a panel over the dimmed scene that opens on the newest line and scrolls back, each line under its speaker's name, the narrator's in muted italics, the choice the player made on a line under it as their reply, a voiced line with a button that plays it again; Close (and back) hides it."
    doc "Parts: Backlog.frame, Backlog.title, Backlog.list, Backlog.entry[narrator][seen], Backlog.name, Backlog.text, Backlog.reply, Backlog.replay, Backlog.close. States: on each entry, group voice (silent, voiced). Motion: it rises in on the panel spring; the list opens at its foot. Sounds: open, back on close, select on a replay. Accessibility: a dialog named by title; the list a log of its lines, each named speaker: text; each replay a button. Probe ids: <id>/List/L<seq>, <id>/List/L<seq>/Replay, <id>/Close."
    host false
    param id String "Its id."
    param desc BacklogDesc "The lines and the words."
    returns BacklogResult
  }

  struct BarksDesc {
    doc "The barks being said, as og.story.barks answers them."
    desc true
    field barks List.BarkView "The barks (og.story.barks), each drawn over its entity."
    field height f32 "World units over each speaker's point." {
      default 2.2
      unit m
    }
    field shoutPriority i32 "A bark of this priority or higher is a shout (bold, a jagged edge)." {
      default 5
    }
    field clamp bool "A speaker off screen keeps its bubble on the edge."
    field maxWidth f32 "A bubble's widest; 0 is 260." {
      min 0
      unit cssPx
    }
  }

  fn barks {
    doc "Barks over their speakers (The Last of Us, Hitman, Sea of Thieves): one og.ui.speechBubble for each bark og.story is saying, typed out from the tick it began and leaving as og.story's time for it (BarkView.ticksLeft) runs out; a new line on the same entity replaces the old at once; a shout from shoutPriority up."
    doc "Parts: those of og.ui.speechBubble. Accessibility: each bubble text named its speaker. Probe ids: <id>/E<entity> (the speech bubble's own ids under it)."
    host false
    param id String "Its id."
    param desc BarksDesc "The barks."
    returns Void
  }

  struct QuestTab {
    doc "One tab of the quest log: a category of QuestView.category."
    desc true
    field key String "Its category (main, side, daily)."
    field label String "Its words."
  }

  struct QuestArt {
    doc "A texture for an asset path a quest names (a reward's image), loaded by the game (og.load.texture)."
    desc true
    field path String "The path, as QuestView names it."
    field texture Texture "Its texture."
  }

  struct QuestLogDesc {
    doc "The quest log, as og.story.quests answers it."
    desc true
    field quests List.QuestView "The quests, in og.story.quests' order (their start)."
    field selected String "The quest shown in the detail (game state); empty or unknown shows the tracked one, else the first."
    field tabs List.QuestTab "The tabs, in order; empty is one list of every quest."
    field tab String "The tab shown (game state); empty is the first."
    field art List.QuestArt "Textures for the reward images the quests name; one it lacks draws the style's placeholder."
    field title String "Its title." {
      default "Quests"
    }
    field trackLabel String "Track." {
      default "Track"
    }
    field trackedLabel String "A tracked quest's toggle." {
      default "Tracked"
    }
    field mapLabel String "Show on map (a quest with a marker); empty hides it." {
      default "Show on map"
    }
    field objectivesLabel String "The objectives' heading." {
      default "Objectives"
    }
    field rewardsLabel String "The rewards' heading." {
      default "Rewards"
    }
    field optionalLabel String "An optional objective's tag." {
      default "Optional"
    }
    field hiddenLabel String "An objective not yet revealed." {
      default "???"
    }
    field giverLabel String "Who gave it ({giver})." {
      default "From {giver}"
    }
    field newLabel String "A quest not looked at yet." {
      default "New"
    }
    field activeLabel String "The active quests' heading." {
      default "Active"
    }
    field completedLabel String "The completed quests' heading and a completed quest's stamp." {
      default "Completed"
    }
    field failedLabel String "A failed quest's stamp." {
      default "Failed"
    }
    field emptyLabel String "With no quests in the tab." {
      default "No quests yet."
    }
    field backLabel String "On a phone, back from a quest to the list." {
      default "Back"
    }
  }

  struct QuestLogResult {
    doc "What the quest log's player did this tick."
    field selected Option.String "A quest picked: show it (game state), and og.story.markSeen it."
    field track Option.String "Track pressed: og.story.track it, flipping QuestView.tracked."
    field showOnMap Option.String "Show on map pressed: open the map on its marker."
    field tab Option.String "A tab picked: show it (game state)."
    field closed bool "Back was pressed at the list."
  }

  fn questLog {
    doc "A quest log to the bar of The Witcher 3, Genshin Impact and Destiny 2: tabs by category over a list of quests (the active ones, then the completed and failed under their heading, muted), each with its category's mark, its region, a New dot until it is looked at and an updated dot when it changed, the tracked one pinned; beside it (stacked on a phone, the list then the quest) the quest itself: its title in the display face, the giver and region, the summary, the stage's objectives as boxes with their counts and bars (optional ones tagged, hidden ones ???, failed ones crossed in danger), the rewards as tiles with their art and amounts, and Track and Show on map. A completed quest wears a stamp."
    doc "Parts: QuestLog.frame, QuestLog.tabs, QuestLog.list, QuestLog.group, QuestLog.row[selected][tracked][new][updated][completed|failed], QuestLog.mark, QuestLog.dot, QuestLog.detail, QuestLog.title, QuestLog.meta, QuestLog.summary, QuestLog.objective[done|failed|optional|hidden], QuestLog.check, QuestLog.count, QuestLog.bar, QuestLog.reward (the tile), QuestLog.caption (its name and pips, in their own row under the tile), QuestLog.stamp[completed|failed], QuestLog.track[on], QuestLog.map, QuestLog.back (a phone in portrait: the style's secondary button with a chevron to the start edge). Slots: each reward's art (art kind item). States: on each row, group status (active, completed, failed); on each objective, group step (open, done, failed). Motion: the detail slides in on a change of quest on the panel spring; a done objective's box ticks with a pop; the New dot breathes (still under reduced motion). Sounds: select on a row, confirm on Track, back on Back. Accessibility: tabs a tablist; the list a listbox of quests named title, category, status, new or updated and tracked; the detail a region named its title; each objective a checkbox named its text and count; Track a toggle. Probe ids: <id>/Tabs/<tab>, <id>/List/<quest id>, <id>/Detail/Title, <id>/Detail/Objectives/<objective id>, <id>/Detail/Rewards/R<i>, <id>/Detail/Actions/Track, <id>/Detail/Actions/Map."
    host false
    param id String "Its id."
    param desc QuestLogDesc "The quests and the words."
    returns QuestLogResult
  }

  struct QuestTrackerDesc {
    doc "The HUD's quest tracker, fed by og.story.quests."
    desc true
    field quests List.QuestView "The quests (og.story.quests): the tracked active ones show, and a tracked one that completes flashes Complete and leaves."
    field from Option.Vector3 "Where the player stands: each quest's distance to its marker. Null shows none."
    field max u32 "The most shown; 0 is og.ui.objectiveTracker's."
    field width f32 "Its width; 0 is og.ui.objectiveTracker's." {
      min 0
      unit cssPx
    }
    field completeLabel String "The completed word." {
      default "Complete"
    }
    field anchor Option.Anchor "Opens its own anchored group there; null builds it in place." {
      default right
    }
  }

  fn questTracker {
    doc "The tracked quests on the HUD: og.ui.objectiveTracker fed by og.story's quests (each tracked active quest's title, its stage's objectives that are revealed, their counts and bars, optional and failed ones as the tracker draws them, the distance to its marker), and a tracked quest that completes flashing Complete before it leaves."
    doc "Parts: those of og.ui.objectiveTracker. Accessibility: as og.ui.objectiveTracker's. Probe ids: <id>/<quest id>, <id>/<quest id>/<objective id>."
    host false
    param id String "Its id."
    param desc QuestTrackerDesc "The quests."
    returns Void
  }

  # ·· lobby: the party, matchmaking and the ready check ··

  struct LobbyMember {
    doc "One player in the party, as the game's viewmodel holds it."
    desc true
    field key String "Its key, stable while it is in the party: its element id, so its probe path is <id>/Lineup/<key>."
    field name String "The player's name: the card's reading, set in the display face."
    field level u32 "The player's level; 0 shows none."
    field title String "A line under the name: a rank, a class, a club (empty: none)."
    field portrait Option.Texture "Its character or avatar (art kind character), filling the card; null draws the style's placeholder figure."
    field ready bool "Ready: the card's foot lit in success with a tick and the ready word."
    field leader bool "The party's leader: a crown at the card's top start."
    field you bool "The local player: its card stands larger and first, its foot reads the ready toggle's state."
    field status String "A line in place of the ready word (In a match, Away); empty is ready or not ready."
    field accepted bool "In a ready check: has accepted."
    field declined bool "In a ready check: has declined."
  }

  struct LobbyMode {
    doc "The mode the party queues for."
    desc true
    field name String "Its name (Ranked, Duos, Grand Prix)."
    field detail String "A line under it (5v5 · Summoner's Rift; 4 players)."
    field image Option.Texture "Its art (art kind thumbnail), 16:9; null draws the style's placeholder."
  }

  struct ReadyCheckView {
    doc "A match found, waiting for every player to accept."
    desc true
    field secondsLeft f32 "Seconds left to accept." {
      unit s
      min 0
    }
    field seconds f32 "The whole time to accept, for the ring; 0 is 10." {
      unit s
      min 0
    }
  }

  struct LobbyDesc {
    doc "A party lobby: who is in it, the mode, matchmaking and the ready check."
    desc true
    field title String "The screen's title (Play, Party, Lobby)."
    field members List.LobbyMember "The party, the local player among them, in the game's order (the local player's card is drawn first)."
    field slots u32 "The party's size: the places past the members are empty seats, each an Invite; 0 is the members' count."
    field mode LobbyMode "The mode the party queues for: a card at the foot's start, pressed to change it (LobbyResult.mode)."
    field searching bool "Matchmaking: the foot's action becomes Cancel and a chip counts the time in queue."
    field searchSeconds f32 "Seconds in queue." {
      unit s
      min 0
    }
    field estimateSeconds f32 "The estimated wait, said beside the count; 0 says none." {
      unit s
      min 0
    }
    field canStart bool "The local player may start matchmaking (the leader, with the party ready): the foot's action is Find match; else it is the ready toggle."
    field readyCheck Option.ReadyCheckView "A match found: the ready check stands over the lobby until the game clears it."
    field readyLabel String "The ready word on a card, and the toggle once ready." {
      default "Ready"
    }
    field notReadyLabel String "The word on a card not ready." {
      default "Not ready"
    }
    field readyUpLabel String "The toggle while not ready." {
      default "Ready up"
    }
    field startLabel String "The leader's action." {
      default "Find match"
    }
    field cancelLabel String "The action while searching." {
      default "Cancel"
    }
    field searchingLabel String "The chip's word while searching." {
      default "Searching"
    }
    field estimateLabel String "The estimate beside the count ({time})." {
      default "Est. {time}"
    }
    field inviteLabel String "An empty seat's word." {
      default "Invite"
    }
    field levelLabel String "A level ({level})." {
      default "Lv {level}"
    }
    field leaderLabel String "The leader, to a screen reader." {
      default "Party leader"
    }
    field matchFoundLabel String "The ready check's title." {
      default "Match found"
    }
    field acceptLabel String "The ready check's accept." {
      default "Accept"
    }
    field acceptedLabel String "Accept once pressed." {
      default "Accepted"
    }
    field declineLabel String "The ready check's decline." {
      default "Decline"
    }
    field modeLabel String "The mode card's eyebrow." {
      default "Mode"
    }
  }

  struct LobbyResult {
    doc "What the lobby was asked this tick, for the game to do."
    field ready bool "The ready toggle was pressed: flip the local player's ready."
    field start bool "Find match was pressed."
    field cancel bool "Cancel was pressed while searching."
    field invite Option.u32 "An empty seat was pressed: its place, from 0 at the first empty seat."
    field member Option.String "A member's card was pressed: the game's menu for it (profile, promote, kick)."
    field mode bool "The mode card was pressed: open the mode select."
    field accept bool "The ready check was accepted (its button, or confirm)."
    field decline bool "The ready check was declined (its button, or Back)."
  }

  fn lobby {
    doc "A party lobby (Valorant, Fortnite, Rocket League, Overwatch): the party stands as a lineup of tall cards, each the player's character art with a scrim at its foot carrying the name in the display face, the level and a title, and a ready foot lit in success with a tick (not ready muted; a status line in its place); the local player's card first and larger, the leader's crown at its corner, each empty seat an Invite. At the foot, the mode card (its art, name and detail) at the start and one primary action at the end: Ready up and Ready for a member, Find match for the leader, Cancel while searching with a chip counting the time in queue and the estimate. A ready check rises over everything on a scrim: Match found in the display face, a ring that runs out with the seconds left, a pip per player lit as each accepts (danger for a decline), and Accept large in the accent beside Decline. On a phone in portrait the lineup is two columns of shorter cards and the foot docks at the thumb."
    doc "Parts: Lobby.frame, Lobby.lineup, Lobby.member[you][leader][ready], Lobby.art, Lobby.plate, Lobby.foot[ready], Lobby.crown, Lobby.seat, Lobby.bar, Lobby.mode, Lobby.action, Lobby.search, Lobby.check, Lobby.pip[accepted|declined], Lobby.accept, Lobby.decline. Slots: each member's portrait (art kind character), the mode's image (art kind thumbnail). States: on each member, group ready (waiting, ready); on the check's pips, group answer (pending, accepted, declined). Motion: the cards rise in one after another on the panel spring; a card turning ready pops its foot; the search chip's dot breathes; the check scales in on the emphasis spring and its ring runs down (still under reduced motion). Sounds: select on a card or seat, confirm on ready, start and accept, back on cancel and decline, open when the check rises, success when every player has accepted. Accessibility: the lineup a list; each card a button named its name, level, title, leader and ready word; each seat a button named the invite word; the check a dialog named the found word with the time left as a timer. Probe ids: <id>/Lineup/<key>, <id>/Lineup/Seat#<i>, <id>/Bar/Mode, <id>/Bar/Action, <id>/Bar/Search, <id>/Check/Accept, <id>/Check/Decline."
    host false
    param id String "Its id."
    param desc LobbyDesc "The party, the mode, matchmaking and the ready check."
    returns LobbyResult
  }

  # ── end of the genre patterns ────────────────────────────────────────

  # ── the UI kit: screen templates (TypeScript over the calls above) ──────

  callback UiAction {
    doc "A template's action, by its id (a menu item, `buy:<item>`, `share`)."
    param action String "The action's id."
  }

  callback SettingsChanged {
    doc "The settings after a change: persist them (cloud save, local storage through the shell) and apply them."
    param settings GameSettings "The new settings."
  }

  struct MenuItem {
    doc "An item of a menu: an id the game acts on and the label a player reads."
    desc true
    field id String "The id answered when it is chosen; also its probe id."
    field label String "What it says."
    field disabled bool "Shown but inert."
    field primary bool "The primary action (one per screen)."
  }

  struct MenuResult {
    doc "What a menu-like template answered this tick."
    field selected Option.String "The id of the item chosen this tick."
  }

  struct MainMenuDesc {
    doc "A title screen: the title, a subtitle, a column of items (the first primary unless one says so) and a footer. Centred on desktop and tablet, bottom-weighted on a phone."
    desc true
    field title String "The game's title, in display type."
    field subtitle String "A line under it; empty is none."
    field items List.MenuItem "The items, such as Play, Continue, Settings, Quit."
    field footer String "A line at the bottom (a version, credits); empty is none."
    field onSelect Option.UiAction "Called with the chosen item's id."
    field instant bool "Shown settled the first time it is built (AnchorDesc.instant): pass it while the title is the screen the game opens on, so the frame behind the web's play gate is the whole title; a title the player comes back to enters with the style."
    field align Align "Where the card stands on desktop and tablet: center (the default) or start, at the start edge so the key art behind it keeps the rest of the screen (end mirrors it). A phone keeps it at the bottom." {
      default center
    }
  }

  struct PauseMenuDesc {
    doc "A pause screen: a dialog over the frozen game with Resume first. Back resumes."
    desc true
    field open bool "Whether the game is paused."
    field title String "Its title." {
      default "Paused"
    }
    field items List.MenuItem "The items; empty is Resume, Settings, Quit to menu (`resume`, `settings`, `quit`)."
    field onSelect Option.UiAction "Called with the chosen item's id; Back answers `resume`."
  }

  struct KeyBinding {
    doc "A control the settings screen lists: an action and the key bound to it."
    desc true
    field action String "The action's id."
    field label String "What a player reads."
    field key String "The bound key, as shown (`Space`, `A`, `←`)."
  }

  struct LanguageOption {
    doc "A language the settings screen offers, in its own name."
    desc true
    field code String "Its code (`en`, `zh-CN`)."
    field label String "Its name in itself (`English`, `简体中文`)."
  }

  struct GameSettings {
    doc "The settings most games share. The game keeps them (a resource, a save) and passes them in every tick."
    desc true
    field masterVolume f32 "The master volume." {
      default 1
      min 0
      max 1
      unit ratio
    }
    field musicVolume f32 "The music bus." {
      default 0.8
      min 0
      max 1
      unit ratio
    }
    field sfxVolume f32 "The effects bus." {
      default 1
      min 0
      max 1
      unit ratio
    }
    field muted bool "Everything silent."
    field quality GraphicsQuality "The graphics preset."
    field showFps bool "Show the frame rate."
    field reducedMotion bool "Keep state changes, drop movement (the UI's transitions only fade)."
    field highContrast bool "The high-contrast theme."
    field textScale f32 "The text size, 1 to 2: UiDesc.textScale (the settings screen configures it in SettingsDesc.world; without one the game passes it to og.ui.configure in onChange)." {
      default 1
      min 1
      max 2
      unit ratio
    }
    field vibration bool "Vibrate on hits (where the device can)." {
      default true
    }
    field invertY bool "Invert the vertical look axis."
    field sensitivity f32 "Look sensitivity." {
      default 1
      min 0.1
      max 3
    }
    field rawMouse bool "Raw mouse input while the pointer is locked (og.input.setMouse: no OS acceleration where the browser grants unadjustedMovement)." {
      default true
    }
    field uiVolume f32 "The interface bus (the UI's own sounds)." {
      default 1
      min 0
      max 1
      unit ratio
    }
    field subtitles bool "Subtitles for speech (XAG 104)." {
      default true
    }
    field display Option.DisplaySettings "The player's graphics settings (og.render.display(world).settings, kept here so they are saved with the rest): with them the Graphics tab is the PC graphics page (the preset, render scale, frame-rate limit, V-Sync as the browser fixes it, adaptive quality, battery saver, fullscreen and the GPU's power preference, which says it applies after a restart) and the screen applies each change with og.render.setDisplay(SettingsDesc.world, display). Null: the Graphics tab shows the preset alone, applied with og.render.applyQuality as before."
    field language String "The language code." {
      default "en"
    }
    field bindings List.KeyBinding "The controls, as shown on the Controls tab."
  }

  struct SettingsDesc {
    doc "A settings screen: Audio, Graphics, Controls and Language tabs (a select on a phone) over the game's settings, with persistence hooks."
    desc true
    field open bool "Whether it is shown."
    field settings GameSettings "The settings from game state."
    field languages List.LanguageOption "The languages offered; empty hides the Language tab."
    field onChange Option.SettingsChanged "Called on every change (apply it at once: volume, contrast)."
    field onSave Option.SettingsChanged "Called when the screen closes after changes (persist here)."
    field world Option.World "The world the graphics preset is drawn in: when the player picks another preset the screen calls og.render.applyQuality(world, preset) before onChange (with GameSettings.display, og.render.setDisplay(world, display) instead, which never writes the world), and another text size og.ui.configure(world, { textScale }). The Controls tab sets the mouse's raw input (og.input.setMouse) and, with lookAction, its sensitivity there too. Null leaves applying them to the game. Inside a system, the system declares RenderSettings among its writes."
    field lookAction String "The axis action (`look`) the Controls tab's Sensitivity and Invert vertical look set for the mouse: og.input.setSensitivity(world, { action, device: keyboardMouse, scale: sensitivity, invertY }). Empty leaves them to the game."
    field title String "The dialog's title. Every word of the screen is a field with its English default: a localised game passes its string table's (og.i18n.t)." {
      default "Settings"
    }
    field audioLabel String "The Audio tab." {
      default "Audio"
    }
    field graphicsLabel String "The Graphics tab." {
      default "Graphics"
    }
    field controlsLabel String "The Controls tab." {
      default "Controls"
    }
    field languageLabel String "The Language tab." {
      default "Language"
    }
    field masterLabel String "The master volume's slider." {
      default "Master"
    }
    field musicLabel String "The music volume's slider." {
      default "Music"
    }
    field effectsLabel String "The effects volume's slider." {
      default "Effects"
    }
    field muteLabel String "The mute toggle." {
      default "Mute everything"
    }
    field uiLabel String "The interface volume's slider." {
      default "Interface"
    }
    field subtitlesLabel String "The subtitles toggle." {
      default "Subtitles"
    }
    field volumeLabel String "The Audio tab's heading over the volume sliders." {
      default "Volume"
    }
    field help Map.String "A line about each row, by its id (Master, Music, Effects, Interface, Mute, Subtitles, Quality, Fps, Motion, Contrast, TextSize, Sensitivity, Invert, Raw, Vibration, Languages, and the graphics page's Scale, Cap, Auto, Battery, Fullscreen, Power): on a desktop or tablet a pane beside the rows shows the focused row's name and line (the tab's first row with a line until one is focused). Empty hides the pane."
    field qualityLabel String "The graphics preset's heading, also the presets' group's accessible name." {
      default "Quality"
    }
    field lowLabel String "The low preset." {
      default "Low"
    }
    field mediumLabel String "The medium preset." {
      default "Medium"
    }
    field highLabel String "The high preset." {
      default "High"
    }
    field fpsLabel String "The frame-rate toggle." {
      default "Show frame rate"
    }
    field motionLabel String "The reduced-motion toggle." {
      default "Reduce motion"
    }
    field contrastLabel String "The high-contrast toggle." {
      default "High contrast"
    }
    field textSizeLabel String "The text-size slider." {
      default "Text size"
    }
    field sensitivityLabel String "The look sensitivity's slider." {
      default "Sensitivity"
    }
    field invertLabel String "The invert-Y checkbox." {
      default "Invert vertical look"
    }
    field vibrationLabel String "The vibration checkbox." {
      default "Vibration"
    }
    field doneLabel String "The button that closes the screen." {
      default "Done"
    }
    field sectionLabel String "What a screen reader calls the row of tabs (the select on a phone): the group's accessible name, never drawn." {
      default "Section"
    }
    field languagesLabel String "What a screen reader calls the list of languages: the group's accessible name, never drawn." {
      default "Languages"
    }
    field renderScaleLabel String "The render scale's slider (GameSettings.display)." {
      default "Render scale"
    }
    field frameCapLabel String "The frame-rate limit's select." {
      default "Frame rate limit"
    }
    field frameCapAutoLabel String "The frame-rate limit's automatic choice (FrameCap auto)." {
      default "Automatic"
    }
    field frameCapDisplayLabel String "The frame-rate limit at the display's rate (FrameCap display)." {
      default "Display's rate"
    }
    field vsyncLabel String "The V-Sync row." {
      default "V-Sync"
    }
    field vsyncValueLabel String "What the V-Sync row says: the browser always presents on the display's refresh." {
      default "On (set by the browser)"
    }
    field autoQualityLabel String "The adaptive quality toggle (DisplaySettings.autoQuality)." {
      default "Adapt quality to hold the frame rate"
    }
    field batteryLabel String "The battery saver toggle." {
      default "Battery saver"
    }
    field fullscreenLabel String "The fullscreen toggle." {
      default "Fullscreen"
    }
    field powerLabel String "The power preference's select." {
      default "Graphics processor"
    }
    field highPerformanceLabel String "The high-performance GPU." {
      default "High performance"
    }
    field lowPowerLabel String "The low-power GPU." {
      default "Low power"
    }
    field restartLabel String "Shown under the power preference while it differs from the GPU the page loaded with." {
      default "Applies after a restart"
    }
    field rawMouseLabel String "The raw mouse input toggle (GameSettings.rawMouse)." {
      default "Raw mouse input"
    }
    field rawUnavailableLabel String "Shown under it where the browser has no raw input (og.input.mouse's rawUnsupported)." {
      default "Not available in this browser"
    }
  }

  struct SettingsResult {
    doc "The settings screen's answer this tick."
    field settings GameSettings "The settings after this tick's input: keep them."
    field changed bool "Something changed this tick."
    field closed bool "The player closed the screen (Back, Done): set open false."
  }

  struct Ability {
    doc "An ability on a HUD: a cooldown ring with its key."
    desc true
    field id String "Its id (and probe id)."
    field key String "The key or button shown in the middle."
    field icon String "An icon of the atlas instead of the key; empty is the key."
    field remaining f32 "How much of its cooldown is left: 1 just used, 0 ready." {
      unit ratio
    }
  }

  struct PlatformerHudDesc {
    doc "A platformer HUD: lives as hearts and a level name top left, coins and score top right, a timer, a pause button. What a game leaves out it does not draw: no hearts with maxLives 0 (and no health), no coins or score capsule without coins or score."
    desc true
    field lives u32 "Lives left."
    field maxLives u32 "Lives at most (hearts drawn); 0 draws no hearts and no capsule for them (a game without lives)." {
      default 3
    }
    field coins Option.u32 "Coins collected; null or left out draws no coins capsule."
    field score Option.u32 "The score; null or left out draws no score capsule."
    field level String "The level's name; empty is none."
    field timeLeft Option.f32 "Seconds left; null hides the timer."
    field health Option.f32 "A health bar instead of hearts, 0 to 1; null shows hearts."
    field touch bool "Show touch controls (a d-pad and Jump) on phones and tablets."
    field jumpLabel String "The touch Jump button. Every word of the HUD is a field with its English default: a localised game passes its string table's (og.i18n.t)." {
      default "Jump"
    }
    field pauseLabel String "The pause button's name (what a screen reader says; the button shows its icon)." {
      default "Pause"
    }
  }

  struct HudResult {
    doc "What a HUD answered this tick."
    field paused bool "The pause button was pressed (or Back)."
    field action Option.String "A HUD action pressed this tick (an ability's id, `jump`, a generator's `buy:<id>`, `tap`)."
    field moveX f32 "The touch controls' horizontal input, -1 to 1."
    field moveY f32 "The touch controls' vertical input, -1 (up) to 1."
    field held List.String "The touch action buttons held this tick."
  }

  struct ShooterHudDesc {
    doc "A shooter HUD: health and armor bottom left, ammo bottom right, abilities as cooldown rings, kills top right, a crosshair, an optional mini-map."
    desc true
    field health f32 "Health."
    field maxHealth f32 "Full health." {
      default 100
    }
    field armor f32 "Armor; 0 with maxArmor 0 hides it."
    field maxArmor f32 "Full armor."
    field ammo u32 "Rounds in the magazine."
    field magazine u32 "Rounds a magazine holds."
    field reserve u32 "Rounds in reserve."
    field weapon String "The weapon's name."
    field kills u32 "Kills."
    field abilities List.Ability "Abilities with cooldowns."
    field crosshair bool "Draw a crosshair at the centre." {
      default true
    }
    field map Option.MinimapDesc "A mini-map top left; null is none."
    field touch bool "Show touch controls (a stick and Fire) on phones and tablets."
    field killsLabel String "The word after the kill count. Every word of the HUD is a field with its English default: a localised game passes its string table's (og.i18n.t)." {
      default "kills"
    }
    field fireLabel String "The touch Fire button." {
      default "Fire"
    }
    field pauseLabel String "The pause button's name (what a screen reader says; the button shows its icon)." {
      default "Pause"
    }
  }

  struct PuzzleHudDesc {
    doc "A puzzle HUD: level and moves, the score towards a target with three star marks, an optional timer."
    desc true
    field level String "The level's name."
    field score u32 "The score."
    field target u32 "The score that wins." {
      default 1000
    }
    field stars List.u32 "The scores for one, two and three stars; empty is a third, two thirds and all of the target."
    field moves Option.u32 "Moves left; null hides it."
    field timeLeft Option.f32 "Seconds left; null hides it."
    field movesLabel String "The caption under the moves left. Every word of the HUD is a field with its English default: a localised game passes its string table's (og.i18n.t)." {
      default "moves left"
    }
    field targetLabel String "The line beside the stars; `{target}` is replaced by the target, formatted (1,000). A localised game passes its string table's, with `{target}` in it." {
      default "Target {target}"
    }
    field pauseLabel String "The pause button's name (what a screen reader says; the button shows its icon)." {
      default "Pause"
    }
  }

  struct Currency {
    doc "A currency an idle game counts."
    desc true
    field id String "Its id."
    field name String "Its name."
    field amount f64 "How much there is."
    field perSecond f64 "How much it earns per second."
    field icon String "An icon of the atlas; empty is none."
  }

  struct Generator {
    doc "A generator an idle game lists: level, cost, progress."
    desc true
    field id String "Its id: buying answers `buy:<id>`."
    field name String "Its name."
    field level u32 "Its level."
    field cost f64 "The next level's price."
    field affordable bool "The player can pay for it."
    field progress f32 "Its cycle, 0 to 1." {
      unit ratio
    }
    field icon String "An icon of the atlas; empty is none."
  }

  struct IdleHudDesc {
    doc "An idle or incremental HUD: currencies with their rates on top, a big tap target, the generators in a list."
    desc true
    field currencies List.Currency "The currencies, the first the main one."
    field generators List.Generator "The generators."
    field tapLabel String "The tap target's label; empty hides it." {
      default "Tap"
    }
    field levelLabel String "A generator's level badge; `{level}` is replaced by its level. Every word of the HUD is a field with its English default: a localised game passes its string table's (og.i18n.t), with `{level}` in it." {
      default "Lv {level}"
    }
    field rateLabel String "A currency's rate; `{rate}` is replaced by its per-second amount, formatted (+12/s is `+{rate}/s`). A localised game passes its string table's, with `{rate}` in it." {
      default "+{rate}/s"
    }
    field pauseLabel String "The pause button's name (what a screen reader says; the button shows its icon)." {
      default "Pause"
    }
  }

  struct RaceSplit {
    doc "One split of a racing HUD: a sector's time and its delta against the reference (the record's split)."
    desc true
    field label String "Its name (`S1`, a sector's), the game's own word."
    field time Option.f32 "Its time in seconds, shown as m:ss.mmm; null is not yet run (a dash)."
    field delta Option.f32 "Against the reference in seconds, shown signed (`-0.412`, `+1.050`, with the ASCII minus every pack draws): negative is ahead, in success ink; positive behind, in danger ink; null shows none."
  }

  struct RacingHudDesc {
    doc "A racing HUD: position and lap top left, the times top right (the race time, a live delta, the best, the splits), the speedometer and gear bottom right, the boost meter, an optional mini-map. A time trial sets racers 0 (no place) and boostMeter false (no meter), and shows its sectors as splits."
    desc true
    field speed f32 "The speed, in `unit`."
    field maxSpeed f32 "The dial's top." {
      default 300
    }
    field unit String "The speed's unit." {
      default "km/h"
    }
    field gear String "The gear (`3`, `R`, `N`)."
    field lap u32 "The lap." {
      default 1
    }
    field laps u32 "Laps in the race." {
      default 3
    }
    field position u32 "The player's place." {
      default 1
    }
    field racers u32 "Cars in the race; 0 hides the place (a time trial)." {
      default 8
    }
    field time f32 "The race time in seconds."
    field delta Option.f32 "A live delta in seconds against the reference lap, under the time, signed like a split's: negative (ahead) in success ink, positive in danger ink; null hides it."
    field best Option.f32 "The best lap in seconds; null hides it."
    field splits List.RaceSplit "Splits under the times (a time trial's sectors), one row each: label, time, delta; empty is none."
    field boost f32 "The boost meter, 0 to 1." {
      unit ratio
    }
    field boostMeter bool "Draw the boost meter and the touch Boost pedal; a race without boost (a time trial) sets false." {
      default true
    }
    field map Option.MinimapDesc "A mini-map; null is none."
    field touch bool "Show touch controls (steering arrows, Brake, Boost) on phones and tablets."
    field lapLabel String "The caption under the lap. Every word of the HUD is a field with its English default (unit too): a localised game passes its string table's (og.i18n.t)." {
      default "lap"
    }
    field bestLabel String "The best lap's line; `{best}` is replaced by the best lap as m:ss.mmm. A localised game passes its string table's, with `{best}` in it." {
      default "Best {best}"
    }
    field pauseLabel String "The pause button's name (what a screen reader says; the button shows its icon)." {
      default "Pause"
    }
    field boostLabel String "The boost meter's label and the touch Boost pedal." {
      default "Boost"
    }
    field brakeLabel String "The touch Brake pedal." {
      default "Brake"
    }
    field leftLabel String "The touch steering arrow left." {
      default "Left"
    }
    field rightLabel String "The touch steering arrow right." {
      default "Right"
    }
  }

