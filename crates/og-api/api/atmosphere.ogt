module atmosphere {
  doc "Fog, a procedural sky, the day-night cycle, weather, the wind that sways vegetation and water, declared as resources and components (the E5 round). Everything is off by default: a world that sets none of them draws exactly as before."
  doc "The day-night clock is a function of the tick (DayNight.start plus the simulated time times speed), so it is the same on every run and after a restore; rendering reads the world and never writes it."

  const WEATHER_NONE u32 0 "Weather.kind: clear."
  const WEATHER_RAIN u32 1 "Weather.kind: rain streaks falling with the wind, the light dimmed and a grey distance fog."
  const WEATHER_SNOW u32 2 "Weather.kind: flakes drifting down on gusts, a pale fog."
  const WEATHER_DUST u32 3 "Weather.kind: dust blowing along the wind near the ground, a warm thick fog."
  const WEATHER_MIST u32 4 "Weather.kind: no particles, a dense low height fog."

  resource Fog {
    doc "Distance and height fog over the 3D scene and world sprites: distance fog, measured from the camera, thickens exponentially by density per metre past start and, when end > start, also by a linear ramp from start to full fog at end; the two apply together, and density defaults to 0.02, so setting only end still adds exponential fog (set density 0 for the ramp alone). Height fog is densest below height and thins by falloff per metre above it; looking into the sun it turns towards sunColor. The overlay is never fogged."
    guide "render §7"
    field enabled bool "Draw the fog."
    field color Color "The colour the fog tends to (linear, before exposure)." {
      default 0.62 0.68 0.76
    }
    field density f32 "Exponential distance fog per metre past start, with or without end's ramp (0: none)." {
      default 0.02
      min 0
      max 2
      tunable true
    }
    field start f32 "The distance from the camera where distance fog starts." {
      min 0
      unit m
      tunable true
    }
    field end f32 "The distance from the camera where fog is full: with end > start, a linear ramp from start to end applied together with density's exponential fog (0: no ramp)." {
      min 0
      unit m
      tunable true
    }
    field heightDensity f32 "Height fog at and below height (0: none)." {
      min 0
      max 10
      tunable true
    }
    field height f32 "The world height below which height fog is densest." {
      worldspace world y
      unit m
      tunable true
    }
    field falloff f32 "How fast height fog thins above height, per metre." {
      default 0.5
      min 0.0001
      max 20
      tunable true
    }
    field sunColor Color "The fog's colour looking into the sun (forward scattering)." {
      default 1 0.86 0.62
    }
    field sunPower f32 "How tight the sun's glow in the fog is (higher: smaller)." {
      default 8
      min 0
      max 256
      tunable true
    }
    field maxOpacity f32 "The most the fog hides." {
      default 1
      min 0
      max 1
      unit ratio
      tunable true
    }
    field sky f32 "How much of the fog covers the sky (0: the sky stays clear)." {
      default 1
      min 0
      max 1
      unit ratio
      tunable true
    }
    field volumetric bool "Light the fog as a medium within volumetricDistance: it (density, thickened below height) scatters the sun through its cascades and the point, spot and rect lights (up to RenderCapabilities.volumetricLights a sample), and dims what lies behind. Blended surfaces and sprites take the plain fog." {
      guide "render §7"
    }
    field scattering f32 "How much of the light the fog takes from a ray it scatters (its albedo, tinted by color): 0 dims without glowing, 1 sends all of it on, above 1 brightens the shafts for effect." {
      default 0.8
      min 0
      max 4
      tunable true
    }
    field anisotropy f32 "Which way the fog scatters (Henyey–Greenstein g): 0 evenly, towards 1 forward (bright looking into the light: shafts against the sun), below 0 back towards the light." {
      default 0.6
      min -0.95
      max 0.95
      tunable true
    }
    field volumetricDistance f32 "How far from the camera the volume reaches." {
      default 48
      min 4
      max 400
      unit m
    }
  }

  resource Sky {
    doc "A procedural sky of chosen colours, drawn behind the scene per pixel and lighting it: the image-based light and the reflections' sky (where a surface reflects no probe and SSR misses) follow it as drawn, clouds and all, captured from the camera a slice a frame, eight frames to a whole capture. Without it, RenderSettings.sky draws the built-in sky. A DayNight that is enabled sets the sky itself."
    guide "render §7"
    field enabled bool "Draw and light by this sky."
    field zenith Color "Overhead." {
      default 0.18 0.36 0.78
    }
    field horizon Color "At the horizon." {
      default 0.78 0.84 0.92
    }
    field ground Color "Below the horizon." {
      default 0.16 0.14 0.12
    }
    field sunDirection Vector3 "Towards the sun (match your DirectionalLight)." {
      default 0.45 0.8 0.35
    }
    field sunColor Color "The sun's colour." {
      default 1 0.95 0.88
    }
    field sunSize f32 "The sun disc's angular radius (0: no disc)." {
      default 1.8
      min 0
      max 20
      unit deg
      tunable true
    }
    field sunIntensity f32 "The disc's brightness." {
      default 40
      min 0
      tunable true
    }
    field glow f32 "The glow around the sun." {
      default 0.6
      min 0
      tunable true
    }
    field glowPower f32 "How tight the glow is." {
      default 24
      min 1
      tunable true
    }
    field stars f32 "Stars where the sky is dark: 0 none, 1 a full night sky." {
      min 0
      max 1
      unit ratio
      tunable true
    }
    field brightness f32 "A multiplier on the whole sky." {
      default 1.1
      min 0
      tunable true
    }
    field moonSize f32 "The moon disc's angular radius (0: no moon). It sets below the horizon and hides the stars behind it." {
      min 0
      max 20
      unit deg
      tunable true
    }
    field moonPhase f32 "How much of the moon is lit: 0 new, 0.25 the first quarter (its right half), 0.5 full, 0.75 the last quarter (its left half)." {
      default 0.5
      min 0
      max 1
      unit ratio
      tunable true
    }
    field moonIntensity f32 "The lit moon's brightness." {
      default 1.4
      min 0
      tunable true
    }
    field moonColor Color "The moon's colour." {
      default 0.9 0.92 1
    }
    field moonDirection Vector3 "Towards the moon; zero puts it opposite sunDirection."
  }

  resource DayNight {
    doc "A day-night cycle: the time of day drives the sun's direction, the sky's colours, stars and moon, the first DirectionalLight (the sun by day, a dim moon opposite it by night), the ambient light and the fog's colour. The clock is start plus the simulated seconds times speed, wrapped to 24 hours; the sky's colours step every `step` minutes while the sun moves smoothly. The drive happens as the frame is drawn and never writes the world: the DirectionalLight keeps the colour, intensity and transform it was given; the probe's `get` answers what is drawn."
    guide "render §7"
    field enabled bool "Run the cycle."
    field start f32 "The time of day at tick 0, in hours (6 sunrise, 12 noon, 18 sunset)." {
      default 9
      min 0
      max 24
      tunable true
    }
    field speed f32 "Game hours per simulated second (0.05: a day in 8 minutes; 0 holds the time)." {
      default 0.05
      min 0
      max 24
      tunable true
    }
    field tilt f32 "How far the sun's path leans from overhead." {
      default 25
      min 0
      max 89
      unit deg
      tunable true
    }
    field azimuth f32 "Where the sun rises, turned about +y from +x." {
      unit deg
      tunable true
    }
    field lightIntensity f32 "A multiplier on the sun and moon light." {
      default 1
      min 0
      max 10
      tunable true
    }
    field tintFog bool "Turn the og.Fog colour towards the horizon's." {
      default true
    }
    field step f32 "Game minutes between steps of the sky's colours (the image-based light follows the sky as drawn)." {
      default 10
      min 1
      max 120
      tunable true
    }
    field moonSize f32 "The moon disc's angular radius, opposite the sun so it rises as the sun sets (0: no moon)." {
      default 1.6
      min 0
      max 20
      unit deg
      tunable true
    }
    field moonPhase f32 "How much of the moon is lit: 0 new, 0.25 the first quarter, 0.5 full, 0.75 the last quarter." {
      default 0.5
      min 0
      max 1
      unit ratio
      tunable true
    }
  }

  resource PhysicalSky {
    doc "A physical sky: sunlight scattered by the air (Rayleigh) and haze (Mie), with ozone, in a spherical atmosphere of Earth's proportions with multiple scattering (Hillaire 2020). It replaces og.Sky's and og.DayNight's gradient, and the image-based light follows it. With og.DayNight it also gives the cycle its sun colour, ambient light and fog colour; with og.Sky, og.Sky's sun, disc, stars, moon and brightness are drawn through the air; alone it draws towards the first DirectionalLight. Visual only: drawn from the tick."
    guide "render §7"
    field enabled bool "Draw the sky by scattering."
    field haze f32 "How much haze the air holds, a multiplier on Earth's aerosols (1: a clear day; 0: pure air; 5 to 10: a hazy or smoggy day, a whiter sky and a wider glow round the sun)." {
      default 1
      min 0
      max 40
      tunable true
    }
    field airDensity f32 "A multiplier on the air's scattering (1: Earth; above 1 a deeper blue and redder sunsets, below 1 a thinner, darker sky)." {
      default 1
      min 0
      max 10
      tunable true
    }
    field ozone f32 "A multiplier on ozone's absorption, which keeps the sky blue overhead at twilight (0: none, the twilight sky turns grey and yellow)." {
      default 1
      min 0
      max 10
      tunable true
    }
    field groundAlbedo Color "The ground's colour as the air sees it from below: it lights the haze and the sky below the horizon." {
      default 0.3 0.3 0.3
    }
    field altitude f32 "The height above sea level of the world's y 0 (the camera's height is added): from high up the sky darkens overhead and the sun stays up longer." {
      min 0
      max 100000
      unit m
      tunable true
    }
    field night Color "The sky's light with the sun far below the horizon (airglow and starlight), so a night is dark blue rather than black and the land under it keeps a deep blue-grey ambient." {
      default 0.0022 0.0032 0.0075
    }
  }

  resource Clouds {
    doc "Clouds in the procedural sky: a volumetric cumulus layer raymarched through a curved shell over the planet, lit by the first DirectionalLight (self-shadowed, with multiple scattering) and the sky, faded with distance, and a thin high cirrus layer above. og.Wind carries them by the tick's clock, the same on every run and after a restore. Drawn over og.Sky, og.DayNight or og.PhysicalSky (alone they bring the built-in sky), they dim the sun and the sky's light by their cover. Visual only."
    guide "render §7"
    field enabled bool "Draw the clouds."
    field coverage f32 "How much of the sky the cumulus covers: 0 none, 0.3 fair weather, 0.6 broken, 1 overcast." {
      default 0.45
      min 0
      max 1
      unit ratio
      tunable true
    }
    field density f32 "How thick they are per metre (0.04: cumulus; 0.01: thin and translucent; 0.08: dense storm cloud)." {
      default 0.04
      min 0
      max 0.5
      tunable true
    }
    field base f32 "The height of the cloud base above the world's y 0." {
      default 1500
      min 0
      unit m
      tunable true
    }
    field thickness f32 "How tall the layer is (0: no cumulus, only the high layer)." {
      default 1800
      min 0
      unit m
      tunable true
    }
    field scale f32 "The size of the largest cloud shapes." {
      default 9000
      min 500
      max 200000
      unit m
      tunable true
    }
    field wind Vector3 "Their own motion, added to og.Wind's (which carries them twice as fast as it blows at the ground): x and z a drift, y how fast their shapes turn over." {
      default 0 0.4 0
      unit mps
      tunable true
    }
    field color Color "Their albedo: white for fair-weather clouds, a grey for rain clouds." {
      default 1 1 1
    }
    field detail f32 "How much fine noise erodes their edges (0: smooth blobs, 1: wispy)." {
      default 0.35
      min 0
      max 1
      unit ratio
      tunable true
    }
    field layer f32 "The high thin layer's cover (0: none)." {
      default 0.3
      min 0
      max 1
      unit ratio
      tunable true
    }
    field layerAltitude f32 "The high layer's height (kept above the cumulus)." {
      default 8000
      min 0
      unit m
      tunable true
    }
    field steps u32 "Samples along each view ray through the cumulus: more is smoother and costs more." {
      default 48
      min 8
      max 256
    }
  }

  resource Aurora {
    doc "The aurora: curtains of light in the upper atmosphere raymarched in the procedural sky (after Lawlor and Genetti 2011), each a sheet of falling electrons along the auroral oval, folded by travelling waves and curled by a Kelvin-Helmholtz instability, glowing by height as the electrons' energy deposits (green oxygen near 114 km, a nitrogen border below, red oxygen above 200 km; Whiter et al. 2023). Emission only, under the clouds; invisible against a daylight sky. It follows the tick's clock. Drawn over the procedural sky. Visual only."
    guide "render §7"
    field enabled bool "Draw the aurora."
    field intensity f32 "How bright the display is: 1 a bright display against a night sky, 0.3 a faint one." {
      default 1
      min 0
      max 20
      tunable true
    }
    field activity f32 "0 quiet, smooth arcs; 0.5 folding, rayed curtains; 1 a substorm's breakup, curled and fragmented, moving fast." {
      default 0.4
      min 0
      max 1
      unit ratio
      tunable true
    }
    field curtains u32 "How many arcs, one behind another." {
      default 3
      min 1
      max 6
    }
    field direction f32 "Where the arcs lie, turned about +y from +x (the convention of og.DayNight's azimuth)." {
      default 90
      unit deg
      tunable true
    }
    field distance f32 "How far the first arc is from the world's origin over the ground (0: overhead)." {
      default 150000
      min 0
      max 1500000
      unit m
      tunable true
    }
    field spread f32 "The distance between successive arcs." {
      default 70000
      min 0
      unit m
      tunable true
    }
    field energy f32 "The falling electrons' characteristic energy in keV: about 2 for a typical display; under 1 a high, red-topped aurora; over 5 a low one with a pink-violet lower border." {
      default 2
      min 0.3
      max 20
      tunable true
    }
    field speed f32 "How fast the folds travel and the rays drift (1: as observed)." {
      default 1
      min 0
      max 20
      tunable true
    }
    field seed u32 "The display's seed: its curtains' shapes and their curls."
    field greenColor Color "The oxygen green line's colour (557.7 nm): by default its spectral colour, a yellow-green; a camera's photograph renders it bluer (0.1 1 0.55)." {
      default 0.29 1 0
    }
    field redColor Color "The oxygen red line's colour (630.0 nm), of the high tops." {
      default 1 0 0.06
    }
    field nitrogenColor Color "The nitrogen bands' colour (427.8 nm and the red first positive band), of the lower border: violet to pink." {
      default 0.57 0 1
    }
  }

  resource WeatherState {
    doc "The weather's effect on the world, simulated in the tick from og.Weather so gameplay can read it: how wet the ground is, how much standing water, snow and dust lie on it, and the lightning strikes, drawn from a stream forked from og.Rng (`fork(\"og.weather\")`) and kept here, so replays, restores and every host strike alike. Registered the first time a game names it: a world that never does keeps its type table and hash. The renderer draws the same values on every lit surface (StandardMaterialDesc.weathering opts a material out); rendering never writes it."
    guide "render §7"
    group "Wetness"
    field soakTime f32 "Seconds of rain at intensity 1 to soak dry ground (wetness 0 to 1)." {
      default 60
      min 0.1
      unit s
      tunable true
    }
    field dryTime f32 "Seconds for soaked ground to dry once the rain stops." {
      default 300
      min 0.1
      unit s
      tunable true
    }
    field puddleTime f32 "Seconds of rain at intensity 1 on soaked ground to fill the puddles (puddles 0 to 1)." {
      default 120
      min 0.1
      unit s
      tunable true
    }
    field drainTime f32 "Seconds for full puddles to drain once the rain stops." {
      default 600
      min 0.1
      unit s
      tunable true
    }
    group "Snow"
    field snowfall f32 "How much snow settles per minute of snowfall at intensity 1." {
      default 0.01
      min 0
      unit m
      tunable true
    }
    field melt f32 "How much snow melts per minute when none falls (three times as fast in rain)." {
      default 0.004
      min 0
      unit m
      tunable true
    }
    field snowCover f32 "The snow depth at which it covers everything that can hold it (the renderer's full cover)." {
      default 0.08
      min 0.001
      unit m
      tunable true
    }
    group "Dust"
    field dustTime f32 "Seconds of a dust storm at intensity 1 to cover what faces up with dust and sand (dust 0 to 1). It stays when the storm ends; rain washes it off." {
      default 600
      min 0.1
      unit s
      tunable true
    }
    field washTime f32 "Seconds of rain at intensity 1 to wash full dust off." {
      default 90
      min 0.1
      unit s
      tunable true
    }
    field dustColor Color "The colour of the settled dust and sand (linear): pale ochre by default; a red desert's or a grey quarry's." {
      default 0.62 0.5 0.36
    }
    group "Lightning"
    field lightning f32 "Lightning strikes per minute on average, at random ticks (0: none), whatever the kind of weather." {
      min 0
      max 600
      tunable true
    }
    field lightningCenter Vector3 "The centre of the area strikes land in (its y is the ground's height there)." {
      worldspace world
      unit m
    }
    field lightningRadius f32 "The radius of that area: strikes land evenly over the disc." {
      default 300
      min 0
      unit m
      tunable true
    }
    group "Shelter"
    field shelterSize f32 "The side of the square around the camera in which roofs, overhangs and canopies keep what is under them dry and free of snow, with a soft edge at the drip line; past it every surface is open to the sky. 0: nothing shelters. Drawn only: the tick's wetness, puddles and snowDepth are the open ground's." {
      guide "render §7"
      default 64
      min 0
      max 1024
      unit m
      tunable true
    }
    group "State" "Written by og.weather; read them, never write them."
    field wetness f32 "How wet the ground is, 0 dry to 1 soaked (written by og.weather)." {
      readonly true
      unit ratio
    }
    field puddles f32 "How far standing water has spread, 0 none to 1 (written by og.weather)." {
      readonly true
      unit ratio
    }
    field dust f32 "How much dust and sand has settled, 0 none to 1 covering what faces up (written by og.weather)." {
      readonly true
      unit ratio
    }
    field snowDepth f32 "The depth of lying snow (written by og.weather). The drawn terrain rises by it on level ground, up to 10 cm, once the cover has built up; only drawn: collision, og.terrain.sample, picking and what stands on the ground keep the terrain's own height." {
      readonly true
      unit m
    }
    field strikes u32 "Lightning strikes so far (written by og.weather)." {
      readonly true
    }
    field lastStrike u32 "The tick of the latest strike (0 before the first; written by og.weather)." {
      readonly true
    }
    field strikePosition Vector3 "Where the latest strike landed (written by og.weather)." {
      worldspace world
      readonly true
      unit m
    }
    field stream u32 "The lightning's random state, forked from og.Rng the first tick (written by og.weather)." {
      readonly true
    }
  }

  event LightningStrike {
    doc "Lightning struck, in the tick og.weather drew it (og.WeatherState.lightning): read in the systems after og.weather that tick, or the next tick's first."
    field position Vector3 "Where it landed: in the disc of og.WeatherState.lightningRadius around lightningCenter, at its height." {
      worldspace world
      unit m
    }
    field strike u32 "Which strike it is, counting from 1 (og.WeatherState.strikes after it)."
  }

  resource Weather {
    doc "A weather preset around the camera: particles (rain, snow, dust), its fog (unless og.Fog is enabled, which takes precedence), the cloud cover rain and snow fall from (og.Clouds closed to it, or a deck of the weather's own under a procedural sky) and the light under it, dimmed once. Particles are simulated by the renderer from the tick, so they look the same on every run; they never touch the simulation."
    field kind u32 "WEATHER_NONE 0, WEATHER_RAIN 1, WEATHER_SNOW 2, WEATHER_DUST 3, WEATHER_MIST 4." {
      min 0
      max 4
      label "Kind"
    }
    field intensity f32 "How heavy: the share of the particles born, the fog, the cover and the dimming. A change keeps the particles in the air: ramp it to build or clear a weather." {
      default 1
      min 0
      max 2
      tunable true
    }
    field wind Vector3 "A wind of the weather's own on the particles, added to og.Wind's." {
      unit mps
      tunable true
    }
    field radius f32 "The size of the region around the camera the particles fill." {
      default 18
      min 1
      max 200
      unit m
      tunable true
    }
    field tint Color "Multiplies the particles' colour." {
      default 1 1 1
    }
    field dim f32 "How much of the preset's cloud cover and dimming of the sunlight applies." {
      default 1
      min 0
      max 1
      unit ratio
      tunable true
    }
    field layer i32 "With an orthographic camera (2D), the sprite layer the particles draw in." {
      default 50
    }
  }

  resource Wind {
    doc "The world's wind: where the air moves and how fast. Everything in the air moves in it and adds its own `wind`: vegetation leans downwind and sways in gusts (og.TerrainScatter, og.Grass, trees, og.Model with a sway: 0.05 of its height per m/s), og.Clouds drift, og.Weather slants, and og.Rope, og.Cloth and og.Garment are pushed in the tick. Material shader hooks read it as `h.wind` (xyz where it blows, w the lean). Where RenderCapabilities.compute allows, vegetation reads one simulated field that carries og.WindMotor pushes. Still at speed 0. An og.Water's sea keeps its own wind."
    guide "render §8"
    field direction Vector3 "Where the wind blows: its horizontal part, normalised." {
      default 1 0 0
      tunable true
    }
    field speed f32 "How fast the air moves, and the gusts travel downwind (3: a light breeze, 8: fresh, branches move; 20: a gale); 0 is still." {
      min 0
      max 50
      unit mps
      tunable true
    }
    field gust f32 "How much the lean varies in the gusts: 0 a steady lean, 1 from upright to twice the mean." {
      default 0.6
      min 0
      max 1
      unit ratio
      tunable true
    }
    field turbulence f32 "How much the wind swirls on its own between the gusts, where the renderer simulates it (RenderCapabilities.compute): 0 the gusts alone, 1 eddies as strong as the wind." {
      default 0.3
      min 0
      max 1
      unit ratio
      tunable true
    }
    field gustSize f32 "How large the gust patches are." {
      default 14
      min 1
      max 200
      unit m
      tunable true
    }
  }

  enum WindMotorKind {
    doc "How an og.WindMotor pushes the wind."
    variant omni "Outward from its centre: a blast, a landing, a horse's hooves."
    variant directional "Along the entity's forward (its -z, horizontal part): a fan, a rotor's downwash leaning the grass one way."
    variant vortex "Around its centre, counter-clockwise seen from above: a whirlwind, a spell."
  }

  column WindMotorKind {
    doc "A WindMotorKind field: the variant's index."
    array Uint32Array
    stride 1
    value WindMotorKind
  }

  component WindMotor {
    doc "A local push on the renderer's wind at the entity's position: vegetation within `radius` leans away from it (omni), along it (directional) or around it (vortex), fading to nothing at the edge, and the field carries the push on after the motor stops. Needs no og.Wind. Only where the renderer simulates the wind (RenderCapabilities.compute; elsewhere it does nothing); visual only, the same on every run. The 16 nearest the camera act."
    guide "render §8"
    field kind WindMotorKind "How it pushes."
    field radius f32 "How far it reaches." {
      default 6
      min 0
      max 200
      unit m
      tunable true
    }
    field strength f32 "Its push at its centre, as a wind speed: vegetation leans by 0.05 of its height per m/s of it, as in og.Wind." {
      default 10
      min 0
      max 100
      unit mps
      tunable true
    }
  }

  component Water {
    doc "A planar water surface on the entity's xz plane (centred on it, turned with it): colour by the water's depth over what is below, foam where it meets geometry, animated waves, refraction and reflections (screen-space, the sky's cubemap where that misses, or a planar reflection), the sun's shadows, caustics below it and an underwater view. With an og.WaterSurface on the same entity its wave heights displace the surface (centred on the entity, unrotated)."
    guide "render §8"
    group "Shape"
    field size Vector2 "The extent along the entity's x and z." {
      default 16 16
      unit m
      tunable true
    }
    field geometry Geometry "Draw the water over this mesh (its vertices in the entity's frame) instead of the size × size grid: a stream, channel or pool of any outline, with the same colour by depth, refraction, foam and reflections. 0: the grid. A mesh surface has no wave heights."
    field river Path "A river along this path (og.path; its heights the water's level): a ribbon riverWidth across in place of the grid, its current riverSpeed mid-stream, slowing to nothing at the banks; og.Buoyancy bodies drift with it in the tick. Where it drops steeper than 45 degrees it falls. 0: none." {
      guide "render §8"
    }
    field riverWidth f32 "The river's width across." {
      default 6
      min 0
      unit m
      tunable true
    }
    field riverSpeed f32 "The river's current mid-stream; it slows to nothing at the banks." {
      default 1.5
      min 0
      unit mps
      tunable true
    }
    field segments u32 "Grid cells per side (the height field's detail)." {
      default 64
      min 1
      max 256
    }
    group "Colour and body"
    field shallow Color "Shallow water's colour (tints what is seen through it)." {
      default 0.55 0.85 0.82
    }
    field deep Color "Deep water's colour." {
      default 0.02 0.09 0.14
    }
    field depthFade f32 "The depth over which water turns from shallow to deep." {
      default 2.5
      min 0.01
      unit m
      tunable true
    }
    field absorption Color "How much of each colour the water absorbs per metre of light's path (1/m; sea water about 0.45 0.07 0.03). With it or scattering set the body is physical: what lies below dims along the path down and up, and sun and sky scatter back out; shallow, deep, depthFade and opacity are then unused." {
      guide "render §8"
      default 0 0 0
    }
    field scattering Color "How much of each colour the water scatters per metre (1/m; clear ocean about 0.002 0.004 0.008, a silty coast ten times that). See absorption." {
      default 0 0 0
    }
    field opacity f32 "How opaque deep water gets." {
      default 0.92
      min 0
      max 1
      unit ratio
      tunable true
    }
    group "Foam"
    field foam Color "The foam's colour." {
      default 0.95 0.97 1
    }
    field foamWidth f32 "The water depth over which foam rings geometry (0: none)." {
      default 0.35
      min 0
      unit m
      tunable true
    }
    group "Detail waves"
    field waveScale f32 "Detail waves per metre." {
      default 0.6
      min 0
      tunable true
    }
    field waveSpeed f32 "How fast the detail waves travel." {
      default 1
      tunable true
    }
    field waveStrength f32 "How strongly they bend the surface (0: a mirror)." {
      default 0.35
      min 0
      max 4
      tunable true
    }
    group "Reflection and refraction"
    field refraction f32 "How far refraction shifts what is seen through the water." {
      default 1
      min 0
      tunable true
    }
    field reflectivity f32 "How much it reflects." {
      default 1
      min 0
      max 2
      tunable true
    }
    field planarReflection f32 "Reflect the scene by drawing it again from the camera mirrored in the surface, at this fraction of the screen's resolution (0: off, the screen-space and sky reflections). As many surfaces a frame as RenderOptions.planarReflections allows." {
      guide "render §8"
      min 0
      max 1
      unit ratio
      tunable true
    }
    field shadows f32 "How much the sun's shadows darken the surface: its highlight, foam and colour (0: none)." {
      min 0
      max 1
      unit ratio
      tunable true
    }
    field f0 f32 "The reflectance looking straight down (Schlick's F0): 0.02 for clean water; three.js Water.js reflects at least 0.3." {
      default 0.02
      min 0
      max 1
      unit ratio
      tunable true
    }
    field reflectionBias f32 "A floor under the reflected colour: bias + (1 - bias) times the reflection (three.js Water.js: 0.1)." {
      min 0
      max 1
      unit ratio
      tunable true
    }
    group "Underwater"
    field underwaterColor Color "With the camera below the surface: the water's fog colour." {
      default 0.03 0.16 0.2
    }
    field underwaterDensity f32 "Its fog per metre (0: no underwater view). Below the surface the frame's fog becomes the water's, and the surface seen from below shows the sky inside Snell's window." {
      default 0.09
      min 0
      max 2
      tunable true
    }
    group "Caustics"
    field caustics f32 "Caustics of the sunlight on everything below the surface (0: none). One surface a frame, the first that has them." {
      min 0
      max 4
      tunable true
    }
    field causticsScale f32 "The caustics' cells per metre." {
      default 0.6
      min 0.01
      max 10
      tunable true
    }
    group "Normal maps and flow" "three.js Water and Water2 ripples in place of the travelling waves."
    field normalMap Texture "Ripples from a tangent-space normal map (linear; red +x, green +z, blue up) in place of the waves: with flow 0, four layers drifting over the world's xz times normalScale (three.js Water); with a flow, two layers sliding along it, cross-faded (three.js Water2). waveStrength scales slopes. 0: waves." {
      guide "render §8"
    }
    field normalScale f32 "The normal map's repeats per metre (the lake) or per uv unit (a flow)." {
      default 1
      min 0
      tunable true
    }
    field glint f32 "three.js Water's sun glint: pow(eye · reflect(-sun, normal), 100) times the sun's light times this, through the Fresnel term. With glint it is shaded as three.js Water.js throughout (deep is its waterColor, sunColor the light × glint / 2). 0: the default half-vector highlight and depth colour." {
      guide "render §8"
      min 0
      tunable true
    }
    field flow Vector2 "Water2's flow: its direction in the mesh's uv (or the grid's x, z) and, as its length, the uv it slides per second. 0 0: the lake's four drifting layers. Without a normalMap a flow carries the travelling waves, in metres a second: a river." {
      default 0 0
      tunable true
    }
    field flowMap Texture "three.js Water2's flowMap: the flow's direction per point as rg * 2 - 1 (linear; image top at v 1), over the mesh's uv or the grid from its -x -z corner; with it flow's length is the speed (0 0: 0.03) and the map the direction, for the normal map's layers or the travelling waves. 0: the flow alone." {
      guide "render §8"
    }
    group "Sea" "A wind-driven ocean on the grid."
    field wind Vector2 "The wind over an open sea, direction in xz, speed (m/s) as length: the grid rises in Gerstner waves of a fully developed sea (Pierson–Moskowitz), drawn as a camera clipmap from a seeded JONSWAP spectrum; og.physics.waterHeight reads its longest waves. Within size unless endless; a mesh has none." {
      guide "render §8"
      default 0 0
      unit mps
      tunable true
    }
    field swell f32 "The sea's height, as a fraction of a fully developed sea's for the wind." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field choppiness f32 "How far the sea's crests lean and sharpen (Gerstner steepness): 0 round swell, 1 the most that never folds over. Whitecaps foam where the crests bunch, by as much." {
      default 0.6
      min 0
      max 1
      unit ratio
      tunable true
    }
    field endless bool "A sea (wind) to the horizon all round the camera, wherever it goes, not only within size: its waves stay where they are in the world. false: the sea ends at the size rectangle (a bay, a lake in a gale)."
    field seabed Entity "The og.Terrain whose heights are the sea's floor (0: none): a wave fades in water shallower than half its length, the sea held under its breaking height (significant height 0.78 × depth); shore trains break into surf. og.physics.waterHeight and og.Buoyancy read the same sea." {
      guide "render §8"
    }
    group "Shore"
    field shore f32 "How high the trains rolling in on the seabed's shores are, times a quarter of the sea's significant height (0: none; the waves still shoal)." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field shoreWaveLength f32 "The trains' length from crest to crest (0: 40 m)." {
      min 0
      max 400
      unit m
      tunable true
    }
    field shoreFoam f32 "How much surf foams where the trains break and the water runs shallow over the seabed (0: none)." {
      default 1
      min 0
      max 2
      unit ratio
      tunable true
    }
    group "Sea details"
    field foamStreaks f32 "How strongly a sea's ageing foam is drawn into streaks along the wind (0: none): the lace a whitecap leaves, gathered into windrows by the surface's Langmuir circulation. Rendering only." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field meniscus f32 "Where the camera's near plane crosses the surface, the width in pixels of the meniscus along the waterline between the air and the water's fog, each pixel under or above as the waves put it; 0: the line alone; below 0: no waterline, the frame above or under as the eye is. Needs underwaterDensity." {
      default 2
      min -1
      max 16
      tunable true
    }
    field dynamicWaves f32 "How high the waves an og.Buoyancy hull raises on a sea are drawn (0: none): a hull presses the water down by its draft and, moving, throws a bow wave and leaves a Kelvin wake, foaming where they break, within some 64 m of the camera. Rendering only: the tick floats every hull on the sea's own waves." {
      guide "render §8"
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field spray f32 "How much spray a sea's breaking crests throw (0: none): droplets torn off where the foam is freshest and the crests steepest, carried by the wind and falling back, more of them as the wind rises past a moderate breeze. Rendering only; the tick never sees them." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
  }

  component Water2D {
    doc "Draws the og.WaterLine on the same entity in the sprite order: the body from its surface down, a gradient from the top colour to the bottom one, and a bright lip along the surface."
    field top Color "The body's colour at the surface." {
      default 0.16 0.5 0.72
    }
    field topOpacity f32 "Its opacity there." {
      default 0.72
      min 0
      max 1
      unit ratio
    }
    field bottom Color "The colour at the bottom." {
      default 0.02 0.1 0.25
    }
    field bottomOpacity f32 "Its opacity there." {
      default 0.92
      min 0
      max 1
      unit ratio
    }
    field lip Color "The lip along the surface." {
      default 0.8 0.95 1
    }
    field lipWidth f32 "How thick the lip is (0: none)." {
      default 0.06
      min 0
      unit m
      tunable true
    }
    field layer i32 "The sprite layer it is drawn in."
  }

  fn timeOfDay {
    doc "The DayNight clock at the current tick, in hours from 0 to 24 (its start when the cycle is off): for lamps that light at dusk and shops that close at night. Inside a system, declare og.DayNight among its reads."
    param world World "The world."
    returns f32
  }
}

# ── anim ──────────────────────────────────────────────────────────────────

