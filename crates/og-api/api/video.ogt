module video {
  doc "Footage authored with file.video in TypeScript, cooked by ffmpeg, loaded with og.load.video and played by og.VideoPlayer. A clip (the default: at most 256 frames) is cooked into a texture array; a stream (`stream: true`: any length) is cooked to AV1 and decoded as it plays. The frame is a Texture; the sound plays on the entity's og.AudioSource in step with it."
  doc "Playback is simulation, decoding is presentation: og.video advances VideoPlayer.time each tick, so a player's frame on a tick is the same on both hosts and after a restore; nothing the decoder has finished reaches the world."
  guide "audio §8"
  split video

  handle Video "Cooked footage: its frames as a texture array, its sound (og.load.video)."

  column Video {
    doc "A Video handle field (0 is none)."
    array Uint32Array
    stride 2
    value Video
  }

  struct VideoInfo {
    doc "What og.load.video loaded."
    field video Video "The video."
    field texture Texture "The texture that shows the frame its og.VideoPlayer is at (frame 0 until one plays it)."
    field sound Sound "Its sound track (og.load.sound's kind of handle, for an og.AudioSource); 0 when it has none or was cooked with `audio: false`."
    field width u32 "Each frame's width in texels."
    field height u32 "Each frame's height in texels."
    field frames u32 "Frames kept (at most 256)."
    field fps u32 "Frames per second kept."
    field seconds f32 "frames / fps." {
      unit s
    }
    field format String "The frames' encoding on the GPU (`rgba8`, `bc7`, `astc4x4`, `etc2`; a stream's texture is `rgba8`)."
    field bytes f64 "Bytes its frames take on the GPU (a stream: its texture's, one frame)." {
      unit bytes
    }
    field streamed bool "Whether it is a stream (`stream: true`: decoded as it plays) rather than a clip of cooked frames."
    field aiGenerated bool "Whether the footage was made by a generative model (`aiGenerated: true` in file.video): a game or store labels AI content from it."
    field alpha bool "Whether its frames carry the source's alpha (`alpha: true` in file.video): keyed footage drawn over the scene through its texture shows the scene where the matte is clear."
    field codec String "The codec this host plays a stream in: `av1`, or `hevc` or `h264` where the browser decodes no AV1 and the cook made that rendition; empty for a clip." {
      guide "audio §8"
    }
    field poster Texture "A stream's first frame as an ordinary texture, ready as soon as the bundle is (a menu's thumbnail, the picture while the stream is fetched); for a clip, VideoInfo.texture."
    field qualities List.String "The quality tiers cooked for this stream, highest first (`high`, `medium`, `low`); empty for a clip."
    field audioLocales List.String "Locale tags of alternate audio tracks cooked beside this video (`audioLocale`); empty when only the base track exists."
  }

  enum VideoQuality {
    doc "The quality tier for streamed video playback (presentation-only: never changes simulation)."
    variant auto "Automatic adaptive selection from decoder capabilities and playback stalls."
    variant high "Source / highest cooked rendition."
    variant medium "720p rendition when cooked, else highest."
    variant low "The 480p rendition (a stream cooked with `lowRendition true`), else the lowest cooked."
  }

  struct VideoBuffering {
    doc "Presentation-only buffering status of active video streams."
    field buffering bool "Whether any active player with `wait` is currently holding the clock for decode or chunk download."
    field progress f32 "0 to 1: download progress of the active stream's next needed chunk (1 when ready)." {
      unit ratio
    }
    field quality VideoQuality "The quality tier currently active for streamed playback."
  }

  struct VideoCapabilities {
    doc "How this host plays streams. Backend limits are reported here, never by missing members: every host loads and plays a stream through the same API."
    field streamed bool "Whether streams decode here: false only on a host without a renderer (a headless run without a GPU), where a stream's texture shows nothing and its sound plays as usual."
    field decoder String "The AV1 decoder: `rav1d` (native, a thread per stream), `webcodecs` (the browser's VideoDecoder), `rav1d-wasm` (rav1d in a Worker of its own, where the browser has no AV1 decoder) or `none`."
    field hardware bool "Whether the browser reports its decoder as hardware-accelerated (WebCodecs' `prefer-hardware` is supported); false for rav1d."
    field maxWidth u32 "The widest stream this decoder plays in real time at 30 fps; wider ones still play, with frames held where decoding falls behind. rav1d-wasm plays a larger stream's 720p rendition, cooked beside it, instead." {
      guide "audio §8"
    }
    field maxHeight u32 "The tallest, as maxWidth."
    field codecs List.String "The codecs streams decode in here, preferred first (`av1`, `hevc`, `h264`; AV1 last where only rav1d-wasm decodes it): a stream plays the first it was cooked in (VideoInfo.codec). Empty where nothing streams." {
      guide "audio §8"
    }
  }

  fn capabilities {
    doc "How streams play on this host: the decoder, whether it is hardware and its largest real-time size."
    param world World "The world asked."
    returns VideoCapabilities
  }

  fn setQuality {
    doc "Presentation-only: choose the quality tier (`auto`, `high`, `medium`, `low`) for streamed videos. Never affects simulation ticks or world hashes."
    param world World "The world."
    param quality VideoQuality "The quality tier."
    returns Result.Void "Refused for an unknown quality tier."
  }

  fn buffering {
    doc "Presentation-only: whether any player with `wait` is currently buffering, its download progress, and the active quality tier."
    param world World "The world."
    returns VideoBuffering
  }

  event MediaIntent {
    doc "A request for a player to change at the next tick boundary, sent through the recorded intent path, so playback stays world state. The og.video system applies it to the entity's og.VideoPlayer and og.AudioSource."
    field player Entity "The entity whose player it asks."
    field playing i32 "1 play, 0 pause, -1 as it is." {
      default -1
      min -1
      max 1
    }
    field seek f64 "Seconds to seek a video to; negative: no seek." {
      default -1
    }
    field gain f32 "Its sound's volume (0 while muted); negative: as it is." {
      default -1
    }
    field repeat i32 "1 loop, 0 not, -1 as it is." {
      default -1
      min -1
      max 1
    }
  }

  component VideoPlayer {
    doc "Plays a loaded video: its texture shows its current frame (frame n is the source at n / fps seconds; a stream's once decoded), and when the entity has an og.AudioSource the og.video system sets its sound, playing, pitch, loop and loop region each tick so the sound plays in step; a seek or a restart starts the sound again at the new time on the next tick. Each player has a texture of its own (written to `texture`): the first takes VideoInfo.texture, each further one its own over the same decoded frames."
    guide "audio §8"
    aliases "movie, video, cinematic, FMV, intro video, Unity VideoPlayer, Godot VideoStreamPlayer"
    field video Video "The video (og.load.video's `video`); 0 plays nothing."
    field playing bool "Whether time advances." {
      default true
    }
    field time f64 "Seconds into the video; written every tick, set it to seek. Double precision, as the sound's playhead: summed in f32, an hour at 60 Hz would fall 2.8 s behind its sound." {
      min 0
      unit s
    }
    field speed f32 "The playback rate: 1 as cooked, 0.5 half speed (the sound's pitch follows)." {
      default 1
      min 0
      max 4
      tunable true
    }
    field loop bool "Start again at loopStart past loopEnd (or 0 past the end); otherwise hold the last frame and set finished."
    field loopStart f64 "With `loop`: where the loop wraps back to, in seconds (0: the start)." {
      min 0
      unit s
    }
    field loopEnd f64 "With `loop`: where the loop wraps, in seconds (0: the video's end)." {
      min 0
      unit s
    }
    field wait bool "A stream on the web: while this player plays and its frame is not decoded yet, the engine's clock holds, so picture and sound never part (the world ticks later). Off: the clock runs on and the last frame stays. Not for a lockstep game." {
      guide "audio §8"
    }
    field frame u32 "Written: the frame shown, floor(time * fps)." {
      readonly true
    }
    field finished bool "Written: a player without loop reached the end." {
      readonly true
    }
    field texture Texture "Written: this player's texture (VideoInfo.texture for the video's first player, a texture of its own for each further one), for a material, sprite or UI image set up from the player. It keeps it while it lives." {
      readonly true
    }
  }
}

