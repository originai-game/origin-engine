module transform {
  doc "Transforms in the three.js vocabulary: position, quaternion and scale, composed into matrixWorld down the parent chain."
  core Transform MatrixWorld lookAt fromAxisAngle

  component Transform {
    doc "Where an entity is, relative to its parent (or the world)."
    field position Vector3 "The position, as three.js Object3D.position." {
      worldspace root
      unit m
    }
    field quaternion Quaternion "The rotation, as three.js Object3D.quaternion."
    field scale Vector3 "The scale, as three.js Object3D.scale." {
      default 1 1 1
    }
  }

  component Parent {
    doc "The entity this one's Transform is relative to. Set by SpawnDesc.parent."
    field entity Entity "The parent."
  }

  component MatrixWorld {
    doc "The world matrix the engine composes after the systems run, as three.js Object3D.matrixWorld."
    field matrix Matrix4 "The composed world matrix." {
      readonly true
    }
  }

  component Volume {
    aliases "zone shape, region bounds, the box or sphere a zone covers, area an effect applies in, size of a zone, soft edge of a zone, area of effect"
    doc "The shape of a region of the world: a box along the entity's axes, or a sphere about it, with a fade past its surface. A region component on the same entity takes its extent from it: og.ReverbZone (where the room is heard), og.StreamCell (the box its anchors approach), og.ForceField, og.FogVolume, og.ReflectionProbe and og.LightVolume. So every region is placed, turned, scaled and faded the same way, and one entity can be several regions of one shape. Alone it does nothing."
    field size Vector3 "The box's full size along the entity's axes, centred on it (times og.Transform.scale)." {
      default 1 1 1
      unit m
    }
    field radius f32 "A sphere of this radius about the entity instead of the box (times the largest of og.Transform.scale); 0 uses the box." {
      min 0
      unit m
      tunable true
    }
    field fade f32 "How far past the surface the region fades out, linearly; 0 is a hard edge." {
      min 0
      unit m
      tunable true
    }
  }

  enum WorldOriginPlane {
    doc "The axes og.WorldOrigin moves the world's zero along."
    variant xz "x and z: the ground plane of a 3D world (heights stay absolute)."
    variant xyz "x, y and z: a world that is also deep or high (space, flight)."
    variant xy "x and y: a 2D world (its z, the drawing order, stays)."
  }

  column WorldOriginPlane {
    doc "A WorldOriginPlane field: the variant's index."
    array Uint32Array
    stride 1
    value WorldOriginPlane
  }

  resource WorldOrigin {
    doc "Large worlds: naming it keeps every place near the zero. As a tick starts, before any system, a focus over `step` from the zero along a plane axis shifts the world by the multiple of `step` nearest it: every root Transform and every `worldspace` field (bodies with contacts and warm starts, paths, particles, tweens, the camera) moves by the same amount, and nothing sees a change but the numbers."
    doc "The shift is world state, decided from world state alone: replays, rollbacks, restores and every og.net peer shift alike, on the same tick. A world that never names it keeps its hash and frames."
    field step f32 "How far the focus may stray from the zero along an axis before the world shifts, and the grid the zero moves on (whole metres)." {
      default 2048
      min 64
      unit m
    }
    field plane WorldOriginPlane "The axes the zero moves along: xz (the default), xyz, or xy for a 2D world."
    field focus Entity "The entity the zero follows (a player, a vehicle; a root). 0: the first og.StreamAnchor by entity id, else og.Camera.position. An og.net session refuses the camera fallback (each peer's camera is its own) and holds the zero until a focus or an anchor exists."
    field off bool "Hold the zero where it is."
    field x f64 "Written: where the zero is in the world along x, kept in f64 (a place's absolute position is its own plus this)." {
      readonly true
      unit m
    }
    field y f64 "Written: where the zero is, along y." {
      readonly true
      unit m
    }
    field z f64 "Written: where the zero is, along z." {
      readonly true
      unit m
    }
    field shifts u32 "Written: how many times the world has shifted." {
      readonly true
    }
  }

  event OriginShifted {
    doc "og.WorldOrigin shifted the world as this tick started, before any system ran: every marked place moved by `delta`. Values a game keeps outside the marked fields (a world position in its own component, a key it set in an og.ai blackboard) are its own: add `delta` to them."
    field delta Vector3 "How far every place moved (a whole multiple of og.WorldOrigin.step along each axis of its plane)." {
      worldspace none
      unit m
    }
    field x f64 "Where the zero is now in the world, along x (og.WorldOrigin.x)." {
      unit m
    }
    field y f64 "Along y." {
      unit m
    }
    field z f64 "Along z." {
      unit m
    }
  }

  fn compose {
    doc "A matrix from position, rotation and scale, as three.js Matrix4.compose."
    param position Vector3 "The translation."
    param quaternion Quaternion "The rotation."
    param scale Vector3 "The scale."
    returns Matrix4
  }

  fn decompose {
    doc "Position, rotation and scale from a matrix, as three.js Matrix4.decompose."
    param matrix Matrix4 "An affine matrix."
    returns Transform
  }

  fn lookAt {
    doc "The rotation that points -Z from an eye towards a target, as three.js Object3D.lookAt for cameras and lights. An object (a character, a vehicle) faces a target with og.transform.face."
    aliases "face, aim at, rotate towards, Unity Transform.LookAt, Godot look_at, three.js lookAt"
    param eye Vector3 "Where the viewer is."
    param target Vector3 "What it looks at."
    param up Vector3 "The up direction; the zero vector means +Y." {
      optional true
    }
    returns Quaternion
  }

  fn face {
    doc "The rotation that turns an object at a position to face a target: its +Z towards it, as three.js Object3D.lookAt for a mesh. A camera or a light uses og.transform.lookAt."
    aliases "turn towards, rotate to face, look rotation, Unity Quaternion.LookRotation"
    guide "facing"
    param position Vector3 "Where the object is."
    param target Vector3 "What it faces."
    param up Vector3 "The up direction; the zero vector means +Y." {
      optional true
    }
    returns Quaternion
  }

  fn forward {
    doc "The way an object with this rotation faces: its local +Z, as a unit vector. A camera's or a light's is og.transform.cameraForward."
    aliases "front, facing direction, heading vector, Unity transform.forward, three.js getWorldDirection"
    guide "facing"
    param quaternion Quaternion "The object's rotation."
    returns Vector3
  }

  fn right {
    doc "An object's right: its local -X, as a unit vector (forward × up). A camera's or a light's is og.transform.cameraRight."
    aliases "strafe direction, side vector, Unity transform.right"
    guide "facing"
    param quaternion Quaternion "The object's rotation."
    returns Vector3
  }

  fn up {
    doc "An object's, a camera's or a light's up: its local +Y, as a unit vector."
    aliases "up vector, Unity transform.up"
    guide "facing"
    param quaternion Quaternion "The rotation."
    returns Vector3
  }

  fn cameraForward {
    doc "The way a camera or a light with this rotation looks: its local -Z, as a unit vector."
    aliases "view direction, look direction, camera front, three.js Camera.getWorldDirection"
    guide "facing"
    param quaternion Quaternion "The camera's or the light's rotation (og.Camera.quaternion)."
    returns Vector3
  }

  fn cameraRight {
    doc "A camera's or a light's right: its local +X, the right of the screen, as a unit vector."
    aliases "screen right, camera strafe direction"
    guide "facing"
    param quaternion Quaternion "The camera's or the light's rotation (og.Camera.quaternion)."
    returns Vector3
  }

  fn heading {
    doc "The heading an object with this rotation faces: the angle about +Y from +Z towards +X of its forward, so 0 faces +Z and half pi faces +X. The heading of a direction is math.atan2(x, z)."
    aliases "yaw, facing angle, compass direction, Unity eulerAngles.y, three.js rotation.y"
    guide "facing"
    param quaternion Quaternion "The object's rotation."
    returns f32 "The heading in radians, from -π to π."
  }

  fn fromHeading {
    doc "The rotation of an upright object facing a heading: a turn about +Y from +Z towards +X, so 0 faces +Z and half pi faces +X."
    aliases "yaw to rotation, rotation from an angle, Unity Quaternion.Euler(0, y, 0), three.js rotation.y"
    guide "facing"
    param heading f32 "The heading in radians."
    returns Quaternion
  }

  fn face2d {
    doc "The rotation that turns a 2D thing at a position to face a target: about +Z, its +X towards it, staying in the xy plane. og.transform.face is the 3D one, and turns a sprite out of the plane."
    aliases "2D look at, rotate a sprite towards, aim in 2D, Unity 2D LookAt, Godot Node2D.look_at"
    guide "facing"
    param position Vector3 "Where the thing is (its xy)."
    param target Vector3 "What it faces (its xy); the same point as the position gives no turn."
    returns Quaternion
  }

  fn forward2d {
    doc "The way a 2D thing with this rotation faces: its local +X, as a unit vector. og.transform.forward is the 3D one (+Z)."
    aliases "2D facing direction, sprite forward, Unity transform.right in 2D, Godot Node2D transform.x"
    guide "facing"
    param quaternion Quaternion "The thing's rotation."
    returns Vector3
  }

  fn heading2d {
    doc "The 2D heading a thing with this rotation faces: the angle about +Z from +X towards +Y of its forward, so 0 faces +X and half pi faces +Y (up). The heading of a direction is math.atan2(y, x)."
    aliases "2D facing angle, sprite rotation angle, Unity eulerAngles.z, Godot Node2D.rotation"
    guide "facing"
    param quaternion Quaternion "The thing's rotation."
    returns f32 "The heading in radians, from -π to π."
  }

  fn fromHeading2d {
    doc "The rotation of a 2D thing facing a heading: a turn about +Z from +X towards +Y, so 0 faces +X and half pi faces +Y (up)."
    aliases "2D angle to rotation, rotate a sprite by an angle, Unity Quaternion.Euler(0, 0, z), Godot Node2D.rotation"
    guide "facing"
    param heading f32 "The 2D heading in radians."
    returns Quaternion
  }

  fn fromAxisAngle {
    doc "A rotation about an axis, as three.js Quaternion.setFromAxisAngle."
    param axis Vector3 "A unit axis."
    param angle f32 "The angle in radians."
    returns Quaternion
  }
}

# ── time ──────────────────────────────────────────────────────────────────

