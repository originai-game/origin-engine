module flow {
  doc "A game's flow as a Yarn dialogue of segments: film, cutscenes, levels and minigames. A node with an `og-flow: <timeline>` header plays that segment on a deck: footage, a live scene (a `scene` track) or both. Its choices open at `flow.open`, lock at `flow.lock` and are taken at the cut (`flow.cut`, else the end), else the `#default`. A playable segment stops at `flow.hold` until og.flow.advance takes a hidden `#outcome:<name>` choice (guide flow)."
  doc "og.flow moves the conversation between segments and prepares those it may lead to on its other decks (og.Timeline.preroll). All of it is world state."
  guide "flow"
  split story video timeline

  struct FlowStartDesc {
    doc "A flow to start."
    desc true
    field dialogue String "The dialogue (StoryAsset.name), loaded with og.story.load and og.flow.load."
    field node String "The node to start at (empty: the dialogue's start)."
    field decks u32 "Decks to play on, 1 to 3 (0: 3). One plays; the others warm what the flow may cut to. 1 warms nothing (one decoder: WeChat on iOS)." {
      max 3
    }
    field paused bool "Start holding the first segment's first frame, warmed, until og.flow.play (a title screen before the first gesture)."
  }

  struct FlowInfo {
    doc "What og.flow.load prepared."
    field dialogue String "The dialogue."
    field segments List.String "Its flow nodes (those with `og-flow`), in file order."
    field chapters List.String "Its chapters' i18n keys (`og-flow-chapter`), in file order."
    field endings List.String "Its endings (`og-flow-ending`), in file order."
  }

  component Flow {
    doc "A flow og.flow.start made: the conversation it paces and its decks. og.flow writes it; read og.flow.view."
    field conversation u32 "Its og.story conversation." {
      readonly true
    }
    field decks u32 "Its decks." {
      readonly true
    }
    field current Entity "The deck playing now (an og.FlowDeck)." {
      readonly true
    }
    field node u32 "The flow node playing, as its id (a hash of its title; og.flow.view names it); 0 before the first." {
      readonly true
    }
    field pending i32 "The choice taken in the window (ChoiceView.index); -1: none yet." {
      default -1
      readonly true
    }
    field window u32 "0 closed, 1 open (choices shown), 2 locked (past flow.lock: the cut takes pending, else the default)." {
      readonly true
    }
    field paused bool "Held by og.flow.pause (or FlowStartDesc.paused) until og.flow.play." {
      readonly true
    }
    field chapter u32 "The node of the last chapter entered (its id, as `node`); 0: none." {
      readonly true
    }
    field ended bool "The last segment played to its cut and the conversation ended." {
      readonly true
    }
    field held bool "The segment playing stopped at its `flow.hold` marker: it waits for og.flow.advance (or a choice), its window open without time running out." {
      readonly true
    }
    field previous Entity "The deck dissolving out (`og-flow-dissolve`), playing on under the current one; 0: none." {
      readonly true
    }
    field dissolve u32 "The dissolve's length, ticks." {
      readonly true
    }
    field dissolveLeft u32 "Ticks left of the dissolve; 0: none." {
      readonly true
    }
    field qte List.u32.8 "Per choice (ChoiceView.index, the first 8): a quick-time event's progress this window, ticks held, presses or timing tick." {
      readonly true
    }
    field qteState List.u32.8 "Per choice (first 8): QTE bitflags and sub-step state (fresh-press latch, sequence step, result grade)." {
      readonly true
    }
    field speed f32 "Playback speed set by og.flow.setSpeed (1: normal)." {
      default 1
      min 0.25
      max 4
      readonly true
    }
    field looping bool "True while holding inside the segment's `flow.loopStart`..`flow.loopEnd` idle loop." {
      readonly true
    }
  }

  component FlowDeck {
    doc "An entity og.flow plays segments on, with an og.Timeline, an og.VideoPlayer (its `wait` set) and an og.AudioSource. The flow's current deck plays; the others hold a segment it may cut to, paused at its first frame."
    field flow Entity "Its flow." {
      readonly true
    }
    field node u32 "The flow node whose segment it holds (its id, as og.Flow.node); 0: none." {
      readonly true
    }
  }

  struct WindowView {
    doc "A segment's choice window."
    field ticksLeft u32 "Ticks until it locks (flow.lock)."
    field ticksTotal u32 "Ticks from flow.open to flow.lock."
    field defaultChoice u32 "The ChoiceView.index taken when nothing was chosen (`#default`, else the first enabled)."
    field pending Option.u32 "The choice taken so far."
    field locked bool "Past flow.lock: choosing is over; the cut takes pending, else the default."
    field held bool "The segment holds (flow.hold) or loops (flow.loopStart..flow.loopEnd): the window never locks, and a choice cuts at once (or breaks the loop)."
  }

  struct FlowHotspot {
    doc "A place on the picture: either a choice (`#hotspot:<id>` on the choice, a `track hotspot` key in its segment) while the window is open, or a non-cutting `inspect` hotspot (triggered with og.flow.inspect)."
    field choice Option.u32 "The ChoiceView.index it takes; null for an `inspect` hotspot, which does not cut."
    field id String "The hotspot's id."
    field kind String "`choice` (takes a choice) or `inspect` (non-cutting investigation point, fires og.FlowInspected)."
    field shape String "`rect` or `circle`."
    field x f32 "Its left edge, a fraction of the video frame from its left." {
      unit ratio
    }
    field y f32 "Its top edge, from the frame's top." {
      unit ratio
    }
    field width f32 "Its width, a fraction of the frame's." {
      unit ratio
    }
    field height f32 "Its height." {
      unit ratio
    }
    field label String "Its localized label (from the hotspot key's `label` i18n key, or the choice's text)."
    field inspected bool "Whether this `inspect` hotspot has already been triggered in this segment."
  }

  struct QteView {
    doc "A choice taken by a quick-time event (`#qte:press:<action>`, `#qte:hold:<action>:<ms>`, `#qte:mash:<action>:<presses>`, `#qte:timing:<action>:<start>-<end>`, `#qte:sequence:<a1>+<a2>+...`, `#qte:swipe:<dir>`, `#qte:drag:<dir>`)."
    field choice u32 "The ChoiceView.index it takes."
    field kind String "press, hold, mash, timing, sequence, swipe or drag."
    field action String "The og.input action it reads (or the current step's action for `sequence`; empty for `swipe`/`drag`)."
    field direction String "Direction for `swipe` or `drag` (`up`, `down`, `left`, `right`); empty otherwise."
    field progress f32 "0 to 1: the hold's time, presses, timing cursor, sequence steps or drag progress." {
      unit ratio
    }
    field zoneStart f32 "For `timing`: start of the target zone (0 to 1)." {
      unit ratio
    }
    field zoneEnd f32 "For `timing`: end of the target zone (0 to 1)." {
      unit ratio
    }
    field grade String "Resolved result grade: `perfect`, `good`, `miss`, or empty while active."
    field done bool "Reached: the choice is pending (or resolved with a grade)."
  }

  struct FlowView {
    doc "What a flow shows now."
    field flow Entity "The flow."
    field node String "The flow node playing."
    field segment String "Its segment's asset id."
    field texture Texture "The current deck's picture (its og.VideoPlayer.texture): put it on a full-screen sprite or image. 0 while its footage plays under the scene (a video track's `layer under`), which og.Camera.backgroundTexture shows."
    field time f32 "Seconds into the segment." {
      unit s
    }
    field cut f32 "When it cuts to the next: its flow.cut marker, else its duration." {
      unit s
    }
    field speed f32 "Current playback speed (og.flow.setSpeed)."
    field videoWidth u32 "Current segment's video frame width in texels (0 for a live-only segment), for aspect-exact hotspot mapping."
    field videoHeight u32 "Current segment's video frame height in texels (0 for a live-only segment)."
    field choices List.ChoiceView "The node's choices while its window is open or locked (og.story's), without its `#outcome` choices, which the game takes."
    field window Option.WindowView "The window, while it is open or locked."
    field hotspots List.FlowHotspot "The hotspots active now: enabled choices' hotspots while the window is open, plus active `inspect` hotspots."
    field qtes List.QteView "The quick-time events of its enabled choices while the window is open or locked."
    field previous Texture "The picture dissolving out (`og-flow-dissolve`); 0: none. Draw it under `texture`, which shows at `mix`."
    field mix f32 "How far the dissolve is: `texture`'s opacity over `previous`, 1 without one." {
      unit ratio
    }
    field paused bool "Held by og.flow.pause."
    field held bool "Stopped at its flow.hold, waiting for og.flow.advance (og.Flow.held)."
    field looping bool "Looping inside the segment's `flow.loopStart`..`flow.loopEnd` idle loop."
    field buffering bool "Presentation-only: whether the current deck is waiting on stream download or decode."
    field bufferProgress f32 "Presentation-only: 0 to 1 download progress for the current stream's next needed chunk." {
      unit ratio
    }
    field chapter String "The last chapter entered."
    field ending String "The ending reached, once ended."
    field ended bool "It played to its end."
  }

  struct FlowTranscriptLine {
    doc "One entry in a flow's transcript backlog (og.flow.history): a caption shown or a choice taken."
    field seq u32 "Monotonic sequence number within the flow."
    field node String "The flow node where it occurred."
    field speaker String "The speaker name, if any."
    field text String "The caption text or chosen option text."
    field spans List.TextSpan "Inline style spans over `text`."
    field chosen bool "True for a choice the player took; false for a spoken caption."
  }

  struct FlowGestureDesc {
    doc "A deterministic touch or pointer gesture fed into active swipe/drag QTEs (og.flow.gesture)."
    desc true
    field kind String "`swipe` or `drag`."
    field direction String "`up`, `down`, `left`, or `right`."
    field progress f32 "For `drag`: 0 to 1 completion progress (1 completes); ignored for `swipe`." {
      unit ratio
    }
  }

  struct FlowMusicDesc {
    doc "Persistent cross-segment background music (og.flow.setMusic or `og-flow-music` header)."
    desc true
    field sound String "The sound asset id to play across segments; empty stops persistent flow music."
    field volume f32 "Target linear volume (0 to 2)." {
      default 1
      min 0
      max 2
    }
    field fade f32 "Crossfade duration in seconds." {
      default 0.5
      min 0
      unit s
    }
    field duck f32 "Volume multiplier while a segment plays video audio (0 to 1; 1 disables ducking)." {
      default 0.4
      min 0
      max 1
    }
  }

  struct FlowCheckpoint {
    doc "A lightweight branch-rewind checkpoint: the dialogue, node and story variables (og.flow.checkpoint / og.flow.jump)."
    field dialogue String "The dialogue name."
    field node String "The flow node to resume at."
    field vars Json "Snapshot of story variables at this node."
  }

  struct FlowJumpDesc {
    doc "Jump a running flow to another node, optionally restoring story variables from a FlowCheckpoint (og.flow.jump)."
    desc true
    field node String "The flow node title to jump to."
    field vars Json "Optional story variables to apply before entering `node` (null/omitted keeps current variables)."
  }

  struct FlowChartNode {
    doc "A flow node on og.flow.chart's layout."
    field node String "Its title."
    field title String "Its display title: `og-flow-title` translated when a string table has it, else as written; `node` without one."
    field segment String "Its segment's asset id."
    field poster Texture "Its segment's first video's poster texture handle (0 for live-only segments)."
    field kind String "`footage`, `live`, or `both`."
    field chapter String "Its `og-flow-chapter`, if any."
    field ending String "Its `og-flow-ending`, if any."
    field depth u32 "Its column: the fewest flow nodes from the start before it (unreached nodes after the deepest)."
    field x f32 "Its centre across, graph units (NodeGraph's)."
    field y f32 "Its centre down."
  }

  struct FlowChartLink {
    doc "Where a flow node may lead, through logic nodes."
    field from String "The node."
    field to String "The flow node it may lead to."
    field choice Option.u32 "The ChoiceView.index that leads there; null for a node without choices."
    field label String "The choice's i18n text key, or empty."
    field outcome String "The `#outcome` name if this link is an outcome, else empty."
    field conditional bool "True when reaching `to` passes through a Yarn condition or multiple targets."
    field points List.f32 "A curve from one to the other as x, y pairs in graph units: a cubic leaving and arriving level, sampled in 16 segments (NodeGraph's link `points`)."
  }

  struct FlowChart {
    doc "A dialogue's flow nodes laid out as a flowchart, columns by depth from the start with barycenter crossing minimisation: what a flowchart screen draws (the built-in NodeGraph), the game marking what the player has seen."
    field nodes List.FlowChartNode "Its flow nodes, in file order."
    field links List.FlowChartLink "Where each leads."
    field width f32 "Its extent across, graph units (NodeGraph's view is `[0, 0, width, height]`)."
    field height f32 "Its extent down."
  }

  event FlowSegment {
    doc "A flow began a node's segment."
    field flow Entity "The flow."
    field node String "The node (at most 63 bytes)."
    field segment String "Its segment's asset id (at most 63 bytes)."
  }

  event FlowChoice {
    doc "A flow took a choice at its cut (before og.story ran it)."
    field flow Entity "The flow."
    field node String "The node (at most 63 bytes)."
    field index u32 "The ChoiceView.index taken."
    field timedOut bool "Nothing was chosen in the window: the default was taken."
  }

  event FlowChapter {
    doc "A flow entered a chapter's node (`og-flow-chapter`): a place to save."
    field flow Entity "The flow."
    field node String "The node (at most 63 bytes)."
    field chapter String "The chapter's i18n key (at most 63 bytes)."
  }

  event FlowEnded {
    doc "A flow's last segment reached its cut with the conversation ended."
    field flow Entity "The flow."
    field node String "The last node (at most 63 bytes)."
    field ending String "Its `og-flow-ending`, empty without one (at most 63 bytes)."
  }

  event FlowInspected {
    doc "An `inspect` hotspot was triggered without cutting (og.flow.inspect)."
    field flow Entity "The flow."
    field node String "The node (at most 63 bytes)."
    field hotspot String "The hotspot's id (at most 63 bytes)."
  }

  event FlowQteResult {
    doc "A quick-time event resolved with a grade (`perfect`, `good`, or `miss`)."
    field flow Entity "The flow."
    field node String "The node (at most 63 bytes)."
    field choice u32 "The ChoiceView.index."
    field grade String "`perfect`, `good`, or `miss` (at most 63 bytes)."
  }

  fn load {
    doc "Prepare a loaded dialogue's flow: every segment's timeline (and through it every video, which fetches nothing until it plays) and og.flow's records. Call it in setup, after og.story.load, in every process that restores a flow."
    param world World "The world."
    param dialogue String "The dialogue (StoryAsset.name)."
    returns Result.FlowInfo "Refused for a dialogue not loaded, a segment that is not a cooked timeline with footage or a scene, or a node's `#outcome` choices without a `flow.hold`."
  }

  fn start {
    doc "Start a flow: its decks, and its conversation held at the first flow node, whose segment plays from the next tick. Outside a system (setup or a command)."
    param world World "The world."
    param desc FlowStartDesc "The dialogue, and optionally the node, the decks and whether it starts paused."
    returns Result.Entity "The flow's entity (og.Flow), or why not: a dialogue og.flow.load has not prepared, an unknown node, or inside a system."
  }

  fn current {
    doc "The flow project.ogt's `flow` line started before GameDesc.start (the engine loads its dialogue, prepares it and starts it, and its FlowScreen draws it unless the line's block says `screen game`): what a playable segment's game passes to og.flow.advance."
    aliases "the game's flow, main flow, declared flow, story flow entity"
    param world World "The world."
    returns Option.Entity "Null without a `flow` line, or once og.flow.stop ended it."
  }

  fn view {
    doc "What a flow shows now: its picture, segment time, choices and window."
    param world World "The world."
    param flow Entity "The flow."
    returns Option.FlowView "Null for an entity that is no flow."
  }

  fn choose {
    doc "Take a choice while the window is open: recorded now (FlowView.window.pending; a later call replaces it) and taken at the cut (or immediately when tagged `#immediate`, held, or in a choice loop). Systems may call it; og.flow applies it this tick."
    param world World "The world."
    param flow Entity "The flow."
    param index u32 "ChoiceView.index."
    returns Result.Void "Refused outside an open window, or for a choice that is hidden, disabled or an `#outcome`."
  }

  fn advance {
    doc "End the segment playing now, as its cut would: with `outcome`, the node's `#outcome:<name>` choice; without, the choice taken in the window, else the default (or its own way on, for a node without choices). What a playable segment's game calls when the level is won or lost; it stops at its `flow.hold` until then. Systems may call it; og.flow cuts this tick."
    aliases "level complete, finish level, next segment, continue the story, Unreal Level Sequence end, Telltale playable section"
    param world World "The world."
    param flow Entity "The flow."
    param outcome String "The `#outcome` to take, such as `won`; omitted for a node without outcomes." {
      optional true
    }
    returns Result.Void "Refused for an entity that is no flow, one that has ended, an outcome its node has not, or none for a node that ends only by its outcomes."
  }

  fn play {
    doc "Play a paused flow from where it is. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    returns Result.Void "Refused for an entity that is no flow."
  }

  fn pause {
    doc "Hold a flow on its frame (a pause menu); its window's time holds too. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    returns Result.Void "Refused for an entity that is no flow."
  }

  fn setSpeed {
    doc "Set playback speed (0.25 to 4.0) for the flow's active segment (fast-forward / slow-motion). Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param speed f32 "Playback speed multiplier (0.25 to 4.0)."
    returns Result.Void "Refused for an entity that is no flow, or a speed outside 0.25 to 4.0."
  }

  fn seek {
    doc "Seek within the current segment (0 to its cut time, e.g., -5s rewind). Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param time f32 "Seconds into the segment, clamped to 0..cut."
    returns Result.Void "Refused for an entity that is no flow, one that has ended, or a non-finite/negative time."
  }

  fn inspect {
    doc "Trigger an active `inspect` hotspot by id without cutting: marks it inspected and sends og.FlowInspected. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param hotspot String "The hotspot's id."
    returns Result.Void "Refused for an entity that is no flow, or an unknown/inactive inspect hotspot."
  }

  fn gesture {
    doc "Feed a deterministic swipe or drag gesture into active QTEs (mobile touch support). Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param desc FlowGestureDesc "The gesture kind (`swipe` or `drag`), direction (`up`, `down`, `left`, `right`) and drag progress."
    returns Result.Void "Refused for an entity that is no flow or an invalid gesture."
  }

  fn setMusic {
    doc "Start, crossfade, or stop persistent cross-segment background music with automatic ducking over segment audio. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param desc FlowMusicDesc "The sound asset id (empty stops), volume, crossfade seconds, and ducking ratio."
    returns Result.Void "Refused for an entity that is no flow."
  }

  fn history {
    doc "Recent captions and player choices recorded by this flow (backlog)."
    param world World "The world."
    param flow Entity "The flow."
    returns List.FlowTranscriptLine "Empty for an entity that is no flow."
  }

  fn checkpoint {
    doc "Capture a lightweight branch-rewind checkpoint: the current dialogue, flow node, and story variables."
    param world World "The world."
    param flow Entity "The flow."
    returns Result.FlowCheckpoint "Refused for an entity that is no flow or has no active node."
  }

  fn jump {
    doc "Jump a running flow directly to another flow node, optionally applying story variables from a FlowCheckpoint. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    param desc FlowJumpDesc "The target node and optional story variables."
    returns Result.Void "Refused for an entity that is no flow or an unknown node."
  }

  fn skip {
    doc "Skip ahead in the segment playing: to its window's open (flow.open) when that is ahead, else to its cut, which takes the pending choice, else the default. For a segment the player has seen; what was seen is the game's (guide flow §5). Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    returns Result.Void "Refused for an entity that is no flow, or one that has ended."
  }

  fn chart {
    doc "A prepared dialogue's flow nodes and where each may lead, laid out for a flowchart."
    param world World "The world."
    param dialogue String "The dialogue (StoryAsset.name), prepared by og.flow.load."
    returns Result.FlowChart "Refused for a dialogue og.flow.load has not prepared."
  }

  fn stop {
    doc "End a flow: its conversation stops and its decks and entity are despawned this tick. Systems may call it."
    param world World "The world."
    param flow Entity "The flow."
    returns Result.Void "Refused for an entity that is no flow."
  }
}
