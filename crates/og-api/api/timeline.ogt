module timeline {
  doc "Timelines: cutscenes and sequences as data, Unity's Timeline and Godot's AnimationPlayer as an `.ogt` the agent reads and diffs. A `type timeline` file has a `duration` in seconds, `path \"<name>\" { ... }` blocks (as og.path's) and `track <kind> [\"<entity>\"] { key <seconds> { ... } }` blocks; `og cook` cooks it (importing caption files) and og.load.timeline loads it. Tracks: `camera` (position and target keys, or `rail \"<path>\"` with `at` 0..1 along it, or `follow \"<entity>\"` with offsets; fov; eased), `transform \"<entity>\"` (position, rotation in degrees or quaternion, scale; eased), `animation \"<entity>\"` (clip, speed, blendIn, loop; `model` names the glTF whose clips they are, else the entity's og.Model), `audio` (sound, volume, playbackRate, bus), `music` (sound, volume, fadeIn, fadeOut, end, loop, bus), `caption` (text from `key` to `end` with a UI type step `style` and an `anchor`; `captions \"narration.srt\" [offset]` imports a SubRip file or word timestamps `.json`), `event` (`do \"<command-channel action>\"`: teleport, set, a game's registered command; `retroactive true` runs it when a seek passes it), `transition` (kind cut, fade, wipe, dissolve, iris or slide; mode through, in or out; duration, color, from, over og.ui's screen cover) `marker` (`name`, sending og.TimelineMarker when played past), `property [\"<entity>\"]` (`field \"og.PointLight.distance\"`, keys of `value`: any reflected field of a component on the entity, or of a resource without one), `light \"<entity>\"` (its og.DirectionalLight, og.PointLight, og.SpotLight, og.RectLight or og.Light2D: color, intensity, distance, angle, ...), `visibility \"<entity>\"` (`visible true|false` of whatever it draws, stepped), `post` (og.PostEffects' fields), `blendshape \"<entity>\"` (og.Blendshapes w0 to w7; its source becomes component), `material \"<entity>\"` (its og.Mesh's material, or its og.Model's material `index N`: StandardMaterialDesc fields by name, other names the material shader's parameters) and `timeline` (`play \"<timeline>\"`, speed, loop: from its key until the next, another timeline plays nested at (time − key) × speed, its markers sent as `<file>/<marker>`, at most four deep) and `shot` (`camera \"<entity>\"`, a virtual camera's name, or `none`; `blend` seconds and `ease`: from its key until the next, that og.VirtualCamera is og.CameraBrain.solo, blended to over the key's blend by its ease or by the camera's own; `none` and the timeline's end hand back the solo it found). Camera keys also take `roll` (degrees about the view direction), `focus` (a distance) or `focusOn \"<entity>\"` and `focusRange`, which set og.PostEffects' depth of field while the track owns the camera. The cook checks every field against the engine's records (a field the record lacks, one a timeline cannot drive, a value of the wrong shape) and refuses nesting in a cycle or deeper than four; a track kind this engine does not read is refused naming it and the engine's version."
  doc "Between two keys that set a value the later key's `ease` (og.tween's Ease names, linear when it gives none) mixes them; before the first and after the last the value is held. Every value is evaluated at the timeline's time, never accumulated over ticks, and that time is kept exactly (in steps of a thousandth of a tick), so seeking to a time and playing to it give the same world: a seek is how a video render starts at any frame."
  doc "An og.Timeline component plays one on its entity, run by the engine's og.timeline system after the game's systems (and tweens) and before og.anim and physics, so what it sets is what animation, physics and the frame see that tick. While one with a camera track plays (or is paused) it owns og.Camera, and hands back the camera it found when it stops or ends. Its event keys' actions run at the start of the next tick, as og.ai's commands do. Loading a timeline (og.load.timeline, outside a system) grants og.timeline the records its tracks write; values they wrote stay when it stops, while the camera, its depth of field and the materials go back. A material track is presentation, not world state: it is applied every frame from the timeline's time, so a restored save draws the right material on its next frame. The command channel plays them too: `timeline:play:<name>` (`timelines/<name>.ogt`, or an asset id), `timeline:seek:<seconds>[:<name>]`, `timeline:pause[:<name>]`, `timeline:resume[:<name>]`, `timeline:stop[:<name>]`."

  handle TimelineAsset "A loaded timeline: its tracks, paths, sounds and clips."

  column TimelineAsset {
    doc "A TimelineAsset handle field (0 is none)."
    array Uint32Array
    stride 2
    value TimelineAsset
  }

  component Timeline {
    doc "Plays a loaded timeline. Set `playing` (or call og.timeline.play) to run it from `time`; write `time` (or call og.timeline.seek) to jump; og.timeline.stop goes back to 0 and lets go of what it owns."
    field asset TimelineAsset "The timeline (og.load.timeline); 0 plays nothing."
    field playing bool "Advances while true."
    field time f32 "Where it is, in seconds; written every tick it plays, set it to seek." {
      min 0
      unit s
    }
    field speed f32 "Playback rate: 1 as authored, 0.5 half speed (0 holds the time while playing)." {
      default 1
      min 0
      max 16
      tunable true
    }
    field loop bool "Start over at the end; otherwise stop playing there, hand the camera back and send og.TimelineEnded."
  }

  event TimelineStarted {
    doc "A timeline started playing from stopped or ended (not on a resume from pause, nor on a loop)."
    field entity Entity "The og.Timeline's entity."
    field asset TimelineAsset "The timeline."
  }

  event TimelineMarker {
    doc "Playback passed a marker key (a seek over one does not send it)."
    aliases "cutscene event, cue, Unity Timeline signal, Unreal Sequencer event track, AnimationPlayer method track"
    field entity Entity "The og.Timeline's entity."
    field asset TimelineAsset "The timeline."
    field name String "The marker's name (at most 63 bytes)."
    field time f32 "The marker's time." {
      unit s
    }
  }

  event TimelineEnded {
    doc "A timeline without loop reached its duration and stopped playing."
    field entity Entity "The og.Timeline's entity."
    field asset TimelineAsset "The timeline."
  }

  struct TimelineTrackInfo {
    doc "One track of a loaded timeline."
    field kind String "camera, transform, animation, audio, music, caption, event, transition, marker, property, light, visibility, post, blendshape, material, timeline or shot."
    field target String "The entity a transform, animation, property, light, visibility, blendshape or material track drives, the path a rail rides, the entity a camera follows; empty otherwise."
    field keys u32 "Its keys."
  }

  struct TimelineInfo {
    doc "A loaded timeline."
    field asset TimelineAsset "Its handle."
    field name String "Its `name`."
    field duration f32 "Its length." {
      unit s
    }
    field tracks List.TimelineTrackInfo "Its tracks, in file order."
    field paths List.String "The paths it declares."
    field markers List.String "Its markers' names, in time order."
  }

  fn info {
    doc "What a loaded timeline holds."
    param world World "The world."
    param asset TimelineAsset "The timeline."
    returns Result.TimelineInfo "Refused for a timeline not loaded in this world."
  }

  fn play {
    doc "Play the entity's og.Timeline from its time (0 after a stop or an end); systems may call it, it takes effect at this tick's og.timeline."
    aliases "play cutscene, start sequence, cinematic, Unity PlayableDirector.Play, Unreal Sequencer play, Godot AnimationPlayer.play"
    param world World "The world."
    param entity Entity "The entity with the og.Timeline."
    returns Result.Void "Refused for an entity without og.Timeline, or one whose asset is not loaded."
  }

  fn pause {
    doc "Hold the entity's og.Timeline where it is (it keeps the camera)."
    param world World "The world."
    param entity Entity "The entity with the og.Timeline."
    returns Result.Void "Refused for an entity without og.Timeline."
  }

  fn seek {
    doc "Jump to a time: this tick evaluates every track there exactly as playing to it would, without sending the markers or running the events passed (except `retroactive` ones)."
    param world World "The world."
    param entity Entity "The entity with the og.Timeline."
    param time f32 "Seconds, 0 to the duration."
    returns Result.Void "Refused for an entity without og.Timeline or a time outside 0 to its duration."
  }

  fn stop {
    doc "Stop at 0: the camera is handed back, its sounds and music stop, its caption and cover go."
    aliases "stop cutscene, end sequence, skip cutscene"
    param world World "The world."
    param entity Entity "The entity with the og.Timeline."
    returns Result.Void "Refused for an entity without og.Timeline."
  }
}

# ── net ───────────────────────────────────────────────────────────────────

