    field max Option.f32 "The most; null is unbounded."
    field step f32 "What each press adds or takes." {
      default 1
    }
    field largeStep f32 "What a held press's repeats move by after a second; 0 is ten steps."
    field label String "Its name, before it in its row; empty for none."
    field format ValueFormat "How its value reads."
    field wrap bool "Past max it goes to min and back (needs both)."
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null fits."
  }

  struct NumberResult {
    doc "A stepper's value after this tick."
    field value f32 "The value, to keep and pass back."
    field changed bool "It changed this tick."
  }

  fn numberStepper {
    doc "A number stepper: minus, the value and plus. A press steps once, a held press repeats after 400 ms and speeds up (large steps after a second); Left and Right step it while the value has the focus. A bound's button goes disabled at the bound. Plays sliderTick per step. Parts: `Stepper.frame[focused|disabled]`, `Stepper.button[dec|inc][hover|pressed|disabled]`, `Stepper.value`. Its label and the buttons share a line while they fit, the buttons go under the label when they do not (larger text, a narrow column). Role spinbutton with its range; its − and + are buttons under a finger (stops keys and pads reach too) and named images on a fine pointer (Left and Right on the focused stepper are theirs). Probe: `<id>/Frame/Dec`, `<id>/Frame/Value`, `<id>/Frame/Inc`."
    aliases "stepper, spinbox, number input, Godot SpinBox"
    param id String "Its id."
    param value f32 "The value from game state."
    param desc NumberStepperDesc "Its range, step and look."
    returns NumberResult
  }

  struct CyclerDesc {
    doc "An option cycler: a setting's levels in one row."
    desc true
    field label String "Its name, before it; empty for none."
    field wrap bool "Past the last it goes to the first." {
      default true
    }
    field pips bool "A pip per option under the value, the current lit." {
      default true
    }
    field disabled bool "Shown but inert."
    field width Option.Size "Its width; null grows."
    field valueWidth Option.f32 "The value's width; null fits the longest option (so the arrows never move)." {
      unit cssPx
    }
  }

  fn cycler {
    doc "An option cycler, the console settings row: `‹ High ›` with pips. Left and Right (a pad's d-pad or stick) change it while it has the focus, the arrows take a press, and a press on the value steps forward; the value slides in from the side it came (selection on the style's motion). Arrows follow the writing direction. Plays select. Parts: `Cycler.frame[hover|focused|disabled]`, `Cycler.arrow[prev|next][disabled]`, `Cycler.pip[current]`. Role spinbutton reading the option; its arrows are buttons under a finger and named images on a fine pointer (Left and Right on the focused cycler are theirs). Probe: `<id>`, `<id>/Prev`, `<id>/Middle/Clip/Value#i` (the option shown), `<id>/Next`, `<id>/Middle/Pips/Pip#i`."
    host false
    param id String "Its id."
    param options List.String "The options."
    param index i32 "The current one from game state."
