module vfx {
  doc "Composed effects: one effect (a fireball's impact, a heal, a level-up) as a timeline of elements in an `.ogt` of `type vfx`, Effekseer's and Niagara's systems as text the agent reads and diffs. A file has `duration <seconds>`, `loop true|false`, `event <seconds> \"<name>\"` and `impact <seconds>` (`event <seconds> \"impact\"`, at most one; the same four lines mean the same in a `type vfx2d` pixel effect), and element blocks, each with `at <seconds>` from the effect's start, `offset <x> <y> <z>` and `rotate <x> <y> <z>` (degrees) in the effect's space, and `life <seconds>` or `until <seconds>` for those that last: `emitter \"<id>\"` (an og.load.emitter asset; `until` stops its emission and its particles live out; `seed`), `mesh sphere | quad | ring | box | cylinder | \"<model id>\"` (drawn with `effect \"<id>\"`, an effect material: `scale`, a value over its life, `spin` degrees per second, `color`, `blend additive | alpha`; a `ring` takes its own shape with any of `inner <radius>` (outer 1), `band <0..1>` (its middle row), `height <outer> <inner>` (its edges raised along its axis: a cone, a tube), `arc <start> <length>` (degrees from +x), `segments <n>` and `colors <outer rgba> <band rgba> <inner rgba>`, its u then along the arc and v from the outer edge to the inner, built at load), `trail` (`effect`, `width <head> <tail>`, `lifetime`, `color`, `orbit <radius> <turns per second>` and `rise <metres per second>` about and up the element's y), `beam` (`to <x> <y> <z>` from the element, `width`, `effect`, `segments`, `jitter`, `color`), `light` (a point light: `color`, `intensity` a value over its life, `distance`), `decal` (projected down the element's -y: `uv <u0> <v0> <u1> <v1>`, its region of og.RenderSettings.decalAtlas, `size <x> <y> <z>` with y the depth it reaches, `fade <seconds>` at its end, `color`), `flash` (a soft glow facing the eye: `size` a value over its life, `color`), `shake` (`trauma`, og.camera.shake), `flipbook \"<id>\"` (a pixel effect, an `.ogt` of `type vfx2d`, or any og.load.flipbook sheet: a camera-facing og.Sprite with og.Flipbook playing its first clip, `size` its height with the width by the frame's shape, `color`, `blend additive | alpha`, for `life` or its clip's length; its og.FlipbookEvent events, the impact frame among them, reach the game as this effect's og.VfxEvent of the same name) and `sound \"<id>\"` (`volume`, `pitch <min> <max>` picked by the seed; a child entity with og.AudioSource at the element, cut when the effect despawns). A value is a number, `random <min> <max>` (fixed per instance) or `curve <t> <v> ...` over the element's life. `og cook` checks the file and that what it names is in the project."
  doc "An og.Vfx plays one from its startTick at its entity's MatrixWorld, so an effect follows the entity it is spawned on (og.vfx.spawn with a parent) or stays where it was spawned. Its visuals are drawn from (asset, seed, startTick, the tick) alone: the renderer expands its elements every frame and nothing of them is world state, so a replay, a restore or a seek draws the same effect. Its gameplay side runs in the tick, in the engine's og.vfx system (scheduled when a game first names og.Vfx or og.VfxEvent, after the systems defined so far): each `event` line sends an og.VfxEvent on the tick its time lands on (startTick plus its time rounded to ticks; an effect started after og.vfx ran that tick catches up on the next), each `shake` adds its trauma and each `sound` plays, then an effect that has ended and does not loop despawns its entity and its sounds (unless `despawn` is false). Element times run on the tick."

  handle VfxAsset "A loaded composed effect (og.load.vfx): its elements and the emitters, effect materials, meshes, textures and sounds they name."

  column VfxAsset {
    doc "A VfxAsset handle field (0 is none)."
    array Uint32Array
    stride 2
    value VfxAsset
  }

  component Vfx {
    doc "Plays a composed effect at the entity's MatrixWorld from startTick (og.vfx.spawn makes one in a call)."
    field asset VfxAsset "The effect (og.load.vfx); 0 plays nothing."
    field seed u32 "Its random seed: what `random` values, emitters and sound pitches pick (instances with different seeds differ)."
    field startTick u32 "The tick it started: write the tick (`world.tick`) to play it, or to play it again. Its default, never written, waits: an effect spawned ahead of its use plays nothing until a tick is written." {
      default 4294967295
    }
    field scale f32 "Its size: offsets, meshes, trails, beams, lights' reach, decals and flashes scale with it; its emitters are placed and shaped by the scaled transform." {
      default 1
      min 0
    }
    field tint Color "Multiplies the colour of everything it draws (linear; above 1 brightens)." {
      default 1 1 1
    }
    field despawn bool "Despawn the entity on the tick after a non-looping effect ends." {
      default true
    }
    field ran u32 "Written by og.vfx: the last tick it ran this effect through (its events, shakes and sounds up to there are sent). Writing startTick again plays it from the start." {
      default 4294967295
      readonly true
    }
  }

  event VfxEvent {
    doc "A composed effect reached one of its `event` lines (an `impact` line included, named `impact`): the frame a fireball lands, a slash connects, a spell resolves. Read in the tick after, like every event; a replay sends the same."
    field entity Entity "The entity with the og.Vfx."
    field asset VfxAsset "The effect."
    field name String "The event's name (at most 63 bytes)."
    field time f32 "Its time in the effect." {
      unit s
    }
  }

  struct VfxSpawnDesc {
    doc "Where and how og.vfx.spawn plays an effect."
    desc true
    field asset VfxAsset "The effect (og.load.vfx)."
    field position Vector3 "Where: in the world, or in the parent's space with a parent." {
      unit m
    }
    field rotation Quaternion "Its turn, as position."
    field parent Option.Entity "An entity to follow (a sword's tip, a character's chest): the effect's entity becomes its child, so it moves with it and despawns with it."
    field scale f32 "Its size (og.Vfx.scale)." {
      default 1
      min 0
    }
    field tint Color "Its tint (og.Vfx.tint)." {
      default 1 1 1
    }
    field seed u32 "Its seed (og.Vfx.seed); 0 takes one from the new entity's id, so each instance differs and a replay repeats it."
  }

  struct VfxInfo {
    doc "A loaded composed effect."
    field asset VfxAsset "Its handle."
    field duration f32 "Its length." {
      unit s
    }
    field loop bool "Whether it starts over at its end."
    field events List.String "Its events' names in time order, `impact` included."
    field impact f32 "Its impact's time, or -1 without one." {
      unit s
    }
    field elements List.String "Its elements' kinds, in file order (emitter, mesh, trail, beam, light, decal, flash, flipbook, shake, sound)."
  }

  fn spawn {
    doc "Play a composed effect now: a new entity with og.Transform (at the desc's position and rotation, a child of its parent when it has one) and og.Vfx started at this tick (world.tick). A system calling it writes og.Transform, og.Vfx and, with a parent, og.Parent. The entity despawns when the effect ends (og.Vfx.despawn)."
    aliases "play effect, spawn particle effect, play vfx, spawn effect at, Unity Instantiate particle prefab, Unreal SpawnSystemAtLocation, SpawnSystemAttached, Godot GPUParticles3D restart, Effekseer play"
    param world World "The world."
    param desc VfxSpawnDesc "The effect and where."
    returns Result.Entity "Refused for an asset not loaded in this world or a dead parent."
  }

  fn info {
    doc "What a loaded composed effect holds."
    param world World "The world."
    param asset VfxAsset "The effect."
    returns Result.VfxInfo "Refused for an effect not loaded in this world."
  }
}
