  component CharacterController {
    doc "A kinematic character (3D, or top-down 2D): the entity's capsule (or any og.Collider) moved by `move` each tick, sliding along walls, climbing slopes up to `maxSlope` and steps up to `stepHeight`, snapped to the ground, carried by the moving platform it stands on and falling by gravity. It keeps `skin` off every surface. What blocks it is every solid collider its og.Collider's `layers` and `mask` interact with, as for bodies. It needs an og.Transform and an og.Collider; the step makes it a kinematic body that pushes dynamic bodies (`pushBodies`, `pushStrength`)."
    guide "physics §6"
    aliases "player controller, kinematic character, Unity CharacterController, Godot CharacterBody3D"
    field mass f32 "Virtual mass in kg for contact-point pushing and weight. Zero pushes nothing." {
      min 0
      unit kg
    }
    field addVelocity Vector3 "Velocity added once next step, then cleared: knockback or a spring." {
      unit mps
    }
    field rootDelta Vector3 "Animation displacement consumed once by the character sweep, including vertical travel; cleared after the move." {
      unit m
    }
    field up Vector3 "Walking and jumping up axis; normalized when nonzero. Zero derives up opposite Physics.gravity each step; zero world gravity supplies no inferred up."
    field jumpBuffer f32 "Seconds a jump press remains buffered. Zero disables buffering, not rising-edge jumps." {
      min 0
      unit s
    }
    field platformInherit f32 "Share of supporting platform velocity retained on leaving it; zero inherits none." {
      min 0
      max 1
    }
    field buffer f32 "Written: unconsumed jump buffer time." {
      readonly true
    }
    field inheritedVelocity Vector3 "Written: retained inertia from airborne vertical motion, knockback and platforms." {
      readonly true
    }
    field groundBody Entity "Written: supporting collider parent body, including compound platforms." {
      readonly true
    }
    field groundPoint Vector3 "Written: supporting contact point in world space." {
      readonly true
      worldspace world
    }
    field groundPosition Vector3 "Written: supporting frame position at the last controller move." {
      readonly true
      worldspace world
    }
    field groundQuaternion Quaternion "Written: supporting frame rotation at the last controller move." {
      readonly true
    }
    field move Vector3 "Wanted world-space velocity across the ground. The up-axis component is ignored while walking, or used as a swimming stroke with og.Buoyancy. With gravityScale zero or no explicit or gravity-derived up, all components move freely. Set it every tick." {
      unit mps
    }
    field jump bool "Held to jump: a jump starts on the tick it becomes true while grounded (or in coyote time)."
    field jumpSpeed f32 "The upward speed of a jump." {
      default 6
      min 0
      unit mps
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity; 0 for top-down movement in any direction." {
      default 1
      min 0
      max 10
      tunable true
    }
    field maxSlope f32 "The steepest slope it walks up." {
      default 45
      min 0
      max 89
      unit deg
      tunable true
    }
    field stepHeight f32 "The highest step it climbs without jumping: the ground beyond the step at most this over the ground it stands on (0: none)." {
      default 0.3
      min 0
      unit m
      tunable true
    }
    field snapDistance f32 "How far below it the ground still holds it (stairs down, slopes): 0 lets it leave every edge." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field skin f32 "The gap kept between it and every surface." {
      default 0.02
      min 0.001
      unit m
    }
    field coyoteTime f32 "After leaving an edge, a jump still starts within this time." {
      default 0.1
      min 0
      unit s
      tunable true
    }
    field maxFallSpeed f32 "The fastest fall." {
      default 40
      min 0
      unit mps
      tunable true
    }
    field pushBodies bool "Push dynamic bodies it walks into, with at most `pushStrength`." {
      default true
    }
    field pushStrength f32 "Maximum side-push force: contacts share an impulse budget of this times dt, using virtual mass and dynamic contact-point effective mass. Standing weight is applied separately. Zero disables all pushing, as mass zero or pushBodies false does." {
      guide "physics §6"
      default 1000
      min 0
      unit newton
      tunable true
    }
    field waterSpeed f32 "The share of `move` it makes fully under water, with og.Buoyancy beside it: wading and swimming slow it by how much of it is under." {
      guide "physics §8"
      default 0.5
      min 0
      max 1
      unit ratio
      tunable true
    }
    field grounded bool "Written: standing on walkable ground after the step." {
      readonly true
    }
    field sliding bool "Written: sliding down a slope steeper than maxSlope." {
      readonly true
    }
    field velocity Vector3 "Written: the velocity it moved at this tick (the platform's carry included)." {
      unit mps
      readonly true
    }
    field groundNormal Vector3 "Written: the ground's normal (zero in the air)." {
      readonly true
    }
    field coyote f32 "Written: seconds left in which a jump may still start (coyote time)." {
      readonly true
    }
    field jumpWasHeld bool "Written: `jump` as the last step saw it (a jump starts on its rising edge)." {
      readonly true
    }
    field ground Entity "Written: the entity it stands on (0 in the air); a moving one carries it." {
      readonly true
    }
  }

  component PlatformerController {
    doc "A 2D platformer character (the 2D profile): run, jump and fall with designer units (jump height and time to apex, not gravity), coyote time, jump buffering, variable jump height, apex hang, air jumps, wall slide and wall jump, one-way platforms (`oneWayMask`; hold `down` to drop through), moving platforms and corner correction. What blocks it is every solid collider its og.Collider's `layers` and `mask` interact with, as for bodies. It needs an og.Transform and an og.Collider (a box or capsule); it becomes a kinematic body that pushes dynamic bodies (`pushBodies`, `pushStrength`)."
    guide "physics §6"
    field mass f32 "Virtual mass in kg for contact-point pushing and weight. Zero pushes nothing." {
      min 0
      unit kg
    }
    field platformInherit f32 "Share of supporting platform velocity retained on leaving it; zero inherits none." {
      min 0
      max 1
    }
    field wallCoyoteTime f32 "Seconds a wall jump remains available after leaving the wall; zero disables it." {
      min 0
      unit s
    }
    field wallCoyote f32 "Written: wall coyote time remaining." {
      readonly true
    }
    field lastWall i32 "Written: last contacted wall side, for wall coyote time." {
      readonly true
    }
    field groundBody Entity "Written: supporting collider parent body." {
      readonly true
    }
    field groundPoint Vector3 "Written: supporting contact point in world space." {
      readonly true
      worldspace world
    }
    field groundPosition Vector3 "Written: supporting frame position at the last controller move." {
      readonly true
      worldspace world
    }
    field groundQuaternion Quaternion "Written: supporting frame rotation at the last controller move." {
      readonly true
    }
    field droppingThrough Entity "Written: only this one-way entity is ignored until the character bounds clear it; replaces dropTime." {
      readonly true
    }
    field run f32 "The run input, -1 (left) to 1 (right). Set it every tick." {
      min -1
      max 1
    }
    field jump bool "Held to jump: a press is buffered for jumpBuffer; releasing while rising cuts the jump."
    field down bool "Held to drop through a one-way platform."
    field addVelocity Vector2 "A velocity change to take on the next step (a knock-back, a spring, a recoil): added to `velocity`, then set back to zero. One with an upward y leaves the ground; the run's acceleration and gravity act on the result from then on." {
      guide "physics §6"
      unit mps
    }
    field maxSpeed f32 "The top running speed." {
      default 8
      min 0
      unit mps
      tunable true
    }
    field acceleration f32 "How fast it reaches maxSpeed on the ground." {
      default 70
      min 0
      unit mps2
      tunable true
    }
    field deceleration f32 "How fast it stops on the ground without input." {
      default 80
      min 0
      unit mps2
      tunable true
    }
    field airAcceleration f32 "Acceleration in the air." {
      default 45
      min 0
      unit mps2
      tunable true
    }
    field airDeceleration f32 "Deceleration in the air without input." {
      default 25
      min 0
      unit mps2
      tunable true
    }
    field jumpHeight f32 "How high a full jump goes." {
      default 3.2
      min 0
      unit m
      tunable true
    }
    field timeToApex f32 "How long a full jump takes to reach its height (sets gravity and the jump speed)." {
      default 0.4
      min 0.05
      unit s
      tunable true
    }
    field fallGravity f32 "Gravity multiplier while falling (snappier landings above 1)." {
      default 1.8
      min 0
      tunable true
    }
    field jumpCut f32 "Gravity multiplier while rising with jump released (variable jump height; 1 disables it)." {
      default 2.5
      min 1
      tunable true
    }
    field apexGravity f32 "Gravity multiplier near the apex while jump is held (hang time; 1 disables it)." {
      default 0.6
      min 0
      max 1
      tunable true
    }
    field apexThreshold f32 "The vertical speed below which the apex multiplier applies." {
      default 1.5
      min 0
      unit mps
      tunable true
    }
    field maxFallSpeed f32 "The fastest fall." {
      default 20
      min 0
      unit mps
      tunable true
    }
    field coyoteTime f32 "After running off an edge, a jump still starts within this time." {
      default 0.1
      min 0
      unit s
      tunable true
    }
    field jumpBuffer f32 "A jump pressed this long before landing starts on landing." {
      default 0.12
      min 0
      unit s
      tunable true
    }
    field airJumps u32 "Extra jumps in the air (1: a double jump)." {
      min 0
      max 8
    }
    field wallJumps bool "Slide down walls it pushes against (and jump off them)." {
      default true
    }
    field wallSlideSpeed f32 "The fastest slide down a wall." {
      default 3
      min 0
      unit mps
      tunable true
    }
    field wallJump Vector2 "A wall jump's velocity: x away from the wall, y up." {
      default 8 12
      unit mps
      tunable true
    }
    field wallJumpLock f32 "After a wall jump, the run input is ignored for this long (so it leaves the wall)." {
      default 0.14
      min 0
      unit s
      tunable true
    }
    field oneWayMask u32 "The collision layers that are one-way platforms (solid from above only), as bits."
    field cornerCorrection f32 "How far a rising jump that clips a ceiling corner is nudged sideways past it (0: never)." {
      default 0.15
      min 0
      unit m
      tunable true
    }
    field maxSlope f32 "The steepest slope it runs up." {
      default 50
      min 0
      max 89
      unit deg
      tunable true
    }
    field snapDistance f32 "How far below it the ground still holds it (slopes, small drops)." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field skin f32 "The gap kept between it and every surface." {
      default 0.01
      min 0.001
      unit m
    }
    field pushBodies bool "Push dynamic bodies it runs into, with at most `pushStrength`." {
      default true
    }
    field pushStrength f32 "The most force it pushes with: each tick the bodies it runs into share an impulse of at most this times the tick's length (mass times the speed it asks of them, capped). 0 leaves every body where it is, as `pushBodies` false does." {
      guide "physics §6"
      default 1000
      min 0
      unit newton
      tunable true
    }
    field grounded bool "Written: standing on ground after the step." {
      readonly true
    }
    field onWall i32 "Written: -1 sliding on a wall to its left, 1 to its right, 0 none." {
      min -1
      max 1
      readonly true
    }
    field facing i32 "Written: -1 facing left, 1 right (the last run direction)." {
      default 1
      min -1
      max 1
      readonly true
    }
    field velocity Vector3 "Written: the velocity after the step (the platform's carry excluded)." {
      unit mps
      readonly true
    }
    field jumping bool "Written: rising from a jump (until the apex or a release cut)." {
      readonly true
    }
    field airJumpsLeft u32 "Written: air jumps left before landing." {
      readonly true
    }
    field coyote f32 "Written: seconds of coyote time left." {
      readonly true
    }
    field buffer f32 "Written: seconds a buffered jump press stays valid." {
      readonly true
    }
    field wallLock f32 "Written: seconds the run input stays locked after a wall jump." {
      readonly true
    }
    field jumpWasHeld bool "Written: `jump` as the last step saw it." {
      readonly true
    }
    field ground Entity "Written: the entity it stands on (0 in the air); a moving one carries it." {
      readonly true
    }
  }

  const CHARACTER_JUMPED u32 1 "`CharacterEvent.kind`: a jump from the ground (or in coyote time)."
  const CHARACTER_LANDED u32 2 "`CharacterEvent.kind`: touched the ground after being in the air."
  const CHARACTER_WALL_JUMPED u32 3 "`CharacterEvent.kind`: a jump off a wall."
  const CHARACTER_AIR_JUMPED u32 4 "`CharacterEvent.kind`: a jump in the air (PlatformerController.airJumps)."
  const CHARACTER_LEFT_GROUND u32 5 "`CharacterEvent.kind`: left the ground without jumping (ran off an edge)."
  const CHARACTER_BUMPED u32 6 "`CharacterEvent.kind`: hit a ceiling while rising."
  const CHARACTER_CRUSHED u32 7 "`CharacterEvent.kind`: opposing solid surfaces crushed the character."

  event CharacterEvent {
    doc "Something a CharacterController or PlatformerController did this step: the hooks for dust, squash, sounds and camera kicks. Read the next tick: the controllers move in the physics step, after the game's systems, so a jump pressed in tick T moves the character in T and its CHARACTER_JUMPED is read in T + 1."
    field entity Entity "The character."
    field kind u32 "CHARACTER_JUMPED 1, LANDED 2, WALL_JUMPED 3, AIR_JUMPED 4, LEFT_GROUND 5, BUMPED 6, CRUSHED 7." {
      min 0
      max 7
    }
    field speed f32 "The vertical speed at the moment (a landing's impact speed is negative)." {
      unit mps
    }
  }

  fn resizeCharacter {
    doc "Resize a character capsule after checking headroom and the final volume. Keeps its feet fixed by adjusting Collider.offset, preserves body velocity and joints, and returns false without changing anything when blocked. Works in both physics profiles, inside a system or between ticks; inside a system read Transform, Parent and the controller and write Collider."
    guide "physics §6"
    param world World "The world."
    param entity Entity "An entity with CharacterController or PlatformerController and a capsule Collider."
    param height f32 "New cylindrical segment height (as Collider.height), excluding caps; finite and >= 0."
    param radius f32 "New capsule radius; finite and > 0."
    returns Result.bool "True when resized, false when blocked; refused for invalid sizes or a non-capsule/non-controller entity."
  }
