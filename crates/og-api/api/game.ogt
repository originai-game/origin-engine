module game {
  doc "The game entry: what the bundle's default export declares."
  place root
  core game GameDesc

  enum ProjectProfile {
    doc "The normalized startup profile. A 2.5d creation uses 3d."
    variant "3d" "Three-dimensional simulation and rendering."
    variant "2d" "Two-dimensional simulation and rendering."
  }

  enum ProjectFlowScreen {
    doc "Who draws the project's startup dialogue."
    variant engine "The built-in FlowScreen."
    variant game "The game's own UI."
  }

  struct ProjectStartupFlow {
    doc "The dialogue started before GameDesc.start; no source code or pack metadata."
    field dialogue String "The dialogue's physical cooked ID, resolved by og project from its checked project ref."
    field screen ProjectFlowScreen "Who draws the flow; omitted means engine." {
      optional true
    }
  }

  struct ProjectStartup {
    doc "Checked project.ts startup data for CreateOptions.project on both hosts. Not project source text or the full manifest. Omitted simulation fields retain GameDesc defaults; conflicting explicit values refuse creation."
    field tick u32 "Fixed ticks per second, 1 to 240." {
      optional true
      min 1
      max 240
    }
    field seed u32 "The project's deterministic seed; CreateOptions.seed is a separate replay override." {
      optional true
    }
    field scenes Map.String "Startup scene names to physical cooked IDs, resolved by og project from checked project refs; no scene contents or pack assembly." {
      optional true
    }
    field scene String "Initial scene name." {
      optional true
    }
    field look String "The look's physical cooked ID, resolved by og project from its checked project ref." {
      optional true
    }
    field saveVersion u32 "The game's save version, at least 1." {
      optional true
      min 1
    }
    field loading LoadingScreen "Who draws the loader; omitted means engine." {
      optional true
    }
    field flow ProjectStartupFlow "Dialogue to start before GameDesc.start." {
      optional true
    }
    field profile ProjectProfile "Normalized profile; omitted means 3d. Tools always emit this field." {
      optional true
    }
  }

  callback FactsFn {
    doc "The game's own facts for the probe's state(): a small JSON object, computed from the world without changing it."
    param world World "The world, read only."
    returns Json
  }

  callback StartFn {
    doc "The game's setup: called once before the first tick, after GameDesc.scene has spawned. Spawn, insert, load and set resources here; systems then only read and write their views."
    param world World "The world."
  }

  callback UiSetupFn {
    doc "Register named presentation stores and mount TSX screens (`mount` from `@origingame/engine/ui`). Called after start and after hot-reload restore, never per tick. World reads may choose initial values; world writes and gameplay side effects are refused. Existing IDs keep values, kept callbacks are replaced, and removed IDs are disposed."
    param world World "The world, read only during registration."
  }

  struct GameDesc {
    doc "A game: its tick, scenes, systems and commands."
    desc true
    field tick u32 "The fixed tick rate. Left unset, checked project.ts startup data applies (else 60); conflicting explicit values in GameDesc and startup data refuse the engine, naming both." {
      default 60
      min 1
      max 240
      unit hz
    }
    field seed u32 "The seed every Rng stream derives from; left unset, checked project.ts startup seed (else 0). CreateOptions.seed overrides it for a replay."
    field scenes Map.String "Scene names to cooked asset IDs, as `{ harbor: \"scenes/harbor.ogt\" }`; left unset, checked project.ts startup scenes."
    field scene String "The scene loaded first; left unset, checked project.ts startup scene (else main)." {
      default "main"
    }
    field systems List.System "The systems, in declaration order before `after`/`before` constraints apply."
    field hooks List.Hook "The hooks (og.defineHook), in the order they run."
    field states List.StateDesc "The state machines systems bind to (SystemDesc.state)."
    field resources List.AnyResource "The game's own resources, created at their defaults."
    field commands Map.CommandHandler "Game actions registered into the command channel, by action name."
    field commandHelp Map.CommandDesc "Each game action's argument form and one sentence, by its name in commands, for `help`: `{ place: { usage: \"<x>:<y>\", doc: \"Move the hero there.\" } }`. An action without an entry is listed by name alone."
    field maxCatchUpTicks u32 "The most ticks one frame may run to catch up with the clock; the accumulator drops the rest." {
      default 4
      min 1
      max 60
      unit ticks
    }
    field facts Option.FactsFn "The game's own facts for the probe's state()."
    field start Option.StartFn "Called once before the first tick, after the first scene spawned. A throw fails the run: no tick runs on the half-built world, `og run`, `og test` and `og dev` exit non-zero naming the error with its stack, and the web shell shows it."
    field ui Option.UiSetupFn "Register retained UI after start and after a hot-reload restore; never reruns start. The engine checks world_hash before and after: duplicate IDs, incompatible store types and gameplay writes fail registration. A fresh-process restore runs start, then ui, then restores named presentation values."
    field render RenderOptions "How the renderer is created: antialiasing and shadow map size. Read once, when the host attaches the renderer."
    field saveVersion u32 "The game's save version, written into every save: raise it when a release changes a saved type, and add the step from the old version to GameDesc.migrations. Left unset, checked project.ts startup saveVersion (else 1); conflicting explicit values refuse the engine." {
      default 1
      min 1
    }
    field migrations List.SaveMigration "The game's explicit save edits: world.restore runs each one whose `from` lies between the save's version and saveVersion, in order. The save must have the current engine version and og-save:4 envelope; other versions are refused, never converted. Engine records and state are never upgraded." {
      guide "saves §5"
    }
    field explore ExploreDesc "How `og explore` searches this game's states: what a cell reads and which inputs it presses. Left out, cells come from every field of the game's resources and components and the inputs from its own button actions and none of the intents. Read by the tool only; the engine and the world never see it."
    field look String "A cooked asset ID (og.load.look), applied after the first scene spawned, before start; its antialias applies when render leaves it out. Left unset, checked startup look from og-project.json (whose art contract the cook reads), else none; conflicting explicit values refuse the engine."
  }

  struct ExploreDesc {
    doc "`og explore`'s view of a game (GameDesc.explore): the state its archive of cells abstracts and the inputs it perturbs from them. Every field is optional."
    doc "A cell counts a named entity's fields by its name, unnamed entities as their number and each field's set of values. Numbers are bucketed (an integer up to 16 by value, a number within -1..1 in eighths, others by power of two, NaN and the infinities apart), bools, strings and enums by value. The time is a cell's too, in 64 slices of the search's horizon, unless `ignore` names `@tick`."
    guide "explore §5"
    desc true
    field cells List.String "The fields a cell reads, as `Record.field` or a whole `Record` (a resource or a component): what tells two states apart. Empty: every field of the game's own resources and components." {
      guide "explore §5"
    }
    field ignore List.String "Fields left out of cells (`Record.field` or `Record`): timers, counters and caches that make every state look new; `@tick` for a game whose state does not depend on when things happen."
    field actions List.String "The actions it presses, by name. Empty: every button action the game defines (og.input.actions), each by its first key or pad binding."
    field intents List.ExploreIntent "The intents it sends (og.input.intent's events): the recorded input a UI's controls stand for. None by default."
  }

  struct ExploreIntent {
    doc "An intent `og explore` sends (ExploreDesc.intents)."
    desc true
    field event String "The event's name."
    field values List.Json "The payloads to send, as objects of its fields. Empty: drawn from its reflection (each enum variant, a ranged integer's values, both bools, a ranged float's min, middle and max; other fields at their defaults)."
  }

  interface Game {
    custom true
    doc "A declared game, the bundle's default export."
    prop tick u32 "GameDesc.tick, or 60 when unset. The engine uses the checked project.ts startup tick when supplied by the host, as og run and og build do."
    prop systems List.System "The systems in declaration order."
  }

  fn game {
    custom true
    doc "Declare the game. The bundle's default export is its result."
    param desc GameDesc "Tick, scenes, systems and commands."
    returns Game
  }
}

# ── transform ─────────────────────────────────────────────────────────────
