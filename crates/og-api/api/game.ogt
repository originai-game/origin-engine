module game {
  doc "The game entry: what the bundle's default export declares."
  place root

  callback FactsFn {
    doc "The game's own facts for the probe's state(): a small JSON object, computed from the world without changing it."
    param world World "The world, read only."
    returns Json
  }

  callback StartFn {
    doc "The game's setup: called once before the first tick, after GameDesc.scene has spawned. Spawn, insert, load and set resources here; systems then only read and write their views."
    param world World "The world."
  }

  callback UiSetupFn {
    doc "Register named presentation stores. Called after start and after hot-reload restore, never per tick. World reads may choose initial values; world writes and gameplay side effects are refused. Existing IDs keep values, kept callbacks are replaced, and removed IDs are disposed. Document mounts await the Svelte parser IR."
    param world World "The world, read only during registration."
  }

  struct GameDesc {
    doc "A game: its tick, scenes, systems and commands."
    desc true
    field tick u32 "The fixed tick rate. Left unset, project.ogt's `tick` applies (else 60); tick, seed, scenes and scene set both here and in project.ogt to different values refuse the engine, naming both." {
      default 60
      min 1
      max 240
      unit hz
    }
    field seed u32 "The project seed every Rng stream derives from; left unset, project.ogt's `seed` (else 0). A replay overrides it."
    field scenes Map.String "Scene names to `.ogt` paths, as `{ main: \"scenes/main.ogt\" }`; left unset, project.ogt's `scenes` block."
    field scene String "The scene loaded first; left unset, project.ogt's `scene` (else main)." {
      default "main"
    }
    field systems List.System "The systems, in declaration order before `after`/`before` constraints apply."
    field hooks List.Hook "The hooks (og.defineHook), in the order they run."
    field states List.StateDesc "The state machines systems bind to (SystemDesc.state)."
    field resources List.AnyResource "The game's own resources, created at their defaults."
    field commands Map.CommandHandler "Game actions registered into the command channel, by action name."
    field commandHelp Map.CommandDesc "Each game action's argument form and one sentence, by its name in commands, for `help`: `{ place: { usage: \"<x>:<y>\", doc: \"Move the hero there.\" } }`. An action without an entry is listed by name alone."
    field maxCatchUp u32 "The most ticks one frame may run to catch up with the clock; the accumulator drops the rest." {
      default 4
      min 1
      max 60
      unit ticks
    }
    field facts Option.FactsFn "The game's own facts for the probe's state()."
    field start Option.StartFn "Called once before the first tick, after the first scene spawned. A throw fails the run: no tick runs on the half-built world, `og run`, `og test` and `og dev` exit non-zero naming the error with its stack, and the web shell shows it."
    field ui Option.UiSetupFn "Register retained UI after start and after a hot-reload restore; never reruns start. The engine checks world_hash before and after: duplicate IDs, incompatible store types and gameplay writes fail registration. A fresh-process restore runs start, then ui, then restores named presentation values."
    field render RenderOptions "How the renderer is created: antialiasing and shadow map size. Read once, when the host attaches the renderer."
    field saveVersion u32 "The game's save version, written into every save: raise it when a release changes a saved type, and add the step from the old version to GameDesc.migrations. Left unset, project.ogt's `saveVersion` (else 1); the two set to different values refuse the engine." {
      default 1
      min 1
    }
    field migrations List.SaveMigration "The game's save migrations: world.restore runs each one whose `from` lies between the save's version and saveVersion, in order. The save envelope must be og-save:3; earlier envelope formats are refused with both versions in the error, never converted." {
      guide "saves §5"
    }
    field explore ExploreDesc "How `og explore` searches this game's states: what a cell reads and which inputs it presses. Left out, cells come from every field of the game's resources and components and the inputs from every button action and none of the intents. Read by the tool only; the engine and the world never see it."
    field look String "A look (`looks/<name>.ogt`, og.load.look) applied after the first scene spawned, before start (which may change any of it); its antialias applies when render leaves it out. Unset or empty: project.ogt's `look` (whose art contract the cook reads), else none; the two naming different looks is refused."
  }

  struct ExploreDesc {
    doc "`og explore`'s view of a game (GameDesc.explore): the state its archive of cells abstracts and the inputs it perturbs from them. Every field is optional."
    doc "A cell counts a named entity's fields by its name, unnamed entities as their number and each field's set of values. Numbers are bucketed (an integer up to 16 by value, a number within -1..1 in eighths, others by power of two, NaN and the infinities apart), bools, strings and enums by value. The time is a cell's too, in 64 slices of the search's horizon, unless `ignore` names `@tick`."
    guide "explore §5"
    desc true
    field cells List.String "The fields a cell reads, as `Record.field` or a whole `Record` (a resource or a component): what tells two states apart. Empty: every field of the game's own resources and components." {
      guide "explore §5"
    }
    field ignore List.String "Fields left out of cells (`Record.field` or `Record`): timers, counters and caches that make every state look new; `@tick` for a game whose state does not depend on when things happen."
    field actions List.String "The actions it presses, by name. Empty: every button action the game defines (og.input.actions), each by its first key or pad binding."
    field intents List.ExploreIntent "The intents it sends (og.input.intent's events): the recorded input a UI's controls stand for. None by default."
  }

  struct ExploreIntent {
    doc "An intent `og explore` sends (ExploreDesc.intents)."
    desc true
    field event String "The event's name."
    field values List.Json "The payloads to send, as objects of its fields. Empty: drawn from its reflection (each enum variant, a ranged integer's values, both bools, a ranged float's min, middle and max; other fields at their defaults)."
  }

  interface Game {
    doc "A declared game, the bundle's default export."
    prop tick u32 "GameDesc.tick, or 60 when it is unset (the engine then runs at project.ogt's `tick` when the host passes the project, as og run and og build do)."
    prop systems List.System "The systems in declaration order."
  }

  fn game {
    doc "Declare the game. The bundle's default export is its result."
    param desc GameDesc "Tick, scenes, systems and commands."
    returns Game
  }
}

# ── transform ─────────────────────────────────────────────────────────────
