module physics {
  doc "Rigid bodies over rapier (rapier3d in the 3D profile, rapier2d in 2D, both with enhanced determinism): game code owns the components, the engine's og.physics system steps them after the game's systems and writes the dynamic bodies back."
  doc "The profile is project.ogt's `profile`. In 2D, bodies move in the xy plane and rotate about z; a transform keeps its z. A collider without a RigidBody is static at its transform."
  doc "The rapier world persists between ticks and is world state: snapshots, restore and the world hash cover the whole simulation. Events sent in tick N are read in tick N + 1."
  guide "physics"
  core RigidBody Collider Velocity CharacterController Vehicle SHAPE_BOX SHAPE_SPHERE SHAPE_HEIGHTFIELD

  const MAX_RAYCAST_HITS u32 256 "The most hits og.physics.castRayAll returns."
  const LOCK_TRANSLATION_X u32 1 "RigidBody.lock bit: no translation along x."
  const LOCK_TRANSLATION_Y u32 2 "RigidBody.lock bit: no translation along y."
  const LOCK_TRANSLATION_Z u32 4 "RigidBody.lock bit: no translation along z."
  const LOCK_ROTATION_X u32 8 "RigidBody.lock bit: no rotation about x."
  const LOCK_ROTATION_Y u32 16 "RigidBody.lock bit: no rotation about y."
  const LOCK_ROTATION_Z u32 32 "RigidBody.lock bit: no rotation about z (the 2D profile's only rotation)."
  const SHAPE_BOX u32 0 "Collider.shape: a box of `size` (both profiles)."
  const SHAPE_SPHERE u32 1 "Collider.shape: a sphere of `radius` (a circle in 2D)."
  const SHAPE_CAPSULE u32 2 "Collider.shape: a capsule along y of `radius`, with `height` between the cap centres (both profiles)."
  const SHAPE_CYLINDER u32 3 "Collider.shape: a cylinder along y of `radius` and `height` (3D only)."
  const SHAPE_CONVEX u32 4 "Collider.shape: the convex hull of the vertices of `mesh` (3D), or of their xy (a convex polygon, 2D)."
  const SHAPE_TRIMESH u32 5 "Collider.shape: the triangles of `mesh` (for static and kinematic bodies); in 2D the outline of their xy (the edges no two triangles share) as a hollow polyline, which stops what comes from outside."
  const SHAPE_HEIGHTFIELD u32 6 "Collider.shape: the height field registered as `mesh`, centred on the entity (3D only; a terrain: og.terrain.load's TerrainInfo.geometry)."
  const SHAPE_DIAMOND u32 7 "Collider.shape: a rhombus whose diagonals are size.x (along x) and size.y (along y), an isometric tile's diamond; in 3D a prism size.z deep (both profiles)."
  const SHAPE_HEXAGON u32 8 "Collider.shape: a pointy-top hexagon in the box size.x by size.y, corners at the top and bottom middles and a quarter down each side, a hex tile's (turn it a quarter about z for a flat-top one); in 3D a prism size.z deep (both profiles)."
  const PROFILE_2D u32 2 "Physics.profile: rapier2d, bodies in the xy plane rotating about z."
  const PROFILE_3D u32 3 "Physics.profile: rapier3d."

  enum RigidBodyType {
    doc "A body's simulation mode. Fixed has Rapier's meaning; kinematic is the engine's combined Velocity/Transform contract."
    guide "physics §1"
    variant dynamic "Moved by the solver; Transform and Velocity are written back every tick."
    variant fixed "Not moved by the solver; collides with dynamic bodies."
    variant kinematic "Velocity moves it each tick; a Transform write teleports it first. Without Velocity it stays at Transform. It pushes dynamic bodies and carries controllers. Transform is not a next-position target from which velocity is inferred."
  }

  column RigidBodyType {
    doc "A RigidBodyType field: the variant's index."
    array Uint32Array
    stride 1
    value RigidBodyType
  }

  component RigidBody {
    doc "A body the physics step simulates. It needs an og.Transform and usually has an og.Collider; a dynamic body without an og.Velocity gets one."
    doc "Changing a RigidBody, a Collider or Transform.scale rebuilds the body (it loses its contacts' warm starts); a Transform or Velocity that game code changed moves it (a teleport)."
    aliases "physics body, Rigidbody, RigidBody3D, dynamic body, kinematic body"
    guide "physics §1"
    field kind RigidBodyType "dynamic is simulated, fixed is not moved by the solver, kinematic follows Velocity and Transform writes." {
      label "Kind"
    }
    field mass f32 "Mass; 0 derives it from the collider's density and volume." {
      min 0
      unit kg
      tunable true
    }
    field linearDamping f32 "How fast linear velocity decays (0: none)." {
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field angularDamping f32 "How fast angular velocity decays (0: none)." {
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies Physics.gravity for this body: 0 floats, 1 is normal." {
      default 1
      min -10
      max 10
      tunable true
    }
    field lock u32 "Locked axes, a sum of the LOCK_* bits: 1, 2, 4 no translation along x, y, z; 8, 16, 32 no rotation about x, y, z (2D uses 1, 2 and 32)." {
      min 0
      max 63
    }
    field ccd bool "Enable continuous collision detection for fast small bodies that must not tunnel."
    field centerOfMass Vector3 "Moves the centre of mass from where the collider puts it (its shape's centre), in the entity's own frame and scaled by og.Transform.scale like Collider.offset; the inertia stays the shape's. Needs an og.Collider." {
      guide "physics §1"
      unit m
      tunable true
    }
    field canSleep bool "Whether the body may sleep when Physics.sleepTicks is set. A body sleeps only with every dynamic body it touches, so false keeps it and what touches it awake (a player's ball, a body game code moves every tick)." {
      default true
    }
    field sleeping bool "Written: true while the body sleeps (Physics.sleepTicks). Write false to wake it; physics then writes it back as the body is."
  }

  component Collider {
    doc "The shape an entity collides with, attached to its RigidBody (or, without one, a static collider at its Transform). Sizes are scaled by og.Transform.scale."
    doc "A Collider without a RigidBody whose og.Parent chain reaches one is part of the nearest such body (a compound), placed relative to it; its density adds to the body's mass, and its friction, restitution, layers and sensor flag are its own. Events and queries name the collider's entity; RaycastHit.body and PointProjection.body name the body. A controller's body takes no children."
    guide "physics §1"
    aliases "trigger, sensor, hitbox, collision shape, Unity Collider isTrigger, Godot CollisionShape"
    field shape u32 "One of the SHAPE_* codes: 0 box, 1 sphere (a circle in 2D), 2 capsule, 3 cylinder (3D), 4 convex hull of `mesh` (a polygon in 2D), 5 triangle mesh of `mesh` (its outline in 2D), 6 the height field `mesh` (3D: a terrain), 7 a diamond and 8 a hexagon in `size` (both)." {
      min 0
      max 8
      label "Shape"
    }
    field size Vector3 "Full extents of a box, as three.js BoxGeometry(width, height, depth)." {
      default 1 1 1
      min 0
      unit m
      tunable true
    }
    field radius f32 "Radius of a sphere, circle, capsule or cylinder." {
      default 0.5
      min 0
      unit m
      tunable true
    }
    field height f32 "A capsule's distance between its cap centres (three.js CapsuleGeometry length); a cylinder's height." {
      default 1
      min 0
      unit m
      tunable true
    }
    field mesh Geometry "The geometry whose vertices a convex or triangle-mesh shape uses: a loaded glTF's geometry (registered automatically) or one given to og.physics.setMesh; for SHAPE_HEIGHTFIELD, a terrain's height field (og.terrain.load's TerrainInfo.geometry)."
    field offset Vector3 "Position of the shape relative to the entity." {
      unit m
    }
    field rotation Quaternion "Rotation of the shape relative to the entity."
    field friction f32 "Coulomb friction (0 is ice, 1 rubber); a pair uses the mean of both colliders." {
      default 0.5
      min 0
      max 2
      tunable true
    }
    field restitution f32 "Bounciness (0 no bounce, 1 elastic); a pair uses the mean of both colliders." {
      min 0
      max 1
      tunable true
    }
    field density f32 "Density, used when RigidBody.mass is 0." {
      default 1
      min 0
      unit kgPerM3
      tunable true
    }
    field sensor bool "A sensor reports SensorEntered and SensorExited and pushes nothing; false is a solid."
    field layers u32 "The collision layers this collider is on, as bits." {
      default 1
    }
    field mask u32 "The layers it collides with, as bits. Two colliders interact when each one's layers meet the other's mask." {
      default 4294967295
    }
  }

  component Velocity {
    doc "Linear and angular velocity. Written for dynamic bodies every tick (added to them by the step when missing); a kinematic body moves by it each tick (never added, never written). Set it to launch or stop a body; push one with og.physics.applyForce, applyImpulse, applyTorque or applyTorqueImpulse."
    field linear Vector3 "The linear velocity (2D uses x and y)." {
      unit mps
      tunable true
    }
    field angular Vector3 "The angular velocity about each axis (2D uses z)." {
      unit radps
      tunable true
    }
  }

  resource Physics {
    doc "The physics settings of the world. The profile is the project's; the same components serve both profiles."
    field profile u32 "PROFILE_2D (2: rapier2d, the xy plane, rotation about z) or PROFILE_3D (3: rapier3d), from project.ogt. Setting the other one at run time makes the next step build that profile's simulation from the components; contacts, joints' warm starts, ropes, cloth, fluids and ragdoll bodies start again." {
      guide "physics §2"
      default 3
      min 2
      max 3
      label "Profile"
    }
    field gravity Vector3 "The acceleration of every dynamic body, times its gravityScale; 2D uses x and y." {
      default 0 -9.81 0
      unit mps2
      tunable true
    }
    field substeps u32 "Physics steps per tick, each of dt / substeps: more is stiffer stacks and less tunnelling, at more cost." {
      default 1
      min 1
      max 16
      tunable true
    }
    field solverIterations u32 "Solver iterations per step." {
      default 4
      min 1
      max 32
      tunable true
    }
    field restSpeed f32 "A dynamic body touching something, supported with at most 2 mm of overlap and slower than this before and after a step, keeps its pose and loses its residual velocity (the same number in m/s and rad/s); 0 disables it." {
      default 0.02
      min 0
      max 1
      unit mps
      tunable true
    }
    field sleepTicks u32 "Ticks in a row a dynamic body must stay slower than sleepSpeed before it sleeps, together with every dynamic body it touches (contacts and joints, transitively), and stays asleep until woken. BodySlept and BodyWoke report it. Counted in ticks and saved with the world; 0, the default, never sleeps." {
      guide "physics §3"
      min 0
      max 3600
      tunable true
    }
    field sleepSpeed f32 "The speed under which a body counts towards sleepTicks, before and after each step (the same number in m/s and rad/s)." {
      default 0.1
      min 0
      max 10
      unit mps
      tunable true
    }
  }

  event CollisionStarted {
    doc "Two solid colliders started touching during the tick. Read in the tick after, when og.Velocity already holds the solver's answer (the bodies parting): how hard they met is `impulse` and `relativeVelocity`, taken in the step itself."
    guide "physics §5"
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
    field point Vector3 "The deepest contact point in world space (z is 0 in 2D)." {
      worldspace world
      unit m
    }
    field normal Vector3 "The contact normal, from a towards b."
    field impulse f32 "The normal impulse the solver gave the pair in the step that made the contact (every substep, every contact point), in newton-seconds: b took `impulse` along `normal`, a the same against it. Its momentum answer to the hit, at least 0; heavier and faster hits give more." {
      min 0
      unit newtonSecond
    }
    field relativeVelocity Vector3 "a's velocity relative to b at `point` as the step began, before the solver answered: each body's linear velocity plus its angular velocity crossed with the offset from its centre of mass (a static collider is still; z is 0 in 2D). Along `normal` it is the closing speed, positive while they approach." {
      guide "physics §5"
      unit mps
    }
  }

  event CollisionEnded {
    doc "Two solid colliders stopped touching, or one of them went away."
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
  }

  event SensorEntered {
    doc "A collider started overlapping a sensor: something walked into a trigger area (a pressure plate, a pickup, a zone that starts a cutscene). A sensor is an og.Collider with `sensor` set; it reports overlaps and pushes nothing."
    aliases "trigger enter, OnTriggerEnter, Godot Area2D body_entered, Unreal OnComponentBeginOverlap, trigger volume, zone entered"
    field sensor Entity "The entity whose collider is the sensor."
    field other Entity "The entity that entered it."
  }

  event SensorExited {
    doc "A collider stopped overlapping a sensor, or one of them went away."
    field sensor Entity "The entity whose collider is the sensor."
    field other Entity "The entity that left it."
  }

  event JointBroken {
    doc "A joint broke during the tick: the solver's force or torque on it passed its breakForce or breakTorque. Sent in joint entity order; the joint's `broken` is set, and its bodies part."
    field joint Entity "The og.Joint's entity."
    field body Entity "Its first body."
    field other Entity "Its second body; 0 for the world."
    field force f32 "The force it carried when it broke." {
      unit newton
    }
    field torque f32 "The torque about its anchor it carried when it broke." {
      unit newtonMetre
    }
  }

  component ContactHook {
    doc "What a collider's contacts do beyond its og.Collider: a one-way platform, a conveyor belt, friction and restitution of its own, entities it passes through. Put it on the collider's entity (a static collider, a body, or a compound child). The solver reads a table of the hooks frozen at the start of the step, on its worker threads: hooks are data, not game callbacks, and run the same on both hosts and in every replay."
    field oneWay Vector3 "A one-way surface: solid only to what is on this side of it, within 45° (world space; up for a platform jumped through from below). What came in from elsewhere passes until it is clear of it. Zero is off."
    field surfaceVelocity Vector3 "The surface's own velocity along its contacts (world space): what lies on it is carried, as on a conveyor belt, a treadmill or a moving walkway. Zero is off." {
      unit mps
      tunable true
    }
    field friction f32 "Its contacts' friction, in place of the pair's mean; negative keeps the colliders' own." {
      default -1
      min -1
      max 2
      tunable true
    }
    field restitution f32 "Its contacts' restitution, in place of the pair's mean; negative keeps the colliders' own." {
      default -1
      min -1
      max 1
      tunable true
    }
    field ignore List.Entity.8 "Entities it never collides with: colliders or their bodies (a projectile and its shooter, a ghost and a door); 0s are skipped."
  }

  event BodySlept {
    doc "A body fell asleep during the tick (Physics.sleepTicks), with every dynamic body it touches; sent in entity order. Stop a rolling sound, settle a pile's debris."
    field entity Entity "The body's entity."
  }

  event BodyWoke {
    doc "A sleeping body woke during the tick: something touched, pushed or moved it, game code wrote to it, or sleep was turned off; sent in entity order."
    field entity Entity "The body's entity."
  }

  event Contact {
    doc "One pair in contact at the end of a step, sent every tick for every touching pair: how a game asks what is touching what right now."
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
    field sensor u32 "0 for two solids; an overlap with a sensor otherwise: 1 a is the sensor, 2 b is, 3 both are."
  }

  const JOINT_FIXED u32 0 "`Joint.kind`: the two bodies move as one."
  const JOINT_REVOLUTE u32 1 "`Joint.kind`: a hinge about `axis` (2D: about z), with optional limits and a motor."
  const JOINT_PRISMATIC u32 2 "`Joint.kind`: a slider along `axis`, with optional limits and a motor."
  const JOINT_SPRING u32 3 "`Joint.kind`: a damped spring pulling the anchors to `restLength` apart."
  const JOINT_ROPE u32 4 "`Joint.kind`: a rope: the anchors stay at most `length` apart, free inside it."
  const JOINT_BALL u32 5 "`Joint.kind`: a ball and socket (3D; the 2D profile treats it as a hinge)."
  const MOTOR_NONE u32 0 "`Joint.motor`: no motor."
  const MOTOR_VELOCITY u32 1 "`Joint.motor`: drive towards `motorTarget` speed (rad/s or m/s)."
  const MOTOR_POSITION u32 2 "`Joint.motor`: spring towards `motorTarget` angle or position (a servo)."

  component Joint {
    doc "A joint between two bodies (or a body and a point of the world). The component may sit on one of the bodies (`body` 0) or on an entity of its own, so one body can have several joints. Anchors are in each body's frame (rotated and moved with it, not scaled); without `other` the second anchor is a world point. A joint whose bodies are not both `og.RigidBody` entities does nothing until they are."
    guide "physics §1"
    field kind u32 "JOINT_FIXED 0, JOINT_REVOLUTE 1 (hinge), JOINT_PRISMATIC 2 (slider), JOINT_SPRING 3, JOINT_ROPE 4, JOINT_BALL 5." {
      min 0
      max 5
      label "Kind"
    }
    field body Entity "The first body; 0 is this entity."
    field other Entity "The second body; 0 joins the first one to the world at `otherAnchor`."
    field anchor Vector3 "Where the joint sits on the first body, in its frame." {
      worldspace none
      unit m
    }
    field otherAnchor Vector3 "Where it sits on the second body, in its frame (a world point without `other`)." {
      worldspace hook
      unit m
    }
    field axis Vector3 "The hinge or slide axis in the first body's frame (a hinge in 2D turns about z)." {
      default 1 0 0
    }
    field limits bool "Whether `min`..`max` bound the hinge angle (rad) or the slide (m)."
    field min f32 "The lower limit: radians for a hinge, metres for a slider."
    field max f32 "The upper limit."
    field motor u32 "MOTOR_NONE 0, MOTOR_VELOCITY 1 (drive at motorTarget speed), MOTOR_POSITION 2 (spring to motorTarget)." {
      min 0
      max 2
    }
    field motorTarget f32 "The motor's target speed (rad/s, m/s) or angle or position (rad, m)." {
      tunable true
    }
    field motorStiffness f32 "A position motor's stiffness; a velocity motor's strength." {
      default 50
      min 0
      tunable true
    }
    field motorDamping f32 "A position motor's damping." {
      default 5
      min 0
      tunable true
    }
    field motorMaxForce f32 "The most force (or torque) the motor applies; 0 is unbounded." {
      min 0
      tunable true
    }
    field restLength f32 "A spring's rest length." {
      default 1
      min 0
      unit m
      tunable true
    }
    field stiffness f32 "A spring's stiffness (N/m)." {
      default 40
      min 0
      tunable true
    }
    field damping f32 "A spring's damping (N·s/m)." {
      default 2
      min 0
      tunable true
    }
    field length f32 "A rope's longest distance between the anchors." {
      default 2
      min 0
      unit m
      tunable true
    }
    field collide bool "Whether the two bodies still collide with each other."
    field value f32 "Written: the hinge angle (rad) or the slide (m) after the step; the anchors' distance for springs and ropes." {
      readonly true
    }
    field breakForce f32 "The force the joint holds before it breaks (JointBroken, `broken`): the solver's load on it through the step, its weight, gravity and what rests or presses on it; a lone impulse (applyImpulse, applyForce) is absorbed before it counts. 0 never breaks." {
      min 0
      unit newton
      tunable true
    }
    field breakTorque f32 "The torque about its anchor it holds before it breaks, as breakForce (a shelf bracket, a cantilevered beam); 0 never breaks." {
      min 0
      unit newtonMetre
      tunable true
    }
    field broken bool "Written: true once the joint broke; a broken joint holds nothing. Write false to mend it, rebuilt where its bodies are now."
  }

