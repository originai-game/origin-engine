module physics {
  skill og-physics
  doc "Rigid bodies over rapier (rapier3d in the 3D profile, rapier2d in 2D, both with enhanced determinism): game code owns the components, the engine's og.physics system steps them after the game's systems and writes the dynamic bodies back."
  doc "The profile is the project's (`profile \"2d\"` or `\"3d\"` in project.ogt). In 2D, bodies move in the xy plane and rotate about z; a transform keeps its z. A collider without a RigidBody is static at its transform."
  doc "The rapier world persists between ticks and is world state: snapshots, restore and the world hash cover the whole simulation. Events sent in tick N are read in tick N + 1."

  const MAX_RAYCAST_HITS u32 256 "The most hits og.physics.raycastAll returns."
  const BODY_DYNAMIC u32 0 "RigidBody.kind: moved by the solver; its Transform and Velocity are written back every tick."
  const BODY_STATIC u32 1 "RigidBody.kind: never moves; collides with dynamic bodies."
  const BODY_KINEMATIC u32 2 "RigidBody.kind: not moved by the solver. With an og.Velocity the step moves it by it each tick and writes its Transform back (a lift, a conveyor, a turning gear); a Transform game code writes moves it there first (a teleport). Without one it stays where its Transform puts it. Either way it pushes dynamic bodies and carries the controllers standing on it."
  const LOCK_TRANSLATION_X u32 1 "RigidBody.lock bit: no translation along x."
  const LOCK_TRANSLATION_Y u32 2 "RigidBody.lock bit: no translation along y."
  const LOCK_TRANSLATION_Z u32 4 "RigidBody.lock bit: no translation along z."
  const LOCK_ROTATION_X u32 8 "RigidBody.lock bit: no rotation about x."
  const LOCK_ROTATION_Y u32 16 "RigidBody.lock bit: no rotation about y."
  const LOCK_ROTATION_Z u32 32 "RigidBody.lock bit: no rotation about z (the 2D profile's only rotation)."
  const SHAPE_BOX u32 0 "Collider.shape: a box of `size` (both profiles)."
  const SHAPE_SPHERE u32 1 "Collider.shape: a sphere of `radius` (a circle in 2D)."
  const SHAPE_CAPSULE u32 2 "Collider.shape: a capsule along y of `radius`, with `height` between the cap centres (both profiles)."
  const SHAPE_CYLINDER u32 3 "Collider.shape: a cylinder along y of `radius` and `height` (3D only)."
  const SHAPE_CONVEX u32 4 "Collider.shape: the convex hull of the vertices of `mesh` (3D), or of their xy (a convex polygon, 2D)."
  const SHAPE_TRIMESH u32 5 "Collider.shape: the triangles of `mesh` (for static and kinematic bodies); in 2D the outline of their xy (the edges no two triangles share) as a hollow polyline, which stops what comes from outside."
  const SHAPE_HEIGHTFIELD u32 6 "Collider.shape: the height field registered as `mesh`, centred on the entity (3D only; a terrain: og.terrain.load's TerrainInfo.geometry)."
  const SHAPE_DIAMOND u32 7 "Collider.shape: a rhombus whose diagonals are size.x (along x) and size.y (along y), an isometric tile's diamond; in 3D a prism size.z deep (both profiles)."
  const SHAPE_HEXAGON u32 8 "Collider.shape: a pointy-top hexagon in the box size.x by size.y, corners at the top and bottom middles and a quarter down each side, a hex tile's (turn it a quarter about z for a flat-top one); in 3D a prism size.z deep (both profiles)."
  const PROFILE_2D u32 2 "Physics.profile: rapier2d, bodies in the xy plane rotating about z."
  const PROFILE_3D u32 3 "Physics.profile: rapier3d."

  component RigidBody {
    doc "A body the physics step simulates. It needs an og.Transform and usually has an og.Collider; a dynamic body without an og.Velocity gets one."
    doc "Changing a RigidBody, a Collider or Transform.scale rebuilds the body (it loses its contacts' warm starts); a Transform or Velocity that game code changed moves it (a teleport)."
    field kind u32 "BODY_DYNAMIC (0, simulated and written back), BODY_STATIC (1, never moves) or BODY_KINEMATIC (2, moved by its Velocity each tick, or by game code through its Transform)." {
      min 0
      max 2
      label "Kind"
    }
    field mass f32 "Mass; 0 derives it from the collider's density and volume." {
      min 0
      unit kg
      tunable true
    }
    field linearDamping f32 "How fast linear velocity decays (0: none)." {
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field angularDamping f32 "How fast angular velocity decays (0: none)." {
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies Physics.gravity for this body: 0 floats, 1 is normal." {
      default 1
      min -10
      max 10
      tunable true
    }
    field lock u32 "Locked axes, a sum of the LOCK_* bits: 1, 2, 4 no translation along x, y, z; 8, 16, 32 no rotation about x, y, z (2D uses 1, 2 and 32)." {
      min 0
      max 63
    }
    field ccd u32 "1 enables continuous collision detection, for fast small bodies that must not tunnel; 0 off." {
      min 0
      max 1
    }
    field centerOfMass Vector3 "Moves the centre of mass from where the collider puts it (its shape's centre), in the entity's own frame and scaled by og.Transform.scale like Collider.offset; the inertia stays the shape's. A car's lowered below its wheel mounts keeps it on its wheels at full lock; a weight at a toy's base rights it. Needs an og.Collider." {
      unit m
      tunable true
    }
    field canSleep bool "Whether the body may sleep when Physics.sleepTicks is set. A body sleeps only with every dynamic body it touches, so false keeps it and what touches it awake (a player's ball, a body game code moves every tick)." {
      default true
    }
    field sleeping bool "Written: true while the body sleeps (Physics.sleepTicks). Write false to wake it; physics then writes it back as the body is."
  }

  component Collider {
    doc "The shape an entity collides with, attached to its RigidBody (or, without one, a static collider at its Transform). Sizes are scaled by og.Transform.scale."
    doc "Compound colliders: a Collider without a RigidBody on a child entity whose og.Parent chain reaches a RigidBody is part of that body (the nearest such ancestor), placed at its transform relative to the body (the transforms between them composed, the body's scale applied): a table of a top and four legs, a ship of a hull and a mast, are one body. Its mass adds to the body's from its density, or the body's RigidBody.mass is shared among its colliders by theirs; its friction, restitution, layers and sensor flag are its own. Children join in entity order, whatever the query order. Changing a child (its collider, or its transform relative to the body) rebuilds the body, which loses its contacts' warm starts. Events and queries name the collider's entity; RaycastHit.body and PointProjection.body name the body. A controller's body takes no children; a collider whose chain reaches no body stays static at its world transform."
    field shape u32 "One of the SHAPE_* codes: 0 box, 1 sphere (a circle in 2D), 2 capsule, 3 cylinder (3D), 4 convex hull of `mesh` (a polygon in 2D), 5 triangle mesh of `mesh` (its outline in 2D), 6 the height field `mesh` (3D: a terrain), 7 a diamond and 8 a hexagon in `size` (both)." {
      min 0
      max 8
      label "Shape"
    }
    field size Vector3 "Full extents of a box, as three.js BoxGeometry(width, height, depth)." {
      default 1 1 1
      min 0
      unit m
      tunable true
    }
    field radius f32 "Radius of a sphere, circle, capsule or cylinder." {
      default 0.5
      min 0
      unit m
      tunable true
    }
    field height f32 "A capsule's distance between its cap centres (three.js CapsuleGeometry length); a cylinder's height." {
      default 1
      min 0
      unit m
      tunable true
    }
    field mesh Geometry "The geometry whose vertices a convex or triangle-mesh shape uses: a loaded glTF's geometry (registered automatically) or one given to og.physics.setMesh; for SHAPE_HEIGHTFIELD, a terrain's height field (og.terrain.load's TerrainInfo.geometry)."
    field offset Vector3 "Position of the shape relative to the entity." {
      unit m
    }
    field rotation Quaternion "Rotation of the shape relative to the entity."
    field friction f32 "Coulomb friction (0 is ice, 1 rubber); a pair uses the mean of both colliders." {
      default 0.5
      min 0
      max 2
      tunable true
    }
    field restitution f32 "Bounciness (0 no bounce, 1 elastic); a pair uses the mean of both colliders." {
      min 0
      max 1
      tunable true
    }
    field density f32 "Density, used when RigidBody.mass is 0." {
      default 1
      min 0
      unit kgPerM3
      tunable true
    }
    field sensor u32 "1 makes this a sensor: it reports SensorEntered and SensorExited and pushes nothing; 0 a solid." {
      min 0
      max 1
    }
    field layers u32 "The collision layers this collider is on, as bits." {
      default 1
    }
    field mask u32 "The layers it collides with, as bits. Two colliders interact when each one's layers meet the other's mask." {
      default 4294967295
    }
  }

  component Velocity {
    doc "Linear and angular velocity. Written for dynamic bodies every tick (added to them by the step when missing); a kinematic body moves by it each tick (never added, never written). Set it to launch or stop a body; push one with og.physics.applyForce, applyImpulse, applyTorque or applyTorqueImpulse."
    field linear Vector3 "The linear velocity (2D uses x and y)." {
      unit mps
      tunable true
    }
    field angular Vector3 "The angular velocity about each axis (2D uses z)." {
      unit radps
      tunable true
    }
  }

  resource Physics {
    doc "The physics settings of the world. The profile is the project's; the same components serve both profiles."
    field profile u32 "PROFILE_2D (2: rapier2d, the xy plane, rotation about z) or PROFILE_3D (3: rapier3d), from project.ogt. Set the other one at run time to change profile: the next step builds that profile's simulation from the components (contacts, joints' warm starts, ropes, cloth, fluids and ragdoll bodies start again), so a 3D game can play a 2D scene and back." {
      default 3
      min 2
      max 3
      label "Profile"
    }
    field gravity Vector3 "The acceleration of every dynamic body, times its gravityScale; 2D uses x and y." {
      default 0 -9.81 0
      unit mps2
      tunable true
    }
    field substeps u32 "Physics steps per tick, each of dt / substeps: more is stiffer stacks and less tunnelling, at more cost." {
      default 1
      min 1
      max 16
      tunable true
    }
    field solverIterations u32 "Solver iterations per step." {
      default 4
      min 1
      max 32
      tunable true
    }
    field restSpeed f32 "A dynamic body touching something, supported with at most 2 mm of overlap and slower than this before and after a step, keeps its pose and loses its residual velocity (the same number in m/s and rad/s); 0 disables it." {
      default 0.02
      min 0
      max 1
      unit mps
      tunable true
    }
    field sleepTicks u32 "Ticks in a row a dynamic body must stay slower than sleepSpeed before it sleeps, together with every dynamic body it touches (contacts and joints, transitively): a settled pile sleeps whole and costs nothing until something wakes it (a body landing on it, a push, a joint, a moving kinematic body, a write to its Transform, Velocity, RigidBody or Collider, its support going away). BodySlept and BodyWoke report it. Deterministic: counted in ticks, saved with the world. 0, the default, never sleeps; new projects use about 30." {
      min 0
      max 3600
      tunable true
    }
    field sleepSpeed f32 "The speed under which a body counts towards sleepTicks, before and after each step (the same number in m/s and rad/s)." {
      default 0.1
      min 0
      max 10
      unit mps
      tunable true
    }
  }

  event CollisionStarted {
    doc "Two solid colliders started touching during the tick. Read in the tick after, when og.Velocity already holds the solver's answer (the bodies parting): how hard they met is `impulse` and `relativeVelocity`, taken in the step itself."
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
    field point Vector3 "The deepest contact point in world space (z is 0 in 2D)." {
      worldspace world
      unit m
    }
    field normal Vector3 "The contact normal, from a towards b."
    field impulse f32 "The normal impulse the solver gave the pair in the step that made the contact (every substep, every contact point), in newton-seconds: b took `impulse` along `normal`, a the same against it. Its momentum answer to the hit, at least 0; heavier and faster hits give more." {
      min 0
      unit newtonSecond
    }
    field relativeVelocity Vector3 "a's velocity relative to b at `point` as that step began, before the solver answered: each body's linear velocity plus its angular velocity crossed with the point's offset from its centre of mass (a static collider is still; z is 0 in 2D). Along `normal` it is the closing speed, positive while they approach: max(0, relativeVelocity · normal) is how hard they hit, in m/s." {
      unit mps
    }
  }

  event CollisionEnded {
    doc "Two solid colliders stopped touching, or one of them went away."
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
  }

  event SensorEntered {
    doc "A collider started overlapping a sensor."
    field sensor Entity "The entity whose collider is the sensor."
    field other Entity "The entity that entered it."
  }

  event SensorExited {
    doc "A collider stopped overlapping a sensor, or one of them went away."
    field sensor Entity "The entity whose collider is the sensor."
    field other Entity "The entity that left it."
  }

  event JointBroken {
    doc "A joint broke during the tick: the solver's force or torque on it passed its breakForce or breakTorque. Sent in joint entity order; the joint's `broken` is set, and its bodies part."
    field joint Entity "The og.Joint's entity."
    field body Entity "Its first body."
    field other Entity "Its second body; 0 for the world."
    field force f32 "The force it carried when it broke." {
      unit newton
    }
    field torque f32 "The torque about its anchor it carried when it broke." {
      unit newtonMetre
    }
  }

  component ContactHook {
    doc "What a collider's contacts do beyond its og.Collider: a one-way platform, a conveyor belt, friction and restitution of its own, entities it passes through. Put it on the collider's entity (a static collider, a body, or a compound child). The solver reads a table of the hooks frozen at the start of the step, on its worker threads: hooks are data, not game callbacks, and run the same on both hosts and in every replay."
    field oneWay Vector3 "A one-way surface: solid only to what is on this side of it, within 45° (world space; up for a platform jumped through from below). What came in from elsewhere passes until it is clear of it. Zero is off."
    field surfaceVelocity Vector3 "The surface's own velocity along its contacts (world space): what lies on it is carried, as on a conveyor belt, a treadmill or a moving walkway. Zero is off." {
      unit mps
      tunable true
    }
    field friction f32 "Its contacts' friction, in place of the pair's mean; negative keeps the colliders' own." {
      default -1
      min -1
      max 2
      tunable true
    }
    field restitution f32 "Its contacts' restitution, in place of the pair's mean; negative keeps the colliders' own." {
      default -1
      min -1
      max 1
      tunable true
    }
    field ignore List.Entity.8 "Entities it never collides with: colliders or their bodies (a projectile and its shooter, a ghost and a door); 0s are skipped."
  }

  event BodySlept {
    doc "A body fell asleep during the tick (Physics.sleepTicks), with every dynamic body it touches; sent in entity order. Stop a rolling sound, settle a pile's debris."
    field entity Entity "The body's entity."
  }

  event BodyWoke {
    doc "A sleeping body woke during the tick: something touched, pushed or moved it, game code wrote to it, or sleep was turned off; sent in entity order."
    field entity Entity "The body's entity."
  }

  event Contact {
    doc "One pair in contact at the end of a step, sent every tick for every touching pair: how a game asks what is touching what right now."
    field a Entity "The entity with the lower id."
    field b Entity "The entity with the higher id."
    field sensor u32 "0 for two solids; an overlap with a sensor otherwise: 1 a is the sensor, 2 b is, 3 both are."
  }

  const JOINT_FIXED u32 0 "`Joint.kind`: the two bodies move as one."
  const JOINT_REVOLUTE u32 1 "`Joint.kind`: a hinge about `axis` (2D: about z), with optional limits and a motor."
  const JOINT_PRISMATIC u32 2 "`Joint.kind`: a slider along `axis`, with optional limits and a motor."
  const JOINT_SPRING u32 3 "`Joint.kind`: a damped spring pulling the anchors to `restLength` apart."
  const JOINT_ROPE u32 4 "`Joint.kind`: a rope: the anchors stay at most `length` apart, free inside it."
  const JOINT_BALL u32 5 "`Joint.kind`: a ball and socket (3D; the 2D profile treats it as a hinge)."
  const MOTOR_NONE u32 0 "`Joint.motor`: no motor."
  const MOTOR_VELOCITY u32 1 "`Joint.motor`: drive towards `motorTarget` speed (rad/s or m/s)."
  const MOTOR_POSITION u32 2 "`Joint.motor`: spring towards `motorTarget` angle or position (a servo)."

  component Joint {
    doc "A joint between two bodies (or a body and a point of the world). The component may sit on one of the bodies (`body` 0) or on an entity of its own, so one body can have several joints. Anchors are in each body's frame (rotated and moved with it, not scaled); without `other` the second anchor is a world point. A joint whose bodies are not both `og.RigidBody` entities does nothing until they are."
    field kind u32 "JOINT_FIXED 0, JOINT_REVOLUTE 1 (hinge), JOINT_PRISMATIC 2 (slider), JOINT_SPRING 3, JOINT_ROPE 4, JOINT_BALL 5." {
      min 0
      max 5
      label "Kind"
    }
    field body Entity "The first body; 0 is this entity."
    field other Entity "The second body; 0 joins the first one to the world at `otherAnchor`."
    field anchor Vector3 "Where the joint sits on the first body, in its frame." {
      worldspace none
      unit m
    }
    field otherAnchor Vector3 "Where it sits on the second body, in its frame (a world point without `other`)." {
      worldspace hook
      unit m
    }
    field axis Vector3 "The hinge or slide axis in the first body's frame (a hinge in 2D turns about z)." {
      default 1 0 0
    }
    field limits bool "Whether `min`..`max` bound the hinge angle (rad) or the slide (m)."
    field min f32 "The lower limit: radians for a hinge, metres for a slider."
    field max f32 "The upper limit."
    field motor u32 "MOTOR_NONE 0, MOTOR_VELOCITY 1 (drive at motorTarget speed), MOTOR_POSITION 2 (spring to motorTarget)." {
      min 0
      max 2
    }
    field motorTarget f32 "The motor's target speed (rad/s, m/s) or angle or position (rad, m)." {
      tunable true
    }
    field motorStiffness f32 "A position motor's stiffness; a velocity motor's strength." {
      default 50
      min 0
      tunable true
    }
    field motorDamping f32 "A position motor's damping." {
      default 5
      min 0
      tunable true
    }
    field motorMaxForce f32 "The most force (or torque) the motor applies; 0 is unbounded." {
      min 0
      tunable true
    }
    field restLength f32 "A spring's rest length." {
      default 1
      min 0
      unit m
      tunable true
    }
    field stiffness f32 "A spring's stiffness (N/m)." {
      default 40
      min 0
      tunable true
    }
    field damping f32 "A spring's damping (N·s/m)." {
      default 2
      min 0
      tunable true
    }
    field length f32 "A rope's longest distance between the anchors." {
      default 2
      min 0
      unit m
      tunable true
    }
    field collide bool "Whether the two bodies still collide with each other."
    field value f32 "Written: the hinge angle (rad) or the slide (m) after the step; the anchors' distance for springs and ropes." {
      readonly true
    }
    field breakForce f32 "The force the joint holds before it breaks (JointBroken, `broken`): the solver's load on it through the step, its weight, gravity and what rests or presses on it; a lone impulse (applyImpulse, applyForce) is absorbed before it counts. 0 never breaks." {
      min 0
      unit newton
      tunable true
    }
    field breakTorque f32 "The torque about its anchor it holds before it breaks, as breakForce (a shelf bracket, a cantilevered beam); 0 never breaks." {
      min 0
      unit newtonMetre
      tunable true
    }
    field broken bool "Written: true once the joint broke; a broken joint holds nothing. Write false to mend it, rebuilt where its bodies are now."
  }

  component CharacterController {
    doc "A kinematic character (3D, or top-down 2D): the entity's capsule (or any og.Collider) moved by `move` each tick, sliding along walls, climbing slopes up to `maxSlope` and steps up to `stepHeight`, snapped to the ground, carried by the moving platform it stands on and falling by gravity. It keeps `skin` off every surface, standing that far over the ground; a step is climbed when the ground beyond it is at most `stepHeight` over the ground it stands on. What blocks it is every solid collider its og.Collider's `layers` and `mask` interact with (each one's layers meeting the other's mask), as for bodies. The entity needs an og.Transform and an og.Collider; the step makes it a kinematic body and pushes the dynamic bodies it walks into (`pushBodies`) with at most `pushStrength`, so a light one is shoved and a heavy one holds."
    field move Vector3 "The wanted velocity across the ground (m/s, world space; y is ignored unless gravityScale is 0). Set it every tick." {
      unit mps
    }
    field jump bool "Held to jump: a jump starts on the tick it becomes true while grounded (or in coyote time)."
    field jumpSpeed f32 "The upward speed of a jump." {
      default 6
      min 0
      unit mps
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity; 0 for top-down movement in any direction." {
      default 1
      min 0
      max 10
      tunable true
    }
    field maxSlope f32 "The steepest slope it walks up." {
      default 45
      min 0
      max 89
      unit deg
      tunable true
    }
    field stepHeight f32 "The highest step it climbs without jumping (0: none)." {
      default 0.3
      min 0
      unit m
      tunable true
    }
    field snapDistance f32 "How far below it the ground still holds it (stairs down, slopes): 0 lets it leave every edge." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field skin f32 "The gap kept between it and every surface." {
      default 0.02
      min 0.001
      unit m
    }
    field coyoteTime f32 "After leaving an edge, a jump still starts within this time." {
      default 0.1
      min 0
      unit s
      tunable true
    }
    field maxFallSpeed f32 "The fastest fall." {
      default 40
      min 0
      unit mps
      tunable true
    }
    field pushBodies bool "Push dynamic bodies it walks into, with at most `pushStrength`." {
      default true
    }
    field pushStrength f32 "The most force it pushes with: each tick the bodies it walks into share an impulse of at most this times the tick's length (mass times the speed it asks of them, capped), so a body of a few kilograms is shoved at its speed while one whose friction holds more (a tonne on the ground) does not move. 0 leaves every body where it is, as `pushBodies` false does." {
      default 1000
      min 0
      unit newton
      tunable true
    }
    field grounded bool "Written: standing on walkable ground after the step." {
      readonly true
    }
    field sliding bool "Written: sliding down a slope steeper than maxSlope." {
      readonly true
    }
    field velocity Vector3 "Written: the velocity it moved at this tick (the platform's carry included)." {
      unit mps
      readonly true
    }
    field groundNormal Vector3 "Written: the ground's normal (zero in the air)." {
      readonly true
    }
    field coyote f32 "Written: seconds left in which a jump may still start (coyote time)." {
      readonly true
    }
    field jumpWasHeld bool "Written: `jump` as the last step saw it (a jump starts on its rising edge)." {
      readonly true
    }
    field ground Entity "Written: the entity it stands on (0 in the air); a moving one carries it." {
      readonly true
    }
  }

  component PlatformerController {
    doc "A 2D platformer character (the 2D profile): run, jump and fall with designer units (jump height and time to apex, not gravity), coyote time, jump buffering, variable jump height (releasing jump while rising cuts the jump), apex hang, air jumps, wall slide and wall jump, one-way platforms (colliders on `oneWayLayers` are solid from above only; hold `down` to drop through), moving platforms (it rides what it stands on) and corner correction (a jump that clips a ceiling corner by less than `cornerCorrection` slides past it). It keeps `skin` off every surface; what blocks it is every solid collider its og.Collider's `layers` and `mask` interact with (each one's layers meeting the other's mask), as for bodies. The entity needs an og.Transform and an og.Collider (a box or capsule); it becomes a kinematic body and pushes the dynamic bodies it runs into (`pushBodies`) with at most `pushStrength`, so a crate's mass tells: a light one is shoved at the run speed, a heavy one holds (set its og.RigidBody `mass`)."
    field moveX f32 "The run input, -1 (left) to 1 (right). Set it every tick." {
      min -1
      max 1
    }
    field jump bool "Held to jump: a press is buffered for jumpBuffer; releasing while rising cuts the jump."
    field down bool "Held to drop through a one-way platform."
    field impulse Vector2 "A velocity change to take on the next step (a knock-back, a spring, a recoil): added to `velocity`, then set back to zero. One with an upward y leaves the ground; the run's acceleration and gravity act on the result from then on, so a knock-back is `{ x: away * 6, y: 7 }` with `moveX` 0 for its few ticks." {
      unit mps
    }
    field maxSpeed f32 "The top running speed." {
      default 8
      min 0
      unit mps
      tunable true
    }
    field acceleration f32 "How fast it reaches maxSpeed on the ground." {
      default 70
      min 0
      unit mps2
      tunable true
    }
    field deceleration f32 "How fast it stops on the ground without input." {
      default 80
      min 0
      unit mps2
      tunable true
    }
    field airAcceleration f32 "Acceleration in the air." {
      default 45
      min 0
      unit mps2
      tunable true
    }
    field airDeceleration f32 "Deceleration in the air without input." {
      default 25
      min 0
      unit mps2
      tunable true
    }
    field jumpHeight f32 "How high a full jump goes." {
      default 3.2
      min 0
      unit m
      tunable true
    }
    field timeToApex f32 "How long a full jump takes to reach its height (sets gravity and the jump speed)." {
      default 0.4
      min 0.05
      unit s
      tunable true
    }
    field fallGravity f32 "Gravity multiplier while falling (snappier landings above 1)." {
      default 1.8
      min 0
      tunable true
    }
    field jumpCut f32 "Gravity multiplier while rising with jump released (variable jump height; 1 disables it)." {
      default 2.5
      min 1
      tunable true
    }
    field apexGravity f32 "Gravity multiplier near the apex while jump is held (hang time; 1 disables it)." {
      default 0.6
      min 0
      max 1
      tunable true
    }
    field apexThreshold f32 "The vertical speed below which the apex multiplier applies." {
      default 1.5
      min 0
      unit mps
      tunable true
    }
    field maxFallSpeed f32 "The fastest fall." {
      default 20
      min 0
      unit mps
      tunable true
    }
    field coyoteTime f32 "After running off an edge, a jump still starts within this time." {
      default 0.1
      min 0
      unit s
      tunable true
    }
    field jumpBuffer f32 "A jump pressed this long before landing starts on landing." {
      default 0.12
      min 0
      unit s
      tunable true
    }
    field airJumps u32 "Extra jumps in the air (1: a double jump)." {
      min 0
      max 8
    }
    field wallJumps bool "Slide down walls it pushes against (and jump off them)." {
      default true
    }
    field wallSlideSpeed f32 "The fastest slide down a wall." {
      default 3
      min 0
      unit mps
      tunable true
    }
    field wallJump Vector2 "A wall jump's velocity: x away from the wall, y up." {
      default 8 12
      unit mps
      tunable true
    }
    field wallJumpLock f32 "After a wall jump, the run input is ignored for this long (so it leaves the wall)." {
      default 0.14
      min 0
      unit s
      tunable true
    }
    field oneWayLayers u32 "The collision layers that are one-way platforms (solid from above), as bits."
    field cornerCorrection f32 "How far a rising jump is nudged sideways past a ceiling corner (0: never)." {
      default 0.15
      min 0
      unit m
      tunable true
    }
    field maxSlope f32 "The steepest slope it runs up." {
      default 50
      min 0
      max 89
      unit deg
      tunable true
    }
    field snapDistance f32 "How far below it the ground still holds it (slopes, small drops)." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field skin f32 "The gap kept between it and every surface." {
      default 0.01
      min 0.001
      unit m
    }
    field pushBodies bool "Push dynamic bodies it runs into, with at most `pushStrength`." {
      default true
    }
    field pushStrength f32 "The most force it pushes with: each tick the bodies it runs into share an impulse of at most this times the tick's length (mass times the speed it asks of them, capped), so a body of a few kilograms is shoved at its speed while one whose friction holds more (a tonne on the ground) does not move. 0 leaves every body where it is, as `pushBodies` false does." {
      default 1000
      min 0
      unit newton
      tunable true
    }
    field grounded bool "Written: standing on ground after the step." {
      readonly true
    }
    field onWall i32 "Written: -1 sliding on a wall to its left, 1 to its right, 0 none." {
      min -1
      max 1
      readonly true
    }
    field facing i32 "Written: -1 facing left, 1 right (the last run direction)." {
      default 1
      min -1
      max 1
      readonly true
    }
    field velocity Vector3 "Written: the velocity after the step (the platform's carry excluded)." {
      unit mps
      readonly true
    }
    field jumping bool "Written: rising from a jump (until the apex or a release cut)." {
      readonly true
    }
    field airJumpsLeft u32 "Written: air jumps left before landing." {
      readonly true
    }
    field coyote f32 "Written: seconds of coyote time left." {
      readonly true
    }
    field buffer f32 "Written: seconds a buffered jump press stays valid." {
      readonly true
    }
    field wallLock f32 "Written: seconds the run input stays locked after a wall jump." {
      readonly true
    }
    field dropTime f32 "Written: seconds one-way platforms stay passable after dropping through." {
      readonly true
    }
    field jumpWasHeld bool "Written: `jump` as the last step saw it." {
      readonly true
    }
    field ground Entity "Written: the entity it stands on (0 in the air); a moving one carries it." {
      readonly true
    }
  }

  const CHARACTER_JUMPED u32 1 "`CharacterEvent.kind`: a jump from the ground (or in coyote time)."
  const CHARACTER_LANDED u32 2 "`CharacterEvent.kind`: touched the ground after being in the air."
  const CHARACTER_WALL_JUMPED u32 3 "`CharacterEvent.kind`: a jump off a wall."
  const CHARACTER_AIR_JUMPED u32 4 "`CharacterEvent.kind`: a jump in the air (PlatformerController.airJumps)."
  const CHARACTER_LEFT_GROUND u32 5 "`CharacterEvent.kind`: left the ground without jumping (ran off an edge)."
  const CHARACTER_BUMPED u32 6 "`CharacterEvent.kind`: hit a ceiling while rising."

  event CharacterEvent {
    doc "Something a CharacterController or PlatformerController did this step: the hooks for dust, squash, sounds and camera kicks. Read the next tick: the controllers move in the physics step, after the game's systems, so a jump pressed in tick T moves the character in T and its CHARACTER_JUMPED is read in T + 1 (og-feel §12 has the same-tick alternative)."
    field entity Entity "The character."
    field kind u32 "CHARACTER_JUMPED 1, LANDED 2, WALL_JUMPED 3, AIR_JUMPED 4, LEFT_GROUND 5, BUMPED 6." {
      min 0
      max 6
    }
    field speed f32 "The vertical speed at the moment (a landing's impact speed is negative)." {
      unit mps
    }
  }

  const DRIVE_REAR u32 0 "`Vehicle.drive`: the rear wheels drive."
  const DRIVE_FRONT u32 1 "`Vehicle.drive`: the front wheels drive."
  const DRIVE_ALL u32 2 "`Vehicle.drive`: every wheel drives."
  const VEHICLE_ARCADE u32 0 "`Vehicle.model`: the arcade car: engineForce, faded out towards maxSpeed."
  const VEHICLE_DRIVETRAIN u32 1 "`Vehicle.model`: an engine with a torque curve driving through a gearbox."

  component Vehicle {
    doc "A car on a dynamic chassis (the entity's og.RigidBody and og.Collider). 3D: a raycast car with four wheels (suspension, grip, steering on the front axle), or with the og.VehicleWheel children it has; its forward is the chassis's local +z (three.js Object3D.lookAt aims +z). 2D: two wheel bodies on sprung wheel joints (front at +x), driven by a motor. The implicit wheels are not entities: og.physics.vehicleWheels gives their poses (and each tyre's slip) for drawing, smoke and skid marks."
    doc "The defaults drive a road car of about 1,000 kg: give the chassis that mass (og.RigidBody.mass 1000), since a car-sized box at the collider's density 1 weighs a few kilograms and the engine's and brakes' newtons would throw it. The suspension and the grip scale with the chassis's mass (Bullet's units), the engine and the brakes do not: a heavier car wants proportionally more engineForce and brakeForce. og-feel §12 has the numbers a game starts from."
    doc "The wheel rays meet what the chassis's collider would (its og.Collider layers against the other's mask, and the other's layers against its mask), so two cars on layers that do not meet (a ghost beside the player) pass through each other."
    field throttle f32 "The accelerator, -1 (reverse) to 1. Set it every tick." {
      min -1
      max 1
    }
    field steer f32 "The steering, -1 (left) to 1 (right); 3D only." {
      min -1
      max 1
    }
    field brake f32 "The brake, 0 to 1." {
      min 0
      max 1
    }
    field wheelBase f32 "The distance between the front and rear axles." {
      default 2.6
      min 0
      unit m
      tunable true
    }
    field track f32 "The distance between the left and right wheels (3D)." {
      default 1.6
      min 0
      unit m
      tunable true
    }
    field wheelRadius f32 "The wheels' radius." {
      default 0.4
      min 0.01
      unit m
      tunable true
    }
    field mountHeight f32 "The height of the wheel mounts below the chassis centre." {
      default 0.2
      unit m
      tunable true
    }
    field suspensionRest f32 "The suspension's length at rest." {
      default 0.35
      min 0
      unit m
      tunable true
    }
    field suspensionTravel f32 "How far the suspension compresses or extends from rest." {
      default 0.25
      min 0
      unit m
      tunable true
    }
    field suspensionStiffness f32 "The suspension's stiffness." {
      default 30
      min 0
      tunable true
    }
    field suspensionDamping f32 "The suspension's damping." {
      default 4
      min 0
      tunable true
    }
    field grip f32 "The tyres' grip (3D: the friction slip, how much of its load a tyre holds before it slides: 2 grips a road car through a bend, below 1 it slides like a drift car; 2D: the wheels' friction)." {
      default 2
      min 0
      tunable true
    }
    field engineForce f32 "The engine's force at full throttle (3D: per driven wheel, in newtons: 2,500 on the two rear wheels push 1,000 kg at 5 m/s²; 2D: the motor's torque, N·m)." {
      default 2500
      min 0
      tunable true
    }
    field maxSpeed f32 "The top speed: the engine's force fades out towards it (throttle against the motion brakes first)." {
      default 40
      min 0
      unit mps
      tunable true
    }
    field brakeForce f32 "The brakes' force at full brake (3D: per wheel, in newtons, every wheel braking: 2,000 stop 1,000 kg at 8 m/s²; 2D: the wheels' braking torque)." {
      default 2000
      min 0
      tunable true
    }
    field maxSteer f32 "The front wheels' largest steering angle (3D)." {
      default 0.55
      min 0
      max 1.2
      unit rad
      tunable true
    }
    field drive u32 "DRIVE_REAR 0, DRIVE_FRONT 1, DRIVE_ALL 2." {
      min 0
      max 2
    }
    field wheelMass f32 "The wheels' mass (2D: the wheel bodies; 3D ignores it)." {
      default 20
      min 0.01
      unit kg
      tunable true
    }
    field rollInfluence f32 "How much the tyres' sideways grip rolls the chassis in a bend (3D): 0 pushes at the centre of mass's height, so the car corners flat and never tips over from steering (an arcade car); towards 1 at the road, the roll that tips a tall car over (rapier's own car uses 0.1, which rolls a 1,000 kg car at full lock above about 20 m/s). Raise it a little for body roll, with og.RigidBody.centerOfMass lowered to keep the car on its wheels." {
      min 0
      max 1
      tunable true
    }
    field speed f32 "Written: the forward speed (m/s; negative reversing)." {
      unit mps
      readonly true
    }
    field contacts u32 "Written: how many wheels touch the ground." {
      readonly true
    }
    field slip f32 "Written: the largest slip of its wheels (og.physics.vehicleWheels' `slip`): 0 every tyre grips, towards 1 one slides; for a squeal's volume or smoke without reading the wheels (3D; 0 in 2D)." {
      min 0
      max 1
      readonly true
    }
    field model u32 "VEHICLE_ARCADE 0 (engineForce, faded out towards maxSpeed) or VEHICLE_DRIVETRAIN 1 (an engine with a torque curve driving through a gearbox: gears, finalDrive, torqueCurve, the rpm fields; engineForce and maxSpeed are then unused). The drivetrain's torque at the driven wheels is the curve's at the engine's speed times throttle, the gear's ratio and finalDrive; the engine's speed follows the wheels while a gear is in." {
      min 0
      max 1
    }
    field handbrake f32 "The handbrake, 0 to 1: it brakes the handbrake wheels (3D: the rear pair, or the og.VehicleWheel children flagged `handbrake`; 2D: the rear wheel) with that share of brakeForce, takes their drive and loosens their grip, sideways and in all, towards handbrakeGrip: in a bend at speed the tail steps out, and driftGrip keeps it loose while it slides. A handbrake turn is a pull and a release: held, the car slows and the slide dies with its speed." {
      min 0
      max 1
    }
    field handbrakeGrip f32 "The handbrake wheels' grip at full handbrake, sideways and in all, as a share of their own (3D): 0.2 lets the tail step out in a bend at speed; 1 holds the line." {
      default 0.2
      min 0
      max 1
      tunable true
    }
    field driftGrip f32 "Drift tuning: the handbrake wheels' sideways grip while the car drifts (the handbrake is on, or one of them slid last step), as a share of their own (3D). 1 is off; around 0.6 holds a slide that the throttle and steering balance." {
      default 1
      min 0
      max 1
      tunable true
    }
    field gears List.f32.8 "Drivetrain: the forward gears' ratios, first gear first; empty uses 3.4, 2.2, 1.6, 1.25, 1.0, 0.82."
    field reverseRatio f32 "Drivetrain: the reverse gear's ratio." {
      default 3.2
      min 0
      tunable true
    }
    field finalDrive f32 "Drivetrain: the final drive's ratio, after every gear." {
      default 3.6
      min 0
      tunable true
    }
    field idleRpm f32 "Drivetrain: the engine's speed at rest." {
      default 900
      min 0
      unit rpm
      tunable true
    }
    field maxRpm f32 "Drivetrain: the rev limit: the engine gives no torque at or above it." {
      default 6800
      min 1
      unit rpm
      tunable true
    }
    field torqueCurve List.f32.8 "Drivetrain: the engine's torque (N·m) at full throttle, at evenly spaced speeds from 0 to maxRpm, interpolated between them; empty uses 140, 170, 195, 210, 215, 205, 185, 150 (a 1,000 kg road car's)."
    field automatic bool "Drivetrain: the gearbox shifts by itself, up at shiftUpRpm and down at shiftDownRpm, into reverse when throttle is negative at a standstill and back into first when it is positive. False leaves `gear` to the game (a manual gearbox)." {
      default true
    }
    field shiftUpRpm f32 "Drivetrain, automatic: the engine speed it shifts up at." {
      default 6000
      min 0
      unit rpm
      tunable true
    }
    field shiftDownRpm f32 "Drivetrain, automatic: the engine speed it shifts down at." {
      default 2800
      min 0
      unit rpm
      tunable true
    }
    field clutchTime f32 "Drivetrain: how long a gear change takes; the engine drives nothing meanwhile." {
      default 0.25
      min 0
      unit s
      tunable true
    }
    field gear i32 "Drivetrain: the gear, -1 reverse, 0 neutral, 1 and up forward. An automatic gearbox writes it; for a manual one the game sets it, and each change takes clutchTime." {
      min -1
      max 8
    }
    field rpm f32 "Written, drivetrain: the engine's speed, for the engine's sound and the tachometer." {
      unit rpm
      readonly true
    }
  }

  component VehicleWheel {
    doc "A wheel of the og.Vehicle it is a child of (down its og.Parent chain), at its og.Transform relative to the chassis: the hard point its suspension hangs from. A vehicle with og.VehicleWheel children (up to 16, in entity order) has those wheels in place of its four implicit ones, and og.physics.vehicleWheels lists them in that order: six-wheeled trucks, trikes, rear-wheel steering. 3D only; the 2D vehicle keeps its two wheels."
    field radius f32 "The wheel's radius." {
      default 0.4
      min 0.01
      unit m
      tunable true
    }
    field suspensionRest f32 "The suspension's length at rest, down from the wheel's position." {
      default 0.35
      min 0
      unit m
      tunable true
    }
    field suspensionTravel f32 "How far the suspension compresses or extends from rest." {
      default 0.25
      min 0
      unit m
      tunable true
    }
    field suspensionStiffness f32 "The suspension's stiffness." {
      default 30
      min 0
      tunable true
    }
    field suspensionDamping f32 "The suspension's damping." {
      default 4
      min 0
      tunable true
    }
    field grip f32 "The tyre's grip, as og.Vehicle's `grip`." {
      default 2
      min 0
      tunable true
    }
    field steer f32 "How much of the vehicle's steering it takes: 1 a front wheel, 0 none, negative steers the other way (rear-wheel steering)." {
      min -1
      max 1
      tunable true
    }
    field drive bool "Whether the engine drives it (og.Vehicle.drive is then unused)."
    field brake bool "Whether the brake brakes it." {
      default true
    }
    field handbrake bool "Whether the handbrake brakes it, and driftGrip applies to it."
  }

  component Rope {
    doc "A Verlet rope: `segments` links from the entity's world position (its og.Transform after its parents'; plus `offset`) to `end` (an entity, plus `endOffset`) or hanging free, swung by gravity and wind, colliding with every solid collider at `radius`. It moves nothing (one-way: a rope joint ties bodies together, og.Joint JOINT_ROPE). Its points are world state (the og.physics state block); og.physics.ropePoints reads them and the renderer draws the rope as a strip of `width` and `color`."
    field segments u32 "The number of links (points minus one)." {
      default 16
      min 1
      max 256
    }
    field length f32 "The rope's length at rest." {
      default 4
      min 0
      unit m
      tunable true
    }
    field offset Vector3 "The start's offset from the entity's position (world axes)." {
      unit m
    }
    field end Entity "The entity the far end is tied to; 0 leaves it free."
    field endOffset Vector3 "The far end's offset from `end`'s position." {
      worldspace none
      unit m
    }
    field iterations u32 "Constraint passes per step: more is stiffer, at more cost." {
      default 12
      min 1
      max 64
      tunable true
    }
    field damping f32 "How much of its velocity each point keeps per tick (1: none lost)." {
      default 0.99
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind)." {
      unit mps2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.05
      min 0
      unit m
      tunable true
    }
    field width f32 "The drawn width." {
      default 0.08
      min 0
      unit m
    }
    field color Vector3 "The drawn linear colour." {
      default 0.55 0.42 0.28
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  const SIMULATION_GAMEPLAY u32 0 "`Cloth.simulation`, `SoftBody.simulation`, `Garment.simulation`: simulated in the physics step on the CPU, deterministic: its points are world state that snapshots, replays, lockstep and the hash carry, and that og.physics.clothPoints, softBodyPoints and garmentPoints read. The default."
  const SIMULATION_VISUAL u32 1 "`Cloth.simulation`, `SoftBody.simulation`, `Garment.simulation`: simulated by the renderer on the GPU (XPBD in small steps), for looks only, never read back. The tick leaves it unsolved: its points (og.physics.clothPoints, softBodyPoints, garmentPoints) are its rest shape carried rigidly by the entity (a garment's: the skinned pose), SoftBody.volume stays 1 and SoftBody.center is that shape's mean, so gameplay reads a stable proxy and a headless server pays nothing. The drawn motion runs on tick time: frames that skip ticks step those too, up to eight, and a world restored, rolled back or more than eight ticks ahead starts again from the rest shape. It meets the colliders drawn this frame (og.Collider boxes, spheres, capsules and height fields; convex, cylinder and triangle-mesh shapes are passed through) and, with thickness, itself. Where RenderCapabilities.visualSimulation is false (no compute or no vertex storage) it draws that rest shape."
  const PIN_TOP u32 1 "`Cloth.pins` bit: the whole top row is pinned."
  const PIN_TOP_CORNERS u32 2 "`Cloth.pins` bit: the top-left and top-right corners are pinned."
  const PIN_LEFT u32 4 "`Cloth.pins` bit: the whole left column is pinned (a flag on a pole)."
  const PIN_TOP_RINGS u32 8 "`Cloth.pins` bit: every fourth point of the top row (curtain rings)."

  component Cloth {
    doc "A Verlet cloth: a `columns` × `rows` grid of points, `spacing` apart, hanging from the entity's world position (its og.Transform after its parents': its top-left corner, the grid laid out along the entity's local x and down -y), pinned by `pins` (pinned points follow the entity), with stretch and shear constraints, gravity, wind, collision against every solid collider and, with `thickness`, against itself. One-way like og.Rope; its points are world state. Drawn as a double-sided mesh with `material` (og.render.standardMaterial; 0: a plain cloth colour)."
    field columns u32 "Points across." {
      default 12
      min 2
      max 64
    }
    field rows u32 "Points down." {
      default 12
      min 2
      max 64
    }
    field spacing f32 "The rest distance between neighbouring points." {
      default 0.15
      min 0.001
      unit m
      tunable true
    }
    field pins u32 "Which points are pinned, a sum of PIN_* bits (1 top row, 2 top corners, 4 left column, 8 top rings)." {
      default 1
    }
    field iterations u32 "Constraint passes per step." {
      default 8
      min 1
      max 64
      tunable true
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.985
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind); the cloth flutters with it." {
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the cloth and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field thickness f32 "Self-collision: how far apart its points keep from the points of the cloth that are not their near neighbours (0: none). About `spacing` keeps a cloth that folds or piles up from passing through itself." {
      min 0
      unit m
      tunable true
    }
    field substeps u32 "Simulation steps per tick, each integrating and then solving `iterations` passes; with self-collision enough that a point moves less than `thickness` per step (a point moves at most half the thickness a step)." {
      default 1
      min 1
      max 16
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step (0: it slides freely; near 1 it sticks where it lands, so a cloth lowered onto the floor folds instead of spreading)." {
      min 0
      max 1
      tunable true
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain cloth."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
  }

  component Garment {
    doc "Cloth on a skinned character: glTF mesh `mesh` of the entity's og.Model (a skirt, a cape, a coat's tails), posed by the entity's og.Skeleton and simulated from there. Each tick the animation poses the mesh; then every point of it swings under gravity and wind and drags behind the motion, but stays within `maxDistance` of where the skinned pose puts it, never goes further than `backstop` behind it into the body, and keeps its edges' lengths. Points within `pinTop` of the garment's top, and points whose vertex colour's red or alpha is 0, stay on the skinned pose; red times alpha between 0 and 1 scales `maxDistance` (paint it in the modelling tool: white everywhere frees the whole garment; paint the alpha over a white colour to keep a textured garment's colours, which the red would tint, since an opaque material does not show the alpha). With `radius` it collides with every solid collider too. One-way like og.Cloth (it moves nothing), simulated in the physics step with the rest of the world, so it replays and snapshots carry it. The model draws the garment where the simulation leaves it, with motion vectors for TAA. 3D only. Its blendshapes are not applied."
    field mesh u32 "The glTF mesh of the entity's model that is the garment (its primitives together), as og.Blendshapes.mesh."
    field maxDistance f32 "How far a point may stray from where the skinned pose puts it." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field pinTop f32 "Points within this height of the garment's top at rest (the bind pose, the model's +y) stay on the skinned pose: a skirt's waistband, a cape's collar." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field backstop f32 "How far a point may go behind where the skinned pose puts it, against the skinned normal (0: never behind it, so it cannot sink into the body)." {
      min 0
      unit m
      tunable true
    }
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower stretches." {
      default 1
      min 0
      max 1
      tunable true
    }
    field bending f32 "How much it resists folding, 0 to 1 a pass (across each pair of triangles that share an edge): 0 drapes like silk, near 1 like leather." {
      default 0.1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 6
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 1
      min 1
      max 16
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.97
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind); the garment flutters with it." {
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the garment and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides with solid colliders at (0: no collision; the skinned pose, through `maxDistance` and `backstop`, holds it on the body). A character's own collider counts: keep it inside the body, or leave this 0." {
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      min 0
      max 1
      tunable true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
  }

  const SOFT_SPHERE u32 0 "`SoftBody.shape`: a sphere of `radius` (an icosphere; 2D a ring)."
  const SOFT_BOX u32 1 "`SoftBody.shape`: a box of `size` (each face a grid of `detail` + 1 cells; 2D a rectangle)."
  const SOFT_MESH u32 2 "`SoftBody.shape`: the closed surface of geometry `mesh` (3D only)."

  component SoftBody {
    doc "A PBD soft volume: a closed surface of points (2D: a ring in the xy plane) held by distance constraints along its edges and by one constraint on the volume it encloses (2D: its area), dropped under gravity and pushed out of every solid collider, so it lands, squashes and springs back: jelly, a water balloon, a slime. Built at the entity's world pose (its og.Transform after its parents') when it appears or its shape changes. It moves nothing (one-way like og.Cloth). Its points are world state (the og.physics state block); og.physics.softBodyPoints reads them and the renderer draws its surface with `material`."
    field shape u32 "SOFT_SPHERE 0, SOFT_BOX 1 or SOFT_MESH 2." {
      min 0
      max 2
    }
    field radius f32 "A sphere's radius." {
      default 0.5
      min 0.01
      unit m
      tunable true
    }
    field size Vector3 "A box's full extents." {
      default 1 1 1
      min 0
      unit m
    }
    field detail u32 "How finely its surface is divided: a sphere 0 to 3 (12, 42, 162 or 642 points; 2D 12 to 96), a box 0 to 7 (cells along a face's edge, minus one). A finer surface needs more iterations to hold its shape: at 642 points and stiffness below 1 the default 8 lets it spread." {
      default 2
      min 0
      max 7
    }
    field mesh Geometry "SOFT_MESH's geometry: a loaded glTF's (registered automatically) or one given to og.physics.setMesh; closed, its vertices welded where they meet."
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower lets the surface stretch and wobble." {
      default 1
      min 0
      max 1
      tunable true
    }
    field pressure f32 "The volume it keeps, as a share of its rest volume: 1 holds it, above inflates it, 0 holds none (it slumps like cloth)." {
      default 1
      min 0
      max 4
      tunable true
    }
    field volumeStiffness f32 "How much of its volume a pass restores, 0 to 1." {
      default 1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 8
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 16
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.995
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field thickness f32 "The distance its points keep from solids (0: no collision)." {
      default 0.03
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      default 0.3
      min 0
      max 1
      tunable true
    }
    field pinTop f32 "Points within this height of its top at rest are pinned to the entity and follow it (0: none): a water balloon on a string." {
      min 0
      unit m
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain one."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
    field volume f32 "Written: its volume (2D: area) now over its rest volume; below 1 squashed, above inflated." {
      default 1
      readonly true
    }
    field center Vector3 "Written: the mean of its points, in world space." {
      worldspace world
      unit m
      readonly true
    }
  }

  component Fluid2D {
    doc "A 2D particle fluid (any profile, in the xy plane): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005: pressure, near pressure, viscosity) on a fixed grid in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider (pushed out of bodies; they push nothing back) and stay inside `bounds` around the entity when it is set. Fluids of one `group` interact: by `density` they layer, by `mixing` they blend. Drawn as metaballs: the particles blurred into a field the renderer thresholds into one surface of `color`, on sprite layer `layer`."
    field count u32 "How many particles (spawned when the component appears or count changes)." {
      default 1000
      min 1
      max 8192
    }
    field size Vector2 "The spawn box, centred on the entity." {
      default 4 3
      unit m
    }
    field bounds Vector2 "The container around the entity (0 0: none; colliders still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.18
      min 0.01
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 1
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.15 it gets springy, then unstable)." {
      default 0.1
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.5
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (honey above 1)." {
      default 0.15
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone), and are drawn as one surface whose colour follows the mix; 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn jitter."
    field color Vector3 "The surface's linear colour." {
      default 0.15 0.45 0.95
    }
    field opacity f32 "The surface's opacity." {
      default 0.9
      min 0
      max 1
    }
    field blobScale f32 "The drawn size of each particle's blob (times radius)." {
      default 1.6
      min 0.1
      max 4
    }
    field threshold f32 "The field value where the surface starts (higher: thinner, separate drops)." {
      default 0.45
      min 0.01
      max 4
    }
    field layer i32 "The sprite layer it is drawn on."
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  component Fluid3D {
    doc "A 3D particle fluid (the 3D profile): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005: pressure, near pressure that gives surface tension, viscosity) over a spatial hash in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider, the terrain's height field included (pushed out; they push nothing back), and stay inside `bounds` around the entity when it is set. An emitter adds particles at `emitRate` up to `maxCount`; a sink box removes those that enter it. Fluids of one `group` interact: by `density` they layer, by `mixing` they blend. Drawn as a screen-space surface: the particles' depth smoothed into one surface, refracting what is behind by its thickness and reflecting the sky, lit by the scene's lights. Cost: about 0.9 ms of CPU a tick for 2000 particles at 1 substep, 1.8 ms at 2 (native and wasm alike), growing with the particles; keep a scene's fluids to a few thousand particles. The surface costs about 1.1 ms of GPU (an Apple M4 Pro, the fluid covering a third of a 1280×720 frame) whatever the particle count, growing with the pixels it covers."
    field count u32 "How many particles to spawn in the box (when the component appears or count or seed changes; 0: none, the emitter fills it)." {
      default 2000
      max 32768
    }
    field size Vector3 "The spawn box, centred on the entity." {
      default 2 1 2
      unit m
    }
    field bounds Vector3 "The container around the entity (0 on an axis: open on that axis; colliders and the terrain still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other. Cost grows with the particles, not the radius." {
      default 0.2
      min 0.02
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 10
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.05 it jitters, then springs apart)." {
      default 0.02
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.4
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (it also calms the surface; honey above 1)." {
      default 0.4
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone); 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick (each costs a full pass over the particles)." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn and emitter jitter."
    field maxCount u32 "The most particles alive at once (the emitter stops there)." {
      default 8192
      min 1
      max 32768
    }
    field emitRate f32 "Particles the emitter adds per second (0: no emitter)." {
      min 0
      max 20000
      tunable true
    }
    field emitOffset Vector3 "Where the emitter is, from the entity (world axes)." {
      unit m
    }
    field emitVelocity Vector3 "The velocity emitted particles start with." {
      unit mps
      tunable true
    }
    field emitRadius f32 "The half-size of the cube new particles appear in around the emitter." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field sinkOffset Vector3 "The sink's centre, from the entity (world axes)." {
      unit m
    }
    field sinkSize Vector3 "The sink box: particles that enter it are removed (0 0 0: no sink)." {
      unit m
    }
    field color Vector3 "The fluid's linear colour (what light passing through it keeps)." {
      default 0.2 0.55 0.9
    }
    field opacity f32 "How opaque a metre of it is (0: clear as glass, 1: opaque)." {
      default 0.6
      min 0
      max 1
    }
    field reflectivity f32 "How much it reflects (scales the Fresnel term)." {
      default 1
      min 0
      max 2
    }
    field refraction f32 "How far refraction bends what is seen through it." {
      default 1
      min 0
      max 4
    }
    field drawScale f32 "The drawn size of each particle (times radius)." {
      default 0.6
      min 0.1
      max 2
    }
    field smoothing f32 "How much the surface is smoothed (0: beads, 1: one surface)." {
      default 1
      min 0
      max 2
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  component WaterSurface {
    doc "Height-field water (3D): a `resolution` × `resolution` grid of heights over a `size` square centred on the entity (its y is the rest level), waves travelling at `waveSpeed` and fading by `damping`. Dynamic bodies crossing it push waves (splashes; og.Splash events) and float by `buoyancy`. The heights are world state; an og.Water on the same entity draws them."
    field resolution u32 "Grid points along each side." {
      default 64
      min 8
      max 256
    }
    field size f32 "The side of the square of water." {
      default 16
      min 0.1
      unit m
      tunable true
    }
    field waveSpeed f32 "How fast waves travel." {
      default 3
      min 0
      unit mps
      tunable true
    }
    field damping f32 "How much of a wave survives a second (1: no loss)." {
      default 0.4
      min 0
      max 1
      tunable true
    }
    field splash f32 "How strongly bodies push waves." {
      default 1
      min 0
      tunable true
    }
    field buoyancy f32 "The upward force on a submerged body per cubic metre of its box under water (0: bodies sink)." {
      default 9.81
      min 0
      tunable true
    }
    field drag f32 "How much a submerged body's velocity is slowed." {
      default 1.5
      min 0
      unit perSecond
      tunable true
    }
  }

  component WaterLine {
    doc "2D water for side-scrollers: a `width` × `depth` pool whose top edge (at the entity's y, centred on its x) is `columns` springs, each pulled to its rest height by `tension`, damped by `damping` and passing waves to its neighbours by `spread`. Bodies (and characters) crossing the surface splash it (og.Splash events) and float by `buoyancy`. The springs are world state; an og.Water2D on the same entity draws it."
    field width f32 "The pool's width." {
      default 12
      min 0.1
      unit m
      tunable true
    }
    field depth f32 "The pool's depth below the surface." {
      default 3
      min 0
      unit m
      tunable true
    }
    field columns u32 "Springs along the surface." {
      default 96
      min 4
      max 512
    }
    field tension f32 "How hard each spring pulls back to rest." {
      default 60
      min 0
      tunable true
    }
    field damping f32 "How fast a spring's motion dies." {
      default 2.5
      min 0
      tunable true
    }
    field spread f32 "How much of a spring's height its neighbours feel each pass (waves travel)." {
      default 0.25
      min 0
      max 0.5
      tunable true
    }
    field splash f32 "How strongly crossing bodies splash." {
      default 0.04
      min 0
      tunable true
    }
    field buoyancy f32 "The upward force on a submerged body per square metre of its box under water (0: bodies sink)." {
      default 12
      min 0
      tunable true
    }
    field drag f32 "How much a submerged body's velocity is slowed." {
      default 2
      min 0
      unit perSecond
      tunable true
    }
  }

  component Buoyancy {
    doc "Floats a dynamic rigid body (3D profile) on the water under it: an og.WaterSurface (at its rest level), an og.Water (a flat lake, or a sea with a wind: its waves as drawn, og.physics.waterHeight's) or both on one entity. Its hull is its colliders' box cut into `samples` cells a side, kept where a cell's centre lies in a solid collider; each cell under the surface pushes up by the water it displaces (Archimedes: `waterDensity` × its share of the colliders' volume × gravity plus the water's own acceleration, so it sinks with a crest that falls away rather than being flung clear) at that cell, so a hull rights itself, pitches and rolls with the waves, and is slowed by `drag` and `angularDrag` against the moving water as far as it is under. Computed in the tick, the same on every run and after a restore; the sea's waves are the absolute world's, so a body moved by og.WorldOrigin rides the same water. A body with it takes no og.WaterSurface `buoyancy` (only its splash). Insert it beside og.RigidBody and og.Collider: `{}` floats a body of the default density half under."
    field waterDensity f32 "The water's density, in og.Collider.density's units: the default 2 floats a body of the colliders' default density 1 half under, as wood floats; at 1 the same body hangs just under the surface, under it sinks." {
      default 2
      min 0
      unit kgPerM3
      tunable true
    }
    field samples u32 "Cells along each side of its colliders' box (1: one point at its centre; up to 12³ points): more follow its shape and the waves more closely, at more cost." {
      default 4
      min 1
      max 12
    }
    field drag f32 "How much of its speed through the water it loses each second when fully under (in part when in part); off-centre cells slow its turning too, so it settles instead of bobbing." {
      default 4
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field angularDrag f32 "How much of its spin it loses each second when fully under (in part when in part)." {
      default 3
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field submerged f32 "Written: the fraction of its hull under water after the last step (0 above it or out of water, 1 sunk): for wakes, splashes and a sinking ship." {
      min 0
      max 1
      readonly true
    }
  }

  event Splash {
    doc "Something crossed a water surface (og.WaterSurface or og.WaterLine): for splash particles and sounds. Read the next tick."
    field water Entity "The water's entity."
    field entity Entity "What crossed it."
    field point Vector3 "Where it crossed the surface." {
      worldspace world
      unit m
    }
    field speed f32 "Its vertical speed (negative going in)." {
      unit mps
    }
  }

  component Ragdoll {
    doc "A ragdoll over an og.Skeleton: a capsule body per bone with a parent, joints with limits between them (ball joints with cone limits in 3D; in 2D hinges about z, the bones rapier2d bodies in the xy plane at their animated z, for a skeleton laid out in that plane), built from the skeleton's rest pose. `weight` is where the pose comes from: 0 the animation (the bodies follow it kinematically), 1 the physics (the bodies are dynamic, starting with the animation's velocity); the pose drawn blends between them over `blendTime`, both ways. The bodies are world state (the og.physics state block), not entities."
    field weight f32 "0 animated, 1 ragdoll. Set it to 1 on a hit; back to 0 to recover." {
      min 0
      max 1
      tunable true
    }
    field blendTime f32 "How long the blend between animation and physics takes, both ways." {
      default 0.25
      min 0
      unit s
      tunable true
    }
    field mass f32 "The whole body's mass, shared by the bones by length." {
      default 60
      min 0.1
      unit kg
      tunable true
    }
    field thickness f32 "A bone capsule's radius as a fraction of its length." {
      default 0.22
      min 0.01
      max 1
      tunable true
    }
    field jointLimit f32 "How far each joint bends from the rest pose." {
      default 0.9
      min 0
      max 3.1
      unit rad
      tunable true
    }
    field damping f32 "How much of their motion the bones lose per second." {
      default 0.6
      min 0
      max 20
      unit perSecond
      tunable true
    }
    field impulse Vector3 "An impulse given to every bone when weight first goes up (a hit)."
    field blend f32 "Written: the blend in use (0 animation .. 1 physics)." {
      readonly true
    }
  }

  struct QueryFilter {
    doc "Which colliders a scene query considers. The zero value considers every solid collider on every layer."
    desc true
    field mask u32 "Layers to consider: a collider counts when its layers meet this; 0 means every layer."
    field includeSensors bool "Also report sensors."
    field exclude Option.Entity "An entity to ignore, such as the caster itself."
  }

  struct RaycastDesc {
    doc "A ray for og.physics.raycast."
    desc true
    field origin Vector3 "Where the ray starts." {
      unit m
    }
    field direction Vector3 "Where it points; it need not be normalised and must not be zero (in 2D, not zero in xy)." {
      default 0 -1 0
    }
    field maxDistance f32 "How far it reaches; 0 is unbounded." {
      min 0
      unit m
    }
    field filter QueryFilter "Which colliders count."
  }

  struct RaycastHit {
    doc "The nearest collider a ray meets."
    field entity Entity "The collider's entity."
    field body Entity "The body the collider belongs to: its own entity, or for a compound child collider (an og.Collider on a child of an og.RigidBody) the ancestor body it is part of."
    field distance f32 "From the origin along the normalised direction." {
      unit m
    }
    field point Vector3 "Where the ray meets the collider."
    field normal Vector3 "The surface normal there (z is 0 in 2D)."
  }

  struct RaycastAllDesc {
    doc "A ray for og.physics.raycastAll: og.physics.raycast's fields and a cap on the hits."
    desc true
    field origin Vector3 "Where the ray starts." {
      unit m
    }
    field direction Vector3 "Where it points; it need not be normalised and must not be zero (in 2D, not zero in xy)." {
      default 0 -1 0
    }
    field maxDistance f32 "How far it reaches; 0 is unbounded." {
      min 0
      unit m
    }
    field filter QueryFilter "Which colliders count."
    field maxHits u32 "The most hits returned, nearest first; 0 is MAX_RAYCAST_HITS (256), and more is held to it." {
      min 0
      max 256
    }
  }

  struct ProjectPointDesc {
    doc "A point for og.physics.projectPoint."
    desc true
    field point Vector3 "The point to project (its z is ignored in 2D)." {
      unit m
    }
    field maxDistance f32 "How far a collider may be; 0 is unbounded." {
      min 0
      unit m
    }
    field solid bool "A point inside a collider is its own projection (distance 0); false projects it onto the collider's surface." {
      default true
    }
    field filter QueryFilter "Which colliders count."
  }

  struct PointProjection {
    doc "Where a point projects onto the nearest collider."
    field entity Entity "The collider's entity."
    field body Entity "The body it belongs to (RaycastHit.body)."
    field point Vector3 "The nearest point on the collider, in world space." {
      unit m
    }
    field normal Vector3 "Unit direction out of the collider at the point, towards a point outside it (from a point inside, still outward); zero when the distance is 0."
    field distance f32 "From the queried point to `point`." {
      unit m
    }
    field inside bool "Whether the queried point is inside the collider."
  }

  struct ShapeDesc {
    doc "The shape of a shape cast or an overlap test: the shape fields of a Collider. The zero value is a 1 m box."
    desc true
    field shape u32 "One of the SHAPE_* codes." {
      min 0
      max 5
    }
    field size Vector3 "Full extents of a box." {
      default 1 1 1
      unit m
    }
    field radius f32 "Radius of a sphere, circle, capsule or cylinder." {
      default 0.5
      unit m
    }
    field height f32 "Capsule or cylinder height." {
      default 1
      unit m
    }
    field mesh Geometry "The geometry of a convex or triangle-mesh shape."
  }

  struct ShapeCastDesc {
    doc "A shape swept along a direction for og.physics.shapeCast."
    desc true
    field shape ShapeDesc "The swept shape."
    field position Vector3 "Where the sweep starts." {
      unit m
    }
    field rotation Quaternion "The shape's rotation; a zero quaternion is no rotation."
    field direction Vector3 "Where it sweeps; it need not be normalised and must not be zero." {
      default 0 -1 0
    }
    field maxDistance f32 "How far it sweeps; 0 is unbounded." {
      min 0
      unit m
    }
    field filter QueryFilter "Which colliders count."
  }

  struct ShapeCastHit {
    doc "The first collider a swept shape meets."
    field entity Entity "The collider's entity."
    field distance f32 "How far the shape travelled before touching." {
      unit m
    }
    field point Vector3 "The contact point on the hit collider, in world space."
    field normal Vector3 "The hit collider's surface normal there, in world space."
  }

  struct OverlapDesc {
    doc "A shape placed in the world for og.physics.overlap."
    desc true
    field shape ShapeDesc "The shape."
    field position Vector3 "Where it is." {
      unit m
    }
    field rotation Quaternion "Its rotation; a zero quaternion is no rotation."
    field filter QueryFilter "Which colliders count."
  }

  struct MeshDesc {
    doc "Geometry for convex and triangle-mesh colliders, in the mesh's own space."
    desc true
    field positions List.Vector3 "Vertex positions (2D polygons use x and y)."
    field indices List.u32 "Triangles as triples of indices into positions; a convex hull ignores them."
  }

  fn raycast {
    doc "The nearest collider along a ray. Inside a system it sees the colliders as they were at the start of the tick (og.physics.queries records them before the game's systems); between ticks, as the world holds them."
    param world World "The world."
    param desc RaycastDesc "The ray and the filter."
    returns Result.Option.RaycastHit "The hit, or null when nothing is hit; refused for a zero direction."
  }

  fn raycastAll {
    doc "Every collider along a ray within its reach, one hit each at its first crossing, nearest first (ties in collider entity order, so every host and run list them alike), at most `maxHits`: what a piercing shot passes through, everything under a cursor. The same view of the colliders as og.physics.raycast; its first hit is raycast's."
    param world World "The world."
    param desc RaycastAllDesc "The ray, the filter and the cap."
    returns Result.List.RaycastHit "The hits, nearest first; empty when nothing is hit; refused for a zero direction."
  }

  fn projectPoint {
    doc "The nearest point on any collider to a point, within maxDistance: snapping to a surface, the closest cover, whether a point is inside a solid. The same view of the colliders as og.physics.raycast."
    param world World "The world."
    param desc ProjectPointDesc "The point, its reach, solid or surface, and the filter."
    returns Result.Option.PointProjection "The projection, or null when no collider is within reach; refused for a point that is not finite."
  }

  fn shapeCast {
    doc "The first collider a shape meets when swept along a direction; the same view of the colliders as raycast."
    param world World "The world."
    param desc ShapeCastDesc "The shape, its sweep and the filter."
    returns Result.Option.ShapeCastHit "The hit, or null; refused for a zero direction or an unknown mesh."
  }

  fn overlap {
    doc "Every collider overlapping a shape, sorted by entity id; the same view of the colliders as raycast."
    param world World "The world."
    param desc OverlapDesc "The shape, its placement and the filter."
    returns Result.List.Entity
  }

  fn applyForce {
    doc "Push a dynamic body with a force (N, world axes) over the next physics step, at a world point or its centre of mass: call it every tick for a steady force (thrust, wind, a car's downforce or an anti-roll assist). Applied by the og.physics step after the systems, in the order given, then gone; a hit stop drops it. Kinematic and static bodies ignore it. Pushes not yet applied are world state (in snapshots and the hash)."
    param world World "The world."
    param entity Entity "The body's entity (an og.RigidBody)."
    param force Vector3 "The force in newtons (2D uses x and y)."
    param point Vector3 "Where it acts, in world space; omitted is the centre of mass (no spin)." {
      optional true
    }
    returns Result.Void "Refused for an entity without an og.RigidBody, or a force or point that is not finite."
  }

  fn applyImpulse {
    doc "Give a dynamic body an impulse (N·s, world axes) at a world point or its centre of mass: a sudden change of momentum (a kick, a hit, a jump: its velocity changes by impulse / mass), applied by the next physics step (after a hit stop ends). As applyForce otherwise."
    param world World "The world."
    param entity Entity "The body's entity (an og.RigidBody)."
    param impulse Vector3 "The impulse in newton-seconds (2D uses x and y)."
    param point Vector3 "Where it acts, in world space; omitted is the centre of mass." {
      optional true
    }
    returns Result.Void "Refused for an entity without an og.RigidBody, or an impulse or point that is not finite."
  }

  fn applyTorque {
    doc "Turn a dynamic body with a torque (N·m about each world axis; 2D uses z) over the next physics step, as applyForce: call it every tick for a steady twist."
    param world World "The world."
    param entity Entity "The body's entity (an og.RigidBody)."
    param torque Vector3 "The torque in newton-metres."
    returns Result.Void "Refused for an entity without an og.RigidBody, or a torque that is not finite."
  }

  fn applyTorqueImpulse {
    doc "Give a dynamic body an angular impulse (N·m·s about each world axis; 2D uses z): its spin changes at once, as applyImpulse."
    param world World "The world."
    param entity Entity "The body's entity (an og.RigidBody)."
    param torque Vector3 "The angular impulse in newton-metre-seconds."
    returns Result.Void "Refused for an entity without an og.RigidBody, or a value that is not finite."
  }

  fn setMesh {
    doc "Register (or replace) the geometry a convex or triangle-mesh Collider names by its mesh handle. Loaded glTF geometries are registered under their own handles already; meshes are assets, not world state: world.snapshot carries a mesh, convex-hull or height-field collider by its handle and scale, not its triangles, and world.restore rebuilds the collider from the geometry registered then (so load or register it before restoring; a save naming one that is not is refused)."
    param world World "The world."
    param mesh Geometry "The handle colliders name in Collider.mesh."
    param desc MeshDesc "Positions and triangles."
    returns Result.Void "Refused for an empty, non-finite or out-of-range mesh."
  }

  struct WheelPose {
    doc "A wheel of an og.Vehicle as the last step left it, for drawing."
    field position Vector3 "The wheel's centre in world space." {
      unit m
    }
    field rotation Quaternion "Its rotation (steering and spin) in world space."
    field contact bool "Whether it touches the ground."
    field slip f32 "How much the tyre slides (rapier's skid info turned round): 0 it grips, towards 1 it asks for more than its grip holds (0.5 is twice as much); 0 in the air and in 2D. Start smoke and skid marks above about 0.2, and fade a squeal in with it." {
      min 0
      max 1
    }
    field sideSpeed f32 "How fast the tyre's contact moves sideways over the ground (along its axle; 0 in the air and in 2D): a slide's speed, for the squeal's pitch or a skid mark's darkness." {
      unit mps
    }
    field entity Entity "The wheel's og.VehicleWheel entity; 0 for a vehicle's implicit wheels."
  }

  struct RagdollBoneDesc {
    doc "One bone of a ragdoll rig: a capsule from the bone's position along `axis` for `length`."
    desc true
    field parent i32 "The parent bone's index (it must come earlier); -1 for the root." {
      default -1
    }
    field position Vector3 "The bone's rest position relative to the entity." {
      unit m
    }
    field rotation Quaternion "The bone's rest rotation relative to the entity; a zero quaternion is no rotation."
    field length f32 "How long the bone is (to its child)." {
      default 0.25
      unit m
    }
    field axis Vector3 "The direction the bone points in its own frame (towards its child)." {
      default 0 1 0
    }
    field joint i32 "The skeleton joint (its index in the skin) the bone stands for, so the model is drawn with it; -1 for none." {
      default -1
    }
  }

  struct RagdollRigDesc {
    doc "The bones of a ragdoll, parents first, for og.physics.setRagdollRig; og.physics.ragdollRigFromSkeleton makes one from a model's skeleton."
    desc true
    field bones List.RagdollBoneDesc "The bones."
    field skeleton SkeletonAsset "The skeleton the bones' joints belong to (0: none): the entity's posed model is drawn blended towards the bones by og.Ragdoll.blend."
  }

  struct BonePose {
    doc "A ragdoll bone's pose as the last step left it (blended with the animation by og.Ragdoll.weight)."
    field position Vector3 "The bone's position in world space." {
      unit m
    }
    field rotation Quaternion "Its rotation in world space."
  }

  fn ropePoints {
    doc "An og.Rope's points after the last step, from its entity to its end (empty before its first step). The engine draws visible ropes itself; this is for game logic and custom drawing."
    param world World "The world."
    param entity Entity "The rope's entity."
    returns Result.List.Vector3 "Refused for an entity without an og.Rope."
  }

  fn garmentPoints {
    doc "An og.Garment's points after the last step, in the world: one per position of the garment's mesh (vertices at the same position, split along a seam, share one), in the order the mesh first uses them."
    param world World "The world."
    param entity Entity "The garment's entity."
    returns Result.List.Vector3 "Refused for an entity without an og.Garment, or one not simulated yet (it needs og.Model, og.Skeleton and a loaded og.load.animation of the model)."
  }

  fn clothPoints {
    doc "An og.Cloth's points after the last step, row by row (`columns` per row, rows downwards from the top edge)."
    param world World "The world."
    param entity Entity "The cloth's entity."
    returns Result.List.Vector3 "Refused for an entity without an og.Cloth."
  }

  struct SoftBodyPoints {
    doc "An og.SoftBody's surface after the last step."
    field points List.Vector3 "Its points, in world space."
    field indices List.u32 "Its triangles, three indices into `points` each, wound outwards (2D: a fan over the ring)."
  }

  fn softBodyPoints {
    doc "An og.SoftBody's points and the triangles of its surface after the last step (none before its first step). The engine draws visible soft bodies itself; this is for game logic (where it touches, how squashed it is) and custom drawing."
    param world World "The world."
    param entity Entity "The soft body's entity."
    returns Result.SoftBodyPoints "Refused for an entity without an og.SoftBody."
  }

  fn fluidParticles {
    doc "An og.Fluid2D's particle positions after the last step, in world space."
    param world World "The world."
    param entity Entity "The fluid's entity."
    returns Result.List.Vector2 "Refused for an entity without an og.Fluid2D."
  }

  fn fluid3dParticles {
    doc "An og.Fluid3D's particle positions after the last step, in world space (emitted particles last, in the order they appeared)."
    param world World "The world."
    param entity Entity "The fluid's entity."
    returns Result.List.Vector3 "Refused for an entity without an og.Fluid3D."
  }

  fn waterHeight {
    doc "The surface height of an og.WaterSurface (world y) or an og.WaterLine (world y at `x`; `z` ignored) at a point, as the last step left it, plus an og.Water's sea (og.Water.wind) at this tick, the surface it draws: for boats that bob and spray that starts on the surface."
    param world World "The world."
    param entity Entity "The water's entity."
    param x f32 "World x, in metres."
    param z f32 "World z, in metres (3D)."
    returns Result.f32 "Refused for an entity without water; outside the water, its rest level."
  }

  fn vehicleWheels {
    doc "An og.Vehicle's wheels after the last step (front left, front right, rear left, rear right; or its og.VehicleWheel children in entity order), for drawing wheel models."
    param world World "The world."
    param entity Entity "The vehicle's entity."
    returns Result.List.WheelPose "Refused for an entity without a vehicle."
  }

  fn ragdollRigFromSkeleton {
    doc "A ragdoll rig from a loaded skeleton (og.load.animation's `skeleton`): a bone per joint of its first skin, parents first, each from its joint's rest pose to its first child joint, every bone naming its joint and the rig naming the skeleton. Pass it to og.physics.setRagdollRig, edited or not."
    param world World "The world."
    param skeleton SkeletonAsset "The skeleton."
    returns Result.RagdollRigDesc "Refused for a skeleton that is not loaded or has no skin."
  }

  fn setRagdollRig {
    doc "Give an entity with an og.Ragdoll its bones (and, from og.physics.ragdollRigFromSkeleton, the skeleton they stand for: its og.Model is then drawn blended from the animation towards the bones by og.Ragdoll.blend). While weight is 0 the bones follow the rig's rest pose at the entity. Rigs are assets, not world state: kept by the engine and given again to a reloaded world."
    param world World "The world."
    param entity Entity "The ragdoll's entity."
    param desc RagdollRigDesc "The bones, parents first."
    returns Result.Void "Refused for an empty rig or a parent that does not come before its child."
  }

  fn ragdollPose {
    doc "An og.Ragdoll's bones after the last step, in rig order (empty before its first step)."
    param world World "The world."
    param entity Entity "The ragdoll's entity."
    returns Result.List.BonePose "Refused for an entity without a ragdoll."
  }

  struct PhysicsPhase {
    doc "One phase of the last physics step, for og.physics.stats."
    field name String "gather (reading the components), sync (bodies and static colliders into rapier), joints (joints and vehicles), ragdolls, water (buoyancy before the step), rapier (rapier's step, every substep), readout (touching pairs and bodies read back, the rest rule), controllers (characters and platformers), soft (ropes and cloths), fluids (2D), fluids3d or writeBack (components and events written back)."
    field ms f64 "Wall-clock time it took (0 where the host has no clock); never world state." {
      unit ms
    }
    field split bool "Whether any of its work ran on the lanes pool: rapier's stages when the step went to the pool, the other phases when they split by bodies, contact pairs, ragdolls, soft bodies or particles."
  }

  struct PhysicsStats {
    doc "What the last physics step cost, phase by phase, and where it ran: for finding where physics time goes. Timings are wall clock and vary run to run; the simulation never reads them."
    field tick f64 "The tick the step ran (0 before the first)."
    field bodies u32 "The rapier bodies it stepped (with ragdoll bones and vehicle wheels)."
    field threads u32 "The lanes pool's threads at the time (1: lanes off or single-threaded)."
    field pool bool "Whether the whole step ran on the lanes pool (from a number of bodies per thread count), where rapier splits its broad phase, narrow phase and solver."
    field ms f64 "Wall-clock time of the whole og.physics system, gather to write-back." {
      unit ms
    }
    field phases List.PhysicsPhase "Every phase, in the order they run."
  }

  fn stats {
    doc "What the last physics step cost: each phase's time and whether it ran on the lanes pool. All zero before the first step."
    param world World "The world."
    returns Result.PhysicsStats "Refused for an engine without physics."
  }
}

# ── atmosphere ────────────────────────────────────────────────────────────

