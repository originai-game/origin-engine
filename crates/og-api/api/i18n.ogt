module i18n {
  doc "Localization: one string table per locale (`.ogt` of `type strings`: `locale \"ja\"`, its font chain `fonts \"...\"`, `string \"key\" \"message\"`), messages in a subset of ICU MessageFormat (`{name}`, `{n, number}`, `{n, plural, =0 {..} one {..} other {..}}` with `#`, `{g, select, a {..} other {..}}`), CLDR plural rules, and the locale the host asks for (the browser's `navigator.language` on the web, `og run --locale` natively)."
  doc "The active locale is the best loaded table for the request (ja-JP takes ja; zh-TW takes zh-Hant or zh-TW), else the base table (`base true`, else en, else the first). A key it lacks is read from its `fallback` table, then the base. It also sets the UI's font chain (its fonts first, then the locale's installed font pack, then packs a frame needed for characters only they cover, then the other tables' fonts) and direction: a right-to-left locale (ar, he, fa, ur) mirrors og.ui's layout, and og-ui shapes Arabic words with the font's own tables (a font cooked with the `arabic` charset carries them). `og cook` warns about every key a locale lacks, or takes other arguments for, than the base."
  doc "Formatting (formatCompact, formatCurrency, formatDate, formatTime, formatDuration, and the message styles `{n, number, compact}`, `{p, number, currency/EUR}`, `{d, date, short}`, `{d, time}`) writes from a CLDR subset built into the engine, for the languages the plural rules cover and zh-Hant; another language is written as en. It follows the active locale (else the requested one, else en). A date or time is seconds since 1970-01-01 00:00 UTC that the game passes in (a save's timestamp, a server's event time): nothing reads a clock, so the same value gives the same text on every host and in a replay. A message's dates are UTC; formatDate and formatTime take an offset."

  enum DateStyle {
    doc "How much of a date to write (CLDR's styles; en shown)."
    variant medium "`Nov 2, 2026`."
    variant short "`11/2/26`."
    variant long "`November 2, 2026`."
    variant full "`Monday, November 2, 2026`."
    variant monthYear "A calendar heading: `November 2026`, `2026年11月`."
    variant monthName "The stand-alone month name: `November`."
    variant weekday "The weekday name: `Monday`."
    variant weekdayShort "The abbreviated weekday: `Mon`."
  }

  enum TimeStyle {
    doc "How much of a time of day to write (en shown)."
    variant short "`3:05 PM`."
    variant medium "`3:05:09 PM`, with seconds."
  }

  struct DateFormat {
    doc "How formatDate writes a moment."
    desc true
    field style DateStyle "How much of the date."
    field offsetMinutes i32 "Minutes ahead of UTC to show it in (a player's time zone, which the game passes in; 540 for Tokyo)."
  }

  struct TimeFormat {
    doc "How formatTime writes a moment."
    desc true
    field style TimeStyle "With or without seconds."
    field offsetMinutes i32 "Minutes ahead of UTC to show it in."
  }

  struct LocaleInfo {
    doc "The localization state."
    field requested String "The locale the host or the game asked for (empty: none)."
    field active String "The table in use (empty: none loaded)."
    field direction String "`ltr` or `rtl`."
    field locales List.String "Every loaded table's locale."
    field fonts List.String "The UI's font chain, first first."
  }

  fn load {
    doc "Load a cooked string table; the active locale is negotiated again."
    param world World "The world."
    param path String "The table, such as `strings/ja.ogt`."
    returns Result.LocaleInfo "Refused for a path that is not a cooked string table, or a font of its chain that is not cooked."
  }

  fn setLocale {
    doc "Ask for a locale (a player's choice in settings); the active one is the best table for it."
    aliases "language, change language, locale, localisation, localization, Godot TranslationServer.set_locale"
    param world World "The world."
    param locale String "A BCP 47 tag: `ja`, `zh-CN`, `ar-EG`."
    returns LocaleInfo
  }

  fn locale {
    doc "The requested and active locales, the direction and the font chain."
    param world World "The world."
    returns LocaleInfo
  }

  fn t {
    doc "A key's message in the active locale, formatted with its arguments; a key no table has answers the key itself and logs one warning."
    aliases "translate, localised string, localized text, gettext, Godot tr, Unity LocalizedString, translation key"
    param world World "The world."
    param key String "The key, such as `menu.start`."
    param args Json "The arguments: an object of strings and numbers, `{ count: 3, name: \"Kai\" }`." {
      optional true
    }
    returns String
  }

  fn has {
    doc "Whether the active locale's own table has the key (not a fallback)."
    param world World "The world."
    param key String "The key."
    returns bool
  }

  struct DecimalFormat {
    doc "Decimal formatting from the engine's shared CLDR data; no host Intl dependency."
    desc true
    field decimals Option.u32 "Exactly this many fractional digits (clamped to 20); null keeps up to three without trailing zeros."
    field grouping Option.bool "Use the locale's digit grouping; null defaults to true."
  }

  fn formatNumber {
    doc "A decimal number using the active locale's grouping, separators, native digits and sign. pseudo/en-XA expands and brackets output; ar-XB also isolates it right-to-left. Pseudo requests remain active for formatting even when translations fall back to a real table."
    param world World "The world (its active locale)."
    param value f64 "The number."
    param format DecimalFormat "Precision and grouping." {
      optional true
    }
    returns String
  }

  fn formatCompact {
    doc "A number written short in the active locale: `1.2K`, `12K`, `1.2M` (en), `1,2 Mio.` (de), `1.2万` (ja). Below the locale's first compact size (de compacts no thousands) the whole number, grouped."
    param world World "The world (its active locale)."
    param value f64 "The number."
    param decimals u32 "Optional fixed fraction digits, clamped to 20; omitted uses compact precision." {
      optional true
    }
    returns String
  }

  fn formatCurrency {
    doc "An amount of money in the active locale: `$1,234.50` (en), `1.234,50 €` (de), `￥1,235` (ja), with the currency's own fraction digits (none for JPY and KRW). A code the subset lacks is written as itself."
    param world World "The world (its active locale)."
    param amount f64 "The amount, in the currency's whole units (dollars, not cents)."
    param currency String "An ISO 4217 code: `USD`, `EUR`, `JPY`."
    returns String
  }

  fn formatDate {
    doc "A date in the active locale, in the style asked for: `Nov 2, 2026` (en), `02.11.2026` (de)."
    param world World "The world (its active locale)."
    param seconds f64 "Seconds since 1970-01-01 00:00 UTC; fractions are dropped."
    param format DateFormat "The style and offset (medium, UTC)." {
      optional true
    }
    returns String
  }

  fn formatTime {
    doc "A time of day in the active locale: `3:05 PM` (en), `15:05` (de)."
    aliases "time of day format, 12 hour clock, 24 hour clock"
    param world World "The world (its active locale)."
    param seconds f64 "Seconds since 1970-01-01 00:00 UTC; fractions are dropped."
    param format TimeFormat "The style and offset (short, UTC)." {
      optional true
    }
    returns String
  }

  enum DurationStyle {
    doc "How a duration is displayed."
    variant clock "Clock face: `1:02:03`, whole seconds rounded down."
    variant short "Narrow largest-unit label: `2h`, `3m`, rounded up; under a minute, whole seconds."
  }

  fn formatDuration {
    doc "A length of time as a clock face, `1:02:03` from an hour and `2:05` below, in the locale's digits; whole seconds, rounded down. og.ui's `duration` and `clock` formats are the in-document equivalents."
    param world World "The world (its active locale)."
    param seconds f64 "The length in seconds; negative is written with a minus."
    param style DurationStyle "Clock face (default) or a narrow cooldown label." {
      optional true
    }
    returns String
  }
}

# ── ui ────────────────────────────────────────────────────────────────────
