module load {
  doc "Asset loading from cooked output: `og cook` turns assets/ into cooked/ (.ogb blobs and the manifest cooked/.cook.ogt), and the runtime reads only cooked/."
  doc "Paths are asset ids: the path under assets/ (`models/ship.glb`, `scenes/main.ogt`); an `assets/` prefix is accepted. Every blob is checked against the manifest's type, schema version and cook stamp."
  doc "The game's bundle (`cooked`) opens before GameDesc.scene spawns. Runtime manifests and scene blobs may still be fetching: keep the pending handle and query status before instantiating. Pending loads complete at tick boundaries."
  guide "loading §1"
  core gltf font emitter texture animation rig flipbook tilemap vfx

  struct FieldData {
    doc "Lossless sampled scalar/vector lattice from type field; x fastest, then y, then z, channels interleaved. No normalization or resampling."
    field dimensions Array.u32.3 "Positive sample counts along x, y, z."
    field channels u32 "One to four scalar channels per cell; units and meaning belong to the author."
    field origin Array.f32.3 "Coordinates of the first lattice sample."
    field spacing Array.f32.3 "Positive distance between samples on each axis, in authored coordinate units."
    field values Float32Array "Finite samples; dimensions product times channels, at most 16,777,216 scalars."
  }

  fn field {
    doc "Read a cooked type field lattice without allocating world or GPU handles."
    param world World "The world whose bundle holds the field."
    param path String "The field asset path under assets/."
    returns Result.FieldData "Refused if missing, not resident, not a field, stale or invalid."
  }

  handle Asset "A loaded bundle, scene or glTF asset."
  handle Font "A cooked font: its file, which text is laid out and rastered from at the size it is drawn, or an icon set."
  handle Sound "A cooked sound: QOA-encoded PCM the audio module plays."
  handle Style "A cooked UI style: its values, atlas, fonts, icons and sounds loaded with it, for og.ui.configure."
  handle TextureArray "A cooked texture array: same-sized layers uploaded as one 2D-array texture (og.load.textureArray)."

  column TextureArray {
    doc "A TextureArray handle field (0 is none)."
    array Uint32Array
    stride 2
    value TextureArray
  }

  column Asset {
    doc "An Asset handle field."
    array Uint32Array
    stride 2
    value Asset
  }

  column Sound {
    doc "A Sound handle field."
    array Uint32Array
    stride 2
    value Sound
  }

  column Font {
    doc "A Font handle field (0 is none): a font og.load.font answered, kept for og.render.text or og.ui.configure."
    array Uint32Array
    stride 2
    value Font
  }

  column Style {
    doc "A Style handle field (0 is none): a UI style og.load.style answered, kept for og.ui.configure."
    array Uint32Array
    stride 2
    value Style
  }

  enum LoadStatus {
    doc "Where a load is."
    variant pending "Still loading."
    variant ready "Loaded; it can be instantiated."
    variant failed "Failed; og.load.error gives the reason."
  }

  struct GltfDesc {
    doc "How to load a glTF, as three.js GLTFLoader options where they apply."
    desc true
    field scene u32 "Which glTF scene to instantiate."
    field castShadow bool "Whether the models instantiated from it cast shadows: world.instantiate and a scene's `model` line give their og.Model this castShadow. On when omitted; false turns it off. The flags belong to the asset: another og.load.gltf of the path answers the same handle and sets them again, for later models." {
      guide "loading §2"
      default true
    }
    field receiveShadow bool "Whether the models instantiated from it receive shadows (og.Model.receiveShadow, as castShadow): on when omitted; false lights them as if unshadowed by every light." {
      default true
    }
  }

  struct GltfPart {
    doc "One placed primitive in the model's default scene. Repeated nodes and instances produce separate parts."
    field geometry Geometry "Mesh-local geometry; transform places it in model space."
    field material Material "This part's material."
    field transform Matrix4 "Primitive-to-model placement, including node ancestors and instance transforms, or the skinned node's bind placement."
  }

  struct ModelShape {
    doc "A cooked model's shape in its own space (og.Model's frame before its og.Transform): the axes a principal-axis fit of its triangles finds, its length and its top surface along that length. Place and turn things on a model from these, never from hand measurements (`physics §6.1`)."
    field forward Vector3 "Its long axis, a unit vector, signed towards +Z (else +X): a whale's or a ship's nose-to-tail line, either way round."
    field up Vector3 "Of the other two axes the one nearest +Y, signed upward."
    field centre Vector3 "The middle of its length on the area-weighted centre line: where `top` heights are measured from."
    field length f32 "Its extent along forward." {
      unit m
    }
    field top List.f32 "Its top surface's height above `centre` along up at 16 evenly spaced stations along forward, from the back (forward's least) to the front, each at the middle of its sixteenth: where a line down the centre line first meets the surface, else the highest point of that slice."
  }

  struct GltfInfo {
    doc "What a loaded glTF holds."
    field scenes u32 "How many scenes it has."
    field geometries List.Geometry "Mesh-local geometries, without node placement. Use parts to read each placement in model space."
    field parts List.GltfPart "Placed primitives in the default scene, in draw order."
    field materials List.Material "Its materials, in glTF order, then the default material."
    field variants List.String "Its material variants' names (KHR_materials_variants), in glTF order: og.Model.variant draws an instance with one, by its index here. Empty for a model without variants."
    field lights u32 "How many punctual lights (KHR_lights_punctual) its default scene has: world.instantiate and a scene's `model` line spawn each as a child entity of the model's, with an og.PointLight, og.SpotLight or og.DirectionalLight at its node's place, converted from glTF's units." {
      guide "loading §2"
    }
    field shape Option.ModelShape "Its shape facts from the cook; null for an uncooked load (og.load.gltfData) or a model without triangles."
    field animations List.String "Its clip names, in glTF order, from the model's `#anim` blob (empty for a model without clips): a skinned glTF's animations, an animated `.vox`'s `frames` or `voxClip` names. og.load.animation answers the same clips with their ClipAsset handles and durations, and og.anim.clip finds one by name."
  }

  struct BundleInfo {
    doc "An open cooked bundle."
    field path String "The cooked directory it was opened from."
    field assets u32 "Source assets it holds."
    field outputs u32 "Cooked outputs (blobs) it holds."
  }

  struct FontInfo {
    doc "A loaded font's metrics, in em units unless stated."
    field family String "The family its file names, as a font-family list calls it; empty for an icon set."
    field weight f32 "Its default weight (OS/2's weight class, 400 regular)."
    field axes List.String "Its variation axes' tags (wght, wdth, opsz …); empty for a static face."
    field ascender f32 "Ascender above the baseline."
    field descender f32 "Descender below the baseline (negative)."
    field lineHeight f32 "Ascender minus descender plus the line gap."
    field icons u32 "The icons of an icon set (an `.ogt` of `type icons`, SVGs cooked like a font for UiDesc.icons.font); 0 for a text font."
  }

  struct SoundInfo {
    doc "A loaded sound."
    field rate u32 "Samples per second." {
      unit hz
    }
    field channels u32 "Interleaved channels."
    field frames u32 "Samples per channel."
    field seconds f32 "Its length." {
      unit s
    }
    field chunks u32 "The chunks it was cooked in, the first included; 0 when it was cooked whole. A chunked sound is never resident whole: the engine reads its chunks from about half a second behind each playhead to four seconds ahead and drops the rest." {
      guide "loading §3"
    }
  }

  struct TextureArrayInfo {
    doc "What og.load.textureArray uploaded."
    field array TextureArray "The array."
    field width u32 "Each layer's width in texels."
    field height u32 "Each layer's height in texels."
    field layers u32 "Its layers, in the order the file lists them."
    field levels u32 "Mip levels of each layer."
    field format String "The encoding on the GPU: `rgba8`, or the block format the device takes for its kind (`bc7`, `bc5`, `astc4x4`, `etc2`, `eacrg11`)."
    field bytes f64 "Bytes it takes on the GPU, every level of every layer (counted in the frame's texture bytes)."
  }

  component Model {
    doc "Draws a loaded glTF's default scene at the entity's world transform: every mesh node with its glTF material. Scene entities with a `model` line get one; world.instantiate of a glTF asset spawns one."
    doc "The glTF's materials are shared by every instance of it; `tint` and `flash` are this instance's own, carried with its transform to the lit shaders (one draw for every instance, whatever each shows), so one of a crowd can flash when struck."
    field asset Asset "The glTF asset."
    field tint Color "A linear colour, 0 to 1 a channel, multiplied with every material's base colour on this instance only (white: as the glTF)." {
      default 1 1 1
    }
    field flash f32 "A hit flash on this instance only: the lit colour mixed towards flashColor by this much (og.tween.flash fades it out)." {
      min 0
      max 1
      tunable true
    }
    field flashColor Color "The flash's linear colour." {
      default 1 1 1
    }
    field castShadow bool "Every mesh of the model casts shadows, as Mesh.castShadow: drawn into the sun's cascades and the shadowed lights' maps. On by default, unlike Mesh's; false takes this instance out of every shadow pass. Set from GltfDesc.castShadow unless the scene gives the entity a `Model` table." {
      guide "loading §2"
      default true
    }
    field receiveShadow bool "Every mesh of the model receives shadows, as Mesh.receiveShadow; false lights this instance as if unshadowed by every light. On by default. Set as castShadow is, from GltfDesc.receiveShadow or the scene's `Model` table." {
      default true
    }
    field visible bool "Whether it is drawn, as Mesh.visible: false skips every draw of this instance (its meshes, its shadows) while it keeps its transform, its animation and its physics, so a ghost car or a pickup waiting to respawn is hidden without moving it away." {
      default true
    }
    field lodBias f32 "This instance's level of detail bias, multiplied with RenderSettings.lodBias: the renderer draws the coarsest cooked level whose error covers less than a pixel at the model's distance. Above 1 keeps detail farther, below 1 drops it sooner; 0 always draws the full mesh." {
      guide "loading §2"
      default 1
      min 0
      max 16
      tunable true
    }
    field layers u32 "Three.js layers of every mesh of the model, as Mesh.layers." {
      default 1
    }
    field sway f32 "How much og.Wind sways this instance, as it sways og.TerrainScatter copies: 0 still (the default), 1 as it blows. Each vertex above the model's origin moves downwind by its height; its shadow and depth move with it. Visual only: the simulation never reads it, and a tick sways the same on every run." {
      guide "loading §2"
      min 0
      max 2
      tunable true
    }
    field static bool "Part of its scene's baked lighting: og bake lightmaps traces the light arriving at it into the scene's lightmap, and while the bake matches the scene it takes its ambient light from there (its lights' direct light still drawn every frame, a static one's excepted). Unbaked, it draws as any model." {
      guide "loading §2"
    }
    field variant i32 "The glTF material variant this instance draws (KHR_materials_variants), an index into GltfInfo.variants: every mesh the variant maps takes its material, the others keep theirs, on this instance only. -1 draws the glTF's own materials; an index past the model's variants does too." {
      guide "loading §2"
      default -1
      min -1
      tunable true
    }
  }

  fn bundle {
    doc "Open another cooked bundle and register its streaming groups, including cell groups. Loads and group residency use that bundle once ready. A group name already declared by another open bundle fails the open, naming both bundles."
    doc "Scene, sub-scene and model dependencies resolve from their own bundle first, with loads cached per bundle and path. An id absent there falls back to the boot bundle, then ready bundles in open order. Direct og.load calls use that fallback order."
    guide "world §4"
    param world World "The world that owns the asset."
    param path String "The cooked directory, relative to the project (or the page), such as `dlc/cooked`."
    returns Result.Asset "The bundle's handle: ready or failed at the call when the host has its manifest (natively always), else pending until a tick boundary. og.load.completions journals the tick, so a replay opens it at the same one."
  }

  fn bundleInfo {
    doc "What an open bundle holds."
    param world World "The world that owns the asset."
    param asset Asset "A bundle handle; the game's own bundle is og.load.bundle's first answer, also given by `defaultBundle`."
    returns Result.BundleInfo "Refused for a pending, failed or non-bundle asset."
  }

  struct LoadProgress {
    doc "How far a load has arrived (og.load.progress)."
    field status LoadStatus "Where it is."
    field received f64 "Bytes received so far of what it fetches (a bundle: its manifest)." {
      unit bytes
    }
    field bytes f64 "Bytes it fetches in all, once the host knows (0 before the first response)." {
      unit bytes
    }
    field fraction f32 "received over bytes, 0 to 1; 1 once ready, 0 when failed or not known yet." {
      min 0
      max 1
    }
  }

  fn progress {
    doc "How far a load has arrived: a bundle og.load.bundle opened, or any handle (a cooked load answers ready at once). Answered from what the host has received, for a loading screen; natively a read completes at once."
    guide "loading §12"
    param world World "The world that owns the asset."
    param asset Asset "The handle."
    returns Result.LoadProgress "Refused for a handle that is not alive."
  }

  fn defaultBundle {
    doc "The game's own bundle, opened before the first tick from `cooked/`."
    param world World "The world that owns the asset."
    returns Result.Asset "Refused when cooked/ was missing or unreadable (run og cook); the reason names the path."
  }

  fn gltf {
    aliases "load a 3D model, model loader, GLTFLoader, glb, gltf model, import a mesh"
    doc "Load a cooked glTF (.gltf or .glb), as three.js GLTFLoader.load: its meshes, materials and textures join the renderer once."
    doc "A MagicaVoxel `.vox` cooks to a glTF and loads here too, its frames as clips og.AnimationPlayer plays; its import settings size and place it."
    guide "loading §2"
    param world World "The world that owns the asset."
    param path String "The asset id, such as `models/ship.glb`."
    param desc GltfDesc "Scene and shadow options."
    returns Result.Asset "The handle, or why it was refused (an uncooked path, a cook stamp mismatch, no open bundle)."
  }

  fn scene {
    doc "Load a cooked scene (.ogt). world.instantiate spawns its entities: depth first, parents before children, each component table matched to a registered component by its reflected name (`Transform` is og.Transform) and migrated field by field; a field the scene lacks keeps its default, one the component lacks is dropped with a warning."
    param world World "The world that owns the asset."
    param path String "The scene's asset id, such as `scenes/main.ogt`."
    returns Result.Asset "The stable handle, pending while its blob is fetched. Query status; error gives a failed load's reason."
  }

  fn prefab {
    doc "Load a cooked prefab (an .ogt of `type prefab`: one entity tree authored once and placed many times, docs/design.md §2.5). world.instantiate spawns it as it spawns a scene, its root under the desc's root entity, each entity unnamed (place a prefab many times without name clashes) and carrying an og.PrefabLink. A scene places one with a `prefab` line in an entity, and the cook flattens it there."
    param world World "The world that owns the asset."
    param path String "The prefab's asset id, such as `prefabs/crate.ogt`."
    returns Result.Asset "The prefab, or why not (not cooked, or not a prefab)."
  }

  component PrefabLink {
    doc "Where an entity came from when it was placed from a prefab: a scene's `prefab` line (flattened by the cook) or world.instantiate of og.load.prefab's asset. The engine writes it as the entity spawns and never changes it; it is world state like any component (snapshots, restores, the hash). A world that never placed a prefab does not register it, so its saves and hash are as before."
    field prefab Asset "The prefab placed (a prefab nested in another links to the outermost one placed). Loaded as og.load.prefab loads it." {
      readonly true
    }
    field node u32 "The entity's node: its index in the prefab's own entity table, depth first with parents first (0 is the prefab's root)." {
      readonly true
    }
    field root Entity "The instance's root entity (the root's own, for the root)." {
      readonly true
    }
  }

  fn font {
    doc "Load a cooked font for og.render.text, or an icon set (an `.ogt` of `type icons`: SVG icons cooked into a distance-field atlas like a font) for UiDesc.icons.font. Synchronous on both hosts: an ungrouped font-pack face must be in the cook's boot preload set. Undeclared paths are refused on both hosts, even if their bytes are resident; name them in game code or project.ts publish.keep and recook (loading guide §1). Optional locale coverage uses og.i18n."
    param world World "The world that owns the font."
    param path String "The font's asset id, such as `fonts/NotoSansSC-Regular-subset.ttf`."
    returns Result.Font
  }

  fn fontInfo {
    doc "A loaded font's metrics."
    param world World "The world that owns the font."
    param font Font "The font."
    returns Result.FontInfo "Refused for a dead font."
  }

  fn sound {
    doc "Load a cooked sound for the audio module. Sounds are `.wav`, `.mp3`, `.ogg` (Vorbis) and `.flac` files under assets/ (and procedural `.ogt` presets): og cook decodes each to 16-bit PCM and encodes it to QOA, so every format plays, streams and loops the same. The asset id keeps the source's extension (`audio/theme.mp3`)."
    doc "A long sound can be cooked in chunks that follow the playheads (SoundInfo.chunks), so it is never resident whole; it plays sample for sample as the whole file would. A sound cooked in chunks cannot join a streaming group."
    guide "loading §3"
    param world World "The world that owns the sound."
    param path String "The sound's asset id, such as `audio/blip.wav`."
    returns Result.Sound
  }

  fn lut {
    doc "A colour lookup table for PostEffects.lut, from a cooked `.cube` file (Adobe/Resolve 3D LUT; other sizes are resampled to 32). Loaded once per path. One in a streaming group's pack loads once its group is resident (refused before, naming the group); while the group is unloaded PostEffects.lut grades nothing with it, and it comes back under the same handle."
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `luts/warm.cube`."
    returns Result.Lut "Refused for a path not in the bundle (the reason says to run og cook)."
  }

  fn environment {
    doc "A prefiltered environment map for Environment.map, from a TS file.environment declaration (an equirectangular HDR/EXR or sRGB image, a KTX2 cube map, or six faces). The cook produces five GGX levels and nine diffuse irradiance harmonics; loading only uploads them. One in a streaming group's pack loads when its group is resident, and the sky lights the scene until then. Loaded once per path."
    guide "loading §4"
    param world World "The world whose renderer owns it."
    param path String "The canonical content id, such as `base/env/studio`."
    returns Result.EnvironmentMap "Refused for a path not in the bundle (the reason says to run og cook) or not an environment map."
  }

  struct EnvironmentSun {
    doc "The sun a cooked environment took out of its lighting image, for the DirectionalLight that puts it back. LDR panoramas extract by default; their intensity is a relative-radiance estimate from the clipped disc and circumsolar gradient, not measured lux. HDR sources integrate measured radiance."
    field direction Vector3 "The world-space unit direction towards the sun: both the cook's rotation and the runtime rotation argument are applied."
    field color Color "Its linear colour, the largest channel 1: DirectionalLight.color."
    field intensity f32 "DirectionalLight.intensity units, including cooked and runtime intensity: assign directly. 0 for sun keep, no detected sun or an uncooked map. LDR estimates share the sky's relative linear-radiance scale, not calibrated lux."
    field angularSize f32 "The apparent disc diameter in radians (solid-angle equivalent diameter of the extracted region); 0 when none was found. An estimate for clipped LDR images."
  }

  fn environmentSun {
    doc "The sun a cooked environment map holds apart from its image (sun: 'extract' in file.environment): the direction, colour and intensity to give a DirectionalLight, so the sun is counted once, casts shadows and leaves no speckle in rough reflections. An image's sun left in the map lights without shadows, and a DirectionalLight beside it adds the sun a second time."
    guide "loading §4"
    param world World "The world whose renderer owns the map."
    param map EnvironmentMap "A map og.load.environment answered."
    param rotation f32 "The Environment.rotation in radians about +Y; applied here, not by the game." {
      default 0
    }
    param intensity f32 "The Environment.intensity multiplier, applied here to the cooked sun, in the same scale as the map lighting." {
      default 1
    }
    returns Result.EnvironmentSun "Refused for a handle that is not an environment map, or one whose streaming group is not resident yet."
  }

  struct EnvironmentSunTurn {
    doc "The Environment.rotation og.load.environmentSunRotation answered, and where the map's sun stands after it."
    field rotation f32 "The Environment.rotation to set, in radians about +Y (-pi to pi); pass the same to og.load.environmentSun for the DirectionalLight."
    field direction Vector3 "The world-space unit direction towards the sun after the turn: og.load.environmentSun's direction at `rotation`."
    field elevation f32 "The sun's elevation above the horizon in radians, which is the map's own: a turn about +Y never changes it, so a sun lower or higher than wanted needs another sky."
  }

  fn environmentSunRotation {
    doc "The Environment.rotation that puts a cooked map's sun at `azimuth` around a view direction, so a sky is turned by where its sun should be (\"light from behind the camera's left\") instead of by a hand-tuned angle. The answer is exact for the map's extracted sun (og.load.environmentSun at rotation 0); its elevation is the map's, reported in `elevation`."
    host false
    guide "render §4"
    param world World "The world whose renderer owns the map."
    param map EnvironmentMap "A map og.load.environment answered, cooked with its sun extracted."
    param view Vector3 "The direction the view looks, such as the camera's forward; only its horizontal part counts."
    param azimuth f32 "Where the sun stands around the view, in radians from straight ahead and positive to the view's right: 0 ahead (the subject backlit), pi behind the viewer (the subject lit from the front), -pi/2 to its left, -3pi/4 behind its left shoulder."
    returns Result.EnvironmentSunTurn "Refused when og.load.environmentSun refuses the map, when the map holds no sun (its cook found none: the cook's report says why), when the sun stands straight overhead (no turn moves it), or when `view` is vertical."
  }

  fn emitter {
    doc "A particle emitter asset for ParticleSystem.emitter, from a cooked `.ogt` of `type particles`: its shape, emission, motion, look, rendering (billboards, meshes or 2D sprites), collision, sub-emitters and events. Every line runs the same in compute and on the CPU path. The textures, texture array, mesh model, effect material and sub-emitters it names are loaded with it (a sub-emitter that fires its parent is refused); while the array's streaming group is not resident its systems draw nothing. Loaded once per path."
    guide "loading §5"
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `fx/sparks.ogt`."
    returns Result.ParticleEmitter "Refused for a path not in the bundle, or a texture, texture array, model or sub-emitter it cannot load."
  }

  fn effect {
    doc "An effect material for og.Trail.effect and og.Beam.effect, from a cooked `.ogt` of `type effect` (the file emitters and composed effects name with `effect`): its textures, UV motion, erosion, fresnel and hook shader, loaded with it. Loaded once per path."
    guide "effect-files §2"
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `fx/slash.ogt`."
    returns Result.EffectMaterial "Refused for a path not in the bundle, not an effect, or a texture or shader it cannot load."
  }

  fn shader {
    doc "A material shader for og.render.shaderMaterial, from a cooked `.ogt` of `type shader` (its WGSL compiled by the cook for every back end): `mode hooks` (the default) defines hooks of the lit shader; `mode full lit` or `mode full unlit` defines its own vertex and fragment entries over the binding contract, which the prepass and every shadow pass draw through too. Loaded once per path."
    guide "loading §6"
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `shaders/dissolve.ogt`."
    returns Result.Shader "Refused for a path not in the bundle or not a shader."
  }

  fn post {
    doc "A custom post pass for PostEffects.custom, from a cooked `.ogt` of `type post`: `code` or `source` (a `.wgsl` beside it) defining `fn post(f: PostInput, p: Params) -> vec4<f32>` and `param <name> float|vec2|vec3|vec4|color <default...>` lines (at most eight). The function reads previous(uv), scene_color(uv), depth(uv), normal(uv) and f.uv, f.pixel, f.size, f.time, and returns linear HDR colour. The cook compiles it for every back end. Loaded once per path."
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `post/crt.ogt`."
    returns Result.Post "Refused for a path not in the bundle or not a post pass."
  }

  fn vector {
    doc "A cooked vector from a TS file.vector declaration: source is a module-relative SVG path, or svg supplies inline XML, with optional positive tolerance in view-box units. Paths, basic shapes, groups, transforms, colours and linear/radial gradients become antialiased triangles; unsupported SVG elements are refused by name. Loaded once per path."
    param world World "The world whose renderer owns it."
    param path String "The canonical asset id, such as `base/ui/emblem`."
    returns Result.VectorArt "Refused for a path not in the bundle or not a vector."
  }

  fn uiMaterial {
    doc "A custom UI material resource from a cooked `.ogt` of `type ui-material`: `code` or `source` (a `.wgsl`) defining `fn material(m: MaterialInput, p: Params) -> vec4<f32>` and up to four `param <name> float|vec2|vec3|vec4|color <default...>` lines. The cook compiles it for every back end. Loaded once per path (ui-materials §2)."
    guide "ui-materials §2"
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `materials/materials/rarity.ogt`."
    returns Result.UiMaterial "Refused for a path not in the bundle or not a UI material."
  }

  fn texture {
    doc "Load a cooked texture for og.render.sprite and a document's `<img>`, as three.js TextureLoader.load."
    doc "Sources are PNG, JPEG or KTX2 files under assets/ (`texture { kind color|normal|linear|pixel }` in `<file>.ogt`). A KTX2's `KTXorientation` and `KTXswizzle` are honoured: one that is not `rd` and `rgba` is decoded, flipped to rows top to bottom and swizzled, and cooked again; one that is (Basis ETC1S or UASTC, or RGBA8, of a colour or linear kind) is taken as it is."
    aliases "image, picture, Texture2D, three.js TextureLoader, load a PNG, sprite image"
    param world World "The world whose renderer owns the texture."
    param path String "The texture's asset id, such as `textures/stone.png`."
    returns Result.Texture
  }

  fn textureArray {
    doc "Load a cooked TS file['texture-array'] declaration as one 2D-array texture: 1..256 equally sized images, in declaration order, encoded for their kind. Each layer is also a texture, `<path>#layer<n>`. Repeated loads return the same array."
    doc "Sprites (SpriteDesc.array, og.Sprite.array) and 2D particle emitters draw from it, one draw per array. In a streaming group it loads once the group is resident (refused before, naming the group), draws nothing while the group is away and returns under the same handle."
    guide "loading §8"
    param world World "The world whose renderer owns the array."
    param path String "The array's canonical asset id, such as `base/tiles/ground`."
    returns Result.TextureArrayInfo "Refused for a path not in the bundle (run og cook), not a texture array, or layers that do not agree."
  }

  fn style {
    doc "Load a cooked UI style for UiDesc.style: the directory whose `pack.json` it reads. A game's style is `styles/<name>` (a `pack.json`, or a `theme.json` the cook compiles into one beside it); an engine theme is `@themes/<name>` (`minimal`, `tactical`, `tactical-arctic`, `fantasy`, `scifi`, `anime`, `cartoon`, `candy`, `ink`, `pixel`, `storybook`), in the bundle only when a look's `ui` line names it. A `style.ogt` path is refused. Loaded once per path."
    guide "loading §6"
    param world World "The world whose UI uses it."
    param path String "The style directory, such as `styles/main` or `@themes/tactical`."
    returns Result.Style "Refused for a directory without a `pack.json` in the bundle (run og cook; an engine theme no look names), a `style.ogt` path, or a pack that fails to parse."
  }

  fn look {
    doc "Load a look: an `.ogt` of `type look` binding a frame's art direction as data, with `name`, `extends` (a preset slug or another look), `ui` and `antialias` lines and one block per resource it sets (LookInfo.resources), its fields by name. The cook validates every field against the reflected schema and flattens `extends`, so the blob is the whole look. The textures, LUTs, palettes, environment map and UI style it names are loaded with it. Loaded once per path."
    guide "loading §6"
    guide "looks §1"
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `looks/main.ogt`."
    returns Result.Look "Refused for a path not in the bundle (the reason says to run og cook) or an asset it names that cannot load."
  }

  fn lookInfo {
    doc "What a loaded look holds and sets."
    param world World "The world that owns the look."
    param look Look "The look."
    returns Result.LookInfo "Refused for a look not loaded in this world."
  }

  fn palette {
    doc "A colour palette for Stylise.palette, from a cooked `.hex` (one RRGGBB per line, as palette sites publish them) or GIMP `.gpl` file: up to 256 sRGB colours, in file order. Loaded once per path. One in a streaming group's pack loads once its group is resident; while the group is unloaded Stylise.palette quantises to no palette, and the palette comes back under the same handle."
    param world World "The world whose renderer owns it."
    param path String "The asset id, such as `palettes/dusk.hex`."
    returns Result.Palette "Refused for a path not in the bundle (the reason says to run og cook)."
  }

  fn soundInfo {
    doc "A loaded sound's format and length."
    param world World "The world that owns the sound."
    param sound Sound "The sound."
    returns Result.SoundInfo "Refused for a dead sound."
  }

  fn status {
    doc "Where a load is."
    param world World "The world that owns the asset."
    param asset Asset "The handle."
    returns LoadStatus
  }

  fn error {
    doc "Why a load failed."
    param world World "The world that owns the asset."
    param asset Asset "The handle."
    returns Option.String "The reason, naming the fix; null unless the load failed."
  }

  fn gltfInfo {
    doc "What a ready glTF holds."
    param world World "The world that owns the asset."
    param asset Asset "A ready glTF handle."
    returns Result.GltfInfo "Refused for a pending, failed or non-glTF asset."
  }

  fn animation {
    doc "Load a cooked glTF's animation (its `<model>#anim` blob: the rig, the clips, the skin and morph streams) and register its skeleton and clips with og.anim. Loading the same model again answers the same handles."
    doc "Clips are cooked as f32 samples or, with `animation { compress true }` in the model's import settings, as quantised keys within a tolerance; either way every frame is rebuilt here and the clip plays as f32. Morph targets are cooked sparse."
    guide "loading §7"
    param world World "The world whose animation owns the assets."
    param path String "The model's asset id, such as `models/walker.glb` (a `#anim` suffix is accepted)."
    returns Result.Animation "Refused for an uncooked path, a model the cook wrote no `#anim` blob for (no skins, clips or morph targets), a cook stamp mismatch or an invalid rig."
  }

  fn animgraph {
    doc "Load a cooked type animgraph asset. Its bind lines map graph names to model clip names; the cook checks references and graph structure. Sprite graphs use sprite true and resolve sheet/rig clip names at playback. Loading the same asset again returns the same handle."
    param world World "The world whose animation owns the graph."
    param path String "The animgraph asset id under assets/."
    returns Result.GraphAsset "Refused for an uncooked or unavailable path, invalid graph or missing bound animation clip."
  }

  fn rig {
    doc "Load a cooked humanoid map (an `.ogt` of `type rig`: a naming scheme and bones named outright) for og.anim.retarget and og.anim.humanoid. Loading the same path again answers the same handle."
    param world World "The world whose animation uses it."
    param path String "The rig's asset id, such as `rigs/strider.ogt`."
    returns Result.Rig "Refused for a path not in the bundle (run og cook) or a cook stamp mismatch."
  }

  fn flipbook {
    doc "Load a cooked flipbook sheet (an `.ogt` of `type flipbook`: an Aseprite or TexturePacker atlas, or animated GIF, WebP or APNG sources the cook packs into `<sheet>#sheet`) and its texture, and register it with og.flipbook. A sheet with `array true` cooks into a texture array (FlipbookInfo.array), frame n drawn as layer n. A sheet in a streaming group loads once its group is resident (refused naming the group before), and its sprites draw nothing while the group is away. Loading the same path again answers the same handles."
    guide "loading §8"
    param world World "The world whose animation and renderer own it."
    param path String "The sheet's asset id, such as `sprites/hero.ogt`."
    returns Result.FlipbookInfo "Refused for a path not in the bundle (run og cook) or a texture it cannot load."
  }

  fn tilemap {
    doc "Load a cooked map (a tilemap `.ogt`, a Tiled `.tmj` or an LDtk `.ldtk`), its tilesets and their textures. Loading the same path again answers the same handles."
    param world World "The world whose renderer and tilemaps own it."
    param path String "The map's asset id, such as `maps/room.tmj`."
    returns Result.TilemapInfo "Refused for a path not in the bundle, a missing tileset or texture, or a terrain its tileset lacks."
  }

  fn video {
    doc "Load cooked footage (an `.ogt` of `type video`), which og cook turns with ffmpeg into a clip (a texture array of its frames) or a stream (AV1, decoded as it plays) and its sound track. Either way it makes the video's Texture (VideoInfo.texture), which shows the frame its og.VideoPlayer is at, drawn like any texture by a material, an og.Sprite or a UI image. A stream fetches nothing here (loading §9). Loading the same path again answers the same handles."
    guide "loading §9"
    param world World "The world whose renderer and audio own it."
    param path String "The video's asset id: the `.ogt`, such as `clips/intro.ogt`."
    returns Result.VideoInfo "Refused for a path not in the bundle (run og cook: a video needs ffmpeg there, og doctor) or not a video."
  }

  fn videoInfo {
    doc "A loaded video's size, frames, rate, length, texture and sound."
    param world World "The world that loaded it."
    param video Video "The video."
    returns Result.VideoInfo "Refused for a handle og.load.video did not answer."
  }

  fn timeline {
    doc "Load a timeline: an `.ogt` of `type timeline` (the og.timeline module's file: duration, paths and tracks of keys), cooked with its caption files imported. Loaded once per path; play it with an og.Timeline whose asset is the handle, or `timeline:play:<name>` on the command channel."
    param world World "The world."
    param path String "The timeline's asset id, such as `timelines/intro.ogt`."
    returns Result.TimelineAsset "Refused for a path not in the bundle (run og cook) or a file that is not a timeline."
  }

  fn vfx {
    doc "Load a composed effect: an `.ogt` of `type vfx` (the og.vfx module's file) or an Effekseer effect (`.efkproj`, `.efkefc`) the cook converts, with every emitter, effect material, model, flipbook sheet and sound it names. Loaded once per path; play it with og.vfx.spawn or an og.Vfx whose asset is the handle."
    guide "loading §11"
    aliases "Effekseer, efkproj, efkefc, Effekseer import, import a particle effect"
    param world World "The world."
    param path String "The effect's asset id, such as `fx/fireball-impact.ogt` or `fx/slash.efkproj`."
    returns Result.VfxAsset "Refused for a path not in the bundle (run og cook), a file that is not a vfx, or an asset it names that will not load."
  }

  fn rig2d {
    doc "Load a cooked 2D rig (an `.ogt` of `type rig2d`, written by hand or imported by the cook from DragonBones JSON) and its texture, and register it with og.skeleton2d. Loading the same path again answers the same handles."
    param world World "The world whose animation and renderer own it."
    param path String "The rig's asset id, such as `rigs/hero.ogt`."
    returns Result.Rig2DInfo "Refused for a path not in the bundle (run og cook) or a texture it cannot load."
  }

  struct LoadBudget {
    doc "The limits an uncooked load (og.load.imageData, og.load.gltfData, og.load.environmentData) is held to: content a player or a generator made is untrusted, so each limit is checked from the file's headers before anything is decoded, and a load over one is refused naming the limit, the value and the fix."
    desc true
    field bytes f64 "The most bytes the source may have." {
      default 33554432
      min 0
      unit bytes
    }
    field triangles u32 "The most triangles a glTF's meshes may have, every primitive of every mesh." {
      default 500000
    }
    field textureSize u32 "The widest or tallest an image may be, in texels (the device's own limit lowers it further)." {
      default 4096
    }
    field frameMs f32 "How long a frame may spend on the engine's thread putting finished loads in place, in milliseconds; at least one load is put in place a frame, and decoding never runs on the engine's thread on the web." {
      default 2
      min 0
      unit ms
    }
  }

  enum ImageKind {
    doc "How an uncooked image's texels are read, as a cooked texture's `kind`."
    variant color "sRGB colour (albedo, UI art), sampled linear."
    variant linear "Data stored linearly (masks, roughness)."
    variant pixel "sRGB colour sampled nearest (pixel art)."
  }

  struct GltfDataDesc {
    doc "How og.load.gltfData reads a model."
    desc true
    field budget LoadBudget "The limits it is held to."
  }

  struct ImageDataDesc {
    doc "How og.load.imageData reads an image."
    desc true
    field kind ImageKind "How its texels are read."
    field budget LoadBudget "The limits it is held to."
  }

  struct CatalogEntry {
    doc "A file of a content catalog's version: what og.load.data reads. A catalog is this game's content, published by its host in immutable versions; its content base is the host's (og run --content, the page's), never game code's."
    guide "loading §14"
    desc true
    field catalog String "The catalog, as the game names it (`world`): 1 to 64 of letters, digits, `.`, `_` and `-`."
    field version String "The version, as the host named it: 1 to 128 of letters, digits, `.`, `_` and `-`."
    field path String "The file within the version, as its manifest lists it (`index/small/3/-2.json`): `/`-separated, no empty, `.` or `..` part."
  }

  enum DataFormat {
    doc "How og.load.data reads a file."
    variant json "JSON: og.load.dataJson gives the value."
    variant bytes "Bytes as stored: og.load.dataBytes gives them."
  }

  struct DataDesc {
    doc "Which catalog file og.load.data reads, and how."
    guide "loading §14"
    desc true
    field entry CatalogEntry "The file."
    field format DataFormat "How to read it."
    field budget LoadBudget "The limits it is held to: bytes alone."
  }

  struct EnvironmentDataDesc {
    doc "How og.load.environmentData reads an HDR environment."
    desc true
    field size u32 "The prefiltered cube's face size at its sharpest level: a power of two from 16 to 2048 (and at most LoadBudget.textureSize), as a cooked environment's `size`." {
      default 128
    }
    field intensity f32 "Multiplies the image, as a cooked environment's `intensity`." {
      default 1
      min 0
    }
    field budget LoadBudget "The limits it is held to: bytes, and textureSize for the image's width and height."
  }

  struct EnvironmentInfo {
    doc "What a ready uncooked environment holds."
    field map EnvironmentMap "The map, for Environment.map or Environment.blendTo, lit and drawn like a cooked one."
    field width u32 "The image's width in pixels."
    field height u32 "The image's height in pixels."
    field size u32 "The prefiltered cube's face size."
  }

  struct ImageInfo {
    doc "What a ready uncooked image holds."
    field texture Texture "The texture: og.render.sprite, a document's `<img>` and material maps draw it like a cooked one."
    field width u32 "Its width in texels."
    field height u32 "Its height in texels."
  }

  struct LoadCompletion {
    doc "When a host-timed load finished: an uncooked load put in place or a runtime bundle opened. The journal a replay applies again (og.load.completions)."
    field kind String "`uncooked` (og.load.imageData, gltfData, environmentData), `bundle` (og.load.bundle of another bundle, og.load.pack) or `data` (og.load.data). A journal without kinds holds uncooked loads."
    field request u32 "The load's number within its kind: 0 for the world's first, then one more for each."
    field tick f64 "The world's tick (world.tick) at the boundary it was put in place: the systems of that tick and every later one see og.load.status ready or failed." {
      unit ticks
    }
    field ok bool "Whether it was ready (else failed)."
    field integrity String "For `data`: the integrity of the bytes it read (`sha384-<base64>`); for an og.load.pack `bundle`: its cooked manifest's. A replay requires it again; absent otherwise." {
      optional true
    }
  }

  fn imageData {
    doc "Load an image from bytes, uncooked, at run time: a PNG or JPEG a player drew, uploaded or a generator made. Its size, width and height are checked against the budget before it is decoded, off the engine's thread. The handle is pending until the image is in place, then ready (og.load.imageInfo gives its texture) or failed (og.load.error says why)."
    guide "loading §10"
    doc "Completion is host input, applied at a tick boundary and journaled, so a replay puts it in place at the same tick. It is local to each session: an asset's status is not world state and is in no snapshot or hash."
    param world World "The world that owns the asset."
    param name String "A name for it in errors and dumps, such as `drawings/cat.png`."
    param bytes Bytes "The file's bytes."
    param desc ImageDataDesc "How to read it and its budget."
    returns Result.Asset "The handle (pending), or why it was refused now: over the budget's bytes or textureSize, or not a PNG or JPEG."
  }

  fn gltfData {
    doc "Load a glTF 2.0 model from bytes, uncooked, at run time: a .glb, or a .gltf whose buffers and images are data: URIs. Its size, triangles and image headers are checked against the budget at the call; then its images decode off the engine's thread and its primitives convert at tick boundaries. The handle is pending until the model is in place, then ready (world.instantiate spawns it, og.load.gltfInfo describes it) or failed (og.load.error says why)."
    guide "loading §10"
    doc "It reads materials, nodes and scenes, without skins, animations or levels of detail."
    doc "Completion is host input, journaled as og.load.imageData's is."
    param world World "The world that owns the asset."
    param name String "A name for it in errors and dumps, such as `creations/kite.glb`; its textures are `<name>#tex<n>`."
    param bytes Bytes "The file's bytes."
    param desc GltfDataDesc "Its budget."
    returns Result.Asset "The handle (pending), or why it was refused now: over the budget's bytes, triangles or textureSize, not a glTF 2.0, an image that is not a PNG or JPEG, or something the reader refuses by name."
  }

  fn environmentData {
    doc "Load an HDR environment from bytes, uncooked, at run time, for Environment.map: an equirectangular Radiance .hdr (or .exr where RenderCapabilities.exrDecode is true), twice as wide as tall. Its size is checked against the budget before it is decoded off the engine's thread; the renderer GGX-prefilters it on the GPU when it first draws with it. The handle is pending until the map is in place, then ready (og.load.environmentInfo) or failed (og.load.error); until then Environment lights by the sky."
    guide "loading §10"
    doc "Completion is host input, journaled as og.load.imageData's is."
    param world World "The world that owns the asset."
    param name String "A name for it in errors and dumps, such as `uploads/sunset.hdr`."
    param bytes Bytes "The file's bytes."
    param desc EnvironmentDataDesc "Its face size, intensity and budget."
    returns Result.Asset "The handle (pending), or why it was refused now: over the budget's bytes or textureSize, not twice as wide as tall, a size that is not a power of two from 16 to 2048, not a .hdr or .exr file, or an .exr where RenderCapabilities.exrDecode is false (the reason names it)."
  }

  fn data {
    doc "Read a file of a content catalog at run time: static, versioned content the game's host publishes (a world's index pages, a shared level), well past a store value's 64 KiB. The file is read from the host's content base against its version manifest's integrity; game code names no URL. The handle is pending, then ready (og.load.dataJson, og.load.dataBytes) or failed, og.load.error starting with its reason."
    guide "loading §14"
    doc "Completion is host input, journaled with its tick and integrity, so a replay reads the same bytes in at the same tick. og.load.release frees it."
    param world World "The world that owns the asset."
    param desc DataDesc "The file and how to read it."
    returns Result.Asset "The handle (pending), or why it was refused now: a malformed catalog, version or path."
  }

  fn dataJson {
    doc "The value of a ready og.load.data file read as `json`."
    guide "loading §14"
    param world World "The world that owns the asset."
    param asset Asset "A handle og.load.data answered."
    returns Result.Json "Refused while it is pending, when it failed (with its reason), when read as `bytes`, or for another kind of asset."
  }

  fn dataBytes {
    doc "The bytes of a ready og.load.data file read as `bytes`."
    guide "loading §14"
    param world World "The world that owns the asset."
    param asset Asset "A handle og.load.data answered."
    returns Result.Bytes "Refused while it is pending, when it failed (with its reason), when read as `json`, or for another kind of asset."
  }

  fn pack {
    doc "Open a cooked bundle a content catalog's version lists by name (its manifest's `packs`), read from the content base against the integrity the version lists. Once ready it is a runtime bundle as og.load.bundle opens: og.load.bundleInfo, its groups and cells, og.load.release to close it."
    guide "loading §14"
    doc "Completion is host input, journaled as a `bundle` with its tick and manifest integrity, so a replay opens the same pack at the same tick. og.load.error starts with its reason, as og.load.data's. A pack opening or open answers its handle."
    param world World "The world that owns the asset."
    param entry CatalogEntry "The pack: its catalog, version, and its name as `path`."
    returns Result.Asset "The handle (pending), or why it was refused now: a malformed catalog, version or name."
  }

  fn environmentInfo {
    doc "A ready uncooked environment's map and sizes."
    param world World "The world that owns the asset."
    param asset Asset "A handle og.load.environmentData answered."
    returns Result.EnvironmentInfo "Refused while it is pending (say so), when it failed (with its reason) or for another kind of asset."
  }

  fn release {
    doc "Free an uncooked load's memory, cancelling it if pending; its handle then answers failed, naming the release. Releasing again does nothing. Close an idle runtime bundle after its groups unload and live references are gone. In a system the close waits for the next tick boundary; between ticks it can finish at once. Refusal leaves it open with status failed and error starting 'bundle release refused:'; remove them and retry. Success answers failed, naming the release. Closing changes no world hash, events or completion journal, and frees its terrains (loading §10). The boot bundle cannot close."
    guide "loading §10"
    param world World "The world that owns the asset."
    param asset Asset "An uncooked asset handle or a runtime bundle handle."
    returns Result.Void "Accepts a bundle close request; poll status and error for its outcome. Refused for an individual cooked asset, which stays with its bundle (a streamed one with its group)."
  }

  fn imageInfo {
    doc "A ready uncooked image's texture and size."
    param world World "The world that owns the asset."
    param asset Asset "A handle og.load.imageData answered."
    returns Result.ImageInfo "Refused while it is pending (say so), when it failed (with its reason) or for another kind of asset."
  }

  fn completions {
    doc "The world's journal of host-timed loads, oldest first: uncooked loads put in place and runtime bundles opened, each with its tick. What a replay hands og.load.replayCompletions to finish each at the same tick. og replay --record keeps it in the trace."
    param world World "The world."
    returns List.LoadCompletion
  }

  fn replayCompletions {
    doc "Finish this world's host-timed loads at the ticks a recorded run did (its og.load.completions), not when this host finishes them: a load is held back until its tick, and at its tick the engine waits for it; a bundle the run opened at the call opens at the call. Call it before the first tick; og replay --compare does. A load the journal names as failed fails at its tick whatever this host made of it; one it never finished never finishes."
    param world World "The world."
    param completions List.LoadCompletion "A recorded journal."
    returns Result.Void "Refused once a tick has run."
  }

  event AssetReady {
    doc "A load completed."
    field asset Asset "The handle."
    field path String "The path it was loaded from."
  }

  event AssetFailed {
    doc "A load failed."
    field asset Asset "The handle."
    field path String "The path it was loaded from."
    field reason String "Why, naming the fix."
  }
}

# ── physics ───────────────────────────────────────────────────────────────
