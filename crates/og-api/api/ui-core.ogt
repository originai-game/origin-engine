module ui {
  doc "The engine's UI: an immediate-mode toolkit. Systems describe the tree every tick with these calls; the engine lays it out Clay-style, styles it with the game's UI style (the engine's default style until the game picks one), draws it over the frame and answers the probe (dump_ui, touch_move_to, move_to_text) from it."
  doc "The engine opens the frame before the game's systems (from og.Input and the play surface) and closes it after them, so calls belong inside systems; outside one they do nothing and log a warning. Interaction is decided against the previous tick's rectangles, which are also what the probe resolves, so a scripted touch_move_to and a click agree; response edges (clicked, changed, submitted) last one tick."
  doc "Lengths are CSS pixels of the play surface (origin top left, y down), the unit of og.Input and the probe. Ids: an element's id is unique among its siblings (`idi(\"Slot\", 3)` is `Slot#3`); a path `Inventory/Slot#3` names it after its nearest ancestors. The UI state (hover, press, focus, caret, scroll) is world state: snapshots and the world hash carry it."

  enum TextAlign {
    doc "How the lines of a label align."
    variant start "To the start (left)."
    variant center "Centred."
    variant end "To the end (right)."
  }

  enum Scheme {
    doc "The palette: games run on a stage, so dark is the default."
    variant dark "The dark palette."
    variant light "The light palette."
  }

  enum DensityMode {
    doc "Control sizes by the input the player holds: auto picks touch sizes on a coarse pointer or a play surface under 768 px, mouse sizes otherwise."
    variant auto "Touch sizes on a coarse pointer or a narrow surface, mouse sizes otherwise."
    variant mouse "A mouse and keyboard: the tightest controls."
    variant pad "A gamepad across a room: larger controls, rows and gutters that read from a couch."
    variant touch "A finger: every control at least 44 CSS px."
  }

  enum ThemeColor {
    doc "A colour role of the UI style in effect (the game's style, or the default style before it picks one)."
    variant backdrop "The screen behind the UI where nothing else is."
    variant well "A recessed ground inside a panel: wells, map frames, empty slots."
    variant panel "Panels and cards."
    variant panelHover "A panel under the pointer."
    variant panelRaised "Dialogs, menus and tooltips."
    variant line "Hairlines and frames."
    variant lineStrong "Stronger frames: high contrast, map borders, scrollbars."
    variant ink "The main ink."
    variant inkMuted "Secondary ink: captions, keys, inactive tabs."
    variant inkFaint "The faintest ink that still reads: placeholders, hints."
    variant inkInverse "Ink on a ground of ink (a selected chip)."
    variant control "Neutral control fills: secondary buttons, tracks, fields."
    variant controlStrong "A neutral control hovered or pressed; selection."
    variant primary "The one directed action: primary buttons, a slider's fill, a switch that is on, the caret."
    variant primaryHover "primary hovered."
    variant primaryActive "primary pressed."
    variant onPrimary "Ink on primary."
    variant primarySoft "A translucent wash of primary."
    variant highlight "Emphasised ink: a speaker's name, a price, a link, the player's map dot."
    variant selection "The selected row, tab or card, independent of primary actions."
    variant onSelection "Ink on the selection ground."
    variant accent "Decorative emphasis, independent of primary and selection."
    variant sceneInk "Scheme-aware text drawn over the scene."
    variant scenePlate "Scheme-aware plate behind HUD content."
    variant sceneShadow "Separation shadow under text over the scene."
    variant focus "The focus ring of key and pad navigation."
    variant knob "Slider and switch knobs."
    variant hud "HUD capsules over the game (scores, timers, toasts)."
    variant scrim "Behind a dialog."
    variant shadow "Drop shadows."
    variant sheen "A skeleton's passing sheen."
    variant success "Success."
    variant warn "Warnings."
    variant danger "Danger and errors."
    variant info "Information."
    variant health "A health meter."
    variant mana "A mana meter."
    variant xp "An experience meter."
    variant gold "Currency: coins, gold, prices that can be paid."
  }

  enum TypeStepName {
    doc "A step of the style's type ramp."
    variant body "The default step."
    variant xs "A step of the ramp."
    variant meta "A step of the ramp."
    variant caption "A step of the ramp."
    variant sm "A step of the ramp."
    variant reading "A step of the ramp."
    variant base "A step of the ramp."
    variant lg "A step of the ramp."
    variant xl "A step of the ramp."
    variant xl2 "A step of the ramp."
    variant xl3 "A step of the ramp."
    variant xl4 "A step of the ramp."
    variant xl5 "A step of the ramp."
    variant xl6 "A step of the ramp."
    variant xl7 "A step of the ramp."
    variant xl8 "A step of the ramp."
    variant displaySm "A step of the ramp."
    variant displayMd "A step of the ramp."
    variant displayLg "A step of the ramp."
    variant displayXl "A step of the ramp."
    variant displayXl2 "A step of the ramp."
    variant hero "The largest typography role, above display; displayXl2 is its legacy alias."
  }

  struct Insets {
    doc "Padding or margins on four sides."
    field left f32 "The left side." {
      unit cssPx
    }
    field top f32 "The top side." {
      unit cssPx
    }
    field right f32 "The right side." {
      unit cssPx
    }
    field bottom f32 "The bottom side." {
      unit cssPx
    }
  }

  struct Paint {
    doc "A colour: a theme token, or an sRGB colour as authored (components 0 to 1), with an alpha. Neither is white."
    desc true
    field token Option.ThemeColor "A semantic colour of the theme."
    field role Option.String "A colour role the style declares of its own (its `roles` block, docs/ui.md §3.1: a game's corruption or faction colour) by name, when no token is given; a name the style lacks draws magenta."
    field color Option.Color "An sRGB colour as authored, when no token or role is given."
    field alpha f32 "The opacity." {
      default 1
      min 0
      max 1
    }
  }

  struct Viewport {
    doc "The play surface the UI lays out in, in og-ui units (CSS px over UiTheme.unit) and device pixels per unit."
    field width f32 "Its width; omitted is 1280." {
      default 1280
      unit cssPx
    }
    field height f32 "Its height; omitted is 720." {
      default 720
      unit cssPx
    }
    field dpr f32 "Device pixels per CSS pixel; rectangles snap to device pixels." {
      default 1
    }
    field safeArea Insets "The device's unsafe margins (notch, home indicator); the root pads by them, and CSS env(safe-area-inset-*) reads them with the covered region folded in (covered)."
    field smallWidth f32 "The surface's width with the browser's own controls (address bar, toolbars) shown, as CSS's small viewport: what svw, svi and svmin read; vw and dvw read width. Omitted or 0 is width (native hosts have no such controls)." {
      unit cssPx
      optional true
    }
    field smallHeight f32 "Its height with the browser's controls shown (CSS svh); omitted or 0 is height." {
      unit cssPx
      optional true
    }
    field largeWidth f32 "Its width with the browser's controls hidden (CSS lvw); omitted or 0 is width." {
      unit cssPx
      optional true
    }
    field largeHeight f32 "Its height with the browser's controls hidden (CSS lvh); omitted or 0 is height." {
      unit cssPx
      optional true
    }
    field coarsePointer bool "A touch screen or another coarse pointer."
    field reducedMotion bool "The page prefers reduced motion (prefers-reduced-motion: reduce, from the web shell): the UI's theme only fades, whatever UiDesc.reducedMotion says. Omitted is false." {
      optional true
    }
    field highContrast bool "The page prefers more contrast (prefers-contrast: more, from the web shell): the UI's theme is the high-contrast one, whatever UiDesc.contrast says. Omitted is false." {
      optional true
    }
    field reducedTransparency bool "The page prefers less transparency (prefers-reduced-transparency: reduce, from the web shell): glass parts are opaque surfaces and the scrim and translucent fills flat, whatever UiDesc.reducedTransparency says (UiTheme.reducedTransparency). Omitted is false." {
      optional true
    }
    field macKeys bool "Text controls take macOS's editing keys: Command with A, C, X and Z, Command+←/→ to the line's ends (↑/↓ the text's), Option+←/→ and Option+Backspace by words, Control+A and E to the line's ends. Off: Control takes the shortcuts and moves by words (Alt too), Home and End go to the line's ends. The web shell sets it from the browser's platform (Apple's); a native host sets it on macOS, so a script that holds Ctrl or Meta edits as a person on that OS would (og.ui.previewViewport pins either). Omitted is false." {
      optional true
    }
    field covered UiRect "Where the host's own control covers the surface: on a published page the web shell's round Back to the Portal, top left (about 12, 12 to 52, 52 CSS px; its name shows beside it for the first seconds of play). A document's CSS `env(safe-area-inset-*)` clears it: it is folded into the one edge's inset that costs the least surface (the left one on a landscape surface, the top one on a portrait one), so a HUD placed at the insets (`position: fixed; left: calc(env(safe-area-inset-left) + 16px)`) never draws under it. A game drawing its own corner reads it from og.ui.frameViewport. Empty (omitted) is none: native hosts and pages without Back." {
      optional true
    }
    field breakpoint Breakpoint "Its size class: phone portrait or landscape, tablet, desktop."
    field hud UiRect "The HUD band (read only): the safe area at most UiDesc.hudMaxAspect times its height wide, centred, where toasts lay out and a HUD document's CSS env(-og-hud-inset-*) places it; a game drawing its own HUD reads it so it sits with them on an ultrawide. Ignored where a host passes a viewport in." {
      optional true
    }
  }

  struct UiDesc {
    doc "How the UI looks: the scheme, the density, its fonts, the contrast, the game's primary colour, motion, transparency, the icon atlas, the style and the sounds. og.ui.configure takes it in part: a field left out keeps the value the last call (or a look's style) gave it, null clears it."
    aliases "UI scale, text scale, font size, accessibility, high contrast, reduced motion, UI settings"
    desc true
    field scheme Scheme "The palette."
    field density DensityMode "The control sizes."
    field font Option.Font "The body font, from og.load.font; null measures text at half an em per character and draws none."
    field displayFont Option.Font "The display font; null uses the body font."
    field monoFont Option.Font "The monospaced font; null uses the body font."
    field roundedFont Option.Font "The rounded font (levels and scores); null uses the display font, then the body font."
    field fallbackFonts List.Font "Fonts for other scripts (Hebrew, Devanagari, a CJK face with `font { runtime true }`), tried in order after the locale's (og.i18n) for a text the role's font cannot draw whole. A text mixing scripts takes each run from the first font that has it (the role's for its Latin, a fallback for its CJK or Arabic), one label in several fonts."
    field contrast Contrast "Standard or high contrast. The page's prefers-contrast: more takes high contrast too (Viewport.highContrast)."
    field primaryColor Option.Color "An sRGB colour as the game's primary (its hover, pressed and soft tones derived from it, the ink on it whichever of ink and inkInverse reads better); null keeps the style's."
    field reducedMotion bool "Transitions only fade; sheens stop. The page's prefers-reduced-motion turns it on too (Viewport.reducedMotion)."
    field textScale f32 "The player's text size (a settings screen's slider, kept with the other settings): every text size and leading is multiplied by it and the layout grows around the text (control, row and header heights by the leading body text gains), never clipping it. 1 is the style's sizes, 1.5 the largest (a larger one lays out at 1.5): docs/ui.md §6.1 holds every screen to 1.5, 200 % deferred." {
      default 1
      min 1
      max 2
      unit ratio
    }
    field unitScale f32 "The og-ui unit in CSS px (docs/ui.md §6.1): the UI lays out in units (og.ui.viewport and og.ui.frameViewport are the surface over it) and draws them at it, so every length grows with the surface (the style's text, space, radii and controls, and a game's own px, alike) and the player's textScale multiplies over it. 0 is auto: on a mouse or pad surface its 1080p-equivalent height (the shorter of the height and the width's 16:9 height) over 720, 1 to 2, so a 1280x720 layout fills a 1080p window with body text at 21 CSS px and the smallest step at 18; a touch surface keeps CSS px (1). A value of 1 to 2 pins it (a game that lays out for one size)." {
      default 0
      min 0
      max 2
      unit ratio
    }
    field reducedTransparency bool "Nothing is see-through: glass parts (a style's glass line) are opaque surfaces (no blur of the frame under them, their frame whole), the scrim is the opaque colour it makes over backdrop and the translucent fills (control, controlStrong, primarySoft, hud) the opaque colours they make over panel. The page's prefers-reduced-transparency turns it on too (Viewport.reducedTransparency); UiTheme.reducedTransparency says it is on."
    field colorVision ColorVision "The player's colour vision (a settings screen's colour-blind mode): the whole frame, the scene and the UI alike, is recoloured for it after every other effect (colorVisionFilter), and a document's CSS reads it as @media (-og-color-vision: protanopia) to add the cues it needs. none (the default) draws the frame as it is. Simulation uses Viénot 1999 for protanopia and deuteranopia and Brettel 1997 for tritanopia; correction is Fidaner 2005's daltonisation over them (docs/ui.md §3.2)."
    field colorVisionFilter ColorVisionFilter "What colorVision does to the frame: correct (the default; the player's setting) or simulate (how a viewer with it sees the frame, for checking a screen)."
    field colorVisionStrength f32 "The deficiency's severity, 0 to 1: 1 (the default) a dichromat's; less blends towards the frame as it is, for the commoner anomalous trichromacy." {
      default 1
      min 0
      max 1
      unit ratio
    }
    field icons Option.IconAtlasDesc "The icon atlas a document's `<og-icon>` draws from; null takes the style's."
    field fallbackIcons Option.IconAtlasDesc "The icon set that draws the names the atlas lacks (icons, or the style's when icons is null): a game's whole set, such as the UI kit's iconoir set, under a style pack's few painted icons, which keep the names they paint. A document's `<og-icon>`, rich text's [icon=], an action's glyph and an art slot's placeholder all look in it; a name in neither warns. null is none."
    field images List.UiInlineImage "Pictures rich text draws inline by name ([img=<name>]): a portrait in a line of dialogue, an item's art in a tooltip. Any texture, not only the icon atlas's cells; each one em tall at its aspect, in its own colours."
    field hudMaxAspect f32 "The widest the HUD band is, over its height: on a wider surface (a 21:9 or 32:9 ultrawide monitor) a HUD document placed at its CSS env(-og-hud-inset-*) (`right: calc(env(-og-hud-inset-right) + 24px)`) lay out in a band this wide, centred in the safe area, so the player's eyes stay near the play; og.ui.viewport's hud is that band. 16/9 keeps a 16:9 game's HUD where it was designed; 0 is the whole safe area (a HUD at the screen's edges). Full-screen layers (dialogs, menus, scrims, world-space markers and their edge clamping) keep the whole surface. The UI itself never stretches: it lays out in CSS pixels at every aspect." {
      default 2.3333333
      min 0
    }
    field style Option.Style "A UI style from og.load.style: its palette, radii, type ramp, fonts, icons, frames, ornaments, motion and sounds replace the default style (fonts, icons and a primary colour given here still win); null is the default style, the design language the engine shares with origin-agent."
    field sounds Option.UiSounds "Sounds for UI events (they win over the style's)."
  }

  struct UiSounds {
    doc "Sounds the UI plays through og-audio (the ui bus) on its events; null is silent."
    desc true
    field hover Option.Sound "The pointer reaches a control, or keyboard or gamepad focus moves to one."
    field press Option.Sound "A control is pressed: by the pointer, Enter, Space or the gamepad's A."
    field open Option.Sound "A dialog opens."
    field close Option.Sound "A dialog closes."
    field success Option.Sound "A success toast."
    field error Option.Sound "A refused press or a danger toast."
  }

  struct TypeStep {
    doc "One step of the type ramp."
    field size f32 "The font size." {
      unit cssPx
    }
    field lineHeight f32 "The leading of Latin text." {
      unit cssPx
    }
    field trackingEm f32 "Latin tracking, in em."
    field cjkLineHeight f32 "The leading text with Chinese, Japanese or Korean characters takes." {
      unit cssPx
    }
    field cjkTrackingEm f32 "Tracking of text containing CJK characters, in em."
    field weight u32 "The face weight (100 to 900); zero takes the font role's own face."
    field uppercase bool "Style-driven locale-sensitive uppercase, applied before measurement without rewriting source text or editable values."
    field features List.String "The OpenType features the step turns on, as tags: smcp (small caps), c2sc (capitals to small caps), tnum (tabular figures), lnum (lining figures), case (case-sensitive forms). A style sets them after a type role's font (`display 42 48 0.02 700 display smcp`); they apply where the role's font is imported with the same `features` line, and a font without one draws its defaults."
  }

  struct ControlSizes {
    doc "The control, row and header heights and the gutter of the density in effect."
    field controlSm f32 "A small control's height." {
      unit cssPx
    }
    field controlMd f32 "A control's height." {
      unit cssPx
    }
    field controlLg f32 "A large control's height." {
      unit cssPx
    }
    field gutter f32 "The gutter." {
      unit cssPx
    }
    field header f32 "The header height." {
      unit cssPx
    }
    field row f32 "The row height." {
      unit cssPx
    }
    field section f32 "The section spacing." {
      unit cssPx
    }
  }

  struct UiTheme {
    doc "The style values the UI draws with, read-only."
    field scheme Scheme "The palette in use."
    field palette Map.String "Each ThemeColor, then each colour role the style declares of its own (docs/ui.md §3.1), as `#rrggbb` or `#rrggbbaa` (sRGB as authored)."
    field space Map.f32 "The spacing scale by name (xxs, xs, sm, md, lg, xl, xxl, xl3), in CSS pixels."
    field radius Map.f32 "The corner radii by name (small, control, bar, panel), in CSS pixels."
    field typeRamp Map.TypeStep "Each TypeStepName's step."
    field sizes ControlSizes "The control sizes of the density in effect."
    field durationsMs Map.f32 "The motion durations by name (instant, fast, base, slow, spring, bounce), in milliseconds."
    field style String "The configured style's name; empty for the default style."
    field styleVersion u32 "The configured style file's version: 1 for a version-1 style, whose game keeps the controls and dialogs it shipped with (docs/ui.md §3); 2 for a version-2 style and the default style."
    field contrast Contrast "The variant in effect: high when the game asked for it or the page prefers more contrast."
    field reducedMotion bool "Transitions only fade and sheens stop: the game asked for it or the page prefers reduced motion. A game's own animations read it to keep their state changes and drop their movement."
    field textScale f32 "The player's text scale in effect (UiDesc.textScale, 1 to 1.5): typeRamp and sizes already carry it; tokens' typography is the style's as authored, so a game's own text drawn from it multiplies by this."
    field unit f32 "The og-ui unit in effect, in CSS px (UiDesc.unitScale; auto: 1 to 2 by the surface): what every length the UI reads and gives is in, og.ui.bounds and og.ui.viewport too. Only what leaves the UI for the page is CSS px: the probe's dump_ui and og.render's screen sprites; a game drawing its own screen sprites beside the UI multiplies by it."
    field colorVision ColorVision "The player's colour vision in effect (UiDesc.colorVision)."
    field colorVisionFilter ColorVisionFilter "Whether the frame is corrected or simulated for it."
    field colorVisionStrength f32 "Its severity, 0 to 1."
    field reducedTransparency bool "Nothing is see-through: the scrim and the translucent fills of `palette` are already the opaque colours they make over panel (the scrim over backdrop) and glass is an opaque surface; the game asked for it or the page prefers reduced transparency. A game's own translucent overlays read it to draw opaque too."
    field tokens Json "The style's tokens (docs/ui.md §3.1), what a game's own drawing reads to match its UI: `typography` (each role, display title heading body label caption numeric button, at each breakpoint: size, lineHeight, trackingEm, weight, font, features), the `space`, `size`, `radius` and `stroke` scales by step, `elevation` (each level's shadows: dx, dy, blur, spread, color), `shape` (each element class's corner and radius: the shape language), `springs` (ui, enter, exit, emphasis, playful: durationMs, bounce), `staggerMs`, `overshoot`, the `rarity`, `team` and `series` colours, `cues` (each colour token's cue besides its hue, by name: `{ icon: <index in the style's icons> }`, `{ pattern: <name> }` or `{ pips: <n> }`; docs/ui.md §3.2), and `feedback` (each UI event's set: how many sounds, the volume and pitch ranges, the haptic's [startMs, ms, low, high] pulses)."
  }

  fn configure {
    doc "Set how the UI looks (the scheme, density, fonts, style, sounds, motion…), typically in GameDesc.start; it takes effect from the next tick. The desc is a partial: a field left out keeps the last UiDesc's value, the one an earlier call or a look's style (og.render.applyLook) gave it, so a settings screen that configures sounds or reducedMotion keeps the style and the fonts; null clears a field to its default (`style: null` goes back to the default style). A UI left with no font at all (no font, no style with fonts, no fallback or locale font) warns: it would draw no text."
    param world World "The world whose UI is configured."
    param desc UiDesc "The fields to change; the others keep their values."
    returns Result.Void "Refused for a dead font or style, or a desc that is not an object."
  }

  fn viewport {
    doc "This tick's play surface as the UI lays out on it: the render target's size, safe area and covered region in og-ui units (CSS pixels over UiTheme.unit, docs/ui.md §6.1: 1 on touch and up to 720p, so CSS pixels there) and device pixels per unit, from what the host reports."
    param world World "The world."
    returns Viewport
  }

  fn theme {
    doc "The style values the UI draws with."
    param world World "The world."
    returns UiTheme
  }

  struct TextSpan {
    doc "A named attribute range in plain text for a store and the Svelte text spans binding. Offsets count Unicode scalar values, not UTF-8 bytes, JavaScript UTF-16 code units or grapheme clusters. Unknown names and properties remain game data. A character span may cover the complete Speaker: prefix, including its separator. Names select text::part(name) styles; text is never reinterpreted as markup."
    field name String "The style part name, for example emphasis or character."
    field position u32 "Start in Unicode scalar values; an astral character counts once."
    field length u32 "Number of Unicode scalars. Zero is a metadata marker."
    field properties Map.OneOf.String.OneOf.f64.bool "Typed attribute properties: only string, finite number or boolean, never nested data or null."
  }

  # ── the game widget set ─────────────────────────────────────────────────

  enum Anchor {
    doc "A point of the safe area an anchored group sits at."
    variant topLeft "The top left corner."
    variant top "The middle of the top edge."
    variant topRight "The top right corner."
    variant left "The middle of the left edge."
    variant center "The centre."
    variant right "The middle of the right edge."
    variant bottomLeft "The bottom left corner."
    variant bottom "The middle of the bottom edge."
    variant bottomRight "The bottom right corner."
  }

  enum Tone {
    doc "A status tone of badges, toasts and map markers."
    variant neutral "Neutral: control fill and muted ink."
    variant success "Success."
    variant warn "Warning (orange)."
    variant danger "Danger."
    variant info "Information."
    variant primary "The game's identity: the primary's soft wash and highlight ink."
    variant inverse "Neutral emphasis: ink fill, inverse ink."
  }

  enum Breakpoint {
    doc "The play surface's size class."
    variant desktop "1024 CSS px wide or more, the shorter side 600 or more."
    variant tablet "The shorter side 600 or more, under 1024 wide."
    variant phoneLandscape "The shorter side under 600, wider than tall."
    variant phonePortrait "The shorter side under 600, taller than wide."
  }

  enum ColorVision {
    doc "A colour vision deficiency (UiDesc.colorVision; CSS @media (-og-color-vision: <name>))."
    variant none "Typical colour vision: no filter."
    variant protanopia "No red-sensitive cones: reds dark, red and green confused."
    variant deuteranopia "No green-sensitive cones: red and green confused."
    variant tritanopia "No blue-sensitive cones: blue and green, yellow and violet confused."
  }

  enum ColorVisionFilter {
    doc "What UiDesc.colorVision does to the frame."
    variant correct "Recolours the frame so what the deficiency confuses is told apart (daltonisation)."
    variant simulate "Shows the frame as a viewer with the deficiency sees it."
  }

  enum Contrast {
    doc "The theme variant: high contrast remaps muted inks, fills and lines to the style's stronger ones and outlines every control (no new colour)."
    variant standard "The style's palette as it is."
    variant high "Stronger inks, fills and edges."
  }

  enum NavIntent {
    doc "A focus-navigation intent, as the arrow keys, Tab, Enter, Space, Escape and a gamepad's d-pad, stick, A and B give."
    variant up "Up."
    variant down "Down."
    variant left "Left."
    variant right "Right."
    variant next "The next control in reading order (Tab)."
    variant prev "The previous one (Shift+Tab)."
    variant activate "Press the focused control (Enter, Space, A)."
    variant back "Leave: the topmost dialog or menu closes, else og.ui.back() answers true (Escape, B)."
  }

  struct UiRect {
    doc "A rectangle of the play surface."
    field x f32 "Its left edge." {
      unit cssPx
    }
    field y f32 "Its top edge." {
      unit cssPx
    }
    field width f32 "Its width." {
      unit cssPx
    }
    field height f32 "Its height." {
      unit cssPx
    }
  }

  struct IconAtlasDesc {
    doc "The icon atlas: a texture of equal cells in a grid, named in reading order, or an icon set cooked like a font (font)."
    desc true
    field font Option.Font "An icon set from og.load.font (an `.ogt` of `type icons` naming SVGs, such as the UI kit's iconoir set): its icons are distance-field glyphs, crisp at any size and tinted by their ink, named by the set; texture, columns, rows and names are then not used."
    field texture Option.Texture "The atlas texture, from og.load.texture."
    field columns u32 "Cells across." {
      default 1
      min 1
    }
    field rows u32 "Cells down." {
      default 1
      min 1
    }
    field names List.String "Each cell's name, in reading order: a document's `<og-icon>` draws a cell by its name."
  }

  struct UiInlineImage {
    doc "A picture rich text draws inline by name ([img=<name>])."
    desc true
    field name String "The name markup gives it."
    field texture Option.Texture "The texture, from og.load.texture; null leaves the name unregistered."
    field uv Option.Array.f32.4 "The region drawn, [u0, v0, u1, v1] with v down; null is the whole texture."
    field aspect f32 "Width over height of the region as drawn; 0 is square." {
      min 0
    }
  }

  struct ToastDesc {
    doc "A toast's tone and time."
    desc true
    field tone Tone "Its tone: a dot of the tone's colour before the text."
    field durationMs f32 "How long it stays; 0 is 3200 ms (6000 for danger)." {
      unit ms
      min 0
    }
  }

  struct UiPointer {
    doc "The primary pointer as the UI reads it this tick."
    field x f32 "Its x from the surface's left." {
      unit cssPx
    }
    field y f32 "Its y from the surface's top." {
      unit cssPx
    }
    field inside bool "It is over the surface: false for a mouse that left it, or a touch screen with no finger down."
    field down bool "Its button or finger is down."
    field pressed bool "Its button or finger went down this tick: where a drag a component runs itself (an inventory's item, a card) starts."
    field released bool "Its button or finger came up this tick: where such a drag ends."
    field shift bool "A Shift key is held (a split stack, a quick transfer, a range of a list)."
    field ctrl bool "A Control key is held."
    field alt bool "An Alt (Option) key is held."
  }

  fn framePointer {
    doc "The primary pointer of the frame being built, without the world: for a component that hit-tests a shape it draws itself (a pie's wedges, a wheel's slices) by angle and radius rather than by rectangles. Keys and pads reach the same choices through focusable parts."
    returns UiPointer
  }

  fn frameCursor {
    doc "The pointer's shape the last frame resolved (never auto): the cursor set on what the press holds or the pointer is over, or around it, else its kind's. The web shell sets the canvas's CSS cursor from each frame's answer (`cursor`); a native host that draws its own window (og dev, Origin Desktop's shared frames) reads the same answer."
    returns Cursor
  }

  fn frameViewport {
    doc "The play surface of the frame being built: og.ui.viewport without the world, for code that only builds UI."
    returns Viewport
  }

  fn hasIcon {
    doc "Whether the icon atlas has an icon of this name (components draw a fallback otherwise)."
    param name String "The icon's name."
    returns bool
  }

  fn seconds {
    doc "The UI's clock in seconds: frames built over the tick rate (simulation time, never the wall clock)."
    returns f64
  }

  fn setFocus {
    doc "Move the focus (the pointer's, the keys' and pad 0's) to the element at a full path when this frame ends, if a focusable control is there then: a component moving the focus with its choice (a radio group's arrow keys, a list opening at its chosen option, a keyboard's first key). The ring shows as navigation's does. The last call in a frame wins; a path with no focusable control leaves the focus where it is."
    param path String "The element's full path (og.ui.focus, the probe's dump)."
    returns Void
  }

  fn scrollIntoView {
    doc "Scroll the scroll container around a control (an interactive or focusable element, by its full path) so the control is in its view, by where both were in the last frame: by the least that shows it whole, or centred in the view (a saga map opening on the current level, a list on its chosen row). The offset stays in the container's range and stops a fling. Nothing for a path the last frame had no control at or that is in no scroll container."
    param path String "The control's full path (og.ui.focus, the probe's dump)."
    param center bool "Centre it in the view, as far as the range allows; false scrolls by the least that shows it."
    returns Void
  }

  fn frameDirection {
    doc "The writing direction of the frame being built, `ltr` or `rtl` (og.i18n's locale sets it): code that draws its own arrows, chevrons or progress along a line mirrors them by it; layout mirrors rows and insets itself."
    returns String
  }

  fn frameTheme {
    doc "The style values of the frame being built: og.ui.theme without the world, for code that only builds UI (the components and patterns)."
    returns UiTheme
  }

  fn bounds {
    doc "Where an element was in the last frame, by id or `Parent/Child` path (topmost first), as touch_move_to resolves it."
    param path String "The id or path."
    returns Option.UiRect
  }

  struct ScrollState {
    doc "A scroll container as the last frame laid it out (og.ui.scrollState)."
    field offsetX f32 "How far its content is scrolled right." {
      unit cssPx
    }
    field offsetY f32 "How far its content is scrolled down." {
      unit cssPx
    }
    field viewWidth f32 "Its view's width, inside its padding." {
      unit cssPx
    }
    field viewHeight f32 "Its view's height, inside its padding." {
      unit cssPx
    }
    field contentWidth f32 "Its whole content's width, unclipped (the view's on an axis it does not scroll)." {
      unit cssPx
    }
    field contentHeight f32 "Its whole content's height, unclipped." {
      unit cssPx
    }
  }

  fn scrollState {
    doc "A scroll container's offset, view and whole content, by its full path (as the probe's dump names it): what a component virtualises its rows by, since og.ui.bounds is cut to the view and a row scrolled away has none. The offset is this tick's; the sizes are the last frame's. Null for a path that was no scroll container."
    param path String "Its full path."
    returns Option.ScrollState
  }

  fn toast {
    doc "Queue a toast: a row of the UI's $toasts store ({ id, text, tone, leaving }) for its time, then leaving for a fast duration; at most three are up (older ones leave first). It draws nothing itself: the built-in notifications screen shows $toasts after its own items, so load and push it once (og.load.document(world, \"@ui/screens/notifications.svelte\"), then og.ui.push(world, \"notifications\", { items: [] })), and a press on one dismisses it. Callable anywhere (systems, commands, start); it is world state, so snapshots carry it."
    aliases "snackbar, transient notification, popup message, auto-dismissing message"
    param world World "The world whose UI shows it."
    param text String "The message: a few words."
    param desc ToastDesc "Tone and time."
    returns u32 "Its id, for dismissToast."
  }

  fn dismissToast {
    doc "Start a toast's exit."
    param world World "The world."
    param toastId u32 "The id toast() answered."
    returns Void
  }

  fn navigate {
    doc "Queue a navigation intent for the next tick: a gamepad og.Input does not read yet, a custom binding, a command. A move queued while the focus is on nothing puts the focus on the first control, whatever its direction, and no further: moves asked again before the focus lands (each tick until og.ui.focus answers a path) land on that same first control."
    param world World "The world."
    param intent NavIntent "The intent."
    returns Void
  }

  fn back {
    doc "Escape or gamepad B this tick, not taken by a dialog or menu: true once, then taken. A pause screen closes on it. While a dialog or menu that Back closes is open (the topmost of the last frame) it answers false and leaves Back to it, even when asked before the dialog is built this tick: a HUD drawn under pause never takes the Back that closes pause. A locked dialog lets Back through."
    returns bool
  }

  fn setPlayers {
    doc "Local multiplayer: how many players this screen takes (1 to 4; 1 by default). Pads 1 to count - 1 each move a focus of their own among the same controls, shown as a ring in the player's colour (info, success, warn), and their A presses the control under it (Response.pad says which pad); pad 0 shares the one focus with the keyboard and the pointer, and Back and adjusting a slider stay pad 0's. Declare it every tick the screen shows; it takes effect from the next tick, and a dialog's focus scope holds every pad's focus inside it."
    param count u32 "Players, 1 to 4 (clamped)."
    returns Void
  }

  struct VirtualCursorDesc {
    doc "A pad's virtual cursor (docs/ui.md §2.1). The zero value moves at 900 units a second, takes a quarter second from a fine start to full speed, has a half-strength magnet and scrolls 1200 units a second."
    desc true
    field speed f32 "Units a second at full tilt; 0 is 900." {
      unit cssPx
      min 0
    }
    field accel f32 "Milliseconds a held stick takes from a third of its speed to all of it, for fine aim first; 0 is 250, negative is none." {
      unit ms
    }
    field magnet f32 "0 to 1: how much it slows over a control and, once the stick rests, pulls to the control's centre; 0 takes the style's motion magnet (the design language's timing table: 0.5), negative is none." {
      max 1
    }
    field scroll f32 "Units a second the right stick scrolls under it at full tilt; 0 is 1200, negative leaves the right stick to the game." {
      unit cssPx
    }
  }

  fn setVirtualCursor {
    doc "A pad's virtual cursor, for a screen built for the pointer (a map, a shop grid, a strategy HUD) played on a pad: pad 0's left stick moves it instead of the focus, slowing and sticking over controls; its A presses where it points as the mouse's button does (drags, sliders and long presses work); its right stick scrolls under it. The style draws it and the system cursor hides (og.ui.frameCursor answers none). The real pointer moving hides it and the stick shows it again. Declare it every tick the screen shows; it takes effect from the next tick. Null turns it off."
    param desc Option.VirtualCursorDesc "How it moves; null is none."
    returns Void
  }

  struct VirtualCursor {
    doc "Where a pad's virtual cursor is."
    field x f32 "Its x, from the surface's left." {
      unit cssPx
    }
    field y f32 "Its y, from the surface's top." {
      unit cssPx
    }
    field shown bool "It is shown: the stick moved it since the real pointer last moved."
  }

  fn virtualCursor {
    doc "The virtual cursor as the last frame left it; null when none is declared."
    returns Option.VirtualCursor
  }

  struct HudPlacement {
    doc "Where the player put a customisable element: moved from its laid-out place, scaled about its centre and faded."
    field x f32 "Moved right." {
      unit cssPx
    }
    field y f32 "Moved down." {
      unit cssPx
    }
    field scale f32 "Its scale (1: as laid out)." {
      unit ratio
    }
    field opacity f32 "Its opacity (1: opaque)." {
      unit ratio
    }
  }

  struct HudEdit {
    doc "The HUD edit mode as the last frame left it."
    field on bool "The edit mode is on."
    field player u32 "The player whose layout the screen shows and edits."
    field selected String "The key of the element being edited; empty for none."
    field placement HudPlacement "Its placement."
    field keys List.String "The customisable elements on screen, in drawing order."
    field changed bool "The player changed the layout this tick (a move ended, a step, a reset): the time to save og.ui.hudLayout in the game's settings."
  }

  fn setHudEdit {
    doc "Turns the HUD edit mode on or off (docs/ui.md §2.1; kept until changed). While it is on, elements with the `customize` attribute stop answering their own presses and show their outlines: a press selects one and a drag moves it, two touches or the wheel scale it, and with no virtual cursor pad 0's left stick moves the selected one. The hud-editor screen document (og ui eject hud-editor) gives the steps, Next, Reset and Done."
    param on bool "On or off."
    returns Void
  }

  fn setHudPlayer {
    doc "Whose layout this screen shows and edits, 0 to 3 (0 by default; kept until changed): each player of a shared screen keeps a layout of their own."
    param player u32 "The player (clamped to 3)."
    returns Void
  }

  fn hudEdit {
    doc "The HUD edit mode as the last frame left it."
    returns HudEdit
  }

  fn hudLayout {
    doc "A player's HUD layout as JSON, for the game's settings: each moved, scaled or faded element's key with its x, y, scale and opacity. Save it when HudEdit.changed says so; give it back with og.ui.setHudLayout on the next run."
    param player u32 "The player, 0 to 3."
    returns String
  }

  fn setHudLayout {
    doc "Gives a player's HUD layout back (og.ui.hudLayout's JSON; `{}` resets it). Answers false and leaves the layout as it was when it does not read (the reason is in the frame's warnings)."
    param player u32 "The player, 0 to 3."
    param layout String "The layout's JSON."
    returns bool
  }

  fn hudSelect {
    doc "Selects an element to edit by its key (empty: none)."
    param key String "Its key."
    returns Void
  }

  fn hudStep {
    doc "Steps the selected element's size and opacity: each -1, 0 or +1 step (a tenth larger or smaller, a tenth more or less opaque), within its limits."
    param scale i32 "The size step."
    param opacity i32 "The opacity step."
    returns Void
  }

  fn hudReset {
    doc "Puts an element back where it was laid out: its key, empty for the selected one, `*` for every one."
    param key String "Its key, empty or `*`."
    returns Void
  }

  fn focus {
    doc "The path of the control pad pad's focus is on in the last frame (pad 0: the shared focus of the pointer, keyboard and pad 0), as touch_move_to resolves it; empty when it is on none."
    param pad u32 "The pad, 0 to 3; past 3 answers empty."
    returns String
  }

  struct A11yNode {
    doc "One node of the accessibility tree: an element with a role (layout containers and spacers have none and are left out)."
    field path String "Its path, as touch_move_to and og.ui.focus name it."
    field parent String "The path of the nearest node above it in the tree; empty at the top."
    field role String "Its role (probe.UiElement.role): button, link, text, heading, image, checkbox, radio, switch, slider, spinbutton, textbox, combobox, listbox, option, tab, tablist, radiogroup, progressbar, meter, timer, status, alert, log, dialog, tooltip, separator, group, list, listitem, and the landmarks navigation, main, banner, contentinfo, complementary, article, region."
    field name String "Its accessible name: what a screen reader says it is. A text field or area is named by the label before it in its row, else by its placeholder, else by its id; never by the text in it (that is its value)."
    field description String "Read after the name (aria-description): a text field's placeholder when a label names it; empty for none."
    field value String "Its value as text (a slider's number, a progress's percent, a field's text); empty for none."
    field states List.String "Its states: disabled, focused, focusable, checked, selected, expanded, collapsed (expandable and closed), pressed, busy, offscreen (a scroll container cuts it out of view)."
    field valueMin Option.f32 "A range's smallest value (aria-valuemin): a slider's min, a bounded stepper's, 0 for a progress (in percent) and a meter; null for a stepper without bounds and a control that is no range."
    field valueMax Option.f32 "A range's largest value (aria-valuemax): a slider's max, a bounded stepper's, 100 for a progress, a meter's max; null as valueMin is."
    field valueNow Option.f32 "A range's value as a number (aria-valuenow; value says it as people read it): a slider's, a stepper's, a meter's, a progress's percent; null for a control that is no range."
    field level Option.u32 "A heading's level, 1 to 6 (aria-level; <h1> to <h6>); null for anything else."
    field live String "A live region's setting (aria-live, or its role's: status and log are polite, alert assertive): polite or assertive, empty for none. A screen reader announces what changes in it; the web mirror and the native tree speak it."
    field atomic bool "A live region that announces its whole text when any of it changes (aria-atomic, or its role's: status and alert); false for none."
    field notify bool "A live region that announces as it appears (an alert, a toast); another region announces only what changes in it after it entered."
    field x f32 "Left edge of the whole element." {
      unit cssPx
    }
    field y f32 "Top edge of the whole element." {
      unit cssPx
    }
    field width f32 "Width." {
      unit cssPx
    }
    field height f32 "Height." {
      unit cssPx
    }
  }

  struct A11yTree {
    doc "The last frame's accessibility tree, built from the same nodes the UI draws and takes input on."
    field nodes List.A11yNode "The nodes, in tree order: the page, then each layer over it (a dialog after the page)."
    field focusOrder List.String "The paths keyboard Tab and the pads visit, in order: the nodes marked focusable, within the topmost dialog while one is open."
    field focused String "The path keyboard and pad 0's focus is on; empty for none."
  }

  fn a11y {
    doc "The accessibility tree of the last frame: every element with a role, its name, value, states and bounds, and the focus order Tab walks. A shell mirrors it into the page for screen readers; a playtest reads the same fields on dump_ui's elements."
    returns A11yTree
  }

  fn feedback {
    doc "Play a UI event's feedback from the style (docs/ui.md §3.1): one sound of its set, at random and never the one it played last, at a volume and pitch from the set's ranges, and its haptic pattern at the player's strength (setHaptics). Widgets play their own events (press, focus, select, confirm, back, open, close, tab, toggleOn, toggleOff, sliderTick); game code plays the rest: scrollTick, typewriter, counterTick, notification, warning, error, success, reward and the reveals revealCommon to revealMythic. The choices come from the UI state, so a replay plays the same. An unknown event or one the style leaves silent plays nothing."
    param event String "The event's name."
    param rise f32 "A rising cascade's step, 0 to 1, walking the set's pitch range up (a counter's ticks); below 0 picks the pitch at random."
    returns Void
  }

  fn setHaptics {
    doc "The player's haptic strength (a settings screen's vibration slider or switch): 0 turns the UI's haptics off, 1 (the default) plays the style's patterns as set; between scales them. The web shell rumbles the gamepad and vibrates a phone; the native host rumbles its pad."
    param intensity f32 "0 to 1 (clamped)."
    returns Void
  }

  fn setNavigation {
    doc "Whether keyboard and gamepad navigation moves focus on this screen (on by default). A gameplay HUD whose keys move the player turns it off; an open dialog or menu turns it back on while it is open. Takes effect from the next tick."
    param on bool "On or off."
    returns Void
  }

  fn tick {
    doc "Frames the UI has built: its clock, for animations by the tick."
    returns u32
  }

  fn previewViewport {
    doc "Lay the UI out for another play surface (a phone in portrait at 3x, a notch) until cleared with null: for headless previews and playtests of responsive layouts. Render at width x dpr by height x dpr (`og run --size`)."
    param world World "The world."
    param viewport Option.Viewport "The surface to lay out for; null returns to the host's."
    returns Void
  }
