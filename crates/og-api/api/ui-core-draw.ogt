  # ── element draws (docs/ui.md §3.3): vector art and UI material handles ──

  handle VectorArt "A cooked SVG subset from a TS file.vector declaration, loaded by og.load.vector."
  handle UiMaterial "A custom UI material resource (an `.ogt` of `type ui-material`) from og.load.uiMaterial."

  column VectorArt {
    doc "A VectorArt handle field (0 is none): a vector handle og.load.vector answered."
    array Uint32Array
    stride 2
    value VectorArt
  }

  column UiMaterial {
    doc "A UiMaterial handle field (0 is none): a UI material handle og.load.uiMaterial answered."
    array Uint32Array
    stride 2
    value UiMaterial
  }

