module destruction {
  doc "Props that break (walls, crates, pillars, glass) and 2D ground that carves. A model cooked with a `fracture { }` block is cut by the cook into Voronoi chunks bonded where they touch; hits, og.destruction.damage and explode break an og.Destructible's bonds, each unanchored island falls as one body, and a stress solver (NVIDIA Blast's) breaks what can no longer carry its own weight. og.PixelTerrain is 2D ground of cells."
  doc "It runs in the tick after the game's systems, before og.physics, in fixed f32 arithmetic; bonds, islands, chunks and cells are world state on both hosts."
  guide "physics §9"
  core Destructible Chunk Fractured PixelTerrain PixelDetached damage explode info material fill2d explode2d MATERIAL_BRICK MATERIAL_CONCRETE MATERIAL_GLASS DamageDesc ExplosionDesc DestructibleInfo Fill2dDesc Explosion2dDesc

  const CAUSE_IMPACT u32 0 "Fractured.cause: a collision's impulse (og.CollisionStarted) past the prop's impactThreshold."
  const CAUSE_DAMAGE u32 1 "Fractured.cause: og.destruction.damage."
  const CAUSE_EXPLOSION u32 2 "Fractured.cause: og.destruction.explode; PixelDetached.cause: og.destruction.explode2d."
  const CAUSE_STRESS u32 3 "Fractured.cause: the stress solver: a part that could no longer hold its own weight."
  const CAUSE_SHATTER u32 4 "Fractured.cause: a chunk with children (the fracture block's `children`) took three times the damage that breaks a bond of its cross-section, and broke into them: they fly free, each its own body, leaving a hole."
  const MATERIAL_BRICK u32 0 "og.destruction.material: brickwork in mortar (no-tension masonry: stands by its weight, steps back over its piers)."
  const MATERIAL_CONCRETE u32 1 "og.destruction.material: plain concrete (strong, breaks in chunky lumps, holds what is left)."
  const MATERIAL_WOOD u32 2 "og.destruction.material: timber boards (light and weak across the grain: splinters where it lands or is struck)."
  const MATERIAL_GLASS u32 3 "og.destruction.material: a glass pane (shatters at a touch, no stress solver)."
  const MATERIAL_STONE u32 4 "og.destruction.material: dry-laid stone (masonry with no mortar: no tension, heavier and tougher than brick)."
  const CAUSE_FRACTURE u32 5 "Fractured.cause: og.destruction.fracture; PixelDetached.cause: og.destruction.fracture2d."
  const CAUSE_CARVE u32 6 "PixelDetached.cause: og.destruction.carve2d cut it loose."

  component Destructible {
    doc "Breaks the entity's og.Model, cooked with a `fracture` block, into its chunks (3D profile). A standing prop (no og.RigidBody, or a static one) is its chunks from the first tick: each a static og.Collider (its piece's hull) on an og.Chunk, replacing the entity's own Collider and RigidBody. A moving prop (a dynamic or kinematic body) collides as itself until its first break, when its chunks replace its Collider, RigidBody and Velocity, moving as it moved. Then each chunk draws its piece of the hidden model (its tint, variant, shadows)."
    doc "Chunks' colliders and mass follow og.Transform.scale's mean."
    guide "physics §9"
    aliases "breakable, destructable, destructible prop, fracture, Unreal Geometry Collection"
    field toughness f32 "How much damage a square metre of bond takes before it breaks: an impulse of that many newton-seconds through 1 m² (a hit spreads over impactRadius). Glass about 50, wood 300, brick 800, concrete 2000." {
      default 800
      min 0
      unit newtonSecondPerM2
      tunable true
    }
    field strength f32 "The stress its bonds hold in tension and shear before they weaken; compression holds thirty times as much, shear more by `friction`, and a bond breaks outright at twice the stress. 0 turns the stress solver off." {
      guide "physics §9"
      default 30000
      min 0
      unit pascal
      tunable true
    }
    field friction f32 "How much more shear a bond holds per pascal of compression across it (Mohr–Coulomb: the tangent of the friction angle). 0 is shear at strength alone." {
      guide "physics §9"
      default 0.7
      min 0
      max 4
      tunable true
    }
    field tension f32 "The stress its bonds hold pulled apart, as a fraction of strength (shear and compression keep strength's); 1 is tension at strength. At 0.1 or below, with strength above 0, a standing block also needs its weight within the middle third of what bears it from below, or it comes loose whole." {
      guide "physics §9"
      default 1
      min 0
      max 1
      tunable true
    }
    field density f32 "The chunks' density: their mass as bodies and their weight in the stress solver." {
      default 1000
      min 1
      unit kgPerM3
      tunable true
    }
    field impactThreshold f32 "A collision's impulse (og.CollisionStarted.impulse) that does no damage: the excess is the hit's damage and, on a prop that stood still, the push its broken-loose pieces take along the striker's path (shared by falloff, none faster than the striker closed); a moving prop's keep their velocity." {
      guide "physics §9"
      default 30
      min 0
      unit newtonSecond
      tunable true
    }
    field impactRadius f32 "How far a hit's damage reaches round its point (all of it within a third of this, falling to nothing at it)." {
      default 0.4
      min 0.01
      unit m
      tunable true
    }
    field anchored bool "Whether its anchors (the chunks on its floor) hold it to the world; false, every island falls." {
      default true
    }
    field breakFx ParticleEmitter "A one-shot emitter (og.load.emitter, `looping false`) burst where each island breaks loose, at its broken faces: the material's own, a lit dust puff for stone and brick, splinters and a little dust for wood, shards and glints for glass. 0 none."
    field hitFx ParticleEmitter "A one-shot emitter burst at each hit that damages it: the material's own, grit and a puff off stone, splinters off wood, glints off glass; sparks only off metal, and a few. 0 none."
    field debris ParticleEmitter "GPU-only debris: a shattering chunk's pieces under og.Destruction.debrisVolume never become bodies but fly on the GPU for debrisLifetime, never touching the simulation (none drawn without visualDebris); this mesh-particle emitter bursts finer grains where they land. 0: every piece is a body." {
      guide "physics §9"
    }
    field fractured bool "Written: true from its first break (the model hidden, its chunks drawn)." {
      readonly true
    }
    field broken u32 "Written: its bonds broken so far." {
      readonly true
    }
    field loose u32 "Written: its chunks that have broken loose and still exist." {
      readonly true
    }
  }

  component Chunk {
    doc "One chunk of an og.Destructible, written by og.destruction when the prop fractures. A loose chunk is a dynamic body (with og.RigidBody and og.Velocity, or a child collider of its island's body); an anchored one a static collider. Drawn with its part of the destructible's model. Despawn it to clear it away."
    field destructible Entity "The og.Destructible it belongs to." {
      readonly true
    }
    field chunk u32 "Its index in the fracture asset." {
      readonly true
    }
    field level u32 "1 a support chunk, 2 a chunk's child." {
      readonly true
    }
    field body Entity "The entity whose og.RigidBody moves it: its own, its island's body, or 0 while anchored." {
      readonly true
    }
    field looseTick u32 "The tick it broke loose; 4294967295 while anchored." {
      default 4294967295
      readonly true
    }
  }

  event Fractured {
    doc "An island of chunks broke loose from a destructible during the tick (or the destructible shattered): read the tick after, for its sound, its camera shake, its score. Sent in the order the islands broke."
    field entity Entity "The og.Destructible."
    field body Entity "The island's body: the entity with its og.RigidBody."
    field chunks u32 "Its chunks."
    field point Vector3 "Where it broke: the centre of its broken bonds." {
      unit m
      worldspace world
    }
    field volume f32 "Its volume." {
      unit m3
    }
    field mass f32 "Its mass." {
      unit kg
    }
    field cause u32 "What broke it: one of the CAUSE_* codes."
  }

  resource Destruction {
    doc "The world's destruction budgets."
    field maxChunks u32 "The most loose chunks alive at once, over every destructible: past it the oldest loose islands (the smallest first among those that broke in the same tick) despawn, each with every chunk it carries." {
      default 256
      min 1
      max 4096
      tunable true
    }
    field debrisVolume f32 "A loose island smaller than this is debris: it despawns debrisLifetime after it broke loose." {
      default 0.004
      min 0
      unit m3
      tunable true
    }
    field debrisLifetime f32 "How long debris lasts (0: until maxChunks takes it)." {
      default 8
      min 0
      unit s
      tunable true
    }
    field fxLifetime f32 "How long a breakFx or hitFx burst's entity lasts before og.destruction despawns it." {
      default 3
      min 0
      unit s
    }
    field stressIterations u32 "The stress solver's iterations when a destructible's support changes (Blast's maxIter). 0, the default, solves until it converges (at most six times its bonds); a capped, unconverged solve loads distant bonds too little, and what should fall can stand." {
      default 0
      min 0
      max 1000
    }
    field stressBudget u32 "The stress solver's work in one tick, across every destructible, in bond-iterations (one solver iteration over one bond). A solve that would start past it waits for the next tick, in the destructibles' entity order, so a tick's worst case is this plus one solve. 0 sets no limit." {
      guide "physics §9"
      default 200000
      min 0
      tunable true
    }
  }

  struct DamageDesc {
    doc "A radial damage for og.destruction.damage."
    desc true
    field point Vector3 "Where it lands, in world space." {
      unit m
    }
    field radius f32 "How far it reaches; it falls linearly to nothing here from innerRadius." {
      default 0.4
      min 0
      unit m
    }
    field innerRadius f32 "Within this the bonds take the whole amount." {
      default 0.1
      min 0
      unit m
    }
    field amount f32 "The damage, as an impulse through a bond (Destructible.toughness says how much a square metre takes)." {
      default 500
      min 0
      unit newtonSecond
    }
    field impulse Vector3 "The momentum the blow carries, along its direction (a hammer, a wrecking ball, a shot): the pieces it breaks loose share it by its falloff and fly on, as a hit's do. Zero, the default, crushes without pushing, and what it breaks out of a standing prop can stay standing on what holds it." {
      unit newtonSecond
    }
  }

  struct ExplosionDesc {
    doc "An explosion for og.destruction.explode."
    desc true
    field point Vector3 "Its centre, in world space." {
      unit m
    }
    field radius f32 "How far it reaches." {
      default 3
      min 0
      unit m
    }
    field innerRadius f32 "Within this everything takes the whole damage and push." {
      default 0.5
      min 0
      unit m
    }
    field damage f32 "The damage to every destructible's bonds in reach, as og.destruction.damage's amount." {
      default 3000
      min 0
      unit newtonSecond
    }
    field impulse f32 "The push outwards on every loose piece in reach, per square metre of the face it shows the blast (the two-thirds power of its volume), at its centre, falling off as the damage does. The pieces it drives apart pull on the bonds between them." {
      guide "physics §9"
      default 2000
      min 0
      unit newtonSecondPerM2
    }
  }

  struct DestructibleInfo {
    doc "What a destructible holds and how much of it stands (og.destruction.info)."
    field chunks u32 "Its support chunks."
    field children u32 "Their children, all told."
    field bonds u32 "The bonds of its support graph."
    field intact u32 "The bonds not yet broken."
    field islands u32 "Its islands now."
    field anchored u32 "Its support chunks still held to the world."
    field health f32 "Its bonds' remaining health over their total, 1 intact to 0 rubble." {
      min 0
      max 1
    }
    field debris u32 "Its fine pieces on the GPU now (og.Destructible.debris): broken off within og.Destruction.debrisLifetime, whether or not this device draws them."
    field crumbs u32 "Its broken joints shedding grit on the GPU now (og.Destructible.debris): a few clay and mortar chips each, broken within og.Destruction.debrisLifetime (at most 48 joints a tick, spread over all that broke), whether or not this device draws them."
  }

  struct DestructibleMaterial {
    doc "A material's og.Destructible fields (og.destruction.material): spread it into the component and add the material's fx, `{ ...og.destruction.material(world, MATERIAL_BRICK), breakFx }`, so a prop is tuned by what it is made of rather than by numbers in the scene. Its fields are og.Destructible's, for a prop of about a metre; override any one after the spread."
    field toughness f32 "og.Destructible.toughness." {
      unit newtonSecondPerM2
    }
    field strength f32 "og.Destructible.strength." {
      unit pascal
    }
    field friction f32 "og.Destructible.friction."
    field tension f32 "og.Destructible.tension."
    field density f32 "og.Destructible.density." {
      unit kgPerM3
    }
    field impactThreshold f32 "og.Destructible.impactThreshold." {
      unit newtonSecond
    }
    field impactRadius f32 "og.Destructible.impactRadius." {
      unit m
    }
  }

  struct DestructionCapabilities {
    doc "What destruction does on this device."
    field visualDebris bool "Whether og.Destructible.debris pieces and bursts are simulated and drawn on the GPU here (a renderer with compute passes: og.render.capabilities' compute); false draws none. Pieces given to `debris` are never bodies, on any device, so a game never depends on it."
    field maxVisualDebris u32 "The most fine pieces the GPU layer holds at once: past it the oldest go first (og.Destruction.debrisLifetime takes them sooner)."
    field visualDebrisContacts String "What the GPU pieces collide with: `world` (the colliders that are boxes, spheres and terrains); they pass through each other and through the chunks that are bodies."
  }

  fn damage {
    doc "Damage a destructible at a point: every bond, anchor and chunk within reach takes the amount, all of it within innerRadius and falling to nothing at radius. Applied by og.destruction after the game's systems this tick (in the order called), so a bond broken now splits the prop before this tick's physics step."
    param world World "The world."
    param entity Entity "An entity with og.Destructible, or one of its chunks."
    param desc DamageDesc "Where, how far and how much."
    returns Result.Void "Refused for an entity that is neither, or a point that is not finite."
  }

  fn explode {
    doc "An explosion: damage to every destructible in reach (as og.destruction.damage), then a push outwards to their loose chunks. Applied by og.destruction this tick, as damage. Push other bodies with og.physics.applyImpulse."
    aliases "blast, explosion, shatter, demolish, blow apart"
    param world World "The world."
    param desc ExplosionDesc "Its centre, reach, damage and push."
    returns Result.Void "Refused for a point that is not finite."
  }

  fn fracture {
    doc "Break every bond of a destructible at once (this tick, as damage): its anchored chunks stay, the rest fall."
    param world World "The world."
    param entity Entity "An entity with og.Destructible."
    returns Result.Void "Refused for an entity without one."
  }

  fn info {
    doc "How much of a destructible stands."
    param world World "The world."
    param entity Entity "An entity with og.Destructible."
    returns Result.DestructibleInfo "Refused for an entity without one, or one whose model is not loaded or has no fracture."
  }

  fn material {
    doc "A material's og.Destructible tuning (MATERIAL_*): toughness, strength, friction, tension, density and how hard a hit must be to hurt it, measured against the props of the destruction-yard test fixture (a brick wall, a concrete pillar, a crate, a pane). Pair it with a model whose fracture block has the same `style` (brick, concrete, wood, glass)."
    param world World "The world."
    param kind u32 "MATERIAL_*."
    returns Result.DestructibleMaterial "Refused for a kind that is none of MATERIAL_*."
  }

  fn capabilities {
    doc "What destruction does on this device."
    param world World "The world."
    returns DestructionCapabilities
  }

  component PixelTerrain {
    doc "Destructible 2D ground of square cells: ground, bedrock or empty. Its og.Transform's position is cell (0, 0)'s bottom-left corner, x right, y up (rotation and scale unused). Filled the first tick it is seen; carve2d, fill2d, explode2d and fracture2d change it in the tick (og.destruction2d, before og.physics)."
    doc "Each `chunk` × `chunk` block with a solid cell is an entity with a static og.Collider (SHAPE_TRIMESH) of its outline smoothed within `tolerance`, rebuilt only when a change touches it. Ground no longer joined through cell sides to bedrock or the bottom row falls as og.PixelPiece entities."
    guide "physics §9"
    aliases "destructible terrain, pixel terrain, worms terrain, noita, carve ground, deformable terrain, 2D destruction"
    field width u32 "Its cells across. Changing it starts the terrain over, filled again." {
      default 256
      min 1
      max 4096
    }
    field height u32 "Its cells up. Changing it starts the terrain over, filled again." {
      default 128
      min 1
      max 4096
    }
    field cellSize f32 "A cell's side." {
      default 0.0625
      min 0.001
      unit m
    }
    field chunk u32 "The side of the blocks of cells that collide and rebuild together: smaller rebuilds less per carve and makes more colliders. Changing it starts the terrain over, filled again." {
      default 32
      min 4
      max 256
    }
    field ground f32 "How much of its height is ground (bedrock included) when it is first filled; 0 starts it empty, to build with fill2d." {
      default 0.5
      min 0
      max 1
      unit ratio
    }
    field bedrock u32 "The rows of bedrock at its bottom when it is first filled: never carved, and what the ground must stay joined to (as to the bottom row) to stand." {
      default 1
    }
    field seed u32 "The seed of its grain and of the pieces explode2d and fracture2d cut."
    field color Color "The ground's colour." {
      default 0.30 0.18 0.09
    }
    field bedrockColor Color "The bedrock's colour." {
      default 0.10 0.10 0.11
    }
    field grain f32 "How much each ground cell's brightness varies, fixed per cell by the seed (pieces keep the grain of the ground they were)." {
      default 0.15
      min 0
      max 1
    }
    field layer i32 "Its sprite's draw order (its pieces' too); higher draws on top."
    field friction f32 "Its colliders' and its pieces' friction." {
      default 0.6
      min 0
    }
    field density f32 "Its pieces' density (per square metre in 2D)." {
      default 1000
      min 1
      unit kgPerM3
    }
    field layers u32 "Its colliders' and pieces' collision layers, as og.Collider.layers." {
      default 1
    }
    field mask u32 "The layers they collide with, as og.Collider.mask." {
      default 4294967295
    }
    field tolerance f32 "How far, in cells, the collision outline may cut across the cells' stair steps." {
      default 0.5
      min 0
      max 4
    }
    field minPiece u32 "An island cut loose with fewer cells vanishes instead of falling as an og.PixelPiece." {
      default 4
    }
    field maxPieces u32 "The most og.PixelPiece entities of this terrain at once: past it the oldest despawn." {
      default 64
      min 1
      max 1024
    }
    field solid u32 "Written: its solid cells (ground and bedrock)." {
      readonly true
    }
  }

  component PixelPiece {
    doc "A piece of an og.PixelTerrain cut loose (an island carve2d cut free, a piece explode2d threw or fracture2d broke off), written by og.destruction2d: a dynamic og.RigidBody whose og.Collider is the convex hull of its cells (SHAPE_CONVEX, a polygon in 2D), drawn as its cells at its og.Transform (the bottom-left corner of its cell (0, 0), turning with the body). Its cells are world state; despawn it to clear it away."
    field terrain Entity "The og.PixelTerrain it was part of." {
      readonly true
    }
    field width u32 "Its cells across." {
      readonly true
    }
    field height u32 "Its cells up." {
      readonly true
    }
    field cells u32 "Its solid cells." {
      readonly true
    }
    field tick u32 "The tick it broke loose." {
      readonly true
    }
  }

  event PixelDetached {
    doc "Cells of an og.PixelTerrain (or of an og.PixelPiece fracture2d broke) broke loose during the tick, read the tick after: one for each piece, in the order they were cut, for its sound, its dust, its score."
    field terrain Entity "The og.PixelTerrain."
    field piece Entity "The og.PixelPiece it became; 0 for an island under minPiece, which vanished."
    field cells u32 "Its cells."
    field point Vector3 "Its centre." {
      unit m
      worldspace world
    }
    field cause u32 "What broke it loose: CAUSE_CARVE, CAUSE_EXPLOSION or CAUSE_FRACTURE."
  }

  struct Carve2dDesc {
    doc "A round hole for og.destruction.carve2d."
    desc true
    field point Vector3 "Its centre, in world space (its xy)." {
      unit m
    }
    field radius f32 "Its radius: every cell whose centre is within it is emptied (bedrock stays)." {
      default 1
      min 0
      unit m
    }
  }

  struct Fill2dDesc {
    doc "A round patch of ground for og.destruction.fill2d."
    desc true
    field point Vector3 "Its centre, in world space (its xy)." {
      unit m
    }
    field radius f32 "Its radius: every cell whose centre is within it is made solid." {
      default 1
      min 0
      unit m
    }
    field bedrock bool "Fill with bedrock (never carved) instead of ground."
  }

  struct Explosion2dDesc {
    doc "A blast for og.destruction.explode2d."
    desc true
    field point Vector3 "Its centre, in world space (its xy)." {
      unit m
    }
    field radius f32 "The hole it blows in every og.PixelTerrain in reach." {
      default 1.5
      min 0
      unit m
    }
    field debris f32 "The width of the ring of ground round the hole that it breaks into pieces and throws (0 none): the ground there is cut into Voronoi pieces of about pieceCells cells, each an og.PixelPiece." {
      default 0.4
      min 0
      unit m
    }
    field pieceCells u32 "About how many cells each thrown piece has." {
      default 24
      min 4
    }
    field speed f32 "How fast it throws the pieces it cuts and the islands it cuts loose outwards, at its centre, falling linearly to nothing at radius plus debris; the og.PixelPiece entities already in reach take the same push on their og.Velocity." {
      default 8
      min 0
      unit mps
    }
  }

  struct Fracture2dDesc {
    doc "How og.destruction.fracture2d breaks a piece."
    desc true
    field pieces u32 "How many Voronoi pieces (fewer when some are under the terrain's minPiece cells)." {
      default 8
      min 1
      max 256
    }
  }

  fn carve2d {
    doc "Empty a round hole in an og.PixelTerrain, this tick (applied by og.destruction2d after the game's systems, in the order called): the chunks it touches collide as their new outline before this tick's physics step, and what it cuts loose falls."
    aliases "dig, carve terrain, crater, destroy ground"
    param world World "The world."
    param entity Entity "An entity with og.PixelTerrain."
    param desc Carve2dDesc "Where and how big."
    returns Result.Void "Refused for an entity without og.PixelTerrain, or a point or radius that is not finite."
  }

  fn fill2d {
    doc "Make a round patch of an og.PixelTerrain solid (ground, or bedrock), this tick, as carve2d. Bedrock stays bedrock."
    aliases "build terrain, add ground, paint terrain"
    param world World "The world."
    param entity Entity "An entity with og.PixelTerrain."
    param desc Fill2dDesc "Where, how big and what with."
    returns Result.Void "Refused for an entity without og.PixelTerrain, or a point or radius that is not finite."
  }

  fn explode2d {
    doc "A blast on every og.PixelTerrain in reach, this tick, as carve2d: a hole of `radius`, the ring of ground `debris` wide round it cut into Voronoi pieces and thrown outwards, the islands it cuts loose and the pieces already in reach pushed outwards. Push other bodies with og.physics.applyImpulse."
    aliases "2D explosion, worms explosion, blast terrain"
    param world World "The world."
    param desc Explosion2dDesc "Its centre, reach and push."
    returns Result.Void "Refused for a point or a size that is not finite."
  }

  fn fracture2d {
    doc "Break an og.PixelPiece (or every cell of an og.PixelTerrain but its bedrock) into Voronoi pieces, this tick, as carve2d: each piece is an og.PixelPiece moving as what it broke from moved; the piece broken is despawned."
    aliases "shatter 2D, break sprite, voronoi 2D"
    param world World "The world."
    param entity Entity "An entity with og.PixelPiece or og.PixelTerrain."
    param desc Fracture2dDesc "How many pieces."
    returns Result.Void "Refused for an entity with neither."
  }

  fn cell2d {
    doc "The cell of an og.PixelTerrain under a world point, as the last tick left it: 0 empty, 255 bedrock, any other ground (fill2d writes 1). Outside the terrain, 0."
    param world World "The world."
    param entity Entity "An entity with og.PixelTerrain."
    param point Vector3 "A world point (its xy)."
    returns Result.u32 "Refused for an entity without og.PixelTerrain, or one og.destruction2d has not yet filled (the tick after it is added)."
  }
}
