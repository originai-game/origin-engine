  component Rope {
    aliases "chain, cable, swinging lantern, hanging rope, XPBD rope"
    doc "A small-step XPBD rope with explicit velocities and point masses. Its start and end follow any Transform entity. Changing length reels it without rebuilding its points; coupling applies endpoint and solid contact impulses to dynamic bodies. Points, velocities and broken links are world state."
    field segments u32 "The number of links (points minus one)." {
      default 16
      min 1
      max 256
    }
    field length f32 "The rope's length at rest." {
      default 4
      min 0
      unit m
      tunable true
    }
    field offset Vector3 "The start's offset from the entity's position (world axes)." {
      unit m
    }
    field end Entity "The entity the far end is tied to; 0 leaves it free."
    field endOffset Vector3 "The far end's offset from `end`'s position." {
      worldspace none
      unit m
    }
    field stiffness f32 "Physical XPBD axial stiffness in N/m; compliance is 1/stiffness (0: constraints off)." {
      default 100000
      min 0
      tunable true
    }
    field mass f32 "Mass of each free point in kg (0: fixed)." {
      default 0.1
      min 0
      unit kg
    }
    field substeps u32 "Small steps per tick (0: simulation off)." {
      default 4
      min 0
      max 16
    }
    field coupling bool "Apply endpoint and solid contact reactions to dynamic bodies."
    field breakForce f32 "Break links above this force in N (0: unbreakable). Broken links stay broken until rebuilt." {
      min 0
    }
    field iterations u32 "XPBD constraint passes per substep; stiffness sets physical compliance." {
      default 12
      min 1
      max 64
      tunable true
    }
    field damping f32 "Velocity decay rate (0: none): each substep h keeps 1 / (1 + damping * h) of a point's velocity." {
      default 0.6
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration of its own, added to og.Wind's push (its velocity as an acceleration, per second)." {
      unit mps2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.05
      min 0
      unit m
      tunable true
    }
    field width f32 "The drawn width." {
      default 0.08
      min 0
      unit m
    }
    field color Color "The drawn colour." {
      default 0.55 0.42 0.28
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  enum Simulation {
    doc "Where a cloth, a garment, a soft body or a 3D fluid is simulated: Cloth.simulation, Garment.simulation, SoftBody.simulation and Fluid3D.simulation."
    guide "physics §8"
    variant gameplay "In the physics step on the CPU, deterministic: its points are world state that snapshots, replays, lockstep and the hash carry, and that og.physics.clothPoints, softBodyPoints and garmentPoints read. The default."
    variant visual "By the renderer on the GPU for looks only, never read back. The tick's points are the rest shape carried rigidly by the entity (a garment's: the skinned pose). Without RenderCapabilities.visualSimulation it draws that shape."
  }

  column Simulation {
    doc "A Simulation field: the variant's index."
    array Uint32Array
    stride 1
    value Simulation
  }

  const PIN_TOP u32 1 "`Cloth.pins` bit: the whole top row is pinned."
  const PIN_TOP_CORNERS u32 2 "`Cloth.pins` bit: the top-left and top-right corners are pinned."
  const PIN_LEFT u32 4 "`Cloth.pins` bit: the whole left column is pinned (a flag on a pole)."
  const PIN_TOP_RINGS u32 8 "`Cloth.pins` bit: every fourth point of the top row (curtain rings)."

  component Cloth {
    doc "A small-step XPBD cloth: a columns by rows grid, pinned to its entity, with stretch, dihedral bending, long-range attachments, relative-air drag and lift, and self-collision. Velocities and area-lumped inverse masses are explicit world state; there is no self-collision speed cap."
    aliases "flag, banner, curtain, sail, Unity Cloth, Unreal Chaos Cloth"
    field columns u32 "Points across." {
      default 12
      min 2
      max 64
    }
    field rows u32 "Points down." {
      default 12
      min 2
      max 64
    }
    field spacing f32 "The rest distance between neighbouring points." {
      default 0.15
      min 0.001
      unit m
      tunable true
    }
    field pins u32 "Which points are pinned, a sum of PIN_* bits (1 top row, 2 top corners, 4 left column, 8 top rings)." {
      default 1
    }
    field stiffness f32 "Physical XPBD stretch stiffness in N/m (0: off)." {
      default 100000
      min 0
      tunable true
    }
    field bending f32 "Physical XPBD dihedral stiffness (0: off)." {
      min 0
      tunable true
    }
    field tether f32 "Long-range attachment stiffness in N/m (0: off)." {
      min 0
      tunable true
    }
    field density f32 "Surface mass density in kg/m² (0: fixed)." {
      default 1
      min 0
    }
    field drag f32 "Quadratic relative-air drag coefficient (0: off)." {
      min 0
      tunable true
    }
    field lift f32 "Relative-air lift coefficient (0: off)." {
      min 0
      tunable true
    }
    field iterations u32 "XPBD constraint passes per substep." {
      default 8
      min 1
      max 64
      tunable true
    }
    field damping f32 "Velocity decay rate (0: none): each substep h keeps 1 / (1 + damping * h) of a point's velocity." {
      default 0.9
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "Air velocity added to the per-point wind field. Drag and lift use air minus point velocity; both coefficients zero disable aerodynamic forces." {
      guide "physics §8"
      unit mps
      tunable true
    }
    field gust f32 "How much the wind varies over the cloth and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field thickness f32 "Self-collision: how far apart its points keep from the points of the cloth that are not their near neighbours (0: none). About `spacing` keeps a cloth that folds or piles up from passing through itself." {
      min 0
      unit m
      tunable true
    }
    field substeps u32 "Small steps per tick, each integrating explicit velocity and solving iterations XPBD passes (0: off)." {
      default 1
      min 0
      max 16
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step (0: it slides freely; near 1 it sticks where it lands, so a cloth lowered onto the floor folds instead of spreading)." {
      min 0
      max 1
      tunable true
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain cloth."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
  }

  component Garment {
    doc "A skinned small-step XPBD garment with explicit velocities, area-lumped masses, dihedral bending and relative-air drag and lift. Scaled maxDistance bounds each point about its skinned target; backstopRadius enables a spherical backstop behind it. bodyRadius enables skeleton capsules. pinTop and vertex red times alpha control freedom. teleportDistance resets large pose jumps. Solid contacts exchange momentum with dynamic bodies. World state, 3D only; blendshapes are not applied."
    guide "physics §8"
    field mesh u32 "The glTF mesh of the entity's model that is the garment (its primitives together), as og.Blendshapes.mesh."
    field maxDistance f32 "How far a point may stray from where the skinned pose puts it." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field pinTop f32 "Points within this height of the garment's top at rest (the bind pose, the model's +y) stay on the skinned pose: a skirt's waistband, a cape's collar." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field backstop f32 "Offset of the spherical backstop behind the skin, scaled by the pose; used with backstopRadius." {
      min 0
      unit m
      tunable true
    }
    field backstopRadius f32 "Spherical backstop radius, scaled by the pose (0: off)." {
      min 0
      unit m
    }
    field bodyRadius f32 "Radius of skeleton bone capsules in model metres, scaled by the character (0: off). Hosts may supply tapered capsules through GarmentPose." {
      min 0
      unit m
    }
    field teleportDistance f32 "Reset on target translations larger than this, scaled by the pose (0: off)." {
      min 0
      unit m
    }
    field density f32 "Surface mass density in kg/m² (0: fixed)." {
      default 1
      min 0
    }
    field drag f32 "Quadratic relative-air drag coefficient (0: off)." {
      min 0
      tunable true
    }
    field lift f32 "Relative-air lift coefficient (0: off)." {
      min 0
      tunable true
    }
    field stiffness f32 "Physical XPBD edge stiffness in N/m (0: off)." {
      default 100000
      min 0
      tunable true
    }
    field bending f32 "Physical XPBD dihedral stiffness (0: off)." {
      default 0.1
      min 0
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 6
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 1
      min 1
      max 16
    }
    field damping f32 "Velocity decay rate (0: none): each substep h keeps 1 / (1 + damping * h) of a point's velocity." {
      default 1.85
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "Air velocity added to the per-point wind field. Drag and lift act on relative air velocity (zero coefficients: off)." {
      guide "physics §8"
      unit mps
      tunable true
    }
    field gust f32 "How much the wind varies over the garment and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides with solid colliders at (0: no collision; the skinned pose, through `maxDistance` and `backstop`, holds it on the body). A character's own collider counts: keep it inside the body, or leave this 0." {
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      min 0
      max 1
      tunable true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
  }


  enum SoftBodyShape {
    doc "What a soft body is built as: SoftBody.shape."
    variant sphere "A sphere of `radius` (an icosphere; 2D a ring)."
    variant box "A box of `size` (each face a grid of `detail` + 1 cells; 2D a rectangle)."
    variant mesh "The closed surface of geometry `mesh` (3D only)."
  }

  column SoftBodyShape {
    doc "A SoftBodyShape field: the variant's index."
    array Uint32Array
    stride 1
    value SoftBodyShape
  }

  component SoftBody {
    doc "An XPBD soft volume with explicit velocities, area-lumped masses, edge constraints and centroid-relative signed volume (2D: area). tetraStiffness enables local hydrostatic volume constraints on a centroid fan. Solid contacts exchange momentum with dynamic bodies. Built at the entity's world pose when its shape or mesh revision changes. Points are world state; og.physics.softBodyPoints reads them and material draws the surface."
    guide "physics §8"
    field shape SoftBodyShape "sphere, box or mesh."
    field radius f32 "A sphere's radius." {
      default 0.5
      min 0.01
      unit m
      tunable true
    }
    field size Vector3 "A box's full extents." {
      default 1 1 1
      min 0
      unit m
    }
    field detail u32 "How finely its surface is divided: a sphere 0 to 3 (12, 42, 162 or 642 points; 2D 12 to 96), a box 0 to 7 (cells along a face's edge, minus one)." {
      guide "physics §8"
      default 2
      min 0
      max 7
    }
    field mesh Geometry "The mesh shape's geometry: a loaded glTF's (registered automatically) or one given to og.physics.setMesh; closed, its vertices welded where they meet."
    field stiffness f32 "Physical XPBD edge stiffness in N/m; compliance is 1/stiffness (0: off)." {
      default 100000
      min 0
      tunable true
    }
    field pressure f32 "The volume it keeps, as a share of its rest volume: 1 holds it, above inflates it, 0 holds none (it slumps like cloth)." {
      default 1
      min 0
      max 4
      tunable true
    }
    field volumeStiffness f32 "Physical XPBD volume stiffness (0: off). Volume and gradients use centroid-relative coordinates." {
      default 100000
      min 0
      tunable true
    }
    field tetraStiffness f32 "Per-tetrahedron hydrostatic volume stiffness about the centroid (0: off)." {
      min 0
      tunable true
    }
    field density f32 "Surface mass density in kg/m² (0: fixed)." {
      default 1
      min 0
    }
    field iterations u32 "Constraint passes per substep." {
      default 8
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 16
    }
    field damping f32 "Velocity decay rate (0: none): each substep h keeps 1 / (1 + damping * h) of a point's velocity." {
      default 0.3
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field thickness f32 "The distance its points keep from solids (0: no collision)." {
      default 0.03
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      default 0.3
      min 0
      max 1
      tunable true
    }
    field pinTop f32 "Points within this height of its top at rest are pinned to the entity and follow it (0: none): a water balloon on a string." {
      min 0
      unit m
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain one."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
    field volume f32 "Written: its volume (2D: area) now over its rest volume; below 1 squashed, above inflated; 1 when simulation is visual." {
      default 1
      readonly true
    }
    field center Vector3 "Written: the mean of its points, in world space." {
      worldspace world
      unit m
      readonly true
    }
  }

  component Fluid2D {
    doc "Deterministic 2D Position Based Fluids in the xy plane: predicted-position neighbour hashing, symmetric mass-weighted density projection, artificial pressure, stable XSPH viscosity and optional vorticity confinement. Groups interpolate material properties by mix; solid contacts exchange impulses with dynamic bodies. Count, seed or size changes rebuild the spawn lattice. Particles and mix are world state; drawn as metaballs on layer."
    field count u32 "How many particles (spawned when the component appears or count changes)." {
      default 1000
      min 0
      max 8192
    }
    field size Vector2 "The spawn box, centred on the entity." {
      default 4 3
      unit m
    }
    field bounds Vector2 "The container around the entity (0 0: none; colliders still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.18
      min 0.01
      unit m
      tunable true
    }
    field restDensity f32 "Target poly6 count including self, multiplied by material density (0: pressure off)." {
      default 2
      min 0
      tunable true
    }
    field stiffness f32 "PBF density relaxation fraction per iteration (0: off)." {
      default 1
      min 0
      max 1
      tunable true
    }
    field nearStiffness f32 "Dimensionless PBF artificial pressure s_corr coefficient (0: off)." {
      default 0.001
      min 0
      tunable true
    }
    field viscosity f32 "Stable, mass-conserving XSPH velocity smoothing rate." {
      default 0.15
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone), and are drawn as one surface whose colour follows the mix; 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 8
    }
    field solverIterations u32 "PBF density projection passes per substep (0: pressure off)." {
      default 3
      min 0
      max 64
    }
    field vorticity f32 "Vorticity confinement acceleration coefficient (0: off)." {
      min 0
      tunable true
    }
    field seed u32 "The seed of the spawn jitter."
    field color Color "The surface's colour." {
      default 0.15 0.45 0.95
    }
    field opacity f32 "The surface's opacity." {
      default 0.9
      min 0
      max 1
    }
    field blobScale f32 "The drawn size of each particle's blob (times radius)." {
      default 1.6
      min 0.1
      max 4
    }
    field threshold f32 "The field value where the surface starts (higher: thinner, separate drops)." {
      default 0.45
      min 0.01
      max 4
    }
    field layer i32 "The sprite layer it is drawn on."
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  component Fluid3D {
    doc "Deterministic 3D Position Based Fluids with predicted-position neighbour hashing, symmetric mass-weighted density projection, artificial pressure, stable XSPH viscosity and optional vorticity confinement. Groups interpolate material properties by mix. Contacts exchange impulses with dynamic bodies. The emitter and sink use entity-local axes. Count, seed or size changes rebuild the lattice; lowering maxCount truncates in particle order even with emission off. World state; rendered as a refracting and reflecting surface."
    guide "physics §8"
    split physics world3d
    field count u32 "How many particles to spawn in the box (when the component appears or count or seed changes; 0: none, the emitter fills it). The tick simulates at most 32768; a visual fluid (simulation visual) up to 262144." {
      default 2000
      max 262144
    }
    field size Vector3 "The spawn box, centred on the entity." {
      default 2 1 2
      unit m
    }
    field bounds Vector3 "The container around the entity (0 on an axis: open on that axis; colliders and the terrain still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.2
      min 0.02
      unit m
      tunable true
    }
    field restDensity f32 "Target poly6 count including self, multiplied by material density (0: pressure off)." {
      default 2
      min 0
      tunable true
    }
    field stiffness f32 "PBF density relaxation fraction per iteration (0: off)." {
      default 1
      min 0
      max 1
      tunable true
    }
    field nearStiffness f32 "Dimensionless PBF artificial pressure s_corr coefficient (0: off)." {
      default 0.001
      min 0
      tunable true
    }
    field viscosity f32 "Stable, mass-conserving XSPH velocity smoothing rate." {
      default 0.4
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone); 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick (each costs a full pass over the particles)." {
      default 2
      min 1
      max 8
    }
    field solverIterations u32 "PBF density projection passes per substep (0: pressure off)." {
      default 3
      min 0
      max 64
    }
    field vorticity f32 "Vorticity confinement acceleration coefficient (0: off)." {
      min 0
      tunable true
    }
    field seed u32 "The seed of the spawn and emitter jitter."
    field maxCount u32 "The most particles alive at once (the emitter stops there)." {
      default 8192
      min 0
      max 262144
    }
    field emitRate f32 "Particles the emitter adds per second (0: no emitter)." {
      min 0
      max 20000
      tunable true
    }
    field emitOffset Vector3 "The emitter's offset in entity-local axes." {
      unit m
    }
    field emitVelocity Vector3 "Emitted velocity in entity-local axes, rotated into the world." {
      unit mps
      tunable true
    }
    field emitRadius f32 "The half-size of the cube new particles appear in around the emitter." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field sinkOffset Vector3 "The sink's centre in entity-local axes; the box rotates with it." {
      unit m
    }
    field sinkSize Vector3 "The sink box: particles that enter it are removed (0 0 0: no sink)." {
      unit m
    }
    field color Color "The fluid's colour (what light passing through it keeps)." {
      default 0.2 0.55 0.9
    }
    field opacity f32 "How opaque a metre of it is (0: clear as glass, 1: opaque)." {
      default 0.6
      min 0
      max 1
    }
    field reflectivity f32 "How much it reflects (scales the Fresnel term)." {
      default 1
      min 0
      max 2
    }
    field refraction f32 "How far refraction bends what is seen through it." {
      default 1
      min 0
      max 4
    }
    field drawScale f32 "The drawn size of each particle (times radius)." {
      default 0.6
      min 0.1
      max 2
    }
    field smoothing f32 "How much the surface is smoothed (0: beads, 1: one surface)." {
      default 1
      min 0
      max 2
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (MLS-MPM on the GPU, for looks only): the tick holds none of its particles, so og.physics.fluid3dParticles answers none and buoyancy and groups ignore it. Without RenderCapabilities.visualSimulation it draws the spawn box still." {
      guide "physics §8"
    }
  }

  component Ragdoll {
    doc "An explicit rest-pose rig of shaped bones and limited joints. Selected boneMask indices become dynamic with weight, inheriting animation COM velocities; other bones follow animation. Local rotations blend with FK over blendTime. Optional PD motors track animation and driveTransform follows the root. Owner and adjacent contacts are excluded pairwise; other ragdolls can collide. Bodies and motors are saved state, not entities."
    aliases "physical animation, death fall, limp body, Unreal physics asset, Unity ragdoll wizard"
    field boneMask List.u32.64 "Rig indices of dynamic bones; an empty list enables none."
    field motorStiffness f32 "PD joint restoring stiffness; zero disables position drive." {
      min 0
      tunable true
    }
    field motorDamping f32 "PD joint velocity damping; zero disables it." {
      min 0
      tunable true
    }
    field driveTransform bool "Move the entity with the simulated root bone."
    field layers u32 "Collision membership bits; zero disables contacts."
    field mask u32 "Collision filter bits; zero disables contacts."
    field weight f32 "0 animated, 1 ragdoll. Set it to 1 on a hit; back to 0 to recover." {
      min 0
      max 1
      tunable true
    }
    field blendTime f32 "How long the blend between animation and physics takes, both ways." {
      default 0.25
      min 0
      unit s
      tunable true
    }
    field mass f32 "Mass shared by length among bones without a per-bone mass override." {
      default 60
      min 0.1
      unit kg
      tunable true
    }
    field thickness f32 "A bone capsule's radius as a fraction of its length." {
      default 0.22
      min 0.01
      max 1
      tunable true
    }
    field jointLimit f32 "How far each joint bends from the rest pose." {
      default 0.9
      min 0
      max 3.1
      unit rad
      tunable true
    }
    field damping f32 "How much of their motion the bones lose per second." {
      default 0.6
      min 0
      max 20
      unit perSecond
      tunable true
    }
    field impulse Vector3 "Total activation impulse distributed among newly dynamic bones in proportion to mass."
    field blend f32 "Written: the blend in use (0 animation .. 1 physics)." {
      readonly true
    }
  }
