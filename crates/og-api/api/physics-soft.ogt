  component Rope {
    doc "A Verlet rope: `segments` links from the entity's world position (its og.Transform after its parents'; plus `offset`) to `end` (an entity, plus `endOffset`) or hanging free, swung by gravity and wind, colliding with every solid collider at `radius`. It moves nothing (one-way: a rope joint ties bodies together, og.Joint JOINT_ROPE). Its points are world state (the og.physics state block); og.physics.ropePoints reads them and the renderer draws the rope as a strip of `width` and `color`."
    field segments u32 "The number of links (points minus one)." {
      default 16
      min 1
      max 256
    }
    field length f32 "The rope's length at rest." {
      default 4
      min 0
      unit m
      tunable true
    }
    field offset Vector3 "The start's offset from the entity's position (world axes)." {
      unit m
    }
    field end Entity "The entity the far end is tied to; 0 leaves it free."
    field endOffset Vector3 "The far end's offset from `end`'s position." {
      worldspace none
      unit m
    }
    field iterations u32 "Constraint passes per step: more is stiffer, at more cost." {
      default 12
      min 1
      max 64
      tunable true
    }
    field damping f32 "How much of its velocity each point keeps per tick (1: none lost)." {
      default 0.99
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind)." {
      unit mps2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.05
      min 0
      unit m
      tunable true
    }
    field width f32 "The drawn width." {
      default 0.08
      min 0
      unit m
    }
    field color Vector3 "The drawn linear colour." {
      default 0.55 0.42 0.28
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  const SIMULATION_GAMEPLAY u32 0 "`Cloth.simulation`, `SoftBody.simulation`, `Garment.simulation`: simulated in the physics step on the CPU, deterministic: its points are world state that snapshots, replays, lockstep and the hash carry, and that og.physics.clothPoints, softBodyPoints and garmentPoints read. The default."
  const SIMULATION_VISUAL u32 1 "`Cloth.simulation`, `SoftBody.simulation`, `Garment.simulation`: simulated by the renderer on the GPU (XPBD in small steps), for looks only, never read back. The tick leaves it unsolved: its points (og.physics.clothPoints, softBodyPoints, garmentPoints) are its rest shape carried rigidly by the entity (a garment's: the skinned pose), SoftBody.volume stays 1 and SoftBody.center is that shape's mean, so gameplay reads a stable proxy and a headless server pays nothing. The drawn motion runs on tick time: frames that skip ticks step those too, up to eight, and a world restored, rolled back or more than eight ticks ahead starts again from the rest shape. It meets the colliders drawn this frame (og.Collider boxes, spheres, capsules and height fields; convex, cylinder and triangle-mesh shapes are passed through) and, with thickness, itself. A visual cloth's or garment's wind is air moving along `wind` at its magnitude in metres a second, meeting each triangle with drag and lift against the triangle's own motion and scaled so a still face square to it feels `wind`; `gust` sends bands of stronger, veering air down it, so it ripples and flaps rather than leaning. Where RenderCapabilities.visualSimulation is false (no compute or no vertex storage) it draws that rest shape."
  const PIN_TOP u32 1 "`Cloth.pins` bit: the whole top row is pinned."
  const PIN_TOP_CORNERS u32 2 "`Cloth.pins` bit: the top-left and top-right corners are pinned."
  const PIN_LEFT u32 4 "`Cloth.pins` bit: the whole left column is pinned (a flag on a pole)."
  const PIN_TOP_RINGS u32 8 "`Cloth.pins` bit: every fourth point of the top row (curtain rings)."

  component Cloth {
    doc "A Verlet cloth: a `columns` × `rows` grid of points, `spacing` apart, hanging from the entity's world position (its og.Transform after its parents': its top-left corner, the grid laid out along the entity's local x and down -y), pinned by `pins` (pinned points follow the entity), with stretch and shear constraints, gravity, wind, collision against every solid collider and, with `thickness`, against itself. One-way like og.Rope; its points are world state. Drawn as a double-sided mesh with `material` (og.render.standardMaterial; 0: a plain cloth colour)."
    aliases "flag, banner, curtain, sail, Unity Cloth, Unreal Chaos Cloth"
    field columns u32 "Points across." {
      default 12
      min 2
      max 64
    }
    field rows u32 "Points down." {
      default 12
      min 2
      max 64
    }
    field spacing f32 "The rest distance between neighbouring points." {
      default 0.15
      min 0.001
      unit m
      tunable true
    }
    field pins u32 "Which points are pinned, a sum of PIN_* bits (1 top row, 2 top corners, 4 left column, 8 top rings)." {
      default 1
    }
    field iterations u32 "Constraint passes per step." {
      default 8
      min 1
      max 64
      tunable true
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.985
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind); the cloth flutters with it." {
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the cloth and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field thickness f32 "Self-collision: how far apart its points keep from the points of the cloth that are not their near neighbours (0: none). About `spacing` keeps a cloth that folds or piles up from passing through itself." {
      min 0
      unit m
      tunable true
    }
    field substeps u32 "Simulation steps per tick, each integrating and then solving `iterations` passes; with self-collision enough that a point moves less than `thickness` per step (a point moves at most half the thickness a step)." {
      default 1
      min 1
      max 16
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step (0: it slides freely; near 1 it sticks where it lands, so a cloth lowered onto the floor folds instead of spreading)." {
      min 0
      max 1
      tunable true
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain cloth."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
  }

  component Garment {
    doc "Cloth on a skinned character: glTF mesh `mesh` of the entity's og.Model (a skirt, a cape, a coat's tails), posed by the entity's og.Skeleton and simulated from there. Each tick the animation poses the mesh; then every point of it swings under gravity and wind and drags behind the motion, but stays within `maxDistance` of where the skinned pose puts it, never goes further than `backstop` behind it into the body, and keeps its edges' lengths. Points within `pinTop` of the garment's top, and points whose vertex colour's red or alpha is 0, stay on the skinned pose; red times alpha between 0 and 1 scales `maxDistance` (paint it in the modelling tool: white everywhere frees the whole garment; paint the alpha over a white colour to keep a textured garment's colours, which the red would tint, since an opaque material does not show the alpha). With `radius` it collides with every solid collider too. One-way like og.Cloth (it moves nothing), simulated in the physics step with the rest of the world, so it replays and snapshots carry it. The model draws the garment where the simulation leaves it, with motion vectors for TAA. 3D only. Its blendshapes are not applied."
    field mesh u32 "The glTF mesh of the entity's model that is the garment (its primitives together), as og.Blendshapes.mesh."
    field maxDistance f32 "How far a point may stray from where the skinned pose puts it." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field pinTop f32 "Points within this height of the garment's top at rest (the bind pose, the model's +y) stay on the skinned pose: a skirt's waistband, a cape's collar." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field backstop f32 "How far a point may go behind where the skinned pose puts it, against the skinned normal (0: never behind it, so it cannot sink into the body)." {
      min 0
      unit m
      tunable true
    }
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower stretches." {
      default 1
      min 0
      max 1
      tunable true
    }
    field bending f32 "How much it resists folding, 0 to 1 a pass (across each pair of triangles that share an edge): 0 drapes like silk, near 1 like leather." {
      default 0.1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 6
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 1
      min 1
      max 16
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.97
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration (wind); the garment flutters with it." {
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the garment and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides with solid colliders at (0: no collision; the skinned pose, through `maxDistance` and `backstop`, holds it on the body). A character's own collider counts: keep it inside the body, or leave this 0." {
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      min 0
      max 1
      tunable true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
  }

  const SOFT_SPHERE u32 0 "`SoftBody.shape`: a sphere of `radius` (an icosphere; 2D a ring)."
  const SOFT_BOX u32 1 "`SoftBody.shape`: a box of `size` (each face a grid of `detail` + 1 cells; 2D a rectangle)."
  const SOFT_MESH u32 2 "`SoftBody.shape`: the closed surface of geometry `mesh` (3D only)."

  component SoftBody {
    doc "A PBD soft volume: a closed surface of points (2D: a ring in the xy plane) held by distance constraints along its edges and by one constraint on the volume it encloses (2D: its area), dropped under gravity and pushed out of every solid collider, so it lands, squashes and springs back: jelly, a water balloon, a slime. Built at the entity's world pose (its og.Transform after its parents') when it appears or its shape changes. It moves nothing (one-way like og.Cloth). Its points are world state (the og.physics state block); og.physics.softBodyPoints reads them and the renderer draws its surface with `material`."
    field shape u32 "SOFT_SPHERE 0, SOFT_BOX 1 or SOFT_MESH 2." {
      min 0
      max 2
    }
    field radius f32 "A sphere's radius." {
      default 0.5
      min 0.01
      unit m
      tunable true
    }
    field size Vector3 "A box's full extents." {
      default 1 1 1
      min 0
      unit m
    }
    field detail u32 "How finely its surface is divided: a sphere 0 to 3 (12, 42, 162 or 642 points; 2D 12 to 96), a box 0 to 7 (cells along a face's edge, minus one). A finer surface needs more iterations to hold its shape: at 642 points and stiffness below 1 the default 8 lets it spread." {
      default 2
      min 0
      max 7
    }
    field mesh Geometry "SOFT_MESH's geometry: a loaded glTF's (registered automatically) or one given to og.physics.setMesh; closed, its vertices welded where they meet."
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower lets the surface stretch and wobble." {
      default 1
      min 0
      max 1
      tunable true
    }
    field pressure f32 "The volume it keeps, as a share of its rest volume: 1 holds it, above inflates it, 0 holds none (it slumps like cloth)." {
      default 1
      min 0
      max 4
      tunable true
    }
    field volumeStiffness f32 "How much of its volume a pass restores, 0 to 1." {
      default 1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 8
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 16
    }
    field damping f32 "How much of its velocity each point keeps per tick." {
      default 0.995
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field thickness f32 "The distance its points keep from solids (0: no collision)." {
      default 0.03
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      default 0.3
      min 0
      max 1
      tunable true
    }
    field pinTop f32 "Points within this height of its top at rest are pinned to the entity and follow it (0: none): a water balloon on a string." {
      min 0
      unit m
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain one."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (in the tick, world state) or SIMULATION_VISUAL 1 (on the GPU, for looks only; see SIMULATION_VISUAL)." {
      min 0
      max 1
    }
    field volume f32 "Written: its volume (2D: area) now over its rest volume; below 1 squashed, above inflated." {
      default 1
      readonly true
    }
    field center Vector3 "Written: the mean of its points, in world space." {
      worldspace world
      unit m
      readonly true
    }
  }

  component Fluid2D {
    doc "A 2D particle fluid (any profile, in the xy plane): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005: pressure, near pressure, viscosity) on a fixed grid in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider (pushed out of bodies; they push nothing back) and stay inside `bounds` around the entity when it is set. Fluids of one `group` interact: by `density` they layer, by `mixing` they blend. Drawn as metaballs: the particles blurred into a field the renderer thresholds into one surface of `color`, on sprite layer `layer`."
    field count u32 "How many particles (spawned when the component appears or count changes)." {
      default 1000
      min 1
      max 8192
    }
    field size Vector2 "The spawn box, centred on the entity." {
      default 4 3
      unit m
    }
    field bounds Vector2 "The container around the entity (0 0: none; colliders still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.18
      min 0.01
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 1
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.15 it gets springy, then unstable)." {
      default 0.1
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.5
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (honey above 1)." {
      default 0.15
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone), and are drawn as one surface whose colour follows the mix; 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn jitter."
    field color Vector3 "The surface's linear colour." {
      default 0.15 0.45 0.95
    }
    field opacity f32 "The surface's opacity." {
      default 0.9
      min 0
      max 1
    }
    field blobScale f32 "The drawn size of each particle's blob (times radius)." {
      default 1.6
      min 0.1
      max 4
    }
    field threshold f32 "The field value where the surface starts (higher: thinner, separate drops)." {
      default 0.45
      min 0.01
      max 4
    }
    field layer i32 "The sprite layer it is drawn on."
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  component Fluid3D {
    doc "A 3D particle fluid (the 3D profile): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005: pressure, near pressure that gives surface tension, viscosity) over a spatial hash in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider, the terrain's height field included (pushed out; they push nothing back), and stay inside `bounds` around the entity when it is set. An emitter adds particles at `emitRate` up to `maxCount`; a sink box removes those that enter it. Fluids of one `group` interact: by `density` they layer, by `mixing` they blend. Drawn as a screen-space surface: the particles' depth smoothed into one surface, refracting what is behind by its thickness and reflecting the sky, lit by the scene's lights. Cost: about 0.9 ms of CPU a tick for 2000 particles at 1 substep, 1.8 ms at 2 (native and wasm alike), growing with the particles; keep a scene's fluids to a few thousand particles. The surface costs about 1.1 ms of GPU (an Apple M4 Pro, the fluid covering a third of a 1280×720 frame) whatever the particle count, growing with the pixels it covers."
    field count u32 "How many particles to spawn in the box (when the component appears or count or seed changes; 0: none, the emitter fills it). The tick simulates at most 32768; a visual fluid (SIMULATION_VISUAL) up to 262144." {
      default 2000
      max 262144
    }
    field size Vector3 "The spawn box, centred on the entity." {
      default 2 1 2
      unit m
    }
    field bounds Vector3 "The container around the entity (0 on an axis: open on that axis; colliders and the terrain still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other. Cost grows with the particles, not the radius." {
      default 0.2
      min 0.02
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 10
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.05 it jitters, then springs apart)." {
      default 0.02
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.4
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (it also calms the surface; honey above 1)." {
      default 0.4
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone); 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick (each costs a full pass over the particles)." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn and emitter jitter."
    field maxCount u32 "The most particles alive at once (the emitter stops there)." {
      default 8192
      min 1
      max 262144
    }
    field emitRate f32 "Particles the emitter adds per second (0: no emitter)." {
      min 0
      max 20000
      tunable true
    }
    field emitOffset Vector3 "Where the emitter is, from the entity (world axes)." {
      unit m
    }
    field emitVelocity Vector3 "The velocity emitted particles start with." {
      unit mps
      tunable true
    }
    field emitRadius f32 "The half-size of the cube new particles appear in around the emitter." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field sinkOffset Vector3 "The sink's centre, from the entity (world axes)." {
      unit m
    }
    field sinkSize Vector3 "The sink box: particles that enter it are removed (0 0 0: no sink)." {
      unit m
    }
    field color Vector3 "The fluid's linear colour (what light passing through it keeps)." {
      default 0.2 0.55 0.9
    }
    field opacity f32 "How opaque a metre of it is (0: clear as glass, 1: opaque)." {
      default 0.6
      min 0
      max 1
    }
    field reflectivity f32 "How much it reflects (scales the Fresnel term)." {
      default 1
      min 0
      max 2
    }
    field refraction f32 "How far refraction bends what is seen through it." {
      default 1
      min 0
      max 4
    }
    field drawScale f32 "The drawn size of each particle (times radius)." {
      default 0.6
      min 0.1
      max 2
    }
    field smoothing f32 "How much the surface is smoothed (0: beads, 1: one surface)." {
      default 1
      min 0
      max 2
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation u32 "SIMULATION_GAMEPLAY 0 (the tick's double density relaxation, world state) or SIMULATION_VISUAL 1: the renderer simulates it on the GPU with MLS-MPM (Hu et al. 2018) for looks only, never read back. A visual fluid has no particles in the tick (og.physics.fluid3dParticles answers none, buoyancy and groups ignore it, the snapshot carries nothing of it): the renderer spawns `count` in the box and simulates them in its container (`bounds`; three times `size` on an open axis), on a grid of cells about `radius` across (kept between two and eight spawned particles a cell, and larger for a container past two million cells), against the colliders drawn this frame, with the emitter and the sink (a particle that enters the sink comes back at the emitter, or goes without one). `stiffness` and `viscosity` scale the solver's own (at their defaults it is water); `restDensity`, `nearStiffness`, `group`, `density` and `mixing` do not apply, and `substeps` is a least (it takes more where gravity needs them). It runs on tick time: frames that skip ticks step those too, up to eight; a world restored, rolled back or further ahead, or a changed count, seed, size, bounds, radius or maxCount, starts it again from the spawn box. Cost, measured on an Apple M4 Pro: a dam break of 60 000 growing to 110 000 particles in 5 cm cells, three steps a tick, took 4.9 ms of GPU a frame with its surface; it grows with the particles and the steps. Where RenderCapabilities.visualSimulation is false it draws the spawned box, still." {
      min 0
      max 1
    }
  }

  component WaterSurface {
    doc "Height-field water (3D): a `resolution` × `resolution` grid of heights over a `size` square centred on the entity (its y is the rest level), waves travelling at `waveSpeed` and fading by `damping`. Dynamic bodies crossing it push waves (splashes; og.Splash events) and float by `buoyancy`. The heights are world state; an og.Water on the same entity draws them."
    field resolution u32 "Grid points along each side." {
      default 64
      min 8
      max 256
    }
    field size f32 "The side of the square of water." {
      default 16
      min 0.1
      unit m
      tunable true
    }
    field waveSpeed f32 "How fast waves travel." {
      default 3
      min 0
      unit mps
      tunable true
    }
    field damping f32 "How much of a wave survives a second (1: no loss)." {
      default 0.4
      min 0
      max 1
      tunable true
    }
    field splash f32 "How strongly bodies push waves." {
      default 1
      min 0
      tunable true
    }
    field buoyancy f32 "The upward force on a submerged body per cubic metre of its box under water (0: bodies sink)." {
      default 9.81
      min 0
      tunable true
    }
    field drag f32 "How much a submerged body's velocity is slowed." {
      default 1.5
      min 0
      unit perSecond
      tunable true
    }
  }

  component WaterLine {
    doc "2D water for side-scrollers: a `width` × `depth` pool whose top edge (at the entity's y, centred on its x) is `columns` springs, each pulled to its rest height by `tension`, damped by `damping` and passing waves to its neighbours by `spread`. Bodies (and characters) crossing the surface splash it (og.Splash events) and float by `buoyancy`. The springs are world state; an og.Water2D on the same entity draws it."
    field width f32 "The pool's width." {
      default 12
      min 0.1
      unit m
      tunable true
    }
    field depth f32 "The pool's depth below the surface." {
      default 3
      min 0
      unit m
      tunable true
    }
    field columns u32 "Springs along the surface." {
      default 96
      min 4
      max 512
    }
    field tension f32 "How hard each spring pulls back to rest." {
      default 60
      min 0
      tunable true
    }
    field damping f32 "How fast a spring's motion dies." {
      default 2.5
      min 0
      tunable true
    }
    field spread f32 "How much of a spring's height its neighbours feel each pass (waves travel)." {
      default 0.25
      min 0
      max 0.5
      tunable true
    }
    field splash f32 "How strongly crossing bodies splash." {
      default 0.04
      min 0
      tunable true
    }
    field buoyancy f32 "The upward force on a submerged body per square metre of its box under water (0: bodies sink)." {
      default 12
      min 0
      tunable true
    }
    field drag f32 "How much a submerged body's velocity is slowed." {
      default 2
      min 0
      unit perSecond
      tunable true
    }
  }

  component Buoyancy {
    doc "Floats a dynamic rigid body (3D profile) on the water under it: an og.WaterSurface (at its rest level), an og.Water (a flat lake, or a sea with a wind: its waves as drawn, og.physics.waterHeight's) or both on one entity. Its hull is its colliders' box cut into `samples` cells a side, kept where a cell's centre lies in a solid collider; each cell under the surface pushes up by the water it displaces (Archimedes: `waterDensity` × its share of the colliders' volume × gravity plus the water's own acceleration, so it sinks with a crest that falls away rather than being flung clear) at that cell, so a hull rights itself, pitches and rolls with the waves, and is slowed by `drag` and `angularDrag` against the moving water as far as it is under. Computed in the tick, the same on every run and after a restore; the sea's waves are the absolute world's, so a body moved by og.WorldOrigin rides the same water. A body with it takes no og.WaterSurface `buoyancy` (only its splash). Insert it beside og.RigidBody and og.Collider: `{}` floats a body of the default density half under."
    field waterDensity f32 "The water's density, in og.Collider.density's units: the default 2 floats a body of the colliders' default density 1 half under, as wood floats; at 1 the same body hangs just under the surface, under it sinks." {
      default 2
      min 0
      unit kgPerM3
      tunable true
    }
    field samples u32 "Cells along each side of its colliders' box (1: one point at its centre; up to 12³ points): more follow its shape and the waves more closely, at more cost." {
      default 4
      min 1
      max 12
    }
    field drag f32 "How much of its speed through the water it loses each second when fully under (in part when in part); off-centre cells slow its turning too, so it settles instead of bobbing." {
      default 4
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field angularDrag f32 "How much of its spin it loses each second when fully under (in part when in part)." {
      default 3
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field submerged f32 "Written: the fraction of its hull under water after the last step (0 above it or out of water, 1 sunk): for wakes, splashes and a sinking ship." {
      min 0
      max 1
      readonly true
    }
  }

  event Splash {
    doc "Something crossed a water surface (og.WaterSurface or og.WaterLine): for splash particles and sounds. Read the next tick."
    field water Entity "The water's entity."
    field entity Entity "What crossed it."
    field point Vector3 "Where it crossed the surface." {
      worldspace world
      unit m
    }
    field speed f32 "Its vertical speed (negative going in)." {
      unit mps
    }
  }

  component Ragdoll {
    doc "A ragdoll over an og.Skeleton: a capsule body per bone with a parent, joints with limits between them (ball joints with cone limits in 3D; in 2D hinges about z, the bones rapier2d bodies in the xy plane at their animated z, for a skeleton laid out in that plane), built from the skeleton's rest pose. `weight` is where the pose comes from: 0 the animation (the bodies follow it kinematically), 1 the physics (the bodies are dynamic, starting with the animation's velocity); the pose drawn blends between them over `blendTime`, both ways. The bodies are world state (the og.physics state block), not entities."
    aliases "physical animation, death fall, limp body, Unreal physics asset, Unity ragdoll wizard"
    field weight f32 "0 animated, 1 ragdoll. Set it to 1 on a hit; back to 0 to recover." {
      min 0
      max 1
      tunable true
    }
    field blendTime f32 "How long the blend between animation and physics takes, both ways." {
      default 0.25
      min 0
      unit s
      tunable true
    }
    field mass f32 "The whole body's mass, shared by the bones by length." {
      default 60
      min 0.1
      unit kg
      tunable true
    }
    field thickness f32 "A bone capsule's radius as a fraction of its length." {
      default 0.22
      min 0.01
      max 1
      tunable true
    }
    field jointLimit f32 "How far each joint bends from the rest pose." {
      default 0.9
      min 0
      max 3.1
      unit rad
      tunable true
    }
    field damping f32 "How much of their motion the bones lose per second." {
      default 0.6
      min 0
      max 20
      unit perSecond
      tunable true
    }
    field impulse Vector3 "An impulse given to every bone when weight first goes up (a hit)."
    field blend f32 "Written: the blend in use (0 animation .. 1 physics)." {
      readonly true
    }
  }

