  component Rope {
    aliases "chain, cable, swinging lantern, hanging rope, Verlet rope"
    doc "A Verlet rope: `segments` links from the entity's world position (its og.Transform after its parents'; plus `offset`) to `end` (an entity, plus `endOffset`) or hanging free, swung by gravity and wind, colliding with every solid collider at `radius`. It moves nothing (one-way: a rope joint ties bodies together, og.Joint JOINT_ROPE). Its points are world state (the og.physics state block); og.physics.ropePoints reads them and the renderer draws the rope as a strip of `width` and `color`."
    field segments u32 "The number of links (points minus one)." {
      default 16
      min 1
      max 256
    }
    field length f32 "The rope's length at rest." {
      default 4
      min 0
      unit m
      tunable true
    }
    field offset Vector3 "The start's offset from the entity's position (world axes)." {
      unit m
    }
    field end Entity "The entity the far end is tied to; 0 leaves it free."
    field endOffset Vector3 "The far end's offset from `end`'s position." {
      worldspace none
      unit m
    }
    field iterations u32 "Constraint passes per step: more is stiffer, at more cost." {
      default 12
      min 1
      max 64
      tunable true
    }
    field damping f32 "How fast its points' velocity decays (0: none lost): each tick a point keeps 1 / (1 + damping * dt) of it, as RigidBody.linearDamping." {
      default 0.6
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration of its own, added to og.Wind's push (its velocity as an acceleration, per second)." {
      unit mps2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.05
      min 0
      unit m
      tunable true
    }
    field width f32 "The drawn width." {
      default 0.08
      min 0
      unit m
    }
    field color Vector3 "The drawn linear colour." {
      default 0.55 0.42 0.28
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  enum Simulation {
    doc "Where a cloth, a garment, a soft body or a 3D fluid is simulated: Cloth.simulation, Garment.simulation, SoftBody.simulation and Fluid3D.simulation."
    guide "physics §8"
    variant gameplay "In the physics step on the CPU, deterministic: its points are world state that snapshots, replays, lockstep and the hash carry, and that og.physics.clothPoints, softBodyPoints and garmentPoints read. The default."
    variant visual "By the renderer on the GPU for looks only, never read back. The tick's points are the rest shape carried rigidly by the entity (a garment's: the skinned pose). Without RenderCapabilities.visualSimulation it draws that shape."
  }

  column Simulation {
    doc "A Simulation field: the variant's index."
    array Uint32Array
    stride 1
    value Simulation
  }

  const PIN_TOP u32 1 "`Cloth.pins` bit: the whole top row is pinned."
  const PIN_TOP_CORNERS u32 2 "`Cloth.pins` bit: the top-left and top-right corners are pinned."
  const PIN_LEFT u32 4 "`Cloth.pins` bit: the whole left column is pinned (a flag on a pole)."
  const PIN_TOP_RINGS u32 8 "`Cloth.pins` bit: every fourth point of the top row (curtain rings)."

  component Cloth {
    doc "A Verlet cloth: a `columns` × `rows` grid of points, `spacing` apart, hanging from the entity's world position (its og.Transform after its parents': its top-left corner, the grid laid out along the entity's local x and down -y), pinned by `pins` (pinned points follow the entity), with stretch and shear constraints, gravity, wind, collision against every solid collider and, with `thickness`, against itself. One-way like og.Rope; its points are world state. Drawn as a double-sided mesh with `material` (og.render.standardMaterial; 0: a plain cloth colour)."
    aliases "flag, banner, curtain, sail, Unity Cloth, Unreal Chaos Cloth"
    field columns u32 "Points across." {
      default 12
      min 2
      max 64
    }
    field rows u32 "Points down." {
      default 12
      min 2
      max 64
    }
    field spacing f32 "The rest distance between neighbouring points." {
      default 0.15
      min 0.001
      unit m
      tunable true
    }
    field pins u32 "Which points are pinned, a sum of PIN_* bits (1 top row, 2 top corners, 4 left column, 8 top rings)." {
      default 1
    }
    field iterations u32 "Constraint passes per step." {
      default 8
      min 1
      max 64
      tunable true
    }
    field damping f32 "How fast its points' velocity decays (0: none lost): each tick a point keeps 1 / (1 + damping * dt) of it, as RigidBody.linearDamping." {
      default 0.9
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration of its own, added to og.Wind's push (its velocity as an acceleration, per second); the cloth flutters with both. A visual cloth (simulation visual) takes the sum as air moving at its magnitude in m/s." {
      guide "physics §8"
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the cloth and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides at (0: no collision)." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field thickness f32 "Self-collision: how far apart its points keep from the points of the cloth that are not their near neighbours (0: none). About `spacing` keeps a cloth that folds or piles up from passing through itself." {
      min 0
      unit m
      tunable true
    }
    field substeps u32 "Simulation steps per tick, each integrating and then solving `iterations` passes; with self-collision enough that a point moves less than `thickness` per step (a point moves at most half the thickness a step)." {
      default 1
      min 1
      max 16
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step (0: it slides freely; near 1 it sticks where it lands, so a cloth lowered onto the floor folds instead of spreading)." {
      min 0
      max 1
      tunable true
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain cloth."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
  }

  component Garment {
    doc "Cloth on a skinned character: glTF mesh `mesh` of the entity's og.Model (a skirt, a cape, a coat's tails), posed by the entity's og.Skeleton and simulated from there. Each tick its points swing under gravity and wind behind the motion, but stay within `maxDistance` of the skinned pose and `backstop` behind it, keeping their edges' lengths. Points within `pinTop` of its top, or whose vertex colour's red or alpha is 0, stay on the pose; red times alpha scales `maxDistance`. One-way like og.Cloth, simulated in the physics step as world state. 3D only; its blendshapes are not applied."
    guide "physics §8"
    field mesh u32 "The glTF mesh of the entity's model that is the garment (its primitives together), as og.Blendshapes.mesh."
    field maxDistance f32 "How far a point may stray from where the skinned pose puts it." {
      default 0.2
      min 0
      unit m
      tunable true
    }
    field pinTop f32 "Points within this height of the garment's top at rest (the bind pose, the model's +y) stay on the skinned pose: a skirt's waistband, a cape's collar." {
      default 0.04
      min 0
      unit m
      tunable true
    }
    field backstop f32 "How far a point may go behind where the skinned pose puts it, against the skinned normal (0: never behind it, so it cannot sink into the body)." {
      min 0
      unit m
      tunable true
    }
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower stretches." {
      default 1
      min 0
      max 1
      tunable true
    }
    field bending f32 "How much it resists folding, 0 to 1 a pass (across each pair of triangles that share an edge): 0 drapes like silk, near 1 like leather." {
      default 0.1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 6
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 1
      min 1
      max 16
    }
    field damping f32 "How fast its points' velocity decays (0: none lost): each tick a point keeps 1 / (1 + damping * dt) of it, as RigidBody.linearDamping." {
      default 1.85
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field wind Vector3 "A steady acceleration of its own, added to og.Wind's push (its velocity as an acceleration, per second); the garment flutters with both. A visual garment (simulation visual) takes the sum as air moving at its magnitude in m/s." {
      guide "physics §8"
      unit mps2
      tunable true
    }
    field gust f32 "How much the wind varies over the garment and the tick (0: steady)." {
      default 0.6
      min 0
      max 2
      tunable true
    }
    field radius f32 "The thickness it collides with solid colliders at (0: no collision; the skinned pose, through `maxDistance` and `backstop`, holds it on the body). A character's own collider counts: keep it inside the body, or leave this 0." {
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      min 0
      max 1
      tunable true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
  }


  enum SoftBodyShape {
    doc "What a soft body is built as: SoftBody.shape."
    variant sphere "A sphere of `radius` (an icosphere; 2D a ring)."
    variant box "A box of `size` (each face a grid of `detail` + 1 cells; 2D a rectangle)."
    variant mesh "The closed surface of geometry `mesh` (3D only)."
  }

  column SoftBodyShape {
    doc "A SoftBodyShape field: the variant's index."
    array Uint32Array
    stride 1
    value SoftBodyShape
  }

  component SoftBody {
    doc "A PBD soft volume: a closed surface of points (2D: a ring in the xy plane) held by distance constraints along its edges and by one constraint on the volume it encloses (2D: its area), dropped under gravity and pushed out of every solid collider, so it lands, squashes and springs back: jelly, a water balloon, a slime. Built at the entity's world pose (its og.Transform after its parents') when it appears or its shape changes. It moves nothing (one-way like og.Cloth). Its points are world state; og.physics.softBodyPoints reads them and the renderer draws its surface with `material`."
    field shape SoftBodyShape "sphere, box or mesh."
    field radius f32 "A sphere's radius." {
      default 0.5
      min 0.01
      unit m
      tunable true
    }
    field size Vector3 "A box's full extents." {
      default 1 1 1
      min 0
      unit m
    }
    field detail u32 "How finely its surface is divided: a sphere 0 to 3 (12, 42, 162 or 642 points; 2D 12 to 96), a box 0 to 7 (cells along a face's edge, minus one)." {
      guide "physics §8"
      default 2
      min 0
      max 7
    }
    field mesh Geometry "The mesh shape's geometry: a loaded glTF's (registered automatically) or one given to og.physics.setMesh; closed, its vertices welded where they meet."
    field stiffness f32 "How stiff its edges are, 0 to 1 a pass: 1 holds their length, lower lets the surface stretch and wobble." {
      default 1
      min 0
      max 1
      tunable true
    }
    field pressure f32 "The volume it keeps, as a share of its rest volume: 1 holds it, above inflates it, 0 holds none (it slumps like cloth)." {
      default 1
      min 0
      max 4
      tunable true
    }
    field volumeStiffness f32 "How much of its volume a pass restores, 0 to 1." {
      default 1
      min 0
      max 1
      tunable true
    }
    field iterations u32 "Constraint passes per substep." {
      default 8
      min 1
      max 64
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 16
    }
    field damping f32 "How fast its points' velocity decays (0: none lost): each tick a point keeps 1 / (1 + damping * dt) of it, as RigidBody.linearDamping." {
      default 0.3
      min 0
      max 100
      unit perSecond
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field thickness f32 "The distance its points keep from solids (0: no collision)." {
      default 0.03
      min 0
      unit m
      tunable true
    }
    field friction f32 "How much of its sliding a point touching a solid loses each step." {
      default 0.3
      min 0
      max 1
      tunable true
    }
    field pinTop f32 "Points within this height of its top at rest are pinned to the entity and follow it (0: none): a water balloon on a string." {
      min 0
      unit m
    }
    field material Material "The material it is drawn with (og.render.standardMaterial); 0 is a plain one."
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (on the GPU, for looks only)." {
      guide "physics §8"
    }
    field volume f32 "Written: its volume (2D: area) now over its rest volume; below 1 squashed, above inflated; 1 when simulation is visual." {
      default 1
      readonly true
    }
    field center Vector3 "Written: the mean of its points, in world space." {
      worldspace world
      unit m
      readonly true
    }
  }

  component Fluid2D {
    doc "A 2D particle fluid (any profile, in the xy plane): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005) over a spatial hash in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider (pushed out of bodies; they push nothing back) and stay inside `bounds` around the entity when it is set. Fluids of one `group` interact: by `density` they layer, by `mixing` they blend. Drawn as metaballs: one thresholded surface of `color` on sprite layer `layer`."
    field count u32 "How many particles (spawned when the component appears or count changes)." {
      default 1000
      min 1
      max 8192
    }
    field size Vector2 "The spawn box, centred on the entity." {
      default 4 3
      unit m
    }
    field bounds Vector2 "The container around the entity (0 0: none; colliders still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.18
      min 0.01
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 1
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.15 it gets springy, then unstable)." {
      default 0.1
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.5
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (honey above 1)." {
      default 0.15
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone), and are drawn as one surface whose colour follows the mix; 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn jitter."
    field color Vector3 "The surface's linear colour." {
      default 0.15 0.45 0.95
    }
    field opacity f32 "The surface's opacity." {
      default 0.9
      min 0
      max 1
    }
    field blobScale f32 "The drawn size of each particle's blob (times radius)." {
      default 1.6
      min 0.1
      max 4
    }
    field threshold f32 "The field value where the surface starts (higher: thinner, separate drops)." {
      default 0.45
      min 0.01
      max 4
    }
    field layer i32 "The sprite layer it is drawn on."
    field visible bool "Whether the renderer draws it." {
      default true
    }
  }

  component Fluid3D {
    doc "A 3D particle fluid (the 3D profile): `count` particles spawned in a `size` box centred on the entity, simulated with double density relaxation (Clavet et al. 2005) over a spatial hash in a fixed order, so it is deterministic and part of the og.physics state block. Particles collide with every solid collider and the terrain (they push nothing back) and stay inside `bounds` when set. An emitter adds particles at `emitRate` up to `maxCount`; a sink box removes them. Fluids of one `group` layer by `density` and blend by `mixing`. Drawn as a screen-space surface that refracts and reflects."
    guide "physics §8"
    field count u32 "How many particles to spawn in the box (when the component appears or count or seed changes; 0: none, the emitter fills it). The tick simulates at most 32768; a visual fluid (simulation visual) up to 262144." {
      default 2000
      max 262144
    }
    field size Vector3 "The spawn box, centred on the entity." {
      default 2 1 2
      unit m
    }
    field bounds Vector3 "The container around the entity (0 on an axis: open on that axis; colliders and the terrain still hold it)." {
      worldspace none
      unit m
    }
    field radius f32 "The interaction radius: particles closer than this push and drag each other." {
      default 0.2
      min 0.02
      unit m
      tunable true
    }
    field restDensity f32 "The density it settles at (neighbours within radius, weighted)." {
      default 10
      min 0
      tunable true
    }
    field stiffness f32 "The pressure's strength (above about 0.05 it jitters, then springs apart)." {
      default 0.02
      min 0
      tunable true
    }
    field nearStiffness f32 "The near pressure's strength (keeps particles apart, gives surface tension)." {
      default 0.4
      min 0
      tunable true
    }
    field viscosity f32 "Linear viscosity (it also calms the surface; honey above 1)." {
      default 0.4
      min 0
      max 4
      tunable true
    }
    field group u32 "Fluids sharing a group above 0 push, drag and (by `mixing`) mix with each other as one fluid, at most four to a group (in entity order; a fifth is simulated alone); 0 keeps the fluid to itself."
    field density f32 "How heavy its particles are against the group's other fluids: a heavier fluid sinks under a lighter one." {
      default 1
      min 0.05
      max 20
      tunable true
    }
    field mixing f32 "How readily it mixes with the group's other fluids: 0 keeps them apart in layers (the boundary held), 1 blends them where they touch (their mix, colour and weight even out)." {
      min 0
      max 1
      tunable true
    }
    field gravityScale f32 "Multiplies og.Physics.gravity." {
      default 1
      min -10
      max 10
      tunable true
    }
    field substeps u32 "Simulation steps per tick (each costs a full pass over the particles)." {
      default 2
      min 1
      max 8
    }
    field seed u32 "The seed of the spawn and emitter jitter."
    field maxCount u32 "The most particles alive at once (the emitter stops there)." {
      default 8192
      min 1
      max 262144
    }
    field emitRate f32 "Particles the emitter adds per second (0: no emitter)." {
      min 0
      max 20000
      tunable true
    }
    field emitOffset Vector3 "Where the emitter is, from the entity (world axes)." {
      unit m
    }
    field emitVelocity Vector3 "The velocity emitted particles start with." {
      unit mps
      tunable true
    }
    field emitRadius f32 "The half-size of the cube new particles appear in around the emitter." {
      default 0.1
      min 0
      unit m
      tunable true
    }
    field sinkOffset Vector3 "The sink's centre, from the entity (world axes)." {
      unit m
    }
    field sinkSize Vector3 "The sink box: particles that enter it are removed (0 0 0: no sink)." {
      unit m
    }
    field color Vector3 "The fluid's linear colour (what light passing through it keeps)." {
      default 0.2 0.55 0.9
    }
    field opacity f32 "How opaque a metre of it is (0: clear as glass, 1: opaque)." {
      default 0.6
      min 0
      max 1
    }
    field reflectivity f32 "How much it reflects (scales the Fresnel term)." {
      default 1
      min 0
      max 2
    }
    field refraction f32 "How far refraction bends what is seen through it." {
      default 1
      min 0
      max 4
    }
    field drawScale f32 "The drawn size of each particle (times radius)." {
      default 0.6
      min 0.1
      max 2
    }
    field smoothing f32 "How much the surface is smoothed (0: beads, 1: one surface)." {
      default 1
      min 0
      max 2
    }
    field visible bool "Whether the renderer draws it." {
      default true
    }
    field simulation Simulation "gameplay (in the tick, world state) or visual (MLS-MPM on the GPU, for looks only): the tick holds none of its particles, so og.physics.fluid3dParticles answers none and buoyancy and groups ignore it. Without RenderCapabilities.visualSimulation it draws the spawn box still." {
      guide "physics §8"
    }
  }

  component Ragdoll {
    doc "A ragdoll over an og.Skeleton: a capsule body per bone with a parent, joints with limits between them (ball joints with cone limits in 3D; in 2D hinges about z, the bones rapier2d bodies in the xy plane at their animated z, for a skeleton laid out in that plane), built from the skeleton's rest pose. `weight` is where the pose comes from: 0 the animation (the bodies follow it kinematically), 1 the physics (the bodies are dynamic, starting with the animation's velocity); the pose drawn blends between them over `blendTime`, both ways. The bodies are world state, not entities."
    aliases "physical animation, death fall, limp body, Unreal physics asset, Unity ragdoll wizard"
    field weight f32 "0 animated, 1 ragdoll. Set it to 1 on a hit; back to 0 to recover." {
      min 0
      max 1
      tunable true
    }
    field blendTime f32 "How long the blend between animation and physics takes, both ways." {
      default 0.25
      min 0
      unit s
      tunable true
    }
    field mass f32 "The whole body's mass, shared by the bones by length." {
      default 60
      min 0.1
      unit kg
      tunable true
    }
    field thickness f32 "A bone capsule's radius as a fraction of its length." {
      default 0.22
      min 0.01
      max 1
      tunable true
    }
    field jointLimit f32 "How far each joint bends from the rest pose." {
      default 0.9
      min 0
      max 3.1
      unit rad
      tunable true
    }
    field damping f32 "How much of their motion the bones lose per second." {
      default 0.6
      min 0
      max 20
      unit perSecond
      tunable true
    }
    field impulse Vector3 "An impulse given to every bone when weight first goes up (a hit)."
    field blend f32 "Written: the blend in use (0 animation .. 1 physics)." {
      readonly true
    }
  }

