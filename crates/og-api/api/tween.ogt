module tween {
  doc "Tweens: animate any numeric field of a component (og.Transform.position, og.Sprite.color, og.Sprite.opacity, a game's own f32) from its value to a target over time with an easing curve, a delay, repeat and yoyo; chain them in sequences or run them in parallel. Advanced by the engine's og.tween system after the game's systems and before og.anim and physics, by scaled time (slow motion, hit stop) unless unscaled."
  doc "Running tweens are world state (the og.tween state block): snapshots, restore and the world hash cover them. og.TweenCompleted reports a tween or group that ends on its own; a cancelled one, or one whose entity or component went away, ends silently."
  doc "Feel presets are tweens too: og.tween.squash (squash and stretch that recovers) and og.tween.flash (a hit flash that fades)."

  handle Tween "A running tween or group."

  column Tween {
    doc "A Tween handle field."
    array Uint32Array
    stride 2
    value Tween
  }

  enum Ease {
    doc "An easing curve from the start (0) to the end (1). In starts slow, out ends slow, inOut both. back overshoots, elastic rings, bounce bounces at the end."
    variant power1.out "Gentle ease out: the default for most motion."
    variant none "Constant speed: scrolling, timers, colour cycles."
    variant power1.in "Gentle ease in."
    variant power1.inOut "Gentle in and out."
    variant power2.in "Ease in."
    variant power2.out "Ease out: UI sliding in, things settling."
    variant power2.inOut "In and out: camera moves, deliberate motion."
    variant power3.in "Strong ease in."
    variant power3.out "Strong ease out."
    variant power3.inOut "Strong in and out."
    variant expo.in "Exponential ease in: things falling away, warp-outs."
    variant expo.out "Exponential ease out: snappy arrivals."
    variant expo.inOut "Exponential in and out."
    variant back.in "Pulls back first, then goes: anticipation."
    variant back.out "Overshoots, then settles: pops, squash recovery, buttons."
    variant back.inOut "Pulls back and overshoots."
    variant elastic.in "Rings before leaving."
    variant elastic.out "Rings after arriving: springy, cartoon impacts."
    variant elastic.inOut "Rings at both ends."
    variant bounce.in "Bounces before leaving."
    variant bounce.out "Bounces at the end: drops, landings."
    variant bounce.inOut "Bounces at both ends."
    pattern "cubic-bezier(${string})" "Four finite controls x1,y1,x2,y2; x1 and x2 must be in [0,1]. Validated by the shared timing parser."
    pattern "steps(${string})" "Positive integer count and optional start/end/jump-start/jump-end/jump-none/jump-both; jump-none requires count > 1. Discrete jumps, not interpolated ramps."
  }

  column Ease {
    doc "An Ease field: the variant's index."
    array Uint32Array
    stride 1
    value Ease
  }

  struct TweenDesc {
    doc "One tween of one field."
    desc true
    field entity Entity "The entity whose component is tweened."
    field component Option.AnyComponent "The component token (og.Transform, og.Sprite, a game's own); null is og.Transform."
    field field String "The field, or one lane of it: `position`, `position.y`, `scale`, `color.r`, `opacity`. f32, f64, i32 and u32 fields (rounded), vectors, colours and quaternions (as a rotation) tween; bool, enum and handle fields do not."
    field to List.f32 "The end value: one number for a scalar or for every lane, or one per lane."
    field from Option.List.f32 "The start value, written from the tick the tween is started and held through its delay; null takes the field's value when the tween starts (after its delay)."
    field relative bool "`to` is added to the start value."
    field duration f32 "Seconds from start to end (one cycle)." {
      default 0.3
      min 0
      unit s
    }
    field delay f32 "Seconds before it starts." {
      min 0
      unit s
    }
    field ease Ease "The curve."
    field repeat i32 "Extra cycles: 0 plays once, n repeats n more times, -1 forever." {
      min -1
    }
    field yoyo bool "Every other cycle plays backwards (pulses, bobbing)."
    field unscaled bool "Advance by real ticks, ignoring Time.scale and hit stop (UI motion)."
    field tag u32 "A number of yours, carried by og.TweenCompleted."
  }

  struct TweenFromDesc {
    doc "Tween from an explicit value to the field captured when og.tween.from is called, before any delay. The start value is written on the first og.tween tick, not synchronously during the call."
    desc true
    field entity Entity "The entity whose component is tweened."
    field component Option.AnyComponent "The component token; null is og.Transform."
    field field String "The numeric field or lane, as in TweenDesc."
    field from List.f32 "The explicit start value: one per lane, or one for all lanes. Held through the delay."
    field duration f32 "Seconds per cycle." {
      default 0.3
      min 0
      unit s
    }
    field delay f32 "Seconds to hold the start value before interpolating." {
      min 0
      unit s
    }
    field ease Ease "The GSAP-named curve."
    field repeat i32 "Extra cycles: 0 once, n more, -1 forever." {
      min -1
    }
    field yoyo bool "Alternate cycles play backwards."
    field unscaled bool "Ignore Time.scale and hit stop."
    field tag u32 "Carried by TweenCompleted."
  }

  struct TweenGroupDesc {
    doc "How a sequence or parallel group runs."
    desc true
    field repeat i32 "Extra runs of the whole group: 0 once, -1 forever; each run replays the spans its tweens resolved in the first." {
      min -1
    }
    field unscaled bool "Advance by real ticks, ignoring Time.scale and hit stop."
    field tag u32 "A number of yours, carried by og.TweenCompleted."
  }

  event TweenCompleted {
    doc "A tween or group ended on its own (read in the tick after)."
    field tween Tween "The handle og.tween.to, sequence, parallel, squash or flash answered."
    field entity Entity "The entity of its (first) tween."
    field tag u32 "Its tag."
  }

  struct SquashDesc {
    doc "Squash and stretch: the entity's og.Transform.scale jumps to rest times impact and eases back to rest."
    desc true
    field entity Entity "The entity."
    field impact Partial.Vector3 "The x, y and z factors at the impact: (1.25, 0.8) squashes (a landing, a hit), (0.8, 1.25) stretches (a jump). z is for 3D models (a squash bulges in x and z: (1.15, 0.85, 1.15)); left out or 0 it stays at rest, so a sprite's { x, y } is unchanged. A component left out takes its default: x 1.25, y 0.8, z 0; under a project's art contract, ArtMotion.squash scales it (0.5 the same, 1 rubber hose: x 1.5, y 0.6)."
    field rest Vector3 "The scale it recovers to." {
      default 1 1 1
    }
    field duration f32 "Seconds to recover." {
      default 0.18
      min 0
      unit s
    }
    field ease Ease "The recovery curve; back.out overshoots a little, elastic.out wobbles." {
      default back.out
    }
  }

  struct FlashDesc {
    doc "A hit flash: the entity's og.Sprite (else og.Mesh, else og.Model) flashColor set and its flash faded from amount to 0."
    desc true
    field entity Entity "The entity."
    field color Color "The flash colour (white for a hit, red for damage taken)." {
      default 1 1 1
    }
    field amount f32 "How far it starts towards the colour." {
      default 1
      min 0
      max 1
    }
    field duration f32 "Seconds to fade." {
      default 0.12
      min 0
      unit s
    }
    field ease Ease "The fade's curve; power1.in holds the flash, then drops it." {
      default power1.in
    }
  }

  fn to {
    doc "Start a tween. Systems may call it; it first moves in this tick's og.tween run."
    aliases "animate a value, DOTween, Godot Tween, LeanTween, GSAP, lerp over time, ease"
    param world World "The world."
    param desc TweenDesc "The field, the values and the timing."
    returns Result.Tween "Refused for a dead entity, a component it lacks, a field that is not numeric, or values of the wrong length."
  }

  fn from {
    doc "Animate from desc.from to the field's value captured at this call, before the delay. The first og.tween tick writes from and holds it through the delay. Unlike GSAP immediateRender, the call itself never writes the field. A system must declare read access to the target component for capture. Snapshot/restore retains the captured endpoint; later writes during the delay cannot change it."
    param world World "The world."
    param desc TweenFromDesc "The start value and timing."
    returns Result.Tween "Refused for an unreadable target or invalid values."
  }

  fn fromTo {
    doc "Animate from explicit desc.from to desc.to; both are required. The first og.tween tick writes from, including during the delay. No endpoint is captured from the live field."
    param world World "The world."
    param desc TweenDesc "The explicit start, end and timing."
    returns Result.Tween "Refused when from is missing or the target or values are invalid."
  }

  fn sequence {
    doc "Start tweens one after another (each with its own delay, duration and repeat); the time one leaves over goes to the next."
    param world World "The world."
    param steps List.TweenDesc "The tweens, in order."
    param desc TweenGroupDesc "Repeat, scaling and the tag." {
      optional true
    }
    returns Result.Tween
  }

  fn parallel {
    doc "Start tweens together; the group ends with the last one."
    param world World "The world."
    param tweens List.TweenDesc "The tweens."
    param desc TweenGroupDesc "Repeat, scaling and the tag." {
      optional true
    }
    returns Result.Tween
  }

  fn cancel {
    doc "Stop a tween where it is (no event)."
    aliases "stop tween, kill tween"
    param world World "The world."
    param tween Tween "The handle."
    returns bool "False when it was not running."
  }

  fn cancelEntity {
    doc "Stop every tween of an entity (no events), say before starting a new reaction."
    param world World "The world."
    param entity Entity "The entity."
    returns u32 "How many stopped."
  }

  fn active {
    doc "Whether a tween is still running."
    param world World "The world."
    param tween Tween "The handle."
    returns bool
  }

  fn squash {
    doc "Squash and stretch the entity's og.Transform.scale (cancels its earlier squash)."
    param world World "The world."
    param desc SquashDesc "The entity and the impact."
    returns Result.Tween "Refused for an entity without og.Transform."
  }

  fn flash {
    doc "Flash the entity's og.Sprite, its og.Mesh, or its og.Model (a glTF instance: this instance only, the others sharing its materials stay as they are). Cancels its earlier flash."
    aliases "hit flash, damage flash, blink, white flash, flicker"
    param world World "The world."
    param desc FlashDesc "The entity and the flash."
    returns Result.Tween "Refused for an entity with none of og.Sprite, og.Mesh and og.Model."
  }
}

# ── tilemap ───────────────────────────────────────────────────────────────
