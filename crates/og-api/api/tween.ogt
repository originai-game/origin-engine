module tween {
  doc "Tweens: animate any numeric field of a component (og.Transform.position, og.Sprite.color, og.Sprite.opacity, a game's own f32) from its value to a target over time with an easing curve, a delay, repeat and yoyo; chain them in sequences or run them in parallel. Advanced by the engine's og.tween system after the game's systems and before og.anim and physics, by scaled time (slow motion, hit stop) unless unscaled."
  doc "Running tweens are world state (the og.tween state block): snapshots, restore and the world hash cover them. og.TweenCompleted reports a tween or group that ends on its own; a cancelled one, or one whose entity or component went away, ends silently."
  doc "Feel presets are tweens too: og.tween.squash (squash and stretch that recovers) and og.tween.flash (a hit flash that fades)."
  doc "Timelines are GSAP's: `const tl = og.tween.timeline(world, { defaults: { duration: 0.4, ease: \"back.out\" }, repeat: 1, yoyo: true })`, then `tl.to(enemies, { field: \"position.y\", to: 2, stagger: { each: 0.05, from: \"center\" } }).to(door, { field: \"position.x\", to: 3 }, \"<0.1\").call(\"door.open\").addLabel(\"out\", \"+=0.5\")`. Targets are entities and one numeric field per call (`field` and `to`, as og.tween.to), not JavaScript objects; vectors take one value per lane. Position is GSAP's: seconds, `\"<\"` (the start of what was added last), `\">\"` (its end), `\"+=1\"` and `\"-=0.5\"` (from the timeline's end), a label, `\"label+=0.2\"`, `\"<50%\"` (half way through what was added last) and `\"-=25%\"` (a quarter of what is inserted); none appends at the end. A label a position names that does not exist is added at the end."
  doc "A timeline renders from its playhead, never accumulated: play, pause, reverse, seek, progress and timeScale move it, and what they change is written in the next og.tween run (this tick, from a system before it). A child is written only when its own time changes, so a finished tween leaves its field to the game. from and fromTo write their start values on the timeline's first render, before their time (GSAP's immediateRender). A timeline stays when it completes (og.TweenCompleted is sent), so it can be reversed, restarted or extended, until kill() or `autoKill`. A refused call (a dead entity, a field that is not numeric, bad position text) adds nothing and its reason is the timeline's `error`; the call still answers the timeline, so chains read as GSAP's."
  doc "Callbacks are names, not closures: `onStart`, `onUpdate`, `onComplete` and `onRepeat` on a tween or the timeline, and `.call(name)`, send og.TweenEvent with that name, read by a system in the tick after. A seek or progress jump sends none. Timelines are world state: snapshots and restore cover the whole timeline, its playhead, labels and captured values, and a `random` stagger shuffles from the world's og.Rng seed (a fork: the main stream does not move; a system needs og.Rng among its reads)."

  handle Tween "A running tween or group."

  column Tween {
    doc "A Tween handle field."
    array Uint32Array
    stride 2
    value Tween
  }

  enum Ease {
    doc "An easing curve from the start (0) to the end (1). In starts slow, out ends slow, inOut both. back overshoots, elastic rings, bounce bounces at the end."
    variant power1.out "Gentle ease out: the default for most motion."
    variant none "Constant speed: scrolling, timers, colour cycles."
    variant power1.in "Gentle ease in."
    variant power1.inOut "Gentle in and out."
    variant power2.in "Ease in."
    variant power2.out "Ease out: UI sliding in, things settling."
    variant power2.inOut "In and out: camera moves, deliberate motion."
    variant power3.in "Strong ease in."
    variant power3.out "Strong ease out."
    variant power3.inOut "Strong in and out."
    variant expo.in "Exponential ease in: things falling away, warp-outs."
    variant expo.out "Exponential ease out: snappy arrivals."
    variant expo.inOut "Exponential in and out."
    variant back.in "Pulls back first, then goes: anticipation."
    variant back.out "Overshoots, then settles: pops, squash recovery, buttons."
    variant back.inOut "Pulls back and overshoots."
    variant elastic.in "Rings before leaving."
    variant elastic.out "Rings after arriving: springy, cartoon impacts."
    variant elastic.inOut "Rings at both ends."
    variant bounce.in "Bounces before leaving."
    variant bounce.out "Bounces at the end: drops, landings."
    variant bounce.inOut "Bounces at both ends."
    pattern "cubic-bezier(${string})" "Four finite controls x1,y1,x2,y2; x1 and x2 must be in [0,1]. Validated by the shared timing parser."
    pattern "steps(${string})" "Positive integer count and optional start/end/jump-start/jump-end/jump-none/jump-both; jump-none requires count > 1. Discrete jumps, not interpolated ramps."
  }

  column Ease {
    doc "A shared timing value: a tag and four payload words (20 bytes), hashed and snapshotted with its record. Accepts every named or parameterized Ease string. Raw views contain the canonical tag/payload, not string indices."
    array Uint32Array
    stride 5
    value Ease
  }

  struct TweenDesc {
    doc "One tween of one field."
    desc true
    field entity Entity "The entity whose component is tweened."
    field component Option.AnyComponent "The component token (og.Transform, og.Sprite, a game's own); null is og.Transform."
    field field String "The field, or one lane of it: `position`, `position.y`, `scale`, `color.r`, `opacity`. f32, f64, i32 and u32 fields (rounded), vectors, colours and quaternions (as a rotation) tween; bool, enum and handle fields do not."
    field to List.f32 "The end value: one number for a scalar or for every lane, or one per lane."
    field from Option.List.f32 "The start value, written from the tick the tween is started and held through its delay; null takes the field's value when the tween starts (after its delay)."
    field relative bool "`to` is added to the start value."
    field duration f32 "Seconds from start to end (one cycle)." {
      default 0.3
      min 0
      unit s
    }
    field delay f32 "Seconds before it starts." {
      min 0
      unit s
    }
    field ease Ease "The curve."
    field repeat i32 "Extra cycles: 0 plays once, n repeats n more times, -1 forever." {
      min -1
    }
    field yoyo bool "Every other cycle plays backwards (pulses, bobbing)."
    field unscaled bool "Advance by real ticks, ignoring Time.scale and hit stop (UI motion)."
    field tag u32 "A number of yours, carried by og.TweenCompleted."
  }

  struct TweenFromDesc {
    doc "Tween from an explicit value to the field captured when og.tween.from is called, before any delay. The start value is written on the first og.tween tick, not synchronously during the call."
    desc true
    field entity Entity "The entity whose component is tweened."
    field component Option.AnyComponent "The component token; null is og.Transform."
    field field String "The numeric field or lane, as in TweenDesc."
    field from List.f32 "The explicit start value: one per lane, or one for all lanes. Held through the delay."
    field duration f32 "Seconds per cycle." {
      default 0.3
      min 0
      unit s
    }
    field delay f32 "Seconds to hold the start value before interpolating." {
      min 0
      unit s
    }
    field ease Ease "The GSAP-named curve."
    field repeat i32 "Extra cycles: 0 once, n more, -1 forever." {
      min -1
    }
    field yoyo bool "Alternate cycles play backwards."
    field unscaled bool "Ignore Time.scale and hit stop."
    field tag u32 "Carried by TweenCompleted."
  }

  struct TweenGroupDesc {
    doc "How a sequence or parallel group runs."
    desc true
    field repeat i32 "Extra runs of the whole group: 0 once, -1 forever; each run replays the spans its tweens resolved in the first." {
      min -1
    }
    field unscaled bool "Advance by real ticks, ignoring Time.scale and hit stop."
    field tag u32 "A number of yours, carried by og.TweenCompleted."
  }

  event TweenCompleted {
    doc "A tween or group ended on its own (read in the tick after)."
    field tween Tween "The handle og.tween.to, sequence, parallel, squash or flash answered."
    field entity Entity "The entity of its (first) tween."
    field tag u32 "Its tag."
  }

  event TweenEvent {
    doc "A timeline callback: a call crossed, or a tween or timeline started, updated, completed or repeated (read in the tick after)."
    aliases "GSAP onComplete, onStart, onUpdate, onRepeat, timeline call, tween callback"
    field tween Tween "The timeline (TweenTimeline.tween)."
    field entity Entity "The tween's target; 0 for the timeline's own callbacks and calls."
    field name String "The name the callback was given (at most 63 bytes)."
    field progress f32 "How far through its cycle it is, 0 to 1."
    field tag u32 "The timeline's tag."
  }

  struct TweenDefaults {
    doc "What a timeline's tweens take when they leave it out (GSAP's `defaults`)."
    desc true
    field component Option.AnyComponent "The component; null is og.Transform."
    field duration f32 "Seconds per cycle." {
      default 0.3
      min 0
      unit s
    }
    field ease Ease "The curve."
  }

  struct TimelineDesc {
    doc "How a timeline plays (og.tween.timeline)."
    desc true
    field defaults TweenDefaults "What its tweens take when they leave it out."
    field repeat i32 "Extra cycles of the whole timeline: 0 once, -1 forever." {
      min -1
    }
    field yoyo bool "Every other cycle plays backwards."
    field repeatDelay f32 "Seconds held between cycles." {
      min 0
      unit s
    }
    field paused bool "Created paused: play() starts it. Its from() values are still written."
    field timeScale f32 "Playback rate: 2 twice as fast, 0.5 half." {
      default 1
      min 0
    }
    field autoKill bool "Removed when it completes, instead of staying to be reversed or restarted."
    field unscaled bool "Advance by real ticks, ignoring Time.scale and hit stop (UI motion)."
    field tag u32 "A number of yours, carried by og.TweenCompleted and og.TweenEvent."
    field onStart Option.String "The og.TweenEvent sent when the playhead leaves the start."
    field onUpdate Option.String "The og.TweenEvent sent every run the playhead moves."
    field onComplete Option.String "The og.TweenEvent sent when it reaches its end going forward."
    field onRepeat Option.String "The og.TweenEvent sent when a cycle begins again."
  }

  struct StaggerDesc {
    doc "GSAP's stagger object: each target's start offset by its distance from `from`."
    desc true
    field each Option.f32 "Seconds between neighbours." {
      unit s
    }
    field amount Option.f32 "Seconds over all of them (wins over each)." {
      unit s
    }
    field from Option.OneOf.String.u32 "`start` (null), `center`, `end`, `edges` (both ends first), `random` (a seeded shuffle), or a target's index."
    field grid Option.List.u32 "`[rows, columns]`: distances measured on that grid."
    field ease Ease "Distributes the offsets through a curve." {
      default none
    }
  }

  struct TweenKeyframe {
    doc "One step of a tween's keyframes: from where the step before ended to `to`."
    desc true
    field to List.f32 "The value at the step's end."
    field duration Option.f32 "Seconds; null takes the tween's." {
      unit s
    }
    field ease Option.Ease "The curve; null takes the tween's."
    field delay f32 "Seconds after the step before." {
      min 0
      unit s
    }
  }

  struct TimelineTweenVars {
    doc "One timeline tween of one field of every target (TweenTimeline.to, from, fromTo and set): GSAP's vars, with the field named."
    desc true
    field component Option.AnyComponent "The component; null takes the timeline's defaults, else og.Transform."
    field field String "The numeric field or lane, as in TweenDesc."
    field to Option.List.f32 "The end value (to, fromTo, set); one for every lane, or one per lane."
    field from Option.List.f32 "The start value (from, fromTo)."
    field relative bool "`to` is added to the start value."
    field duration Option.f32 "Seconds per cycle; null takes the timeline's defaults." {
      unit s
    }
    field delay f32 "Seconds added to its position." {
      min 0
      unit s
    }
    field ease Option.Ease "The curve; null takes the timeline's defaults."
    field repeat i32 "Extra cycles: 0 once, -1 forever." {
      min -1
    }
    field yoyo bool "Every other cycle plays backwards."
    field repeatDelay f32 "Seconds held between cycles." {
      min 0
      unit s
    }
    field stagger Option.OneOf.f32.StaggerDesc "Several targets start one after another: seconds between them, or a StaggerDesc."
    field keyframes Option.List.TweenKeyframe "Steps played in order instead of `to` (repeat and yoyo then apply to the whole)."
    field onStart Option.String "The og.TweenEvent sent when it starts (per target)."
    field onUpdate Option.String "The og.TweenEvent sent every run it is written."
    field onComplete Option.String "The og.TweenEvent sent when it ends."
    field onRepeat Option.String "The og.TweenEvent sent when a cycle begins again."
  }

  interface TweenTimeline {
    doc "A GSAP timeline (og.tween.timeline): build it with to, from, fromTo, set, call, addLabel and add, each placed by a position and answering the timeline so calls chain; control it with play, pause, reverse, seek, progress, timeScale and kill."
    prop tween Tween "Its handle: og.TweenCompleted and og.TweenEvent carry it, og.tween.cancel and active take it."
    prop error Option.String "Why the last refused call added nothing; null when none was refused."
    fn to {
      doc "Tween a field of every target to `vars.to` (or through `vars.keyframes`), from its value when the tween starts."
      param targets OneOf.Entity.List.Entity "An entity or several (staggered by vars.stagger)."
      param vars TimelineTweenVars "The field, the values and the timing."
      param position OneOf.f64.String "Where: seconds or GSAP's position text; null appends." {
        optional true
      }
      returns TweenTimeline
    }
    fn from {
      doc "Tween from `vars.from` to each target's value at this call (read now: a system needs read access to the component). The start value is written on the timeline's first render."
      param targets OneOf.Entity.List.Entity "An entity or several."
      param vars TimelineTweenVars "The field, the start value and the timing."
      param position OneOf.f64.String "Where." {
        optional true
      }
      returns TweenTimeline
    }
    fn fromTo {
      doc "Tween from `vars.from` to `vars.to`; both are required. The start value is written on the timeline's first render."
      param targets OneOf.Entity.List.Entity "An entity or several."
      param vars TimelineTweenVars "The field, both values and the timing."
      param position OneOf.f64.String "Where." {
        optional true
      }
      returns TweenTimeline
    }
    fn set {
      doc "Set a field of every target to `vars.to` when the playhead reaches the position (a tween of no duration; going back before it restores the value it found)."
      param targets OneOf.Entity.List.Entity "An entity or several."
      param vars TimelineTweenVars "The field and the value."
      param position OneOf.f64.String "Where." {
        optional true
      }
      returns TweenTimeline
    }
    fn call {
      doc "Send og.TweenEvent `name` when the playhead crosses the position, forwards or backwards (GSAP's call, named instead of a function)."
      param name String "The event's name (at most 63 bytes)."
      param position OneOf.f64.String "Where." {
        optional true
      }
      returns TweenTimeline
    }
    fn addLabel {
      doc "Name a time, for positions (`\"label\"`, `\"label+=0.5\"`) and seek."
      param label String "The label."
      param position OneOf.f64.String "Where; null is the end." {
        optional true
      }
      returns TweenTimeline
    }
    fn add {
      doc "Nest a running tween, sequence, parallel group or timeline (its `tween` handle) at the position: it stops running on its own and plays as part of this one. A string adds a label."
      param child OneOf.Tween.String "The handle to nest, or a label."
      param position OneOf.f64.String "Where." {
        optional true
      }
      returns TweenTimeline
    }
    fn play {
      doc "Play forwards, from a time or label when given."
      param from OneOf.f64.String "Where to start." {
        optional true
      }
      returns TweenTimeline
    }
    fn pause {
      doc "Hold the playhead, at a time or label when given."
      param at OneOf.f64.String "Where to hold." {
        optional true
      }
      returns TweenTimeline
    }
    fn resume {
      doc "Play on in the direction it had."
      returns TweenTimeline
    }
    fn reverse {
      doc "Play backwards towards the start, from a time or label when given."
      param from OneOf.f64.String "Where to start." {
        optional true
      }
      returns TweenTimeline
    }
    fn restart {
      doc "Play forwards from the start (callbacks fire again)."
      returns TweenTimeline
    }
    fn seek {
      doc "Jump the playhead to a time or label without sending callbacks; it keeps playing or holding."
      param position OneOf.f64.String "Seconds or a label."
      returns TweenTimeline
    }
    fn progress {
      doc "How far through its cycle the playhead is, 0 to 1; given a value, jumps there first (without callbacks)."
      param value f64 "The progress to jump to." {
        optional true
      }
      returns f64
    }
    fn time {
      doc "The playhead's time within its cycle, in seconds."
      returns f64
    }
    fn duration {
      doc "One cycle, in seconds: where its last child ends."
      returns f64
    }
    fn timeScale {
      doc "The playback rate; given a value, sets it first (2 twice as fast, 0 holds)."
      param value f64 "The new rate, 0 or more." {
        optional true
      }
      returns f64
    }
    fn isActive {
      doc "Whether it is running and not paused."
      returns bool
    }
    fn kill {
      doc "Stop and remove it where it is (no events); its fields keep their values."
      returns bool
    }
  }

  struct SquashDesc {
    doc "Squash and stretch: the entity's og.Transform.scale jumps to rest times impact and eases back to rest."
    desc true
    field entity Entity "The entity."
    field impact Partial.Vector3 "The x, y and z factors at the impact: (1.25, 0.8) squashes (a landing, a hit), (0.8, 1.25) stretches (a jump). z is for 3D models (a squash bulges in x and z: (1.15, 0.85, 1.15)); left out or 0 it stays at rest, so a sprite's { x, y } is unchanged. A component left out takes its default: x 1.25, y 0.8, z 0; under a project's art contract, ArtMotion.squash scales it (0.5 the same, 1 rubber hose: x 1.5, y 0.6)."
    field rest Vector3 "The scale it recovers to." {
      default 1 1 1
    }
    field duration f32 "Seconds to recover." {
      default 0.18
      min 0
      unit s
    }
    field ease Ease "The recovery curve; back.out overshoots a little, elastic.out wobbles." {
      default back.out
    }
  }

  struct FlashDesc {
    doc "A hit flash: the entity's og.Sprite (else og.Mesh, else og.Model) flashColor set and its flash faded from amount to 0."
    desc true
    field entity Entity "The entity."
    field color Color "The flash colour (white for a hit, red for damage taken)." {
      default 1 1 1
    }
    field amount f32 "How far it starts towards the colour." {
      default 1
      min 0
      max 1
    }
    field duration f32 "Seconds to fade." {
      default 0.12
      min 0
      unit s
    }
    field ease Ease "The fade's curve; power1.in holds the flash, then drops it." {
      default power1.in
    }
  }

  fn to {
    doc "Start a tween. Systems may call it; it first moves in this tick's og.tween run."
    aliases "animate a value, DOTween, Godot Tween, LeanTween, GSAP, lerp over time, ease"
    param world World "The world."
    param desc TweenDesc "The field, the values and the timing."
    returns Result.Tween "Refused for a dead entity, a component it lacks, a field that is not numeric, or values of the wrong length."
  }

  fn from {
    doc "Animate from desc.from to the field's value captured at this call, before the delay. The first og.tween tick writes from and holds it through the delay. Unlike GSAP immediateRender, the call itself never writes the field. A system must declare read access to the target component for capture. Snapshot/restore retains the captured endpoint; later writes during the delay cannot change it."
    param world World "The world."
    param desc TweenFromDesc "The start value and timing."
    returns Result.Tween "Refused for an unreadable target or invalid values."
  }

  fn fromTo {
    doc "Animate from explicit desc.from to desc.to; both are required. The first og.tween tick writes from, including during the delay. No endpoint is captured from the live field."
    param world World "The world."
    param desc TweenDesc "The explicit start, end and timing."
    returns Result.Tween "Refused when from is missing or the target or values are invalid."
  }

  fn sequence {
    doc "Start tweens one after another (each with its own delay, duration and repeat); the time one leaves over goes to the next."
    param world World "The world."
    param steps List.TweenDesc "The tweens, in order."
    param desc TweenGroupDesc "Repeat, scaling and the tag." {
      optional true
    }
    returns Result.Tween
  }

  fn parallel {
    doc "Start tweens together; the group ends with the last one."
    param world World "The world."
    param tweens List.TweenDesc "The tweens."
    param desc TweenGroupDesc "Repeat, scaling and the tag." {
      optional true
    }
    returns Result.Tween
  }

  fn timeline {
    doc "A GSAP timeline: tweens, calls, labels and nested timelines placed on its own clock, played, paused, reversed and sought as one. It starts playing in this tick's og.tween run unless paused."
    aliases "gsap.timeline, GSAP timeline, tween sequence, stagger, keyframes, choreography, DOTween Sequence"
    param world World "The world."
    param desc TimelineDesc "Defaults, repeat, yoyo, paused, callbacks." {
      optional true
    }
    returns TweenTimeline "Refused settings are reported in its `error`; it still answers the timeline."
  }

  fn cancel {
    doc "Stop a tween where it is (no event)."
    aliases "stop tween, kill tween"
    param world World "The world."
    param tween Tween "The handle."
    returns bool "False when it was not running."
  }

  fn cancelEntity {
    doc "Stop every tween of an entity (no events), say before starting a new reaction. A timeline drops its tweens of the entity and plays on."
    param world World "The world."
    param entity Entity "The entity."
    returns u32 "How many stopped."
  }

  fn active {
    doc "Whether a tween is still running."
    param world World "The world."
    param tween Tween "The handle."
    returns bool
  }

  fn squash {
    doc "Squash and stretch the entity's og.Transform.scale (cancels its earlier squash)."
    param world World "The world."
    param desc SquashDesc "The entity and the impact."
    returns Result.Tween "Refused for an entity without og.Transform."
  }

  fn flash {
    doc "Flash the entity's og.Sprite, its og.Mesh, or its og.Model (a glTF instance: this instance only, the others sharing its materials stay as they are). Cancels its earlier flash."
    aliases "hit flash, damage flash, blink, white flash, flicker"
    param world World "The world."
    param desc FlashDesc "The entity and the flash."
    returns Result.Tween "Refused for an entity with none of og.Sprite, og.Mesh and og.Model."
  }
}

# ── tilemap ───────────────────────────────────────────────────────────────
