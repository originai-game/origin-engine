  component Water {
    doc "A planar water surface on the entity's xz plane (centred on it, turned with it): colour by the water's depth over what is below, foam where it meets geometry, animated waves, refraction and reflections (screen-space, the sky's cubemap where that misses, or a planar reflection), the sun's shadows, caustics below it and an underwater view. With an og.WaterSurface on the same entity its wave heights displace the surface (centred on the entity, unrotated). Bodies crossing it are og.Splash events, og.physics.waterHeight answers its surface and an og.Buoyancy hull floats on it."
    guide "render §8"
    group "Shape"
    field size Vector2 "The extent along the entity's x and z." {
      default 16 16
      unit m
      tunable true
    }
    field geometry Geometry "Draw the water over this mesh (its vertices in the entity's frame) instead of the size × size grid: a stream, channel or pool of any outline, with the same colour by depth, refraction, foam and reflections. 0: the grid. A mesh surface has no wave heights."
    field river Path "A river along this path (og.path; its heights the water's level): a ribbon riverWidth across in place of the grid, its current riverSpeed mid-stream, slowing to nothing at the banks; og.Buoyancy bodies drift with it in the tick. Where it drops steeper than 45 degrees it falls. 0: none." {
      guide "render §8"
    }
    field riverWidth f32 "The river's width across." {
      default 6
      min 0
      unit m
      tunable true
    }
    field riverSpeed f32 "The river's current mid-stream; it slows to nothing at the banks." {
      default 1.5
      min 0
      unit mps
      tunable true
    }
    field segments u32 "Grid cells per side (the height field's detail)." {
      default 64
      min 1
      max 256
    }
    group "Colour and body"
    field shallow Color "Shallow water's colour (tints what is seen through it)." {
      default 0.55 0.85 0.82
    }
    field deep Color "Deep water's colour." {
      default 0.02 0.09 0.14
    }
    field depthFade f32 "The depth over which water turns from shallow to deep." {
      default 2.5
      min 0.01
      unit m
      tunable true
    }
    field absorption Color "How much of each colour the water absorbs per metre of light's path (1/m; sea water about 0.45 0.07 0.03). With it or scattering set the body is physical: what lies below dims along the path down and up, and sun and sky scatter back out; shallow, deep, depthFade and opacity are then unused." {
      guide "render §8"
      default 0 0 0
    }
    field scattering Color "How much of each colour the water scatters per metre (1/m; clear ocean about 0.002 0.004 0.008, a silty coast ten times that). See absorption." {
      default 0 0 0
    }
    field opacity f32 "How opaque deep water gets." {
      default 0.92
      min 0
      max 1
      unit ratio
      tunable true
    }
    group "Foam"
    field foam Color "The foam's colour." {
      default 0.95 0.97 1
    }
    field foamWidth f32 "The water depth over which foam rings geometry (0: none)." {
      default 0.35
      min 0
      unit m
      tunable true
    }
    group "Detail waves"
    field waveScale f32 "Detail waves per metre." {
      default 0.6
      min 0
      tunable true
    }
    field waveSpeed f32 "How fast the detail waves travel." {
      default 1
      tunable true
    }
    field waveStrength f32 "How strongly they bend the surface (0: a mirror)." {
      default 0.35
      min 0
      max 4
      tunable true
    }
    group "Reflection and refraction"
    field refraction f32 "How far refraction shifts what is seen through the water." {
      default 1
      min 0
      tunable true
    }
    field reflectivity f32 "How much it reflects." {
      default 1
      min 0
      max 2
      tunable true
    }
    field planarReflection f32 "Reflect the scene by drawing it again from the camera mirrored in the surface, at this fraction of the screen's resolution (0: off, the screen-space and sky reflections). As many surfaces a frame as RenderOptions.planarReflections allows." {
      guide "render §8"
      min 0
      max 1
      unit ratio
      tunable true
    }
    field shadows f32 "How much the sun's shadows darken the surface: its highlight, foam and colour (0: none)." {
      min 0
      max 1
      unit ratio
      tunable true
    }
    field f0 f32 "The reflectance looking straight down (Schlick's F0): 0.02 for clean water; three.js Water.js reflects at least 0.3." {
      default 0.02
      min 0
      max 1
      unit ratio
      tunable true
    }
    field reflectionBias f32 "A floor under the reflected colour: bias + (1 - bias) times the reflection (three.js Water.js: 0.1)." {
      min 0
      max 1
      unit ratio
      tunable true
    }
    group "Underwater"
    field underwaterColor Color "With the camera below the surface: the water's fog colour." {
      default 0.03 0.16 0.2
    }
    field underwaterDensity f32 "Its fog per metre (0: no underwater view). Below the surface the frame's fog becomes the water's, darker with depth, the sun in shafts as strong as `caustics`; the surface from below shows the sky inside Snell's window and mirrors the water outside it." {
      guide "render §8"
      default 0.09
      min 0
      max 2
      tunable true
    }
    group "Caustics"
    field caustics f32 "Caustics of the sunlight on everything below the surface (0: none): the bright net the surface's waves focus, a sea's by its own waves, a lake's by its ripples, its cells growing with depth. One surface a frame, the first that has them." {
      min 0
      max 4
      tunable true
    }
    field causticsScale f32 "How fine a lake's caustics are: the ripples that focus them, in cells per metre (a sea's follow its waves)." {
      default 0.6
      min 0.01
      max 10
      tunable true
    }
    group "Normal maps and flow" "three.js Water and Water2 ripples in place of the travelling waves."
    field normalMap Texture "Ripples from a tangent-space normal map (linear; red +x, green +z, blue up) in place of the waves: with flow 0, four layers drifting over the world's xz times normalScale (three.js Water); with a flow, two layers sliding along it, cross-faded (three.js Water2). waveStrength scales slopes. 0: waves." {
      guide "render §8"
    }
    field normalScale f32 "The normal map's repeats per metre (the lake) or per uv unit (a flow)." {
      default 1
      min 0
      tunable true
    }
    field glint f32 "three.js Water's sun glint: pow(eye · reflect(-sun, normal), 100) times the sun's light times this, through the Fresnel term. With glint it is shaded as three.js Water.js throughout (deep is its waterColor, sunColor the light × glint / 2). 0: the default half-vector highlight and depth colour." {
      guide "render §8"
      min 0
      tunable true
    }
    field flow Vector2 "Water2's flow: its direction in the mesh's uv (or the grid's x, z) and, as its length, the uv it slides per second. 0 0: the lake's four drifting layers. Without a normalMap a flow carries the travelling waves, in metres a second: a river." {
      default 0 0
      tunable true
    }
    field flowMap Texture "three.js Water2's flowMap: the flow's direction per point as rg * 2 - 1 (linear; image top at v 1), over the mesh's uv or the grid from its -x -z corner; with it flow's length is the speed (0 0: 0.03) and the map the direction, for the normal map's layers or the travelling waves. 0: the flow alone." {
      guide "render §8"
    }
    group "Sea" "A wind-driven ocean on the grid."
    field wind Vector2 "The wind over an open sea, direction in xz, speed (m/s) as length: the water rises in Gerstner waves of a fully developed sea (Pierson–Moskowitz), drawn as a clipmap about the camera; og.physics.waterHeight and og.Buoyancy read the same waves. Within size unless endless; a mesh has none." {
      guide "render §8"
      default 0 0
      unit mps
      tunable true
    }
    field swell f32 "The sea's height, as a fraction of a fully developed sea's for the wind." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field choppiness f32 "How far the sea's crests lean and sharpen (Gerstner steepness): 0 round swell, 1 the most that never folds over. Whitecaps foam where the crests bunch, by as much." {
      default 0.6
      min 0
      max 1
      unit ratio
      tunable true
    }
    field endless bool "A sea (wind) to the horizon all round the camera, wherever it goes, not only within size: its waves stay where they are in the world. false: the sea ends at the size rectangle (a bay, a lake in a gale)."
    field seabed Entity "The og.Terrain whose heights are the sea's floor (0: none): a wave fades in water shallower than half its length, the sea held under its breaking height (significant height 0.78 × depth); shore trains break into surf. og.physics.waterHeight and og.Buoyancy read the same sea." {
      guide "render §8"
    }
    group "Shore"
    field shore f32 "How high the trains rolling in on the seabed's shores are, times a quarter of the sea's significant height (0: none; the waves still shoal)." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field shoreWaveLength f32 "The trains' length from crest to crest (0: 40 m)." {
      min 0
      max 400
      unit m
      tunable true
    }
    field shoreFoam f32 "How much surf foams where the trains break and the water runs shallow over the seabed (0: none)." {
      default 1
      min 0
      max 2
      unit ratio
      tunable true
    }
    group "Sea details"
    field foamStreaks f32 "How strongly a sea's ageing foam is drawn into streaks along the wind (0: none): the lace a whitecap leaves, gathered into windrows by the surface's Langmuir circulation. Rendering only." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field meniscus f32 "Where the camera's near plane crosses the surface, the width in pixels of the meniscus along the waterline between the air and the water's fog, each pixel under or above as the waves put it; 0: the line alone; below 0: no waterline, the frame above or under as the eye is. Needs underwaterDensity." {
      default 2
      min -1
      max 16
      tunable true
    }
    field dynamicWaves f32 "How high the waves an og.Buoyancy hull raises on a sea are drawn (0: none): a hull presses the water down by its draft and, moving, throws a bow wave and leaves a Kelvin wake, foaming where they break, within some 64 m of the camera. Rendering only: the tick floats every hull on the sea's own waves." {
      guide "render §8"
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
    field spray f32 "How much spray a sea's breaking crests throw (0: none): droplets torn off where the foam is freshest and the crests steepest, carried by the wind and falling back, more of them as the wind rises past a moderate breeze. Rendering only; the tick never sees them." {
      default 1
      min 0
      max 4
      unit ratio
      tunable true
    }
  }

  component Water2D {
    doc "Draws the og.WaterLine on the same entity in the sprite order: the body from its surface down, a gradient from the top colour to the bottom one, and a bright lip along the surface."
    field top Color "The body's colour at the surface." {
      default 0.16 0.5 0.72
    }
    field topOpacity f32 "Its opacity there." {
      default 0.72
      min 0
      max 1
      unit ratio
    }
    field bottom Color "The colour at the bottom." {
      default 0.02 0.1 0.25
    }
    field bottomOpacity f32 "Its opacity there." {
      default 0.92
      min 0
      max 1
      unit ratio
    }
    field lip Color "The lip along the surface." {
      default 0.8 0.95 1
    }
    field lipWidth f32 "How thick the lip is (0: none)." {
      default 0.06
      min 0
      unit m
      tunable true
    }
    field layer i32 "The sprite layer it is drawn in."
  }
}

# ── anim ──────────────────────────────────────────────────────────────────

