module abilities {
  doc "The records og.systems.abilities carries out: an og.Ability is used on a press of its action or by og.abilities.use when it has a charge, its lock has run out and its pool holds its cost; its charges return one by one. An og.Status on a target merges with one of the same kind by its stacking rule and runs out after its ticks; an og.Stat's value is its base with the og.Modifier entities naming it applied in a fixed order. Every number is the game's: an ability of 0 charges is never used."
  guide "abilities §1"

  enum StatusStacking {
    doc "What a second og.Status of the same kind on the same target does to the first."
    variant refresh "The first stays and takes the second's ticks; the second goes."
    variant stack "The first stays, adds the second's stacks up to maxStacks and takes its ticks; the second goes."
    variant strongest "The stronger stays (a tie keeps the first, with the second's ticks); the other goes."
  }

  column StatusStacking {
    doc "A StatusStacking field: the variant's index."
    array Uint32Array
    stride 1
    value StatusStacking
  }

  enum ModifierOp {
    doc "How an og.Modifier changes its og.Stat: all adds, then the percents summed, then each multiply."
    variant add "Adds its amount to the base."
    variant percent "Its amount joins one sum: the value is times 1 + the sum (0.1 and 0.2 make 1.3)."
    variant multiply "Times 1 + its amount, one by one (0.1 and 0.2 make 1.32)."
  }

  column ModifierOp {
    doc "A ModifierOp field: the variant's index."
    array Uint32Array
    stride 1
    value ModifierOp
  }

  component Ability {
    aliases "skill, spell, cooldown, charges, ability slot, mana cost, Unreal GAS ability, special move"
    doc "Something its owner uses: on a press of `action` (og.input.consume, taken only when it can be used, so an early press waits in the buffer) or by og.abilities.use, it spends a charge and its cost and starts its lock, and og.AbilityUsed is sent. Below maxCharges a charge returns every rechargeTicks. Charges and locks count the ticks time moves (none in a hit stop)."
    guide "abilities §1"
    field owner Entity "Who uses it, as og.AbilityUsed reports."
    field action str.32 "The input action that uses it; empty: only og.abilities.use."
    field maxCharges u32 "The charges it holds at most; 0 is never used." {
      min 0
      tunable true
    }
    field charges u32 "The charges it has: give its first ones when it is inserted; written as it is used and recharged."
    field rechargeTicks u32 "Ticks for one charge to return while below maxCharges; 0 returns none." {
      min 0
      unit ticks
      tunable true
    }
    field recharge u32 "Written: ticks into the charge returning (0 when full)." {
      readonly true
      unit ticks
    }
    field lockTicks u32 "Ticks after a use before it can be used again, whatever its charges; 0 locks nothing." {
      min 0
      unit ticks
      tunable true
    }
    field lock u32 "Written: ticks of its lock left." {
      readonly true
      unit ticks
    }
    field pool Entity "The og.Stat a use takes `cost` from (its base: mana, stamina, ammo); 0 costs nothing."
    field cost f32 "What a use takes from the pool's base; a pool whose value is under it refuses the use." {
      min 0
      tunable true
    }
  }

  event AbilityUsed {
    aliases "on cast, ability cast, skill used, spell cast"
    doc "An og.Ability was used: sent the tick it was."
    guide "abilities §1"
    field ability Entity "The og.Ability."
    field owner Entity "Its owner."
  }

  component Stat {
    aliases "attribute, stat, character stats, speed stat, strength, armor value, mana pool, stamina, Unreal attribute set"
    doc "A number something has, on an entity of its own: `value` is `base` with every og.Modifier whose stat it is applied: adds, then percents, then multiplies, each kind in ascending order of what it adds, so the order modifiers came in never changes it. Written by og.systems.abilities each tick."
    guide "abilities §2"
    field base f32 "Its own number: a pool's amount (og.Ability.cost takes from it), a level's strength."
    field value f32 "Written: the base with its modifiers applied, each tick." {
      readonly true
    }
  }

  component Modifier {
    aliases "stat modifier, buff value, debuff value, bonus, multiplier, flat bonus, percent bonus"
    doc "A change to an og.Stat, on an entity of its own: a child of an og.Status counts its amount once per stack and goes with it; one without counts once until it is despawned."
    guide "abilities §2"
    field stat Entity "The og.Stat it changes."
    field op ModifierOp "How it changes it."
    field amount f32 "What it adds (add), joins to the percent sum (percent) or multiplies by 1 + (multiply); 0 changes nothing."
  }

  component Status {
    aliases "status effect, buff, debuff, poison, burn, slow, haste, stun, shield, damage over time, aura"
    doc "An effect on a target, its parent (og.Parent): spawned there to apply it. og.systems.abilities merges it with the target's status of the same kind by that status's `stacking`, counts down `ticks` each tick time moves (its first tick counting) and despawns it, and its modifiers, when they run out."
    guide "abilities §2"
    field kind str.32 "Which statuses on one target are one effect; empty never merges."
    field stacking StatusStacking "What one of the same kind applied after it does."
    field ticks u32 "Ticks left; 0 lasts until it is despawned." {
      min 0
      unit ticks
      tunable true
    }
    field stacks u32 "How many stacks it holds: each of its modifiers counts this many times; 0 changes nothing."
    field maxStacks u32 "The most stacks `stack` adds up to; 0 adds none." {
      min 0
      tunable true
    }
    field strength f32 "What `strongest` compares."
    field applied bool "Written: it has been merged (or found alone) on its target." {
      readonly true
    }
  }

  resource AbilityEntities {
    doc "Every og.Ability, og.Stat, og.Status and og.Modifier in entity order, written by og.systems.abilities' first systems each tick for its last."
    field abilities List.Entity.1024 "The abilities (at most 1,024)."
    field stats List.Entity.1024 "The stats (at most 1,024)."
    field statuses List.Entity.1024 "The statuses (at most 1,024)."
    field modifiers List.Entity.1024 "The modifiers (at most 1,024)."
  }

  fn ready {
    doc "Whether an ability can be used now: a charge, no lock, and its pool's value at least its cost."
    host false
    param world World "The world."
    param ability Entity "The og.Ability."
    returns bool
  }

  fn use {
    doc "Use an ability now: a charge, its lock and its cost, then og.AbilityUsed. A system that calls this lists og.Ability, og.Stat and og.AbilityUsed in its writes."
    aliases "cast, activate ability, trigger skill"
    host false
    param world World "The world."
    param ability Entity "The og.Ability."
    returns Result.Void "Refused, changing nothing, without a charge, while locked or when its pool holds less than its cost, naming which."
  }
}
