module shared {
  doc "Shared worlds: visitors of one large world see each other's avatars in real time, near them only. Each client runs its own world; a world server (`og world-server`) holds the avatars, checks each move and sends each client those near it. The game marks its avatar with og.SharedAvatar and moves it as always; every other visitor in sight is an og.RemoteAvatar entity the engine spawns, moves and despawns."
  doc "The host supplies the connection; game code names no URL or token. What the session delivers is host input, journaled with og.platform.journal."
  guide "shared-worlds"
  core SharedAvatar RemoteAvatar join status

  enum SharedState {
    doc "Where this client's session stands (og.SharedWorld.state)."
    variant off "No session: og.shared.join was never called, or og.shared.leave ended it."
    variant connecting "Joining: the host asked its session provider for a connection and the server has not welcomed this client yet."
    variant joined "In the world: the server took this client in; remote avatars arrive."
    variant reconnecting "The connection was lost (or the server moved this client): the engine asks the provider for a new connection, backing off from 250 ms to 4 s for 30 s, and the server keeps this avatar 10 s for it to resume."
    variant refused "The provider or the server refused this client, or reconnecting gave up: og.SharedLeft says why."
  }

  column SharedState {
    doc "A SharedState field: the variant's index."
    array Uint32Array
    stride 1
    value SharedState
  }

  resource SharedWorld {
    doc "This client's shared-world session: its settings, which the game sets, and where it stands, which the engine writes. Remote avatars are drawn `interpDelayMs` behind the newest server time this client has, between the two states around it."
    aliases "multiplayer, MMO, online presence, see other players, shared world, persistent world, massively multiplayer, visitors, avatars of others, server authoritative, interest management"
    guide "shared-worlds §2"
    field sendRateHz u32 "How often this client proposes its avatar's state, per second (at most the tick rate)." {
      default 20
      min 1
      max 60
    }
    field interpDelayMs u32 "How far behind the newest server time remote avatars are drawn: two snapshots at the server's 20 Hz by default, so a lost one is covered." {
      guide "shared-worlds §3"
      default 100
      min 0
      max 1000
      unit ms
    }
    field extrapolateMs u32 "How long a remote avatar whose updates stopped keeps moving along its last velocity before it holds." {
      default 250
      min 0
      max 2000
      unit ms
    }
    field state SharedState "Where the session stands." {
      readonly true
    }
    field inSight u32 "The remote avatars this client holds now (og.RemoteAvatar entities)." {
      readonly true
    }
  }

  component SharedAvatar {
    doc "Marks the one entity whose state this client shares: its og.Transform's position and its yaw (the rotation about y), the velocity its moves imply, and the fields of the game's avatar component (og.shared.shape) on the same entity. The first in entity order is the one shared."
    aliases "local player avatar, my character online, networked player, replicated player"
    guide "shared-worlds §2"
    field kind u32 "The avatar's kind: which of the server's movement rules it moves by (its top speed). A token that names a kind wins."
  }

  component RemoteAvatar {
    doc "Another visitor in sight, written by the engine: it spawns the entity with an og.Transform (and the game's avatar component, og.shared.shape) when the visitor comes into sight, moves it every tick, and despawns it when the visitor leaves. The game adds its own visuals to it. Who it is: og.shared.remote."
    aliases "other player, remote player, networked avatar, replicated entity, ghost player, proxy"
    guide "shared-worlds §3"
    field id u32 "This client's number for it, while it is in sight." {
      readonly true
    }
    field kind u32 "Its kind (og.SharedAvatar.kind)." {
      readonly true
    }
    field sinceTick f64 "The tick it came into sight." {
      readonly true
      unit ticks
    }
    field jumpedTick f64 "The tick it last jumped (a teleport: drawn there at once, not moved across); 0 never." {
      readonly true
      unit ticks
    }
  }

  event SharedJoined {
    doc "The server took this client in: sent at the start of the tick after its welcome arrived, and again after a reconnect."
    field player String "This player's opaque id, the provider's (at most 63 bytes)."
    field name String "This player's display name (at most 63 bytes)."
    field resumed bool "Whether the server resumed this avatar from before a lost connection (it stayed where it was for the others)."
  }

  event SharedLeft {
    doc "The session ended: og.shared.leave, a refusal, or reconnecting gave up. Every og.RemoteAvatar despawns the same tick."
    field reason String "Why: `left` (og.shared.leave), or a code and the provider's or the server's words: `unauthorized`, `full`, `version`, `shape`, `draining`, `unavailable` (no session provider here), `offline` (reconnecting gave up)."
  }

  event PresenceEntered {
    doc "A visitor came into sight: its og.RemoteAvatar entity exists from this tick."
    field entity Entity "Its og.RemoteAvatar entity."
    field player String "Its opaque player id (at most 63 bytes)."
    field name String "Its display name (at most 63 bytes)."
    field kind u32 "Its kind."
  }

  event PresenceLeft {
    doc "A visitor left sight (or the world): its og.RemoteAvatar entity was despawned this tick."
    field entity Entity "The entity it had."
    field player String "Its opaque player id (at most 63 bytes)."
  }

  event SharedCorrected {
    doc "The server refused a move of this avatar (faster than its kind allows, or outside the world's bounds) and the engine put it back: at the state the server holds, plus what it moved here since. A game may snap its camera or tell the player."
    guide "shared-worlds §4"
    field sequence u32 "The proposal the correction answers."
  }

  struct SharedShapeDesc {
    doc "What the game shares besides the transform (og.shared.shape)."
    desc true
    field avatar Option.AnyComponent "The game's component whose fields every state carries (a locomotion mode, an appearance id): on the og.SharedAvatar entity, and written on each og.RemoteAvatar. Its packed bytes are at most 32. Null: none."
    field event Option.AnyComponent "The game's component used as an event record (og.shared.send, og.shared.events): its packed bytes are at most 1024, and an Entity field named `from` is set to the sender's og.RemoteAvatar. Used as a shape only. Null: no events."
  }

  struct SharedJoinDesc {
    doc "Which world to join (og.shared.join)."
    desc true
    field world String "The world's name on the server (at most 64 of letters, digits, `.`, `_` and `-`)." {
      default "main"
    }
  }

  struct SharedRemote {
    doc "Who an og.RemoteAvatar is."
    field player String "Its opaque player id."
    field name String "Its display name."
    field kind u32 "Its kind."
    field sinceTick f64 "The tick it came into sight." {
      unit ticks
    }
  }

  struct SharedStatus {
    doc "The session, as a HUD or the probe reads it."
    field state String "`off`, `connecting`, `joined`, `reconnecting` or `refused`."
    field host String "What carries the session here: the session provider's name (`static` for a fixed endpoint, `player` for the platform's), or `none`."
    field transport String "The connection's transport, `ws`; empty without one."
    field world String "The world joined."
    field player String "This player's opaque id; empty before the welcome."
    field name String "This player's display name."
    field inSight u32 "The remote avatars held."
    field others u32 "Visitors near this one the server does not send (past its 64 nearest)."
    field serverTick f64 "The newest server tick received." {
      unit ticks
    }
    field serverHz u32 "The server's tick rate."
    field proposals f64 "Proposals sent."
    field corrections u32 "Corrections received (og.SharedCorrected)."
    field bytesIn f64 "Bytes received in this session." {
      unit bytes
    }
    field bytesOut f64 "Bytes sent in this session." {
      unit bytes
    }
    field reason String "Why the last session ended or was refused; empty while none did."
  }

  fn shape {
    doc "Set what the game shares besides the transform: its avatar component and its event component. Call it outside a system before og.shared.join; its fingerprint is checked when joining, so every client of a world needs the same shape. Without a call, the transform alone and no events."
    guide "shared-worlds §2"
    param world World "The world."
    param desc SharedShapeDesc "The avatar component and the event component."
    returns Result.Void "Refused inside a system, during a session, or for a component whose packed bytes are too many."
  }

  fn join {
    doc "Join a shared world: the host asks its session provider for a connection (an endpoint and a token the engine never reads), the engine says hello, and og.SharedJoined arrives once the server takes this client in. The og.SharedAvatar entity is what it shares. A lost connection reconnects by itself."
    aliases "connect to server, join online world, go online, enter MMO, start multiplayer session"
    guide "shared-worlds §2"
    param world World "The world."
    param desc SharedJoinDesc "The world to join."
    returns Result.Void "Refused during a session, with lockstep running (og.Lockstep), or for a world name that is not one. Without a session provider the join is refused when the host answers: og.SharedLeft says `unavailable`."
  }

  fn leave {
    doc "Leave the shared world: the server is told, and every og.RemoteAvatar despawns at the next tick (og.SharedLeft says `left`)."
    param world World "The world."
    returns Result.Void "Refused without a session."
  }

  fn teleport {
    doc "Move this avatar anywhere at once (a map click, a portal): its og.Transform is set and the next proposal is a teleport, which the server takes past the speed rule when its policy allows, and remote clients draw at once instead of moving it across."
    guide "shared-worlds §4"
    param world World "The world."
    param position Vector3 "Where, in world space."
    returns Result.Void "Refused without an og.SharedAvatar entity or for a position that is not finite."
  }

  fn send {
    doc "Send an event to the visitors near this one (those whose sight holds this avatar): reliable, at most 1 KiB, rate-limited by the server. They read it with og.shared.events at the start of the tick after it arrives."
    generic C AnyComponent
    param world World "The world."
    param component C "The event component og.shared.shape named."
    param value Partial.Value.C "Its fields; omitted ones take their defaults (`from` is the engine's)."
    returns Result.Void "Refused without a joined session, without an event shape, or for another component."
  }

  fn events {
    doc "The events delivered this tick, in the order they arrived, each with `from` set to its sender's og.RemoteAvatar when the component has that field. Callable from a system."
    generic C AnyComponent
    param world World "The world."
    param component C "The event component og.shared.shape named."
    returns Result.List.Value.C "Refused for another component than the shape's."
  }

  fn remote {
    doc "Who an og.RemoteAvatar is: its player id, name and kind. Null for an entity that is not one."
    param world World "The world."
    param entity Entity "The og.RemoteAvatar entity."
    returns Option.SharedRemote
  }

  fn status {
    doc "The session now: its state, what carries it, the avatars held, the server's tick, and the bytes and corrections so far."
    param world World "The world."
    returns SharedStatus
  }
}
