# Generated files and shell scripts must have identical bytes on every host.
* text=auto eol=lf
# Radiance headers can make Git mistake an HDR image for text.
*.hdr binary
# QOA sound fixtures: binary.
*.qoa binary
# Binary model and texture fixtures.
*.glb binary
*.dds binary
*.psd binary
*.tga binary
*.webp binary
# Weight bundles and their test fixtures (og-motion): binary.
*.safetensors binary
*.jpg binary
# Preserve the released Yarn conformance corpus byte-for-byte, including CRLF.
third_party/yarn-spinner/upstream/** -text
