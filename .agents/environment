# shellcheck shell=bash
# Sourced by non-interactive login shells in this checkout. No secrets or
# services belong in the shared project snapshot.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
# Browser tests use CHROME (not CHROME_PATH). Reuse the orb's browser rather
# than downloading another copy; an explicit caller override wins.
if [[ -z ${CHROME:-} ]]; then
  for chrome in "$HOME"/.agent-browser/browsers/chrome-*/chrome; do
    if [[ -x $chrome ]]; then
      export CHROME="$chrome"
    fi
  done
  unset chrome
fi
# sccache shares its cache between orbs through Cloudflare R2 (the owner,
# 2026-11-01) when the project secrets SCCACHE_R2_ACCESS_KEY_ID and
# SCCACHE_R2_SECRET_ACCESS_KEY are present; without them it keeps its local
# disk cache. The token reads and writes this one bucket only; objects
# expire after 30 days. macrunner and studio-win keep their local caches.
if [[ -n ${SCCACHE_R2_ACCESS_KEY_ID:-} && -n ${SCCACHE_R2_SECRET_ACCESS_KEY:-} ]]; then
  export SCCACHE_BUCKET=origin-engine-sccache
  export SCCACHE_ENDPOINT=https://bca3392cf595465b8f0a046434c1ab82.r2.cloudflarestorage.com
  export SCCACHE_REGION=auto
  export SCCACHE_S3_KEY_PREFIX=orb-linux-x64
  export AWS_ACCESS_KEY_ID="$SCCACHE_R2_ACCESS_KEY_ID"
  export AWS_SECRET_ACCESS_KEY="$SCCACHE_R2_SECRET_ACCESS_KEY"
fi
