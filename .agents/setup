#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local start=$SECONDS
  printf '\n==> %s\n' "$*"
  "$@"
  printf '==> done (%ss)\n' "$((SECONDS - start))"
}

# Cache prerequisites and a warm dev build (prewarm, at the end) in the
# project snapshot.
# libnss3 and libnspr4 are Chrome's own libraries (the browser tests and
# web-reference run the orb's agent-browser Chrome, .agents/environment).
# libasound2-dev and libudev-dev are Linux build dependencies of the native
# hosts: cpal's ALSA output (og-audio) and gilrs's gamepads (og-host-c).
packages=(build-essential mold pkg-config libasound2-dev libudev-dev brotli shellcheck curl ca-certificates unzip xz-utils minisign libnss3 libnspr4)
missing=()
for package in "${packages[@]}"; do
  if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
mesa_min=25.0.7
mesa_version=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers 2>/dev/null || true)
mesa_upgrade=false
mesa_suite=()
if [[ $(dpkg-query -W -f='${Status}' mesa-vulkan-drivers 2>/dev/null || true) != 'install ok installed' ]] \
  || ! dpkg --compare-versions "${mesa_version:-0}" ge "$mesa_min"; then
  mesa_upgrade=true
  # Bookworm's Mesa 22.3.6 grows RSS every frame and OOMs the intro at 4 GiB.
  # The same test and pixels pass with 25.0.7 from Debian's backports.
  # shellcheck disable=SC1091
  source /etc/os-release
  if [[ ${ID:-} == debian && ${VERSION_CODENAME:-} == bookworm ]]; then
    printf '%s\n' 'deb https://deb.debian.org/debian bookworm-backports main' \
      | sudo tee /etc/apt/sources.list.d/origin-engine-backports.list >/dev/null
    mesa_suite=(-t bookworm-backports)
  fi
fi
# ffmpeg cooks the video tests' clips (without it og-video.test.ts skips all
# five). It is pinned: the video fixture's references/vulkan/video-90.png
# was recorded from a clip this build encoded (6.1.1, libsvtav1 1.7.0), and
# another encoder moves the frame. A distribution without this build gets
# none, so the tests skip rather than compare another encoder's clip.
ffmpeg_pin=7:6.1.1-3ubuntu5
ffmpeg_install=false
# The pin is an Ubuntu build: on another distribution (the orbs' Debian) skip
# it without an apt-get update on every run.
# shellcheck disable=SC1091
os_id=$(. /etc/os-release && echo "${ID:-}")
if [[ $os_id == ubuntu && $(dpkg-query -W -f='${Version}' ffmpeg 2>/dev/null || true) != "$ffmpeg_pin" ]]; then
  ffmpeg_install=true
fi
if ((${#missing[@]})) || "$mesa_upgrade" || "$ffmpeg_install"; then
  step sudo apt-get update -qq
fi
if "$ffmpeg_install"; then
  if apt-cache madison ffmpeg | grep -q " $ffmpeg_pin "; then
    step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --allow-downgrades "ffmpeg=$ffmpeg_pin" "libavcodec60=$ffmpeg_pin"
    [[ $(ffmpeg -hide_banner -encoders 2>/dev/null) == *libsvtav1* ]] \
      || { printf 'ffmpeg %s has no libsvtav1: the video fixture cannot be cooked.\n' "$ffmpeg_pin" >&2; exit 1; }
  else
    printf 'warning: ffmpeg %s is not available here; the video tests will skip.\n' "$ffmpeg_pin" >&2
  fi
fi
if ((${#missing[@]})); then
  step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
fi
if "$mesa_upgrade"; then
  step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${mesa_suite[@]}" mesa-vulkan-drivers
  mesa_version=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers)
  if ! dpkg --compare-versions "$mesa_version" ge "$mesa_min"; then
    printf 'Mesa %s is too old: Origin Engine orbs need mesa-vulkan-drivers >= %s.\n' "$mesa_version" "$mesa_min" >&2
    exit 1
  fi
fi

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
mkdir -p "$HOME/.local/bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if ! command -v rustup >/dev/null; then
  step curl -fsSL --retry 3 https://sh.rustup.rs -o "$tmp/rustup.sh"
  step sh "$tmp/rustup.sh" -y --profile minimal --default-toolchain none --no-modify-path
fi
# Install the dated nightly and targets from rust-toolchain.toml here, as its
# own timed step: rustup >= 1.28's `show` installs nothing, so the download
# used to happen lazily inside install-tools.sh's first cargo call.
step rustup toolchain install --no-self-update

# Avoid compiling nextest from source during setup. The repository leaves its
# version unpinned, as does CI; an installed version is retained on warm runs.
if ! command -v cargo-nextest >/dev/null; then
  step curl -fsSL --retry 3 https://get.nexte.st/latest/linux -o "$tmp/nextest.tar.gz"
  step tar -xzf "$tmp/nextest.tar.gz" -C "$HOME/.local/bin" cargo-nextest
fi
step scripts/install-tools.sh
step cargo fetch --locked
# The pinned binaries (og-assets.json) that tests compile in and the gate reads.
step bun scripts/assets.ts ensure
step bun install --cwd tests/install --frozen-lockfile
# og check's tsrs comes from scripts/install-tools.sh above. Cache the tsgo
# check-conformance compares it with (TSGO_VERSION in crates/og-cli/src/commands/check.rs).
typescript=$(sed -n 's/^pub const TSGO_VERSION: &str = "\(.*\)";/\1/p' crates/og-cli/src/commands/check.rs)
test -n "$typescript"
step bun x --package "typescript@$typescript" tsc --version

# Amp and supervised services start separate login shells. Keep the hook
# repository-scoped and read the checked-out environment on every activation.
marker="# Origin Engine orb environment"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$PWD/"*) source "$PWD/.agents/environment" ;;
esac
EOF
fi
# Some custom providers have neither agent-browser nor its Chrome install.
# Reuse a caller's browser or the orb's install; otherwise provision both.
# shellcheck disable=SC1091
source .agents/environment
if [[ -z ${CHROME:-} ]]; then
  if ! command -v agent-browser >/dev/null; then
    step npm install --global --prefix "$HOME/.local" agent-browser
  fi
  step agent-browser install --with-deps
fi
# Chrome's sandbox needs unprivileged user namespaces, which Ubuntu's
# AppArmor restricts by default ("No usable sandbox"). sysctl.d keeps the
# setting across a reboot; .agents/resume applies it again on a resumed VM.
userns=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [[ -e $userns ]]; then
  printf 'kernel.apparmor_restrict_unprivileged_userns = 0\n' \
    | sudo tee /etc/sysctl.d/60-origin-engine-chrome.conf >/dev/null
  [[ $(cat "$userns") == 0 ]] || echo 0 | sudo tee "$userns" >/dev/null
fi
# shellcheck disable=SC2016 # Expand CHROME in the new login shell, not setup.
step bash -lc 'command -v cargo bun sccache og-sccache-wrap wasm-bindgen node; test -x "$CHROME" && "$CHROME" --headless=new --version'

# No prewarm build (the owner, 2026-11-24: orbs started too slowly). main
# moves many times a day, so most new orbs restore a stale snapshot and rerun
# this script: a warm-target build here cost up to 10 minutes per orb, and the
# target it left (tens of GB) made snapshots slow to restore and filled small
# guests' disks. A thread builds what it needs on first use.
