#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local start=$SECONDS
  printf '\n==> %s\n' "$*"
  "$@"
  printf '==> done (%ss)\n' "$((SECONDS - start))"
}

# Cache prerequisites, not a full engine build, in the project snapshot.
packages=(build-essential pkg-config libasound2-dev brotli shellcheck curl ca-certificates unzip xz-utils)
missing=()
for package in "${packages[@]}"; do
  if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
mesa_min=25.0.7
mesa_version=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers 2>/dev/null || true)
mesa_upgrade=false
mesa_suite=()
if [[ $(dpkg-query -W -f='${Status}' mesa-vulkan-drivers 2>/dev/null || true) != 'install ok installed' ]] \
  || ! dpkg --compare-versions "${mesa_version:-0}" ge "$mesa_min"; then
  mesa_upgrade=true
  # Bookworm's Mesa 22.3.6 grows RSS every frame and OOMs the intro at 4 GiB.
  # The same test and pixels pass with 25.0.7 from Debian's backports.
  # shellcheck disable=SC1091
  source /etc/os-release
  if [[ ${ID:-} == debian && ${VERSION_CODENAME:-} == bookworm ]]; then
    printf '%s\n' 'deb https://deb.debian.org/debian bookworm-backports main' \
      | sudo tee /etc/apt/sources.list.d/origin-engine-backports.list >/dev/null
    mesa_suite=(-t bookworm-backports)
  fi
fi
if ((${#missing[@]})) || "$mesa_upgrade"; then
  step sudo apt-get update -qq
fi
if ((${#missing[@]})); then
  step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
fi
if "$mesa_upgrade"; then
  step sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${mesa_suite[@]}" mesa-vulkan-drivers
  mesa_version=$(dpkg-query -W -f='${Version}' mesa-vulkan-drivers)
  if ! dpkg --compare-versions "$mesa_version" ge "$mesa_min"; then
    printf 'Mesa %s is too old: Origin Engine orbs need mesa-vulkan-drivers >= %s.\n' "$mesa_version" "$mesa_min" >&2
    exit 1
  fi
fi

export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
mkdir -p "$HOME/.local/bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
if ! command -v rustup >/dev/null; then
  step curl -fsSL --retry 3 https://sh.rustup.rs -o "$tmp/rustup.sh"
  step sh "$tmp/rustup.sh" -y --profile minimal --default-toolchain none --no-modify-path
fi
# rustup reads the version, components and targets from rust-toolchain.toml.
step rustup show active-toolchain

# Avoid compiling nextest from source during setup. The repository leaves its
# version unpinned, as does CI; an installed version is retained on warm runs.
if ! command -v cargo-nextest >/dev/null; then
  step curl -fsSL --retry 3 https://get.nexte.st/latest/linux -o "$tmp/nextest.tar.gz"
  step tar -xzf "$tmp/nextest.tar.gz" -C "$HOME/.local/bin" cargo-nextest
fi
step scripts/install-tools.sh
step cargo fetch --locked
step cargo fetch --locked --manifest-path tools/wasm-determinism/Cargo.toml
step bun install --cwd tools/bench --frozen-lockfile
step bun install --cwd tests/install --frozen-lockfile
# og check's tsrs comes from scripts/install-tools.sh above. Cache the tsgo
# check-conformance compares it with (TSGO_VERSION in crates/og-cli/src/check.rs).
typescript=$(sed -n 's/^pub const TSGO_VERSION: &str = "\(.*\)";/\1/p' crates/og-cli/src/check.rs)
test -n "$typescript"
step bun x --package "typescript@$typescript" tsc --version

# Amp and supervised services start separate login shells. Keep the hook
# repository-scoped and read the checked-out environment on every activation.
marker="# Origin Engine orb environment"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$PWD/"*) source "$PWD/.agents/environment" ;;
esac
EOF
fi
# shellcheck disable=SC2016 # Expand CHROME in the new login shell, not setup.
step bash -lc 'command -v cargo bun sccache wasm-bindgen wasm-opt node; test -x "$CHROME"'
