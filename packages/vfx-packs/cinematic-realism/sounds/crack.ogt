type sfx
version 1
---
# MIT Origin Engine. Timber or stone giving way: a dry snap and a low
# knock.
layer noise {
  lowpass 2600
  highpass 300
  attack 0.001
  sustain 0.008
  decay 0.07
  punch 1
  gain 0.7
}
layer sine {
  freq 260
  freq_end 110
  attack 0.001
  sustain 0.01
  decay 0.08
  gain 0.5
}
layer noise {
  lowpass 900
  delay 0.05
  attack 0.01
  sustain 0.05
  decay 0.35
  gain 0.25
}
