type sfx
version 1
---
# MIT Origin Engine. A grenade-size blast: a tight thump and a sharp
# crack.
layer sine {
  freq 95
  freq_end 38
  attack 0.002
  sustain 0.04
  decay 0.45
  punch 0.6
  drive 1.5
  gain 0.85
}
layer noise {
  lowpass 1400
  lp_slide -0.5
  attack 0.003
  sustain 0.06
  decay 0.8
  gain 0.6
}
layer noise {
  highpass 2200
  attack 0.001
  sustain 0.008
  decay 0.09
  gain 0.5
}
