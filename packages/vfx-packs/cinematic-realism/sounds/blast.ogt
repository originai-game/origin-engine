type sfx
version 1
---
# MIT Origin Engine. A mid-size blast: a sub thump falling in pitch, the
# body's roar and a short crack on top.
layer sine {
  freq 70
  freq_end 28
  attack 0.002
  sustain 0.08
  decay 0.9
  punch 0.6
  drive 1.5
  gain 0.9
}
layer noise {
  lowpass 900
  lp_slide -0.5
  attack 0.004
  sustain 0.12
  decay 1.6
  gain 0.7
}
layer noise {
  highpass 1800
  attack 0.001
  sustain 0.01
  decay 0.12
  gain 0.45
}
