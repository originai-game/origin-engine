# MIT Origin Engine. An energy blast's shell: a thin bright skin that
# opens and tears apart.
blend additive
doubleSided true
noise {
  tile 5 3
  scroll 0 0.4
}
erosion curve 0 0.15 0.5 0.45 1 0.95
erosionSoftness 0.15
erosionEdge 0.05 2 3 4 1
fresnel 2 1.5
alpha curve 0 0.9 0.5 0.5 1 0
softDepth 0.1
