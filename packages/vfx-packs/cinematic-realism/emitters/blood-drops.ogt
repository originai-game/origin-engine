type particles
version 1
---
# MIT Origin Engine. Droplets thrown from a hit, stretched by their speed,
# falling until they meet the ground.
maxParticles 24
shape cone 40 0.02
rate 0
burst 0 18
duration 0.05
looping false
lifetime 0.4 0.8
speed 1.5 3.8
size 0.008 0.016
align velocity 0.03
gravity 0 -9.8 0
drag 1.2
blend alpha
lit true
color 0.36 0.02 0.02
colorOverLife {
  key 0 1 1 1 1
  key 0.85 1 1 1 1
  key 1 1 1 1 0
}
collision 0 0 depth die
