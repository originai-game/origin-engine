type particles
version 1
---
# MIT Origin Engine. The side petals of sustained fire, one star per 0.1 s
# cycle in step with muzzle-auto's loop: gas escaping
# sideways from the barrel as a short star.
maxParticles 8
shape cone 80 0.015
rate 0
burst 0 6
duration 0.1
looping true
lifetime 0.05 0.08
speed 3.5 5.5
size 0.06 0.1
heightOverLife 0 2.5 1 1
sizeOverLife 0 1 1 0.2
align velocity 0.035
gravity 0 0 0
blend additive
colorOverLife {
  key 0 2.6 1.6 0.7 1
  key 1 0.8 0.2 0.03 0
}
