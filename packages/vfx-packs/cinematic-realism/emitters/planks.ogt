type particles
version 1
---
# MIT Origin Engine. A crate's boards: thrown apart, tumbling, coming to
# rest.
maxParticles 16
shape sphere 0.3
spread 180
rate 0
burst 0 14
duration 0.05
looping false
lifetime 1.6 2.4
speed 2 5
size 0.05 0.09
heightOverLife 0 5 1 5
rotation 0 360
angularVelocity -360 360
gravity 0 -9.8 0
drag 0.3
render mesh box
lit true
roughness 0.85
blend alpha
color 0.42 0.31 0.2
colorOverLife {
  key 0 1 1 1 1
  key 0.9 1 1 1 1
  key 1 1 1 1 0
}
collision 0.3 0.6 depth
