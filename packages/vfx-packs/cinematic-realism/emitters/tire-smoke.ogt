# CC0 Thomas Iché / Unity Labs DiscSmoke01; MIT composition. White smoke
# off a spinning or sliding tyre, rolling along the ground before it
# lifts.
maxParticles 120
shape cone 70 0.1
rate 50
duration 2
looping true
lifetime 1.2 2.2
speed 0.5 1.6
size 0.3 0.5
sizeOverLife 0 0.5 0.3 1 1 2.6
rotation 0 360
angularVelocity -25 25
gravity 0 0.35 0
drag 1.8
wind 1
noise 0.3 0.7 0.3
texture "vfx/cinematic-realism/textures/dust.png"
sheet 16 4 64 life 1 blend
blend alpha
lit true
color 1.7 1.7 1.75
softDistance 0.3
colorOverLife {
  key 0 1 1 1 0
  key 0.08 1 1 1 0.45
  key 0.5 1 1 1 0.26
  key 1 1 1 1 0
}
