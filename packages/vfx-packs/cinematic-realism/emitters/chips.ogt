type particles
version 1
---
# MIT Origin Engine. Chips of stone or concrete knocked off a hit,
# tumbling and bouncing.
maxParticles 14
shape cone 45 0.03
rate 0
burst 0 12
duration 0.05
looping false
lifetime 0.7 1.3
speed 1.5 4.5
size 0.008 0.025
rotation 0 360
angularVelocity -700 700
gravity 0 -9.8 0
drag 0.3
render mesh tetrahedron
lit true
roughness 0.9
blend alpha
color 0.5 0.49 0.46
colorOverLife {
  key 0 1 1 1 1
  key 0.85 1 1 1 1
  key 1 1 1 1 0
}
collision 0.3 0.6 depth
