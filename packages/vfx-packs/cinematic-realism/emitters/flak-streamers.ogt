shape sphere 0.2
spread 180
rate 0
burst 0 8
duration 0.05
looping false
lifetime 1 1.6
speed 5 9
size 0.05 0.08
gravity 0 -5 0
drag 1
trail 0.7 1
blend alpha
colorOverLife {
  key 0 0.25 0.24 0.23 0.7
  key 0.6 0.3 0.29 0.28 0.4
  key 1 0.3 0.3 0.3 0
}
