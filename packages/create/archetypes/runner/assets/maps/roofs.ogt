type tilemap
version 1
---
# The roof the courier runs on, 0.65 units a tile (tools/make-assets.py).
size 16 3
tile 16 16
unit 0.65
tileset "tiles/city.ogt"
layer roofs {
  z 0
  repeat x
  legend "=" 0
  legend "b" 1
  legend "L" 2
  legend "D" 3
  row "================"
  row "bLbDbbLbDbbLbDbb"
  row "bbbbbbbbbbbbbbbb"
}
