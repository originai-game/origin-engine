type strings
version 1
---
# Spark Orb's English strings (og.i18n); every key matches zh-CN.ogt.
# Big numbers: num.step digits a unit, num.1-num.4 the units, then num.sci.
locale "en"
base true
string "title.name" "Spark Orb"
string "title.tagline" "Tap the orb, wake the sparks, light the night"
string "title.play" "Play"
string "title.continue" "Continue"
string "title.settings" "Settings"
string "title.footer" "Space taps · 1–4 buy · N for the supernova"
string "hud.rate" "+{n} a second"
string "hud.pause" "Pause"
string "hud.buy" "Buy {name}"
string "hud.nova" "Supernova"
string "hud.novaGain" "+{n} stardust"
string "hud.novaAt" "Supernova at {n}"
string "gen.ember" "Ember"
string "gen.storm" "Storm"
string "gen.crystal" "Crystal"
string "gen.star" "Star"
string "float.milestone" "{name} ×2!"
string "confirm.title" "Collapse into a supernova?"
string "confirm.body" "Your sparks and generators are gone; you keep {n} stardust ({total} in all), making everything {bonus}% stronger."
string "confirm.later" "Not yet"
string "confirm.collapse" "Collapse"
string "welcome.title" "Welcome back"
string "welcome.body" "While you were away ({time}) the orb made {n} sparks."
string "welcome.collect" "Collect"
string "nova.title" "Supernova!"
string "nova.made" "Sparks this run"
string "nova.time" "Run time"
string "nova.gain" "Stardust gained"
string "nova.dust" "Stardust"
string "nova.bonus" "Bonus to everything"
string "nova.percent" "+{n}%"
string "nova.again" "Ignite again"
string "pause.title" "Paused"
string "pause.resume" "Resume"
string "pause.settings" "Settings"
string "pause.quit" "Title"
string "settings.title" "Settings"
string "settings.master" "Master"
string "settings.music" "Music"
string "settings.effects" "Effects"
string "settings.language" "Language"
string "settings.motion" "Reduce motion"
string "settings.done" "Done"
string "lang.en" "English"
string "lang.zh" "简体中文"
string "num.step" "3"
string "num.whole" "{n, number}"
string "num.short" "{m}{u}"
string "num.sci" "{m}e{e}"
string "num.1" "K"
string "num.2" "M"
string "num.3" "B"
string "num.4" "T"
string "time.hm" "{h} h {m} min"
string "time.ms" "{m} min {s} s"
