type strings
version 1
---
# 星火球的简体中文字符串（og.i18n）；每个键都与 en.ogt 一一对应。
# 大数：num.step 为每个单位的位数（万进制为 4），num.1–num.4 为单位，之后用 num.sci。
locale "zh-CN"
fonts "fonts/NotoSansSC-subset.ttf"
string "title.name" "星火球"
string "title.tagline" "点亮星火球，唤醒火花，照亮夜空"
string "title.play" "开始"
string "title.continue" "继续"
string "title.settings" "设置"
string "title.footer" "空格点击 · 1–4 购买 · N 超新星"
string "hud.rate" "每秒 +{n}"
string "hud.pause" "暂停"
string "hud.buy" "购买{name}"
string "hud.nova" "超新星"
string "hud.novaGain" "+{n} 星尘"
string "hud.novaAt" "{n} 时可超新星"
string "gen.ember" "余烬"
string "gen.storm" "风暴"
string "gen.crystal" "晶簇"
string "gen.star" "星辰"
string "float.milestone" "{name} ×2！"
string "confirm.title" "坍缩成超新星？"
string "confirm.body" "火花和生成器都会消失；你将获得 {n} 星尘（共 {total}），一切产出提升 {bonus}%。"
string "confirm.later" "再等等"
string "confirm.collapse" "坍缩"
string "welcome.title" "欢迎回来"
string "welcome.body" "你离开的这段时间（{time}），星火球产出了 {n} 火花。"
string "welcome.collect" "收下"
string "nova.title" "超新星！"
string "nova.made" "本轮火花"
string "nova.time" "本轮用时"
string "nova.gain" "获得星尘"
string "nova.dust" "星尘总数"
string "nova.bonus" "全部产出加成"
string "nova.percent" "+{n}%"
string "nova.again" "重新点燃"
string "pause.title" "已暂停"
string "pause.resume" "继续"
string "pause.settings" "设置"
string "pause.quit" "返回标题"
string "settings.title" "设置"
string "settings.master" "总音量"
string "settings.music" "音乐"
string "settings.effects" "音效"
string "settings.language" "语言"
string "settings.motion" "减少动态效果"
string "settings.done" "完成"
string "lang.en" "English"
string "lang.zh" "简体中文"
string "num.step" "4"
string "num.whole" "{n, number}"
string "num.short" "{m}{u}"
string "num.sci" "{m}e{e}"
string "num.1" "万"
string "num.2" "亿"
string "num.3" "万亿"
string "num.4" "亿亿"
string "time.hm" "{h} 小时 {m} 分"
string "time.ms" "{m} 分 {s} 秒"
