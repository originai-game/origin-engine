type skin
version 1
---
# Ember Vale's skin: a copy of the fantasy style pack (templates/ui-kit/tools/make-skins.py; CC0 art, OFL fonts; LICENSES.md).
name "ember"
base dark
atlas "skins/ember/atlas.png" 384 256
scale 1
palette {
  bg "#1a120b"
  bgSubtle "#241910"
  surface "#efdfb8"
  surfaceRaised "#efdfb8"
  surfaceHover "#f4e8c8"
  materialThick "#efdfb8"
  materialRegular "#efdfb8f2"
  materialThin "#efdfb8e6"
  fg "#2a1a0c"
  fgMuted "#3d2a18"
  fgSubtle "#654b31"
  fgInverse "#f4e8c8"
  fill "#e2cc98"
  fillStrong "#d6bc82"
  border "#9b7a4a"
  borderStrong "#5c4127"
  accent "#7a520f"
  accentHover "#74500e"
  accentActive "#6a470c"
  accentFg "#fff4dc"
  accentInk "#6e470d"
  accentSoft "#7a520f40"
  focus "#8f2d1f"
  thumb "#f4e8c8"
  scrim "#0d0805cc"
  success "#2d5a1e"
  warn "#704713"
  danger "#6e1b10"
  info "#22517f"
  shadow "#000000aa"
  stage "#1a120b"
}
radius {
  control 4
  field 4
  block 4
  card 4
  panel 6
  sheet 6
  button 6
}
ramp {
  body 15 22
  meta 13 18
  caption 13 18
  reading 16 24
  lg 19 26
  xl 22 28
  xl2 24 30
  xl3 28 32
  displaySm 28 34
  displayMd 34 40
  displayLg 42 48
}
durations {
  fast 200
  base 300
  slow 480
}
fonts {
  body "skins/ember/Newsreader-Medium.ttf"
  display "skins/ember/Cinzel-Bold.ttf"
  numeric "skins/ember/Cinzel-Bold.ttf"
  fallback "fonts/NotoSansSC-subset.ttf"
}
icons "skins/ember/icons.png" 8 4 {
  names "heart" "star" "coin" "lock" "pause" "gear" "sword" "shield" "potion" "gem" "key" "map" "bolt" "clock" "trophy" "home" "plus" "close" "check" "play" "back" "bag" "bomb" "crown" "flag" "apple" "leaf" "fire" "drop" "skull" "music" "person"
}
slice panel 4 4 96 96 16 authored
slice card 104 4 64 64 10 authored
slice button 172 4 48 48 10 tint
slice buttonHover 224 4 48 48 10 tint
slice buttonPressed 276 4 48 48 10 tint
slice buttonDisabled 328 4 48 48 10 tint
slice field 4 104 48 48 8 tint
slice slot 56 104 48 48 10 tint
slice tooltip 108 104 32 32 8 tint
slice capsule 144 104 32 32 12 tint
slice track 180 104 32 16 6 tint
slice fill 216 104 32 16 6 tint
soft 252 104 64 64 24
corner 320 104 32 32 28 28 authored 6
corners panel
divider 4 172 128 24 112 20 authored
flourish 136 172 64 24 48 18 authored 0
tile 204 172 64 64 64 64 0.5 6 panel card
shadow panel 0 10 18 2 "#000000b3"
shadow card 0 4 8 0 "#00000066"
shadow button 0 3 4 0 "#00000073"
shadow capsule 0 3 6 0 "#00000080"
press 0.98 0.96 1
hover 0 1.0
motion {
  enter scale
  stagger 35
  toast slideDown
  progress 420
  shake 5
  pop 0.1
}
