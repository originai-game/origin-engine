type navmesh
version 1
---
# The sentinels' navmesh, baked by `og cook` (og.nav.load("nav/vale.ogt")):
# the vale's terrain above the waterline (bounds' min y is a little over the
# lake's surface at y 1, so the lake is a hole the sentinels walk round, and
# the water a refuge) and the four beacons' plinths, for an agent 0.5 m wide
# and 1.8 m tall. The cliffs round the vale are steeper than `slope`.
agent {
  radius 0.5
  height 1.8
  climb 0.4
  slope 40
}
cellSize 0.35
cellHeight 0.1
tileSize 32
terrain "terrain/vale.ogt" {
  position 0 0 0
}
bounds {
  min -58 1.3 -58
  max 58 16 58
}
# The beacons' plinths (src/world.ts PLINTH: 1.6 m square, from 0.2 m below
# the knoll's top to 1 m above it; the tops are tools/make-assets.py's
# heights there).
box {
  center -34 5.8 -30
  size 1.6 1.2 1.6
}
box {
  center 34 6.51 -32
  size 1.6 1.2 1.6
}
box {
  center 36 6.16 26
  size 1.6 1.2 1.6
}
box {
  center -36 6.49 24
  size 1.6 1.2 1.6
}
