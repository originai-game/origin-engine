type particles
version 1
---
# A hit: sparks thrown up from the receptor in the lane's colour (the sprite tints them).
maxParticles 40
shape box 0.5 0.05 0
spread 60
burst 0 14
duration 0.1
lifetime 0.25 0.45
speed 3 6
size 0.08 0.16
sizeOverLife 0 1 1 0
colorOverLife {
  key 0 1 1 1 1
  key 1 1 1 1 0
}
gravity 0 -8 0
drag 2
texture "sprites/spark.png"
blend additive
render sprite 20
