  "derived": {
    "_doc": "Values the engine's default CSS derives from the roles above, per scheme: `tint` is a role at a fraction of its alpha (`--<name>`), `shadow` the inset shadows of controls built on those tints (`--shadow-<name>`), `alias` names kept for documents and the active density's sizes (`--<name>`: `--control-sm/md/lg`, `--row`, `--header`, `--gutter`, `--section` are the input's density, which the engine selects as `--density-active-*`; `--touch-target` the smallest target a finger gets).",
    "tint": {
      "shadow-30": { "color": "shadow", "alpha": 0.3 },
      "shadow-35": { "color": "shadow", "alpha": 0.35 },
      "shadow-45": { "color": "shadow", "alpha": 0.45 },
      "sheen-50": { "color": "sheen", "alpha": 0.5 },
      "sheen-60": { "color": "sheen", "alpha": 0.6 },
      "line-70": { "color": "border", "alpha": 0.7 },
      "danger-45": { "color": "danger", "alpha": 0.45 }
    },
    "shadow": {
      "sheen": "inset 0 1px 0 0 var(--sheen-60)",
      "well": "inset 0 1px 3px 0 var(--shadow-30)",
      "pressed": "inset 0 1px 3px 0 var(--shadow-45)",
      "groove": "inset 0 1px 2px 0 var(--shadow-35)",
      "fill-sheen": "inset 0 1px 0 0 var(--sheen-50)"
    },
    "alias": {
      "font-body": "var(--font-sans)",
      "space-xl3": "var(--space-3xl)",
      "radius-xs": "var(--radius-control)",
      "radius-sm": "var(--radius-button)",
      "radius-md": "var(--radius-panel)",
      "radius-lg": "calc(var(--radius-panel) * 1.5)",
      "radius-xl": "calc(var(--radius-panel) * 2)",
      "radius-pill": "var(--radius-capsule)",
      "motion-enter": "var(--motion-duration-base) ease-out",
      "motion-exit": "var(--motion-duration-fast) ease-in",
      "density-touch-gutter": "var(--density-compact-gutter)",
      "density-touch-section": "var(--density-compact-section)",
      "control-sm": "var(--density-active-control-sm, var(--density-compact-control-sm))",
      "control-md": "var(--density-active-control-md, var(--density-compact-control-md))",
      "control-lg": "var(--density-active-control-lg, var(--density-compact-control-lg))",
      "row": "var(--density-active-row, var(--density-compact-row))",
      "header": "var(--density-active-header, var(--density-compact-header))",
      "gutter": "var(--density-active-gutter, var(--density-compact-gutter))",
      "section": "var(--density-active-section, var(--density-compact-section))",
      "touch-target": "var(--size-touch)"
    }
  },
  "motion": {
    "duration": {
      "instant": "120ms",
      "fast": "180ms",
      "base": "240ms",
      "slow": "400ms",
      "spring": "520ms",
      "bounce": "640ms"
    },
    "easing": {
      "out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001)",
      "snappy": "linear(0, 0.016, 0.063 4.1%, 0.25 8.7%, 0.684 17.5%, 0.86 22.6%, 0.967 28%, 1.03 34%, 1.05 39.6%, 1.045 46.2%, 1.017 58.5%, 0.997 75.2%, 1)",
      "bounce": "linear(0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%, 1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%, 1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%, 0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1)"
    },
    "timing": {
      "_doc": "The timing table: what each moment of a UI moves on, by the duration, easing and spring names above (or a number of its own). A style overrides a row in its motion block (docs/ui.md §3.1); the default style takes these. hover: the lift on the spring named and, for a pad's virtual cursor, how much it slows and settles over a control (magnet 0–1). press: the squash in at once, back on a spring of this damping over the duration named. enter and exit: a widget's arrival and departure. cascade: a list's or a panel's children entering one after another, step between them, never spread past cap. toast: in, held (hold; holdDanger for an error), out. screen: a game-screen transition covers then reveals over this many slow durations.",
      "hover": { "spring": "default", "magnet": 0.5 },
      "press": { "duration": "instant", "damping": 0.55 },
      "enter": { "duration": "base", "easing": "out" },
      "exit": { "duration": "fast", "easing": "exit" },
      "cascade": { "step": "40ms", "cap": "400ms", "easing": "out" },
      "toast": { "enter": "base", "hold": "3200ms", "holdDanger": "6000ms", "exit": "fast" },
      "screen": { "slow": 2 }
    },
    "spring": {
      "_doc": "Springs as damping ratio (1 = critically damped, below 1 overshoots) and response (seconds to reach the target; not a duration), the parameters Apple ships. build.mjs emits --ease-spring-<name> (a linear() easing), --dur-spring-<name> (its settle time) and --spring-<name>-damping/-response for the runtime spring (ui-svelte motion/spring.ts); Swift gets the pair for .spring(response:dampingFraction:). default: overlays, menus, highlights; sheet: sheets and drawers; momentum: releases that carried velocity (a flick, a throw).",
      "default": {
        "damping": 1,
        "response": "350ms"
      },
      "sheet": {
        "damping": 0.85,
        "response": "300ms"
      },
      "momentum": {
        "damping": 0.8,
        "response": "400ms"
      }
    },
    "named": {
      "_doc": "The engine's named transitions (`transition: var(--motion-<name>)` in a document, a widget's motion token): each a spring of a perceptual duration and a bounce (0 none, towards 1 more), capped by a style's overshoot; `ui` also sets --motion-ui-easing, its 60 Hz samples.",
      "ui": { "duration": "300ms", "bounce": 0 },
      "panel": { "duration": "420ms", "bounce": 0.1 },
      "emphasis": { "duration": "520ms", "bounce": 0.3 },
      "playful": { "duration": "600ms", "bounce": 0.45 },
      "enter": { "duration": "var(--motion-duration-base)", "easing": "var(--motion-easing-out)" },
      "exit": { "duration": "var(--motion-duration-fast)", "easing": "var(--motion-easing-exit)" }
    }
  },
