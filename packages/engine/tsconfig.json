{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "noEmit": true,
    "paths": {
      "@origingame/engine": [
        "./types/index.d.ts"
      ]
    }
  },
  "include": [
    "types/index.d.ts",
    "examples/*.ts",
    "tests/*.ts"
  ]
}
