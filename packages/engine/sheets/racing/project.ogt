type project
version 1
---
# The racing components' review sheet: `og ui sheet racing` renders each page
# at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page. race is the normal page (speed, standings, lap deltas, the start
# banner), garage the stress page (a long garage and a full classification),
# states every member in every fixture state it declares.
name "Racing kit sheet"
id "racing-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "race-fantasy" "style:fantasy;page:race"
  screen "garage-fantasy" "style:fantasy;page:garage"
  screen "states-fantasy" "style:fantasy;page:states"
}
