type strings
version 1
---
# The card kit's strings and the sheet's fixture text in Simplified Chinese,
# as a game ships them, so the review's CJK cells (--locales …,zh-CN) show a
# localised game.
locale "zh-CN"
string "card.face.cost" "费用 {cost}"
string "card.hand.name" "手牌"
string "card.hand.empty" "没有手牌"
string "card.hand.play" "打出"
string "card.hand.unplayable" "不能打出"
string "card.piles.name" "牌堆"
string "card.piles.count" "{label}：{count}"
string "card.collection.filters" "筛选"
string "card.collection.empty" "没有符合的卡牌"
