type strings
version 1
---
# The card kit's strings in Arabic, as a game ships them, so the review's
# right-to-left cells (og ui review --locales …,ar) show them.
locale "ar"
string "card.face.cost" "الكلفة {cost}"
string "card.hand.name" "اليد"
string "card.hand.empty" "لا بطاقات في يدك"
string "card.hand.play" "العب"
string "card.hand.unplayable" "لا يمكن لعبها"
string "card.piles.name" "الأكوام"
string "card.piles.count" "{label}: {count}"
string "card.collection.filters" "عوامل التصفية"
string "card.collection.empty" "لا بطاقات مطابقة"
string "card.collection.owned" "×{count}"
string "card.collection.inDeck" "{count} في المجموعة"
string "card.collection.locked" "غير مملوكة"
string "card.collection.refused" "لا يمكن إضافتها"
string "card.collection.cards" "البطاقات"
string "card.deck.empty" "مجموعتك فارغة"
string "card.deck.count" "{count} / {limit}"
string "card.deck.size" "حجم المجموعة"
string "card.deck.copies" "×{count}"
string "card.deck.less" "−"
string "card.deck.more" "+"
string "card.deck.add" "أضف نسخة من {name}"
string "card.deck.remove" "أزل نسخة من {name}"
string "card.reward.choices" "الخيارات"
string "card.reward.relic" "أثر"
string "card.reward.empty" "لا شيء للاختيار"
string "card.map.name" "الخريطة"
string "card.map.legend" "مفتاح الخريطة"
