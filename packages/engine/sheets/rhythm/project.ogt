type project
version 1
---
# The rhythm components' review sheet: `og ui sheet rhythm` renders each page
# at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page. songs is the normal page (the song list and its charts), play the
# stress page (the judgement and score HUD over the lanes beside a long
# results screen), states every member in every fixture state it declares.
name "Rhythm kit sheet"
id "rhythm-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "songs-fantasy" "style:fantasy;page:songs"
  screen "play-fantasy" "style:fantasy;page:play"
  screen "states-fantasy" "style:fantasy;page:states"
}
