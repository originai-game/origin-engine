type project
version 1
---
# The rpg components' review sheet: `og ui sheet rpg` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page.
name "RPG kit sheet"
id "rpg-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "inventory-fantasy" "style:fantasy;page:inventory"
  screen "journal-fantasy" "style:fantasy;page:journal"
  screen "equipment-fantasy" "style:fantasy;page:equipment"
  screen "explore-fantasy" "style:fantasy;page:explore"
  screen "combat-fantasy" "style:fantasy;page:combat"
}
