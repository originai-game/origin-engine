type project
version 1
---
# The rpg components' review sheet: `og ui sheet rpg` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page.
name "RPG kit sheet"
id "rpg-sheet"
engine "0.8.0"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "inventory-default" "style:default;page:inventory"
  screen "journal-default" "style:default;page:journal"
  screen "equipment-default" "style:default;page:equipment"
  screen "explore-default" "style:default;page:explore"
  screen "combat-default" "style:default;page:combat"
  screen "primitives-default" "style:default;page:primitives"
  screen "crafting-default" "style:default;page:crafting"
  screen "trade-default" "style:default;page:trade"
  screen "loot-default" "style:default;page:loot"
  screen "dialogue-default" "style:default;page:dialogue"
  screen "inventory-fantasy" "style:fantasy;page:inventory"
  screen "journal-fantasy" "style:fantasy;page:journal"
  screen "equipment-fantasy" "style:fantasy;page:equipment"
  screen "explore-fantasy" "style:fantasy;page:explore"
  screen "combat-fantasy" "style:fantasy;page:combat"
}
