type strings
version 1
---
# The dialog and film screens' own strings in Simplified Chinese, as a game
# ships them, and the text of their `story` fixtures (src/fixtures.ts,
# "t:<key>|<English>"), so the review's CJK cells (og ui review screens
# --locales …,zh-CN) draw Chinese.
locale "zh-CN"
string "screen.common.back" "返回"
string "screen.confirm.undone" "无法撤销"
string "screen.tutorial.Step" "教程 · {step} / {steps}"
string "screen.tutorial.next" "下一步"
string "screen.tutorial.skip" "跳过"
string "screen.film-chapters.title" "章节"
string "screen.film-chapters.locked" "尚未到达"
string "screen.film-gallery.title" "结局"
string "screen.film-gallery.locked" "尚未到达"
string "screen.film-choices.label" "选择"
string "screen.film-choices.qte" "按住或连按"
string "screen.film-flowchart.title" "目前的故事"
string "screen.film-flowchart.play" "从这里开始"
string "screen.film-flowchart.selected" "已选中"
string "sheet.confirm.title" "要永久删除“九重之门”战役的存档吗？"
string "sheet.confirm.body" "第 7 章，已游玩 61 小时，所有同伴与宝库中的全部物品。此操作无法撤销，云端副本也会一并删除。"
string "sheet.confirm.ok" "全部删除"
string "sheet.confirm.cancel" "保留存档"
string "sheet.tutorial.title" "闪避穿过典狱长的攻击"
string "sheet.tutorial.text" "在攻击命中前的一瞬按下闪避键，即可从中穿过。时间会短暂变慢：绕到敌人身后，趁它转身前出手。"
string "sheet.chapters.c1" "1 · 厨房"
string "sheet.chapters.c2" "2 · 灯塔下的漫漫长夜"
string "sheet.chapters.c3" "3 · 地窖"
string "sheet.endings.e1" "黎明"
string "sheet.endings.e2" "地窖的门始终紧闭"
string "sheet.choices.c0" "拿起桌上的刀"
string "sheet.choices.c1" "打开门并呼喊"
string "sheet.choices.c2" "按住闪避"
string "sheet.choices.c3" "在黑暗中等待"
string "sheet.flow.start" "厨房"
string "sheet.flow.hall" "走廊"
string "sheet.flow.wait" "等待"
string "sheet.flow.brave" "楼梯"
string "sheet.flow.shy" "地窖"
string "sheet.flow.end" "黎明"
string "sheet.flow.detail" "第 2 章 · 灯塔下的漫漫长夜"
