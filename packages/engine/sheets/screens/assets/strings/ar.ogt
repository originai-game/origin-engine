type strings
version 1
---
# The built-in screens' own strings in Arabic, as a game ships them, so the
# review's right-to-left cells (og ui review screens --locales …,ar) draw
# Arabic: under a pack whose faces have none, each Arabic glyph falls back
# to the locale's face.
locale "ar"
string "screen.common.back" "رجوع"
string "screen.settings.title" "الإعدادات"
string "screen.settings.defaults" "الافتراضي"
string "screen.settings.revert" "تراجع"
string "screen.settings.apply" "تطبيق"
string "screen.pause.Played" "{played}"
string "screen.pause.controls" "التحكم"
string "screen.pause.load" "تحميل"
string "screen.pause.quit" "الخروج من اللعبة"
string "screen.pause.quitToMenu" "العودة إلى القائمة"
string "screen.pause.resume" "متابعة"
string "screen.pause.save" "حفظ"
string "screen.pause.settings" "الإعدادات"
string "screen.pause.title" "إيقاف مؤقت"
string "screen.results.Amount" "{r_name} ×{r_amount}"
string "screen.results.Gained" "+{gained, number} نقطة خبرة"
string "screen.results.LevelValue" "المستوى {level}"
string "screen.results.StatValue" "{format, select, percent {{value, number}%} other {{value, number}}}"
string "screen.results.again" "العب مجددًا"
string "screen.results.best" "الأفضل"
string "screen.results.continue" "متابعة"
string "screen.results.replay" "شاهد الإعادة"
