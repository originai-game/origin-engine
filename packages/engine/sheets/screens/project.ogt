type project
version 1
---
# The built-in screens' review sheet (src/ui/screens): `og ui sheet screens`
# renders each page at desktop and phone, 100 % and 150 % (docs/ui.md §6.2).
# A screen fills the viewport, so each is a page of its own: its default
# state, and in the fantasy pack its stress state too (overflow, else the
# first the sheet declares); `og ui review screens --states a,b` takes every
# page through any state of src/fixtures.ts. The -default screens review the
# same pages in the core default style.
name "Built-in screens sheet"
id "screens-sheet"
engine "0.7.7"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "banner-fantasy" "style:fantasy;page:banner"
  screen "banner-overflow-fantasy" "style:fantasy;page:banner:overflow"
  screen "calendar-fantasy" "style:fantasy;page:calendar"
  screen "calendar-month-fantasy" "style:fantasy;page:calendar:month"
  screen "calibration-fantasy" "style:fantasy;page:calibration"
  screen "card-fantasy" "style:fantasy;page:card"
  screen "card-overflow-fantasy" "style:fantasy;page:card:overflow"
  screen "confirm-fantasy" "style:fantasy;page:confirm"
  screen "confirm-overflow-fantasy" "style:fantasy;page:confirm:overflow"
  screen "creator-tools-fantasy" "style:fantasy;page:creator-tools"
  screen "credits-fantasy" "style:fantasy;page:credits"
  screen "credits-overflow-fantasy" "style:fantasy;page:credits:overflow"
  screen "data-list-fantasy" "style:fantasy;page:data-list"
  screen "data-list-overflow-fantasy" "style:fantasy;page:data-list:overflow"
  screen "film-chapters-fantasy" "style:fantasy;page:film-chapters"
  screen "film-chapters-overflow-fantasy" "style:fantasy;page:film-chapters:overflow"
  screen "film-choices-fantasy" "style:fantasy;page:film-choices"
  screen "film-choices-overflow-fantasy" "style:fantasy;page:film-choices:overflow"
  screen "film-flowchart-fantasy" "style:fantasy;page:film-flowchart"
  screen "film-gallery-fantasy" "style:fantasy;page:film-gallery"
  screen "film-gallery-locked-fantasy" "style:fantasy;page:film-gallery:locked"
  screen "game-over-fantasy" "style:fantasy;page:game-over"
  screen "game-over-overflow-fantasy" "style:fantasy;page:game-over:overflow"
  screen "hud-editor-fantasy" "style:fantasy;page:hud-editor"
  screen "key-values-fantasy" "style:fantasy;page:key-values"
  screen "key-values-overflow-fantasy" "style:fantasy;page:key-values:overflow"
  screen "leaderboard-fantasy" "style:fantasy;page:leaderboard"
  screen "leaderboard-overflow-fantasy" "style:fantasy;page:leaderboard:overflow"
