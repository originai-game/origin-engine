type strings
version 1
---
# The puzzle kit's strings in Arabic, as a game ships them, so the review's
# right-to-left cells (og ui review --locales …,ar) show them.
locale "ar"
string "puzzle.path.name" "المراحل"
string "puzzle.path.empty" "لا مراحل بعد"
string "puzzle.path.play" "العب"
string "puzzle.path.chapterStars" "{earned} / {total}"
string "puzzle.path.chapterStarsName" "{earned} من {total} نجمة"
string "puzzle.path.levelLocked" "المرحلة {number}، مقفلة"
string "puzzle.path.levelOpen" "المرحلة {number}، متاحة"
string "puzzle.path.levelCurrent" "المرحلة {number}، التالية"
string "puzzle.path.levelDone" "المرحلة {number}، مكتملة، {stars} من {max} نجوم"
string "puzzle.goals.name" "الأهداف"
string "puzzle.goals.none" "ابلغ النتيجة المطلوبة"
string "puzzle.goals.left" "{label}: بقي {left}"
string "puzzle.goals.done" "{label}: تم"
string "puzzle.goals.moves" "الحركات"
string "puzzle.goals.time" "الوقت"
string "puzzle.goals.movesLeft" "بقيت {moves} حركة"
string "puzzle.goals.timeLeft" "بقي {time}"
string "puzzle.goals.low" "أوشك على النفاد"
string "puzzle.goals.score" "النتيجة"
string "puzzle.goals.scoreName" "النتيجة {score}"
string "puzzle.summary.win" "اكتملت المرحلة"
string "puzzle.summary.lose" "فشلت المرحلة"
string "puzzle.summary.stars" "{stars} من {max} نجوم"
string "puzzle.summary.record" "رقم قياسي جديد"
string "puzzle.summary.breakdown" "تفصيل النتيجة"
string "puzzle.summary.total" "المجموع"
string "puzzle.summary.next" "التالي"
string "puzzle.summary.retry" "أعد المحاولة"
string "puzzle.summary.menu" "الخريطة"
string "puzzle.boosters.name" "المعززات"
string "puzzle.boosters.empty" "لا معززات"
string "puzzle.boosters.count" "{name}، بقي {count}"
string "puzzle.boosters.unavailable" "{name}، غير متاح"
string "puzzle.boosters.armed" "جاهز"
string "puzzle.boosters.armedName" "{name}، بقي {count}، جاهز"
string "puzzle.boosters.locked" "غير متاح"
