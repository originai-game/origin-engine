type strings
version 1
---
# The puzzle kit's strings in Japanese, as a game ships them, so the review's
# CJK cells (og ui review --locales …,ja) show them.
locale "ja"
string "puzzle.path.name" "ステージ"
string "puzzle.path.empty" "ステージはまだありません"
string "puzzle.path.play" "プレイ"
string "puzzle.path.chapterStars" "{earned} / {total}"
string "puzzle.path.chapterStarsName" "スター {total}個中{earned}個"
string "puzzle.path.levelLocked" "ステージ{number}、ロック中"
string "puzzle.path.levelOpen" "ステージ{number}、プレイ可能"
string "puzzle.path.levelCurrent" "ステージ{number}、次のステージ"
string "puzzle.path.levelDone" "ステージ{number}、クリア、スター {max}個中{stars}個"
string "puzzle.goals.name" "目標"
string "puzzle.goals.none" "目標スコアを達成しよう"
string "puzzle.goals.left" "{label}：あと{left}"
string "puzzle.goals.done" "{label}：達成"
string "puzzle.goals.moves" "手数"
string "puzzle.goals.time" "時間"
string "puzzle.goals.movesLeft" "残り{moves}手"
string "puzzle.goals.timeLeft" "残り{time}"
string "puzzle.goals.low" "残りわずか"
string "puzzle.goals.score" "スコア"
string "puzzle.goals.scoreName" "スコア {score}"
string "puzzle.summary.win" "ステージクリア"
string "puzzle.summary.lose" "ステージ失敗"
string "puzzle.summary.stars" "スター {max}個中{stars}個"
string "puzzle.summary.record" "自己ベスト"
string "puzzle.summary.breakdown" "スコアの内訳"
string "puzzle.summary.total" "合計"
string "puzzle.summary.next" "次へ"
string "puzzle.summary.retry" "リトライ"
string "puzzle.summary.menu" "マップ"
string "puzzle.boosters.name" "ブースター"
string "puzzle.boosters.empty" "ブースターがありません"
string "puzzle.boosters.count" "{name}、残り{count}個"
string "puzzle.boosters.unavailable" "{name}、使用できません"
string "puzzle.boosters.armed" "準備完了"
string "puzzle.boosters.armedName" "{name}、残り{count}個、準備完了"
string "puzzle.boosters.locked" "使用不可"
