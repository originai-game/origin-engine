type strings
version 1
---
# The puzzle kit's strings in Simplified Chinese, as a game ships them, and
# the sheet's own fixture text (src/fixtures.ts keys it sheet.<slug of the
# English>), so the review's zh-CN cells show a localised game.
locale "zh-CN"
string "puzzle.path.name" "关卡"
string "puzzle.path.empty" "还没有关卡"
string "puzzle.path.play" "开始"
string "puzzle.path.selected" "已选"
string "puzzle.path.open" "可玩"
string "puzzle.path.chapterStars" "{earned} / {total}"
string "puzzle.path.chapterStarsName" "{total} 颗星中已得 {earned} 颗"
string "puzzle.path.levelLocked" "第 {number} 关，未解锁"
string "puzzle.path.levelOpen" "第 {number} 关，可玩"
string "puzzle.path.levelCurrent" "第 {number} 关，下一关"
string "puzzle.path.levelDone" "第 {number} 关，已通关，{max} 颗星中得 {stars} 颗"
string "puzzle.goals.name" "目标"
string "puzzle.goals.none" "达到目标分数"
string "puzzle.goals.left" "{label}：还剩 {left}"
string "puzzle.goals.done" "{label}：已完成"
string "puzzle.goals.moves" "步数"
string "puzzle.goals.time" "时间"
string "puzzle.goals.movesLeft" "还剩 {moves} 步"
string "puzzle.goals.timeLeft" "还剩 {time}"
string "puzzle.goals.low" "快用完了"
string "puzzle.goals.score" "分数"
string "puzzle.goals.scoreName" "分数 {score}"
string "puzzle.summary.win" "关卡完成"
string "puzzle.summary.lose" "关卡失败"
string "puzzle.summary.stars" "{max} 颗星中得 {stars} 颗"
string "puzzle.summary.record" "新纪录"
string "puzzle.summary.breakdown" "得分明细"
string "puzzle.summary.total" "总分"
string "puzzle.summary.next" "下一关"
string "puzzle.summary.retry" "重试"
string "puzzle.summary.menu" "地图"
string "puzzle.boosters.name" "道具"
string "puzzle.boosters.empty" "没有道具"
string "puzzle.boosters.count" "{name}，剩 {count} 个"
string "puzzle.boosters.unavailable" "{name}，不可用"
string "puzzle.boosters.armed" "已就绪"
string "puzzle.boosters.armedName" "{name}，剩 {count} 个，已就绪"
string "puzzle.boosters.locked" "不可用"
string "puzzle.boosters.times" "×{count}"
string "sheet.red-sweets" "红糖果"
string "sheet.jelly" "果冻"
string "sheet.leaves" "叶子"
string "sheet.gems" "宝石"
string "sheet.stars" "星星"
string "sheet.keys" "钥匙"
string "sheet.hammer" "锤子"
string "sheet.shuffle" "洗牌"
string "sheet.extra-moves" "加步数"
string "sheet.colour-burst" "彩色爆破"
string "sheet.lucky-star" "幸运星"
string "sheet.unlock" "解锁"
string "sheet.gem-rain" "宝石雨"
string "sheet.jelly-spill" "果冻泼洒"
string "sheet.candy-meadow" "糖果草地"
string "sheet.frosted-peaks" "霜糖山峰"
string "sheet.level-12" "第 12 关"
string "sheet.goals-cleared" "目标完成"
string "sheet.moves-left-6" "剩余步数 × 6"
string "sheet.moves-left-7" "剩余步数 × 7"
string "sheet.best-combo" "最佳连击"
