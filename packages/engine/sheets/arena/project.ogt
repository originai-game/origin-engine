type project
version 1
---
# The arena components' review sheet: `og ui sheet arena` renders each page
# at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page. select is the normal page (roster, draft, lobby), match the
# stress page (round HUD and banner, a full scoreboard, versus, long names),
# states every member in every fixture state it declares. The -default
# screens review the same pages in the core default style.
name "Arena kit sheet"
id "arena-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "select-fantasy" "style:fantasy;page:select"
  screen "match-fantasy" "style:fantasy;page:match"
  screen "states-fantasy" "style:fantasy;page:states"
  screen "select-default" "style:default;page:select"
  screen "match-default" "style:default;page:match"
}
