type strings
version 1
---
# The shop family's strings in Simplified Chinese, as a game ships them, so
# the review's CJK cells (og ui review --locales …,zh-CN) show them.
locale "zh-CN"
string "general.confirm.afterSaid" "{currency}余额：{after}"
string "general.confirm.balance" "余额"
string "general.confirm.busy" "正在购买"
string "general.confirm.buy" "购买"
string "general.confirm.cancel" "取消"
string "general.confirm.cost" "花费"
string "general.confirm.missing" "还差 {amount}"
string "general.confirm.missingSaid" "还需要 {amount} {currency}"
string "general.confirm.name" "确认购买"
string "general.confirm.shortOf" "{currency}不足"
string "general.shop.amount" "{amount} {currency}"
string "general.shop.amountWas" "{amount} {currency}，原价 {was}"
string "general.shop.empty" "暂时没有在售商品"
string "general.shop.featured" "精选"
string "general.shop.loading" "正在加载商店"
string "general.shop.name" "商店"
string "general.shop.owned" "已拥有"
string "general.shop.price" "价格"
string "general.shop.refused" "{name}，{status}"
string "general.shop.retry" "重试"
string "general.shop.short" "余额不足"
string "general.shop.soldOut" "已售完"
string "general.shop.tabs" "分类"
string "general.shop.wallet" "你的余额"
string "meta.available" "可领取"
string "meta.claim" "领取"
string "meta.claimed" "已领取"
string "meta.continue" "继续"
string "meta.loading" "加载中"
string "meta.locked" "未解锁"
string "meta.new" "新"
string "meta.pass.empty" "当前没有赛季"
string "meta.pass.free" "免费"
string "meta.pass.freeRewards" "免费奖励"
string "meta.pass.kicker" "{season} · {refresh}"
string "meta.pass.level" "等级 {level}"
string "meta.pass.premium" "高级"
string "meta.pass.premiumRewards" "高级奖励"
string "meta.pass.progress" "下一级"
string "meta.pass.reward" "第 {tier} 级，{name}，{state}"
string "meta.pass.rewards" "赛季奖励"
string "meta.pass.tier" "第 {tier} 级"
string "meta.pass.title" "赛季通行证"
string "meta.rarity.common" "普通"
string "meta.rarity.epic" "史诗"
string "meta.rarity.legendary" "传说"
string "meta.rarity.mythic" "神话"
string "meta.rarity.rare" "稀有"
string "meta.rarity.uncommon" "优秀"
string "meta.reveal.empty" "这次没有奖励"
string "meta.reveal.open" "打开奖励"
string "meta.reveal.revealing" "正在揭晓奖励…"
string "meta.reveal.reward" "{name}，{rarity}"
string "meta.reveal.skip" "跳过揭晓"
string "meta.reveal.title" "奖励"
