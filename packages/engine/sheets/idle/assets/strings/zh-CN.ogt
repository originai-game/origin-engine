type strings
version 1
---
# The idle kit's strings in Simplified Chinese, as a game ships them, and
# the sheet's own fixture text (src/fixtures.ts keys it sheet.<slug of the
# English>), so the review's zh-CN cells show a localised game.
locale "zh-CN"
string "idle.resources.name" "资源"
string "idle.resources.empty" "还没有资源"
string "idle.resources.loading" "{name}：加载中"
string "idle.resources.full" "已满"
string "idle.resources.perSecond" "+{rate}/秒"
string "idle.resources.perSecondDown" "{rate}/秒"
string "idle.resources.row" "{name}：{amount}"
string "idle.generators.name" "生产者"
string "idle.generators.kicker" "产出"
string "idle.generators.levelName" "{name}，{level} 级"
string "idle.generators.lockedName" "{name}，未解锁：{what}"
string "idle.generators.empty" "还没有可建造的"
string "idle.generators.owned" "×{owned}"
string "idle.generators.auto" "自动"
string "idle.generators.locked" "未解锁"
string "idle.generators.cycle" "周期"
