type project
version 1
---
# The idle components' review sheet: `og ui sheet idle` renders each page
# at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use the
# built-in components by name, as a game does; each screen names its style
# and page. play is the normal page (the resource bar over generators and
# upgrades), reset the prestige and welcome-back panels with long text,
# states every member in every fixture state it declares.
name "Idle kit sheet"
id "idle-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "play-fantasy" "style:fantasy;page:play"
  screen "reset-fantasy" "style:fantasy;page:reset"
  screen "states-fantasy" "style:fantasy;page:states"
}
