type project
version 1
---
name "Profile review"
id "profile-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "profile-default" "state:default"
  screen "profile-private" "state:private"
  screen "profile-pending" "state:pending"
  screen "profile-stress" "state:overflow"
  screen "profile-loading" "state:loading"
  screen "profile-error" "state:error"
  screen "profile-empty" "state:empty"
  screen "profile-no-stats" "state:no-stats"
}
