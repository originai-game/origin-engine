type project
version 1
---
# The world labels' review sheet (nameplates, overhead bars, loot labels,
# interaction prompts, speech bubbles, waypoints, telegraphs, selection
# rings, placement ghosts, path lines) over the approved mockup's sample
# art: `og ui sheet world` renders each page at desktop and phone, 100 % and
# 150 % (docs/ui.md §6.2). scene is the third-person scene, topdown the
# strategy scene, states and marks every member in every fixture state.
name "World components sheet"
id "world-sheet"
engine "0.8.0"
entry "src/main.ts"
profile "3d"
tick 60
seed 1
ui {
  screen "scene-default" "style:default;page:scene"
  screen "topdown-default" "style:default;page:topdown"
  screen "states-default" "style:default;page:states"
  screen "marks-default" "style:default;page:marks"
}
