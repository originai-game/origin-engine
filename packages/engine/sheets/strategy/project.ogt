type project
version 1
---
# The strategy components' review sheet: `og ui sheet strategy` renders each
# page at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use
# the built-in components by name, as a game does; each screen names its
# style and page. field is the normal page (selection, command card and
# production over a bright meadow and a dark forest), defence the stress page
# (an endless wave and a high-tier tower with long names), states every member
# in every fixture state it declares.
name "Strategy kit sheet"
id "strategy-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "field-fantasy" "style:fantasy;page:field"
  screen "defence-fantasy" "style:fantasy;page:defence"
  screen "states-fantasy" "style:fantasy;page:states"
}
