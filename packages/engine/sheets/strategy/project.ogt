type project
version 1
---
# The strategy components' review sheet: `og ui sheet strategy` renders each
# page at desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The pages use
# the built-in components by name, as a game does; each screen names its
# style and page. field is the normal page (the RTS HUD as its approved
# mockup over a battlefield), defence the stress page (an endless wave, an
# overflowing queue and a high-tier tower with long names over the same
# scene), states every member in every fixture state it declares.
name "Strategy kit sheet"
id "strategy-sheet"
engine "0.9.0"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "field-fantasy" "style:fantasy;page:field"
  screen "defence-fantasy" "style:fantasy;page:defence"
  screen "states-fantasy" "style:fantasy;page:states"
  screen "field-default" "style:default;page:field"
  screen "defence-default" "style:default;page:defence"
  screen "states-default" "style:default;page:states"
}
