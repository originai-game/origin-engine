type screen
version 2
---
# Scoreboard (docs/ui.md Appendix B). Held over the match (Tab, the
# pad's View): the score and the time, each team's table of players with
# their values, the local player lit; it takes no input, so play goes on.
#
# Viewmodel: score (as text: 7 - 5), clock (seconds), map. Events: none
# (code pushes it while the key is held and pops it on release). Slots:
# Board takes shooter.scoreboard (the teams in their colours, the rows,
# the dead, ping bars, the MVP); Extra takes the match's own row
# (objectives held, sports.matchStats).
name "scoreboard"
layer hud
props {
  score string "The score, as text."
  clock number "Seconds left (or played)."
  map string "The map's name."
}
fixture default "{\"score\": \"7 - 5\", \"clock\": 412, \"map\": \"Harbour\"}"
column Scoreboard {
  width: stretch
  height: stretch
  padding: 48px
  justify-content: center
  align-items: center
  @media phone {
    padding: 12px
  }
  @media phone-landscape {
    padding: 8px 52px
  }
  column Panel {
    width: stretch; max-width: 1100px
    gap: 8px
    row Head {
      width: stretch
      gap: 16px
      align-items: center
      label Map {
        text bind map
        color: var(--ink-muted)
      }
      spacer
      label Score {
        text bind score
        font: var(--text-xl2)
        heading true
      }
      spacer
      label Clock {
        text bind clock clock
        font: var(--text-lg)
      }
    }
    slot Board {
      width: stretch
    }
    slot Extra {
      width: stretch
    }
  }
}
