type project
version 1
---
# The shooter kit's review sheet: `og ui sheet shooter` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §17.3). Every page sets
# its own style and state.
name "Shooter kit sheet"
id "shooter-sheet"
engine "0.7.7"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "hud-scifi" "style:scifi;page:hud"
  screen "hud-pixel" "style:pixel;page:hud"
  screen "scoreboard-scifi" "style:scifi;page:scoreboard"
  screen "scoreboard-fantasy" "style:fantasy;page:scoreboard"
  screen "loadout-scifi" "style:scifi;page:loadout"
  screen "loadout-cartoon" "style:cartoon;page:loadout"
}
