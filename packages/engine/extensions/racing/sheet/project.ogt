type project
version 1
---
# The racing kit's review sheet: `og ui sheet racing` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §17.3). Every page sets
# its own style and state.
name "Racing kit sheet"
id "racing-sheet"
engine "0.7.7"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "hud-scifi" "style:scifi;page:hud"
  screen "hud-fantasy" "style:fantasy;page:hud"
  screen "arcade-cartoon" "style:cartoon;page:arcade"
  screen "hud-pixel" "style:pixel;page:hud"
  screen "garage-scifi" "style:scifi;page:garage"
  screen "garage-cartoon" "style:cartoon;page:garage"
}
