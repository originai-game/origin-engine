type screen
version 2
---
# A race's results (Forza, Gran Turismo, Mario Kart): the finishing place
# over the field, the player's best lap and points, the classification
# with each driver's time, gap and points, the rewards, and Continue,
# Restart and Replay.
#
# The classification is the document's own rows: a game that shows another
# figure (a car, a fastest-lap mark, a rating change) adds a field to its
# rows and a label bound to it under Classification/Row, and a column
# heading under Classification/Head (a phone shows the time under the
# driver, Classification/Row/Who/TimeUnder, and hides Gap and Points); a game that shows the podium in 3D
# fills the Podium slot instead.
#
# Viewmodel: title, place, field, bestLap, points, rows ({ place, name,
# time, gap, points, player }), rewards ({ name, amount }). Events to code:
# continue, restart, replay. Slots: Podium takes the game's podium or
# celebration (og.ui.celebration, a 3D podium's render target).
name "race-results"
layer menu
under hide
back none
focus "Panel/Footer/Continue"
props {
  title string "The result's line (Victory, Race complete)."
  place number "The player's finishing place."
  field number "How many drivers finished."
  bestLap string "The player's best lap, as the game formats it (1:32.418)."
  points number "The points the player scored."
  rows list "The classification: { place, name, time, gap, points, player }."
  rewards list "The rewards: { name, amount }."
}
parts frame place row
actions {
  confirm "Continue"
}
timeline land {
  track "Panel/Page/Head/Place" scale {
    key 0 1.8
    key 260 0.94 out
    key 420 1 out
  }
  event 0 "" sound reward
}
fixture default "{\"title\": \"Victory\", \"place\": 1, \"field\": 8, \"bestLap\": \"1:32.418\", \"points\": 25, \"rows\": [{\"place\": 1, \"name\": \"You\", \"time\": \"14:02.311\", \"gap\": \"\", \"points\": 25, \"player\": true}, {\"place\": 2, \"name\": \"M. Okafor\", \"time\": \"14:03.515\", \"gap\": \"+1.204\", \"points\": 18, \"player\": false}, {\"place\": 3, \"name\": \"L. Varga\", \"time\": \"14:05.002\", \"gap\": \"+2.691\", \"points\": 15, \"player\": false}, {\"place\": 4, \"name\": \"S. Ishikawa\", \"time\": \"14:09.870\", \"gap\": \"+7.559\", \"points\": 12, \"player\": false}, {\"place\": 5, \"name\": \"R. Delacroix\", \"time\": \"14:12.144\", \"gap\": \"+9.833\", \"points\": 10, \"player\": false}, {\"place\": 6, \"name\": \"A. Lindqvist\", \"time\": \"14:20.660\", \"gap\": \"+18.349\", \"points\": 8, \"player\": false}, {\"place\": 7, \"name\": \"J. Moreno\", \"time\": \"14:31.007\", \"gap\": \"+28.696\", \"points\": 6, \"player\": false}, {\"place\": 8, \"name\": \"K. Brandt\", \"time\": \"DNF\", \"gap\": \"\", \"points\": 0, \"player\": false}], \"rewards\": [{\"name\": \"Credits\", \"amount\": 12500}, {\"name\": \"Driver XP\", \"amount\": 840}]}"
column Results {
  width: stretch
  height: stretch
  background: var(--backdrop)
  padding: 32px
  justify-content: center
  align-items: center
  @media phone {
    padding: 12px
  }
  column Panel {
    width: stretch; max-width: 920px
    height: stretch; max-height: 860px
    padding: 24px
    gap: 16px
    background: var(--panel)
    -og-frame: panel
    part frame
    on appear play land
    @media phone {
      padding: 16px
      gap: 12px
    }
    scroll Page {
      width: stretch
      height: stretch
      gap: 16px
      @media phone {
        gap: 12px
      }
      row Head {
        width: stretch
        gap: 20px
        align-items: center
        label Place {
          text "P{place}"
          font: var(--text-display-lg)
          font-family: var(--font-display)
          color: var(--gold)
          part place
          @media phone {
            font: var(--text-xl5)
          }
        }
        column Text {
          width: stretch
          gap: 4px
          label Title {
            text bind title
            font: var(--text-xl3)
            heading true
            @media phone {
              font: var(--text-xl2)
            }
          }
          label Field {
            text "{place, ordinal} of {field}"
            color: var(--ink-muted)
          }
        }
      }
      row Summary {
        width: stretch
        gap: 24px
        flex-wrap: wrap
        column BestLap {
          gap: 2px
          label Name {
            key "screen.raceResults.bestLap"
            text "Best lap"
            font: var(--text-caption)
            color: var(--ink-muted)
          }
          label Value {
            text bind bestLap
            font: var(--text-lg)
            font-family: var(--font-mono)
          }
        }
        column Points {
          gap: 2px
          label Name {
            key "screen.raceResults.points"
            text "Points"
            font: var(--text-caption)
            color: var(--ink-muted)
          }
          label Value {
            text "+{points, grouped}"
            font: var(--text-lg)
          }
        }
      }
      slot Podium {
        width: stretch
      }
      column Classification {
        width: stretch
        gap: 4px
        row Head {
          width: stretch
          gap: 12px
          padding: 4px 8px
          label Place {
            key "screen.raceResults.pos"
            text "Pos"
            font: var(--text-caption)
            color: var(--ink-muted)
            white-space: nowrap
            width: 40px
            @media phone {
              width: 44px
            }
          }
          label Driver {
            key "screen.raceResults.driver"
            text "Driver"
            font: var(--text-caption)
            color: var(--ink-muted)
            width: stretch
          }
          label Time {
            key "screen.raceResults.time"
            text "Time"
            font: var(--text-caption)
            color: var(--ink-muted)
            width: 110px
            text-align: end
            @media phone {
              visible false
            }
          }
          label Gap {
            key "screen.raceResults.gap"
            text "Gap"
            font: var(--text-caption)
            color: var(--ink-muted)
            width: 110px
            text-align: end
            @media phone {
              visible false
            }
          }
          label Points {
            key "screen.raceResults.pts"
            text "Pts"
            font: var(--text-caption)
            color: var(--ink-muted)
            width: 48px
            text-align: end
            @media phone {
              visible false
            }
          }
        }
        for row in rows {
          row Row {
            width: stretch
            gap: 12px
            padding: 10px 8px
            align-items: center
            border-radius: 6px
            part row
            state player bind row.player {
              other {
                background: var(--panel-raised)
              }
              you {
                background: var(--primary-soft)
              }
            }
            label Place {
              text bind row.place
              font-family: var(--font-display)
              width: 40px
              @media phone {
                width: 44px
              }
            }
            column Who {
              width: stretch
              gap: 2px
              label Driver {
                text bind row.name
                width: stretch
                line-clamp: 1
                text-overflow: ellipsis
              }
              label TimeUnder {
                text bind row.time
                font-family: var(--font-mono)
                color: var(--ink-muted)
                visible false
                @media phone {
                  visible true
                }
              }
            }
            label Time {
              text bind row.time
              font-family: var(--font-mono)
              white-space: nowrap
              width: 110px
              text-align: end
              @media phone {
                visible false
              }
            }
            label Gap {
              text bind row.gap
              font-family: var(--font-mono)
              white-space: nowrap
              color: var(--ink-muted)
              width: 110px
              text-align: end
              @media phone {
                visible false
              }
            }
            label Points {
              text bind row.points
              width: 48px
              text-align: end
              @media phone {
                visible false
              }
            }
          }
        }
      }
      row Rewards {
        width: stretch
        gap: 12px
        flex-wrap: wrap
        for reward in rewards {
          badge Reward {
            text "+{reward.amount, grouped} {reward.name}"
            tone accent
          }
        }
      }
    }
    row Footer {
      width: stretch
      gap: 12px
      justify-content: end
      flex-wrap: wrap
      button Replay {
        key "screen.raceResults.replay"
        text "Replay"
        variant ghost
        on click emit replay
      }
      button Restart {
        key "screen.raceResults.restart"
        text "Restart"
        variant secondary
        on click emit restart
      }
      button Continue {
        key "screen.common.continue"
        text "Continue"
        variant primary
        on click emit continue
        on action confirm emit continue
      }
    }
  }
}
