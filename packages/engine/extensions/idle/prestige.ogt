type screen
version 2
---
# Prestige and meta-progression hub (docs/ui.md Appendix B). The reset
# itself and what it gives, the meta currency, the permanent upgrades it
# buys, and the run's records.
#
# Viewmodel: currency (the meta currency held), name (its name), upgrades,
# runs, best. Events to code: buy (the click wrote buying: the upgrade's
# index) (Back pops it). Slots: Prestige takes idle.prestigePanel (the emblem, the
# reward, what a reset does and its hold-to-confirm; it answers the
# reset); Records takes the run's numbers (og.ui.keyValueRows).
name "prestige"
layer menu
focus "Body/Prestige"
props {
  currency number "The meta currency held (past 1e308: { m, e })."
  name string "Its name (Angels, Heavenly chips)."
  upgrades list "The permanent upgrades: { name, text, level, cost, afford (bool) }."
  buying number "The upgrade bought last."
  runs number "Resets so far."
  best number "The best run's earnings."
}
actions {
  back "Back"
}
fixture default "{\"currency\": 1.5e12, \"name\": \"Angels\", \"upgrades\": [{\"name\": \"Blessed hands\", \"text\": \"Clicks earn 2× per level.\", \"level\": 3, \"cost\": 2.5e11, \"afford\": true}, {\"name\": \"Choir\", \"text\": \"Generators start at level 10.\", \"level\": 0, \"cost\": 4e12, \"afford\": false}], \"buying\": -1, \"runs\": 12, \"best\": 8.2e15}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.prestige.title"
      text "Prestige"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Currency {
      text "{currency, letters} {name}"
      font: var(--text-lg)
      color: var(--gold)
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 1fr 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: auto 1fr
      gap: 12px
    }
    column Left {
      width: stretch
      gap: 12px
      slot Prestige {
        width: stretch
      }
      label Runs {
        text "{runs} resets · best {best, letters}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      slot Records {
        width: stretch
      }
    }
    scroll Upgrades {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 8px
        for u in upgrades {
          row Upgrade {
            width: stretch
            padding: 10px
            gap: 12px
            align-items: center
            background: var(--panel-raised)
            -og-frame: card
            column Text {
              width: stretch
              gap: 2px
              label Name {
                text "{u.name} · {u.level}"
                font: var(--text-lg)
              }
              label Line {
                text bind u.text
                color: var(--ink-muted)
                line-clamp: 2
              }
            }
            button Buy {
              text bind u.cost letters
              size small
              @media phone {
                size medium
              }
              disabled bind "!u.afford"
              on click set buying "$index"
              on click emit buy
            }
          }
        }
      }
    }
  }
}
