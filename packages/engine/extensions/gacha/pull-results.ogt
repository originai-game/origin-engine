type screen
version 2
---
# Pull results and pack opening (docs/ui.md Appendix B: gacha banner and
# pull results; pack opening). Over everything: the charge, each result
# revealed in its tier's colour, then the summary of every result with
# Pull again and Done.
#
# Viewmodel: count (results in the pull), again (the price of another
# pull, text), canAgain. Events to code: again, done (also Back once the
# summary shows). Slots: Sequence takes gacha.pullSequence (charge, reveal
# and summary, its own Skip; it answers when it reaches the summary and
# when Again or Done is pressed). For a pack opening, the same sequence
# with cards (art kind card) or card.rewardChoice when the player keeps
# some.
name "pull-results"
layer modal
under hide
back emit done
props {
  count number "How many results the pull gave."
  again string "Another pull's price, as text (10 × 160)."
  canAgain bool "The player can pay for another."
}
actions {
  confirm "Next"
  back "Done"
}
fixture default "{\"count\": 10, \"again\": \"10 × 160\", \"canAgain\": true}"
stack Results {
  width: stretch
  height: stretch
  background: var(--backdrop)
  slot Sequence {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  row Bar {
    position: absolute
    inset-inline-start: 24px
    inset-inline-end: 24px
    bottom: 24px
    gap: 12px
    justify-content: end
    @media phone {
      inset-inline-start: 12px
      inset-inline-end: 12px
      bottom: 12px
    }
    label Count {
      text "{count, plural, one {# result} other {# results}}"
      font: var(--text-caption)
      color: var(--ink-muted)
    }
    spacer
    button Again {
      text "Again · {again}"
      disabled bind "!canAgain"
      on click emit again
    }
    button Done {
      key "screen.pull-results.done"
      text "Done"
      variant primary
      on click emit done
    }
  }
}
