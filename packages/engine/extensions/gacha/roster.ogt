type screen
version 2
---
# Roster and team builder (docs/ui.md Appendix B: roster, team builder,
# character detail and ascension). The owned characters as portrait tiles
# with their level, stars and element, sorted and filtered; the team's
# slots at the head, filled by a press or a drag. character-detail is the
# one character's page.
#
# Viewmodel: team (the slots: { name, texture, empty }), units, sort,
# power. Events to code: open (the click wrote selected: push
# character-detail), slot (the team slot pressed: the click wrote slot),
# sort, auto (fill the team) (Back pops it). Slots: Filters takes og.ui.segmented
# or og.ui.dropdown for element, role and rarity.
name "roster"
layer menu
focus "Body/Grid"
props {
  team list "The team's slots: { name, texture, empty (bool) }."
  slot number "The team slot pressed last."
  units list "The owned characters: { name, level, stars, element, texture, inTeam (bool) }."
  selected number "The character pressed last."
  sort string "What the list is sorted by, as text."
  power number "The team's power."
}
actions {
  confirm "Select"
  back "Back"
  details "Details"
}
fixture default "{\"team\": [{\"name\": \"Aria\", \"texture\": 0, \"empty\": false}, {\"name\": \"Kael\", \"texture\": 0, \"empty\": false}, {\"name\": \"\", \"texture\": 0, \"empty\": true}, {\"name\": \"\", \"texture\": 0, \"empty\": true}], \"slot\": 0, \"units\": [{\"name\": \"Aria\", \"level\": 60, \"stars\": 5, \"element\": \"Fire\", \"texture\": 0, \"inTeam\": true}, {\"name\": \"Kael\", \"level\": 52, \"stars\": 4, \"element\": \"Ice\", \"texture\": 0, \"inTeam\": true}, {\"name\": \"Juno\", \"level\": 40, \"stars\": 4, \"element\": \"Wind\", \"texture\": 0, \"inTeam\": false}, {\"name\": \"Pell\", \"level\": 12, \"stars\": 3, \"element\": \"Earth\", \"texture\": 0, \"inTeam\": false}], \"selected\": 0, \"sort\": \"Level\", \"power\": 48210}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.roster.title"
      text "Team"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Power {
      text "Power {power, grouped}"
      font: var(--text-lg)
    }
  }
  row Team {
    width: stretch
    gap: 12px
    focusGroup wrap
    for t in team {
      column Slot {
        width: stretch; max-width: 160px
        gap: 4px
        padding: 6px
        align-items: center
        -og-frame: slot
        interactive true
        focusable true
        on click set slot "$index"
        on click emit slot
        art Art {
          kind bust
          width: stretch
          texture bind t.texture
          visible bind "!t.empty"
        }
        label Empty {
          key "screen.roster.empty"
          text "Empty"
          color: var(--ink-muted)
          visible bind t.empty
        }
        label Name {
          text bind t.name
          font: var(--text-caption)
          line-clamp: 1
          text-overflow: ellipsis
        }
        :hover {
          scale: 1.03
        }
        :active {
          scale: 0.97
        }
        :focus-visible {
          scale: 1.03
        }
        -og-state-transition: var(--motion-ui)
      }
    }
  }
  row Tools {
    width: stretch
    gap: 8px
    align-items: center
    flex-wrap: wrap
    slot Filters {
    }
    spacer
    button Sort {
      text "Sort: {sort}"
      size small
      @media phone {
        size medium
      }
      on click emit sort
    }
    button Auto {
      key "screen.roster.auto"
      text "Auto"
      size small
      @media phone {
        size medium
      }
      on click emit auto
    }
  }
  scroll Body {
    width: stretch
    height: stretch
    grid Grid {
      width: stretch
      gap: 10px
      grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr
      focusGroup wrap
      @media tablet {
        grid-template-columns: 1fr 1fr 1fr 1fr
      }
      @media phone-portrait {
        grid-template-columns: 1fr 1fr 1fr
        gap: 6px
      }
      for u in units {
        column Unit {
          width: stretch
          gap: 2px
          padding: 4px
          background: var(--panel-raised)
          -og-frame: card
          interactive true
          focusable true
          on click set selected "$index"
          on click emit open
          art Art {
            kind bust
            width: stretch
            texture bind u.texture
          }
          label Name {
            text bind u.name
            font: var(--text-caption)
            line-clamp: 1
            text-overflow: ellipsis
          }
          label Meta {
            text "Lv {u.level} · {u.stars, plural, one {# star} other {# stars}}"
            font: var(--text-caption)
            color: var(--ink-muted)
            line-clamp: 1
          }
          badge InTeam {
            key "screen.roster.inTeam"
            text "In team"
            tone info
            visible bind u.inTeam
          }
          :hover {
            scale: 1.03
          }
          :active {
            scale: 0.97
          }
          :focus-visible {
            scale: 1.03
          }
          -og-state-transition: var(--motion-ui)
        }
      }
    }
  }
}
