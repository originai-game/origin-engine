type ui-material
version 1
---
# Holo: a rainbow that sweeps across the art in diagonal bands and drifts
# with the clock, laid over the art's lightness (the holographic and
# polychrome editions of deck-builders and gacha cards).
source "holo.wgsl"
# How much of the rainbow shows, 0–1.
param amount float 0.5
# One cycle of the rainbow, CSS px.
param scale float 160
# Its drift, cycles a second.
param speed float 0.08
# Its saturation, 0–1.
param saturation float 0.8
