type project
version 1
---
# The materials kit's review sheet: `og ui sheet materials` renders each
# page at desktop and phone, 100 % and 150 % (docs/ui.md §17.3): one card
# per preset, over the style's plain ground, at fixed parameters.
name "Materials kit sheet"
id "materials-sheet"
engine "0.7.7"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "cards-fantasy" "style:fantasy"
  screen "cards-scifi" "style:scifi"
}
