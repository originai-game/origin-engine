type screen
version 2
---
# Missions and events hub (docs/ui.md Appendix B: daily login, missions,
# events hub). The live events as banners with their time left, and the
# daily and weekly missions with their progress and rewards; Claim on the
# finished ones, Claim all at the head.
#
# Viewmodel: events, tab, missions, resets (seconds). Events to code:
# event (the click wrote event: code opens it), tab, claim (the click
# wrote claiming: the mission's index), claimAll (Back pops it). Slots: Featured
# takes the first event's own panel (og.ui.banner, og.ui.carousel of
# event art); Points takes a points track (puzzle.goalChips,
# og.ui.progressBar with milestones).
name "events-hub"
layer menu
focus "Body/Missions/List"
props {
  events list "The live events: { name, ends (seconds), texture, fresh (bool) }."
  event number "The event pressed last."
  tab string "daily or weekly."
  missions list "The tab's missions: { name, done, goal, reward, claimed (bool) }."
  claiming number "The mission whose Claim was pressed."
  resets number "Seconds until the tab's missions reset."
}
actions {
  confirm "Select"
  back "Back"
}
fixture default "{\"events\": [{\"name\": \"Harvest festival\", \"ends\": 432000, \"texture\": 0, \"fresh\": true}, {\"name\": \"Double XP weekend\", \"ends\": 86400, \"texture\": 0, \"fresh\": false}], \"event\": 0, \"tab\": \"daily\", \"missions\": [{\"name\": \"Win 3 matches\", \"done\": 3, \"goal\": 3, \"reward\": \"50 gems\", \"claimed\": false}, {\"name\": \"Collect 500 gold\", \"done\": 320, \"goal\": 500, \"reward\": \"1 ticket\", \"claimed\": false}, {\"name\": \"Log in\", \"done\": 1, \"goal\": 1, \"reward\": \"100 gold\", \"claimed\": true}], \"claiming\": -1, \"resets\": 39600}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.events-hub.title"
      text "Events"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    button ClaimAll {
      key "screen.events-hub.claimAll"
      text "Claim all"
      variant primary
      size small
      @media phone {
        size medium
      }
      on click emit claimAll
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 1fr 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: auto 1fr
      gap: 12px
    }
    scroll Events {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 12px
        slot Featured {
          width: stretch
        }
        for e in events {
          stack Event {
            width: stretch
            interactive true
            focusable true
            on click set event "$index"
            on click emit event
            art Art {
              kind banner
              width: stretch
              texture bind e.texture
            }
            row Plate {
              position: absolute
              inset-inline-start: 0
              inset-inline-end: 0
              bottom: 0
              padding: 12px
              gap: 8px
              align-items: center
              background: var(--scrim)
              label Name {
                text bind e.name
                font: var(--text-lg)
                width: stretch
                line-clamp: 1
                text-overflow: ellipsis
              }
              badge New {
                key "screen.common.new"
                text "New"
                tone accent
                visible bind e.fresh
              }
              label Ends {
                text "{e.ends, duration}"
                font: var(--text-caption)
              }
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    column Missions {
      width: stretch
      height: stretch
      gap: 8px
      row Tabs {
        width: stretch
        gap: 6px
        align-items: center
        button Daily {
          key "screen.events-hub.daily"
          text "Daily"
          variant ghost
          on click set tab "\"daily\""
          state selection bind "tab == \"daily\"" {
            off {
              opacity: 0.85
            }
            on {
              opacity: 1
            }
          }
        }
        button Weekly {
          key "screen.events-hub.weekly"
          text "Weekly"
          variant ghost
          on click set tab "\"weekly\""
          state selection bind "tab == \"weekly\"" {
            off {
              opacity: 0.85
            }
            on {
              opacity: 1
            }
          }
        }
        spacer
        label Resets {
          text "{resets, countdown}"
          font: var(--text-caption)
          color: var(--ink-muted)
        }
      }
      slot Points {
        width: stretch
      }
      scroll MissionScroll {
        width: stretch
        height: stretch
        column List {
          width: stretch
          gap: 6px
          for m in missions {
            row Mission {
              width: stretch
              padding: 10px
              gap: 12px
              align-items: center
              background: var(--panel-raised)
              -og-frame: card
              column Text {
                width: stretch
                gap: 4px
                label Name {
                  text bind m.name
                  line-clamp: 2
                }
                progress Bar {
                  width: stretch
                  value bind "m.done / m.goal"
                }
                label Count {
                  text "{m.done, grouped}/{m.goal, grouped} · {m.reward}"
                  font: var(--text-caption)
                  color: var(--ink-muted)
                }
              }
              button Claim {
                key "screen.events-hub.claim"
                text "Claim"
                variant primary
                size small
                @media phone {
                  size medium
                }
                visible bind "m.done >= m.goal && !m.claimed"
                on click set claiming "$index"
                on click emit claim
              }
              badge Claimed {
                key "screen.events-hub.claimed"
                text "Claimed"
                tone success
                visible bind m.claimed
              }
            }
          }
        }
      }
    }
  }
}
