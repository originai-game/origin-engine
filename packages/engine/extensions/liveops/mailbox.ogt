type screen
version 2
---
# Mailbox (docs/ui.md Appendix B). The letters, unread first, each its
# sender, subject, expiry and an attachment mark; the selected letter's
# body and attachments with Collect; Collect all and Delete read.
#
# Viewmodel: mails, selected, mail (the selected one's body and
# attachments). Events to code: select (the click wrote selected),
# collect, collectAll, deleteRead (Back pops it). Slots: Attachments takes the
# attachments' tiles when they need more than the list below (og.ui.card).
name "mailbox"
layer menu
focus "Body/Mails/List"
props {
  mails list "The letters: { from, subject, expires (seconds, 0: never), unread (bool), gift (bool) }."
  selected number "The selected letter's index."
  mail object "The selected letter: { from, subject, body, collected (bool), gifts: [{ name, amount, texture }] }."
}
actions {
  confirm "Collect"
  back "Back"
}
fixture default "{\"mails\": [{\"from\": \"The Guild\", \"subject\": \"Your weekly stipend\", \"expires\": 518400, \"unread\": true, \"gift\": true}, {\"from\": \"Support\", \"subject\": \"Sorry for the downtime\", \"expires\": 0, \"unread\": false, \"gift\": true}], \"selected\": 0, \"mail\": {\"from\": \"The Guild\", \"subject\": \"Your weekly stipend\", \"body\": \"For your service this week, adventurer.\", \"collected\": false, \"gifts\": [{\"name\": \"Gold\", \"amount\": 2000, \"texture\": 0}, {\"name\": \"Gems\", \"amount\": 30, \"texture\": 0}]}}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.mailbox.title"
      text "Mail"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    button DeleteRead {
      key "screen.mailbox.deleteRead"
      text "Delete read"
      variant quiet
      size small
      @media phone {
        size medium
      }
      on click emit deleteRead
    }
    button CollectAll {
      key "screen.mailbox.collectAll"
      text "Collect all"
      variant primary
      size small
      @media phone {
        size medium
      }
      on click emit collectAll
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 2fr 3fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    scroll Mails {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 4px
        focusGroup stop
        for m in mails {
          row Mail {
            width: stretch
            padding: 10px
            gap: 10px
            align-items: center
            border-radius: 8px
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            column Text {
              width: stretch
              gap: 2px
              label From {
                text bind m.from
                font: var(--text-caption)
                color: var(--ink-muted)
              }
              label Subject {
                text bind m.subject
                line-clamp: 1
                text-overflow: ellipsis
              }
            }
            icon Gift {
              icon gem
              iconSize 20
              visible bind m.gift
            }
            label Expires {
              text "{m.expires, duration}"
              font: var(--text-caption)
              color: var(--warn)
              visible bind "m.expires > 0"
            }
            state selection bind "$index == selected" {
              off {
                background: var(--panel)
              }
              on {
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            state read bind m.unread {
              read {
                opacity: 0.7
              }
              unread {
                opacity: 1
              }
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    column Letter {
      width: stretch
      padding: 16px
      gap: 10px
      background: var(--panel)
      -og-frame: panel
      visible bind "mails.length > 0"
      label Subject {
        text bind mail.subject
        font: var(--text-lg)
        heading true
      }
      label From {
        text bind mail.from
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      label Body {
        text bind mail.body
        font: var(--text-reading)
      }
      row Gifts {
        width: stretch
        gap: 8px
        flex-wrap: wrap
        for g in mail.gifts {
          column Gift {
            padding: 8px
            gap: 4px
            align-items: center
            background: var(--panel-raised)
            -og-frame: card
            art Art {
              kind itemIcon
              width: 48px
              height: 48px
              texture bind g.texture
            }
            label Amount {
              text "{g.name} ×{g.amount, compact}"
              font: var(--text-caption)
            }
          }
        }
      }
      slot Attachments {
        width: stretch
      }
      button Collect {
        key "screen.mailbox.collect"
        text "Collect"
        variant primary
        disabled bind mail.collected
        on click emit collect
      }
    }
  }
}
