type screen
version 1
---
# Mailbox (docs/ui.md Appendix B). The letters, unread first, each its
# sender, subject, expiry and an attachment mark; the selected letter's
# body and attachments with Collect; Collect all and Delete read.
#
# Viewmodel: mails, selected, mail (the selected one's body and
# attachments). Events to code: select (the click wrote selected),
# collect, collectAll, deleteRead (Back pops it). Slots: Attachments takes the
# attachments' tiles when they need more than the list below (og.ui.card).
name "mailbox"
layer menu
focus "Body/Mails/List"
props {
  mails list "The letters: { from, subject, expires (seconds, 0: never), unread (bool), gift (bool) }."
  selected number "The selected letter's index."
  mail object "The selected letter: { from, subject, body, collected (bool), gifts: [{ name, amount, texture }] }."
}
actions {
  confirm "Collect"
  back "Back"
}
fixture default "{\"mails\": [{\"from\": \"The Guild\", \"subject\": \"Your weekly stipend\", \"expires\": 518400, \"unread\": true, \"gift\": true}, {\"from\": \"Support\", \"subject\": \"Sorry for the downtime\", \"expires\": 0, \"unread\": false, \"gift\": true}], \"selected\": 0, \"mail\": {\"from\": \"The Guild\", \"subject\": \"Your weekly stipend\", \"body\": \"For your service this week, adventurer.\", \"collected\": false, \"gifts\": [{\"name\": \"Gold\", \"amount\": 2000, \"texture\": 0}, {\"name\": \"Gems\", \"amount\": 30, \"texture\": 0}]}}"
column Screen {
  width grow
  height grow
  padding 32
  gap 12
  at phone {
    padding 16
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.mailbox.title"
      text "Mail"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    spacer
    button DeleteRead {
      key "screen.mailbox.deleteRead"
      text "Delete read"
      variant quiet
      size small
      at phone {
        size medium
      }
      on click emit deleteRead
    }
    button CollectAll {
      key "screen.mailbox.collectAll"
      text "Collect all"
      variant primary
      size small
      at phone {
        size medium
      }
      on click emit collectAll
    }
  }
  grid Body {
    width grow
    height grow
    gap 24
    columns "2fr" "3fr"
    rows "1fr"
    at phonePortrait {
      columns "1fr"
      rows "1fr" auto
      gap 12
    }
    scroll Mails {
      width grow
      height grow
      column List {
        width grow
        gap 4
        focusGroup stop
        for m in mails {
          row Mail {
            width grow
            padding 10
            gap 10
            cross center
            radius 8
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            column Text {
              width grow
              gap 2
              label From {
                text bind m.from
                step caption
                color token inkMuted
              }
              label Subject {
                text bind m.subject
                maxLines 1
                ellipsis true
              }
            }
            icon Gift {
              icon gem
              iconSize 20
              visible bind m.gift
            }
            label Expires {
              text "{m.expires, duration}"
              step caption
              color token warn
              visible bind "m.expires > 0"
            }
            state selection bind "$index == selected" {
              off {
                background token panel
              }
              on {
                background token primarySoft
              }
              transition any any token ui
            }
            state read bind m.unread {
              read {
                opacity 0.7
              }
              unread {
                opacity 1
              }
            }
            state interaction {
              normal {
                scale 1
              }
              hover {
                scale 1.01
              }
              pressed {
                scale 0.99
              }
              focused {
                scale 1.01
              }
              transition any any token ui
            }
          }
        }
      }
    }
    column Letter {
      width grow
      padding 16
      gap 10
      background token panel
      frame panel
      visible bind "mails.length > 0"
      label Subject {
        text bind mail.subject
        step lg
        heading true
      }
      label From {
        text bind mail.from
        step caption
        color token inkMuted
      }
      label Body {
        text bind mail.body
        step reading
      }
      row Gifts {
        width grow
        gap 8
        wrap true
        for g in mail.gifts {
          column Gift {
            padding 8
            gap 4
            cross center
            background token panelRaised
            frame card
            art Art {
              kind itemIcon
              width 48
              height 48
              texture bind g.texture
            }
            label Amount {
              text "{g.name} ×{g.amount, compact}"
              step caption
            }
          }
        }
      }
      slot Attachments {
        width grow
      }
      button Collect {
        key "screen.mailbox.collect"
        text "Collect"
        variant primary
        disabled bind mail.collected
        on click emit collect
      }
    }
  }
}
