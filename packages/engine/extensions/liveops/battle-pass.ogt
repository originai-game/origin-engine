type screen
version 2
---
# Battle pass and season track (docs/ui.md Appendix B). The season's name
# and time left, the level and its XP, the free and premium tracks, and the
# weekly challenges that feed it.
#
# Viewmodel: season, ends (seconds), challenges, tab. Events to code: tab
# (the click wrote tab), claimAll, unlock (Back pops it). Slots: Pass takes
# liveops.battlePass (the header's level and XP, the tiers on both tracks,
# claim and claim all, unlock premium; it answers the reward claimed);
# ChallengeList takes puzzle.goalChips or rpg.questTracker for the weekly
# challenges.
name "battle-pass"
layer menu
focus "Body/Pass"
props {
  season string "The season's name."
  ends number "Seconds until it ends."
  tab string "track or challenges."
}
actions {
  confirm "Claim"
  back "Back"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"season\": \"Season 4 · Tides\", \"ends\": 1814400, \"tab\": \"track\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    column Season {
      gap: 2px
      label Name {
        text bind season
        font: var(--text-xl2)
        heading true
        @media phone {
          font: var(--text-lg)
        }
      }
      label Ends {
        text "Ends in {ends, duration}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
    }
    spacer
    row Tabs {
      gap: 6px
      button Track {
        key "screen.battle-pass.track"
        text "Rewards"
        variant ghost
        on click set tab "\"track\""
        state selection bind "tab == \"track\"" {
          off {
            opacity: 0.85
          }
          on {
            opacity: 1
          }
        }
      }
      button Challenges {
        key "screen.battle-pass.challenges"
        text "Challenges"
        variant ghost
        on click set tab "\"challenges\""
        state selection bind "tab == \"challenges\"" {
          off {
            opacity: 0.85
          }
          on {
            opacity: 1
          }
        }
      }
    }
  }
  column Body {
    width: stretch
    height: stretch
    slot Pass {
      width: stretch
      height: stretch
      visible bind "tab == \"track\""
    }
    scroll ChallengeScroll {
      width: stretch
      height: stretch
      visible bind "tab == \"challenges\""
      slot ChallengeList {
        width: stretch
      }
    }
  }
}
