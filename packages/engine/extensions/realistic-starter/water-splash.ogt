type vfx
version 2
---
# Something striking water, realistic: a crown of droplets, a spray column, mist and spreading rings. The water's surface is the effect's origin: spawn it where the thing went in.
duration 1.6
impact 0
emitter "vfx/realistic-starter/water-splash/drops.emitter.ogt" {
  at 0
}
emitter "vfx/realistic-starter/water-splash/spray.emitter.ogt" {
  at 0
}
emitter "vfx/realistic-starter/water-splash/mist.emitter.ogt" {
  at 0
  offset 0 0.25 0
}
emitter "vfx/realistic-starter/water-splash/ripple.emitter.ogt" {
  at 0
  offset 0 0.01 0
}
