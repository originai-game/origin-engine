type vfx
version 2
---
# A bullet striking a hard surface, realistic: sparks, chips, a dust puff and the mark. The surface's normal is the effect's +y: spawn it at the hit turned to the normal.
duration 1.8
impact 0
emitter "vfx/realistic-starter/bullet-impact/sparks.emitter.ogt" {
  at 0
}
emitter "vfx/realistic-starter/bullet-impact/chips.emitter.ogt" {
  at 0
}
emitter "vfx/realistic-starter/bullet-impact/dust.emitter.ogt" {
  at 0
}
emitter "vfx/realistic-starter/bullet-impact/mark.emitter.ogt" {
  at 0
  offset 0 0.004 0
}
glow {
  at 0
  life 0.05
  offset 0 0.04 0
  size curve 0 0.14 1 0.2
  color 2.4 1.5 0.7
}
light {
  at 0
  life 0.08
  offset 0 0.1 0
  color 1 0.7 0.4
  intensity curve 0 1.5 1 0
  distance 2
}
