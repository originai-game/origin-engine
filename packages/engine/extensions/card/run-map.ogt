type screen
version 2
---
# Run map (docs/ui.md Appendix B: branching nodes). The act's map of
# nodes and paths (fights, elites, shops, rests, events, the boss), the
# player's position and the reachable next nodes, the run's health, gold
# and relics at the head, and the hovered node's legend.
#
# Viewmodel: act, floor, health, maxHealth, gold, hint (what the hovered
# node is). Events to code: deck (open the deck); Back pops it (the map
# opened over a room). Slots: Graph takes og.ui.nodeGraph
# (the nodes by kind and state, the links; it answers the node pressed:
# code moves the run there); Relics takes the relic strip (og.ui.card
# icons with og.ui.tooltipCard); Legend takes the kinds' key.
name "run-map"
layer menu
focus "Body/Graph"
props {
  act string "The act's name."
  floor number "The floor the player is on."
  health number "Health."
  maxHealth number "Its most."
  gold number "Gold."
  hint string "What the node under the pointer or focus is (empty: none)."
}
actions {
  confirm "Travel"
  back "Close"
  details "Deck"
}
fixture default "{\"act\": \"Act I · The Undergrowth\", \"floor\": 6, \"health\": 54, \"maxHealth\": 80, \"gold\": 143, \"hint\": \"Elite: a strong enemy guarding a relic.\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 16px
    align-items: center
    flex-wrap: wrap
    column Act {
      gap: 2px
      label Name {
        text bind act
        font: var(--text-lg)
        heading true
      }
      label Floor {
        text "Floor {floor}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
    }
    spacer
    row Stats {
      gap: 16px
      align-items: center
      row Health {
        gap: 6px
        align-items: center
        icon Heart {
          icon heart
          iconSize 20
          color: var(--health)
        }
        label Value {
          text "{health}/{maxHealth}"
        }
      }
      row Gold {
        gap: 6px
        align-items: center
        icon Coin {
          icon coin
          iconSize 20
          color: var(--gold)
        }
        label Value {
          text bind gold grouped
        }
      }
      button Deck {
        key "screen.run-map.deck"
        text "Deck"
        size small
        @media phone {
          size medium
        }
        on click emit deck
        on action details emit deck
      }
    }
  }
  slot Relics {
    width: stretch
  }
  stack Body {
    width: stretch
    height: stretch
    slot Graph {
      width: stretch
      height: stretch
    }
    column Side {
      position: absolute
      inset-inline-end: 0
      top: 0
      gap: 8px
      @media phone-portrait {
        visible false
      }
      slot Legend {
      }
    }
  }
  label Hint {
    text bind hint
    color: var(--ink-muted)
    line-clamp: 2
    visible bind "hint != \"\""
  }
}
