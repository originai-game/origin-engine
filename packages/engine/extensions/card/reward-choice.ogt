type screen
version 1
---
# Reward choice (docs/ui.md Appendix B: pick N of M). After a fight or at
# a level-up: the rewards dealt as cards, picked one (or N), with Reroll,
# Banish and Skip under them and the counts each has left.
#
# Viewmodel: title, picks (how many to take), rerolls, banishes. Events to
# code: skip. Slots: Choice takes card.rewardChoice (the cards, their
# selection, Reroll, Banish, Skip and Confirm; it answers what was taken,
# rerolled or banished); Context takes what the choice adds to (the deck's
# count, the build so far: og.ui.keyValueRows).
name "reward-choice"
layer modal
under dim
back none
focus "Panel/Choice"
props {
  title string "The heading (Choose a card, Level up!)."
  picks number "How many to take."
  rerolls number "Rerolls left."
  banishes number "Banishes left."
}
actions {
  confirm "Take"
  details "Inspect"
}
fixture default "{\"title\": \"Choose a reward\", \"picks\": 1, \"rerolls\": 2, \"banishes\": 1}"
column Reward {
  width grow
  height grow
  padding 32
  gap 16
  align center
  cross center
  at phone {
    padding 12
  }
  column Panel {
    width grow 0 1080
    gap 16
    cross center
    enter fade
    label Title {
      text bind title
      step xl3
      heading true
      textAlign center
      at phone {
        step xl
      }
    }
    label Picks {
      text "{picks, plural, one {Take one} other {Take #}}"
      color token inkMuted
    }
    slot Choice {
      width grow
    }
    slot Context {
      width grow
    }
    row Counts {
      gap 16
      label Rerolls {
        text "{rerolls, plural, one {# reroll} other {# rerolls}} left"
        step caption
        color token inkMuted
      }
      label Banishes {
        text "{banishes, plural, one {# banish} other {# banishes}} left"
        step caption
        color token inkMuted
      }
    }
  }
}
