type screen
version 2
---
# Diplomacy and trade (docs/ui.md Appendix B). The other powers with
# their leader, attitude and treaties; the selected one's page: what they
# think of the player and why, the actions (declare war, alliance, open
# borders), and the trade table, each side's offer with the deal's
# acceptance.
#
# Viewmodel: powers, selected, power (the selected one's page), mine and
# theirs (the offers), acceptance (-1 to 1). Events to code: select (the
# click wrote selected), action (the click wrote acting: the action's
# index), propose, clearDeal (Back pops it). Slots: Leader takes the leader's
# portrait or a scene (og.ui.viewport); Offers takes the items to add to
# the deal (og.ui.dataList, drag into the offers below).
name "diplomacy"
layer menu
pause true
focus "Body/Powers/List"
props {
  powers list "The powers met: { name, attitude (as text), war (bool), texture }."
  selected number "The selected power's index."
  power object "The selected power: { name, leader, reasons: [{ text, value }], actions: [{ name, enabled }] }."
  acting number "The action pressed last."
  mine list "What the player offers: { name }."
  theirs list "What they offer: { name }."
  acceptance number "How they take the deal, -1 (refuse) to 1 (gladly)."
}
actions {
  confirm "Select"
  back "Close"
}
fixture default "{\"powers\": [{\"name\": \"Aurelian Empire\", \"attitude\": \"Friendly\", \"war\": false, \"texture\": 0}, {\"name\": \"Free Cities\", \"attitude\": \"Wary\", \"war\": false, \"texture\": 0}, {\"name\": \"Ashen Horde\", \"attitude\": \"Hostile\", \"war\": true, \"texture\": 0}], \"selected\": 0, \"power\": {\"name\": \"Aurelian Empire\", \"leader\": \"Empress Livia\", \"reasons\": [{\"text\": \"Trade partners\", \"value\": 12}, {\"text\": \"Border tension\", \"value\": -4}], \"actions\": [{\"name\": \"Propose alliance\", \"enabled\": true}, {\"name\": \"Open borders\", \"enabled\": true}, {\"name\": \"Declare war\", \"enabled\": true}]}, \"acting\": -1, \"mine\": [{\"name\": \"200 gold\"}], \"theirs\": [{\"name\": \"Iron (10 turns)\"}], \"acceptance\": 0.3}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.diplomacy.title"
      text "Diplomacy"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 280px 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 180px 1fr
      gap: 12px
    }
    scroll Powers {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 4px
        focusGroup stop
        for p in powers {
          row Power {
            width: stretch
            padding: 8px
            gap: 10px
            align-items: center
            border-radius: 8px
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            art Emblem {
              kind emblem
              width: 36px
              height: 36px
              texture bind p.texture
            }
            column Text {
              width: stretch
              label Name {
                text bind p.name
                line-clamp: 1
                text-overflow: ellipsis
              }
              label Attitude {
                text bind p.attitude
                font: var(--text-caption)
                color: var(--ink-muted)
              }
            }
            badge War {
              key "screen.diplomacy.war"
              text "War"
              tone danger
              visible bind p.war
            }
            state selection bind "$index == selected" {
              off {
                background: var(--panel)
              }
              on {
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    scroll Page {
      width: stretch
      height: stretch
      column Power {
        width: stretch
        gap: 12px
        row Head {
          width: stretch
          gap: 16px
          slot Leader {
          }
          column Text {
            width: stretch
            gap: 4px
            label Name {
              text bind power.name
              font: var(--text-xl)
              heading true
            }
            label Leader {
              text bind power.leader
              color: var(--ink-muted)
            }
            for r in power.reasons {
              row Reason {
                width: stretch
                gap: 8px
                label Text {
                  text bind r.text
                  width: stretch
                  font: var(--text-caption)
                }
                label Value {
                  text bind r.value
                  font: var(--text-caption)
                  state sign bind "r.value >= 0" {
                    down {
                      color: var(--danger)
                    }
                    up {
                      color: var(--success)
                    }
                  }
                }
              }
            }
          }
        }
        row Actions {
          width: stretch
          gap: 8px
          flex-wrap: wrap
          for a in power.actions {
            button Action {
              text bind a.name
              size small
              @media phone {
                size medium
              }
              disabled bind "!a.enabled"
              on click set acting "$index"
              on click emit action
            }
          }
        }
        label TradeTitle {
          key "screen.diplomacy.trade"
          text "Trade"
          font: var(--text-lg)
          heading true
        }
        grid Trade {
          width: stretch
          gap: 12px
          grid-template-columns: 1fr 1fr
          column Mine {
            width: stretch
            padding: 12px
            gap: 6px
            background: var(--panel-raised)
            -og-frame: card
            label Title {
              key "screen.diplomacy.youGive"
              text "You give"
              font: var(--text-caption)
              color: var(--ink-muted)
            }
            for m in mine {
              label Item {
                text bind m.name
              }
            }
          }
          column Theirs {
            width: stretch
            padding: 12px
            gap: 6px
            background: var(--panel-raised)
            -og-frame: card
            label Title {
              key "screen.diplomacy.theyGive"
              text "They give"
              font: var(--text-caption)
              color: var(--ink-muted)
            }
            for t in theirs {
              label Item {
                text bind t.name
              }
            }
          }
        }
        slot Offers {
          width: stretch
        }
        row Deal {
          width: stretch
          gap: 12px
          align-items: center
          flex-wrap: wrap
          label Acceptance {
            key "screen.diplomacy.acceptance"
            text "Their view"
            font: var(--text-caption)
            color: var(--ink-muted)
          }
          progress Meter {
            width: stretch; min-width: 120px
            value bind "(acceptance + 1) / 2"
          }
          button Clear {
            key "screen.diplomacy.clear"
            text "Clear"
            variant quiet
            on click emit clearDeal
          }
          button Propose {
            key "screen.diplomacy.propose"
            text "Propose"
            variant primary
            on click emit propose
          }
        }
      }
    }
  }
}
