type screen
version 2
---
# Character select (docs/ui.md Appendix B: character select and versus).
# The players' picks standing large, the roster's tiles with each
# player's cursor, Lock in and the timer; versus follows it.
#
# Viewmodel: mode (the match's name), timer (seconds, -1: none), locked
# (the local pick is locked in). Events to code: back (code unlocks first
# when locked). Slots: Select takes versus.characterSelect (the splashes,
# the roster grid with cursors, taken and locked tiles, Lock in and the
# timer; it answers the cursor's moves, the lock and the unlock); Options
# takes the pick's skin, colour or loadout (og.ui.cycler, og.ui.segmented).
name "character-select"
layer menu
under hide
back emit back
focus "Body/Select"
props {
  mode string "The match's name (Ranked · Best of 3)."
  timer number "Seconds left to pick (-1: no timer)."
  locked bool "The local player has locked in."
}
actions {
  confirm "Lock in"
  back "Back"
}
fixture default "{\"mode\": \"Ranked · Best of 3\", \"timer\": 24, \"locked\": false}"
column Screen {
  width: stretch
  height: stretch
  padding: 16px
  gap: 8px
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click emit back
    }
    label Mode {
      text bind mode
      font: var(--text-lg)
      heading true
      line-clamp: 1
      text-overflow: ellipsis
    }
    spacer
    badge Locked {
      key "screen.character-select.locked"
      text "Locked in"
      tone success
      visible bind locked
    }
  }
  column Body {
    width: stretch
    height: stretch
    gap: 8px
    slot Select {
      width: stretch
      height: stretch
    }
    slot Options {
      width: stretch
    }
  }
}
