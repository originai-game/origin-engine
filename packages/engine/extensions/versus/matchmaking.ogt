type screen
version 2
---
# Matchmaking and ready check (docs/ui.md Appendix B: lobby, party,
# matchmaking, ready check). Searching: the mode, the time in queue
# against the estimate, players found, Cancel. Found: Match found, the
# seconds left, a pip per player as they accept, Accept and Decline.
#
# Viewmodel: mode, phase ("searching" or "found"), waited, estimate,
# found, needed, left (seconds to accept), answers (a pip per player:
# { state: pending, accepted, declined }), accepted. Events to code:
# cancel, accept, decline. Slots: Tip takes a tip or the mode's art while
# searching (og.ui.card).
name "matchmaking"
layer modal
under dim
back emit cancel
focus "Panel/Searching/Cancel"
props {
  mode string "The mode being searched."
  phase string "searching or found."
  waited number "Seconds in the queue."
  estimate number "The estimated wait, seconds."
  found number "Players found so far."
  needed number "Players a match needs."
  left number "Seconds left to accept."
  answers list "One per player: { state: pending, accepted or declined }."
  accepted bool "The local player has accepted."
}
actions {
  confirm "Accept"
  back "Cancel"
}
timeline found {
  track "Panel" scale {
    key 0 0.9
    key 180 1.04 out
    key 320 1 out
  }
  event 0 "" sound open
}
fixture default "{\"mode\": \"Ranked · Solo\", \"phase\": \"found\", \"waited\": 74, \"estimate\": 90, \"found\": 9, \"needed\": 10, \"left\": 8, \"answers\": [{\"state\": \"accepted\"}, {\"state\": \"accepted\"}, {\"state\": \"pending\"}, {\"state\": \"pending\"}, {\"state\": \"declined\"}, {\"state\": \"pending\"}, {\"state\": \"accepted\"}, {\"state\": \"pending\"}, {\"state\": \"pending\"}, {\"state\": \"pending\"}], \"accepted\": false}"
column Match {
  width: stretch
  height: stretch
  padding: 24px
  justify-content: center
  align-items: center
  @media phone {
    padding: 12px
  }
  column Panel {
    width: stretch; max-width: 480px
    padding: 24px
    gap: 16px
    align-items: center
    background: var(--panel)
    -og-frame: panel
    on change phase play found
    column Searching {
      width: stretch
      gap: 12px
      align-items: center
      visible bind "phase == \"searching\""
      label Title {
        key "screen.matchmaking.searching"
        text "Finding a match"
        font: var(--text-xl)
        heading true
      }
      label Mode {
        text bind mode
        color: var(--ink-muted)
      }
      label Waited {
        text "{waited, clock} · about {estimate, clock}"
        font: var(--text-lg)
      }
      progress Found {
        width: stretch
        value bind "found / needed"
      }
      slot Tip {
        width: stretch
      }
      button Cancel {
        key "screen.common.cancel"
        text "Cancel"
        width: stretch
        on click emit cancel
      }
    }
    column Found {
      width: stretch
      gap: 12px
      align-items: center
      visible bind "phase == \"found\""
      label Title {
        key "screen.matchmaking.found"
        text "Match found"
        font: var(--text-xl2)
        heading true
      }
      label Left {
        text bind left countdown
        font: var(--text-xl3)
      }
      row Answers {
        gap: 6px
        flex-wrap: wrap
        justify-content: center
        for a in answers {
          panel Pip {
            width: 14px
            height: 14px
            border-radius: 7px
            state answer bind a.state {
              pending {
                background: var(--control)
              }
              accepted {
                background: var(--success)
              }
              declined {
                background: var(--danger)
              }
            }
          }
        }
      }
      row Actions {
        width: stretch
        gap: 8px
        visible bind "!accepted"
        button Decline {
          key "screen.matchmaking.decline"
          text "Decline"
          width: stretch
          on click emit decline
        }
        button Accept {
          key "screen.matchmaking.accept"
          text "Accept"
          variant primary
          size large
          width: stretch
          autofocus true
          on click emit accept
          on action confirm emit accept
        }
      }
      label Waiting {
        key "screen.matchmaking.waiting"
        text "Waiting for the others"
        color: var(--ink-muted)
        visible bind accepted
      }
    }
  }
}
