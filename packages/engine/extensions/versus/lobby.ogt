type screen
version 2
---
# Lobby and party (docs/ui.md Appendix B: lobby, party, matchmaking,
# ready check). The party's lineup, the mode and the one action (Ready,
# Find match, Cancel), the ready check over everything; matchmaking is the
# queue's own screen for games that leave the lobby while searching.
#
# Viewmodel: code (the party's join code, empty: none), privacy (as text).
# Events to code: invite, copyCode, privacy, leave (also Back). Slots: Lobby
# takes versus.lobby (the lineup, seats, mode card, Ready and Find match,
# the queue chip and the ready check; it answers ready, start, cancel,
# accept, decline, invite and the member pressed); Side takes the party
# chat or the friends list (og.ui.dataList).
name "lobby"
layer menu
back emit leave
focus "Body/Lobby"
props {
  code string "The party's join code (empty: none)."
  privacy string "Who can join, as text (Friends only)."
}
actions {
  confirm "Ready"
  back "Leave"
}
fixture default "{\"code\": \"K7QX-42\", \"privacy\": \"Friends only\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Leave {
      key "screen.lobby.leave"
      text "Leave"
      variant quiet
      on click emit leave
    }
    label Title {
      key "screen.lobby.title"
      text "Party"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    button Code {
      text "Code {code}"
      size small
      @media phone {
        size medium
      }
      visible bind "code != \"\""
      on click emit copyCode
    }
    button Privacy {
      text bind privacy
      size small
      @media phone {
        size medium
      }
      on click emit privacy
    }
    button Invite {
      key "screen.lobby.invite"
      text "Invite"
      size small
      @media phone {
        size medium
      }
      on click emit invite
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 1fr 300px
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr
    }
    slot Lobby {
      width: stretch
      height: stretch
    }
    slot Side {
      width: stretch
      height: stretch
      @media phone {
        visible false
      }
    }
  }
}
