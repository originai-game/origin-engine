type screen
version 2
---
# Training mode with frame data (docs/ui.md Appendix B). Over the live
# fight: the last move's frame data (startup, active, recovery, on block,
# on hit), the combo's damage and hits, the inputs history, and the dummy's
# settings in a side panel.
#
# Viewmodel: move (the last move's name), startup, active, recovery,
# onBlock, onHit, damage, hits, showInputs, showPanel. Events to code:
# reset (the positions), record, playback, panel (the click toggles
# showPanel). Slots: Inputs takes the input history (og.ui.dataList of
# direction and button glyphs with frame counts); Dummy takes the dummy's
# settings (og.ui.dropdown for stance, block and recovery,
# og.ui.toggleSwitch rows); Bars takes the fighters' meters
# (og.ui.statBar).
name "training"
layer hud
props {
  move string "The last move's name."
  startup number "Its startup, frames."
  active number "Its active frames."
  recovery number "Its recovery, frames."
  onBlock number "Its advantage on block (negative: punishable)."
  onHit number "Its advantage on hit."
  damage number "The combo's damage."
  hits number "The combo's hits."
  showInputs bool "The input history shows."
  showPanel bool "The dummy's panel is open (two-way)."
}
fixture default "{\"move\": \"Heavy kick\", \"startup\": 11, \"active\": 3, \"recovery\": 19, \"onBlock\": -6, \"onHit\": 2, \"damage\": 1840, \"hits\": 5, \"showInputs\": true, \"showPanel\": false}"
stack Training {
  width: stretch
  height: stretch
  slot Bars {
    position: absolute
    inset-inline-start: 16px
    top: 16px
    inset-inline-end: 16px
  }
  column Data {
    position: absolute
    inset-inline-start: 16px
    top: 96px
    padding: 12px
    gap: 4px
    -og-frame: hud
    @media phone {
      top: 72px
      inset-inline-start: 8px
    }
    @media phone-landscape {
      inset-inline-start: 52px
    }
    label Move {
      text bind move
      font: var(--text-lg)
      heading true
    }
    row Frames {
      gap: 12px
      label Startup {
        text "S {startup}"
        font-family: var(--font-mono)
      }
      label Active {
        text "A {active}"
        font-family: var(--font-mono)
      }
      label Recovery {
        text "R {recovery}"
        font-family: var(--font-mono)
      }
    }
    row Advantage {
      gap: 12px
      label Block {
        text "Block {onBlock}"
        font-family: var(--font-mono)
        state safe bind "onBlock >= -3" {
          unsafe {
            color: var(--danger)
          }
          safe {
            color: var(--ink)
          }
        }
      }
      label Hit {
        text "Hit {onHit}"
        font-family: var(--font-mono)
      }
    }
    divider
    label Combo {
      text "{hits} hits · {damage, grouped}"
      color: var(--warn)
    }
  }
  column InputsColumn {
    position: absolute
    inset-inline-start: 16px
    bottom: 16px
    visible bind showInputs
    @media phone-portrait {
      visible false
    }
    slot Inputs {
    }
  }
  row Tools {
    position: absolute
    inset-inline-end: 16px
    top: 96px
    gap: 8px
    @media phone {
      top: 72px
      inset-inline-end: 8px
    }
    @media phone-landscape {
      inset-inline-end: 52px
    }
    button Reset {
      key "screen.training.reset"
      text "Reset"
      size small
      @media phone {
        size medium
      }
      on click emit reset
    }
    button Record {
      key "screen.training.record"
      text "Record"
      size small
      @media phone {
        size medium
      }
      on click emit record
    }
    button Playback {
      key "screen.training.playback"
      text "Play back"
      size small
      @media phone {
        size medium
      }
      on click emit playback
    }
    button Panel {
      key "screen.training.dummy"
      text "Dummy"
      size small
      @media phone {
        size medium
      }
      on click set showPanel "!showPanel"
      on click emit panel
    }
  }
  column Panel {
    position: absolute
    inset-inline-end: 16px
    top: 148px
    width: stretch; max-width: 320px
    padding: 12px
    gap: 8px
    background: var(--panel)
    -og-frame: panel
    visible bind showPanel
    -og-enter: slide-left 24px var(--motion-enter)
    @media phone {
      inset-inline-end: 8px
      top: 120px
    }
    @media phone-landscape {
      inset-inline-end: 52px
    }
    label Title {
      key "screen.training.dummyTitle"
      text "Dummy"
      font: var(--text-lg)
      heading true
    }
    slot Dummy {
      width: stretch
    }
  }
}
