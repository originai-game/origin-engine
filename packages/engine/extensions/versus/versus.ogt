type screen
version 2
---
# Versus (docs/ui.md Appendix B: character select and versus). The two
# sides slammed in on a slant, the mark between them, the stage and the
# loading progress; a tip at the foot while it loads.
#
# Viewmodel: tip, canSkip. Events to code: skip (once loaded). Slots:
# Versus takes versus.versus (the two splashes in their team tints, the
# names, the mark, the stage and the progress; its own skip).
name "versus"
layer modal
under hide
back none
capture true
props {
  tip string "A tip under the screen while it loads (empty: none)."
  canSkip bool "The match is loaded: a press skips."
}
actions {
  confirm "Skip"
}
fixture default "{\"tip\": \"Blocking low stops sweeps but not overheads.\", \"canSkip\": false}"
stack Versus {
  width: stretch
  height: stretch
  background: var(--backdrop)
  interactive true
  on click emit skip
  slot Versus {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  label Tip {
    position: absolute
    inset-inline-start: 24px
    inset-inline-end: 24px
    bottom: 16px
    text bind tip
    font: var(--text-caption)
    text-align: center
    color: var(--ink-muted)
    line-clamp: 2
    visible bind "tip != \"\" && !canSkip"
  }
}
