type screen
version 2
---
# Route flowchart (docs/ui.md Appendix B: backlog, gallery, route
# flowchart). Back, the title and the endings reached at the head; under
# them the route chart fills the screen.
#
# Slot Chart takes story.routeChart("Chart", desc): the chapters' headings
# over their columns, each scene a card on its column and lane (seen lit,
# unseen quiet, locked veiled, the current ringed, endings banded), the
# branches as elbow lines (taken ones lit, a choice's words at the fork),
# the count of scenes seen, and the selected scene's detail with Jump here
# for a seen one (under the chart on a phone in portrait). Its
# RouteChartDesc: chapters ({ key, label }), scenes ({ key, title, image,
# column, lane, seen, locked, current, ending, good }), links ({ from, to,
# label, taken }), selected, and its words (lockedLabel, jumpLabel,
# currentLabel, seenLabel); its title is the document's, so pass it empty.
# Its RouteChartResult: selected (code sets it), jump (code returns the
# story to that scene and pops this screen), refused.
#
# Viewmodel: endings (as text). Back pops it.
name "flowchart"
layer menu
focus "Chart"
props {
  endings string "Endings reached, as text (2/6)."
}
actions {
  confirm "Select"
  back "Back"
}
fixture default "{\"endings\": \"2/6\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.flowchart.title"
      text "Story chart"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Endings {
      text "Endings {endings}"
      font: var(--text-caption)
      color: var(--ink-muted)
    }
  }
  slot Chart {
    width: stretch
    height: stretch
  }
}
