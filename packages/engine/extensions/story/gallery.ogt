type screen
version 2
---
# Gallery (docs/ui.md Appendix B: backlog, gallery, route flowchart). The
# event CGs, the music and the endings unlocked, by tab: the CGs are the
# CG gallery, the music and endings the document's own grid, each a
# thumbnail (locked ones dimmed with a hint) and the count found.
#
# Slot Gallery (the Scenes tab) takes story.cgGallery("Cg", desc): its
# chapters as tabs (the tab actions step them) with the count seen, the
# 16:9 tiles in whole rows (locked ones veiled with their hint, New on the
# fresh), and the viewer over its whole box with the versions' pips,
# previous, next and Close. Its CgGalleryDesc: chapters ({ key, label }),
# chapter, entries ({ key, title, chapter, image, variants, locked, hint,
# fresh }), viewing (the key shown, empty: the grid), variant, and its
# words (countLabel, lockedLabel, newLabel, closeLabel, prevLabel,
# nextLabel); its title is the document's, so pass it empty. Its
# CgGalleryResult (chapter, open, refused, close, step, variant) moves
# the game's state; set `viewing` here while a picture is open, so the
# head gives the viewer the screen.
#
# Viewmodel: tab, items (the music or endings), found, total, viewing.
# Events to code: open (a music or ending item; the click wrote selected),
# back (the Back button and the Back action: close an open picture first,
# else og.ui.pop; the layer leaves Back to code).
name "gallery"
layer menu
back emit back
focus "Gallery"
props {
  tab string "cg, music or endings."
  items list "The tab's items: { name, unlocked (bool), hint, texture }."
  selected number "The selected item's index."
  found number "Music or endings unlocked (the CG gallery counts its own)."
  total number "Music or endings in the tab."
  viewing bool "A CG is open in the gallery's viewer: the head and tabs hide."
}
actions {
  confirm "View"
  back "Back"
  tabNext "Next chapter"
  tabPrev "Previous chapter"
}
fixture default "{\"tab\": \"cg\", \"items\": [{\"name\": \"First meeting\", \"unlocked\": true, \"hint\": \"\", \"texture\": 0}, {\"name\": \"The festival\", \"unlocked\": true, \"hint\": \"\", \"texture\": 0}, {\"name\": \"???\", \"unlocked\": false, \"hint\": \"Chapter 4\", \"texture\": 0}], \"selected\": 0, \"found\": 2, \"total\": 24, \"viewing\": false}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    visible bind "!viewing"
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click emit back
    }
    label Title {
      key "screen.gallery.title"
      text "Gallery"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Found {
      text "{found}/{total}"
      color: var(--ink-muted)
      visible bind "tab != \"cg\""
    }
  }
  row Tabs {
    visible bind "!viewing"
    gap: 6px
    flex-wrap: wrap
    button Cg {
      key "screen.gallery.cg"
      text "Scenes"
      variant ghost
      on click set tab "\"cg\""
      state selection bind "tab == \"cg\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Music {
      key "screen.gallery.music"
      text "Music"
      variant ghost
      on click set tab "\"music\""
      state selection bind "tab == \"music\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Endings {
      key "screen.gallery.endings"
      text "Endings"
      variant ghost
      on click set tab "\"endings\""
      state selection bind "tab == \"endings\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
  }
  slot Gallery {
    width: stretch
    height: stretch
    visible bind "tab == \"cg\""
  }
  scroll Body {
    width: stretch
    height: stretch
    visible bind "tab != \"cg\""
    grid Grid {
      width: stretch
      gap: 12px
      grid-template-columns: 1fr 1fr 1fr 1fr
      focusGroup wrap
      @media tablet {
        grid-template-columns: 1fr 1fr 1fr
      }
      @media phone-portrait {
        grid-template-columns: 1fr 1fr
        gap: 8px
      }
      for it in items {
        column Item {
          width: stretch
          gap: 4px
          interactive true
          focusable true
          on click set selected "$index"
          on click emit open
          art Thumb {
            kind eventCg
            width: stretch
            texture bind it.texture
          }
          label Name {
            text bind it.name
            font: var(--text-caption)
            line-clamp: 1
            text-overflow: ellipsis
          }
          label Hint {
            text bind it.hint
            font: var(--text-caption)
            color: var(--ink-muted)
            visible bind "!it.unlocked"
          }
          state lock bind it.unlocked {
            locked {
              opacity: 0.45
            }
            open {
              opacity: 1
            }
          }
          :hover {
            scale: 1.02
          }
          :active {
            scale: 0.98
          }
          :focus-visible {
            scale: 1.02
          }
          -og-state-transition: var(--motion-ui)
        }
      }
    }
  }
}
