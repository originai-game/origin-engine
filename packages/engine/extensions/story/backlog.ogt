type screen
version 1
---
# Backlog (docs/ui.md Appendix B: backlog, gallery, route flowchart). The
# visual novel's lines read so far, over the dimmed scene, opening on the
# newest; gallery and flowchart are the other two.
#
# Viewmodel: chapter. Events to code: close (also Back), jump (code goes
# back to the line the backlog answers, where the game allows it). Slots:
# Log takes story.backlog (the lines under their speakers, the choices
# made, replay of a voiced line, Close; it answers the replay and close).
name "backlog"
layer modal
under dim
back emit close
focus "Panel/Log"
props {
  chapter string "The chapter's name, at the head."
}
actions {
  back "Close"
}
fixture default "{\"chapter\": \"Chapter 2 · The Letter\"}"
column Backlog {
  width grow
  height grow
  padding 32
  align center
  cross center
  at phone {
    padding 12
  }
  column Panel {
    width grow 0 880
    height grow
    gap 8
    label Chapter {
      text bind chapter
      step caption
      color token inkMuted
    }
    slot Log {
      width grow
      height grow
    }
  }
}
