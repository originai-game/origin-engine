type screen
version 2
---
# Quest log and journal (docs/ui.md Appendix B: quest log, journal,
# codex, bestiary, encyclopedia). The quests by category, the selected
# quest's objectives, rewards, Track and Show on map. codex is the
# encyclopedia beside it.
#
# Viewmodel: active (count), done (count). Back pops it. Slots:
# Log takes rpg.questLog (the tabs, the list with its new and updated
# dots, the detail with objectives, rewards, Track and Show on map; it
# answers the quest picked, tracked and shown); Map takes a small map of
# the quest's area when the game has one (og.ui.minimapView).
name "quest-log"
layer menu
pause true
focus "Body/Log"
props {
  active number "Quests in progress."
  done number "Quests completed."
}
actions {
  confirm "Select"
  back "Close"
  details "Track"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"active\": 7, \"done\": 23}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.quest-log.title"
      text "Journal"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Counts {
      text "{active} active · {done} done"
      font: var(--text-caption)
      color: var(--ink-muted)
    }
  }
  column Body {
    width: stretch
    height: stretch
    gap: 12px
    slot Log {
      width: stretch
      height: stretch
    }
    slot Map {
      width: stretch
    }
  }
}
