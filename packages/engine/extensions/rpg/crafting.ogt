type screen
version 2
---
# Crafting and recipe book (docs/ui.md Appendix B). The recipes by
# category with a search, each marked when it can be made; the selected
# recipe's result, its ingredients against what the player has, the
# station it needs, an amount and Craft (held for many).
#
# Viewmodel: categories, category, query, recipes, selected, recipe,
# amount. Events to code: category, search (the field wrote query), select
# (the click wrote selected), craft (Back pops it). Slots: Result takes the
# result's tooltip (og.ui.tooltipCard); Amount takes og.ui.numberStepper;
# Craft takes og.ui.holdButton when crafting many at once is held.
name "crafting"
layer menu
pause true
focus "Body/Recipes/List"
props {
  categories list "The categories: { name }."
  category number "The selected category's index."
  query string "The search's text (two-way)."
  recipes list "The recipes shown: { name, can (bool), known (bool), texture }."
  selected number "The selected recipe's index."
  recipe object "The selected recipe: { name, text, station, stationHere (bool), ingredients: [{ name, need, have, texture }] }."
  amount number "How many to craft."
}
actions {
  confirm "Craft"
  back "Back"
}
fixture default "{\"categories\": [{\"name\": \"All\"}, {\"name\": \"Tools\"}, {\"name\": \"Food\"}], \"category\": 0, \"query\": \"\", \"recipes\": [{\"name\": \"Iron pick\", \"can\": true, \"known\": true, \"texture\": 0}, {\"name\": \"Lantern\", \"can\": false, \"known\": true, \"texture\": 0}, {\"name\": \"???\", \"can\": false, \"known\": false, \"texture\": 0}], \"selected\": 0, \"recipe\": {\"name\": \"Iron pick\", \"text\": \"Breaks stone and ore.\", \"station\": \"Anvil\", \"stationHere\": true, \"ingredients\": [{\"name\": \"Iron bar\", \"need\": 3, \"have\": 5, \"texture\": 0}, {\"name\": \"Wood\", \"need\": 2, \"have\": 1, \"texture\": 0}]}, \"amount\": 1}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  @media phone-landscape {
    padding: 8px
    gap: 6px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.crafting.title"
      text "Crafting"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    field Search {
      width: stretch; min-width: 160px; max-width: 320px
      input bind query
      placeholder "Search recipes"
      on changed emit search
    }
  }
  row Categories {
    width: stretch
    gap: 6px
    flex-wrap: wrap
    for c in categories {
      button Category {
        text bind c.name
        variant ghost
        size small
        @media phone {
          size medium
        }
        on click set category "$index"
        on click emit category
        state selection bind "$index == category" {
          off {
            opacity: 0.85
          }
          on {
            opacity: 1
          }
        }
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 1fr 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    scroll Recipes {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 4px
        focusGroup stop
        for r in recipes {
          row Recipe {
            width: stretch
            padding: 8px
            gap: 10px
            align-items: center
            border-radius: 8px
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            art Icon {
              kind itemIcon
              width: 40px
              height: 40px
              texture bind r.texture
            }
            label Name {
              text bind r.name
              width: stretch
              line-clamp: 1
              text-overflow: ellipsis
            }
            badge Can {
              key "screen.crafting.can"
              text "Ready"
              tone success
              visible bind r.can
            }
            state selection bind "$index == selected" {
              off {
                background: var(--panel)
              }
              on {
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            state know bind r.known {
              unknown {
                opacity: 0.5
              }
              known {
                opacity: 1
              }
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    column Detail {
      width: stretch
      padding: 16px
      gap: 10px
      background: var(--panel)
      -og-frame: panel
      row Head {
        width: stretch
        gap: 12px
        align-items: center
        slot Result {
        }
        column Text {
          width: stretch
          gap: 2px
          label Name {
            text bind recipe.name
            font: var(--text-lg)
            heading true
          }
          label Line {
            text bind recipe.text
            color: var(--ink-muted)
            line-clamp: 2
          }
        }
      }
      label IngredientsTitle {
        key "screen.crafting.ingredients"
        text "Ingredients"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      column Ingredients {
        width: stretch
        gap: 6px
        for i in recipe.ingredients {
          row Ingredient {
            width: stretch
            gap: 8px
            align-items: center
            art Icon {
              kind itemIcon
              width: 32px
              height: 32px
              texture bind i.texture
            }
            label Name {
              text bind i.name
              width: stretch
              line-clamp: 1
              text-overflow: ellipsis
            }
            label Count {
              text "{i.have}/{i.need}"
              state enough bind "i.have >= i.need" {
                short {
                  color: var(--danger)
                }
                enough {
                  color: var(--ink)
                }
              }
            }
          }
        }
      }
      row Station {
        width: stretch
        gap: 8px
        label Label {
          key "screen.crafting.station"
          text "Station"
          font: var(--text-caption)
          color: var(--ink-muted)
        }
        label Name {
          text bind recipe.station
          font: var(--text-caption)
        }
        badge Missing {
          key "screen.crafting.noStation"
          text "Not here"
          tone warn
          visible bind "!recipe.stationHere"
        }
      }
      row Actions {
        width: stretch
        gap: 8px
        align-items: center
        slot Amount {
        }
        spacer
        slot Craft {
        }
        button CraftOne {
          key "screen.crafting.craft"
          text "Craft"
          variant primary
          disabled bind "!recipes.length || !recipe.stationHere"
          on click emit craft
        }
      }
    }
  }
}
