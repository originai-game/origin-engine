type screen
version 2
---
# Character, loadout, paperdoll and stats (docs/ui.md Appendix B). The
# character's name, level and headline stats at the head, Equipment and
# Loadout tabs under it: the paperdoll with the hovered item's comparison
# beside it, or the loadout filling the page.
#
# Viewmodel: name, level, className, tab, stats. Events to code: tab (the
# click wrote tab); Back pops it. Slots: Paperdoll takes rpg.paperdoll
# (the figure, the equipment slots and the stats with deltas; its own
# figure slot takes a sceneViewport turntable); Compare takes
# og.ui.statCompare or og.ui.tooltipCard for the item under the pointer or
# the focus. Loadout takes shooter.loadout("Loadout", desc) with its title
# empty (the head above names the character): its LoadoutDesc is loadouts
# (the saved sets' names, its tabs), loadout, balance and currencyImage,
# slots ({ key, label, name, detail, image, rarity, locked }), slot, the
# selected item (image, aspect, name, subtitle, rarity, rarityWord,
# description), attachments ({ key, label, name, image, rarity,
# rarityLabel, x, y }), attachment, capacity, stats ({ key, label, value,
# delta, max }) and its words
# (statsLabel, attachmentsLabel, emptyLabel, removeLabel, lockedLabel);
# its LoadoutResult (loadout, slot, attachment, remove, refused) is the
# game's to apply.
name "character"
layer menu
focus "Tabs/Equipment"
props {
  name string "The character's name."
  level number "Its level."
  className string "Its class or role."
  tab string "equipment or loadout."
  stats list "The headline stats: { name, value }."
}
actions {
  back "Back"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"name\": \"Mara\", \"level\": 24, \"className\": \"Ranger\", \"tab\": \"equipment\", \"stats\": [{\"name\": \"Power\", \"value\": 412}, {\"name\": \"Armour\", \"value\": 268}, {\"name\": \"Speed\", \"value\": 105}]}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 16px
  @media phone {
    padding: 16px
    gap: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    column Who {
      gap: 2px
      label Name {
        text bind name
        font: var(--text-xl2)
        heading true
        @media phone {
          font: var(--text-xl)
        }
      }
      label Meta {
        text "Level {level} · {className}"
        color: var(--ink-muted)
      }
    }
    spacer
    row Stats {
      gap: 16px
      @media phone-portrait {
        visible false
      }
      for s in stats {
        column Stat {
          align-items: center
          label Value {
            text bind s.value grouped
            font: var(--text-lg)
          }
          label Name {
            text bind s.name
            font: var(--text-caption)
            color: var(--ink-muted)
          }
        }
      }
    }
  }
  row Tabs {
    gap: 8px
    focusGroup wrap
    button Equipment {
      key "screen.character.equipment"
      text "Equipment"
      variant ghost
      on click set tab "\"equipment\""
      state selection bind "tab == \"equipment\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Loadout {
      key "screen.character.loadout"
      text "Loadout"
      variant ghost
      on click set tab "\"loadout\""
      state selection bind "tab == \"loadout\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
  }
  column Body {
    width: stretch
    height: stretch
    grid Equipment {
      width: stretch
      height: stretch
      gap: 24px
      grid-template-columns: 2fr 1fr
      grid-template-rows: 1fr
      visible bind "tab == \"equipment\""
      @media phone-portrait {
        grid-template-columns: 1fr
        grid-template-rows: 1fr auto
        gap: 12px
      }
      slot Paperdoll {
        width: stretch
        height: stretch
      }
      slot Compare {
        width: stretch
      }
    }
    slot Loadout {
      width: stretch
      height: stretch
      visible bind "tab == \"loadout\""
    }
  }
}
