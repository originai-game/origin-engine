type screen
version 2
---
# Dialogue (docs/ui.md Appendix B: choices, checks, timers). Over the
# scene: the speaker's portrait and the conversation box with its line,
# its choices (checks, locked ones with their reason, a timer), and Skip,
# Log and Auto.
#
# Viewmodel: cinematic (letterbox bars on), speaking (a line is up).
# Events to code: log (push backlog), skip. Slots: Conversation takes
# rpg.conversation (fed by og.story.view: the name, the line typing out,
# the choices with their checks and reasons, the timer, the roll, Skip,
# Log and Auto; it answers the choice and going on); Portrait takes the
# speaker (art kind bust, or a sceneViewport for a 3D close-up).
name "dialogue"
layer hud
input menu
capture true
back emit skip
props {
  cinematic bool "Letterbox bars above and below."
  speaking bool "A line is up (false: the box is hidden between lines)."
}
actions {
  confirm "Next"
  back "Skip"
  details "Log"
}
fixture default "{\"cinematic\": true, \"speaking\": true}"
stack Dialogue {
  width: stretch
  height: stretch
  on action details emit log
  column Bars {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
    visible bind cinematic
    panel Top {
      width: stretch
      height: 64px
      background: #000000
      @media phone {
        height: 32px
      }
    }
    spacer
    panel Bottom {
      width: stretch
      height: 64px
      background: #000000
      @media phone {
        height: 32px
      }
    }
  }
  row Stage {
    position: absolute
    inset-inline-start: 32px
    inset-inline-end: 32px
    bottom: 80px
    gap: 16px
    align-items: end
    visible bind speaking
    @media phone {
      inset-inline-start: 12px
      inset-inline-end: 12px
      bottom: 40px
    }
    slot Portrait {
      @media phone-portrait {
        visible false
      }
    }
    slot Conversation {
      width: stretch
    }
  }
}
