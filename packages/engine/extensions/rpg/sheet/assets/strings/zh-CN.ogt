type strings
version 1
---
# The rpg kit's strings in Simplified Chinese, as a game ships them, so the review's
# CJK cells (og ui review --locales …,zh-CN) show them.
locale "zh-CN"
string "rpg.backpack.tabs" "分类"
string "rpg.backpack.empty" "背包是空的"
string "rpg.backpack.equipped" "已装备"
string "rpg.backpack.new" "新"
string "rpg.backpack.locked" "无法丢弃"
string "rpg.backpack.weight" "负重"
string "rpg.backpack.gold" "{gold} 金币"
string "rpg.card.current" "当前装备"
string "rpg.card.equip" "装备"
string "rpg.card.use" "使用"
string "rpg.card.drop" "丢弃"
string "rpg.character.attributes" "属性"
string "rpg.character.unequip" "卸下"
string "rpg.quests.empty" "暂无任务"
string "rpg.quests.tracked" "追踪中"
string "rpg.quests.updated" "已更新"
string "rpg.quest.objectives" "目标"
string "rpg.quest.rewards" "奖励"
