string "rpg.talk.narration" "旁白"
string "rpg.talk.replies" "回答"
string "rpg.talk.continue" "继续"
string "rpg.compass.name" "罗盘，朝向 {heading}"
string "rpg.party.name" "队伍"
string "rpg.party.empty" "没有同伴"
string "rpg.party.level" "等级 {level}"
string "rpg.party.health" "生命"
string "rpg.party.mana" "法力"
