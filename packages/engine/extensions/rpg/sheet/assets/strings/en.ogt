string "sheet.placeName" "Saltmere Abbey"
string "sheet.placeAbout" "Its belfry leans over the mere, half a bell's height under water at high tide."
string "sheet.talkSpeaker" "Ysolde of the Mere"
string "sheet.talkLine" "The water remembers every bell it swallowed. Are you certain you want to hear them ring again?"
string "sheet.talkReplies.r1.text" "Yes. The bell must ring again."
string "sheet.talkReplies.r2.text" "Tell me first what the brothers fear."
string "sheet.talkReplies.r3.text" "Not yet. I need to gather supplies."
