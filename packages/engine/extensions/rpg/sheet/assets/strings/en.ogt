string "sheet.questName" "The Sunken Bell"
string "sheet.questSummary" "The abbey's bell fell silent the night the causeway flooded. The brothers say it still rings beneath the mere, and that whoever raises it will hold the crossing."
string "sheet.questObjectives.o1.text" "Cross the flooded causeway"
string "sheet.questObjectives.o2.text" "Speak with the oarsman"
string "sheet.questObjectives.o3.text" "Find the sunken belfry"
string "sheet.questObjectives.o4.text" "Bring salt for the lurker"
