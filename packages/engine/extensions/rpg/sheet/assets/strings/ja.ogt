string "rpg.talk.narration" "語り"
string "rpg.talk.replies" "返答"
string "rpg.talk.continue" "続ける"
string "rpg.compass.name" "コンパス、{heading} を向いている"
string "rpg.party.name" "パーティ"
string "rpg.party.empty" "仲間はいません"
string "rpg.party.level" "レベル {level}"
string "rpg.party.health" "体力"
string "rpg.party.mana" "魔力"
