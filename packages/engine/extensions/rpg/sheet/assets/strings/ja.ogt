type strings
version 1
---
# The rpg kit's strings in Japanese, as a game ships them, so the review's
# CJK cells (og ui review --locales …,ja) show them.
locale "ja"
string "rpg.backpack.tabs" "カテゴリ"
string "rpg.backpack.empty" "バッグは空です"
string "rpg.backpack.equipped" "装備中"
string "rpg.backpack.new" "新着"
string "rpg.backpack.locked" "捨てられません"
string "rpg.backpack.weight" "所持重量"
string "rpg.backpack.gold" "{gold} ゴールド"
string "rpg.card.current" "現在の装備"
string "rpg.card.equip" "装備"
string "rpg.card.use" "使う"
string "rpg.card.drop" "捨てる"
string "rpg.character.attributes" "能力値"
string "rpg.character.unequip" "外す"
string "rpg.quests.empty" "クエストはまだありません"
string "rpg.quests.tracked" "追跡中"
string "rpg.quests.updated" "更新"
string "rpg.quest.objectives" "目標"
string "rpg.quest.rewards" "報酬"
