type project
version 1
---
# The rpg kit's review sheet: `og ui sheet rpg` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §6.2). The kit is installed
# as a game installs it; each screen names its style and page.
name "RPG kit sheet"
id "rpg-sheet"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "inventory-fantasy" "style:fantasy;page:inventory"
  screen "journal-fantasy" "style:fantasy;page:journal"
}
