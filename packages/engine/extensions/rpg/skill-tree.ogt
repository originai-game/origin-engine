type screen
version 2
---
# Skill, talent, passive and tech trees (docs/ui.md Appendix B). The tree
# filling the screen, panned and zoomed; the points to spend at the head;
# the selected node's detail with Learn, and Respec.
#
# Viewmodel: trees (the tabs: { name }), tree, points, selected (the
# node's { name, rank, maxRank, cost, text, state }), refund. Events to
# code: tree (the click wrote tree), learn, unlearn, respec (Back pops it). Slots:
# Graph takes og.ui.nodeGraph (nodes, links, states; it answers the node
# pressed: code sets selected); Detail takes more about the node (its
# ranks, og.ui.keyValueRows).
name "skill-tree"
layer menu
pause true
focus "Body/Graph"
props {
  trees list "The trees: { name }."
  tree number "The selected tree's index."
  points number "Points left to spend."
  selected object "The selected node: { name, rank, maxRank, cost, text, state (locked, open, learned) }."
  refund number "What a respec costs (0: free)."
}
actions {
  confirm "Learn"
  back "Back"
  details "Unlearn"
  tabNext "Next tree"
  tabPrev "Previous tree"
}
fixture default "{\"trees\": [{\"name\": \"Combat\"}, {\"name\": \"Survival\"}, {\"name\": \"Arcane\"}], \"tree\": 0, \"points\": 3, \"selected\": {\"name\": \"Keen edge\", \"rank\": 1, \"maxRank\": 3, \"cost\": 1, \"text\": \"Critical hits deal 10% more damage per rank.\", \"state\": \"open\"}, \"refund\": 500}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    row Trees {
      gap: 6px
      flex-wrap: wrap
      for t in trees {
        button Tree {
          text bind t.name
          variant ghost
          on click set tree "$index"
          on click emit tree
          state selection bind "$index == tree" {
            off {
              opacity: 0.85
            }
            on {
              opacity: 1
            }
          }
        }
      }
    }
    spacer
    badge Points {
      text "{points, plural, one {# point} other {# points}}"
      tone accent
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 1fr 340px
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    slot Graph {
      width: stretch
      height: stretch
    }
    column Side {
      width: stretch
      padding: 16px
      gap: 8px
      background: var(--panel)
      -og-frame: panel
      label Name {
        text bind selected.name
        font: var(--text-lg)
        heading true
      }
      label Rank {
        text "Rank {selected.rank}/{selected.maxRank}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      label Text {
        text bind selected.text
        font: var(--text-reading)
        line-clamp: 6
      }
      slot Detail {
        width: stretch
      }
      row Actions {
        width: stretch
        gap: 8px
        button Learn {
          key "screen.skill-tree.learn"
          text "Learn"
          variant primary
          disabled bind "points < selected.cost || selected.state == \"locked\" || selected.rank >= selected.maxRank"
          on click emit learn
        }
        button Unlearn {
          key "screen.skill-tree.unlearn"
          text "Unlearn"
          variant quiet
          disabled bind "selected.rank == 0"
          on click emit unlearn
        }
      }
      button Respec {
        key "screen.skill-tree.respec"
        text "Reset all points"
        variant quiet
        on click emit respec
      }
    }
  }
}
