type screen
version 2
---
# Inventory (docs/ui.md Appendix B: grid, list, weighted, nested
# containers). The bag's grid (or list), its weight against the limit, the
# filters and sort, the selected item's detail with its actions, and a
# breadcrumb into nested containers.
#
# Viewmodel: path (the containers opened, outermost first), weight,
# capacity, filter, filters, gold, view. Events to code: filter (the
# click wrote filter), sort, view (grid and list), up (the breadcrumb's
# parent), use, drop (Back pops it). Slots: Grid takes rpg.inventoryGrid (or
# og.ui.dataList for the list view); Detail takes the selected item
# (og.ui.tooltipCard, og.ui.statCompare); Equip takes rpg.paperdoll
# when the screen is the bag and the doll together.
name "inventory"
layer menu
pause true
focus "Body/Grid"
props {
  path list "The containers opened, outermost first: { name }."
  weight number "What the bag holds, in the game's unit."
  capacity number "What it can hold (0: no limit)."
  filter number "The selected filter's index."
  filters list "The filters: { name }."
  gold number "The purse."
  view string "grid or list."
}
actions {
  confirm "Select"
  back "Close"
  details "Item menu"
  rotate "Rotate"
}
fixture default "{\"path\": [{\"name\": \"Backpack\"}], \"weight\": 42.5, \"capacity\": 60, \"filter\": 0, \"filters\": [{\"name\": \"All\"}, {\"name\": \"Weapons\"}, {\"name\": \"Armour\"}, {\"name\": \"Consumables\"}], \"gold\": 1840, \"view\": \"grid\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.inventory.title"
      text "Inventory"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    row Path {
      gap: 6px
      align-items: center
      for c in path {
        button Crumb {
          text bind c.name
          variant ghost
          size small
          @media phone {
            size medium
          }
          on click emit up
        }
      }
    }
    spacer
    label Gold {
      text "{gold, grouped}"
      font: var(--text-lg)
      color: var(--gold)
    }
  }
  row Tools {
    width: stretch
    gap: 8px
    align-items: center
    flex-wrap: wrap
    for f in filters {
      button Filter {
        text bind f.name
        variant ghost
        size small
        @media phone {
          size medium
        }
        on click set filter "$index"
        on click emit filter
        state selection bind "$index == filter" {
          off {
            opacity: 0.85
          }
          on {
            opacity: 1
          }
        }
      }
    }
    spacer
    button Sort {
      key "screen.inventory.sort"
      text "Sort"
      size small
      @media phone {
        size medium
      }
      on click emit sort
    }
    button View {
      key "screen.inventory.view"
      text "Grid / list"
      size small
      @media phone {
        size medium
      }
      on click emit view
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 2fr 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    column Main {
      width: stretch
      height: stretch
      gap: 12px
      slot Equip {
        width: stretch
      }
      slot Grid {
        width: stretch
        height: stretch
      }
    }
    column Side {
      width: stretch
      gap: 12px
      slot Detail {
        width: stretch
      }
      row Actions {
        width: stretch
        gap: 8px
        button Use {
          key "screen.inventory.use"
          text "Use"
          variant primary
          on click emit use
        }
        button Drop {
          key "screen.inventory.drop"
          text "Drop"
          variant quiet
          on click emit drop
        }
      }
    }
  }
  row Weight {
    width: stretch
    gap: 12px
    align-items: center
    visible bind "capacity > 0"
    label Label {
      key "screen.inventory.weight"
      text "Weight"
      font: var(--text-caption)
      color: var(--ink-muted)
    }
    progress Bar {
      width: stretch
      value bind "weight / capacity"
    }
    label Value {
      text "{weight, fixed, 1} / {capacity, grouped}"
      font: var(--text-caption)
    }
  }
}
