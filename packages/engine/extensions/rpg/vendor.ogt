type screen
version 2
---
# Shop and vendor in the world (docs/ui.md Appendix B). The vendor's
# portrait and greeting, Buy, Sell and Buy back tabs over the goods, the
# selected item's comparison, the player's purse, and an amount for
# stacks.
#
# Viewmodel: vendor, greeting, tab, goods, selected, gold, amount. Events
# to code: tab (the click wrote tab), select (the click wrote selected),
# buy, sell, buyBack, close. Slots: Compare takes the selected item
# against what is equipped (og.ui.statCompare, og.ui.tooltipCard); Amount
# takes og.ui.numberStepper; Bag takes rpg.inventoryGrid on the Sell tab
# when the game sells from a grid.
name "vendor"
layer menu
pause true
focus "Body/Goods/List"
props {
  vendor string "The vendor's name."
  greeting string "What the vendor says."
  portrait number "The vendor's portrait texture (0: the placeholder)."
  tab string "buy, sell or buyBack."
  goods list "The tab's items: { name, price, stock (-1: endless), tier, texture, afford (bool) }."
  selected number "The selected item's index."
  gold number "The player's gold."
}
actions {
  confirm "Buy"
  back "Leave"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"vendor\": \"Hesk the trader\", \"greeting\": \"Fine wares, fair prices. Mostly fair.\", \"portrait\": 0, \"tab\": \"buy\", \"goods\": [{\"name\": \"Healing draught\", \"price\": 40, \"stock\": -1, \"tier\": \"Common\", \"texture\": 0, \"afford\": true}, {\"name\": \"Steel longsword\", \"price\": 820, \"stock\": 1, \"tier\": \"Rare\", \"texture\": 0, \"afford\": true}, {\"name\": \"Wyrmscale mail\", \"price\": 4200, \"stock\": 1, \"tier\": \"Epic\", \"texture\": 0, \"afford\": false}], \"selected\": 0, \"gold\": 1840}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 16px
    align-items: center
    art Portrait {
      kind bust
      width: 72px
      height: 72px
      texture bind portrait
      @media phone {
        width: 48px
        height: 48px
      }
    }
    column Who {
      width: stretch
      gap: 2px
      label Name {
        text bind vendor
        font: var(--text-xl)
        heading true
      }
      label Greeting {
        text bind greeting
        color: var(--ink-muted)
        line-clamp: 2
      }
    }
    label Gold {
      text "{gold, grouped}"
      font: var(--text-lg)
      color: var(--gold)
    }
  }
  row Tabs {
    gap: 6px
    focusGroup wrap
    button Buy {
      key "screen.vendor.buy"
      text "Buy"
      variant ghost
      on click set tab "\"buy\""
      state selection bind "tab == \"buy\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Sell {
      key "screen.vendor.sell"
      text "Sell"
      variant ghost
      on click set tab "\"sell\""
      state selection bind "tab == \"sell\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button BuyBack {
      key "screen.vendor.buyBack"
      text "Buy back"
      variant ghost
      on click set tab "\"buyBack\""
      state selection bind "tab == \"buyBack\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 3fr 2fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    scroll Goods {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 4px
        focusGroup stop
        slot Bag {
          width: stretch
        }
        for g in goods {
          row Good {
            width: stretch
            padding: 8px
            gap: 10px
            align-items: center
            border-radius: 8px
            interactive true
            focusable true
            on click set selected "$index"
            art Icon {
              kind itemIcon
              width: 44px
              height: 44px
              texture bind g.texture
            }
            column Text {
              width: stretch
              gap: 2px
              label Name {
                text bind g.name
                line-clamp: 1
                text-overflow: ellipsis
              }
              label Tier {
                text bind g.tier
                font: var(--text-caption)
                color: var(--ink-muted)
              }
            }
            label Stock {
              text "×{g.stock}"
              font: var(--text-caption)
              color: var(--ink-muted)
              visible bind "g.stock >= 0"
            }
            label Price {
              text "{g.price, grouped}"
              state afford bind g.afford {
                short {
                  color: var(--danger)
                }
                afford {
                  color: var(--gold)
                }
              }
            }
            state selection bind "$index == selected" {
              off {
                background: var(--panel)
              }
              on {
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    column Side {
      width: stretch
      gap: 12px
      slot Compare {
        width: stretch
      }
      row Actions {
        width: stretch
        gap: 8px
        align-items: center
        slot Amount {
        }
        spacer
        button BuyItem {
          key "screen.vendor.buyItem"
          text "Buy"
          variant primary
          visible bind "tab == \"buy\""
          on click emit buy
        }
        button SellItem {
          key "screen.vendor.sellItem"
          text "Sell"
          variant primary
          visible bind "tab == \"sell\""
          on click emit sell
        }
        button BuyBackItem {
          key "screen.vendor.buyBackItem"
          text "Buy back"
          variant primary
          visible bind "tab == \"buyBack\""
          on click emit buyBack
        }
      }
    }
  }
}
