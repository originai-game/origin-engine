type screen
version 2
---
# Codex, bestiary and encyclopedia (docs/ui.md Appendix B: quest log,
# journal, codex, bestiary, encyclopedia). Categories, a searchable list
# of entries (the undiscovered ones ???), and the selected entry's art,
# text and facts; how many of each category are found.
#
# Viewmodel: categories, category, query, entries, selected, entry.
# Events to code: category (the click wrote category), search (the field
# wrote query), select (the click wrote selected). Slots: Facts takes
# the entry's facts (og.ui.keyValueRows: weaknesses, habitat); Prose
# takes rich text with links (og.ui.prose) when the entry's text is more
# than a paragraph.
name "codex"
layer menu
pause true
focus "Body/Entries/List"
props {
  categories list "The categories: { name, found, total }."
  category number "The selected category's index."
  query string "The search's text (two-way)."
  entries list "The category's entries: { name, found (bool), fresh (bool) }."
  selected number "The selected entry's index."
  entry object "The selected entry: { name, kind, text, texture }."
}
actions {
  confirm "Select"
  back "Close"
  tabNext "Next category"
  tabPrev "Previous category"
}
fixture default "{\"categories\": [{\"name\": \"Creatures\", \"found\": 18, \"total\": 40}, {\"name\": \"Places\", \"found\": 9, \"total\": 22}, {\"name\": \"Lore\", \"found\": 31, \"total\": 60}], \"category\": 0, \"query\": \"\", \"entries\": [{\"name\": \"Bog wight\", \"found\": true, \"fresh\": true}, {\"name\": \"Lantern moth\", \"found\": true, \"fresh\": false}, {\"name\": \"???\", \"found\": false, \"fresh\": false}], \"selected\": 0, \"entry\": {\"name\": \"Bog wight\", \"kind\": \"Undead · Marsh\", \"text\": \"Drawn to light, it drowns travellers who carry lanterns after dark. Fire keeps it at bay.\", \"texture\": 0}}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.codex.title"
      text "Codex"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    field Search {
      width: stretch; min-width: 160px; max-width: 320px
      input bind query
      placeholder "Search"
      on changed emit search
    }
  }
  row Categories {
    width: stretch
    flex-wrap: wrap
    gap: 6px
    for c in categories {
      button Category {
        text "{c.name} {c.found}/{c.total}"
        variant ghost
        size small
        @media phone {
          size medium
        }
        on click set category "$index"
        on click emit category
        state selection bind "$index == category" {
          off {
            opacity: 0.85
          }
          on {
            opacity: 1
          }
        }
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 300px 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 200px 1fr
      gap: 12px
    }
    scroll Entries {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 2px
        focusGroup stop
        for e in entries {
          row Entry {
            width: stretch
            height: fit-content; min-height: 44px
            padding: 8px
            gap: 8px
            align-items: center
            border-radius: 6px
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            label Name {
              text bind e.name
              width: stretch
              line-clamp: 1
              text-overflow: ellipsis
            }
            badge New {
              key "screen.common.new"
              text "New"
              tone accent
              visible bind e.fresh
            }
            state selection bind "$index == selected" {
              off {
                background: var(--panel)
              }
              on {
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            state find bind e.found {
              hidden {
                opacity: 0.5
              }
              found {
                opacity: 1
              }
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    scroll Page {
      width: stretch
      height: stretch
      column Entry {
        width: stretch
        gap: 12px
        row Head {
          width: stretch
          gap: 16px
          flex-wrap: wrap
          art Art {
            kind unitPortrait
            width: 200px
            height: 200px
            texture bind entry.texture
            @media phone {
              width: 120px
              height: 120px
            }
          }
          column Text {
            width: stretch; min-width: 200px
            gap: 4px
            label Name {
              text bind entry.name
              font: var(--text-xl)
              heading true
            }
            label Kind {
              text bind entry.kind
              color: var(--ink-muted)
            }
            slot Facts {
              width: stretch
            }
          }
        }
        label Body {
          text bind entry.text
          font: var(--text-reading)
        }
        slot Prose {
          width: stretch
        }
      }
    }
  }
}
