type screen
version 2
---
# Character creation (docs/ui.md Appendix B: sliders, presets, turntable).
# The character turning in the middle, presets across the top, the
# categories (body, face, hair, colours) at the start side, the selected
# category's sliders at the end, the name and Done at the foot.
#
# Viewmodel: presets, preset, categories, category, sliders, name. Events
# to code: preset (the click wrote preset), category, randomize, done
# (Back pops it). The sliders write their value back; code applies them to the
# model. Slots: Turntable takes the character (og.ui.viewport, a
# sceneViewport the player drags to turn); Colours takes swatches or
# og.ui.colorPicker for the selected category.
name "character-creation"
layer menu
under hide
focus "Body/Categories/List"
props {
  presets list "The presets: { name, texture }."
  preset number "The selected preset's index (-1: custom)."
  categories list "The categories: { name }."
  category number "The selected category's index."
  sliders list "The selected category's sliders: { name, value, min, max }; value two-way."
  name string "The character's name (two-way)."
}
actions {
  confirm "Select"
  back "Back"
  details "Randomize"
}
fixture default "{\"presets\": [{\"name\": \"Wanderer\", \"texture\": 0}, {\"name\": \"Scholar\", \"texture\": 0}, {\"name\": \"Veteran\", \"texture\": 0}], \"preset\": 0, \"categories\": [{\"name\": \"Body\"}, {\"name\": \"Face\"}, {\"name\": \"Hair\"}, {\"name\": \"Colours\"}], \"category\": 1, \"sliders\": [{\"name\": \"Jaw\", \"value\": 0.4, \"min\": 0, \"max\": 1}, {\"name\": \"Eyes\", \"value\": 0.6, \"min\": 0, \"max\": 1}, {\"name\": \"Nose\", \"value\": 0.5, \"min\": 0, \"max\": 1}], \"name\": \"Mara\"}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 16px
  @media phone {
    padding: 16px
    gap: 8px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.character-creation.title"
      text "Create your character"
      font: var(--text-xl2)
      heading true
      line-clamp: 1
      text-overflow: ellipsis
      @media phone {
        font: var(--text-lg)
      }
    }
  }
  scroll Presets {
    width: stretch
    @media phone-landscape {
      visible false
    }
    row List {
      gap: 8px
      for p in presets {
        column Preset {
          width: 96px
          gap: 4px
          padding: 4px
          align-items: center
          background: var(--panel-raised)
          -og-frame: card
          interactive true
          focusable true
          on click set preset "$index"
          on click emit preset
          art Art {
            kind bust
            width: 80px
            height: 80px
            texture bind p.texture
          }
          label Name {
            text bind p.name
            font: var(--text-caption)
            line-clamp: 1
            text-overflow: ellipsis
          }
          state selection bind "$index == preset" {
            off {
              opacity: 0.75
            }
            on {
              opacity: 1
              background: var(--primary-soft)
            }
          }
          :hover {
            translate: 0 -2px
          }
          :active {
            translate: 0 0
          }
          :focus-visible {
            translate: 0 -2px
          }
          -og-state-transition: var(--motion-ui)
        }
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 200px 1fr 320px
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 240px auto auto
      gap: 8px
    }
    column Categories {
      width: stretch
      gap: 4px
      @media phone-portrait {
        grid-column: 1; grid-row: 2
      }
      row List {
        width: stretch
        gap: 4px
        flex-wrap: wrap
        for c in categories {
          button Category {
            text bind c.name
            variant ghost
            on click set category "$index"
            on click emit category
            state selection bind "$index == category" {
              off {
                opacity: 0.85
              }
              on {
                opacity: 1
              }
            }
          }
        }
      }
    }
    slot Turntable {
      width: stretch
      height: stretch
      @media phone-portrait {
        grid-column: 1; grid-row: 1
      }
    }
    scroll Sliders {
      width: stretch
      height: stretch
      @media phone-portrait {
        grid-column: 1; grid-row: 3
      }
      column List {
        width: stretch
        gap: 10px
        for s in sliders {
          column Slider {
            width: stretch
            gap: 4px
            label Name {
              text bind s.name
              font: var(--text-caption)
              color: var(--ink-muted)
            }
            slider Value {
              width: stretch
              min bind s.min
              max bind s.max
              value bind s.value
            }
          }
        }
        slot Colours {
          width: stretch
        }
      }
    }
  }
  row Footer {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    field Name {
      width: stretch; max-width: 320px
      input bind name
      placeholder "Name"
      maxChars 24
    }
    spacer
    button Randomize {
      key "screen.character-creation.randomize"
      text "Randomize"
      variant quiet
      on click emit randomize
      on action details emit randomize
    }
    button Done {
      key "screen.character-creation.done"
      text "Done"
      variant primary
      disabled bind "name == \"\""
      on click emit done
    }
  }
}
