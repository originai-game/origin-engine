type screen
version 2
---
# Auction house and market (docs/ui.md Appendix B). Browse, Sell and My
# auctions; the search and filters, the listings as a sortable table
# (thousands of rows), the selected listing's price history and Buy or
# Bid; the player's gold and the house's cut.
#
# Viewmodel: tab, query, gold, cut (fraction), selected (the listing: {
# name, price, bid, seller, ends }). Events to code: tab (the click wrote
# tab), search (the field wrote query), buy, bid, post, cancel (Back pops it).
# Slots: Listings takes og.ui.table (built in view only, sortable by price,
# level and time left; it answers the row selected); Filters takes the
# category tree and level range (og.ui.tree, og.ui.rangeSlider); History
# takes the price history (og.ui.chart, line); Post takes the sell form
# (rpg.inventoryGrid of the bag, og.ui.numberStepper for the price).
name "auction-house"
layer menu
focus "Body/Listings"
props {
  tab string "browse, sell or mine."
  query string "The search's text (two-way)."
  gold number "The player's gold."
  cut number "The house's cut on a sale, a fraction."
  selected object "The selected listing: { name, price, bid, seller, ends (seconds) }."
}
actions {
  confirm "Buy"
  back "Close"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"tab\": \"browse\", \"query\": \"\", \"gold\": 48210, \"cut\": 0.05, \"selected\": {\"name\": \"Starsteel ingot\", \"price\": 1250, \"bid\": 980, \"seller\": \"Brann\", \"ends\": 7200}}"
column Screen {
  width: stretch
  height: stretch
  padding: 24px
  gap: 12px
  @media phone {
    padding: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.auction-house.title"
      text "Auction house"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    label Gold {
      text bind gold grouped
      font: var(--text-lg)
      color: var(--gold)
    }
  }
  row Tools {
    width: stretch
    gap: 8px
    align-items: center
    flex-wrap: wrap
    button Browse {
      key "screen.auction-house.browse"
      text "Browse"
      variant ghost
      on click set tab "\"browse\""
      state selection bind "tab == \"browse\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Sell {
      key "screen.auction-house.sell"
      text "Sell"
      variant ghost
      on click set tab "\"sell\""
      state selection bind "tab == \"sell\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Mine {
      key "screen.auction-house.mine"
      text "My auctions"
      variant ghost
      on click set tab "\"mine\""
      state selection bind "tab == \"mine\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    spacer
    field Search {
      width: stretch; min-width: 160px; max-width: 320px
      input bind query
      placeholder "Search"
      on changed emit search
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 16px
    grid-template-columns: 240px 1fr 300px
    grid-template-rows: 1fr
    @media tablet {
      grid-template-columns: 1fr 280px
    }
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    slot Filters {
      width: stretch
      height: stretch
      @media tablet {
        visible false
      }
      @media phone {
        visible false
      }
    }
    slot Listings {
      width: stretch
      height: stretch
    }
    column Side {
      width: stretch
      padding: 12px
      gap: 8px
      background: var(--panel)
      -og-frame: panel
      column Browse {
        width: stretch
        gap: 8px
        visible bind "tab != \"sell\""
        label Name {
          text bind selected.name
          font: var(--text-lg)
          heading true
        }
        label Seller {
          text "{selected.seller} · {selected.ends, duration}"
          font: var(--text-caption)
          color: var(--ink-muted)
        }
        slot History {
          width: stretch
        }
        row Prices {
          width: stretch
          gap: 8px
          label Bid {
            text "Bid {selected.bid, grouped}"
          }
          spacer
          label Price {
            text "Buyout {selected.price, grouped}"
            color: var(--gold)
          }
        }
        row Actions {
          width: stretch
          gap: 8px
          button Bid {
            key "screen.auction-house.bid"
            text "Bid"
            width: stretch
            visible bind "tab == \"browse\""
            on click emit bid
          }
          button Buy {
            key "screen.auction-house.buy"
            text "Buy out"
            variant primary
            width: stretch
            visible bind "tab == \"browse\""
            disabled bind "gold < selected.price"
            on click emit buy
          }
          button Cancel {
            key "screen.auction-house.cancel"
            text "Cancel auction"
            variant danger
            width: stretch
            visible bind "tab == \"mine\""
            on click emit cancel
          }
        }
      }
      column SellPage {
        width: stretch
        gap: 8px
        visible bind "tab == \"sell\""
        slot Post {
          width: stretch
        }
        label Cut {
          text "The house keeps {cut, percent}"
          font: var(--text-caption)
          color: var(--ink-muted)
        }
        button PostIt {
          key "screen.auction-house.post"
          text "Post auction"
          variant primary
          width: stretch
          on click emit post
        }
      }
    }
  }
}
