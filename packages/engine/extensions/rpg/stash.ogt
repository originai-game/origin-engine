type screen
version 2
---
# Stash, storage, bank (docs/ui.md Appendix B). The stash's tabs and grid
# beside the player's bag, items moved between them by drag, quick
# transfer (Shift and a press, or the details action held) or Deposit all;
# the bank's gold with deposit and withdraw.
#
# Viewmodel: tabs, tab, used, slots, gold, banked. Events to code: tab
# (the click wrote tab), depositAll, sortStash, deposit, withdraw and
# buyTab. Slots: StashGrid and BagGrid each take rpg.inventoryGrid (the
# two grids move items between them; each answers what moved); Amount
# takes og.ui.numberStepper for the gold to move.
name "stash"
layer menu
pause true
focus "Body/Stash/StashGrid"
props {
  tabs list "The stash's tabs: { name, locked }."
  tab number "The selected tab's index."
  used number "Cells in use in the tab."
  slots number "Cells in the tab."
  gold number "Gold carried."
  banked number "Gold in the bank."
}
actions {
  confirm "Select"
  back "Close"
  details "Quick transfer"
}
fixture default "{\"tabs\": [{\"name\": \"I\", \"locked\": false}, {\"name\": \"II\", \"locked\": false}, {\"name\": \"III\", \"locked\": true}], \"tab\": 0, \"used\": 37, \"slots\": 60, \"gold\": 1840, \"banked\": 25600}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.stash.title"
      text "Stash"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    row Bank {
      gap: 8px
      align-items: center
      label Banked {
        text "{banked, grouped}"
        font: var(--text-lg)
        color: var(--gold)
      }
      slot Amount {
      }
      button Deposit {
        key "screen.stash.deposit"
        text "Deposit"
        size small
        @media phone {
          size medium
        }
        on click emit deposit
      }
      button Withdraw {
        key "screen.stash.withdraw"
        text "Withdraw"
        size small
        @media phone {
          size medium
        }
        on click emit withdraw
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 1fr 1fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr 1fr
      gap: 12px
    }
    column Stash {
      width: stretch
      height: stretch
      gap: 8px
      row Tabs {
        width: stretch
        gap: 6px
        align-items: center
        flex-wrap: wrap
        for t in tabs {
          button Tab {
            width: fit-content; min-width: 44px
            text bind t.name
            variant ghost
            size small
            @media phone {
              size medium
            }
            disabled bind t.locked
            on click set tab "$index"
            state selection bind "$index == tab" {
              off {
                opacity: 0.85
              }
              on {
                opacity: 1
              }
            }
          }
        }
        button BuyTab {
          key "screen.stash.buyTab"
          text "+"
          size small
          @media phone {
            size medium
          }
          square true
          name "Buy a tab"
          on click emit buyTab
        }
        spacer
        label Used {
          text "{used}/{slots}"
          font: var(--text-caption)
          color: var(--ink-muted)
        }
      }
      slot StashGrid {
        width: stretch
        height: stretch
      }
      row Actions {
        width: stretch
        gap: 8px
        button Sort {
          key "screen.stash.sort"
          text "Sort"
          size small
          @media phone {
            size medium
          }
          on click emit sortStash
        }
        button DepositAll {
          key "screen.stash.depositAll"
          text "Deposit all"
          size small
          @media phone {
            size medium
          }
          on click emit depositAll
        }
      }
    }
    column Bag {
      width: stretch
      height: stretch
      gap: 8px
      row Head {
        width: stretch
        gap: 8px
        align-items: center
        label Title {
          key "screen.stash.bag"
          text "Bag"
          font: var(--text-lg)
          heading true
        }
        spacer
        label Gold {
          text "{gold, grouped}"
          color: var(--gold)
        }
      }
      slot BagGrid {
        width: stretch
        height: stretch
      }
    }
  }
}
