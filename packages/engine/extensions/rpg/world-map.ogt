type screen
version 2
---
# World map (docs/ui.md Appendix B: fog, markers, fast travel). The map
# filling the screen, its legend and the selected place's detail, the
# region the player is in, and the zoom.
#
# Viewmodel: region, zoom (two-way). Events to code: zoomIn, zoomOut,
# center (on the player) (Back pops it). Slots: Map takes rpg.worldMap (the
# painted map with fog, regions, pins, the player's arrow, the legend and
# the place's detail with Fast travel and waypoints; it answers the pin
# pressed, travel and the waypoint); Tracker takes rpg.questTracker for
# the tracked quest over the map.
name "world-map"
layer menu
pause true
under hide
focus "Map/Map"
props {
  region string "The region the player is in."
  zoom number "The map's zoom, 0 to 1 (two-way)."
}
actions {
  confirm "Select"
  back "Close"
  details "Waypoint"
}
fixture default "{\"region\": \"Greywater Marsh\", \"zoom\": 0.4}"
stack Map {
  width: stretch
  height: stretch
  slot Map {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  row Head {
    position: absolute
    inset-inline-start: 24px
    top: 24px
    inset-inline-end: 24px
    gap: 12px
    align-items: center
    @media phone {
      inset-inline-start: 12px
      top: 12px
      inset-inline-end: 12px
    }
    button Close {
      key "screen.common.close"
      text "Close"
      on click pop
    }
    panel Region {
      padding: 8px
      -og-frame: hud
      label Name {
        text bind region
        font: var(--text-lg)
        heading true
        line-clamp: 1
        text-overflow: ellipsis
      }
    }
    spacer
    slot Tracker {
      @media phone-portrait {
        visible false
      }
    }
  }
  column Zoom {
    position: absolute
    inset-inline-end: 24px
    bottom: 24px
    gap: 8px
    @media phone {
      inset-inline-end: 12px
      bottom: 12px
    }
    button In {
      key "screen.world-map.zoomIn"
      text "+"
      square true
      name "Zoom in"
      on click emit zoomIn
    }
    button Out {
      key "screen.world-map.zoomOut"
      text "-"
      square true
      name "Zoom out"
      on click emit zoomOut
    }
    button Center {
      key "screen.world-map.center"
      text "Me"
      name "Centre on me"
      on click emit center
    }
  }
}
