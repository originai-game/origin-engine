type project
version 1
---
# The puzzle kit's review sheet: `og ui sheet puzzle` renders each page at
# desktop and phone, 100 % and 150 % (docs/ui.md §17.3). Every page sets
# its own style and state.
name "Puzzle kit sheet"
id "puzzle-sheet"
engine "0.7.7"
entry "src/main.ts"
profile "2d"
tick 60
seed 1
ui {
  screen "saga-cartoon" "style:cartoon;page:saga"
  screen "saga-fantasy" "style:fantasy;page:saga"
  screen "goals-cartoon" "style:cartoon;page:goals"
  screen "goals-pixel" "style:pixel;page:goals"
}
