type screen
version 2
---
# Level and saga map (docs/ui.md Appendix B). The levels along a path
# that scrolls, the player's pin on the current one, the stars won, lives
# and their refill timer, and the selected level's card with Play.
#
# Viewmodel: lives, maxLives, refill (seconds), stars (total), level (the
# selected one: { name, stars, best, goal }), showLevel. Events to code:
# play, close (the card), settings (Back pops it). Slots: Map takes puzzle.sagaMap
# (the path, badges, stars, locks, bosses and the pin; it answers the
# level picked: code fills level and sets showLevel); Boosters takes the
# boosters to take into the level (og.ui.card tiles).
name "saga-map"
layer menu
focus "Map/Map"
props {
  lives number "Lives left."
  maxLives number "The most lives."
  refill number "Seconds until the next life."
  stars number "Stars won in all."
  level object "The picked level: { name, stars, best, goal }."
  showLevel bool "The level's card is open."
}
actions {
  confirm "Play"
  back "Back"
}
fixture default "{\"lives\": 4, \"maxLives\": 5, \"refill\": 1260, \"stars\": 128, \"level\": {\"name\": \"Level 42\", \"stars\": 2, \"best\": 18400, \"goal\": \"Clear 30 jellies in 25 moves\"}, \"showLevel\": true}"
stack Map {
  width: stretch
  height: stretch
  slot Map {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  row Top {
    position: absolute
    inset-inline-start: 16px
    top: 16px
    inset-inline-end: 16px
    gap: 8px
    align-items: center
    panel Lives {
      padding: 8px
      -og-frame: hud
      row Row {
        gap: 6px
        align-items: center
        icon Heart {
          icon heart
          iconSize 20
          color: var(--danger)
        }
        label Count {
          text "{lives}/{maxLives}"
          font: var(--text-lg)
        }
        label Refill {
          text "{refill, countdown}"
          font: var(--text-caption)
          color: var(--ink-muted)
          visible bind "lives < maxLives"
        }
      }
    }
    panel Stars {
      padding: 8px
      -og-frame: hud
      row Row {
        gap: 6px
        align-items: center
        icon Star {
          icon star
          iconSize 20
          color: var(--gold)
        }
        label Count {
          text bind stars grouped
          font: var(--text-lg)
        }
      }
    }
    spacer
    button Settings {
      key "screen.saga-map.settings"
      text "Settings"
      size small
      @media phone {
        size medium
      }
      on click emit settings
    }
  }
  row Shade {
    width: stretch
    height: stretch
    padding: 24px
    justify-content: center
    align-items: center
    background: var(--scrim)
    visible bind showLevel
    interactive true
    on click set showLevel "false"
    column Card {
      width: stretch; max-width: 420px
      padding: 24px
      gap: 12px
      align-items: center
      background: var(--panel)
      -og-frame: panel
      interactive true
      -og-enter: pop
      label Name {
        text bind level.name
        font: var(--text-xl2)
        heading true
      }
      row Stars {
        gap: 6px
        icon One {
          icon star
          iconSize 32
          state lit bind "level.stars >= 1" {
            off {
              color: var(--ink-faint)
            }
            on {
              color: var(--gold)
            }
          }
        }
        icon Two {
          icon star
          iconSize 32
          state lit bind "level.stars >= 2" {
            off {
              color: var(--ink-faint)
            }
            on {
              color: var(--gold)
            }
          }
        }
        icon Three {
          icon star
          iconSize 32
          state lit bind "level.stars >= 3" {
            off {
              color: var(--ink-faint)
            }
            on {
              color: var(--gold)
            }
          }
        }
      }
      label Goal {
        text bind level.goal
        text-align: center
        line-clamp: 3
      }
      label Best {
        text "Best {level.best, grouped}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      slot Boosters {
        width: stretch
      }
      row Actions {
        width: stretch
        gap: 8px
        button Close {
          key "screen.common.close"
          text "Close"
          variant quiet
          on click set showLevel "false"
          on click emit close
        }
        button Play {
          key "screen.saga-map.play"
          text "Play"
          variant primary
          width: stretch
          autofocus true
          disabled bind "lives == 0"
          on click emit play
        }
      }
    }
  }
}
