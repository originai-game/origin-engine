type screen
version 1
---
# Auction house and market (docs/ui.md Appendix B). Browse, Sell and My
# auctions; the search and filters, the listings as a sortable table
# (thousands of rows), the selected listing's price history and Buy or
# Bid; the player's gold and the house's cut.
#
# Viewmodel: tab, query, gold, cut (fraction), selected (the listing: {
# name, price, bid, seller, ends }). Events to code: tab (the click wrote
# tab), search (the field wrote query), buy, bid, post, cancel (Back pops it).
# Slots: Listings takes og.ui.table (built in view only, sortable by price,
# level and time left; it answers the row selected); Filters takes the
# category tree and level range (og.ui.tree, og.ui.rangeSlider); History
# takes the price history (og.ui.chart, line); Post takes the sell form
# (og.ui.inventoryGrid of the bag, og.ui.numberStepper for the price).
name "auction-house"
layer menu
focus "Body/Listings"
props {
  tab string "browse, sell or mine."
  query string "The search's text (two-way)."
  gold number "The player's gold."
  cut number "The house's cut on a sale, a fraction."
  selected object "The selected listing: { name, price, bid, seller, ends (seconds) }."
}
actions {
  confirm "Buy"
  back "Close"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"tab\": \"browse\", \"query\": \"\", \"gold\": 48210, \"cut\": 0.05, \"selected\": {\"name\": \"Starsteel ingot\", \"price\": 1250, \"bid\": 980, \"seller\": \"Brann\", \"ends\": 7200}}"
column Screen {
  width grow
  height grow
  padding 24
  gap 12
  at phone {
    padding 12
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.auction-house.title"
      text "Auction house"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    spacer
    label Gold {
      text bind gold grouped
      step lg
      color token gold
    }
  }
  row Tools {
    width grow
    gap 8
    cross center
    wrap true
    button Browse {
      key "screen.auction-house.browse"
      text "Browse"
      variant ghost
      on click set tab "\"browse\""
      state selection bind "tab == \"browse\"" {
        off {
          opacity 0.7
        }
        on {
          opacity 1
        }
      }
    }
    button Sell {
      key "screen.auction-house.sell"
      text "Sell"
      variant ghost
      on click set tab "\"sell\""
      state selection bind "tab == \"sell\"" {
        off {
          opacity 0.7
        }
        on {
          opacity 1
        }
      }
    }
    button Mine {
      key "screen.auction-house.mine"
      text "My auctions"
      variant ghost
      on click set tab "\"mine\""
      state selection bind "tab == \"mine\"" {
        off {
          opacity 0.7
        }
        on {
          opacity 1
        }
      }
    }
    spacer
    field Search {
      width grow 160 320
      input bind query
      placeholder "Search"
      on changed emit search
    }
  }
  grid Body {
    width grow
    height grow
    gap 16
    columns 240 "1fr" 300
    rows "1fr"
    at tablet {
      columns "1fr" 280
    }
    at phonePortrait {
      columns "1fr"
      rows "1fr" auto
      gap 12
    }
    slot Filters {
      width grow
      height grow
      at tablet {
        visible false
      }
      at phone {
        visible false
      }
    }
    slot Listings {
      width grow
      height grow
    }
    column Side {
      width grow
      padding 12
      gap 8
      frame panel
      column Browse {
        width grow
        gap 8
        visible bind "tab != \"sell\""
        label Name {
          text bind selected.name
          step lg
          heading true
        }
        label Seller {
          text "{selected.seller} · {selected.ends, duration}"
          step caption
          color token inkMuted
        }
        slot History {
          width grow
        }
        row Prices {
          width grow
          gap 8
          label Bid {
            text "Bid {selected.bid, grouped}"
          }
          spacer
          label Price {
            text "Buyout {selected.price, grouped}"
            color token gold
          }
        }
        row Actions {
          width grow
          gap 8
          button Bid {
            key "screen.auction-house.bid"
            text "Bid"
            width grow
            visible bind "tab == \"browse\""
            on click emit bid
          }
          button Buy {
            key "screen.auction-house.buy"
            text "Buy out"
            variant primary
            width grow
            visible bind "tab == \"browse\""
            disabled bind "gold < selected.price"
            on click emit buy
          }
          button Cancel {
            key "screen.auction-house.cancel"
            text "Cancel auction"
            variant danger
            width grow
            visible bind "tab == \"mine\""
            on click emit cancel
          }
        }
      }
      column SellPage {
        width grow
        gap 8
        visible bind "tab == \"sell\""
        slot Post {
          width grow
        }
        label Cut {
          text "The house keeps {cut, percent}"
          step caption
          color token inkMuted
        }
        button PostIt {
          key "screen.auction-house.post"
          text "Post auction"
          variant primary
          width grow
          on click emit post
        }
      }
    }
  }
}
