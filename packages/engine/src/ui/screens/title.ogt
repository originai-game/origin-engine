type screen
version 2
---
# Title (docs/ui.md Appendix B: boot, splash, title, main menu, mode
# select). Key art edge to edge, the logo, and "Press any button" breathing
# until the player presses something; the device's glyph tells which.
#
# Viewmodel: version, legal. Events to code:
# start (any press; code pushes main-menu). Slots: Background takes the
# game's own scene (og.ui.viewport) for a live title.
name "title"
layer menu
under none
back none
capture true
props {
  version string "The build's version."
  legal string "The legal line at the foot (copyright, trademarks)."
}
actions {
  confirm "Start"
}
timeline breathe {
  track "Foot/Prompt" opacity {
    key 0 1
    key 900 0.45 inOut
    key 1800 1 inOut
  }
  duration 1800
}
fixture default "{\"version\": \"1.0.0\", \"legal\": \"© Studio. All rights reserved.\"}"
stack Title {
  width: stretch
  height: stretch
  interactive true
  on click emit start
  on action confirm emit start
  on appear play breathe
  art Art {
    kind keyArt
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  slot Background {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  column Foot {
    width: stretch
    height: stretch
    padding: 48px
    gap: 16px
    align-items: center
    @media phone {
      padding: 24px
    }
    spacer
    art Logo {
      kind logo
      width: 420px
      height: 160px
      @media phone {
        width: 280px
        height: 106px
      }
    }
    spacer
    label Prompt {
      key "screen.title.press"
      text "Press any button"
      font: var(--text-lg)
      text-align: center
    }
    label Legal {
      text bind legal
      font: var(--text-caption)
      color: var(--ink-muted)
      text-align: center
    }
  }
  label Version {
    text bind version
    font: var(--text-caption)
    color: var(--ink-muted)
    position: absolute
    inset-inline-end: 16px
    bottom: 12px
  }
}
