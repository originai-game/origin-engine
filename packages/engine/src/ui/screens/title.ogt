type screen
version 1
---
# Title (docs/ui.md Appendix B: boot, splash, title, main menu, mode
# select). Key art edge to edge, the logo, and "Press any button" breathing
# until the player presses something; the device's glyph tells which.
#
# Viewmodel: version, legal. Events to code:
# start (any press; code pushes main-menu). Slots: Background takes the
# game's own scene (og.ui.viewport) for a live title.
name "title"
layer menu
under none
back none
capture true
props {
  version string "The build's version."
  legal string "The legal line at the foot (copyright, trademarks)."
}
actions {
  confirm "Start"
}
timeline breathe {
  track "Foot/Prompt" opacity {
    key 0 1
    key 900 0.45 inOut
    key 1800 1 inOut
  }
  duration 1800
}
fixture default "{\"version\": \"1.0.0\", \"legal\": \"© Studio. All rights reserved.\"}"
stack Title {
  width grow
  height grow
  interactive true
  on click emit start
  on action confirm emit start
  on appear play breathe
  art Art {
    kind keyArt
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
  }
  slot Background {
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
  }
  column Foot {
    width grow
    height grow
    padding 48
    gap 16
    cross center
    at phone {
      padding 24
    }
    spacer
    art Logo {
      kind logo
      width 420
      height 160
      at phone {
        width 280
        height 106
      }
    }
    spacer
    label Prompt {
      key "screen.title.press"
      text "Press any button"
      step lg
      textAlign center
    }
    label Legal {
      text bind legal
      step caption
      color token inkMuted
      textAlign center
    }
  }
  label Version {
    text bind version
    step caption
    color token inkMuted
    position absolute
    end 16
    bottom 12
  }
}
