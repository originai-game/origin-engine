type screen
version 1
---
# HUD layout editor (docs/ui.md Appendix B: settings, its HUD layout
# editor; §8.4 the player-customised HUD). Over the live HUD, which keeps
# drawing under it: a hint at the top, and the editor's panel at the foot.
# The HUD's elements that declare `customize true` are what the player
# drags; og.ui.setHudEdit(true) turns the edit mode on when it is pushed.
#
# Slot Editor takes og.ui.hudLayoutEditor("Editor", desc): the selected
# element's key, its size and opacity steps, Next (how keys and pads pick
# an element), Reset (the selected one, or all with none selected) and
# Done, which turns the edit mode off. Its HudEditorDesc is its words:
# title, sizeLabel, opacityLabel, nextLabel, resetLabel, doneLabel. Its
# HudEditorResult: done (code pops this screen and saves
# og.ui.hudLayout()), changed. Inside settings, the tree's HUD page mounts
# the same editor; this screen is it outside the menu.
#
# Viewmodel: showHint (the hint at the top). Events to code: back (the
# Back action: og.ui.setHudEdit(false), then og.ui.pop, as Done).
name "hud-editor"
layer modal
under none
pause true
back emit back
props {
  showHint bool "The hint at the top shows (false once the player has moved something)."
}
actions {
  back "Done"
}
fixture default "{\"showHint\": true}"
stack Editor {
  width grow
  height grow
  panel Hint {
    position absolute
    top 24
    centerX true
    padding 10
    frame hud
    visible bind showHint
    at phone {
      top 56
    }
    label Text {
      key "screen.hud-editor.hint"
      text "Drag an element to move it."
      textAlign center
      maxLines 2
    }
  }
  slot Editor {
    position absolute
    bottom 24
    centerX true
    at phonePortrait {
      start 8
      end 8
      bottom 40
    }
    at phoneLandscape {
      start 52
      end 52
      bottom 24
    }
  }
}
