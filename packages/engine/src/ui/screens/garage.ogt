type screen
version 1
---
# Garage, tuning and livery editor (docs/ui.md Appendix B). Back, the
# car's name, the Garage and Tuning views and Test drive at the head; under
# them the garage (parts and livery) or the game's tuning page.
#
# Slot Garage (the Garage view) takes og.ui.garage("Garage", desc): the
# categories' rail, the category's parts with their pips, prices, locks
# and fitted ticks, the car on its lit turntable, the performance card
# (class badge, rating and each figure with the selected part's change),
# the part's detail and one action (Equip, Buy, Equipped); a livery
# category turns the list into the car's layers with a colour picker, Add
# layer and Delete. Its GarageDesc: balance, currencyImage, categories ({
# key, name, image, count, livery }), category, parts ({ key, name, image,
# rarity, rarityLabel, tier, tierMax, price, owned, equipped, locked,
# lockedHint, description }), selected, vehicle (the car's texture, a
# render target for a 3D car), stats ({ key, label, value, preview, max
# }), ratingClass, rating, ratingPreview, layers ({ key, name, kind,
# color, visible, locked }), layer, swatches and its words; its title is
# the document's, so pass it empty. Its GarageResult (category, selected,
# equip, buy, refused and the livery's layer edits) is the game's to
# apply. Slot Tuning (the Tuning view) takes the game's setup: an
# og.ui.valueSlider row per setting (gearing, camber, downforce) and
# og.ui.statCompare of what they change.
#
# Viewmodel: name, view (garage or tuning). Events to code: view (the
# click wrote view), testDrive; Back pops it.
name "garage"
layer menu
under hide
focus "Body/Garage"
props {
  name string "The car's name."
  view string "garage or tuning."
}
actions {
  confirm "Select"
  back "Back"
  tabNext "Next category"
  tabPrev "Previous category"
}
fixture default "{\"name\": \"Kestrel GT\", \"view\": \"garage\"}"
column Screen {
  width grow
  height grow
  padding 24
  gap 12
  at phone {
    padding 12
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Name {
      text bind name
      step xl2
      heading true
      maxLines 1
      ellipsis true
      at phone {
        step xl
      }
    }
    spacer
    button GarageView {
      key "screen.garage.garage"
      text "Garage"
      variant ghost
      on click set view "\"garage\""
      on click emit view
      state selection bind "view == \"garage\"" {
        off {
          opacity 0.85
        }
        on {
          opacity 1
        }
      }
    }
    button TuningView {
      key "screen.garage.tuning"
      text "Tuning"
      variant ghost
      on click set view "\"tuning\""
      on click emit view
      state selection bind "view == \"tuning\"" {
        off {
          opacity 0.85
        }
        on {
          opacity 1
        }
      }
    }
    button TestDrive {
      key "screen.garage.testDrive"
      text "Test drive"
      size small
      at phone {
        size medium
      }
      on click emit testDrive
    }
  }
  column Body {
    width grow
    height grow
    slot Garage {
      width grow
      height grow
      visible bind "view != \"tuning\""
    }
    scroll TuningScroll {
      width grow
      height grow
      visible bind "view == \"tuning\""
      slot Tuning {
        width grow
      }
    }
  }
}
