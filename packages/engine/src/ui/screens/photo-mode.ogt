type screen
version 1
---
# Photo mode (docs/ui.md Appendix B). The game frozen under it with the
# HUD hidden, the photo mode's controls over it, and the shots taken this
# session at the top start.
#
# Slot Controls (the whole surface) takes og.ui.photoMode("Mode", desc),
# over the game's own paused view, which it never draws: the panel with
# its title, tabs and each tab's sliders (og.ui.valueSlider) or the
# filters' and frames' tiles with the filter's strength, the shutter
# between Grid, Hide UI, Reset and Exit, the rule of thirds and the chosen
# frame's art over the picture, the hint while hidden and the shutter's
# flash (a sheet at the foot on a phone in portrait). Its PhotoModeDesc:
# tabs ({ key, label }), tab, controls ({ key, tab, label, value, min,
# max, step, unit, digits, origin }), filters and frames ({ key, name,
# image, tint }), filter, strength, frame, frameImage, grid, hidden,
# flashMs and its words (title, captureLabel, hideLabel, gridLabel,
# resetLabel, exitLabel, strengthLabel, hiddenHint). Its PhotoModeResult
# (tab, set, filter, strength, frame, grid, hide, capture, reset, exit)
# moves the camera and the look; capture takes the shot (og.render's
# capture) and exit pops this screen.
#
# Viewmodel: hidden (the controls are hidden: the Gallery button too),
# shots. Events to code: gallery (the shots taken), back (the Back action:
# show the controls when hidden, else leave as Exit does; the layer leaves
# Back to code).
name "photo-mode"
layer modal
under none
pause true
back emit back
props {
  hidden bool "The controls are hidden (the pattern's hidden): the Gallery button hides with them."
  shots number "Photos taken this session."
}
actions {
  confirm "Take photo"
  back "Exit"
  details "Hide"
}
fixture default "{\"hidden\": false, \"shots\": 3}"
stack Photo {
  width grow
  height grow
  slot Controls {
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
  }
  button Gallery {
    text "Gallery ({shots})"
    position absolute
    start 24
    top 24
    visible bind "!hidden && shots > 0"
    on click emit gallery
    at phone {
      start 12
      top 56
    }
    at phoneLandscape {
      start 52
      top 12
    }
  }
}
