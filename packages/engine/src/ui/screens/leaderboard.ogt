type screen
version 2
---
# Leaderboards (docs/ui.md Appendix B: global, friends, leagues). Global,
# Friends and League tabs, the period, the top players with their rank,
# name and score, the player's own row pinned at the foot, and the
# league's promotion and demotion lines.
#
# Viewmodel: tab, period, rows, me (the player's own row), league (its
# name and the lines: { name, promote, demote, ends }). Events to code:
# tab (the click wrote tab), period, row (the click wrote selected: code
# shows the profile) (Back pops it). Slots: Board takes og.ui.table or og.ui.
# dataList when the board is long (10,000 rows, built in view only) instead
# of the rows below.
name "leaderboard"
layer menu
focus "Body/List"
props {
  tab string "global, friends or league."
  period string "The period, as text (This week)."
  rows list "The top rows: { rank, name, score, you (bool), texture }."
  selected number "The row pressed last."
  me object "The player's row: { rank, name, score }."
  league object "The league: { name, promote (rank), demote (rank), ends (seconds) }."
}
actions {
  confirm "Profile"
  back "Back"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"tab\": \"global\", \"period\": \"This week\", \"rows\": [{\"rank\": 1, \"name\": \"Nyx\", \"score\": 982140, \"you\": false, \"texture\": 0}, {\"rank\": 2, \"name\": \"Ferro\", \"score\": 951300, \"you\": false, \"texture\": 0}, {\"rank\": 3, \"name\": \"Lumen\", \"score\": 948020, \"you\": false, \"texture\": 0}, {\"rank\": 4, \"name\": \"Quill\", \"score\": 902210, \"you\": false, \"texture\": 0}], \"selected\": -1, \"me\": {\"rank\": 1284, \"name\": \"You\", \"score\": 402110}, \"league\": {\"name\": \"Gold league\", \"promote\": 10, \"demote\": 25, \"ends\": 259200}}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 12px
  @media phone {
    padding: 16px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    flex-wrap: wrap
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.leaderboard.title"
      text "Leaderboard"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
    spacer
    button Period {
      text bind period
      size small
      @media phone {
        size medium
      }
      on click emit period
    }
  }
  row Tabs {
    gap: 6px
    focusGroup wrap
    button Global {
      key "screen.leaderboard.global"
      text "Global"
      variant ghost
      on click set tab "\"global\""
      state selection bind "tab == \"global\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Friends {
      key "screen.leaderboard.friends"
      text "Friends"
      variant ghost
      on click set tab "\"friends\""
      state selection bind "tab == \"friends\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button League {
      key "screen.leaderboard.league"
      text "League"
      variant ghost
      on click set tab "\"league\""
      state selection bind "tab == \"league\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
  }
  row LeagueBar {
    width: stretch
    gap: 12px
    padding: 10px
    align-items: center
    flex-wrap: wrap
    background: var(--panel-raised)
    -og-frame: card
    visible bind "tab == \"league\""
    label Name {
      text bind league.name
      font: var(--text-lg)
      heading true
    }
    label Lines {
      text "Top {league.promote} go up · below {league.demote} go down"
      font: var(--text-caption)
      color: var(--ink-muted)
    }
    spacer
    label Ends {
      text "{league.ends, duration}"
      font: var(--text-caption)
    }
  }
  scroll Body {
    width: stretch
    height: stretch
    column List {
      width: stretch
      gap: 4px
      focusGroup stop
      slot Board {
        width: stretch
      }
      for r in rows {
        row Row {
          width: stretch
          padding: 8px
          gap: 12px
          align-items: center
          border-radius: 8px
          interactive true
          focusable true
          on click set selected "$index"
          on click emit row
          label Rank {
            text bind r.rank ordinal
            width: 56px
            font: var(--text-lg)
          }
          art Avatar {
            kind emblem
            width: 36px
            height: 36px
            texture bind r.texture
          }
          label Name {
            text bind r.name
            width: stretch
            line-clamp: 1
            text-overflow: ellipsis
          }
          label Score {
            text bind r.score grouped
          }
          state mine bind r.you {
            other {
              background: var(--panel)
            }
            you {
              background: var(--primary-soft)
            }
          }
          :hover {
            scale: 1.01
          }
          :active {
            scale: 0.99
          }
          :focus-visible {
            scale: 1.01
          }
          -og-state-transition: var(--motion-ui)
        }
      }
    }
  }
  row Me {
    width: stretch
    padding: 10px
    gap: 12px
    align-items: center
    background: var(--panel-raised)
    -og-frame: card
    label Rank {
      text bind me.rank ordinal
      width: 56px
      font: var(--text-lg)
    }
    label Name {
      text bind me.name
      width: stretch
      line-clamp: 1
      text-overflow: ellipsis
    }
    label Score {
      text bind me.score grouped
      font: var(--text-lg)
    }
  }
}
