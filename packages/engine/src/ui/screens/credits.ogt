type screen
version 2
---
# Credits (docs/ui.md Appendix B). The roll: the game's logo, then each
# section's heading and its names, scrolling up on their own; a press
# speeds it, Back leaves; the licences at the end.
#
# Viewmodel: sections, offset (how far the roll has run, CSS px: code
# advances it each tick, faster while held). Events to code: faster (a
# press) (Back pops it). Slots: End takes what follows the roll (a thank-you, a
# last scene: og.ui.prose, og.ui.artSlot); Licences takes the third-party
# notices (og.ui.prose).
name "credits"
layer menu
under hide
capture true
props {
  sections list "The sections: { title, names: [{ name, role }] }."
  offset number "How far the roll has run, CSS px."
}
actions {
  confirm "Faster"
  back "Back"
}
fixture default "{\"sections\": [{\"title\": \"Directed by\", \"names\": [{\"name\": \"Ada Lin\", \"role\": \"\"}]}, {\"title\": \"Art\", \"names\": [{\"name\": \"Tomas Reyes\", \"role\": \"Lead artist\"}, {\"name\": \"Mira Okafor\", \"role\": \"Environment\"}]}, {\"title\": \"Music\", \"names\": [{\"name\": \"Jun Sato\", \"role\": \"Composer\"}]}], \"offset\": 0}"
stack Credits {
  width: stretch
  height: stretch
  background: var(--backdrop)
  interactive true
  on click emit faster
  on action confirm emit faster
  column Roll {
    position: absolute
    inset-inline-start: 0
    inset-inline-end: 0
    top: 0
    padding: 48px
    gap: 40px
    align-items: center
    translate: 0 bind("-offset")
    @media phone {
      padding: 24px
      gap: 28px
    }
    art Logo {
      kind logo
      width: 360px
      height: 140px
      @media phone {
        width: 240px
        height: 94px
      }
    }
    for s in sections {
      column Section {
        width: stretch; max-width: 640px
        gap: 10px
        align-items: center
        label Title {
          text bind s.title
          font: var(--text-caption)
          color: var(--ink-muted)
          text-align: center
        }
        for n in s.names {
          column Person {
            align-items: center
            gap: 2px
            label Name {
              text bind n.name
              font: var(--text-xl)
              text-align: center
            }
            label Role {
              text bind n.role
              font: var(--text-caption)
              color: var(--ink-muted)
              visible bind "n.role != \"\""
            }
          }
        }
      }
    }
    slot End {
      width: stretch; max-width: 640px
    }
    slot Licences {
      width: stretch; max-width: 640px
    }
  }
  button Back {
    key "screen.common.back"
    text "Back"
    variant quiet
    position: absolute
    inset-inline-start: 16px
    top: 16px
    on click pop
  }
}
