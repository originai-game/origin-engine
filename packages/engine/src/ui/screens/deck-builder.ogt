type screen
version 1
---
# Deck builder and collection (docs/ui.md Appendix B). Back, the title,
# Rename and Clear at the head; under them the deck builder fills the
# screen.
#
# Slot Builder takes og.ui.deckBuilder("Builder", desc): the filters
# (cost, tier and kind chips, the search, the sort), the collection's grid
# (unowned cards dimmed, the hovered one large), and the deck beside it
# with its name, art and count, its rows by cost, the mana curve, the
# kinds' counts and Done (on a phone in portrait the two halves are tabs).
# Its DeckBuilderDesc: cards ({ key, name, cost, typeLine, kind, text,
# image, rarity, owned, count, limit }), deckName, deckImage, deckSize,
# copyLimit, the filters' state (costFilter, rarityFilter, kindFilter,
# search, sort, view), their lists (rarities, kinds, sorts) and its words
# (allLabel, searchLabel, sortLabel, collectionLabel, deckLabel,
# curveLabel, kindsLabel, doneLabel, fullLabel, limitLabel, unownedLabel,
# emptyLabel); its title is the document's, so pass it empty. Its
# DeckBuilderResult (add, remove, refused, the filters' changes, view,
# done) is the game's to apply; done saves the deck and pops this screen.
#
# Viewmodel: dirty (unsaved changes). Events to code: rename (code asks
# for the name: og.ui.dialog over og.ui.inputField), clear, back (the Back
# button and the Back action: code asks before dropping unsaved changes,
# og.ui.confirm, then og.ui.pop).
name "deck-builder"
layer menu
back emit back
focus "Builder"
props {
  dirty bool "The deck has unsaved changes."
}
actions {
  confirm "Add"
  back "Back"
}
fixture default "{\"dirty\": true}"
column Screen {
  width grow
  height grow
  padding 24
  gap 12
  at phone {
    padding 12
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click emit back
    }
    label Title {
      key "screen.deck-builder.title"
      text "Deck builder"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    badge Unsaved {
      key "screen.deck-builder.unsaved"
      text "Unsaved"
      tone warn
      visible bind dirty
    }
    spacer
    button Rename {
      key "screen.deck-builder.rename"
      text "Rename"
      variant quiet
      size small
      at phone {
        size medium
      }
      on click emit rename
    }
    button Clear {
      key "screen.deck-builder.clear"
      text "Clear"
      variant quiet
      size small
      at phone {
        size medium
      }
      on click emit clear
    }
  }
  slot Builder {
    width grow
    height grow
  }
}
