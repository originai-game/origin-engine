type screen
version 1
---
# Song and track select with preview (docs/ui.md Appendix B). The songs
# (or tracks) on a wheel, the selected one's jacket, charts, best score and
# preview, and Play; sort and search at the head, the modifiers at the
# foot.
#
# Viewmodel: count (songs shown), sort (as text), query. Events to code:
# sort, search (the field wrote query), mods (open the modifiers) (Back pops it).
# Slots: Select takes og.ui.songSelect (the wheel, the detail with its
# charts and score, the preview with its waveform, Play; it answers the
# song and chart moves, the preview toggle and Play); for a racing game's
# track select, the same slot takes og.ui.carousel of tracks with their
# thumbnail (art kind levelThumb) and og.ui.keyValueRows of the lap
# record; ModList takes the modifiers (og.ui.segmented, og.ui.toggleSwitch).
name "song-select"
layer menu
focus "Body/Select"
props {
  count number "Songs shown."
  sort string "What the wheel is sorted by, as text."
  query string "The search's text (two-way)."
}
actions {
  confirm "Play"
  back "Back"
  tabNext "Next chart"
  tabPrev "Previous chart"
}
fixture default "{\"count\": 128, \"sort\": \"Title\", \"query\": \"\"}"
column Screen {
  width grow
  height grow
  padding 16
  gap 8
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Count {
      text "{count, plural, one {# song} other {# songs}}"
      color token inkMuted
    }
    spacer
    field Search {
      width grow 140 280
      input bind query
      placeholder "Search"
      on changed emit search
    }
    button Sort {
      text "Sort: {sort}"
      size small
      at phone {
        size medium
      }
      on click emit sort
    }
  }
  column Body {
    width grow
    height grow
    gap 8
    slot Select {
      width grow
      height grow
    }
    row Mods {
      width grow
      gap 8
      cross center
      slot ModList {
        width grow
      }
      button Open {
        key "screen.song-select.mods"
        text "Modifiers"
        size small
        at phone {
          size medium
        }
        on click emit mods
      }
    }
  }
}
