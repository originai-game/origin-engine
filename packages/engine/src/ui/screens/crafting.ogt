type screen
version 1
---
# Crafting and recipe book (docs/ui.md Appendix B). The recipes by
# category with a search, each marked when it can be made; the selected
# recipe's result, its ingredients against what the player has, the
# station it needs, an amount and Craft (held for many).
#
# Viewmodel: categories, category, query, recipes, selected, recipe,
# amount. Events to code: category, search (the field wrote query), select
# (the click wrote selected), craft (Back pops it). Slots: Result takes the
# result's tooltip (og.ui.tooltipCard); Amount takes og.ui.numberStepper;
# Craft takes og.ui.holdButton when crafting many at once is held.
name "crafting"
layer menu
pause true
focus "Body/Recipes/List"
props {
  categories list "The categories: { name }."
  category number "The selected category's index."
  query string "The search's text (two-way)."
  recipes list "The recipes shown: { name, can (bool), known (bool), texture }."
  selected number "The selected recipe's index."
  recipe object "The selected recipe: { name, text, station, stationHere (bool), ingredients: [{ name, need, have, texture }] }."
  amount number "How many to craft."
}
actions {
  confirm "Craft"
  back "Back"
}
fixture default "{\"categories\": [{\"name\": \"All\"}, {\"name\": \"Tools\"}, {\"name\": \"Food\"}], \"category\": 0, \"query\": \"\", \"recipes\": [{\"name\": \"Iron pick\", \"can\": true, \"known\": true, \"texture\": 0}, {\"name\": \"Lantern\", \"can\": false, \"known\": true, \"texture\": 0}, {\"name\": \"???\", \"can\": false, \"known\": false, \"texture\": 0}], \"selected\": 0, \"recipe\": {\"name\": \"Iron pick\", \"text\": \"Breaks stone and ore.\", \"station\": \"Anvil\", \"stationHere\": true, \"ingredients\": [{\"name\": \"Iron bar\", \"need\": 3, \"have\": 5, \"texture\": 0}, {\"name\": \"Wood\", \"need\": 2, \"have\": 1, \"texture\": 0}]}, \"amount\": 1}"
column Screen {
  width grow
  height grow
  padding 32
  gap 12
  at phone {
    padding 16
  }
  at phoneLandscape {
    padding 8
    gap 6
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.crafting.title"
      text "Crafting"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    spacer
    field Search {
      width grow 160 320
      input bind query
      placeholder "Search recipes"
      on changed emit search
    }
  }
  row Categories {
    width grow
    gap 6
    wrap true
    for c in categories {
      button Category {
        text bind c.name
        variant ghost
        size small
        at phone {
          size medium
        }
        on click set category "$index"
        on click emit category
        state selection bind "$index == category" {
          off {
            opacity 0.7
          }
          on {
            opacity 1
          }
        }
      }
    }
  }
  grid Body {
    width grow
    height grow
    gap 24
    columns "1fr" "1fr"
    rows "1fr"
    at phonePortrait {
      columns "1fr"
      rows "1fr" auto
      gap 12
    }
    scroll Recipes {
      width grow
      height grow
      column List {
        width grow
        gap 4
        focusGroup stop
        for r in recipes {
          row Recipe {
            width grow
            padding 8
            gap 10
            cross center
            radius 8
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            art Icon {
              kind itemIcon
              width 40
              height 40
              texture bind r.texture
            }
            label Name {
              text bind r.name
              width grow
              maxLines 1
              ellipsis true
            }
            badge Can {
              key "screen.crafting.can"
              text "Ready"
              tone success
              visible bind r.can
            }
            state selection bind "$index == selected" {
              off {
                background token panel
              }
              on {
                background token primarySoft
              }
              transition any any token ui
            }
            state know bind r.known {
              unknown {
                opacity 0.5
              }
              known {
                opacity 1
              }
            }
            state interaction {
              normal {
                scale 1
              }
              hover {
                scale 1.01
              }
              pressed {
                scale 0.99
              }
              focused {
                scale 1.01
              }
              transition any any token ui
            }
          }
        }
      }
    }
    column Detail {
      width grow
      padding 16
      gap 10
      frame panel
      row Head {
        width grow
        gap 12
        cross center
        slot Result {
        }
        column Text {
          width grow
          gap 2
          label Name {
            text bind recipe.name
            step lg
            heading true
          }
          label Line {
            text bind recipe.text
            color token inkMuted
            maxLines 2
          }
        }
      }
      label IngredientsTitle {
        key "screen.crafting.ingredients"
        text "Ingredients"
        step caption
        color token inkMuted
      }
      column Ingredients {
        width grow
        gap 6
        for i in recipe.ingredients {
          row Ingredient {
            width grow
            gap 8
            cross center
            art Icon {
              kind itemIcon
              width 32
              height 32
              texture bind i.texture
            }
            label Name {
              text bind i.name
              width grow
              maxLines 1
              ellipsis true
            }
            label Count {
              text "{i.have}/{i.need}"
              state enough bind "i.have >= i.need" {
                short {
                  ink token danger
                }
                enough {
                  ink token ink
                }
              }
            }
          }
        }
      }
      row Station {
        width grow
        gap 8
        label Label {
          key "screen.crafting.station"
          text "Station"
          step caption
          color token inkMuted
        }
        label Name {
          text bind recipe.station
          step caption
        }
        badge Missing {
          key "screen.crafting.noStation"
          text "Not here"
          tone warn
          visible bind "!recipe.stationHere"
        }
      }
      row Actions {
        width grow
        gap 8
        cross center
        slot Amount {
        }
        spacer
        slot Craft {
        }
        button CraftOne {
          key "screen.crafting.craft"
          text "Craft"
          variant primary
          disabled bind "!recipes.length || !recipe.stationHere"
          on click emit craft
        }
      }
    }
  }
}
