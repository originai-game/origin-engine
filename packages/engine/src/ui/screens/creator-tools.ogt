type screen
version 2
---
# Creator tools (docs/ui.md Appendix B: inspector, hierarchy,
# catalogues). An editor's chrome around the world view: the toolbar
# (select, move, rotate, scale, play), the hierarchy at the start side,
# the inspector at the end, the catalogue at the foot; on a phone the
# panels are tabs over the view.
#
# Viewmodel: tool (select, move, rotate or scale), playing, selected (the
# selected object's name), panel (on a phone: the open panel), dirty.
# Events to code: tool (the click wrote tool), play, save, undo, redo,
# exit. Slots: View takes the world view with its gizmos (og.ui.viewport);
# Hierarchy takes og.ui.tree of the scene's objects; Inspector takes the
# selected object's properties (og.ui.keyValueRows, og.ui.inputField,
# og.ui.numberStepper, og.ui.colorPicker per reflected field); Catalogue
# takes the assets to place (og.ui.searchBox over og.ui.dataGrid of
# thumbnails, art kind levelThumb or itemIcon).
name "creator-tools"
layer menu
under none
input all
back emit exit
props {
  tool string "select, move, rotate or scale."
  playing bool "The world is playing."
  selected string "The selected object's name (empty: none)."
  panel string "On a phone, the open panel: hierarchy, inspector or catalogue."
  dirty bool "Unsaved changes."
}
actions {
  back "Exit"
}
fixture default "{\"tool\": \"move\", \"playing\": false, \"selected\": \"Lantern_03\", \"panel\": \"inspector\", \"dirty\": true}"
column Editor {
  width: stretch
  height: stretch
  row Toolbar {
    width: stretch
    padding: 8px
    gap: 6px
    align-items: center
    background: var(--panel)
    -og-frame: panel
    flex-wrap: wrap
    button Select {
      key "screen.creator-tools.select"
      text "Select"
      variant ghost
      size small
      @media phone-portrait {
        size medium
      }
      on click set tool "\"select\""
      state selection bind "tool == \"select\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Move {
      key "screen.creator-tools.move"
      text "Move"
      variant ghost
      size small
      @media phone-portrait {
        size medium
      }
      on click set tool "\"move\""
      state selection bind "tool == \"move\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Rotate {
      key "screen.creator-tools.rotate"
      text "Rotate"
      variant ghost
      size small
      @media phone-portrait {
        size medium
      }
      on click set tool "\"rotate\""
      state selection bind "tool == \"rotate\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    button Scale {
      key "screen.creator-tools.scale"
      text "Scale"
      variant ghost
      size small
      @media phone-portrait {
        size medium
      }
      on click set tool "\"scale\""
      state selection bind "tool == \"scale\"" {
        off {
          opacity: 0.85
        }
        on {
          opacity: 1
        }
      }
    }
    spacer
    button Undo {
      key "screen.creator-tools.undo"
      text "Undo"
      size small
      @media phone-portrait {
        size medium
      }
      variant quiet
      on click emit undo
    }
    button Redo {
      key "screen.creator-tools.redo"
      text "Redo"
      size small
      @media phone-portrait {
        size medium
      }
      variant quiet
      on click emit redo
    }
    button Play {
      key "screen.creator-tools.play"
      text "Play"
      size small
      @media phone-portrait {
        size medium
      }
      variant primary
      on click emit play
      state run bind playing {
        stopped {
          opacity: 1
        }
        playing {
          opacity: 0.8
        }
      }
    }
    button Save {
      key "screen.common.save"
      text "Save"
      size small
      @media phone-portrait {
        size medium
      }
      disabled bind "!dirty"
      on click emit save
    }
  }
  grid Body {
    width: stretch
    height: stretch
    grid-template-columns: 260px 1fr 320px
    grid-template-rows: 1fr 200px
    grid-template-areas: "tree view inspector" "tree catalogue inspector"
    @media tablet {
      grid-template-columns: 220px 1fr 280px
    }
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto 260px
      grid-template-areas: "view" "tabs" "panel"
    }
    column TreePanel {
      width: stretch
      height: stretch
      padding: 8px
      gap: 6px
      background: var(--panel)
      -og-frame: panel
      grid-area: tree
      @media phone-portrait {
        grid-area: panel
        visible bind "panel == \"hierarchy\""
      }
      label Title {
        key "screen.creator-tools.hierarchy"
        text "Hierarchy"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      slot Hierarchy {
        width: stretch
        height: stretch
      }
    }
    slot View {
      width: stretch
      height: stretch
      grid-area: view
    }
    row Tabs {
      width: stretch
      gap: 6px
      padding: 6px
      visible false
      grid-area: tabs
      @media phone-portrait {
        visible true
      }
      button Hierarchy {
        key "screen.creator-tools.hierarchy"
        text "Hierarchy"
        size small
        @media phone-portrait {
          size medium
        }
        variant ghost
        on click set panel "\"hierarchy\""
      }
      button Inspector {
        key "screen.creator-tools.inspector"
        text "Inspector"
        size small
        @media phone-portrait {
          size medium
        }
        variant ghost
        on click set panel "\"inspector\""
      }
      button Catalogue {
        key "screen.creator-tools.catalogue"
        text "Catalogue"
        size small
        @media phone-portrait {
          size medium
        }
        variant ghost
        on click set panel "\"catalogue\""
      }
    }
    column InspectorPanel {
      width: stretch
      height: stretch
      padding: 8px
      gap: 6px
      background: var(--panel)
      -og-frame: panel
      grid-area: inspector
      @media phone-portrait {
        grid-area: panel
        visible bind "panel == \"inspector\""
      }
      label Selected {
        text bind selected
        font: var(--text-lg)
        line-clamp: 1
        text-overflow: ellipsis
      }
      scroll Scroll {
        width: stretch
        height: stretch
        slot Inspector {
          width: stretch
        }
      }
    }
    column CataloguePanel {
      width: stretch
      height: stretch
      padding: 8px
      gap: 6px
      background: var(--panel)
      -og-frame: panel
      grid-area: catalogue
      @media phone-portrait {
        grid-area: panel
        visible bind "panel == \"catalogue\""
      }
      label Title {
        key "screen.creator-tools.catalogue"
        text "Catalogue"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
      slot Catalogue {
        width: stretch
        height: stretch
      }
    }
  }
}
