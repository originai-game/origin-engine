type screen
version 1
---
# Character, loadout, paperdoll and stats (docs/ui.md Appendix B). Tabs
# for Equipment and Loadout over the character's paperdoll and stats,
# with the hovered item's comparison at the end side.
#
# Viewmodel: name, level, className, tab, stats. Events to code: tab (the
# click wrote tab) (Back pops it). Slots: Paperdoll takes og.ui.paperdoll (the
# figure, the equipment slots and the stats with deltas; its own figure
# slot takes a sceneViewport turntable); Compare takes og.ui.statCompare
# or og.ui.tooltipCard for the item under the pointer or the focus.
#
# PATTERN PENDING (U6d): the loadout pattern mounts in the slot Loadout
# (weapon sets, ability and perk slots, saved presets). Until it lands,
# code fills Loadout from og.ui.abilityBar and og.ui.card.
name "character"
layer menu
focus "Tabs/Equipment"
props {
  name string "The character's name."
  level number "Its level."
  className string "Its class or role."
  tab string "equipment or loadout."
  stats list "The headline stats: { name, value }."
}
actions {
  back "Back"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"name\": \"Mara\", \"level\": 24, \"className\": \"Ranger\", \"tab\": \"equipment\", \"stats\": [{\"name\": \"Power\", \"value\": 412}, {\"name\": \"Armour\", \"value\": 268}, {\"name\": \"Speed\", \"value\": 105}]}"
column Screen {
  width grow
  height grow
  padding 32
  gap 16
  at phone {
    padding 16
    gap 12
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    column Who {
      gap 2
      label Name {
        text bind name
        step xl2
        heading true
        at phone {
          step xl
        }
      }
      label Meta {
        text "Level {level} · {className}"
        color token inkMuted
      }
    }
    spacer
    row Stats {
      gap 16
      at phonePortrait {
        visible false
      }
      for s in stats {
        column Stat {
          cross center
          label Value {
            text bind s.value grouped
            step lg
          }
          label Name {
            text bind s.name
            step caption
            color token inkMuted
          }
        }
      }
    }
  }
  row Tabs {
    gap 8
    focusGroup wrap
    button Equipment {
      key "screen.character.equipment"
      text "Equipment"
      variant ghost
      on click set tab "\"equipment\""
      state selection bind "tab == \"equipment\"" {
        off {
          opacity 0.7
        }
        on {
          opacity 1
        }
      }
    }
    button Loadout {
      key "screen.character.loadout"
      text "Loadout"
      variant ghost
      on click set tab "\"loadout\""
      state selection bind "tab == \"loadout\"" {
        off {
          opacity 0.7
        }
        on {
          opacity 1
        }
      }
    }
  }
  grid Body {
    width grow
    height grow
    gap 24
    columns "2fr" "1fr"
    rows "1fr"
    at phonePortrait {
      columns "1fr"
      rows "1fr" auto
      gap 12
    }
    slot Paperdoll {
      width grow
      height grow
      visible bind "tab == \"equipment\""
    }
    slot Loadout {
      width grow
      height grow
      visible bind "tab == \"loadout\""
    }
    slot Compare {
      width grow
    }
  }
}
