type screen
version 2
---
# Mode select (docs/ui.md Appendix B: boot, splash, title, main menu, mode
# select). The game's modes as large cards with their art, a line each, a
# lock with its reason, and a tag (New, Ranked, Limited time).
#
# Viewmodel: modes, selected. Events to code: select (a card; the click's
# `set` already wrote `selected`), play (the selected mode) (Back pops it). Slots:
# Detail takes more about the selected mode (rules, rewards: og.ui.
# keyValueRows, og.ui.card).
name "mode-select"
layer menu
focus "Modes"
props {
  modes list "The modes: { name, line, tag, locked, reason, texture }."
  selected number "The index of the selected mode."
}
actions {
  confirm "Play"
  back "Back"
}
fixture default "{\"modes\": [{\"name\": \"Story\", \"line\": \"The campaign, alone or with a friend.\", \"tag\": \"\", \"locked\": false, \"reason\": \"\", \"texture\": 0}, {\"name\": \"Arena\", \"line\": \"Ranked fights, one life.\", \"tag\": \"Ranked\", \"locked\": false, \"reason\": \"\", \"texture\": 0}, {\"name\": \"Trials\", \"line\": \"Hard challenges for the brave.\", \"tag\": \"New\", \"locked\": true, \"reason\": \"Finish chapter 2\", \"texture\": 0}], \"selected\": 0}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 20px
  @media phone {
    padding: 16px
    gap: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.mode-select.title"
      text "Choose a mode"
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-xl)
      }
    }
  }
  scroll Scroll {
    width: stretch
    height: stretch
    grid Modes {
      width: stretch
      gap: 16px
      grid-template-columns: 1fr 1fr 1fr
      focusGroup wrap
      @media tablet {
        grid-template-columns: 1fr 1fr
      }
      @media phone-portrait {
        grid-template-columns: 1fr
        gap: 12px
      }
      for mode in modes {
        column Mode {
          width: stretch
          padding: 12px
          gap: 8px
          background: var(--panel-raised)
          -og-frame: card
          interactive true
          focusable true
          on click set selected "$index"
          on click emit select
          art Art {
            kind levelThumb
            width: stretch
            aspect-ratio: 1.78
            texture bind mode.texture
          }
          row Head {
            width: stretch
            gap: 8px
            align-items: center
            label Name {
              text bind mode.name
              font: var(--text-lg)
              heading true
            }
            spacer
            badge Tag {
              text bind mode.tag
              tone accent
              visible bind "mode.tag != \"\""
            }
          }
          label Line {
            text bind mode.line
            color: var(--ink-muted)
            line-clamp: 2
          }
          label Reason {
            text bind mode.reason
            font: var(--text-caption)
            color: var(--warn)
            visible bind mode.locked
          }
          state selection bind "$index == selected" {
            off {
              opacity: 0.85
            }
            on {
              opacity: 1
            }
            transition: var(--motion-ui)
          }
          state lock bind mode.locked {
            open {
              scale: 1
            }
            locked {
              opacity: 0.55
            }
          }
          :hover {
            translate: 0 -4px
          }
          :active {
            translate: 0 0
          }
          :focus-visible {
            translate: 0 -4px
          }
          -og-state-transition: var(--motion-ui)
        }
      }
    }
  }
  slot Detail {
    width: stretch
  }
  row Footer {
    width: stretch
    gap: 12px
    justify-content: end
    button Play {
      key "screen.mode-select.play"
      text "Play"
      variant primary
      size large
      disabled bind "modes.length == 0"
      on click emit play
      on action confirm emit play
      @media phone {
        width: stretch
      }
    }
  }
}
