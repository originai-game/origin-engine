type screen
version 2
---
# Save and load with thumbnails (docs/ui.md Appendix B). The slots as
# cards, each its thumbnail, title, place, time played and date, an
# autosave tag; Save or Load acts on the selected one, Delete asks first.
#
# Viewmodel: mode ("save" or "load"), slots, selected. Events to code:
# select (the click wrote selected), save, load, delete (code asks with
# og.ui.confirm), newSlot. Slots: Preview takes the selected save's
# detail (party, quest, og.ui.keyValueRows).
name "save-load"
layer menu
focus "Body/Slots/List"
props {
  mode string "save or load: the title and the main action."
  slots list "The saves: { title, place, played (seconds), date (text), auto (bool), empty (bool), thumb (texture) }."
  selected number "The selected slot's index."
}
actions {
  confirm "Select"
  back "Back"
  details "Delete"
}
fixture default "{\"mode\": \"load\", \"slots\": [{\"title\": \"Chapter 3\", \"place\": \"Old mill\", \"played\": 15120, \"date\": \"Today 18:42\", \"auto\": true, \"empty\": false, \"thumb\": 0}, {\"title\": \"Chapter 2\", \"place\": \"Harbour\", \"played\": 9800, \"date\": \"Yesterday\", \"auto\": false, \"empty\": false, \"thumb\": 0}, {\"title\": \"\", \"place\": \"\", \"played\": 0, \"date\": \"\", \"auto\": false, \"empty\": true, \"thumb\": 0}], \"selected\": 0}"
column Screen {
  width: stretch
  height: stretch
  padding: 32px
  gap: 16px
  @media phone {
    padding: 16px
    gap: 12px
  }
  row Header {
    width: stretch
    gap: 12px
    align-items: center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label SaveTitle {
      key "screen.save-load.saveTitle"
      text "Save game"
      font: var(--text-xl2)
      heading true
      visible bind "mode == \"save\""
      @media phone {
        font: var(--text-xl)
      }
    }
    label LoadTitle {
      key "screen.save-load.loadTitle"
      text "Load game"
      font: var(--text-xl2)
      heading true
      visible bind "mode != \"save\""
      @media phone {
        font: var(--text-xl)
      }
    }
  }
  grid Body {
    width: stretch
    height: stretch
    gap: 24px
    grid-template-columns: 3fr 2fr
    grid-template-rows: 1fr
    @media phone-portrait {
      grid-template-columns: 1fr
      grid-template-rows: 1fr auto
      gap: 12px
    }
    scroll Slots {
      width: stretch
      height: stretch
      column List {
        width: stretch
        gap: 8px
        focusGroup stop
        for s in slots {
          row Slot {
            width: stretch
            padding: 10px
            gap: 12px
            align-items: center
            background: var(--panel-raised)
            -og-frame: card
            interactive true
            focusable true
            on click set selected "$index"
            on click emit select
            art Thumb {
              kind saveThumb
              width: 160px
              aspect-ratio: 1.78
              texture bind s.thumb
              @media phone {
                width: 96px
              }
            }
            column Text {
              width: stretch
              gap: 2px
              label Empty {
                key "screen.save-load.empty"
                text "Empty slot"
                font: var(--text-lg)
                visible bind s.empty
              }
              label Name {
                text bind s.title
                visible bind "!s.empty"
                font: var(--text-lg)
                line-clamp: 1
                text-overflow: ellipsis
              }
              label Place {
                text bind s.place
                color: var(--ink-muted)
                line-clamp: 1
                text-overflow: ellipsis
                visible bind "!s.empty"
              }
              row Meta {
                gap: 8px
                visible bind "!s.empty"
                label Played {
                  text "{s.played, duration}"
                  font: var(--text-caption)
                  color: var(--ink-muted)
                }
                label Date {
                  text bind s.date
                  font: var(--text-caption)
                  color: var(--ink-muted)
                }
              }
            }
            badge Auto {
              key "screen.save-load.auto"
              text "Auto"
              tone info
              visible bind s.auto
            }
            state selection bind "$index == selected" {
              off {
                opacity: 0.8
              }
              on {
                opacity: 1
                background: var(--primary-soft)
              }
              transition: var(--motion-ui)
            }
            :hover {
              scale: 1.01
            }
            :active {
              scale: 0.99
            }
            :focus-visible {
              scale: 1.01
            }
            -og-state-transition: var(--motion-ui)
          }
        }
      }
    }
    column Side {
      width: stretch
      gap: 12px
      slot Preview {
        width: stretch
        @media phone {
          visible false
        }
      }
      row Actions {
        width: stretch
        gap: 8px
        justify-content: end
        button Delete {
          key "screen.save-load.delete"
          text "Delete"
          variant danger
          on click emit delete
          on action details emit delete
        }
        button New {
          key "screen.save-load.new"
          text "New slot"
          visible bind "mode == \"save\""
          on click emit newSlot
        }
        button Save {
          key "screen.save-load.save"
          text "Save"
          variant primary
          visible bind "mode == \"save\""
          on click emit save
        }
        button Load {
          key "screen.save-load.load"
          text "Load"
          variant primary
          visible bind "mode != \"save\" && slots.length > 0"
          on click emit load
        }
      }
    }
  }
}
