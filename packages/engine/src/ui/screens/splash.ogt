type screen
version 2
---
# Boot and splash (docs/ui.md Appendix B: boot, splash, title, main menu,
# mode select). The studio's and partners' marks one after another, then
# the boot's progress while the first assets load. The engine's own boot
# splash (the brand's genesis motion) runs before the game's code; this is
# the game's, after it.
#
# Viewmodel: marks (the logos in order), mark (the one showing), progress,
# status. Events to code: skip (a press, a tap or confirm: code moves to
# the next mark or the title). Slots: Custom takes a mark the game draws
# itself (an animated logo, og.ui.emitter) instead of the art.
name "splash"
layer modal
under hide
back none
capture true
props {
  marks list "The marks in order: { name, texture } (texture: an og.load.texture handle, 0 for the placeholder)."
  mark number "The index of the mark showing now."
  progress number "Boot progress, 0 to 1 (below 0: no bar)."
  status string "What is loading, small under the bar (empty: nothing)."
}
actions {
  confirm "Skip"
}
fixture default "{\"marks\": [{\"name\": \"Studio\", \"texture\": 0}, {\"name\": \"Engine\", \"texture\": 0}], \"mark\": 0, \"progress\": 0.4, \"status\": \"Loading shaders\"}"
column Splash {
  width: stretch
  height: stretch
  padding: 48px
  gap: 24px
  justify-content: center
  align-items: center
  background: var(--backdrop)
  interactive true
  on click emit skip
  on action confirm emit skip
  @media phone {
    padding: 24px
  }
  spacer
  for m in marks {
    column Mark {
      gap: 12px
      align-items: center
      visible bind "$index == mark"
      -og-enter: fade
      -og-exit: fade
      art Art {
        kind logo
        width: 360px
        height: 160px
        texture bind m.texture
        @media phone {
          width: 260px
          height: 116px
        }
      }
      label Name {
        text bind m.name
        font: var(--text-caption)
        color: var(--ink-muted)
      }
    }
  }
  slot Custom {
  }
  spacer
  column Boot {
    width: stretch; max-width: 360px
    gap: 8px
    align-items: center
    visible bind "progress >= 0"
    progress Bar {
      width: stretch
      value bind progress
    }
    label Status {
      text bind status
      font: var(--text-caption)
      color: var(--ink-muted)
      line-clamp: 1
      text-overflow: ellipsis
    }
  }
}
