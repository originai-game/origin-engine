type screen
version 1
---
# Replay and spectator (docs/ui.md Appendix B). The match playing under
# it with the playback bar at the foot (play, pause, the speed, the time
# and the scrubber with its events), the camera's modes and the players to
# follow, and the spectator's overlays.
#
# Viewmodel: playing, speed, time, length, at (the scrubber, 0 to 1,
# two-way), events (marks on the timeline: { at (0 to 1), kind }), camera
# (as text), live (spectating live: no scrubbing past now). Events to
# code: play (toggle), slower, faster, seek (the slider wrote at), camera,
# exit. Slots: Players takes the players to follow (og.ui.partyFrames,
# og.ui.unitFrame); Overlay takes the spectator's overlays (og.ui.minimapView,
# og.ui.scoreboard, og.ui.matchStats).
name "replay"
layer hud
input menu
back emit exit
props {
  playing bool "Playback runs."
  speed number "Its speed (0.25 to 8)."
  time number "Seconds in."
  length number "The replay's length, seconds."
  at number "The scrubber, 0 to 1 (two-way)."
  events list "Marks on the timeline: { at (0 to 1), kind }."
  camera string "The camera's mode, as text (Free, Follow Aria)."
  live bool "Spectating live."
}
actions {
  confirm "Play / pause"
  back "Exit"
}
fixture default "{\"playing\": true, \"speed\": 1, \"time\": 412, \"length\": 1520, \"at\": 0.27, \"events\": [{\"at\": 0.1, \"kind\": \"kill\"}, {\"at\": 0.25, \"kind\": \"objective\"}], \"camera\": \"Follow Aria\", \"live\": false}"
stack Replay {
  width grow
  height grow
  slot Overlay {
    width grow
    height grow
    position absolute
    start 0
    top 0
    end 0
    bottom 0
  }
  column Side {
    position absolute
    end 16
    top 16
    gap 8
    at phonePortrait {
      visible false
    }
    at phoneLandscape {
      end 52
    }
    button Camera {
      text "Camera: {camera}"
      size small
      at phone {
        size medium
      }
      on click emit camera
    }
    slot Players {
    }
  }
  column Bar {
    position absolute
    start 16
    end 16
    bottom 16
    padding 10
    gap 6
    frame hud
    at phonePortrait {
      start 8
      end 8
      bottom 40
    }
    at phoneLandscape {
      start 52
      end 52
      bottom 24
    }
    slider Scrubber {
      width grow
      value bind at
      disabled bind live
      on changed emit seek
    }
    row Controls {
      width grow
      gap 8
      cross center
      button Slower {
        key "screen.replay.slower"
        text "<<"
        square true
        size small
        at phone {
          size medium
        }
        name "Slower"
        on click emit slower
      }
      button Play {
        text bind "playing ? \"||\" : \">\""
        square true
        size small
        at phone {
          size medium
        }
        name "Play or pause"
        on click emit play
        on action confirm emit play
      }
      button Faster {
        key "screen.replay.faster"
        text ">>"
        square true
        size small
        at phone {
          size medium
        }
        name "Faster"
        on click emit faster
      }
      label Speed {
        text "{speed}×"
        step caption
      }
      spacer
      badge Live {
        key "screen.replay.live"
        text "Live"
        tone danger
        visible bind live
      }
      label Time {
        text "{time, clock} / {length, clock}"
        step caption
        font mono
      }
      button Exit {
        key "screen.replay.exit"
        text "Exit"
        size small
        at phone {
          size medium
        }
        variant quiet
        on click emit exit
      }
    }
  }
}
