type screen
version 2
---
# Pause and system menu (docs/ui.md Appendix B). Over the dimmed game,
# which pauses while it is up: Resume, Settings, Controls, Save, Load,
# Quit to the menu and Quit the game, with the run's objective and time.
#
# Viewmodel: objective, played (seconds), canSave. Events to code: resume
# (also Back), settings, controls, save, load, quitToMenu, quit (code asks
# with og.ui.confirm before quitting). Slots: Side takes the game's own
# panel beside the menu (a map, a party sheet: og.ui.card).
name "pause"
layer menu
pause true
under blur
back emit resume
focus "Panel/Menu/Resume"
props {
  objective string "The current objective (empty: none)."
  played number "Seconds played this run."
  canSave bool "Saving is allowed here."
}
actions {
  confirm "Select"
  back "Resume"
}
fixture default "{\"objective\": \"Reach the lighthouse\", \"played\": 4520, \"canSave\": true}"
row Pause {
  width: stretch
  height: stretch
  padding: 32px
  gap: 24px
  justify-content: center
  align-items: center
  @media phone {
    padding: 16px
  }
  column Panel {
    width: stretch; max-width: 400px
    padding: 24px
    gap: 16px
    background: var(--panel)
    -og-frame: panel
    @media phone-landscape {
      width: stretch; max-width: 640px
      padding: 12px
      gap: 8px
    }
    -og-enter: slide-up 24px var(--motion-enter)
    label Title {
      key "screen.pause.title"
      text "Paused"
      font: var(--text-xl2)
      heading true
    }
    column Status {
      width: stretch
      gap: 4px
      @media phone-landscape {
        visible false
      }
      label Objective {
        text bind objective
        color: var(--ink-muted)
        line-clamp: 2
        visible bind "objective != \"\""
      }
      label Played {
        text "{played, duration}"
        font: var(--text-caption)
        color: var(--ink-muted)
      }
    }
    grid Menu {
      width: stretch
      gap: 8px
      grid-template-columns: 1fr
      focusGroup wrap
      @media phone-landscape {
        grid-template-columns: 1fr 1fr
      }
      button Resume {
        key "screen.pause.resume"
        text "Resume"
        variant primary
        width: stretch
        on click emit resume
      }
      button Settings {
        key "screen.pause.settings"
        text "Settings"
        width: stretch
        on click emit settings
      }
      button Controls {
        key "screen.pause.controls"
        text "Controls"
        width: stretch
        on click emit controls
      }
      button Save {
        key "screen.pause.save"
        text "Save"
        width: stretch
        disabled bind "!canSave"
        on click emit save
      }
      button Load {
        key "screen.pause.load"
        text "Load"
        width: stretch
        on click emit load
      }
      button QuitToMenu {
        key "screen.pause.quitToMenu"
        text "Quit to menu"
        variant quiet
        width: stretch
        on click emit quitToMenu
      }
      button Quit {
        key "screen.pause.quit"
        text "Quit game"
        variant danger
        width: stretch
        on click emit quit
      }
    }
  }
  slot Side {
    @media phone {
      visible false
    }
  }
}
