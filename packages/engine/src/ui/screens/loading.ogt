type screen
version 2
---
# Loading with tips, lore and progress (docs/ui.md Appendix B, §15.5). The
# destination's key art under a half scrim, never a flat field; one
# dominant element, the progress bar in the pack's track and fill with the
# place's name as its line, along the foot; a tip or a line of lore that
# changes on a press as the secondary card over it; "Continue" once loaded
# when the game waits for the player.
#
# Viewmodel: place, tip, progress, ready, waits. Events to code: nextTip
# (a press while loading), continue (a press once ready). Slots: Lore takes
# a richer card (an item, a character: og.ui.card, og.ui.prose).
name "loading"
layer modal
under hide
back none
capture true
props {
  keyArt number "The key art's texture (og.load.texture; 0: the style's placeholder)."
  place string "Where the player is going."
  tip string "A tip or a line of lore."
  progress number "0 to 1."
  ready bool "Loading is done."
  waits bool "The game waits for a press once ready."
}
actions {
  confirm "Continue"
}
fixture default "{\"place\": \"The Sunken Archive\", \"tip\": \"Dodging through an attack at the last moment slows time for a breath.\", \"progress\": 0.62, \"ready\": false, \"waits\": true}"
stack Loading {
  width: stretch
  height: stretch
  interactive true
  on click emit "nextTip"
  art Art {
    kind tutorial
    texture bind keyArt
    object-fit: cover
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  column Scrim {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
    background: #000000
    opacity: 0.5
  }
  column Foot {
    width: stretch
    height: stretch
    padding: 48px
    gap: 12px
    @media phone {
      padding: 24px
    }
    spacer
    column Tip {
      width: stretch; max-width: 720px
      padding: 16px
      gap: 6px
      background: var(--panel)
      -og-frame: panel
      label Eyebrow {
        key "screen.loading.tip"
        text "Tip"
        font: var(--text-caption)
        color: var(--primary)
      }
      label Text {
        text bind tip
        font: var(--text-reading)
        line-clamp: 4
      }
      slot Lore {
        width: stretch
      }
    }
    label Place {
      text bind place
      font: var(--text-xl2)
      heading true
      @media phone {
        font: var(--text-lg)
      }
    }
    row Progress {
      width: stretch
      gap: 12px
      align-items: center
      progress Bar {
        width: stretch
        height: 12px
        value bind progress
      }
      label Percent {
        text "{progress, percent}"
        font: var(--text-caption)
        color: var(--ink-muted)
        visible bind "!ready"
      }
      button Continue {
        key "screen.loading.continue"
        text "Continue"
        variant primary
        visible bind "ready && waits"
        autofocus true
        on click emit continue
        on action confirm emit continue
      }
    }
  }
}
