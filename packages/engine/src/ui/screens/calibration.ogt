type screen
version 1
---
# Calibration (docs/ui.md Appendix B: audio offset, brightness,
# controller). Three steps: brightness (the logo barely visible against the
# dark), the audio and video offset (tap with the beat; the measured
# offset), and the controller (the sticks' dead zones, a test of each
# button). Back and Next move between them; Done saves.
#
# Viewmodel: step (brightness, offset or controller), brightness (two-way,
# 0 to 1), offset (ms, two-way), taps (the taps measured), deadZone
# (two-way, 0 to 0.5). Events to code: next, tap (a press on the offset step),
# measure (start the beat), done, back. Slots: Test takes what the step
# shows (the brightness's dark logo: art kind logo; the beat's pulse:
# og.ui.progressRing; the controller's sticks and buttons drawn by the
# game: og.ui.viewport).
name "calibration"
layer menu
focus "Panel/Foot/Next"
props {
  step string "brightness, offset or controller."
  brightness number "The gamma's adjustment, 0 to 1 (two-way)."
  offset number "The audio offset in ms, -200 to 200 (two-way)."
  taps number "Taps measured so far."
  deadZone number "The sticks' dead zone, 0 to 0.5 (two-way)."
}
actions {
  confirm "Next"
  back "Back"
}
fixture default "{\"step\": \"offset\", \"brightness\": 0.5, \"offset\": 24, \"taps\": 6, \"deadZone\": 0.12}"
column Calibration {
  width grow
  height grow
  padding 32
  align center
  cross center
  at phone {
    padding 12
  }
  column Panel {
    width grow 0 640
    padding 24
    gap 16
    frame panel
    row Steps {
      width grow
      gap 8
      badge Brightness {
        key "screen.calibration.brightness"
        text "Brightness"
        tone neutral
        state at bind "step == \"brightness\"" {
          off {
            opacity 0.5
          }
          on {
            opacity 1
          }
        }
      }
      badge Offset {
        key "screen.calibration.offset"
        text "Audio offset"
        tone neutral
        state at bind "step == \"offset\"" {
          off {
            opacity 0.5
          }
          on {
            opacity 1
          }
        }
      }
      badge Controller {
        key "screen.calibration.controller"
        text "Controller"
        tone neutral
        state at bind "step == \"controller\"" {
          off {
            opacity 0.5
          }
          on {
            opacity 1
          }
        }
      }
    }
    slot Test {
      width grow
    }
    column BrightnessStep {
      width grow
      gap 8
      visible bind "step == \"brightness\""
      label Hint {
        key "screen.calibration.brightnessHint"
        text "Move the slider until the mark is barely visible."
        maxLines 3
      }
      slider Value {
        width grow
        value bind brightness
        stepBy 0.01
      }
    }
    column OffsetStep {
      width grow
      gap 8
      visible bind "step == \"offset\""
      label Hint {
        key "screen.calibration.offsetHint"
        text "Press on every beat. The offset is measured from your presses."
        maxLines 3
      }
      row Measure {
        width grow
        gap 12
        cross center
        button Start {
          key "screen.calibration.start"
          text "Start the beat"
          on click emit measure
        }
        button Tap {
          key "screen.calibration.tap"
          text "Tap"
          variant primary
          size large
          on click emit tap
        }
        label Taps {
          text "{taps} taps"
          step caption
          color token inkMuted
        }
      }
      row Manual {
        width grow
        gap 12
        cross center
        slider Value {
          width grow
          min -200
          max 200
          stepBy 1
          value bind offset
        }
        label Ms {
          text "{offset} ms"
          width 72
          textAlign end
        }
      }
    }
    column ControllerStep {
      width grow
      gap 8
      visible bind "step == \"controller\""
      label Hint {
        key "screen.calibration.controllerHint"
        text "Let go of the sticks, then press each button once."
        maxLines 3
      }
      row DeadZone {
        width grow
        gap 12
        cross center
        label Label {
          key "screen.calibration.deadZone"
          text "Dead zone"
        }
        slider Value {
          width grow
          min 0
          max 0.5
          stepBy 0.01
          value bind deadZone
        }
      }
    }
    row Foot {
      width grow
      gap 8
      align end
      button Back {
        key "screen.common.back"
        text "Back"
        variant quiet
        on click emit back
      }
      button Next {
        key "screen.calibration.next"
        text "Next"
        variant primary
        visible bind "step != \"controller\""
        on click emit next
      }
      button Done {
        key "screen.calibration.done"
        text "Done"
        variant primary
        visible bind "step == \"controller\""
        on click emit done
      }
    }
  }
}
