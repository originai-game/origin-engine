type screen
version 2
---
# Results and post-match (docs/ui.md Appendix B: grades, XP cascades,
# graphs). Victory or defeat, the grade, the stats, the XP and the level it
# reached, the rewards, the match's graphs, and Continue, Replay and Play
# again.
#
# Viewmodel: won, grade, title (the result's line), stats, level, xp (0 to
# 1, after), gained, rewards, tab. Events to code: continue, again,
# replay, tab (the click wrote tab). Slots: Graph takes the match's graphs
# (og.ui.chart: the gold or score over time; RTS, MOBA, 4X); Scores takes
# the final scoreboard (shooter.scoreboard); Celebration takes the level-up
# or the grade's flourish (og.ui.celebration, og.ui.numberCounter for the
# XP cascade).
name "results"
layer menu
under hide
back none
focus "Panel/Footer/Continue"
props {
  won bool "The player won."
  grade string "The grade (S, A, B …; empty: none)."
  title string "The result's line (Victory, Stage clear)."
  stats list "The stats: { name, value, best (bool) }."
  level number "The level after the match."
  xp number "Progress to the next level after the match, 0 to 1."
  gained number "XP gained."
  rewards list "The rewards: { name, amount, texture }."
  tab string "summary, graphs or board."
}
actions {
  confirm "Continue"
}
timeline land {
  track "Panel/Page/Head/Grade" scale {
    key 0 2
    key 260 0.92 out
    key 420 1 out
  }
  event 0 "" sound reward
}
fixture default "{\"won\": true, \"grade\": \"A\", \"title\": \"Victory\", \"stats\": [{\"name\": \"Score\", \"value\": 48210, \"best\": true}, {\"name\": \"Kills\", \"value\": 14, \"best\": false}, {\"name\": \"Accuracy\", \"value\": 0.62, \"best\": false}], \"level\": 18, \"xp\": 0.45, \"gained\": 1240, \"rewards\": [{\"name\": \"Gold\", \"amount\": 320, \"texture\": 0}, {\"name\": \"Crate\", \"amount\": 1, \"texture\": 0}], \"tab\": \"summary\"}"
column Results {
  width: stretch
  height: stretch
  padding: 32px
  justify-content: center
  align-items: center
  @media phone {
    padding: 12px
  }
  column Panel {
    width: stretch; max-width: 960px
    height: stretch; max-height: 900px
    padding: 24px
    gap: 16px
    background: var(--panel)
    -og-frame: panel
    on appear play land
    @media phone {
      padding: 16px
      gap: 12px
    }
    @media phone-landscape {
      flex-direction: row
      padding: 12px
      gap: 12px
    }
    scroll Page {
      width: stretch
      height: stretch
      gap: 16px
      -og-scroll-fade: 40px
      @media phone {
        gap: 12px
      }
      @media phone-landscape {
        gap: 8px
      }
      row Head {
        width: stretch
        gap: 16px
        align-items: center
        column Text {
          width: stretch
          gap: 4px
          label Title {
            text bind title
            font: var(--text-xl4)
            heading true
            @media phone {
              font: var(--text-xl2)
            }
            state outcome bind won {
              lost {
                color: var(--danger)
              }
              won {
                color: var(--gold)
              }
            }
          }
          label Gained {
            text "+{gained, grouped} XP"
            color: var(--xp)
          }
          row Level {
            width: stretch
            gap: 12px
            align-items: center
            label Value {
              text "Level {level}"
              font: var(--text-lg)
            }
            progress Xp {
              width: stretch
              value bind xp
            }
          }
        }
        label Grade {
          text bind grade
          font: var(--text-display-lg)
          heading true
          visible bind "grade != \"\""
          @media phone {
            font: var(--text-xl4)
          }
        }
      }
      slot Celebration {
        width: stretch
      }
      tabs Tabs {
        items Summary Graphs Scoreboard
        keys screen.results.summary screen.results.graphs screen.results.board
        values summary graphs board
        current bind tab
        width: stretch
        fill true
      }
      column Summary {
        width: stretch
        gap: 12px
        visible bind "tab == \"summary\""
        column Stats {
          width: stretch
          gap: 6px
          for s in stats {
            row Stat {
              width: stretch
              gap: 8px
              align-items: center
              label Name {
                text bind s.name
                color: var(--ink-muted)
              }
              badge Best {
                key "screen.results.best"
                text "Best"
                tone accent
                visible bind s.best
              }
              spacer
              label Value {
                text bind s.value grouped
                font: var(--text-lg)
              }
            }
          }
        }
        row Rewards {
          width: stretch
          gap: 8px
          flex-wrap: wrap
          for r in rewards {
            column Reward {
              padding: 8px
              gap: 4px
              align-items: center
              background: var(--panel-raised)
              -og-frame: card
              art Art {
                kind itemIcon
                width: 56px
                height: 56px
                texture bind r.texture
              }
              label Amount {
                text "{r.name} ×{r.amount, compact}"
                font: var(--text-caption)
              }
            }
          }
        }
      }
      slot Graph {
        width: stretch
        visible bind "tab == \"graphs\""
      }
      slot Scores {
        width: stretch
        visible bind "tab == \"board\""
      }
    }
    row Footer {
      width: stretch
      gap: 8px
      justify-content: end
      flex-wrap: wrap
      @media phone-landscape {
        flex-direction: column
        width: fit-content
        height: stretch
        align-items: stretch
        flex-wrap: nowrap
      }
      button Replay {
        key "screen.results.replay"
        text "Watch replay"
        variant quiet
        on click emit replay
      }
      button Again {
        key "screen.results.again"
        text "Play again"
        on click emit again
      }
      button Continue {
        key "screen.results.continue"
        text "Continue"
        variant primary
        on click emit continue
        on action confirm emit continue
      }
    }
  }
}
