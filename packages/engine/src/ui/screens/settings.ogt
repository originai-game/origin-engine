type screen
version 1
---
# Settings (docs/ui.md Appendix B: settings with graphics, audio, controls
# and remapping, accessibility, language, HUD layout editor). Back and the
# title at the head; under them the settings tree fills the screen.
#
# Slot Tree takes og.ui.settingsTree(world, "Tree", desc, custom): the
# pages as tabs, each page's entries as rows, the focused entry's detail,
# Defaults, Revert and Apply, and the keep-or-revert countdown after a
# display change. Its SettingsTreeDesc: pages ({ key, label, entries, hud }
# with each entry { key, kind: toggle | slider | choice | binding | action
# | custom, label, description, section, on, value, min, max, step, unit,
# options, index, action, display, dirty, disabled }), page, pending,
# confirmSeconds and confirmTotal, and its words (applyLabel, revertLabel,
# defaultsLabel, confirmTitle, keepLabel, revertingLabel, hudNote,
# editHudLabel, changedLabel); `custom` builds a custom entry's control by
# its key. A page with `hud: true` is the HUD layout page: Edit HUD turns
# og.ui.setHudEdit on and the page mounts og.ui.hudLayoutEditor itself
# (hud-editor is the same editor over the live HUD, outside the menu). Its
# SettingsTreeResult (page, change, action, bindingChanged, apply, revert,
# defaults, keep, confirmRevert, hudDone) is the game's to apply.
#
# Viewmodel: note (a line under the title). Events to code: back (the
# Back button and the Back action: revert a countdown or pending changes
# first, then og.ui.pop; the layer leaves Back to code so the tree's
# countdown sees it).
name "settings"
layer menu
back emit back
focus "Tree"
remember true
props {
  note string "A line under the title (Some changes apply after a restart); empty: none."
}
actions {
  confirm "Select"
  back "Back"
  tabNext "Next page"
  tabPrev "Previous page"
}
fixture default "{\"note\": \"\"}"
column Screen {
  width grow
  height grow
  padding 32
  gap 16
  at phone {
    padding 16
    gap 12
  }
  row Header {
    width grow
    gap 12
    cross center
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click emit back
    }
    column Heading {
      width grow
      gap 2
      label Title {
        key "screen.settings.title"
        text "Settings"
        step xl2
        heading true
        at phone {
          step xl
        }
      }
      label Note {
        text bind note
        step caption
        color token inkMuted
        maxLines 2
        visible bind "note != \"\""
      }
    }
  }
  slot Tree {
    width grow
    height grow
  }
}
