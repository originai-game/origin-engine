type screen
version 1
---
# Prestige and meta-progression hub (docs/ui.md Appendix B). The reset
# itself and what it gives, the meta currency, the permanent upgrades it
# buys, and the run's records.
#
# Viewmodel: currency (the meta currency held), name (its name), upgrades,
# runs, best. Events to code: buy (the click wrote buying: the upgrade's
# index) (Back pops it). Slots: Prestige takes og.ui.prestigePanel (the emblem, the
# reward, what a reset does and its hold-to-confirm; it answers the
# reset); Records takes the run's numbers (og.ui.keyValueRows).
name "prestige"
layer menu
focus "Body/Prestige"
props {
  currency number "The meta currency held (past 1e308: { m, e })."
  name string "Its name (Angels, Heavenly chips)."
  upgrades list "The permanent upgrades: { name, text, level, cost, afford (bool) }."
  buying number "The upgrade bought last."
  runs number "Resets so far."
  best number "The best run's earnings."
}
actions {
  back "Back"
}
fixture default "{\"currency\": 1.5e12, \"name\": \"Angels\", \"upgrades\": [{\"name\": \"Blessed hands\", \"text\": \"Clicks earn 2× per level.\", \"level\": 3, \"cost\": 2.5e11, \"afford\": true}, {\"name\": \"Choir\", \"text\": \"Generators start at level 10.\", \"level\": 0, \"cost\": 4e12, \"afford\": false}], \"buying\": -1, \"runs\": 12, \"best\": 8.2e15}"
column Screen {
  width grow
  height grow
  padding 24
  gap 12
  at phone {
    padding 12
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Back {
      key "screen.common.back"
      text "Back"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.prestige.title"
      text "Prestige"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    spacer
    label Currency {
      text "{currency, letters} {name}"
      step lg
      color token gold
    }
  }
  grid Body {
    width grow
    height grow
    gap 16
    columns "1fr" "1fr"
    rows "1fr"
    at phonePortrait {
      columns "1fr"
      rows auto "1fr"
      gap 12
    }
    column Left {
      width grow
      gap 12
      slot Prestige {
        width grow
      }
      label Runs {
        text "{runs} resets · best {best, letters}"
        step caption
        color token inkMuted
      }
      slot Records {
        width grow
      }
    }
    scroll Upgrades {
      width grow
      height grow
      column List {
        width grow
        gap 8
        for u in upgrades {
          row Upgrade {
            width grow
            padding 10
            gap 12
            cross center
            frame card
            column Text {
              width grow
              gap 2
              label Name {
                text "{u.name} · {u.level}"
                step lg
              }
              label Line {
                text bind u.text
                color token inkMuted
                maxLines 2
              }
            }
            button Buy {
              text bind u.cost letters
              size small
              at phone {
                size medium
              }
              disabled bind "!u.afford"
              on click set buying "$index"
              on click emit buy
            }
          }
        }
      }
    }
  }
}
