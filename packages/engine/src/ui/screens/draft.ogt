type screen
version 1
---
# Draft and ban with timers (docs/ui.md Appendix B). The two teams' picks
# and bans, the phase with its timer, the roster to pick from and the one
# action; a chat strip and the team's trade requests at the foot.
#
# Viewmodel: phase (the phase's name as text), turn (the local team picks
# now). Events to code: back (leaving a draft is a dodge: code confirms
# with og.ui.confirm). Slots: Draft takes og.ui.draft (the teams' slots,
# bans, the banner and timer, the roster and Ban or Lock in; it answers
# hover, ban and pick); Chat takes the team chat (og.ui.dataList with
# og.ui.inputField).
name "draft"
layer menu
under hide
back emit back
focus "Body/Draft"
props {
  phase string "The phase, as text (Ban phase 1)."
  turn bool "It is the local team's turn."
}
actions {
  confirm "Lock in"
  back "Leave"
}
fixture default "{\"phase\": \"Ban phase 1\", \"turn\": true}"
column Screen {
  width grow
  height grow
  padding 16
  gap 8
  row Header {
    width grow
    gap 12
    cross center
    label Phase {
      text bind phase
      step lg
      heading true
    }
    badge Turn {
      key "screen.draft.yourTurn"
      text "Your turn"
      tone accent
      visible bind turn
    }
  }
  column Body {
    width grow
    height grow
    gap 8
    slot Draft {
      width grow
      height grow
    }
    slot Chat {
      width grow
      at phonePortrait {
        visible false
      }
    }
  }
}
