type screen
version 2
---
# Main menu (docs/ui.md Appendix B: boot, splash, title, main menu, mode
# select). The game's key art behind, its logo, and the menu: Continue
# while there is a save, New game, the modes, Settings, Credits and Quit.
#
# Viewmodel: canContinue, saveLine, version, news (see props). Events to
# code: continue, newGame, modes, settings, credits, quit, news (the news
# card pressed). Slots: Background takes the game's own scene or art
# (og.ui.viewport, a sceneViewport) when the key art is not enough;
# Extra takes anything the game adds under the menu (og.ui.card, a
# season banner). Push it as the first menu: og.ui.push(world,
# "main-menu", vm).
name "main-menu"
layer menu
under none
back none
focus "Menu/Continue"
props {
  canContinue bool "A save exists: Continue shows and takes the focus."
  saveLine string "Under Continue: where the last save stands (chapter, time played)."
  version string "The build's version, shown small in the corner."
  news string "A line for the news card (empty: no card)."
}
actions {
  confirm "Select"
}
fixture default "{\"canContinue\": true, \"saveLine\": \"Chapter 3 · 4h 12m\", \"version\": \"1.0.0\", \"news\": \"Season 2 is live\"}"
stack Menu {
  width: stretch
  height: stretch
  art Art {
    kind keyArt
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  slot Background {
    width: stretch
    height: stretch
    position: absolute
    inset-inline-start: 0
    top: 0
    inset-inline-end: 0
    bottom: 0
  }
  column Menu {
    width: fit-content; min-width: 420px
    height: stretch
    padding: 48px
    gap: 12px
    justify-content: center
    @media phone {
      padding: 24px
      width: stretch
    }
    @media phone-landscape {
      padding: 12px
      gap: 4px
    }
    art Logo {
      kind logo
      width: 320px
      height: 120px
      @media phone {
        width: 240px
        height: 90px
      }
      @media phone-landscape {
        visible false
      }
    }
    spacer
    button Continue {
      @media phone-landscape {
        size medium
      }
      key "screen.main-menu.continue"
      text "Continue"
      variant primary
      size large
      width: stretch
      visible bind canContinue
      on click emit continue
    }
    label SaveLine {
      text bind saveLine
      font: var(--text-caption)
      color: var(--ink-muted)
      visible bind canContinue
    }
    button NewGame {
      @media phone-landscape {
        size medium
      }
      key "screen.main-menu.newGame"
      text "New game"
      size large
      width: stretch
      on click emit newGame
    }
    button Modes {
      @media phone-landscape {
        size medium
      }
      key "screen.main-menu.modes"
      text "Modes"
      size large
      width: stretch
      on click emit modes
    }
    button Settings {
      @media phone-landscape {
        size medium
      }
      key "screen.main-menu.settings"
      text "Settings"
      size large
      width: stretch
      on click emit settings
    }
    button Credits {
      key "screen.main-menu.credits"
      text "Credits"
      variant quiet
      width: stretch
      on click emit credits
    }
    button Quit {
      key "screen.main-menu.quit"
      text "Quit"
      variant quiet
      width: stretch
      on click emit quit
    }
    slot Extra {
      width: stretch
    }
    spacer
  }
  panel News {
    position: absolute
    inset-inline-end: 32px
    bottom: 32px
    padding: 16px
    gap: 4px
    background: var(--panel-raised)
    -og-frame: card
    interactive true
    focusable true
    visible bind "news != \"\""
    on click emit news
    @media phone {
      visible false
    }
    label Eyebrow {
      key "screen.main-menu.newsEyebrow"
      text "News"
      font: var(--text-caption)
      color: var(--primary)
    }
    label Line {
      text bind news
      font: var(--text-lg)
      line-clamp: 2
    }
    :hover {
      translate: 0 -2px
    }
    :active {
      translate: 0 0
    }
    :focus-visible {
      translate: 0 -2px
    }
    -og-state-transition: var(--motion-ui)
  }
  label Version {
    text bind version
    font: var(--text-caption)
    color: var(--ink-muted)
    position: absolute
    inset-inline-start: 16px
    bottom: 12px
  }
}
