type screen
version 1
---
# Guild, friends and chat (docs/ui.md Appendix B). Friends, Guild and Chat
# tabs: the friends, online first, with their status, Whisper and Invite;
# the guild's name, message of the day and members with their ranks; the
# chat window filling the page.
#
# Slot Chat (the Chat tab) takes og.ui.chat("Chat", desc): the channel
# tabs with their unread counts, the log (links, @mentions, a message
# naming the player lit, the new-messages pill), and the input with the
# channel chip, the field, the @name suggestions and Send. Its ChatDesc:
# channels ({ key, name, color, unread, mentions, all, readOnly }),
# channel, messages ({ key, channel, author, authorKey, avatar, text,
# links, time, system, own }), me, members ({ key, name, avatar }), draft,
# sendTo, maxChars, and its words (placeholder, sendLabel, newLabel,
# channelLabel); title empty (the tabs above name it) and hud false (the
# HUD form is the game's chat over play, not this screen). Its ChatResult
# (channel, sendTo, draft, send, link, author) is the game's to apply.
#
# Viewmodel: tab, online, requests, guild, friends, members, picked.
# Events to code: tab (the click wrote tab), add (add a friend), whisper
# (the click wrote picked: code opens the Chat tab with sendTo that
# friend), invite (the click wrote picked); Back pops it.
name "social"
layer menu
focus "Tabs/Friends"
props {
  tab string "friends, guild or chat."
  online number "Friends online."
  requests number "Friend requests waiting."
  guild object "The guild: { name, motd }."
  friends list "The friends, online first: { name, status (as text), online (bool) }."
  members list "The guild's members: { name, rank, online (bool) }."
  picked number "The friend whose Whisper or Invite was pressed last."
}
actions {
  confirm "Select"
  back "Close"
  tabNext "Next tab"
  tabPrev "Previous tab"
}
fixture default "{\"tab\": \"friends\", \"online\": 4, \"requests\": 2, \"guild\": {\"name\": \"Lanterns of Vael\", \"motd\": \"Raid tonight at 20:00. Bring potions.\"}, \"friends\": [{\"name\": \"Ria\", \"status\": \"In a match\", \"online\": true}, {\"name\": \"Brann\", \"status\": \"In the menu\", \"online\": true}, {\"name\": \"Sela\", \"status\": \"Last seen 2 days ago\", \"online\": false}], \"members\": [{\"name\": \"Vael\", \"rank\": \"Leader\", \"online\": true}, {\"name\": \"Ria\", \"rank\": \"Officer\", \"online\": true}, {\"name\": \"Torvin\", \"rank\": \"Member\", \"online\": false}], \"picked\": -1}"
column Screen {
  width grow
  height grow
  padding 24
  gap 12
  at phone {
    padding 8
  }
  row Header {
    width grow
    gap 12
    cross center
    wrap true
    button Close {
      key "screen.common.close"
      text "Close"
      variant quiet
      on click pop
    }
    label Title {
      key "screen.social.title"
      text "Social"
      step xl2
      heading true
      at phone {
        step xl
      }
    }
    spacer
    button Add {
      key "screen.social.add"
      text "Add friend"
      size small
      at phone {
        size medium
      }
      on click emit add
    }
  }
  row Tabs {
    width grow
    gap 6
    cross center
    wrap true
    focusGroup wrap
    button Friends {
      text "Friends {online}"
      variant ghost
      on click set tab "\"friends\""
      state selection bind "tab == \"friends\"" {
        off {
          opacity 0.85
        }
        on {
          opacity 1
        }
      }
    }
    button Guild {
      key "screen.social.guild"
      text "Guild"
      variant ghost
      on click set tab "\"guild\""
      state selection bind "tab == \"guild\"" {
        off {
          opacity 0.85
        }
        on {
          opacity 1
        }
      }
    }
    button Chat {
      key "screen.social.chat"
      text "Chat"
      variant ghost
      on click set tab "\"chat\""
      state selection bind "tab == \"chat\"" {
        off {
          opacity 0.85
        }
        on {
          opacity 1
        }
      }
    }
    badge Requests {
      text "{requests, plural, one {# request} other {# requests}}"
      tone accent
      visible bind "requests > 0"
    }
  }
  scroll FriendsScroll {
    width grow
    height grow
    visible bind "tab == \"friends\""
    column List {
      width grow
      gap 4
      for f in friends {
        row Friend {
          width grow
          padding 8
          gap 10
          cross center
          background token panelRaised
          frame card
          wrap true
          panel Dot {
            width 10
            height 10
            radius 5
            state presence bind f.online {
              away {
                background token inkFaint
              }
              online {
                background token success
              }
            }
          }
          column Text {
            width grow
            gap 2
            label Name {
              text bind f.name
              maxLines 1
              ellipsis true
            }
            label Status {
              text bind f.status
              step caption
              color token inkMuted
              maxLines 1
              ellipsis true
            }
          }
          button Whisper {
            key "screen.social.whisper"
            text "Whisper"
            variant quiet
            size small
            visible bind f.online
            at phone {
              size medium
            }
            on click set picked "$index"
            on click emit whisper
          }
          button Invite {
            key "screen.social.invite"
            text "Invite"
            size small
            visible bind f.online
            at phone {
              size medium
            }
            on click set picked "$index"
            on click emit invite
          }
        }
      }
    }
  }
  column Guild {
    width grow
    height grow
    gap 8
    visible bind "tab == \"guild\""
    column Head {
      width grow
      padding 12
      gap 4
      background token panelRaised
      frame card
      label Name {
        text bind guild.name
        step lg
        heading true
      }
      label Motd {
        text bind guild.motd
        color token inkMuted
        maxLines 3
      }
    }
    scroll MemberScroll {
      width grow
      height grow
      column List {
        width grow
        gap 2
        for m in members {
          row Member {
            width grow
            padding 8
            gap 10
            cross center
            label Name {
              text bind m.name
              width grow
              maxLines 1
              ellipsis true
            }
            label Rank {
              text bind m.rank
              step caption
              color token inkMuted
            }
            state presence bind m.online {
              away {
                opacity 0.55
              }
              online {
                opacity 1
              }
            }
          }
        }
      }
    }
  }
  slot Chat {
    width grow
    height grow
    visible bind "tab == \"chat\""
  }
}
