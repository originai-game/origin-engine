type particles
version 1
---
# A reward's glints for a `<Particles>` node (1 unit a CSS px, +y up):
# four-point stars thrown out from the centre, popping in, slowing and
# shrinking away. White: the node's ink (text-<colour>) colours them.
maxParticles 32
shape sphere 6
spread 180
rate 0
burst 0 22
duration 0.1
looping false
lifetime 0.8 1.4
speed 160 420
size 16 30
sizeOverLife 0 0.2 0.15 1 1 0
rotation 0 45
angularVelocity -90 90
gravity 0 0 0
drag 2.6
texture "@styles/shared/fx/sparkle.png"
colorOverLife {
  key 0 1 1 1 1
  key 0.7 1 1 1 1
  key 1 1 1 1 0
}
