type particles
version 1
---
# A screen wash for a `<Particles>` node: one very large soft light over
# the whole screen, fading out (a legendary reveal's or a level-up's
# tint, 18% strong). White: the ink colours it.
maxParticles 2
shape point
rate 0
burst 0 1
duration 0.1
looping false
lifetime 0.5
speed 0
size 1400
gravity 0 0 0
texture "@styles/shared/fx/glint.png"
colorOverLife {
  key 0 1 1 1 0.18
  key 1 1 1 1 0
}
