type particles
version 1
---
# Sparks for a `<Particles>` node (1 unit a CSS px, +y up): one ring of
# streaks thrown out from the node's centre, slowing and thinning as they
# fade. White: the node's ink (text-<colour>) colours it; Celebration lays
# one node per ink.
maxParticles 32
shape sphere 4
spread 180
rate 0
burst 0 12
duration 0.1
looping false
lifetime 0.6 0.9
speed 90 260
size 4 6
sizeOverLife 0 1 1 0.2
align velocity 0.05
drag 2.4
colorOverLife {
  key 0 1 1 1 1
  key 0.6 1 1 1 1
  key 1 1 1 1 0
}
