type particles
version 1
---
# A level-up's rising stars for a `<Particles>` node: four-point stars
# born along the node's box and drifting up, popping in and out. White:
# the node's ink colours them.
maxParticles 96
shape box 1 1 0
spread 180
rate 40
burst 0 10
duration 1.6
looping false
lifetime 1.2 1.8
speed 10 40
size 10 22
sizeOverLife 0 0.3 0.2 1 1 0
rotation 0 45
gravity 0 240 0
drag 0.2
texture "@styles/shared/fx/sparkle.png"
colorOverLife {
  key 0 1 1 1 1
  key 0.7 1 1 1 1
  key 1 1 1 1 0
}
