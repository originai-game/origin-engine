type timeline
version 1
---
# The in-engine cutscene: the hall, the camera pushing in.
duration 2
track scene {
  key 0 {
    scene "scenes/hall.ogt"
  }
}
track camera {
  key 0 {
    position 0 2.5 7
    target 0 0.8 0
    fov 45
  }
  key 2 {
    position 1.5 1.5 3.5
    target -0.5 1 -1
    fov 38
    ease power2.inOut
  }
}
