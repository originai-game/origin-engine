type scene
version 1
---
# The 3D level: a ball on the set, which the game rolls off the edge
# (won) or keeps on it (lost). Its own sky and light.
name "Level"
resource Sky {
  enabled true
  zenith 0.25 0.4 0.7
  horizon 0.6 0.7 0.8
  ground 0.2 0.18 0.15
  sunIntensity 3
  sunDirection 0.4 0.8 0.3
}
entity "set" {
  model "models/set.ogt"
  RigidBody {
    kind fixed
  }
  Collider {
    shape box
    size 12 0.1 12
  }
}
entity "ball" {
  model "models/ball.ogt"
  Transform {
    position 0 0.3 0
  }
  RigidBody {
    mass 1
  }
  Collider {
    shape sphere
    radius 0.3
  }
}
entity "sun" {
  Transform {
    position 3 6 2
    quaternion -0.399593 0.239756 0 0.884784
  }
  DirectionalLight {
    color 1 0.95 0.85
    intensity 2.5
  }
}
