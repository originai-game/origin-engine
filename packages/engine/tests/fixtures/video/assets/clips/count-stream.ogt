type video
version 1
---
# The same source as count.ogt, streamed: AV1 decoded as it plays, a key
# frame every second (frames 0, 30, 60, 90), its sound in Opus; a chunk a
# second, so a seek and a loop cross chunks, each fetched as players reach it.
source "count.mp4"
stream true
fps 30
size 192 108
keyframe 1
chunk 1
