  inkFaint "#9c9c9c"
  inkInverse "#161616"
  control "#ffffff0f"
  controlStrong "#ffffff1a"
  primary "#e8e8e8"
  primaryHover "#ffffff"
  primaryActive "#c8c8c8"
  onPrimary "#161616"
  primarySoft "#ffffff1f"
  highlight "#6ad8ec"
  focus "#5ad1e6"
  knob "#f0f0f0"
  hud "#101010d1"
  scrim "#0000008c"
