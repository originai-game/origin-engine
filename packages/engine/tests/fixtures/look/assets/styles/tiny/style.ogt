type style
version 2
---
# Upgraded to version 2 by og style upgrade: its version 1 values kept, the new tokens derived from its palette and scheme (docs/ui.md §12).
name "tiny"
scheme dark
palette {
  backdrop "#101010"
  well "#161616"
  panel "#1e1e1e"
  panelHover "#2a2a2a"
  panelRaised "#262626"
  line "#3a3a3a"
  lineStrong "#606060"
  ink "#f0f0f0"
  inkMuted "#b4b4b4"
  inkFaint "#9c9c9c"
  inkInverse "#161616"
  control "#ffffff0f"
  controlStrong "#ffffff1a"
  primary "#e8e8e8"
  primaryHover "#ffffff"
  primaryActive "#c8c8c8"
  onPrimary "#161616"
  primarySoft "#ffffff1f"
  highlight "#6ad8ec"
  focus "#5ad1e6"
  knob "#f0f0f0"
  hud "#101010d1"
  scrim "#0000008c"
  shadow "#000000"
  sheen "#ffffff3d"
  success "#4cc38a"
  warn "#f0a050"
  danger "#ff8a82"
  info "#7ab8ff"
  health "#5ccf6e"
  mana "#5a9cff"
  xp "#b07cff"
  gold "#f2c14e"
}
colors {
  success pattern dots
  warn pattern stripes
  danger pattern crosshatch
  info pattern waves
  common "#9e9e9e" pips 1
  uncommon "#3fbf4f" pips 2
  rare "#2f7fef" pips 3
  epic "#a335ee" pips 4
  legendary "#ff8000" pips 5
  mythic "#e8364f" pips 6
  team1 "#3d7eff"
  team2 "#ff4747"
  team3 "#3fbf5f"
  team4 "#ffc61a"
  team5 "#a347ff"
  team6 "#ff8a1f"
  team7 "#1fc7c7"
  team8 "#ff5cb0"
  physical "#b8b0a0"
  fire "#ff6a2b"
  ice "#62cfff"
  lightning "#ffd83a"
  poison "#7ed957"
  holy "#ffe9a0"
  shadow "#8a5cf6"
  arcane "#ff4fd8"
  series1 "#4e79a7"
  series2 "#f28e2b"
  series3 "#e15759"
  series4 "#76b7b2"
  series5 "#59a14f"
  series6 "#edc948"
  series7 "#b07aa1"
  series8 "#ff9da7"
}
typography {
  display 40 44 0 700 display {
    phonePortrait 32 35
    phoneLandscape 36 40
  }
  title 28 32 0 700 display {
    phonePortrait 25 28
    phoneLandscape 26 30
  }
  heading 20 28 0 600 display
  body 14 20 0 400 body
  label 14 20 0 600 body
  caption 13 18 0 400 body
  numeric 18 26 0 600 numeric
}
space {
  xxs 2
  xs 4
  sm 8
  md 12
  lg 16
  xl 24
  xxl 32
  xl3 48
}
size {
  xs 16
  sm 24
  md 32
  lg 48
  xl 64
  xxl 96
  touch 44
}
radius {
  xs 1
  sm 2
  md 3
  lg 5
  xl 6
  pill 9999
}
stroke {
  hairline 1
  thin 1.5
  regular 2
  thick 3
  focus 2
}
elevation {
  raised {
    shadow 0 1 3 0 "#0000004d"
  }
  floating {
    shadow 0 4 12 0 "#00000059"
  }
  overlay {
    shadow 0 12 32 0 "#00000073"
  }
  top {
    shadow 0 18 48 0 "#00000073"
  }
}
shape {
  panel round 3
  dialog round 3
  card round 3
  tooltip round 3
  button round 2
  field round 2
  chip round 2
  badge round 2
  tab round 2
  slot round 1
  bar round 1
  hud round 2
  avatar round 1
}
motion {
  spring ui 180 0
  spring panel 240 0
  spring emphasis 400 0.15
  spring playful 520 0.3
  ease standard 0.2 0 0 1
  ease enter 0.23 1 0.32 1
  ease exit 0.4 0 1 1
  ease emphasis 0.34 1.4 0.64 1
  duration instant 120
  duration fast 180
  duration base 240
  duration slow 400
  duration spring 520
  duration bounce 640
  stagger 0
  staggerCap 300
  overshoot 0.05
}
sounds {
  hover none haptic none
  press none haptic tick
  focus none haptic none
  select none haptic tick
  confirm none haptic tap
  cancel none haptic tick
  back none haptic tick
  open none haptic none
  close none haptic none
  tab none haptic tick
  toggleOn none haptic tick
  toggleOff none haptic tick
  sliderTick none haptic tick
  scrollTick none haptic none
  typewriter none haptic none
  counterTick none haptic none
  notification none haptic tap
  warning none haptic warning
  error none haptic error
  success none haptic success
  reward none haptic double
  revealCommon none haptic none
  revealUncommon none haptic tick
  revealRare none haptic tap
  revealEpic none haptic double
  revealLegendary none haptic thud
  revealMythic none haptic buzz
}
