type project
version 1
---
# The fixture uncooked-release.test.ts runs: at tick 10 it loads a 1024 px
# image and a 131,072-triangle grid uncooked (og.load.imageData,
# og.load.gltfData), draws them, and at tick 40 releases both
# (og.load.release), so dump_memory before, between and after shows what
# the loads took on the GPU and the heap and that the release gave it back.
name "Uncooked release fixture"
id "uncooked-release-fixture"
engine "0.7.7"
entry "src/main.ts"
profile "3d"
tick 60
seed 1
