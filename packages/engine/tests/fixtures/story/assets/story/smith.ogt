type dialogue
version 1
---
name smith
start greet
speaker smith {
  name "npc.smith"
  portrait "art/smith.png"
  side right
}
var mood 0
global gold 10
global charm 3
node greet {
  say smith "smith.hello" {
    arg gold "gold"
  }
  set mood "mood + 1"
  choice "smith.buy" {
    if "gold >= 10"
    reason "smith.need_gold" {
      arg need "10 - gold"
    }
    kind trade
    set gold "gold - 10"
    goto bought
  }
  choice "smith.haggle" {
    check active charm 12
    goto bought
    fail angry
  }
  choice "smith.secret" {
    check passive charm 5
    hide
    goto bought
  }
  choice "smith.leave"
  timer 30 smith.leave
}
node bought {
  say smith "smith.thanks"
  quest progress rescue sword
  emit give_sword "mood"
}
node angry {
  pick {
    calm 1
    furious 1
  }
}
node calm {
  say smith "smith.calm"
  goto greet
}
node furious {
  say smith "smith.furious"
}
