{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "types": ["@origingame/engine/bun-test"],
    "customConditions": ["og-source"]
  },
  "include": [
    "src/**/*.ts",
    "src/ui/inspector.tsx",
    "extensions/**/*.ts",
    "shell/**/*.ts",
    "tests/**/*.ts",
    "bench/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "tests/contract.ts",
    "tests/fixtures/*/src/**"
  ]
}
