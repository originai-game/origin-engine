{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "bun:test": ["./vendor/bun-types/test.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "shell/**/*.ts",
    "tests/**/*.ts",
    "bench/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "tests/contract.ts",
    "tests/fixtures/*/src/**"
  ]
}
