{
  "name": "@origingame/engine",
  "version": "0.0.1",
  "description": "Origin Engine: the TypeScript API, generated from crates/og-api/api.ogt.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts"
    },
    "./bindings.json": "./types/bindings.json",
    "./schema.json": "./schema/api.schema.json"
  },
  "files": ["types", "schema"],
  "scripts": {
    "typecheck": "bun x --package typescript@5.9.3 tsc --noEmit -p tsconfig.json",
    "test": "bun run typecheck"
  }
}
