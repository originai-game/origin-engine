{
  "name": "@origingame/engine",
  "version": "0.0.1",
  "description": "Origin Engine: the TypeScript API, generated from crates/og-api/api.ogt, and its runtime on the web (wasm in a Worker) and native (napi addon) hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/origingame/origin-engine",
    "directory": "packages/engine"
  },
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./node": "./src/node/index.ts",
    "./web/worker": "./src/web/worker.ts",
    "./web/shell": "./src/web/shell.ts",
    "./web/play": "./src/web/play.ts",
    "./web/rpc-ring": "./src/web/rpc-ring.ts",
    "./runtime": "./src/runtime.ts",
    "./bindings.json": "./types/bindings.json",
    "./schema.json": "./schema/api.schema.json",
    "./playtest": "./src/playtest.ts"
  },
  "bin": {
    "og": "./bin/og.mjs"
  },
  "files": [
    "types",
    "schema",
    "src",
    "shell",
    "bin",
    "dist/web",
    "dist/web-publish",
    "vendor"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "optionalDependencies": {
    "@origingame/engine-darwin-arm64": "0.0.1",
    "@origingame/engine-linux-x64": "0.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "typecheck": "bun x --package typescript@5.9.3 tsc --noEmit -p tsconfig.json && bun x --package typescript@5.9.3 tsc --noEmit -p tsconfig.runtime.json",
    "test": "bun run typecheck && sh scripts/build.sh && bun test tests/",
    "pack": "sh scripts/pack.sh",
    "test:browser": "bun tests/web/wire.ts && bun tests/web/player.ts && bun tests/web/export.ts"
  }
}
