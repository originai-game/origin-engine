{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "preserve",
    "paths": {
      "@origingame/engine": ["./types/index.d.ts"],
      "@origingame/engine/ui": ["./types/ui.d.ts"],
      "@origingame/engine/ui/components": ["./src/ui/components/index.tsx"]
    }
  },
  "include": [
    "types/assets.d.ts",
    "src/ui/components/**/*.tsx",
    "src/ui/controls/*.tsx",
    "src/ui/screens/*.tsx",
    "tests/fixtures/*/assets/ui/*.tsx",
    "../../showcase/*/assets/ui/*.tsx",
    "../create/template/src/**/*.ts",
    "../../tests/fixtures/*/src/**/*.ts",
    "tests/fixtures/*/src/**/*.ts"
  ]
}
