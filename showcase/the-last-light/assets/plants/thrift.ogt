# Sea thrift: round pink heads on short stems over a cushion of leaves.
plant "thrift" {
  kind daisy
  seed 31
  trunk {
    length 0.2
  }
  leaves {
    count 12
    size 0.06
    width 0.12
  }
  flowers {
    petals 22
    size 0.03
    width 0.5
    cup 48
    color 0.95 0.42 0.62
    color2 0.8 0.3 0.55
    centerColor 0.9 0.5 0.7
  }
}
