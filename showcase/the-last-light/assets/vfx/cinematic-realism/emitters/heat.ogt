type particles
version 1
---
# MIT Origin Engine. Heat haze over a blast: invisible billboards that only
# bend the scene behind them while the fireball is hot.
maxParticles 6
shape sphere 0.6
rate 0
burst 0.05 5
duration 0.1
looping false
lifetime 0.7 1.1
speed 0.3 0.8
size 1.6 2.4
sizeOverLife 0 0.6 1 1.4
gravity 0 1 0
drag 1
blend alpha
distortion 0.012
color 1 1 1 0
colorOverLife {
  key 0 1 1 1 0
  key 0.2 1 1 1 1
  key 1 1 1 1 0
}
