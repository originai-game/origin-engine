speed 1.8 3.6
size 0.012 0.03
align velocity 0.02
gravity 0 -9.8 0
drag 0.3
blend alpha
color 0.88 0.94 1
colorOverLife {
  key 0 1 1 1 0.85
  key 0.8 1 1 1 0.65
  key 1 1 1 1 0
}
collision 0 0 depth die
