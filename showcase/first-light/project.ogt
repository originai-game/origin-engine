type project
version 1
---
name "First Light"
id "first-light"
engine "0.9.0"
entry "src/main.ts"
tick 60
seed 1
publish {
  probe player
  out "dist"
}

look "looks/first-light.ogt"

create {
  genre "open-world"
  view "third-person-3d"
  look "cinematic-realism"
  mood "warm"
  ui "default"
  platform "desktop"
  input "keyboard-mouse"
  players "single"
  lang "en"
  music "folk"
}
