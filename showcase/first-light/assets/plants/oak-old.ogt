type model
version 1
---
# The old oak on the knoll: a short trunk two metres through, forking low
# into heavy limbs that reach out level over the hilltop and droop at their
# ends, so their leaves hang into the top of the frame.
plant "oak-old" {
  kind oak
  seed 11
  levels 3
  force 0 -1 0 0.006
  barkColor 0.115 0.085 0.06
  trunk {
    length 5.2
    radius 1.05
    sections 10
    segments 14
    taper 0.5
    gnarliness 0.1
    twist 0.2
    children 6
  }
  branch1 {
    length 9.5
    radius 0.45
    sections 9
    segments 8
    taper 0.6
    gnarliness 0.16
    twist 0.3
    children 6
    angle 80
    start 0.72
  }
  branch2 {
    length 5
    radius 0.55
    sections 5
    segments 5
    taper 0.7
    gnarliness 0.16
    children 5
    angle 52
    start 0.2
  }
  branch3 {
    length 2.2
    radius 0.7
    sections 3
    segments 3
    taper 0.75
    gnarliness 0.1
    angle 38
    start 0.1
  }
  leaves {
    count 90
    start 0.05
    angle 52
    size 0.2
    width 0.6
    sizeVariance 0.5
    color 0.1 0.2 0.035
    color2 0.2 0.32 0.06
  }
}
