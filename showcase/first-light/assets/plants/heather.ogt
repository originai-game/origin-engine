type model
version 1
---
# A low heather: a shrub cut down to knee height, with purple spikes. Few
# branches and leaves: it is scattered by the hundred.
plant "heather" {
  kind shrub
  seed 5
  levels 2
  trunk {
    children 6
  }
  branch1 {
    length 0.3
    children 2
  }
  branch2 {
    length 0.18
  }
  leaves {
    count 8
    size 0.06
    color 0.09 0.16 0.07
    color2 0.14 0.2 0.09
  }
  flowers {
    share 1
    count 4
    size 0.04
    color 0.3 0.1 0.5
    color2 0.46 0.2 0.62
  }
}
