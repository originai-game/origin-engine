type effect
version 1
---
# MIT Origin Engine. The pale streak a fast blade leaves in the air: thin,
# gone in a few frames.
blend additive
doubleSided true
mask "vfx/cinematic-realism/textures/taper.png"
noise {
  tile 1 4
}
erosion curve 0 0.05 0.5 0.3 1 0.85
erosionSoftness 0.5
alpha curve 0 0.6 0.4 0.4 1 0
softDepth 0.05
