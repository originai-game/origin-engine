type particles
version 1
---
# CC0 Thomas Iché / Unity Labs DiscSmoke01; MIT composition. A wisp per
# shot of a burst, so sustained fire builds a haze and a single shot
# leaves little.
maxParticles 24
shape cone 18 0.03
rate 0
burst 0 2
duration 0.05
looping false
lifetime 0.6 1
speed 0.6 1.4
size 0.14 0.22
sizeOverLife 0 0.5 1 2.4
rotation 0 360
angularVelocity -40 40
gravity 0 0.15 0
drag 3
wind 1
texture "vfx/cinematic-realism/textures/dust.png"
sheet 16 4 64 life 1 blend
blend alpha
lit true
color 1 0.98 0.95
softDistance 0.1
colorOverLife {
  key 0 1 1 1 0
  key 0.1 1 1 1 0.22
  key 1 1 1 1 0
}
