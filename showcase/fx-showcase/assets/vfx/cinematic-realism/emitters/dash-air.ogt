type particles
version 1
---
# MIT Origin Engine. The air a dash displaces: billboards that only bend
# the scene.
maxParticles 4
shape cone 10 0.2
rate 0
burst 0 4
duration 0.05
looping false
lifetime 0.25 0.4
speed 2 5
size 0.6 0.9
sizeOverLife 0 0.6 1 1.5
gravity 0 0 0
drag 3
blend alpha
distortion 0.01
color 1 1 1 0
colorOverLife {
  key 0 1 1 1 1
  key 1 1 1 1 0
}
