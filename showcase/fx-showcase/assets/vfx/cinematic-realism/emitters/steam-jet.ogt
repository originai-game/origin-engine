sheet 16 4 64 life 1 blend
blend alpha
lit true
color 2 2 2.05
softDistance 0.15
colorOverLife {
  key 0 1 1 1 0
  key 0.1 1 1 1 0.4
  key 0.5 1 1 1 0.25
  key 1 1 1 1 0
}
