# MIT Origin Engine. Sparks lifted off a fire, wandering as they rise and
# die.
maxParticles 32
shape cone 20 0.15
rate 9
duration 2
looping true
lifetime 1 2.2
speed 0.5 1.5
size 0.008 0.016
gravity 0 0.6 0
drag 0.6
wind 1
noise 0.5 1 0.4
blend additive
colorOverLife {
  key 0 2.4 1.4 0.4 1
  key 0.5 1.8 0.6 0.1 1
  key 1 0.4 0.05 0.01 0
}
