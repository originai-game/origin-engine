type particles
version 1
---
# MIT Origin Engine. Clods of earth thrown up; they fall and stay where
# they land.
maxParticles 16
shape cone 35 0.04
rate 0
burst 0 14
duration 0.05
looping false
lifetime 0.8 1.3
speed 2 5
size 0.01 0.028
rotation 0 360
angularVelocity -400 400
gravity 0 -9.8 0
drag 0.4
render mesh tetrahedron
lit true
roughness 1
blend alpha
color 0.2 0.15 0.1
colorOverLife {
  key 0 1 1 1 1
  key 0.85 1 1 1 1
  key 1 1 1 1 0
}
collision 0.1 0.9 depth
