type particles
version 1
---
# CC0 Thomas Iché / Unity Labs DiscSmoke01; MIT composition. Puffs along
# the thread a lobbed grenade or a smoking fragment draws, spreading as it
# fades.
maxParticles 128
shape sphere 0.02
spread 180
rate 70
duration 2
looping true
lifetime 1 1.6
speed 0.02 0.12
size 0.18 0.28
sizeOverLife 0 0.5 1 2.6
rotation 0 360
gravity 0 0 0
drag 2
wind 1
noise 0.12 1 0.3
texture "vfx/cinematic-realism/textures/dust.png"
sheet 16 4 64 life 1 blend
blend alpha
lit true
color 0.8 0.8 0.8
softDistance 0.1
colorOverLife {
  key 0 1 1 1 0
  key 0.1 1 1 1 0.5
  key 0.5 1 1 1 0.28
  key 1 1 1 1 0
}
