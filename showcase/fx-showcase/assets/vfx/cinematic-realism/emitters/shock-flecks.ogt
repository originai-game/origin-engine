type particles
version 1
---
# MIT Origin Engine. Flecks of charge thrown off a shocked body, a spray
# with each arc of shocked's 0.6 s loop.
maxParticles 48
shape sphere 0.25
rate 0
burst 0 10
burst 0.12 8
burst 0.3 10
burst 0.44 8
duration 0.6
looping true
lifetime 0.12 0.3
speed 1.2 3
size 0.012 0.024
align velocity 0.03
gravity 0 -2 0
drag 4
blend additive
colorOverLife {
  key 0 1.4 2.4 4 1
  key 1 0.1 0.3 1 0
}
