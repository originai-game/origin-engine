type particles
version 1
---
# MIT Origin Engine. Heavy pieces a large blast throws high; they fall
# back over a second or two.
maxParticles 44
shape cone 50 0.8
rate 0
burst 0 40
duration 0.05
looping false
lifetime 1.8 3
speed 8 16
size 0.05 0.14
rotation 0 360
angularVelocity -400 400
gravity 0 -9.8 0
drag 0.2
render mesh tetrahedron
lit true
roughness 0.9
blend alpha
color 0.09 0.08 0.07
colorOverLife {
  key 0 1 1 1 1
  key 0.9 1 1 1 1
  key 1 1 1 1 0
}
collision 0.25 0.7 depth
