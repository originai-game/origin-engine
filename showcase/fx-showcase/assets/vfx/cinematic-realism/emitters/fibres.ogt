type particles
version 1
---
# MIT Origin Engine. Threads and scraps torn from cloth, drifting down.
maxParticles 10
shape cone 55 0.02
rate 0
burst 0 8
duration 0.05
looping false
lifetime 0.8 1.4
speed 0.8 2.4
size 0.002 0.004
heightOverLife 0 6 1 6
rotation 0 360
angularVelocity -300 300
gravity 0 -3 0
drag 2.5
wind 1
render mesh box
lit true
roughness 1
blend alpha
color 0.3 0.29 0.27
colorOverLife {
  key 0 1 1 1 1
  key 0.8 1 1 1 1
  key 1 1 1 1 0
}
