type particles
version 1
---
# MIT Origin Engine. The ripple a jump leaves: one billboard that only
# bends the scene, opening outwards.
maxParticles 1
shape point
rate 0
burst 0 1
duration 0.05
looping false
lifetime 0.6
speed 0
size 1.2
sizeOverLife 0 0.3 1 4
gravity 0 0 0
blend alpha
distortion 0.03
color 1 1 1 0
colorOverLife {
  key 0 1 1 1 1
  key 1 1 1 1 0
}
