type sfx
version 1
---
# MIT Origin Engine. A large blast: a long sub rumble, a wide roar and
# debris rattling after it.
layer sine {
  freq 52
  freq_end 22
  attack 0.003
  sustain 0.15
  decay 1.6
  punch 0.6
  drive 2
  gain 1
}
layer noise {
  lowpass 650
  lp_slide -0.4
  attack 0.006
  sustain 0.25
  decay 2.6
  gain 0.8
}
layer noise {
  highpass 1500
  attack 0.001
  sustain 0.015
  decay 0.16
  gain 0.4
}
layer noise {
  lowpass 2600
  highpass 700
  delay 0.35
  attack 0.2
  sustain 0.3
  decay 1.4
  gain 0.12
}
