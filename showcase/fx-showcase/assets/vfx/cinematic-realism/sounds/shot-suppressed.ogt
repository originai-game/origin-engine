type sfx
version 1
---
# MIT Origin Engine. A suppressed shot: a dull puff of gas and the
# action's click.
layer noise {
  lowpass 2200
  highpass 300
  attack 0.002
  sustain 0.01
  decay 0.09
  gain 0.4
}
layer sine {
  freq 230
  freq_end 120
  attack 0.001
  sustain 0.004
  decay 0.03
  gain 0.2
}
layer noise {
  highpass 3500
  delay 0.015
  attack 0.001
  sustain 0.002
  decay 0.02
  gain 0.15
}
