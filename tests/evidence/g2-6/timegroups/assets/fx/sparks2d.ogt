type particles
version 1
---
# Sparks thrown up from under a column and falling back, drawn as sprites
# on layer 5 and glowing: their rise, fall and fade show the time group's
# pace (after templates/fx-showcase's embers2d).
maxParticles 300
shape box 0.8 0.05 0
rate 90
lifetime 1.2 1.6
speed 6 8
spread 18
size 0.3 0.45
sizeOverLife 0 1 1 0.2
colorOverLife {
  key 0 1 0.8 0.3 1
  key 0.6 1 0.4 0.1 1
  key 1 1 0.15 0.05 0
}
gravity 0 -9 0
texture "textures/spark.png"
blend additive
render sprite 5
glow 2
