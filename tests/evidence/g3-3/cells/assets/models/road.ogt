type model
version 1
---
# The road the rover drives on, always there: 240 m along X, 4 m wide.
material "asphalt" {
  color 0.2 0.2 0.22
  roughness 1
}
material "line" {
  color 0.9 0.85 0.5
  roughness 0.8
}
part "road" {
  material "asphalt"
  position 50 -0.05 0
  boxGeometry {
    width 240
    height 0.1
    depth 4
  }
}
part "dash" {
  material "line"
  position 50 0.005 0
  boxGeometry {
    width 240
    height 0.02
    depth 0.15
  }
}
