type model
version 1
---
# The anchor: a 2.4 m rover, its foot on y = 0, facing +X.
material "hull" {
  color 0.95 0.5 0.1
  roughness 0.6
}
material "tyre" {
  color 0.12 0.12 0.14
  roughness 0.9
}
part "hull" {
  material "hull"
  position 0 0.8 0
  boxGeometry {
    width 2.4
    height 0.7
    depth 1.5
  }
}
part "cab" {
  material "hull"
  position -0.3 1.4 0
  boxGeometry {
    width 1.1
    height 0.6
    depth 1.2
  }
}
part "wheels" {
  material "tyre"
  cylinderGeometry {
    radiusTop 0.4
    radiusBottom 0.4
    height 0.3
    radialSegments 16
  }
  at {
    position 0.8 0.4 0.8
    quaternion 0.7071068 0 0 0.7071068
  }
  at {
    position -0.8 0.4 0.8
    quaternion 0.7071068 0 0 0.7071068
  }
  at {
    position 0.8 0.4 -0.8
    quaternion 0.7071068 0 0 0.7071068
  }
  at {
    position -0.8 0.4 -0.8
    quaternion 0.7071068 0 0 0.7071068
  }
}
