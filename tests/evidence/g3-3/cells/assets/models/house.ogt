# A small house: 4 x 3 x 4 m walls under a pitched roof, its foot on y = 0.
material "wall" {
  color 0.86 0.8 0.68
  roughness 0.9
}
material "roof" {
  color 0.62 0.2 0.14
  roughness 0.9
}
material "door" {
  color 0.3 0.18 0.1
  roughness 0.9
}
part "walls" {
  material "wall"
  position 0 1.5 0
  boxGeometry {
    width 4
    height 3
    depth 4
  }
}
part "roof" {
  material "roof"
  position 0 3.9 0
  quaternion 0 0.3826834 0 0.9238795
  coneGeometry {
    radius 3.4
    height 1.8
    radialSegments 4
  }
}
part "door" {
  material "door"
  position 0 0.9 2.01
  boxGeometry {
    width 0.9
    height 1.8
    depth 0.05
  }
}
