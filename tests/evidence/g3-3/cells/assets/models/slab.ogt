type model
version 1
---
# A cell's ground: 24 x 24 m, 0.5 m thick, its top 2 cm under the road's.
material "turf" {
  color 0.42 0.55 0.32
  roughness 1
}
material "edge" {
  color 0.36 0.3 0.24
  roughness 1
}
part "top" {
  material "turf"
  position 0 -0.07 0
  boxGeometry {
    width 24
    height 0.1
    depth 24
  }
}
part "body" {
  material "edge"
  position 0 -0.32 0
  boxGeometry {
    width 24
    height 0.4
    depth 24
  }
}
