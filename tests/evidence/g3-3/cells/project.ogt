type project
version 1
---
# The G3-3 world cells sample: a rover drives along a row of five cells,
# each a sub-scene (a slab with a static collider, houses or trees, and
# dynamic crates or balls). A cell loads as the rover comes within 12 m of
# its box and unloads past 15 m behind it; its crates fall onto its slab
# the tick it loads. tests/evidence/g3-3/NOTES.md has the commands and what
# each frame shows.
name "G3-3 world cells"
id "g3-3-cells"
engine "0.7.7"
entry "src/main.ts"
profile "3d"
scenes {
  world "scenes/world.ogt"
}
scene world
tick 60
seed 1
