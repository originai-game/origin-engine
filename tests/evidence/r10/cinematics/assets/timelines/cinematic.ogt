type timeline
version 1
---
name "Lamp scene"
duration 8
track camera {
  key 0 {
    position -3.5 2.2 7
    target 0 1.2 0
    roll 0
    focusOn "hero"
    focusRange 0.6
  }
  key 4 {
    position 0 1.8 5.2
    target 0 1.3 -1
    roll -10
    ease quadInOut
  }
  key 5 {
    focus 7.5
    focusRange 0.8
  }
  key 7 {
    position 2.6 2 5.8
    target 0 1.4 -2
    roll 0
    focus 7.5
    ease quadInOut
  }
}
track light "lamp" {
  key 0 {
    color 1 0.55 0.25
    intensity 0
  }
  key 2.5 {
    intensity 40
    ease quadIn
  }
}
track material "lamp" {
  key 0 {
    emissiveIntensity 0
  }
  key 2.5 {
    emissiveIntensity 8
    ease quadIn
  }
}
track property "fill" {
  field "og.DirectionalLight.intensity"
  key 0 {
    value 1.2
  }
  key 3 {
    value 0.15
  }
}
track property {
  field "og.RenderSettings.environmentIntensity"
  key 0 {
    value 0.7
  }
  key 2.5 {
    value 0.06
  }
}
track visibility "crate" {
  key 0 {
    visible true
  }
  key 3.5 {
    visible false
  }
}
track post {
  key 0 {
    vignetteIntensity 0
  }
  key 6 {
    vignetteIntensity 0.7
    ease quadOut
  }
}
track timeline {
  key 4.5 {
    play "timelines/door.ogt"
  }
}
track marker {
  key 8 {
    name "end"
  }
}
