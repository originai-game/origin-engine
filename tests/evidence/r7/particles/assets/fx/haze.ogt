type particles
version 1
---
# Heat haze over the brazier: untextured puffs that push the scene behind
# them outwards by up to 2% of the screen's height.
maxParticles 120
shape box 0.3 0.05 0.3
rate 30
lifetime 1.4 1.8
speed 0.6 0.9
size 0.6 0.9
sizeOverLife 0 0.6 1 1.4
colorOverLife {
  key 0 1 1 1 0
  key 0.25 1 1 1 1
  key 1 1 1 1 0
}
rotation 0 360
gravity 0 0 0
distortion 0.02
