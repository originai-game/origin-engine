type vfx
version 1
---
# A heal on a target standing at the origin: a glowing column, two trails
# spiralling up it, rising motes, a sigil on the ground and a green light;
# it resolves (`healed`) with a flash at 1.2 s.
duration 2
event 1.2 "healed"
mesh cylinder {
  at 0
  life 2
  offset 0 0.8 0
  effect "fx/pillar.ogt"
  scale curve 0 0.6 0.2 1.6 1 1.7
}
trail {
  at 0
  until 1.6
  effect "fx/streak.ogt"
  width 0.12 0
  lifetime 0.45
  orbit 0.75 1.2
  rise 1
}
trail {
  at 0
  until 1.6
  rotate 0 180 0
  effect "fx/streak.ogt"
  width 0.12 0
  lifetime 0.45
  orbit 0.75 1.2
  rise 1
}
emitter "fx/motes.ogt" {
  at 0
  until 1.6
  offset 0 0.2 0
}
light {
  at 0
  life 2
  offset 0 1 0
  color 0.3 1 0.45
  intensity curve 0 0 0.2 18 0.8 18 1 0
  distance 6
}
decal {
  at 0.1
  life 1.9
  uv 0.5 0 1 1
  size 2.2 0.5 2.2
  fade 0.5
}
flash {
  at 1.2
  life 0.25
  offset 0 1 0
  size curve 0 0.8 1 1.8
  color 0.4 2 0.8
}
