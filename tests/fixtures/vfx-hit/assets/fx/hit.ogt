type vfx
version 1
---
# A heavy hit on the ground: a flash, sparks, embers and dust, a shock ring,
# a scorch left behind, a burst of light and a shake; the impact lands on
# the third tick.
duration 1.6
impact 0.05
flash {
  at 0
  life 0.2
  offset 0 0.35 0
  size curve 0 0.6 1 1.4
  color 2.4 1.4 0.6
}
emitter "fx/sparks.ogt" {
  at 0
  offset 0 0.3 0
}
emitter "fx/embers.ogt" {
  at 0.02
  offset 0 0.3 0
}
emitter "fx/smoke.ogt" {
  at 0.05
  offset 0 0.1 0
}
mesh ring {
  at 0
  life 0.45
  offset 0 0.06 0
  rotate -90 0 0
  effect "fx/shock.ogt"
  scale curve 0 0.4 1 3
}
light {
  at 0
  life 0.5
  offset 0 0.6 0
  color 1 0.6 0.25
  intensity curve 0 25 0.3 8 1 0
  distance 7
}
decal {
  at 0.05
  life 1.55
  uv 0 0 0.5 1
  size 2.4 0.6 2.4
  fade 0.6
}
shake {
  at 0.05
  trauma 0.35
}
