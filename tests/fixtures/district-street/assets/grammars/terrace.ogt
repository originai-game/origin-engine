type grammar
version 1
---
param height 12
param floor 3.2
start Lot
rule Lot {
  extrude height {
    front Facade
    sides Rear
    top Roof
  }
}
rule Facade {
  split y {
    part 4 Ground
    repeat floor Floor
    part 0.4 Cornice
  }
}
rule Rear {
  split y {
    part 0.45 Plinth
    repeat floor Floor
    part 0.4 Cornice
  }
}
rule Floor {
  split x {
    part 0.5 Wall
    repeat 2.8 Bay
    part 0.5 Wall
  }
}
rule Bay {
  split x {
    fill 1 Wall
    part 1.2 Window
    fill 1 Wall
  }
}
rule Window {
  split y {
    part 0.9 Wall
    part 1.6 Glass
    fill 1 Wall
  }
}
rule Glass {
  recess 0.12
  label glass
}
rule Ground {
  pick {
    option 3 Shopfront
    option 2 Residential
  }
}
rule Shopfront {
  split x {
    part 0.4 Pier
    fill 1 Shop
    part 1.35 Entrance
    part 0.4 Pier
  }
}
rule Residential {
  split x {
    part 0.4 Pier
    part 1.35 Entrance
    fill 1 HouseWindow
    part 0.4 Pier
  }
}
rule Pier {
  split y {
    part 0.45 Plinth
    fill 1 Wall
  }
}
rule HouseWindow {
  split y {
    part 0.45 Plinth
    fill 1 Floor
  }
}
rule Shop {
  split y {
    part 0.45 Plinth
    fill 1 ShopWindows
    part 0.45 Frame
  }
}
rule ShopWindows {
  split x {
    repeat 2.2 ShopWindow
  }
}
rule ShopWindow {
  inset 0.1 Frame ShopGlass
}
rule ShopGlass {
  recess 0.16 Frame
  label shopglass
}
rule Entrance {
  split y {
    part 0.12 Plinth
    part 2.6 DoorFrame
    fill 1 Frame
  }
}
rule DoorFrame {
  inset 0.1 Frame Door
}
rule Door {
  recess 0.2 Frame
  split y {
    part 0.85 DoorPanel
    fill 1 DoorLight
  }
}
rule DoorPanel {
  label door
}
rule DoorLight {
  inset 0.07 Frame DoorPane
}
rule DoorPane {
  label shopglass
}
rule Frame {
  label shopfront
}
rule Plinth {
  extrude 0.06 {
    top PlinthEdge
    sides PlinthEdge
  }
}
rule PlinthEdge {
  label plinth
}
rule Cornice {
  label trim
}
rule Wall {
  label wall
}
rule Roof {
  roof hip 35 {
    overhang 0.3
    slope Slate
  }
}
rule Slate {
  label roof
}
