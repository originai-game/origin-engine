type terrain
version 1
---
# Low rolling hills, 160 m square, generated by the cook (no heightmap
# file): a sample every 1.25 m, gentle noise, no erosion. Two colour
# layers: grass on the flats, dirt on the slopes.
height 0 6
size 160 160
generate {
  samples 129 129
  seed 7
  noise {
    octaves 3
    frequency 1.5
    gain 0.4
  }
  biome {
    layer 0
    slope 0 12
  }
  biome {
    layer 1
    slope 12 90
  }
}
layer {
  color 0.3 0.42 0.2
  roughness 0.95
}
layer {
  color 0.42 0.33 0.22
  roughness 1
}
