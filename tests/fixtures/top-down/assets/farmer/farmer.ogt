type flipbook
version 1
---
# The farmer walking towards the camera: a generated GIF (512x512, magenta
# ground, an art pixel about 11 of its pixels) keyed and brought to its grid.
source "farmer_walk.gif" {
  clip "walk"
  event 1 "step"
  event 5 "step"
}
key auto 0.1 holes
align none
scale 0.0909
filter nearest
