type particles
version 1
---
# breakFx for the brick wall and the concrete pillar: a low puff where a
# piece breaks loose, sinking quickly so the break shows through it.
maxParticles 256
shape sphere 0.25
spread 180
rate 0
burst 0 16
duration 0.25
looping false
lifetime 0.8 1.6
speed 0.2 0.8
size 0.25 0.5
sizeOverLife 0 0.6 1 1.8
colorOverLife {
  key 0 0.5 0.45 0.4 0
  key 0.1 0.5 0.45 0.4 0.4
  key 1 0.55 0.5 0.46 0
}
gravity 0 -0.6 0
drag 2
blend alpha
lit true
softDistance 0.3
