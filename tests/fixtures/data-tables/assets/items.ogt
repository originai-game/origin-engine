type table
version 1
---
# The items: each names its ammunition here and what it salvages into in
# materials.ogt, which names the items back.
row "sword" {
  damage 12
  weight 3.5
  rarity "rare"
  icon asset "icons/sword.svg"
  name text "items.sword" "Sword"
  salvage row "materials.ogt" "iron" row "materials.ogt" "wood"
}
row "bow" {
  damage 7
  weight 1.5
  name text "items.bow" "Bow"
  ammo row "arrow"
  salvage row "materials.ogt" "wood"
}
row "arrow" {
  damage 3
  weight 0.1
  name text "items.arrow" "Arrow"
}
