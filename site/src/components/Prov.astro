---
// The provenance line under a frame: what made it and when.
import { copy, type Lang } from "../i18n";
import { get, provenance } from "../lib/media";
import type { SlotName } from "../media";

interface Props { slots: SlotName[]; lang: Lang }
const { slots, lang } = Astro.props;
const rs = slots.map((s) => get(s));
const lines = [...new Set(rs.filter((r) => r.kind !== "pending").map(provenance))];
const status = rs.some((r) => r.status === "pending") ? "pending" : rs.some((r) => r.status === "interim") ? "interim" : null;
---
{(lines.length > 0 || status) && (
  <div class="prov">
    {status && <span class="chip" data-kind={status} title={status === "interim" ? copy.placeholder.interimNote[lang] : undefined}>{status === "interim" ? copy.placeholder.interim[lang] : copy.placeholder.pending[lang]}</span>}
    <span>{copy.media.source[lang]}</span>
    {lines.map((l) => <span class="mono">{l}</span>)}
  </div>
)}
