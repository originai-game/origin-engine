---
import "../styles/site.css";
import { engine, mark, motionCss } from "../lib/brand";
import { copy, langs, path, type Lang } from "../i18n";
import { numbers } from "../numbers";
import { tokenCss } from "../tokens";
import Hero from "./Hero.astro";
import Loop from "./Loop.astro";
import Media from "./Media.astro";
import Nav from "./Nav.astro";
import Prov from "./Prov.astro";
import Weather from "./Weather.astro";
import Wipe from "./Wipe.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy;
const r = c.rendering;
const site = "https://engine.origingame.ai";
const head = numbers.find((n) => n.key === "days")!;
const commit = (await import("node:child_process")).execFileSync("git", ["rev-parse", "--short=9", "HEAD"], { encoding: "utf8" }).trim();
const wipes = [
  { key: "fog", left: "render-fog-before", right: "render-fog-after", l: r.before, rr: r.after },
  { key: "refl", left: "render-refl-off", right: "render-refl-on", l: r.off, rr: r.on },
  { key: "ssr", left: "render-ssr-off", right: "render-ssr-on", l: r.off, rr: r.on },
] as const;
const hashes = [
  { t: c.determinism.rollback, b: c.determinism.rollbackBody, h: "04fdc5c4b5e353f4" },
  { t: c.determinism.lockstep, b: c.determinism.lockstepBody, h: "04fdc5c4b5e353f4" },
  { t: c.determinism.save, b: c.determinism.saveBody, h: "485ed0a7de28cb9a" },
];
const games = [
  ["play-meridian", "Meridian Loop", "meridian"],
  ["play-hollowbell", "Hollowbell", "hollowbell"],
  ["play-kestrel", "The Kestrel Stair", "kestrel"],
  ["play-lantern", "Lantern Vale", "lantern"],
  ["play-brasswick", "Brasswick", "brasswick"],
  ["play-rumpus", "Rumpus Isle", "rumpus"],
] as const;
---
<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{c.meta.title[lang]}</title>
  <meta name="description" content={c.meta.description[lang]} />
  <meta name="theme-color" content="#000000" />
  <link rel="canonical" href={`${site}${path(lang)}`} />
  {langs.map((l) => <link rel="alternate" hreflang={l === "zh" ? "zh-CN" : "en"} href={`${site}${path(l)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${site}/`} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={c.meta.title[lang]} />
  <meta property="og:description" content={c.meta.description[lang]} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${site}${path(lang)}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <style is:inline set:html={tokenCss()} />
  <style is:inline set:html={motionCss()} />
  {lang === "en" && (
    <script is:inline>
      // A Chinese reader's first visit goes to /zh/ unless they chose a language.
      try {
        if (!localStorage.getItem("og-site-lang") && /^zh\b/i.test(navigator.language)) location.replace("/zh/" + location.hash);
      } catch {}
    </script>
  )}
</head>
<body>
  <a class="sr-only" href="#loop">{lang === "en" ? "Skip to content" : "跳到正文"}</a>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />

    <section class="section" id="loop">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.loop.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.loop.title[lang]}</h2>
          <p class="lede">{c.loop.body[lang]}</p>
        </header>
        <Loop lang={lang} />
        <div class="subhead reveal">
          <h3 class="display d-md">{c.determinism.title[lang]}</h3>
          <p class="lede">{c.determinism.body[lang]}</p>
        </div>
        <div class="hashes">
          {hashes.map((x, i) => (
            <div class="hash reveal" style={`--delay:${i * 100}ms`}>
              <h3>{x.t[lang]}</h3>
              <p>{x.b[lang]}</p>
              <code>{x.h}</code>
            </div>
          ))}
        </div>
        <p class="match reveal"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3 7.5 2.5 2.5L11 4.5" /></svg>{c.determinism.match[lang]} · G2-7 rollback · G1-5 cross-host save</p>
      </div>
    </section>

    <section class="section" id="rendering">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{r.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{r.title[lang]}</h2>
          <p class="lede">{r.body[lang]}</p>
        </header>
        <div class="reveal" data-wipes>
          <div class="seg wipe-tabs" role="tablist" aria-label={r.eyebrow[lang]}>
            {wipes.map((w, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={w.key}>{r.wipes[w.key][lang]}</button>)}
          </div>
          {wipes.map((w, i) => (
            <div role="tabpanel" data-panel={w.key} hidden={i !== 0}>
              <Wipe left={w.left} right={w.right} leftLabel={w.l[lang]} rightLabel={w.rr[lang]} lang={lang} title={r.wipes[w.key][lang]} />
              <Prov slots={[w.left, w.right]} lang={lang} />
            </div>
          ))}
        </div>
        <div style="margin-top:clamp(64px,9vw,120px)"><Weather lang={lang} /></div>
        <div class="grid-3" style="margin-top:clamp(64px,9vw,120px);grid-template-columns:1fr 1fr">
          <div class="card reveal"><div class="frame"><Media slot="water-sunset" lang={lang} /></div></div>
          <div class="card reveal" style="--delay:100ms"><div class="frame"><Media slot="water-storm" lang={lang} /></div></div>
        </div>
        <div class="caption reveal">
          <h3>{r.oceanTitle[lang]}</h3>
          <p>{r.oceanBody[lang]}</p>
        </div>
        <Prov slots={["water-sunset", "water-storm"]} lang={lang} />
        <div class="frame r16x9 reveal" style="margin-top:clamp(64px,9vw,120px)"><Media slot="render-reel" lang={lang} /></div>
        <Prov slots={["render-reel"]} lang={lang} />
      </div>
    </section>

    <section class="section" id="characters">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.characters.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.characters.title[lang]}</h2>
          <p class="lede">{c.characters.body[lang]}</p>
        </header>
        <div class="frame r16x9 reveal"><Media slot="char-motion" lang={lang} /></div>
        <div class="grid-3" style="margin-top:var(--space-lg)">
          <div class="card reveal"><div class="frame"><Media slot="char-autorig" lang={lang} sizes="(max-width: 899px) 100vw, 420px" /></div>
            <div class="caption"><h3>{c.characters.autorig[lang]}</h3><p>{c.characters.autorigBody[lang]}</p></div></div>
          <div class="card reveal" style="--delay:100ms"><div class="frame"><Media slot="char-motion-course" lang={lang} sizes="(max-width: 899px) 100vw, 420px" /></div>
            <div class="caption"><h3>{c.characters.motion[lang]}</h3><p>{c.characters.motionBody[lang]}</p></div></div>
          <div class="card reveal" style="--delay:200ms"><div class="frame"><Media slot="char-cloth" lang={lang} sizes="(max-width: 899px) 100vw, 420px" /></div>
            <div class="caption"><h3>{c.characters.cloth[lang]}</h3><p>{c.characters.clothBody[lang]}</p></div></div>
        </div>
        <Prov slots={["char-autorig", "char-motion-course", "char-cloth"]} lang={lang} />
      </div>
    </section>

    <section class="section" id="worlds">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.worlds.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.worlds.title[lang]}</h2>
          <p class="lede">{c.worlds.body[lang]}</p>
        </header>
        <div class="frame r16x9 reveal"><Media slot="world-grass" lang={lang} /></div>
        <div class="grid-3" style="margin-top:var(--space-lg)">
          {([["world-terrain", c.worlds.terrain], ["world-dungeon", c.worlds.dungeon], ["world-village", c.worlds.village]] as const).map(([s, t], i) => (
            <div class="card reveal" style={`--delay:${i * 100}ms`}><div class="frame"><Media slot={s} lang={lang} sizes="(max-width: 899px) 100vw, 420px" /></div>
              <div class="caption"><h3>{t[lang]}</h3></div></div>
          ))}
        </div>
        <Prov slots={["world-grass", "world-terrain", "world-dungeon", "world-village"]} lang={lang} />
      </div>
    </section>

    <section class="section" id="ui">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.ui.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.ui.title[lang]}</h2>
          <p class="lede">{c.ui.body[lang]}</p>
        </header>
        <div class="frame r16x9 reveal"><Media slot="ui-grid" lang={lang} /></div>
        <p class="meta" style="margin-top:12px">{c.ui.pending[lang]}</p>
      </div>
    </section>

    <section class="section" id="play">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.play.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.play.title[lang]}</h2>
          <p class="lede">{c.play.body[lang]}</p>
        </header>
        <div class="tiles">
          {games.map(([slot, name, key], i) => (
            <figure class="tile reveal" style={`--delay:${(i % 3) * 100}ms;margin:0`}>
              <div class="frame"><Media slot={slot} lang={lang} sizes="(max-width: 599px) 100vw, (max-width: 899px) 50vw, 420px" /></div>
              <figcaption><h3>{name}</h3><p>{c.play.games[key][lang]}</p><p class="meta">{c.play.soon[lang]}</p></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="numbers">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.numbers.eyebrow[lang]}</p>
          <h2 class="display d-2xl">{c.numbers.title[lang]}</h2>
          <p class="lede">{c.numbers.body[lang]}</p>
        </header>
        <div class="numbers reveal">
          {numbers.map((n) => (
            <div class={n.pending ? "pending-num" : ""} title={n.source[lang]}>
              <div class="value" data-count={n.pending ? undefined : n.value}>{n.value}{n.unit && <small>{n.unit[lang]}</small>}</div>
              <div class="label">{n.label[lang]}</div>
              <div class="src">{n.pending ? <span class="status" data-kind="pending" style="position:static">{c.numbers.pending[lang]}</span> : n.source[lang]}</div>
            </div>
          ))}
        </div>
        <div class="bench reveal">
          <div><h3>{c.numbers.benchmark[lang]}</h3><p>{c.numbers.benchmarkBody[lang]}</p></div>
          <span class="status" data-kind="pending" style="position:static">{c.numbers.pending[lang]}</span>
        </div>
      </div>
    </section>

    <section class="cta wrap">
      <Fragment set:html={mark("none", "cta", 'data-cta-mark')} />
      <h2 class="display d-2xl reveal">{c.cta.title[lang]}</h2>
      <p class="lede reveal">{c.cta.body[lang]}</p>
      <div class="actions reveal">
        <a class="btn primary" href="https://origingame.ai">{c.cta.primary[lang]}</a>
        <a class="btn secondary" href="https://www.npmjs.com/package/@origingame/create-game">{c.cta.secondary[lang]}</a>
      </div>
      <p class="meta reveal" style="margin-top:28px">{c.cta.command[lang]}</p>
      <div class="cmdline reveal"><span>bunx @origingame/create-game my-game</span><button type="button" data-copy="bunx @origingame/create-game my-game" data-copied={c.cta.copied[lang]}>{c.cta.copy[lang]}</button></div>
    </section>
  </main>
  <footer>
    <div class="wrap">
      <span class="brand" style="font-size:var(--text-base)"><Fragment set:html={engine()} />Origin Engine</span>
      <span class="meta">{c.footer.built[lang]} <span class="mono">{commit}</span> · {head.source[lang]}</span>
      <span class="meta">{c.footer.rights[lang]}</span>
    </div>
  </footer>

  <script>
    // Reveal on scroll.
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // Films play only while on screen (and never under reduced motion).
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const vio = new IntersectionObserver((es) => es.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !still) { v.preload = "auto"; void v.play().catch(() => {}); } else v.pause();
    }), { threshold: 0.25 });
    document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]").forEach((v) => vio.observe(v));

    // Wipes: the range input carries the value.
    document.querySelectorAll<HTMLElement>("[data-wipe]").forEach((w) => {
      const input = w.querySelector("input")!;
      const set = () => w.style.setProperty("--pos", `${input.value}%`);
      input.addEventListener("input", set);
      if (!still) {
        // A first sweep the first time the wipe comes into view, so the reader sees it moves.
        const once = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          once.disconnect();
          const t0 = performance.now();
          const step = (t: number) => {
            const k = Math.min(1, (t - t0) / 1600);
            if (document.activeElement === input) return;
            input.value = String(50 + 28 * Math.sin(k * Math.PI * 2) * (1 - k));
            set();
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }, { threshold: 0.6 });
        once.observe(w);
      }
    });
    const tabs = document.querySelector<HTMLElement>("[data-wipes]");
    tabs?.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => b.addEventListener("click", () => {
      tabs.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((x) => { const on = x === b; x.setAttribute("aria-selected", String(on)); });
      tabs.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
    }));

    // Numbers count up once, from zero, to the measured value.
    const nio = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      nio.unobserve(e.target);
      const el = e.target as HTMLElement;
      const text = el.dataset.count!;
      const target = Number(text.replace(/,/g, ""));
      const decimals = (text.split(".")[1] ?? "").length;
      const small = el.querySelector("small")?.outerHTML ?? "";
      if (still || !Number.isFinite(target)) return;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = Math.min(1, (t - t0) / 1400);
        const v = target * (1 - Math.pow(1 - k, 4));
        el.innerHTML = (decimals ? v.toFixed(decimals) : Math.round(v).toLocaleString("en-US")) + small;
        if (k < 1) requestAnimationFrame(step); else el.innerHTML = text + small;
      };
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => nio.observe(el));

    // The CTA mark plays genesis when it comes into view.
    const cm = document.querySelector<SVGElement>("[data-cta-mark]");
    if (cm) {
      new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); cm.setAttribute("data-motion", "genesis"); } }, { threshold: 0.6 }).observe(cm);
    }

    // Copy the create command.
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
      await navigator.clipboard.writeText(b.dataset.copy!);
      const was = b.textContent;
      b.textContent = b.dataset.copied!;
      setTimeout(() => (b.textContent = was), 1600);
    }));
  </script>
</body>
</html>
